	Возврат 3;

КонецФункции

// Агент разбора - тот же, что у команды сбора (копия поиска ar_СобратьДокументыРасторжения.АгентКомандыСбора,
// спека В.3): активный агент с включенным инструментом этого пакета и включенной подпиской на команду
// договоров. Чтение - привилегированно с парным сбросом.
//
// Возвращаемое значение:
//  Структура - {Код: "ok" / "no_package" / "no_agent" / "ambiguous"; Агент; Наименования: Массив из Строка}.
//
Функция АгентРазбораВыгрузок()

	Результат = Новый Структура("Код, Агент, Наименования", "no_agent",
		Справочники.ar_Агенты.ПустаяСсылка(), Новый Массив);

	Агенты = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИдентификаторыПакета = ИдентификаторыЭтогоПакета();
		Если ИдентификаторыПакета.Количество() = 0 Тогда
			Результат.Код = "no_package";
		Иначе
			Агенты = АгентыПакетаСПодпискойДоговоров(ИдентификаторыПакета);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Результат.Код = "no_package" Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого НайденныйАгент Из Агенты Цикл
		Результат.Наименования.Добавить(НайденныйАгент.Наименование);
	КонецЦикла;
	Если Агенты.Количество() = 1 Тогда
		Результат.Код = "ok";
		Результат.Агент = Агенты[0].Ссылка;
	ИначеЕсли Агенты.Количество() > 1 Тогда
		Результат.Код = "ambiguous";
	Иначе
		// Агент не настроен - Код остается "no_agent".
		Результат.Код = "no_agent";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Строковые UUID элементов Справочник.ДополнительныеОтчетыИОбработки этого пакета - так ядро хранит пакет
// инструмента (ar_Инструменты.ar_ИдентификаторПакета). Вызывается в привилегированном режиме.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ИдентификаторыЭтогоПакета()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Пакеты
		|ГДЕ
		|	Пакеты.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ Пакеты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяМодуляЛога());

	Идентификаторы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;
	Возврат Идентификаторы;

КонецФункции

// Активные агенты с включенным инструментом пакета и включенной подпиской на команду договоров, РАЗЛИЧНЫЕ
// (запрос - как в ar_СобратьДокументыРасторжения.АгентыПакета). Вызывается в привилегированном режиме.
//
// Параметры:
//  ИдентификаторыПакета - Массив из Строка - строковые UUID элементов пакета.
//
// Возвращаемое значение:
//  Массив из Структура - {Ссылка, Наименование}.
//
Функция АгентыПакетаСПодпискойДоговоров(Знач ИдентификаторыПакета)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты.ar_ДоступныеИнструменты КАК ИнструментыАгента
		|		ПО ИнструментыАгента.Ссылка = Агенты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Инструменты КАК Инструменты
		|		ПО Инструменты.ar_Имя = ИнструментыАгента.ar_Инструмент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_ПодпискиАгентов КАК Подписки
		|		ПО Подписки.ar_Агент = Агенты.Ссылка
		|ГДЕ
		|	Агенты.ar_Активен
		|	И НЕ Агенты.ПометкаУдаления
		|	И ИнструментыАгента.ar_Включен
		|	И Инструменты.ar_Включён
		|	И НЕ Инструменты.ПометкаУдаления
		|	И Инструменты.ar_ИдентификаторПакета В (&ИдентификаторыПакета)
		|	И Подписки.ar_Включён
		|	И НЕ Подписки.ПометкаУдаления
		|	И Подписки.ar_Событие1С = &Событие
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Запрос.УстановитьПараметр("ИдентификаторыПакета", ИдентификаторыПакета);
	Запрос.УстановитьПараметр("Событие", СобытиеКомандыДоговоров());

	Агенты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Агенты.Добавить(Новый Структура("Ссылка, Наименование", Выборка.Ссылка, Выборка.Наименование));
	КонецЦикла;
	Возврат Агенты;

КонецФункции

// Событие командной подписки агента на договоры - как у команды сбора ar_СобратьДокументыРасторжения.
