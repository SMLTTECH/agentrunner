Функция СхемаАргументовРазбора()

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Новый Структура);
	Параметры.Вставить("required", Новый Массив);

	Возврат ОбернутьВOpenAIФормат(ИмяИнструментаРазбора(),
		НСтр("ru = 'Разложить выгрузку ДО по договору запуска по папкам разбора.'"), Параметры);

