КонецФункции

// Строка даты для файлов задачи: местное время ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//
// Параметры:
//  ЗначениеДаты - Дата - дата.
//
// Возвращаемое значение:
//  Строка - представление даты; для пустой даты - пустая строка.
//
Функция СтрокаДатыФайла(Знач ЗначениеДаты)

	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат "";
	КонецЕсли;
	Возврат XMLСтрока(ЗначениеДаты);

КонецФункции

// Дата из строки файла задачи (ГГГГ-ММ-ДДTЧЧ:ММ:СС); нераспознанная строка - пустая дата.
//
// Параметры:
//  ЗначениеСтроки - Произвольный - значение поля файла.
//
// Возвращаемое значение:
//  Дата - дата или пустая дата.
//
Функция ДатаИзСтрокиФайла(Знач ЗначениеСтроки)

	Если ТипЗнч(ЗначениеСтроки) <> Тип("Строка") Или ПустаяСтрока(ЗначениеСтроки) Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), СокрЛП(ЗначениеСтроки));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Значение поля разобранного JSON-объекта (Соответствие) с проверкой типа: нет поля или тип другой -
// значение по умолчанию.
//
// Параметры:
//  Объект               - Соответствие, Произвольный - разобранный JSON-объект.
//  Ключ                 - Строка - имя поля.
//  ЗначениеПоУмолчанию  - Строка, Число, Булево, Массив - значение по умолчанию; его тип - ожидаемый тип поля.
//
// Возвращаемое значение:
//  Произвольный - значение поля или значение по умолчанию.
//
Функция ПолеОбъекта(Знач Объект, Знач Ключ, Знач ЗначениеПоУмолчанию = "")

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	ЗначениеПоля = Объект.Получить(Ключ);
	Если ЗначениеПоля = Неопределено Или ТипЗнч(ЗначениеПоля) <> ТипЗнч(ЗначениеПоУмолчанию) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат ЗначениеПоля;

КонецФункции

// Читает JSON-файл с повтором (спека Е.3): файл не разобрался - до 3 попыток с паузой 1 с; файла нет -
// повтор только если рядом лежит временный файл замены «<имя>.*.tmp» (миг между удалением старого
// и переименованием нового), иначе сразу «файла нет».
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Структура:
//   * Данные   - Соответствие, Неопределено - разобранный объект; Неопределено - файла нет или он битый.
//   * ФайлЕсть - Булево - файл есть на диске (Данные = Неопределено и ФайлЕсть - файл битый).
//
Функция ПрочитатьФайлДанных(Знач ПолноеИмя)

	Результат = Новый Структура("Данные, ФайлЕсть", Неопределено, Ложь);
	ЧислоПопыток = 3;
	Для НомерПопытки = 1 По ЧислоПопыток Цикл
		ФайлДанных = Новый Файл(ПолноеИмя);
		Результат.ФайлЕсть = ФайлДанных.Существует();
		Если Результат.ФайлЕсть Тогда
			Результат.Данные = ОбъектИзФайлаДанных(ПолноеИмя);
			Если Результат.Данные <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли Не ЕстьВременныйФайлЗамены(ПолноеИмя) Тогда
			Возврат Результат;
		Иначе
			// Идет замена файла - повтор после паузы.
			Результат.ФайлЕсть = Ложь;
		КонецЕсли;
		Если НомерПопытки < ЧислоПопыток Тогда
			ОбменДаннымиСервер.Пауза(1);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает JSON-файл в Соответствие; текст читается в UTF-8 (с BOM и без).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - объект JSON; Неопределено - файл не прочитан или не объект JSON.
//
Функция ОбъектИзФайлаДанных(Знач ПолноеИмя)

	ТекстФайла = "";
	Попытка
		ЧтениеФайла = Новый ЧтениеТекста(ПолноеИмя, КодировкаТекста.UTF8);
		Попытка
			ТекстФайла = ЧтениеФайла.Прочитать();
		Исключение
			ЧтениеФайла.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		ЧтениеФайла.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(ТекстФайла) <> Тип("Строка") Или ПустаяСтрока(ТекстФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеОбъекта = Новый ЧтениеJSON;
	ЧтениеОбъекта.УстановитьСтроку(ТекстФайла);
	Попытка
		Объект = ПрочитатьJSON(ЧтениеОбъекта, Истина);
	Исключение
		ЧтениеОбъекта.Закрыть();
		Возврат Неопределено;
	КонецПопытки;
	ЧтениеОбъекта.Закрыть();

	Возврат ?(ТипЗнч(Объект) = Тип("Соответствие"), Объект, Неопределено);

КонецФункции

// Есть ли рядом с файлом временный файл его замены «<имя>.<УИД>.tmp».
//
// Параметры:
//  ПолноеИмя - Строка - полное имя заменяемого файла.
//
// Возвращаемое значение:
//  Булево - Истина, если временный файл есть.
//
Функция ЕстьВременныйФайлЗамены(Знач ПолноеИмя)

	ФайлДанных = Новый Файл(ПолноеИмя);
	Попытка
		Возврат НайтиФайлы(ФайлДанных.Путь, ФайлДанных.Имя + ".*.tmp", Ложь).Количество() > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Атомарно записывает JSON-файл (спека Е.2): временный файл «<имя>.<УИД>.tmp» в той же папке ->
// удаление старого -> переименование временного. Замена не удалась (файл открыт читателем) - до 3 попыток
// с паузой 1 с. Временный файл при неудаче удаляется.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//  Данные    - Структура, Соответствие - записываемый объект (строки, числа, булевы, массивы).
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - файл записан.
//
Функция ОшибкаАтомарнойЗаписиФайла(Знач ПолноеИмя, Знач Данные)

	ТекстДанных = ar_JSON.ВЗначениеJSON(Данные);
	Если ПустаяСтрока(ТекстДанных) Тогда
		Возврат НСтр("ru = 'данные не сериализуются в JSON'");
	КонецЕсли;

	ВременноеИмя = ПолноеИмя + "." + Строка(Новый УникальныйИдентификатор) + ".tmp";
	Попытка
		ЗаписьФайла = Новый ЗаписьТекста(ВременноеИмя, КодировкаТекста.UTF8, Символы.ПС, Ложь);
		Попытка
			ЗаписьФайла.Записать(ТекстДанных);
		Исключение
			ЗаписьФайла.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		ЗаписьФайла.Закрыть();
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		УдалитьФайлБезОшибки(ВременноеИмя);
		Возврат ТекстОшибки;
	КонецПопытки;

	ТекстОшибки = "";
	ЧислоПопыток = 3;
	Для НомерПопытки = 1 По ЧислоПопыток Цикл
		Попытка
			Если ФайлСуществует(ПолноеИмя) Тогда
				УдалитьФайлы(ПолноеИмя);
			КонецЕсли;
			ПереместитьФайл(ВременноеИмя, ПолноеИмя);
			Возврат "";
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Если НомерПопытки < ЧислоПопыток Тогда
			ОбменДаннымиСервер.Пауза(1);
		КонецЕсли;
	КонецЦикла;

	УдалитьФайлБезОшибки(ВременноеИмя);
	Возврат ТекстОшибки;

КонецФункции

// Есть ли файл или каталог на диске.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФайлСуществует(Знач ПолноеИмя)

	ПроверяемыйФайл = Новый Файл(ПолноеИмя);
	Возврат ПроверяемыйФайл.Существует();

КонецФункции

// Удаляет файл; ошибку удаления не передает: остаток временного файла удалит регламент разбора.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//
Процедура УдалитьФайлБезОшибки(Знач ПолноеИмя)

	Попытка
		УдалитьФайлы(ПолноеИмя);
	Исключение
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_tmp_not_deleted",
			ПолноеИмя + "; " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

КонецПроцедуры

// Подкаталоги первого уровня каталога документов, по которым может быть живое задание разбора (спека А.5):
// метка времени «ГГГГММДД_ЧЧММСС» в конце имени не старше срока ожидания + 5 дней; без метки - берутся все.
//
// Параметры:
//  КаталогДокументов - Строка - каталог из настройки.
//
// Возвращаемое значение:
//  Массив из Строка - полные пути подкаталогов, по имени.
//
Функция ЖивыеПодкаталогиДоговоров(Знач КаталогДокументов)

	ГраницаСвежести = ТекущаяДатаСеанса() - (СрокОжиданияВыгрузкиДней() + ЗапасДнейПоискаЗаданий()) * СекундВСутках();

	ИменаПодкаталогов = Новый СписокЗначений;
	Для Каждого НайденныйФайл Из НайтиФайлы(КаталогДокументов, "*", Ложь) Цикл
		Если Не НайденныйФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		МеткаВремени = МеткаВремениИмениПодкаталога(НайденныйФайл.Имя);
		Если ЗначениеЗаполнено(МеткаВремени) И МеткаВремени < ГраницаСвежести Тогда
			Продолжить;
		КонецЕсли;
		ИменаПодкаталогов.Добавить(НайденныйФайл.ПолноеИмя);
	КонецЦикла;
	ИменаПодкаталогов.СортироватьПоЗначению();

	Возврат ИменаПодкаталогов.ВыгрузитьЗначения();

КонецФункции

// Метка времени в конце имени подкаталога сбора «... - ГГГГММДД_ЧЧММСС».
//
// Параметры:
//  ИмяПодкаталога - Строка - имя подкаталога.
//
// Возвращаемое значение:
//  Дата - метка; пустая дата - метки нет.
//
Функция МеткаВремениИмениПодкаталога(Знач ИмяПодкаталога)

	ДлинаМетки = 15; // ГГГГММДД_ЧЧММСС
	ДлинаДаты = 8;
	ДлинаВремени = 6;
	Метка = Прав(ИмяПодкаталога, ДлинаМетки);
	Если СтрДлина(Метка) <> ДлинаМетки Или Сред(Метка, ДлинаДаты + 1, 1) <> "_" Тогда
		Возврат '00010101';
	КонецЕсли;
	ЦифрыМетки = Лев(Метка, ДлинаДаты) + Прав(Метка, ДлинаВремени);
	Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЦифрыМетки) Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(ЦифрыМетки);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Число секунд в сутках - для сроков в файлах разбора (сутки ожидания очереди, срок ожидания выгрузки).
//
// Возвращаемое значение:
//  Число.
//
Функция СекундВСутках()

	Возврат 86400;

КонецФункции

// Запас дней поиска заданий сверх срока ожидания выгрузки: до трех суточных повторов с запасом (спека В.2).
//
// Возвращаемое значение:
//  Число - дней.
//
Функция ЗапасДнейПоискаЗаданий()

	Возврат 5;

КонецФункции

// Задания разбора договора в живых подкаталогах (спека А.5): отбор по contract_uuid, имя папки не используется
// (номер в имени очищен, имя контрагента обрезано).
//
// Параметры:
//  КаталогДокументов - Строка - каталог из настройки.
//  Договор           - СправочникСсылка.ДоговорыКонтрагентов - договор.
//
// Возвращаемое значение:
//  Массив из Структура - {Подкаталог: Строка; Задание: Соответствие; Состояние: Соответствие, Неопределено}.
//
Функция ЗаданияРазбораДоговора(Знач КаталогДокументов, Знач Договор)

	УИДДоговора = НРег(Строка(Договор.УникальныйИдентификатор()));
	Задания = Новый Массив;
	Для Каждого Подкаталог Из ЖивыеПодкаталогиДоговоров(КаталогДокументов) Цикл
		Чтение = ПрочитатьФайлДанных(ПутьЗаданияРазбора(Подкаталог));
		Если Чтение.Данные = Неопределено
			Или НРег(СокрЛП(ПолеОбъекта(Чтение.Данные, "contract_uuid"))) <> УИДДоговора Тогда
			Продолжить;
		КонецЕсли;
		Состояние = ПрочитатьФайлДанных(ПутьСостоянияРазбора(Подкаталог)).Данные;
		Задания.Добавить(Новый Структура("Подкаталог, Задание, Состояние", Подкаталог, Чтение.Данные, Состояние));
	КонецЦикла;
	Возврат Задания;

КонецФункции

// Есть ли готовый список выгрузки «ДО\<папка>\Выгрузка ДО.json» в подкаталоге договора.
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//
// Возвращаемое значение:
//  Булево - Истина, если хоть в одной папке выгрузки есть список.
//
Функция ЕстьСписокВыгрузки(Знач Подкаталог)

	Возврат ПапкиСписковВыгрузки(Подкаталог).Количество() > 0;

КонецФункции

// Папки выгрузки ДО со списком «Выгрузка ДО.json», по имени (номер списка в ref - по этому порядку).
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//
// Возвращаемое значение:
//  Массив из Строка - полные пути папок.
//
Функция ПапкиСписковВыгрузки(Знач Подкаталог)

	КаталогДО = Подкаталог + "\" + ИмяПапкиДО();
	Папки = Новый СписокЗначений;
	Попытка
		НайденныеФайлы = НайтиФайлы(КаталогДО, "*", Ложь);
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		Если НайденныйФайл.ЭтоКаталог()
			И ФайлСуществует(НайденныйФайл.ПолноеИмя + "\" + ИмяФайлаСпискаВыгрузки()) Тогда
			Папки.Добавить(НайденныйФайл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Папки.СортироватьПоЗначению();
	Возврат Папки.ВыгрузитьЗначения();

КонецФункции

// Закончен ли разбор по состоянию: в «Состоянии разбора» заполнено finished.
//
// Параметры:
//  Состояние - Соответствие, Неопределено - состояние разбора.
//
// Возвращаемое значение:
//  Булево.
//
Функция РазборЗакончен(Знач Состояние)

	Возврат Не ПустаяСтрока(ПолеОбъекта(Состояние, "finished"));

КонецФункции

// Жив ли запуск-владелец разбора (спека Е.4): heartbeat моложе 15 минут, или статус запуска не терминальный
// и heartbeat моложе 2 ч. Свежий heartbeat важнее статуса ядра: долгий вызов инструмента не обновляет пульс
// ядра, и запуск может быть помечен «Прерван», пока инструмент еще копирует файлы.
//
// Параметры:
//  Состояние - Соответствие - состояние разбора (run_id, heartbeat).
//
// Возвращаемое значение:
//  Булево - Истина, если запуск жив.
//
Функция ЗапускРазбораЖив(Знач Состояние)

	МоментПульса = ДатаИзСтрокиФайла(ПолеОбъекта(Состояние, "heartbeat"));
	Если Не ЗначениеЗаполнено(МоментПульса) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПрошлоСекунд = ТекущаяДатаСеанса() - МоментПульса;
	СвежийПульсСек = 900; // 15 минут (спека Е.4).
	ПределПульсаСек = 7200; // 2 часа (спека Е.4).
	Если ПрошлоСекунд < СвежийПульсСек Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПрошлоСекунд >= ПределПульсаСек Тогда
		Возврат Ложь;
	КонецЕсли;

	СтатусЗапуска = СтатусЗапускаАгента(ПолеОбъекта(Состояние, "run_id"));
	Возврат СтатусЗапуска <> Неопределено И Не ar_AuditЗапуски.ЭтоТерминальныйСтатусЗапуска(СтатусЗапуска);

КонецФункции

// Статус запуска агента по идентификатору (РегистрСведений.ar_Запуски, ключ записи); чтение привилегированно
// с парным сбросом, как ШапкаЗапуска.
//
// Параметры:
//  ИдентификаторЗапуска - Строка - run_id.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_СтатусЗапуска, Неопределено - статус; Неопределено - записи нет (считается
//  терминальным).
//
Функция СтатусЗапускаАгента(Знач ИдентификаторЗапуска)

	Если ПустаяСтрока(ИдентификаторЗапуска) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска";
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", СокрЛП(ИдентификаторЗапуска));

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Удаляет временные файлы замены (*.tmp) старше суток в папках задачи подкаталога: корень, «Разбор»,
// папки выгрузки ДО (спека Е.2). Ошибка удаления не мешает обходу.
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//
Процедура УдалитьСтарыеВременныеФайлы(Знач Подкаталог)

	Папки = Новый Массив;
	Папки.Добавить(Подкаталог);
	Папки.Добавить(Подкаталог + "\" + ИмяПапкиРазбора());
	// Папки списков выгрузки ДО; папки ДО нет (сбор без задания разбора) - удалять в ней нечего.
	КаталогДО = Подкаталог + "\" + ИмяПапкиДО();
	Если ФайлСуществует(КаталогДО) Тогда
		Для Каждого НайденныйФайл Из НайтиФайлы(КаталогДО, "*", Ложь) Цикл
			Если НайденныйФайл.ЭтоКаталог() Тогда
				Папки.Добавить(НайденныйФайл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ГраницаВремени = ТекущаяУниверсальнаяДата() - СекундВСутках();
	Для Каждого Папка Из Папки Цикл
		Попытка
			ВременныеФайлы = НайтиФайлы(Папка, "*.tmp", Ложь);
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого ВременныйФайл Из ВременныеФайлы Цикл
			Если ВременныйФайл.ПолучитьУниверсальноеВремяИзменения() < ГраницаВремени Тогда
				УдалитьФайлБезОшибки(ВременныйФайл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗаданиеРазбораДО

// Шаг сбора do_task (спека А.2): в подкаталоге договора создаются пустая папка «ДО» и «Задание разбора
// ДО.json» со статусом waiting. Сбой не роняет сбор: status = error, причина - в журнале сбора.
//
// Параметры:
//  Сбор - Структура - контекст сбора (изменяется КаталогДО).
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагЗаданияРазбора(Знач Сбор)

	КодШага = КодШагаЗаданияРазбора();
	Шаг = НовыйШагОтвета(КодШага);
	КаталогДО = Сбор.КаталогПодкаталога + "\" + ИмяПапкиДО();
	СоздатьКаталог(КаталогДО);

	РеквизитыДоговора = Сбор.РеквизитыДоговора;
	ИННКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДоговора.Владелец, "ИНН");
	ТекущийМомент = СтрокаДатыФайла(ТекущаяДатаСеанса());

	Задание = Новый Структура;
	Задание.Вставить("version", 1);
	Задание.Вставить("contract_uuid", Строка(Сбор.Предмет.УникальныйИдентификатор()));
	Задание.Вставить("contract_number", СокрЛП(РеквизитыДоговора.Номер));
	Задание.Вставить("contract_date", СтрокаДатыФайла(РеквизитыДоговора.Дата));
	// Код договора в ДО (ключ обмена БИТ-ДО): по нему обработка выгрузки ДО подставляет договор, когда
	// пользователь выбирает папку «ДО» этого задания (agentrunner-498). Пусто - договор не связан с ДО.
	Задание.Вставить("do_contract_code", СокрЛП(РеквизитыДоговора.sd_КодДО));
	Задание.Вставить("counterparty_inn", СокрЛП(Строка(ИННКонтрагента)));
	УИДИнициатора = "";
	Если ЗначениеЗаполнено(Сбор.Инициатор) Тогда
		УИДИнициатора = Строка(Сбор.Инициатор.УникальныйИдентификатор());
	КонецЕсли;
	Задание.Вставить("initiator_uuid", УИДИнициатора);
	Задание.Вставить("created", ТекущийМомент);
	Задание.Вставить("status", СтатусЗаданияОжидает());
	Задание.Вставить("status_changed", ТекущийМомент);
	Задание.Вставить("attempts", 0);

	ОшибкаЗаписи = ОшибкаАтомарнойЗаписиФайла(ПутьЗаданияРазбора(Сбор.КаталогПодкаталога), Задание);
	Если Не ПустаяСтрока(ОшибкаЗаписи) Тогда
		ВызватьИсключение ОшибкаЗаписи;
	КонецЕсли;

	Сбор.КаталогДО = КаталогДО;
	Шаг.status = "ok";
	Шаг.message = ТекстПросьбыВыгрузитьИзДО(КаталогДО);
	ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШагаЖурнала(КодШага), "", "", ИмяФайлаЗаданияРазбора(), 0,
		НСтр("ru = 'создано'") + ". " + Шаг.message);
	Возврат Шаг;

КонецФункции

// Строка для итога запуска: куда выгрузить документы из ДО обработкой 472 (спека А.2, Д).
//
// Параметры:
//  КаталогДО - Строка - папка «ДО» подкаталога договора.
//
// Возвращаемое значение:
//  Строка - текст.
//
Функция ТекстПросьбыВыгрузитьИзДО(Знач КаталогДО)

	ШаблонТекста = НСтр("ru = 'Выгрузите документы из ДО обработкой «Выгрузка документов по договору» в каталог %1'");
	Возврат СтрШаблон(ШаблонТекста, КаталогДО);

КонецФункции

