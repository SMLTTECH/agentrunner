КонецФункции

// Защита сбора от путаницы режимов (спека А.4): у договора есть задание queued моложе суток, разбор по нему
// не закончен - модель вызвала сбор вместо разбора.
//
// Параметры:
//  КаталогДокументов - Строка - каталог из настройки.
//  Договор           - СправочникСсылка.ДоговорыКонтрагентов - договор.
//
// Возвращаемое значение:
//  Булево - Истина, если разбор ожидает вызова.
//
Функция ЕстьОжидающийРазбор(Знач КаталогДокументов, Знач Договор)

	ГраницаСвежести = ТекущаяДатаСеанса() - СекундВСутках();
	Для Каждого НайденноеЗадание Из ЗаданияРазбораДоговора(КаталогДокументов, Договор) Цикл
		ВОчереди = ПолеОбъекта(НайденноеЗадание.Задание, "status") = СтатусЗаданияВОчереди();
		ПоставленоНедавно = ДатаИзСтрокиФайла(ПолеОбъекта(НайденноеЗадание.Задание, "status_changed"))
			>= ГраницаСвежести;
		Если ВОчереди И ПоставленоНедавно И Не РазборЗакончен(НайденноеЗадание.Состояние) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Обновляет поля задания разбора и записывает файл задания атомарно; сбой записи - служебный лог (файл задания
// пишут только сбор и регламент, спека Е.1).
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//  Задание    - Соответствие - задание (изменяется).
//  Поля       - Структура - новые значения полей.
//
// Возвращаемое значение:
//  Булево - Истина, если файл записан.
//
Функция ЗаписатьЗаданиеРазбора(Знач Подкаталог, Знач Задание, Знач Поля)

	Для Каждого Поле Из Поля Цикл
		Задание.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Если Поля.Свойство("status") Тогда
		Задание.Вставить("status_changed", СтрокаДатыФайла(ТекущаяДатаСеанса()));
	КонецЕсли;

	ОшибкаЗаписи = ОшибкаАтомарнойЗаписиФайла(ПутьЗаданияРазбора(Подкаталог), Задание);
	Если ПустаяСтрока(ОшибкаЗаписи) Тогда
		Возврат Истина;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_task_write_failed",
		СтрШаблон("Подкаталог=%1; %2", Подкаталог, ОшибкаЗаписи), "Ошибка");
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область РегламентРазбораВыгрузокДО

// Команда «Разбор выгрузок ДО» (ar_РазборВыгрузокДО, спека В): регламентное задание БСП обходит живые
// подкаталоги каталога документов и по файлу задания каждого решает - поставить договор в очередь агента,
// ждать, отметить просрочку, сбой или завершение. Каждый подкаталог - в своей Попытка: сбой на одном не
// останавливает обход. Разбор выключен - команда сразу выходит.
//
Процедура ВыполнитьРазборВыгрузокДО()

	Если Не РазборВыгрузокДОВключен() Тогда
		Возврат;
	КонецЕсли;

	КаталогДокументов = КаталогДокументовИзНастройки();
	Если ПустаяСтрока(КаталогДокументов) Тогда
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_no_directory",
			СтрШаблон(НСтр("ru = 'Не задан каталог документов (доп. настройка «%1»).'"), КлючНастройкиКаталога()),
			"Предупреждение");
		Возврат;
	КонецЕсли;

	Попытка
		Подкаталоги = ЖивыеПодкаталогиДоговоров(КаталогДокументов);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_directory_unavailable",
			КаталогДокументов + "; " + ТекстОшибки, "Ошибка");
		Возврат;
	КонецПопытки;

	Обход = Новый Структура("ПоискАгента", Неопределено);
	Для Каждого Подкаталог Из Подкаталоги Цикл
		// Каталог документов общий: подкаталоги без задания разбора (чужие, сбор без разбора) - одна проверка
		// файла вместо поиска временных файлов в трех папках. Файл задания в миг замены отсутствует -
		// подкаталог обработается на следующем запуске.
		Если Не ФайлСуществует(ПутьЗаданияРазбора(Подкаталог)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			УдалитьСтарыеВременныеФайлы(Подкаталог);
			ОбработатьЗаданиеРазбораРегламентом(Обход, Подкаталог);
		Исключение
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_step_failed",
				СтрШаблон("Подкаталог=%1; %2", Подкаталог,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), "Ошибка");
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Решение регламента по одному подкаталогу (спека В.2): waiting без начатого разбора - постановка, когда
// готов список выгрузки, или просрочка; queued и waiting с начатым разбором - по таблице Е.4.
//
// Параметры:
//  Обход      - Структура - контекст обхода: ПоискАгента - результат поиска агента (ищется один раз за обход).
//  Подкаталог - Строка - подкаталог договора.
//
Процедура ОбработатьЗаданиеРазбораРегламентом(Знач Обход, Знач Подкаталог)

	Чтение = ПрочитатьФайлДанных(ПутьЗаданияРазбора(Подкаталог));
	Если Чтение.Данные = Неопределено Тогда
		Если Чтение.ФайлЕсть Тогда
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_task_broken",
				СтрШаблон(НСтр("ru = 'Файл задания разбора не читается: %1'"), ПутьЗаданияРазбора(Подкаталог)),
				"Ошибка");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Задание = Чтение.Данные;
	СтатусЗадания = ПолеОбъекта(Задание, "status");
	Если СтатусЗадания <> СтатусЗаданияОжидает() И СтатусЗадания <> СтатусЗаданияВОчереди() Тогда
		Возврат;
	КонецЕсли;

	ЧтениеСостояния = ПрочитатьФайлДанных(ПутьСостоянияРазбора(Подкаталог));
	Состояние = ЧтениеСостояния.Данные;
	Если Состояние = Неопределено И ЧтениеСостояния.ФайлЕсть Тогда
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_state_broken",
			СтрШаблон(НСтр("ru = 'Файл состояния разбора не читается: %1'"), ПутьСостоянияРазбора(Подкаталог)),
			"Ошибка");
		Возврат;
	КонецЕсли;

	Если СтатусЗадания = СтатусЗаданияВОчереди() Или Состояние <> Неопределено Тогда
		РешитьПоСостояниюРазбора(Обход, Подкаталог, Задание, Состояние);
		Возврат;
	КонецЕсли;

	// waiting без начатого разбора.
	Создано = ДатаИзСтрокиФайла(ПолеОбъекта(Задание, "created"));
	Если Создано + СрокОжиданияВыгрузкиДней() * СекундВСутках() < ТекущаяДатаСеанса() Тогда
		Если ЗаписатьЗаданиеРазбора(Подкаталог, Задание, Новый Структура("status", СтатусЗаданияПросрочено())) Тогда
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_expired",
				СтрШаблон(НСтр("ru = 'Срок ожидания выгрузки ДО истек: %1'"), Подкаталог), "Предупреждение");
		КонецЕсли;
	ИначеЕсли ЕстьСписокВыгрузки(Подкаталог) Тогда
		ПоставитьРазборВОчередь(Обход, Подкаталог, Задание);
	Иначе
		// Выгрузки еще нет - ждать.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Решение регламента по таблице Е.4 спеки (строки сверху вниз, срабатывает первая подходящая).
//
// Параметры:
//  Обход      - Структура - контекст обхода.
//  Подкаталог - Строка - подкаталог договора.
//  Задание    - Соответствие - задание разбора.
//  Состояние  - Соответствие, Неопределено - состояние разбора.
//
Процедура РешитьПоСостояниюРазбора(Знач Обход, Знач Подкаталог, Знач Задание, Знач Состояние)

	Если РазборЗакончен(Состояние) Тогда
		Если ПолеОбъекта(Состояние, "mail") = СтатусПисьмаОжидает()
			И ПустаяСтрока(ПолеОбъекта(Задание, "mail_sent")) Тогда
			Если ЗапускРазбораЖив(Состояние) Тогда
				Возврат; // Письмо отправляет сам запуск.
			КонецЕсли;
			ОтправитьПисьмоИтогаРазбора(Подкаталог, Задание, Состояние, Ложь);
			Задание.Вставить("mail_sent", СтрокаДатыФайла(ТекущаяДатаСеанса()));
		КонецЕсли;
		ЗаписатьЗаданиеРазбора(Подкаталог, Задание, Новый Структура("status", СтатусЗаданияРазобрано()));
		Возврат;
	КонецЕсли;

	Если Состояние = Неопределено Тогда
		ПоставленоВОчередь = ДатаИзСтрокиФайла(ПолеОбъекта(Задание, "status_changed"));
		Если ПоставленоВОчередь + СекундВСутках() > ТекущаяДатаСеанса() Тогда
			Возврат; // Очередь ядра еще не разобрана.
		КонецЕсли;
	ИначеЕсли ЗапускРазбораЖив(Состояние) Тогда
		Возврат;
	Иначе
		// Состояние есть, запуск мертв - повторная постановка сразу.
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_run_dead",
			СтрШаблон("Подкаталог=%1; run_id=%2", Подкаталог, ПолеОбъекта(Состояние, "run_id")), "Предупреждение");
	КонецЕсли;

	Если ПолеОбъекта(Задание, "attempts", 0) >= МаксимумПостановокРазбора() Тогда
		Если ЗаписатьЗаданиеРазбора(Подкаталог, Задание, Новый Структура("status", СтатусЗаданияСбой())) Тогда
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_failed",
				СтрШаблон(НСтр("ru = 'Разбор выгрузки ДО не завершен после %1 постановок: %2'"),
					МаксимумПостановокРазбора(), Подкаталог), "Ошибка");
			ОтправитьПисьмоИтогаРазбора(Подкаталог, Задание, Состояние, Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПоставитьРазборВОчередь(Обход, Подкаталог, Задание);

КонецПроцедуры

// Ставит договор задания в очередь агента разбора (спека В.3): ar_ЗапросыАгентам.Отправить с комментарием
// «#РазборВыгрузкиДО <путь задания>». queued - статус queued, время и attempts + 1; already_queued и in_work -
// статус не меняется (договор уже в очереди или в работе); прочие итоги - служебный лог.
//
// Параметры:
//  Обход      - Структура - контекст обхода (ПоискАгента заполняется при первом вызове).
//  Подкаталог - Строка - подкаталог договора.
//  Задание    - Соответствие - задание разбора.
//
Процедура ПоставитьРазборВОчередь(Знач Обход, Знач Подкаталог, Знач Задание)

	Договор = ДоговорЗадания(Задание);
	Если Договор = Неопределено Тогда
		Если ЗаписатьЗаданиеРазбора(Подкаталог, Задание, Новый Структура("status", СтатусЗаданияСбой())) Тогда
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_failed",
				СтрШаблон(НСтр("ru = 'Договор задания разбора удален или помечен на удаление: %1'"), Подкаталог),
				"Ошибка");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Обход.ПоискАгента = Неопределено Тогда
		Обход.ПоискАгента = АгентРазбораВыгрузок();
	КонецЕсли;
	Если Обход.ПоискАгента.Код <> "ok" Тогда
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_no_agent",
			СтрШаблон("Подкаталог=%1; Код=%2; Агенты=%3", Подкаталог, Обход.ПоискАгента.Код,
				СтрСоединить(Обход.ПоискАгента.Наименования, ", ")), "Ошибка", , Договор);
		Возврат;
	КонецЕсли;

	ПараметрыОтправки = Новый Структура("Агент, Комментарий", Обход.ПоискАгента.Агент,
		МаркерРазбораВыгрузкиДО() + " " + ПутьЗаданияРазбора(Подкаталог));
	Итоги = ar_ЗапросыАгентам.Отправить(Договор, ПараметрыОтправки);

	ИтогОтправки = "error";
	ТекстИтога = "";
	Для Каждого СтрокаИтога Из Итоги Цикл
		ИтогОтправки = СтрокаИтога.Итог;
		ТекстИтога = СтрокаИтога.Текст;
		Прервать;
	КонецЦикла;

	Если ИтогОтправки = "queued" Тогда
		Поля = Новый Структура("status, attempts", СтатусЗаданияВОчереди(), ПолеОбъекта(Задание, "attempts", 0) + 1);
		ЗаписатьЗаданиеРазбора(Подкаталог, Задание, Поля);
	ИначеЕсли ИтогОтправки = "already_queued" Или ИтогОтправки = "in_work" Тогда
		// Договор уже в очереди или в работе (сбой прошлого цикла, ручной запуск, другое задание) - статус
		// не меняется: разбор найдет задание сам (спека Г.1), регламент доведет его по таблице Е.4.
		Возврат;
	Иначе
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_enqueue_failed",
			СтрШаблон("Подкаталог=%1; Итог=%2; %3", Подкаталог, ИтогОтправки, ТекстИтога), "Ошибка", , Договор);
	КонецЕсли;

КонецПроцедуры

// Договор задания по contract_uuid; удален или помечен на удаление - Неопределено.
//
// Параметры:
//  Задание - Соответствие - задание разбора.
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов, Неопределено.
//
Функция ДоговорЗадания(Знач Задание)

	Попытка
		УИДДоговора = Новый УникальныйИдентификатор(СокрЛП(ПолеОбъекта(Задание, "contract_uuid")));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИДДоговора);
	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ПометкаУдаления");
	Если ПометкаУдаления <> Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Договор;

КонецФункции

// Маркер комментария запуска разбора: по нему модель выбирает инструмент разбора (спека Д).
//
// Возвращаемое значение:
//  Строка - маркер.
//
Функция МаркерРазбораВыгрузкиДО()

	Возврат "#РазборВыгрузкиДО";

КонецФункции

