#Область ПрограммныйИнтерфейс

// Пакет инструментов AgentRunner «Сбор документов для расторжения договора» (задача
// agentrunner-471). Один инструмент contract_termination_collect: по договору -
// предмету запуска - собирает в каталог из доп. настроек полный комплект документов
// для расторжения (спека agentrunner-471 п.3):
//   * акт сверки с 01.01.2020 (настройка) по конец текущего дня - печатная форма
//     «Акт сверки» в XLSX, сам акт остается в базе проведенным документом
//     (по образцу Документы.sd_СогласованиеРасторженияДоговора.СоздатьАктСверкиРасчетов,
//     у образца дата начала зашита 2021 годом); повторный запуск в тот же день
//     берет акт, созданный агентом сегодня (решение человека 19.11.2026);
//   * дополнительный отчет «Отчет по платежным поручениям» - программная компоновка
//     варианта «Основной» по договору, XLSX;
//   * вложения документов из табличной части акта сверки ПоДаннымОрганизации
//     (реквизит Документ) - папка «Документы акта сверки» (agentrunner-487, 488);
//   * вложения документов КС-2, ОтчетКомитентуОПродажах и корректировочных КС-2
//     по договору (у корректировочных своих хранилищ файлов нет - берутся файлы
//     документа-основания, решение человека 19.11.2026); документ, уже выгруженный
//     из акта сверки, повторно не сохраняется (agentrunner-487);
//   * журнал работы «Журнал сбора документов.txt» в корне подкаталога договора
//     (решение человека 19.11.2026).
//
// Разбор выгрузки ДО (agentrunner-480): сбор создает папку «ДО» и «Задание разбора ДО.json»;
// обработка 472 выгружает туда документы из ДО и пишет «Выгрузка ДО.json»; регламентная
// команда ar_РазборВыгрузокДО ставит договор в очередь агента с комментарием «#РазборВыгрузкиДО»;
// инструменты contract_termination_documents_sort и contract_termination_documents_resolve раскладывают файлы по папкам
// «Разбор\<категория>» и пишут инициатору письмо с итогом. Состояние - в файлах рядом
// с выгрузкой, без блокировок (спека agentrunner-480, раздел Е). Шаг документов акта сверки
// выгружает и файлы заявок на расходование ДС по списаниям с расчетного счета (раздел Ж).
//
// Команда для пользователя - отдельная обработка ar_СобратьДокументыРасторжения
// (решение человека 19.11.2026): пакет и команда разнесены, чтобы в подменю
// «Заполнить» договора не было служебных команд пакета. Вид регистрации пакета -
// ДополнительнаяОбработка без назначения: в формах договора пакет не появляется.
//
// Регистрация в БСП «Дополнительные отчеты и обработки». БезопасныйРежим = Ложь -
// ядро вызывает инструменты пакета в сеансе запуска агента, безопасный режим
// запрещает запись файлов в каталог (решение человека 2026-10-01 по пакетам - ядро
// пишет предупреждение package_registered_unsafe_mode). Команда
// «ar_ToolPack» - маркер принадлежности пакета AgentRunner (см.
// .docs/Контракт-пакета-tools.md 1.2): ядро отбирает кандидатов на регистрацию
// запросом к ТЧ Команды, вид обработки не проверяется.
//
// Манифест - схема 2 (русские ключи). Уровень риска contract_termination_collect -
// «Запись» без подтверждения с обоснованием (решение человека 19.11.2026):
// запуск - по кнопке пользователя на конкретном договоре, создается только акт
// сверки с маркером в комментарии, файлы пишутся в новый подкаталог.
//
// Латиницей - только внешний протокол: имя инструмента contract_termination_collect,
// ключи JSON (directory, log_file, saved_files, steps, status, ...), коды ошибок
// и коды шагов (reconciliation_act, payment_report, act_documents, ks2,
// commission_reports, ks2_corrections). Имена процедур, переменных и тексты - по-русски.
//
// Исполнение: весь код - серверный (ВызовСерверногоМетода); привилегированный режим
// поднимается точечно с парным сбросом (чтение ar_Запуски). Акт сверки создается
// и отчет компонуется по правам сеанса агента (RLS статей оборотов и роли
// sd_ПросмотрЗП режут состав отчета - осознанно, спека п. «Права»).

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки» (см. .docs/Контракт-пакета-tools.md 1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	// 1.0.0 - первая версия (agentrunner-471): инструмент
	// contract_termination_collect и настройки каталога/даты начала периода.
	ПараметрыРегистрации.Версия = ВерсияПакета();
	ПараметрыРегистрации.Наименование =
		НСтр("ru = 'AgentRunner: пакет сбора документов для расторжения договора'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Пакет инструментов contract_termination_collect: агент собирает по договору
		|комплект документов для расторжения - акт сверки, отчет по платежным поручениям
		|и вложения КС-2, отчетов комитенту и корректировочных КС-2 - в каталог
		|из доп. настроек. Команда для пользователя - обработка
		|«AgentRunner: собрать документы для расторжения договора». Инструменты contract_termination_documents_sort
		|и contract_termination_documents_resolve и регламентная команда «Разбор выгрузок ДО» раскладывают выгрузку
		|из ДО по папкам «относится к договору / не относится / не распознано / спорно».'");
	// Запись файлов и создание акта сверки в сеансе агента недоступны в безопасном режиме.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	КомандаМаркера = ПараметрыРегистрации.Команды.Добавить();
	КомандаМаркера.Представление = НСтр("ru = 'Служебная: маркер пакета AgentRunner (не для расписания)'");
	КомандаМаркера.Идентификатор = "ar_ToolPack";
	КомандаМаркера.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаМаркера.ПоказыватьОповещение = Ложь;

	// Разбор выгрузок ДО (agentrunner-480, спека В.1): команда запускается регламентным
	// заданием БСП, расписание задает администратор в карточке обработки. Идентификатор
	// после релиза не менять - на нем расписания.
	КомандаРазбора = ПараметрыРегистрации.Команды.Добавить();
	КомандаРазбора.Представление = НСтр("ru = 'AgentRunner Пакет инструментов: Разбор выгрузок ДО'");
	КомандаРазбора.Идентификатор = ИдентификаторКомандыРазбора();
	КомандаРазбора.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаРазбора.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Версия пакета - одна для регистрации обработки (СведенияОВнешнейОбработке)
// и манифеста (ar_ОписаниеИнструментов), правило «версия регистрации =
// версия манифеста» (решение человека, agentrunner-213).
//
// Возвращаемое значение:
//  Строка - версия пакета.
//
Функция ВерсияПакета()

	Возврат "1.1.3";

КонецФункции

// Обработчик команд БСП «Дополнительные отчеты и обработки». Команда "ar_ToolPack" -
// маркерная: существует только для отбора кандидатов на регистрацию пакета ядром
// AgentRunner, интерактивный вызов не предусмотрен - обработчик только поясняет.
// Команда "ar_РазборВыгрузокДО" - регламентный разбор выгрузок ДО (agentrunner-480).
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетРасторжениеДоговора.ВыполнитьКоманду", "contract_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,
				|прикладного действия по этой команде не предусмотрено.'"));
	ИначеЕсли ИдентификаторКоманды = ИдентификаторКомандыРазбора() Тогда
		ВыполнитьРазборВыгрузокДО();
	Иначе
		ar_СлужебныйЛог.Записать("ar_ПакетРасторжениеДоговора.ВыполнитьКоманду", "contract_command_unknown",
			ИдентификаторКоманды, "Предупреждение");
	КонецЕсли;

КонецПроцедуры

// Манифест пакета инструментов - контракт AgentRunner, схема 2 (см.
// .docs/Контракт-пакета-tools.md 1.4). Вызывается ядром при регистрации/
// переподтверждении пакета.
//
// Возвращаемое значение:
//  Структура - манифест пакета:
//   * ВерсияСхемы, ПространствоИмён, Версия, Категории, Инструменты, Настройки.
//
Функция ar_ОписаниеИнструментов() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("ВерсияСхемы", 2);
	Манифест.Вставить("ПространствоИмён", "contract_termination");
	// 1.0.0 - первая версия (agentrunner-471).
	// 1.0.2 - исправлен текст запроса документов вложений; пульс запуска и время
	// шагов во время сбора (agentrunner-483).
	// 1.0.3 - файлы документов шага одним запросом на шаг вместо запроса на каждый
	// документ (agentrunner-485).
	// 1.0.4 - уточнены комментарии выборки файлов (agentrunner-486).
	// 1.0.5 - вложения документов из табличных частей акта сверки (шаг
	// act_documents); КС-2, отчеты комитенту и основания корректировочных,
	// уже выгруженные из акта, повторно не сохраняются (agentrunner-487).
	// 1.0.6 - документы акта только из табличной части ПоДаннымОрганизации
	// (agentrunner-488).
	// 1.1.0 - разбор выгрузки ДО: задание разбора при сборе, регламентная команда,
	// инструменты contract_termination_documents_sort и contract_termination_documents_resolve; файлы заявок
	// на расходование ДС по списаниям акта сверки (agentrunner-480).
	// 1.1.1 - инструменты разбора переименованы в contract_termination_documents_sort и
	// contract_termination_documents_resolve: ядро требует префикс пространства имен пакета,
	// пакет 1.1.0 отклонялся (name_not_namespaced) (agentrunner-495).
	// 1.1.2 - регламент разбора ДО пропускает подкаталоги без файла задания разбора, не ищет в них
	// временные файлы (agentrunner-496).
	Манифест.Вставить("Версия", ВерсияПакета());

	Категория = Новый Структура;
	Категория.Вставить("Имя", "files");
	Категория.Вставить("Представление", НСтр("ru = 'Присоединённые файлы'"));
	Категория.Вставить("ОписаниеДляLLM",
		НСтр("ru = 'Комплект документов для расторжения договора: акт сверки, отчет по платежным поручениям, вложения'"));
	Категория.Вставить("Порядок", 3);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаСбораДокументов());
	Инструменты.Добавить(ОписаниеИнструментаРазбора());
	Инструменты.Добавить(ОписаниеИнструментаРешения());
	Манифест.Вставить("Инструменты", Инструменты);

	Манифест.Вставить("Настройки", ОписанияНастроекПакета());

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md 1.6). Диспетчеризация по имени, без
// Выполнить()/Вычислить().
//
// Параметры:
//  ИмяTool       - Строка    - полное имя инструмента (contract_termination_collect,
//                  contract_termination_documents_sort, contract_termination_documents_resolve).
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащенный ядром
//                  системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = ИмяИнструментаСбора() Тогда
		Возврат ВыполнитьСборДокументов(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = ИмяИнструментаРазбора() Тогда
		Возврат ВыполнитьРазборДокументов(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = ИмяИнструментаРешения() Тогда
		Возврат ВыполнитьРешениеСпорного(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаИнструмента("unknown_tool");
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МанифестИНастройки

// Описание инструмента contract_termination_collect для манифеста пакета.
// УровеньРиска = «Запись» без подтверждения с обоснованием (ядро проверяет
// непустой ОбоснованиеЗаписиБезПодтверждения, решение человека 19.11.2026).
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаСбораДокументов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", ИмяИнструментаСбора());
	Описание.Вставить("Описание",
		НСтр("ru = 'Собирает по договору - предмету запуска - полный комплект документов для расторжения
			|в каталог из доп. настроек: акт сверки с суммой задолженности (XLSX), отчет по платежным
			|поручениям (XLSX), вложения документов из акта сверки и вложения КС-2, отчетов комитенту
			|и корректировочных КС-2 (папки с номером и датой документа в имени файла; документ из акта
			|в папки КС-2 и отчетов не дублируется; к списаниям с расчетного счета - файлы их заявок
			|на расходование ДС). Аргументов нет: договор инструмент берет из запуска сам. В ответе directory,
			|log_file, saved_files и статусы шагов steps; шаг, который не удался (оборотов нет, отчет
			|не найден), не мешает остальным. Если включен разбор выгрузки ДО - поле do_directory: куда
			|пользователю выгрузить документы из ДО. Ошибка sort_pending - вызови
			|contract_termination_documents_sort.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Комплект документов расторжения договора в каталог'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовСбораДокументов());
	Описание.Вставить("УровеньРиска", "Запись");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'agentrunner-471 (решение человека 19.11.2026): запуск - по кнопке пользователя
			|на конкретном договоре; создается только акт сверки с маркером в комментарии,
			|файлы пишутся в новый подкаталог.'"));
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов contract_termination_collect в OpenAI tool-format:
// аргументов нет (шаги детерминированы, договор - предмет запуска).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСбораДокументов()

	Свойства = Новый Структура;

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Новый Массив);

	Возврат ОбернутьВOpenAIФормат(ИмяИнструментаСбора(),
		НСтр("ru = 'Собрать комплект документов для расторжения по договору запуска.'"), Параметры);

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
//
// Параметры:
//  Имя       - Строка    - полное имя инструмента (с пространством имен).
//  Описание  - Строка    - человекочитаемое описание инструмента для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, ...}).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)

	ОписаниеФункции = Новый Структура;
	ОписаниеФункции.Вставить("name", Имя);
	ОписаниеФункции.Вставить("description", Описание);
	ОписаниеФункции.Вставить("parameters", Параметры);

	ОберткаФормата = Новый Структура;
	ОберткаФормата.Вставить("type", "function");
	ОберткаФормата.Вставить("function", ОписаниеФункции);
	Возврат ar_JSON.ВЗначениеJSON(ОберткаФормата);

КонецФункции

// Настройки пакета (создаются ядром при регистрации, ключи - глобальные в
// ar_Настройки, читаются пакетом ar_Настройки.ЗначениеНастройки).
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписанияНастроекПакета()

	Настройки = Новый Массив;

	НастройкаКаталога = ОписаниеНастройки(КлючНастройкиКаталога(),
		НСтр("ru = 'Расторжение договора: каталог документов'"),
		НСтр("ru = 'Каталог на стороне сервера 1С (локальный или UNC), доступный на запись учетной записи
			|службы сервера 1С. В него инструмент создает подкаталог договора и сохраняет файлы.
			|Пусто - инструмент отвечает no_directory.'"),
		"");
	Настройки.Добавить(НастройкаКаталога);

	НастройкаДаты = ОписаниеНастройки(КлючНастройкиДатыНачала(),
		НСтр("ru = 'Расторжение договора: дата начала периода'"),
		НСтр("ru = 'Начало периода акта сверки и отчета по платежным поручениям.'"),
		ДатаНачалаПериодаПоУмолчанию());
	Настройки.Добавить(НастройкаДаты);

	ДобавитьНастройкиРазбораДО(Настройки);

	Возврат Настройки;

КонецФункции

// Элемент массива Настройки манифеста.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (глобальный в ar_Настройки).
//  Наименование        - Строка - наименование для администратора.
//  Описание            - Строка - описание настройки.
//  ЗначениеПоУмолчанию - Строка, Число, Булево, Дата - значение по умолчанию.
//
// Возвращаемое значение:
//  Структура - {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	Настройка = Новый Структура;
	Настройка.Вставить("Ключ", Ключ);
	Настройка.Вставить("Наименование", Наименование);
	Настройка.Вставить("Описание", Описание);
	Настройка.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Возврат Настройка;

КонецФункции

// Полное имя инструмента сбора - константа модуля (пространство имён пакета
// contract_termination).
//
// Возвращаемое значение:
//  Строка - имя инструмента.
//
Функция ИмяИнструментаСбора()

	Возврат "contract_termination_collect";

КонецФункции

// Ключи настроек пакета в ar_Настройки (глобальные, поэтому с приставкой задачи).
//
// Возвращаемое значение:
//  Строка - ключ настройки.
//
Функция КлючНастройкиКаталога()

	Возврат "РасторжениеДоговораКаталогДокументов";

КонецФункции

// См. КлючНастройкиКаталога.
//
Функция КлючНастройкиДатыНачала()

	Возврат "РасторжениеДоговораДатаНачала";

КонецФункции

#КонецОбласти

#Область ИнструментСбораДокументов

// Шаги вложений: один пакетный запрос на три шага; сбой запроса валит только
// эти шаги (status = error каждому), остальные уже выполнены (спека п.3).
//
// Параметры:
//  Сбор - Структура - контекст сбора (изменяется Сбор.Шаги).
//
Процедура ВыполнитьШагиВложений(Знач Сбор)

	ОбновитьПульсСбора(Сбор);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		СтрокиДокументов = ДокументыВложенийПоДоговору(Сбор.Предмет);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСбойШагаВЛог(Сбор, "ks2, commission_reports, ks2_corrections", ТекстОшибки,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Для Каждого ВидШага Из ВидыШаговВложений() Цикл
			Шаг = НовыйШагОтвета(ВидШага);
			Шаг.status = "error";
			Шаг.message = ТекстОшибки;
			Сбор.Ошибок = Сбор.Ошибок + 1;
			РезультатОшибки = НСтр("ru = 'ошибка'") + ": " + ТекстОшибки;
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШагаЖурнала(ВидШага), "", "", "", 0, РезультатОшибки);
			Сбор.Шаги.Добавить(Шаг);
		КонецЦикла;
		Возврат;
	КонецПопытки;

	// Запрос документов по договору - отдельной строкой времени: поле договора
	// в документах не индексировано, на больших базах это заметная часть сбора.
	ЗаписатьВремяШага(Сбор, "documents_query", "ok", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс);

	Для Каждого ВидШага Из ВидыШаговВложений() Цикл
		ШагВложений = ВыполнитьШагНезависимо(Сбор, ВидШага, СтрокиДокументов.Получить(ВидШага));
		Сбор.Шаги.Добавить(ШагВложений);
	КонецЦикла;

КонецПроцедуры

// Реализация инструмента contract_termination_collect (спека agentrunner-471 п.3).
// Порядок: предмет и инициатор по RunId -> настройки (каталог, дата начала) ->
// защита от путаницы с разбором (sort_pending, agentrunner-480) ->
// режим без записи (план, ничего не создается) -> подкаталог договора и журнал ->
// независимые шаги (акт сверки, отчет, вложения, задание разбора ДО) -> итоговый ответ. Ошибки,
// которые аргументом не исправить (не договор, пустой каталог, недоступен
// подкаталог), - {"error": код, "message", "next": "finish"}.
//
// Параметры:
//  АргументыJSON - Строка    - JSON аргументов (аргументов нет, читается _dry_run).
//  Контекст      - Структура - контекст запуска (RunId, ...); может быть
//                  Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {directory, log_file, saved_files, steps, [log_error]}
//  либо {error, message, next: "finish"}.
//
Функция ВыполнитьСборДокументов(Знач АргументыJSON, Знач Контекст)

	Шапка = ШапкаЗапуска(RunIdИзКонтекста(Контекст));
	Если ТипЗнч(Шапка.Предмет) <> Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Возврат ОшибкаЗавершенияИнструмента("not_contract",
			НСтр("ru = 'Предмет запуска не является договором контрагента.'"));
	КонецЕсли;

	КаталогДокументов = КаталогДокументовИзНастройки();
	Если ПустаяСтрока(КаталогДокументов) Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Не задан каталог документов (доп. настройка «%1»).'"),
			КлючНастройкиКаталога());
		Возврат ОшибкаЗавершенияИнструмента("no_directory", СообщениеОбОшибке);
	КонецЕсли;

	// Защита от путаницы режимов (agentrunner-480, спека А.4): по договору ждет разбор
	// выгрузки ДО - модель вызвала сбор вместо разбора. Ошибка исправима - без next=finish.
	РазборВключен = РазборВыгрузокДОВключен();
	Если РазборВключен И ЕстьОжидающийРазбор(КаталогДокументов, Шапка.Предмет) Тогда
		СообщениеОбОшибке = СтрШаблон(
			НСтр("ru = 'По договору ждет разбор выгрузки ДО - вызовите %1, а не сбор документов.'"),
			ИмяИнструментаРазбора());
		Возврат ОшибкаАргумента("sort_pending", СообщениеОбОшибке);
	КонецЕсли;

	РеквизитыДоговора = РеквизитыДоговораДляСбора(Шапка.Предмет);
	ДатаНачала = ДатаНачалаПериода();

	// Режим без записи: документ не создается, каталоги, файлы и журнал не пишутся.
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		ПланСбора = ПланСбораДляОтвета(Шапка.Предмет, КаталогДокументов, РеквизитыДоговора, ДатаНачала);
		Если РазборВключен Тогда
			ПланСбора.Вставить("do_directory", ПланСбора.directory + "\" + ИмяПапкиДО());
		КонецЕсли;
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON(ИмяИнструментаСбора(), ПланСбора);
	КонецЕсли;

	КаталогПодкаталога = КаталогДокументов + "\" + ИмяПодкаталогаСбора(КаталогДокументов, РеквизитыДоговора);
	Попытка
		СоздатьКаталог(КаталогПодкаталога);
	Исключение
		Возврат ОшибкаЗавершенияИнструмента("directory_unavailable",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Журнал создается сразу после подкаталога, до шагов; сбой создания - как
	// недоступность каталога для записи (спека п.3 «журнал работы»).
	Журнал = ОткрытьЖурналСбора(КаталогПодкаталога + "\" + ИмяФайлаЖурнала());
	Если Журнал.Запись = Неопределено Тогда
		Возврат ОшибкаЗавершенияИнструмента("directory_unavailable", Журнал.ОшибкаЗаписи);
	КонецЕсли;

	Сбор = НовыйСтруктураСбора(Шапка.Предмет, РеквизитыДоговора, ДатаНачала,
		КаталогПодкаталога, Журнал, Шапка.Пользователь, RunIdИзКонтекста(Контекст));
	ЗаписатьШапкуЖурнала(Сбор, Контекст);

	// Шаги под общей попыткой только ради гарантии закрытия журнала: исключения
	// самих шагов поглощаются ВыполнитьШагНезависимо, сюда долетает непредвиденное.
	Попытка
		ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаАктаСверки());
		Сбор.Шаги.Добавить(ШагОтвета);
		ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаОтчетаПлатежных());
		Сбор.Шаги.Добавить(ШагОтвета);
		// Документы акта - до шагов по договору: КС-2 и отчеты комитенту, уже
		// выгруженные из акта, там пропускаются (agentrunner-487).
		ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаДокументовАкта());
		Сбор.Шаги.Добавить(ШагОтвета);
		ВыполнитьШагиВложений(Сбор);
		// Задание разбора выгрузки ДО - после шагов сбора (agentrunner-480, спека А.2).
		Если РазборВключен Тогда
			ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаЗаданияРазбора());
			Сбор.Шаги.Добавить(ШагОтвета);
		КонецЕсли;
		ЗаписатьИтогЖурнала(Сбор);
	Исключение
		ЗакрытьЖурнал(Сбор.Журнал);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьЖурнал(Сбор.Журнал);

	Возврат ОтветОбУспехе(Сбор);

КонецФункции

// Контекст всего сбора: предмет, настройки, пути, журнал и итоги. Дата окончания
// периода - конец текущего дня сеанса.
//
// Параметры:
//  Предмет            - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  РеквизитыДоговора  - Структура - {Номер, Дата, Владелец, Организация}.
//  ДатаНачала         - Дата - дата начала периода из настройки.
//  КаталогПодкаталога - Строка - каталог сбора договора.
//  Журнал             - Структура - журнал сбора (см. ОткрытьЖурналСбора).
//  Инициатор          - СправочникСсылка.Пользователи - инициатор запуска.
//  RunId              - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - контекст сбора.
//
Функция НовыйСтруктураСбора(Знач Предмет, Знач РеквизитыДоговора, Знач ДатаНачала,
	Знач КаталогПодкаталога, Знач Журнал, Знач Инициатор, Знач RunId)

	Сбор = Новый Структура(
		"Предмет, РеквизитыДоговора, ДатаНачала, ДатаОкончания, КаталогПодкаталога, Журнал,
		|Инициатор, RunId, Шаги, СохраненоФайлов, ПропущеноФайлов, Ошибок",
		Предмет, РеквизитыДоговора, ДатаНачала, КонецДня(ТекущаяДатаСеанса()), КаталогПодкаталога, Журнал,
		Инициатор, RunId, Новый Массив, 0, 0, 0);
	// Пульс запуска и время шагов (agentrunner-483): момент последнего пульса,
	// признак уже записанного сбоя пульса, длительность шага по коду (мс).
	Сбор.Вставить("МоментПульса", ТекущаяДатаСеанса());
	Сбор.Вставить("СбойПульсаЗаписан", Ложь);
	Сбор.Вставить("ДлительностиШагов", Новый Соответствие);
	// Документы акта сверки (agentrunner-487): акт шага reconciliation_act и
	// документы, выгруженные шагом act_documents (Ссылка -> Истина).
	Сбор.Вставить("АктСверки", Неопределено);
	Сбор.Вставить("ВыгруженыИзАкта", Новый Соответствие);
	// Заявки на расходование ДС по списаниям акта (agentrunner-480, спека Ж) и папка
	// выгрузки ДО задания разбора (спека А.2).
	Сбор.Вставить("ЗаявкиАкта", Неопределено);
	Сбор.Вставить("КаталогДО", "");
	Возврат Сбор;

КонецФункции

// Каталог документов из настройки пакета (сервер 1С), без концевых пробелов
// и разделителей каталога (иначе при склейке путей получится двойной «\»).
//
// Возвращаемое значение:
//  Строка - каталог; пустая строка, если настройка не строка или не заполнена.
//
Функция КаталогДокументовИзНастройки()

	Значение = ar_Настройки.ЗначениеНастройки(КлючНастройкиКаталога(), "");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Каталог = СокрЛП(Значение);
	Пока СтрЗаканчиваетсяНа(Каталог, "\") Или СтрЗаканчиваетсяНа(Каталог, "/") Цикл
		Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
	КонецЦикла;
	Возврат Каталог;

КонецФункции

// Дата начала периода из настройки пакета (не дата - значение по умолчанию).
//
// Возвращаемое значение:
//  Дата - дата начала периода акта сверки и отчета.
//
Функция ДатаНачалаПериода()

	Значение = ar_Настройки.ЗначениеНастройки(КлючНастройкиДатыНачала(), ДатаНачалаПериодаПоУмолчанию());
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат ДатаНачалаПериодаПоУмолчанию();
	КонецЕсли;
	Возврат НачалоДня(Значение);

КонецФункции

// Дата начала периода по умолчанию (описание задачи: с 01.01.2020) - константа модуля.
//
// Возвращаемое значение:
//  Дата - дата начала периода по умолчанию.
//
Функция ДатаНачалаПериодаПоУмолчанию()

	Возврат '20200101';

КонецФункции

// Номер, дата, контрагент (владелец), организация и код договора в ДО - одним чтением БСП.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//
// Возвращаемое значение:
//  Структура - {Номер, Дата, Владелец, Организация, sd_КодДО}.
//
Функция РеквизитыДоговораДляСбора(Знач Договор)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Номер, Дата, Владелец, Организация, sd_КодДО");

КонецФункции

// Имя подкаталога договора: «<Контрагент> - договор <Номер> от <ДД.ММ.ГГГГ> -
// <ГГГГММДД_ЧЧММСС>». Имена очищаются от недопустимых символов; часть контрагента
// обрезается так, чтобы полный путь подкаталога был не длиннее 250 символов
// (спека п.3 «имена»); повторный запуск создает новый подкаталог (метка времени).
//
// Параметры:
//  КаталогДокументов - Строка          - каталог из настройки.
//  РеквизитыДоговора - Структура       - реквизиты договора.
//
// Возвращаемое значение:
//  Строка - имя подкаталога (без каталога).
//
Функция ИмяПодкаталогаСбора(Знач КаталогДокументов, Знач РеквизитыДоговора)

	ХвостИмени = СтрШаблон(" - договор %1 от %2 - %3", СокрЛП(РеквизитыДоговора.Номер),
		Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"), Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss"));

	ИмяКонтрагента = СокрЛП(Строка(РеквизитыДоговора.Владелец));
	// Резерв под папку шага и имя файла: лимит 250 - для полного пути файла, не подкаталога.
	ДоступноКонтрагенту = МаксимальнаяДлинаПути() - РезервДлиныПутиФайла() - СтрДлина(КаталогДокументов) - 1
		- СтрДлина(ХвостИмени);
	Если ДоступноКонтрагенту < 0 Тогда
		ИмяКонтрагента = "";
	ИначеЕсли СтрДлина(ИмяКонтрагента) > ДоступноКонтрагенту Тогда
		ИмяКонтрагента = Лев(ИмяКонтрагента, ДоступноКонтрагенту);
	Иначе
		// Имя контрагента помещается целиком - не обрезается.
	КонецЕсли;

	Возврат ОчиститьИмяФайла(ИмяКонтрагента + ХвостИмени);

КонецФункции

