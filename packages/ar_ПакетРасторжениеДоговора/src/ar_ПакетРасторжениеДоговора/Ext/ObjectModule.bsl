// Добавляет настройки разбора выгрузки ДО (спека А.1). Разбор по умолчанию выключен: обновление пакета
// не меняет работающий сбор, пока не готовы каталог и расписание.
//
// Параметры:
//  Настройки - Массив из Структура - настройки пакета (дополняется).
//
Процедура ДобавитьНастройкиРазбораДО(Знач Настройки)

	НастройкаРазбора = ОписаниеНастройки(КлючНастройкиРазбораДО(),
		НСтр("ru = 'Расторжение договора: разбор выгрузок ДО'"),
		НСтр("ru = 'Включает разбор документов, выгруженных из ДО: сбор создает папку «ДО» и задание разбора,
			|регламентная команда «Разбор выгрузок ДО» ставит договор агенту.'"),
		Ложь);
	Настройки.Добавить(НастройкаРазбора);

	НастройкаСрока = ОписаниеНастройки(КлючНастройкиСрокаОжидания(),
		НСтр("ru = 'Расторжение договора: срок ожидания выгрузки ДО, дней'"),
		НСтр("ru = 'Сколько дней после сбора ждать выгрузку из ДО; дальше задание разбора - просрочено.'"),
		СрокОжиданияПоУмолчанию());
	Настройки.Добавить(НастройкаСрока);

	НастройкаРасширений = ОписаниеНастройки(КлючНастройкиРасширений(),
		НСтр("ru = 'Расторжение договора: расширения файлов разбора'"),
		НСтр("ru = 'Расширения файлов через запятую, у которых разбор извлекает текст (нужен IFilter на сервере 1С);
			|остальные - в «Не распознано».'"),
		РасширенияРазбораПоУмолчанию());
	Настройки.Добавить(НастройкаРасширений);

	НастройкаРазмера = ОписаниеНастройки(КлючНастройкиРазмераФайла(),
		НСтр("ru = 'Расторжение договора: максимальный размер файла разбора, МБ'"),
		НСтр("ru = 'Файл больше лимита разбор не читает - он попадает в «Не распознано» с причиной «размер».'"),
		МаксРазмерФайлаПоУмолчанию());
	Настройки.Добавить(НастройкаРазмера);

