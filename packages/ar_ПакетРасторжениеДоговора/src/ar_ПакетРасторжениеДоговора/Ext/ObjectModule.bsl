КонецФункции

#КонецОбласти

#Область ШагиСбора

// Выполняет шаг сбора независимо от остальных (см. ВыполнитьШагСПерехватомОшибки);
// до и после шага обновляет пульс запуска, длительность шага пишет в служебный
// лог (событие contract_docs_step_timing) и в итог журнала (agentrunner-483).
//
// Параметры:
//  Сбор            - Структура - контекст сбора.
//  КодШага         - Строка    - код шага.
//  СтрокиДокументов - Массив, Неопределено - документы шага (для шагов вложений).
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагНезависимо(Знач Сбор, Знач КодШага, Знач СтрокиДокументов = Неопределено)

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьПульсСбора(Сбор);

	Шаг = ВыполнитьШагСПерехватомОшибки(Сбор, КодШага, СтрокиДокументов);

	ЗаписатьВремяШага(Сбор, КодШага, Шаг.status, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс,
		Шаг.documents, Шаг.files_total);
	ОбновитьПульсСбора(Сбор);

	Возврат Шаг;

КонецФункции

// Выполняет шаг сбора: исключение шага перехватывается, пишется в результат шага
// (status = error, message) и в служебный лог (событие contract_docs_step_failed),
// остальные шаги выполняются (спека п.3).
//
// Параметры:
//  Сбор            - Структура - контекст сбора.
//  КодШага         - Строка    - код шага.
//  СтрокиДокументов - Массив, Неопределено - документы шага (для шагов вложений).
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагСПерехватомОшибки(Знач Сбор, Знач КодШага, Знач СтрокиДокументов)

	Попытка
		Если КодШага = КодШагаАктаСверки() Тогда
			Возврат ВыполнитьШагАктаСверки(Сбор);
		ИначеЕсли КодШага = КодШагаОтчетаПлатежных() Тогда
			Возврат ВыполнитьШагОтчетаПлатежных(Сбор);
		Иначе
			Возврат ВыполнитьШагВложений(Сбор, КодШага, СтрокиДокументов);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСбойШагаВЛог(Сбор, КодШага, ТекстОшибки,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Шаг = НовыйШагОтвета(КодШага);
		Шаг.status = "error";
		Шаг.message = ТекстОшибки;
		Сбор.Ошибок = Сбор.Ошибок + 1;
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШагаЖурнала(КодШага), "", "", "", 0,
			НСтр("ru = 'ошибка'") + ": " + ТекстОшибки);
		Возврат Шаг;
	КонецПопытки;

КонецФункции

// Записывает сбой шага в служебный лог (событие contract_docs_step_failed,
// уровень Ошибка).
//
// Параметры:
//  Сбор     - Структура - контекст сбора.
//  КодШага  - Строка    - код шага (или перечень через запятую).
//  Кратко   - Строка    - краткое представление ошибки (в ответ).
//  Подробно - Строка    - подробное представление ошибки (в лог).
//
Процедура ЗаписатьСбойШагаВЛог(Знач Сбор, Знач КодШага, Знач Кратко, Знач Подробно)

	ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_docs_step_failed",
		СтрШаблон("Договор=%1; Шаг=%2; %3", Строка(Сбор.Предмет), КодШага, Подробно),
		"Ошибка", Сбор.RunId, Сбор.Предмет);

КонецПроцедуры

// Записывает длительность шага: в служебный лог (событие contract_docs_step_timing)
// и в контекст сбора для итога журнала (agentrunner-483: при сотнях документов
// видно, какой шаг занимает время).
//
// Параметры:
//  Сбор           - Структура - контекст сбора (изменяется ДлительностиШагов).
//  КодШага        - Строка    - код шага (или перечень через запятую).
//  Статус         - Строка    - статус шага.
//  ДлительностьМс - Число     - длительность шага, мс.
//  Документов     - Число     - документов шага.
//  Файлов         - Число     - сохранено файлов шага.
//
Процедура ЗаписатьВремяШага(Знач Сбор, Знач КодШага, Знач Статус, Знач ДлительностьМс,
	Знач Документов = 0, Знач Файлов = 0)

	Сбор.ДлительностиШагов.Вставить(КодШага, ДлительностьМс);

	ФорматЧисла = "ЧН=0; ЧГ=0";
	ТекстЗаписи = СтрШаблон("Договор=%1; Шаг=%2; Статус=%3; ДлительностьМс=%4; Документов=%5; Файлов=%6",
		Строка(Сбор.Предмет), КодШага, Статус, Формат(ДлительностьМс, ФорматЧисла),
		Формат(Документов, ФорматЧисла), Формат(Файлов, ФорматЧисла));
	ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_docs_step_timing", ТекстЗаписи,
		"Информация", Сбор.RunId, Сбор.Предмет);

КонецПроцедуры

// Обновляет пульс запуска агента, не чаще раза в ИнтервалПульсаСек секунд. Пульс
// идет только от диспетчера LLM, а инструмент сбора на сотнях документов работает
// дольше предела очистки зависших (30 мин без пульса) - без него запуск снимается
// как зависший (agentrunner-483). Сбой пульса не прерывает сбор: пишется в
// служебный лог один раз за сбор.
//
// Параметры:
//  Сбор - Структура - контекст сбора (изменяются МоментПульса, СбойПульсаЗаписан).
//
Процедура ОбновитьПульсСбора(Знач Сбор)

	Если ПустаяСтрока(Сбор.RunId) Тогда
		Возврат;
	КонецЕсли;

	ТекущийМомент = ТекущаяДатаСеанса();
	Если ТекущийМомент - Сбор.МоментПульса < ИнтервалПульсаСек() Тогда
		Возврат;
	КонецЕсли;
	Сбор.МоментПульса = ТекущийМомент;

	Попытка
		ar_AuditЗащищённыйРежим.ОбновитьПульсПривилегированно(Сбор.RunId);
	Исключение
		Если Не Сбор.СбойПульсаЗаписан Тогда
			Сбор.СбойПульсаЗаписан = Истина;
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_heartbeat_failed",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				"Предупреждение", Сбор.RunId, Сбор.Предмет);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Не чаще стольких секунд обновляется пульс запуска во время сбора: пульс - запись
// регистра с блокировкой, на каждый файл его писать незачем (предел очистки
// зависших - 30 мин).
//
// Возвращаемое значение:
//  Число - интервал, секунды.
//
Функция ИнтервалПульсаСек()

	Возврат 60;

КонецФункции

// Шаг акта сверки (reconciliation_act): до создания ищется акт, созданный агентом
// сегодня по этому договору с той же датой начала (решение человека 19.11.2026);
// найден - печатается повторно (reused = true), не найден - создается по образцу
// sd_СогласованиеРасторженияДоговора.СоздатьАктСверкиРасчетов и проводится, затем
// печатная форма «АктСверки» в XLSX (спека п.3).
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагАктаСверки(Знач Сбор)

	КодШага = КодШагаАктаСверки();
	ИмяШага = ИмяШагаЖурнала(КодШага);
	Шаг = НовыйШагОтвета(КодШага);

	Акт = СегодняшнийАктСверки(Сбор.Предмет, Сбор.ДатаНачала);
	ВзятПовторно = Акт <> Неопределено;

	Если Не ВзятПовторно Тогда
		Акт = СоздатьАктСверкиПоДоговору(Сбор);
		Если Акт.Код = "no_turnover" Тогда
			Шаг.status = "no_turnover";
			Шаг.message = НСтр("ru = 'Обороты по договору за период отсутствуют, акт сверки не создан.'");
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, "", "", "", 0, НСтр("ru = 'оборотов нет'"));
			Возврат Шаг;
		ИначеЕсли Акт.Код = "fill_processing_not_found" Тогда
			Шаг.status = "fill_processing_not_found";
			Шаг.message = СтрШаблон(НСтр("ru = 'Не найдена дополнительная обработка «%1».'"),
				НаименованиеОбработкиЗаполненияАкта());
			РезультатЖурнала = НСтр("ru = 'ошибка'") + ": " + Шаг.message;
			Сбор.Ошибок = Сбор.Ошибок + 1;
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, "", "", "", 0, РезультатЖурнала);
			Возврат Шаг;
		Иначе
			// Акт создан и проведен - печать и сохранение ниже.
		КонецЕсли;
	КонецЕсли;

	ДвоичныеДанные = ДвоичныеДанныеПечатиАкта(Акт.Ссылка);
	ПутьФайла = ФайловаяСистема.УникальноеИмяФайла(Сбор.КаталогПодкаталога + "\" + ИмяФайлаАктаСверки());
	ДвоичныеДанные.Записать(ПутьФайла);

	Шаг.status = "ok";
	Шаг.documents = 1;
	Шаг.files_total = 1;
	Сбор.СохраненоФайлов = Сбор.СохраненоФайлов + 1;
	Шаг.message = СтрШаблон(НСтр("ru = 'Акт сверки № %1 от %2.'"), Акт.Номер,
		Формат(Акт.Дата, "ДФ=dd.MM.yyyy"));

	ИсточникАкта = ПредставлениеДокументаЖурнала(НСтр("ru = 'Акт сверки'"), Акт.Номер, Акт.Дата);
	Если ВзятПовторно Тогда
		Шаг.Вставить("reused", Истина);
		РезультатПовтора = СтрШаблон(НСтр("ru = 'использован ранее созданный акт № %1 от %2'"),
			Акт.Номер, Формат(Акт.Дата, "ДФ=dd.MM.yyyy"));
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникАкта, "", "", 0, РезультатПовтора);
	КонецЕсли;

	ДобавитьФайлВШаг(Шаг, ИмяФайлаАктаСверки(), ДвоичныеДанные.Размер());
	ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникАкта, "", ИмяФайлаАктаСверки(),
		ДвоичныеДанные.Размер(), НСтр("ru = 'сохранён'"));

	Возврат Шаг;

КонецФункции

// Акт сверки, созданный агентом сегодня по договору с той же датой начала:
// ВЫБРАТЬ ПЕРВЫЕ 1 по дате документа (индекс даты документа: актов за день -
// единицы), договору, дате начала, проведению и маркеру в начале комментария
// (Комментарий - строка неограниченной длины, сравнение только подстрокой),
// последний за день (решение человека 19.11.2026, спека п.3).
//
// Параметры:
//  Договор    - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  ДатаНачала - Дата - дата начала периода из настройки.
//
// Возвращаемое значение:
//  Структура, Неопределено - {Ссылка, Номер, Дата} найденного акта;
//  Неопределено - акта нет.
//
Функция СегодняшнийАктСверки(Знач Договор, Знач ДатаНачала)

	Маркер = МаркерКомментарияАкта();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Акты.Ссылка КАК Ссылка,
		|	Акты.Номер КАК Номер,
		|	Акты.Дата КАК Дата
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК Акты
		|ГДЕ
		|	Акты.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И Акты.ДоговорКонтрагента = &Договор
		|	И Акты.ДатаНачала = &ДатаНачала
		|	И Акты.Проведен
		|	И НЕ Акты.ПометкаУдаления
		|	И ПОДСТРОКА(Акты.Комментарий, 1, &ДлинаМаркера) = &Маркер
		|УПОРЯДОЧИТЬ ПО
		|	Акты.Дата УБЫВ";
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДлинаМаркера", СтрДлина(Маркер));
	Запрос.УстановитьПараметр("Маркер", Маркер);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ссылка, Номер, Дата", Выборка.Ссылка, Выборка.Номер, Выборка.Дата);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Создает и проводит акт сверки по договору - своя функция по образцу
// Документы.sd_СогласованиеРасторженияДоговора.СоздатьАктСверкиРасчетов (у образца
// дата начала зашита 2021 годом, ответственный - настройка расширения доработок;
// здесь период - настройка пакета, ответственный - инициатор запуска, спека п.3).
// Заполнение табличных частей - дополнительной обработкой «Заполнить акт сверки
// взаиморасчетов» (штатного серверного заполнения нет). «Обороты отсутствуют» -
// документ не записывается.
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
// Возвращаемое значение:
//  Структура - {Код: "ok" / "no_turnover" / "fill_processing_not_found",
//  Ссылка, Номер, Дата}.
//
Функция СоздатьАктСверкиПоДоговору(Знач Сбор)

	Результат = Новый Структура("Код, Ссылка, Номер, Дата", "ok",
		Документы.АктСверкиВзаиморасчетов.ПустаяСсылка(), "", '00010101');

	АктОбъект = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
	АктОбъект.Организация = Сбор.РеквизитыДоговора.Организация;
	АктОбъект.Дата = ТекущаяДатаСеанса();
	АктОбъект.Контрагент = Сбор.РеквизитыДоговора.Владелец;
	АктОбъект.ДоговорКонтрагента = Сбор.Предмет;
	АктОбъект.ДатаНачала = Сбор.ДатаНачала;
	АктОбъект.ДатаОкончания = Сбор.ДатаОкончания;
	АктОбъект.ВалютаДокумента = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	АктОбъект.ПредставительОрганизации = Документы.АктСверкиВзаиморасчетов.ПредставительОрганизации(
		АктОбъект.Организация, АктОбъект.Дата);
	АктОбъект.ПредставительКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АктОбъект.Контрагент,
		"ОсновноеКонтактноеЛицо");

	// Список счетов расчетов - как в образце: таблица счетов учета взаиморасчетов
	// с переименованной колонкой и признаком участия в расчетах.
	ТаблицаСчетов = УчетВзаиморасчетов.ПолучитьТаблицуСчетовУчетаВзаиморасчетов(Истина, Ложь);
	ТаблицаСчетов.Колонки.СчетРасчетов.Имя = "Счет";
	ТаблицаСчетов.Колонки.Добавить("УчаствуетВРасчетах");
	ТаблицаСчетов.ЗаполнитьЗначения(Истина, "УчаствуетВРасчетах");
	АктОбъект.СписокСчетов.Загрузить(ТаблицаСчетов);

	АктОбъект.Ответственный = Сбор.Инициатор;
	АктОбъект.Комментарий = МаркерКомментарияАкта();

	ОбработкаЗаполнения = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(
		НаименованиеОбработкиЗаполненияАкта());
	Если ОбработкаЗаполнения.Пустая() Тогда
		Результат.Код = "fill_processing_not_found";
		Возврат Результат;
	КонецЕсли;

	ОбработкаОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ОбработкаЗаполнения);
	ДоговорыЗаполнения = Новый Массив;
	ДоговорыЗаполнения.Добавить(Сбор.Предмет);
	ОбработкаОбъект.ЗаполнитьПоДаннымБухгалтерскогоУчета(АктОбъект, Истина, ДоговорыЗаполнения);

	Если АктОбъект.ПоДаннымОрганизации.Количество() = 1
		И АктОбъект.ПоДаннымОрганизации[0].Представление = "Обороты отсутствуют" Тогда
		Результат.Код = "no_turnover";
		Возврат Результат;
	КонецЕсли;

	АктОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Результат.Ссылка = АктОбъект.Ссылка;
	Результат.Номер = АктОбъект.Номер;
	Результат.Дата = АктОбъект.Дата;
	Возврат Результат;

КонецФункции

// Печатная форма «АктСверки» акта сверки в XLSX - двоичные данные файла
// (УправлениеПечатью.НапечататьВФайл, по образцу sd_СогласованиеРасторженияДоговора.
// ПечатьИОтправка; имена файлов транслита не используются - путь задает пакет).
//
// Параметры:
//  АктСсылка - ДокументСсылка.АктСверкиВзаиморасчетов - акт сверки.
//
// Возвращаемое значение:
//  ДвоичныеДанные - данные файла XLSX.
//
Функция ДвоичныеДанныеПечатиАкта(Знач АктСсылка)

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(АктСсылка);

	КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(АктСсылка.Метаданные());
	НайденнаяКоманда = КомандыПечати.Найти("АктСверки", "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'У документа акта сверки не найдена команда печати «АктСверки».'");
	КонецЕсли;

	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);
	КомандаПечатиВФайл.ДополнительныеПараметры.Вставить("ИсключитьШтампы");

	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.XLSX);

	ТаблицаФайлов = УправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектов, НастройкиСохранения);
	Если ТаблицаФайлов.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Печать акта сверки в файл не вернула файл.'");
	КонецЕсли;

	Возврат ТаблицаФайлов[0].ДвоичныеДанные;

КонецФункции

// Маркер комментария акта сверки: созданные агентом акты ищутся по нему
// (повторный запуск, откат - спека п. «Внедрение и откат»).
//
// Возвращаемое значение:
//  Строка - маркер (начало комментария акта).
//
Функция МаркерКомментарияАкта()

	Возврат НСтр("ru = '#Сформирован агентом AgentRunner для расторжения договора'");

КонецФункции

// Наименование дополнительной обработки заполнения акта - константа модуля
// (имя элемента справочника, как в конфигурации; другого серверного способа
// заполнения нет - спека п.3).
//
// Возвращаемое значение:
//  Строка - наименование обработки.
//
Функция НаименованиеОбработкиЗаполненияАкта()

	Возврат "Заполнить акт сверки взаиморасчетов";

КонецФункции

// Имя файла акта сверки в подкаталоге договора - константа модуля (спека п.3).
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайлаАктаСверки()

	Возврат НСтр("ru = 'Акт сверки.xlsx'");

КонецФункции

// Шаг отчета по платежным поручениям (payment_report): дополнительный отчет
// ищется по наименованию (решение человека 19.11.2026, без настройки), вариант
// «Основной» компонуется по договору и периоду с 01.01.2020 (настройка) по конец
// текущего дня, результат - в XLSX (спека п.3).
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагОтчетаПлатежных(Знач Сбор)

	Шаг = НовыйШагОтвета(КодШагаОтчетаПлатежных());
	Шаг.documents = 1;

	СсылкиОтчета = СсылкиДопОтчетаПлатежных();
	РазмерФайла = 0;
	Если СсылкиОтчета.Количество() = 0 Тогда
		Шаг.status = "report_not_found";
		Шаг.message = СтрШаблон(НСтр("ru = 'Дополнительный отчет «%1» не найден.'"),
			НаименованиеДопОтчетаПлатежных());
	ИначеЕсли СсылкиОтчета.Количество() > 1 Тогда
		Шаг.status = "report_ambiguous";
		Шаг.message = СтрШаблон(НСтр("ru = 'Найдено несколько дополнительных отчетов «%1»: %2.'"),
			НаименованиеДопОтчетаПлатежных(), ПредставленияДопОтчетов(СсылкиОтчета));
	Иначе
		ТабличныйДокумент = ТабличныйДокументОтчета(СсылкиОтчета[0], Сбор.Предмет,
			Сбор.ДатаНачала, Сбор.ДатаОкончания);
		Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
			Шаг.status = "no_data";
			Шаг.message = НСтр("ru = 'Отчет не вернул данных за период.'");
		Иначе
			ПутьФайла = ФайловаяСистема.УникальноеИмяФайла(Сбор.КаталогПодкаталога + "\" + ИмяФайлаОтчетаПлатежных());
			ТабличныйДокумент.Записать(ПутьФайла, ТипФайлаТабличногоДокумента.XLSX);

			Шаг.status = "ok";
			Шаг.files_total = 1;
			Сбор.СохраненоФайлов = Сбор.СохраненоФайлов + 1;
			ФайлОтчета = Новый Файл(ПутьФайла);
			РазмерФайла = ФайлОтчета.Размер();
			ДобавитьФайлВШаг(Шаг, ИмяФайлаОтчетаПлатежных(), РазмерФайла);
		КонецЕсли;
	КонецЕсли;

	РезультатЖурнала = НСтр("ru = 'сохранён'");
	СохраненКак = ИмяФайлаОтчетаПлатежных();
	Если Шаг.status = "no_data" Тогда
		РезультатЖурнала = НСтр("ru = 'нет данных'");
		СохраненКак = "";
	ИначеЕсли Шаг.status <> "ok" Тогда
		РезультатЖурнала = НСтр("ru = 'ошибка'") + ": " + Шаг.message;
		СохраненКак = "";
		Сбор.Ошибок = Сбор.Ошибок + 1;
	Иначе
		// Файл отчета сохранен - результат по умолчанию.
	КонецЕсли;
	ИмяШага = ИмяШагаЖурнала(КодШагаОтчетаПлатежных());
	ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, НаименованиеДопОтчетаПлатежных(), "",
		СохраненКак, РазмерФайла, РезультатЖурнала);

	Возврат Шаг;

КонецФункции

// Ссылки элементов дополнительного отчета по наименованию (вид - дополнительный
// отчет, не помечен на удаление). Поиск по Наименование - индекс справочника
// (спека п. «Производительность»).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДополнительныеОтчетыИОбработки - найденные элементы.
//
Функция СсылкиДопОтчетаПлатежных()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Отчеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Отчеты
		|ГДЕ
		|	Отчеты.Наименование = &Наименование
		|	И Отчеты.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет)
		|	И НЕ Отчеты.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Отчеты.Ссылка";
	Запрос.УстановитьПараметр("Наименование", НаименованиеДопОтчетаПлатежных());

	Ссылки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

// Наименование элемента дополнительного отчета «Отчет по платежным поручениям» -
// константа модуля: имя из описания задачи, ссылку в код не зашиваем (правило
// проекта; решение человека 19.11.2026 - поиск по имени, без настройки).
//
// Возвращаемое значение:
//  Строка - наименование доп. отчета.
//
Функция НаименованиеДопОтчетаПлатежных()

	Возврат "Отчет по платежным поручениям";

КонецФункции

// Представления найденных доп. отчетов для сообщения об неоднозначности.
//
// Параметры:
//  СсылкиОтчета - Массив из СправочникСсылка.ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Строка - представления через запятую.
//
Функция ПредставленияДопОтчетов(Знач СсылкиОтчета)

	Представления = Новый Массив;
	Для Каждого Ссылка Из СсылкиОтчета Цикл
		Представления.Добавить(Строка(Ссылка));
	КонецЦикла;
	Возврат СтрСоединить(Представления, ", ");

КонецФункции

// Табличный документ доп. отчета: настройки варианта «Основной» схемы
// «ОсновнаяСхемаКомпоновкиДанных» загружаются в компоновщик объекта отчета,
// ДополнительныеСвойства.КлючВарианта = «Основной» (его читает
// ПриКомпоновкеРезультата отчета), параметры данных ПериодПлатежка (стандартный
// период) и ДоговорКонтрагента; компоновка - СкомпоноватьРезультат, чтобы
// отработал ПриКомпоновкеРезультата (RLS прав сеанса, спека п.3).
//
// Параметры:
//  СсылкаОтчета - СправочникСсылка.ДополнительныеОтчетыИОбработки - элемент отчета.
//  Договор      - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  ДатаНачала   - Дата - дата начала периода.
//  ДатаОкончания - Дата - дата окончания периода.
//
// Возвращаемое значение:
//  ТабличныйДокумент - результат компоновки.
//
Функция ТабличныйДокументОтчета(Знач СсылкаОтчета, Знач Договор, Знач ДатаНачала, Знач ДатаОкончания)

	ОтчетОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(СсылкаОтчета);

	СхемаКомпоновки = ОтчетОбъект.ПолучитьМакет(ИмяСхемыКомпоновкиОтчета());
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(
		НастройкиВариантаСхемы(СхемаКомпоновки, ИмяВариантаОтчета()));

	НастройкиКД = ОтчетОбъект.КомпоновщикНастроек.Настройки;
	НастройкиКД.ДополнительныеСвойства.Вставить("КлючВарианта", ИмяВариантаОтчета());
	УстановитьПараметрДанных(НастройкиКД, "ПериодПлатежка",
		Новый СтандартныйПериод(ДатаНачала, ДатаОкончания));
	УстановитьПараметрДанных(НастройкиКД, "ДоговорКонтрагента", Договор);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ДанныеРасшифровки = Неопределено;
	ОтчетОбъект.СкомпоноватьРезультат(ТабличныйДокумент, ДанныеРасшифровки);

	Возврат ТабличныйДокумент;

КонецФункции

// Настройки варианта схемы компоновки по имени; нет вариантов - настройки
// по умолчанию.
//
// Параметры:
//  СхемаКомпоновки - СхемаКомпоновкиДанных - схема отчета.
//  ИмяВарианта     - Строка - имя варианта настроек.
//
// Возвращаемое значение:
//  НастройкиКомпоновкиДанных - настройки варианта.
//
Функция НастройкиВариантаСхемы(Знач СхемаКомпоновки, Знач ИмяВарианта)

	Для Каждого Вариант Из СхемаКомпоновки.ВариантыНастроек Цикл
		Если Вариант.Имя = ИмяВарианта Тогда
			Возврат Вариант.Настройки;
		КонецЕсли;
	КонецЦикла;

	Возврат СхемаКомпоновки.НастройкиПоУмолчанию;

КонецФункции

// Устанавливает значение параметра данных компоновки и включает его
// использование (частая ошибка паттерна - забыть Использование).
//
// Параметры:
//  НастройкиКД - НастройкиКомпоновкиДанных - настройки компоновки.
//  ИмяПараметра - Строка - имя параметра данных.
//  Значение     - Произвольный - значение параметра.
//
Процедура УстановитьПараметрДанных(Знач НастройкиКД, Знач ИмяПараметра, Знач Значение)

	Параметр = НастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Значение;
		Параметр.Использование = Истина;
	КонецЕсли;

КонецПроцедуры

// Имя схемы компоновки доп. отчета - константа модуля (имя макета отчета).
//
// Возвращаемое значение:
//  Строка - имя схемы.
//
Функция ИмяСхемыКомпоновкиОтчета()

	Возврат "ОсновнаяСхемаКомпоновкиДанных";

КонецФункции

// Имя варианта настроек отчета - константа модуля (его читает
// ПриКомпоновкеРезультата отчета).
//
// Возвращаемое значение:
//  Строка - имя варианта.
//
Функция ИмяВариантаОтчета()

