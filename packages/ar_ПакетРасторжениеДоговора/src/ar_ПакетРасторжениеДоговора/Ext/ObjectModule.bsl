// JSON Schema аргументов contract_termination_documents_resolve: ref (строка из disputed), decision (enum).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовРешения()

	СвойствоСсылки = Новый Структура;
	СвойствоСсылки.Вставить("type", "string");
	СвойствоСсылки.Вставить("description",
		НСтр("ru = 'ref спорного файла из списка disputed ответа contract_termination_documents_sort,
			|например 1.f0003'"));

	СвойствоРешения = Новый Структура;
	СвойствоРешения.Вставить("type", "string");
	СвойствоРешения.Вставить("enum", ДопустимыеРешения());
	СвойствоРешения.Вставить("description",
		НСтр("ru = 'related - файл относится к договору, unrelated - не относится'"));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", СвойствоСсылки);
	Свойства.Вставить("decision", СвойствоРешения);

	Обязательные = Новый Массив;
	Обязательные.Добавить("ref");
	Обязательные.Добавить("decision");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат(ИмяИнструментаРешения(),
		НСтр("ru = 'Решить спорный файл разбора выгрузки ДО по ref.'"), Параметры);

КонецФункции

