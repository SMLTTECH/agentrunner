#КонецОбласти

#Область ИнструментСбораДокументов

// Шаги вложений: один пакетный запрос на три шага; сбой запроса валит только
// эти шаги (status = error каждому), остальные уже выполнены (спека п.3).
//
// Параметры:
//  Сбор - Структура - контекст сбора (изменяется Сбор.Шаги).
//
Процедура ВыполнитьШагиВложений(Знач Сбор)

	ОбновитьПульсСбора(Сбор);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		СтрокиДокументов = ДокументыВложенийПоДоговору(Сбор.Предмет);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСбойШагаВЛог(Сбор, "ks2, commission_reports, ks2_corrections", ТекстОшибки,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Для Каждого ВидШага Из ВидыШаговВложений() Цикл
			Шаг = НовыйШагОтвета(ВидШага);
			Шаг.status = "error";
			Шаг.message = ТекстОшибки;
			Сбор.Ошибок = Сбор.Ошибок + 1;
			РезультатОшибки = НСтр("ru = 'ошибка'") + ": " + ТекстОшибки;
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШагаЖурнала(ВидШага), "", "", "", 0, РезультатОшибки);
			Сбор.Шаги.Добавить(Шаг);
		КонецЦикла;
		Возврат;
	КонецПопытки;

	// Запрос документов по договору - отдельной строкой времени: поле договора
	// в документах не индексировано, на больших базах это заметная часть сбора.
	ЗаписатьВремяШага(Сбор, "documents_query", "ok", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс);

	Для Каждого ВидШага Из ВидыШаговВложений() Цикл
		ШагВложений = ВыполнитьШагНезависимо(Сбор, ВидШага, СтрокиДокументов.Получить(ВидШага));
		Сбор.Шаги.Добавить(ШагВложений);
	КонецЦикла;

КонецПроцедуры

// Реализация инструмента contract_termination_collect (спека agentrunner-471 п.3).
// Порядок: предмет и инициатор по RunId -> настройки (каталог, дата начала) ->
// режим без записи (план, ничего не создается) -> подкаталог договора и журнал ->
// независимые шаги (акт сверки, отчет, вложения) -> итоговый ответ. Ошибки,
// которые аргументом не исправить (не договор, пустой каталог, недоступен
// подкаталог), - {"error": код, "message", "next": "finish"}.
//
// Параметры:
//  АргументыJSON - Строка    - JSON аргументов (аргументов нет, читается _dry_run).
//  Контекст      - Структура - контекст запуска (RunId, ...); может быть
//                  Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {directory, log_file, saved_files, steps, [log_error]}
//  либо {error, message, next: "finish"}.
//
Функция ВыполнитьСборДокументов(Знач АргументыJSON, Знач Контекст)

	Шапка = ШапкаЗапуска(RunIdИзКонтекста(Контекст));
	Если ТипЗнч(Шапка.Предмет) <> Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Возврат ОшибкаЗавершенияИнструмента("not_contract",
			НСтр("ru = 'Предмет запуска не является договором контрагента.'"));
	КонецЕсли;

	КаталогДокументов = КаталогДокументовИзНастройки();
	Если ПустаяСтрока(КаталогДокументов) Тогда
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Не задан каталог документов (доп. настройка «%1»).'"),
			КлючНастройкиКаталога());
		Возврат ОшибкаЗавершенияИнструмента("no_directory", СообщениеОбОшибке);
	КонецЕсли;

	РеквизитыДоговора = РеквизитыДоговораДляСбора(Шапка.Предмет);
	ДатаНачала = ДатаНачалаПериода();

	// Режим без записи: документ не создается, каталоги, файлы и журнал не пишутся.
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON(ИмяИнструментаСбора(),
			ПланСбораДляОтвета(Шапка.Предмет, КаталогДокументов, РеквизитыДоговора, ДатаНачала));
	КонецЕсли;

	КаталогПодкаталога = КаталогДокументов + "\" + ИмяПодкаталогаСбора(КаталогДокументов, РеквизитыДоговора);
	Попытка
		СоздатьКаталог(КаталогПодкаталога);
	Исключение
		Возврат ОшибкаЗавершенияИнструмента("directory_unavailable",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Журнал создается сразу после подкаталога, до шагов; сбой создания - как
	// недоступность каталога для записи (спека п.3 «журнал работы»).
	Журнал = ОткрытьЖурналСбора(КаталогПодкаталога + "\" + ИмяФайлаЖурнала());
	Если Журнал.Запись = Неопределено Тогда
		Возврат ОшибкаЗавершенияИнструмента("directory_unavailable", Журнал.ОшибкаЗаписи);
	КонецЕсли;

	Сбор = НовыйСтруктураСбора(Шапка.Предмет, РеквизитыДоговора, ДатаНачала,
		КаталогПодкаталога, Журнал, Шапка.Пользователь, RunIdИзКонтекста(Контекст));
	ЗаписатьШапкуЖурнала(Сбор, Контекст);

	// Шаги под общей попыткой только ради гарантии закрытия журнала: исключения
	// самих шагов поглощаются ВыполнитьШагНезависимо, сюда долетает непредвиденное.
	Попытка
		ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаАктаСверки());
		Сбор.Шаги.Добавить(ШагОтвета);
		ШагОтвета = ВыполнитьШагНезависимо(Сбор, КодШагаОтчетаПлатежных());
		Сбор.Шаги.Добавить(ШагОтвета);
		ВыполнитьШагиВложений(Сбор);
		ЗаписатьИтогЖурнала(Сбор);
	Исключение
		ЗакрытьЖурнал(Сбор.Журнал);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьЖурнал(Сбор.Журнал);

	Возврат ОтветОбУспехе(Сбор);

КонецФункции

// Контекст всего сбора: предмет, настройки, пути, журнал и итоги. Дата окончания
// периода - конец текущего дня сеанса.
//
// Параметры:
//  Предмет            - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  РеквизитыДоговора  - Структура - {Номер, Дата, Владелец, Организация}.
//  ДатаНачала         - Дата - дата начала периода из настройки.
//  КаталогПодкаталога - Строка - каталог сбора договора.
//  Журнал             - Структура - журнал сбора (см. ОткрытьЖурналСбора).
//  Инициатор          - СправочникСсылка.Пользователи - инициатор запуска.
//  RunId              - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - контекст сбора.
//
Функция НовыйСтруктураСбора(Знач Предмет, Знач РеквизитыДоговора, Знач ДатаНачала,
	Знач КаталогПодкаталога, Знач Журнал, Знач Инициатор, Знач RunId)

	Сбор = Новый Структура(
		"Предмет, РеквизитыДоговора, ДатаНачала, ДатаОкончания, КаталогПодкаталога, Журнал,
		|Инициатор, RunId, Шаги, СохраненоФайлов, ПропущеноФайлов, Ошибок",
		Предмет, РеквизитыДоговора, ДатаНачала, КонецДня(ТекущаяДатаСеанса()), КаталогПодкаталога, Журнал,
		Инициатор, RunId, Новый Массив, 0, 0, 0);
	// Пульс запуска и время шагов (agentrunner-483): момент последнего пульса,
	// признак уже записанного сбоя пульса, длительность шага по коду (мс).
	Сбор.Вставить("МоментПульса", ТекущаяДатаСеанса());
	Сбор.Вставить("СбойПульсаЗаписан", Ложь);
	Сбор.Вставить("ДлительностиШагов", Новый Соответствие);
	Возврат Сбор;

КонецФункции

// Каталог документов из настройки пакета (сервер 1С), без концевых пробелов
// и разделителей каталога (иначе при склейке путей получится двойной «\»).
//
// Возвращаемое значение:
//  Строка - каталог; пустая строка, если настройка не строка или не заполнена.
//
Функция КаталогДокументовИзНастройки()

	Значение = ar_Настройки.ЗначениеНастройки(КлючНастройкиКаталога(), "");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Каталог = СокрЛП(Значение);
	Пока СтрЗаканчиваетсяНа(Каталог, "\") Или СтрЗаканчиваетсяНа(Каталог, "/") Цикл
		Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
	КонецЦикла;
	Возврат Каталог;

КонецФункции

// Дата начала периода из настройки пакета (не дата - значение по умолчанию).
//
// Возвращаемое значение:
//  Дата - дата начала периода акта сверки и отчета.
//
Функция ДатаНачалаПериода()

	Значение = ar_Настройки.ЗначениеНастройки(КлючНастройкиДатыНачала(), ДатаНачалаПериодаПоУмолчанию());
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат ДатаНачалаПериодаПоУмолчанию();
	КонецЕсли;
	Возврат НачалоДня(Значение);

КонецФункции

// Дата начала периода по умолчанию (описание задачи: с 01.01.2020) - константа модуля.
//
// Возвращаемое значение:
//  Дата - дата начала периода по умолчанию.
//
Функция ДатаНачалаПериодаПоУмолчанию()

	Возврат '20200101';

КонецФункции

// Номер, дата, контрагент (владелец) и организация договора - одним чтением БСП.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//
// Возвращаемое значение:
//  Структура - {Номер, Дата, Владелец, Организация}.
//
Функция РеквизитыДоговораДляСбора(Знач Договор)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Номер, Дата, Владелец, Организация");

КонецФункции

// Имя подкаталога договора: «<Контрагент> - договор <Номер> от <ДД.ММ.ГГГГ> -
// <ГГГГММДД_ЧЧММСС>». Имена очищаются от недопустимых символов; часть контрагента
// обрезается так, чтобы полный путь подкаталога был не длиннее 250 символов
// (спека п.3 «имена»); повторный запуск создает новый подкаталог (метка времени).
//
// Параметры:
//  КаталогДокументов - Строка          - каталог из настройки.
//  РеквизитыДоговора - Структура       - реквизиты договора.
//
// Возвращаемое значение:
//  Строка - имя подкаталога (без каталога).
//
Функция ИмяПодкаталогаСбора(Знач КаталогДокументов, Знач РеквизитыДоговора)

	ХвостИмени = СтрШаблон(" - договор %1 от %2 - %3", СокрЛП(РеквизитыДоговора.Номер),
		Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"), Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss"));

	ИмяКонтрагента = СокрЛП(Строка(РеквизитыДоговора.Владелец));
	// Резерв под папку шага и имя файла: лимит 250 - для полного пути файла, не подкаталога.
	ДоступноКонтрагенту = МаксимальнаяДлинаПути() - РезервДлиныПутиФайла() - СтрДлина(КаталогДокументов) - 1
		- СтрДлина(ХвостИмени);
	Если ДоступноКонтрагенту < 0 Тогда
		ИмяКонтрагента = "";
	ИначеЕсли СтрДлина(ИмяКонтрагента) > ДоступноКонтрагенту Тогда
		ИмяКонтрагента = Лев(ИмяКонтрагента, ДоступноКонтрагенту);
	Иначе
		// Имя контрагента помещается целиком - не обрезается.
	КонецЕсли;

	Возврат ОчиститьИмяФайла(ИмяКонтрагента + ХвостИмени);

КонецФункции

// Максимальная длина полного пути файла (спека п.3 «имена»: путь не длиннее
// 250 символов с сохранением расширения) - константа модуля.
//
// Возвращаемое значение:
//  Число - максимальная длина пути.
//
Функция МаксимальнаяДлинаПути()

	Возврат 250;

КонецФункции

// Резерв длины пути под «\<папка шага>\<префикс документа><имя файла>» внутри
// подкаталога договора - константа модуля.
//
// Возвращаемое значение:
//  Число - резерв длины пути.
//
Функция РезервДлиныПутиФайла()

	Возврат 100;

КонецФункции

// План сбора для режима без записи: путь подкаталога, найден ли доп. отчет,
// число документов каждого вида, будет ли акт сверки взят повторно (спека п.3).
//
// Параметры:
//  Предмет            - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  КаталогДокументов  - Строка    - каталог из настройки.
//  РеквизитыДоговора  - Структура - реквизиты договора.
//  ДатаНачала         - Дата      - дата начала периода.
//
// Возвращаемое значение:
//  Структура - {directory, report_found, documents: {ks2, commission_reports,
//  ks2_corrections}, act_reused}.
//
Функция ПланСбораДляОтвета(Знач Предмет, Знач КаталогДокументов, Знач РеквизитыДоговора, Знач ДатаНачала)

	План = Новый Структура;
	План.Вставить("directory",
		КаталогДокументов + "\" + ИмяПодкаталогаСбора(КаталогДокументов, РеквизитыДоговора));

	СсылкиОтчета = СсылкиДопОтчетаПлатежных();
	План.Вставить("report_found", СсылкиОтчета.Количество() = 1);

	ДокументыПлана = Новый Структура;
	ДокументыПлана.Вставить(КодШагаКС2(), 0);
	ДокументыПлана.Вставить(КодШагаОтчетовКомитенту(), 0);
	ДокументыПлана.Вставить(КодШагаКорректировочныхКС2(), 0);
	Попытка
		СтрокиДокументов = ДокументыВложенийПоДоговору(Предмет);
		Для Каждого Пара Из СтрокиДокументов Цикл
			ДокументыПлана.Вставить(Пара.Ключ, Пара.Значение.Количество());
		КонецЦикла;
	Исключение
		// План без числа документов хуже плана с числом, но не причина отказывать
		// в ответе режима без записи.
		ТекстОшибки = СтрШаблон("Договор=%1; Шаг=dry_run_documents; %2", Строка(Предмет),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_docs_step_failed", ТекстОшибки,
			"Ошибка", , Предмет);
	КонецПопытки;
	План.Вставить("documents", ДокументыПлана);

	План.Вставить("act_reused", СегодняшнийАктСверки(Предмет, ДатаНачала) <> Неопределено);

	Возврат План;

КонецФункции

#КонецОбласти

#Область ЖурналСбора

// Открывает журнал сбора «Журнал сбора документов.txt» для дописывания:
// UTF-8 с BOM (открывается в Блокноте и Excel), строки дописываются по ходу
// работы, файл закрывается в любом исходе (спека п.3 «журнал работы»).
//
// Параметры:
//  ПутьЖурнала - Строка - полный путь файла журнала.
//
// Возвращаемое значение:
//  Структура:
//   * Запись       - ЗаписьТекста, Неопределено - открытая запись (Неопределено -
//                    не удалось создать файл, причина в ОшибкаЗаписи).
//   * Путь         - Строка - путь файла журнала.
//   * ОшибкаЗаписи - Строка - первая ошибка записи (создание - в вызывающий код).
//
Функция ОткрытьЖурналСбора(Знач ПутьЖурнала)

	Журнал = Новый Структура("Запись, Путь, ОшибкаЗаписи", Неопределено, ПутьЖурнала, "");

	Попытка
		// Файл новый (новый подкаталог): без дописывания - платформа пишет BOM.
		Журнал.Запись = Новый ЗаписьТекста(ПутьЖурнала, КодировкаТекста.UTF8, Символы.ПС, Ложь);
	Исключение
		Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Журнал;

КонецФункции

// Шапка журнала: договор, контрагент, организация, инициатор, запуск, агент,
// период и время начала (спека п.3 «журнал работы»).
//
// Параметры:
//  Сбор     - Структура - контекст сбора.
//  Контекст - Структура - контекст вызова инструмента (Агент - при наличии).
//
Процедура ЗаписатьШапкуЖурнала(Знач Сбор, Знач Контекст)

	РеквизитыДоговора = Сбор.РеквизитыДоговора;
	ФорматДаты = "ДФ=dd.MM.yyyy";

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Договор: № %1 от %2'"),
		СокрЛП(РеквизитыДоговора.Номер), Формат(РеквизитыДоговора.Дата, ФорматДаты));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Контрагент: %1'"), Строка(РеквизитыДоговора.Владелец));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Организация: %1'"), Строка(РеквизитыДоговора.Организация));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Инициатор: %1'"), Строка(Сбор.Инициатор));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Запуск AgentRunner: %1'"), Сбор.RunId);
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	ИмяАгента = "";
	Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("Агент") Тогда
		ИмяАгента = Строка(Контекст.Агент);
	КонецЕсли;
	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Агент: %1'"), ?(ПустаяСтрока(ИмяАгента), "-", ИмяАгента));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Период: %1 - %2'"), Формат(Сбор.ДатаНачала, ФорматДаты),
		Формат(Сбор.ДатаОкончания, ФорматДаты));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Начало: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	ДописатьСтрокуВЖурнал(Сбор.Журнал, "");

КонецПроцедуры

// Дописывает строку события в журнал; поля - через табуляцию (столбцы в Excel):
// время ЧЧ:ММ:СС, шаг, документ-источник, исходный файл, сохранен как,
// размер (байт), результат (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал           - Структура - журнал сбора.
//  Шаг              - Строка - имя шага журнала («Акт сверки», «КС-2», ...).
//  ДокументИсточник - Строка - представление документа-источника.
//  ИсходныйФайл     - Строка - имя исходного присоединенного файла.
//  СохраненКак      - Строка - путь относительно подкаталога.
//  Размер           - Число - размер сохраненного файла, байт.
//  Результат        - Строка - результат события.
//
Процедура ЗаписатьСтрокуЖурнала(Знач Журнал, Знач Шаг, Знач ДокументИсточник = "", Знач ИсходныйФайл = "",
	Знач СохраненКак = "", Знач Размер = 0, Знач Результат = "")

	Поля = Новый Массив;
	Поля.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss"));
	Поля.Добавить(Шаг);
	Поля.Добавить(ДокументИсточник);
	Поля.Добавить(ИсходныйФайл);
	Поля.Добавить(СохраненКак);
	Поля.Добавить(Формат(Размер, "ЧГ=0"));
	Поля.Добавить(Результат);

	ДописатьСтрокуВЖурнал(Журнал, СтрСоединить(Поля, Символы.Таб));

КонецПроцедуры

// Дописывает готовую строку в журнал. Ошибка записи (кроме создания) не прерывает
// работу: причина запоминается в журнале (в ответ попадает log_error) и пишется
// в служебный лог - один раз (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал - Структура - журнал сбора.
//  Текст  - Строка    - строка журнала.
//
Процедура ДописатьСтрокуВЖурнал(Знач Журнал, Знач Текст)

	Если Журнал.Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Журнал.Запись.ЗаписатьСтроку(Текст);
	Исключение
		Если ПустаяСтрока(Журнал.ОшибкаЗаписи) Тогда
			Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_log_write_failed",
				Журнал.ОшибкаЗаписи, "Ошибка");
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Итог журнала: время окончания, сохранено, пропущено, ошибок и статус по шагам
// (спека п.3 «журнал работы»).
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
Процедура ЗаписатьИтогЖурнала(Знач Сбор)

	ФорматЧисла = "ЧГ=0";

	ДописатьСтрокуВЖурнал(Сбор.Журнал, "");

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Окончание: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Сохранено файлов: %1'"),
		Формат(Сбор.СохраненоФайлов, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Пропущено: %1'"),
		Формат(Сбор.ПропущеноФайлов, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Ошибок: %1'"), Формат(Сбор.Ошибок, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	Для Каждого Шаг Из Сбор.Шаги Цикл
		СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Шаг %1: %2'"), ИмяШагаЖурнала(Шаг.step), Шаг.status);
		ДлительностьМс = Сбор.ДлительностиШагов.Получить(Шаг.step);
		Если ДлительностьМс <> Неопределено Тогда
			СтрокаЖурнала = СтрокаЖурнала + СтрШаблон(НСтр("ru = ', %1 с'"),
				Формат(ДлительностьМс / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0"));
		КонецЕсли;
		ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);
	КонецЦикла;

КонецПроцедуры

// Закрывает журнал; при сбое закрытия повторная попытка не выполняется - файл
// остается с тем, что успели (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал - Структура - журнал сбора.
//
Процедура ЗакрытьЖурнал(Знач Журнал)

	Если Журнал.Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Журнал.Запись.Закрыть();
	Исключение
		Если ПустаяСтрока(Журнал.ОшибкаЗаписи) Тогда
			Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_log_close_failed",
				Журнал.ОшибкаЗаписи, "Ошибка");
		КонецЕсли;
	КонецПопытки;
	Журнал.Запись = Неопределено;

КонецПроцедуры

// Имя файла журнала - константа модуля (спека п.3).
