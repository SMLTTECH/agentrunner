// Отправляет инициатору письмо с итогом разбора (спека Г.3) или о незавершенном разборе (failed, спека В.2):
// путь «Разбор», счетчики, списки «Не распознано» и «Спорно - решить вручную» (до 50 имен), предупреждение
// о другом договоре ДО первой строкой. Почта - по образцу ar_ОтправитьАгентуКонтрагента. Нет инициатора,
// адреса, учетной записи, ошибка отправки - служебный лог contract_do_sort_mail_not_sent, без исключения.
//
// Параметры:
//  Подкаталог  - Строка - подкаталог договора.
//  Задание     - Соответствие - задание разбора (initiator_uuid, contract_number, contract_date).
//  Состояние   - Соответствие, Неопределено - состояние разбора.
//  НеЗавершен  - Булево - письмо о незавершенном разборе.
//
// Возвращаемое значение:
//  Строка - причина неотправки; пустая строка - письмо отправлено.
//
Функция ОтправитьПисьмоИтогаРазбора(Знач Подкаталог, Знач Задание, Знач Состояние, Знач НеЗавершен)

	Причина = "";
	Попытка
		Причина = ПричинаНеотправкиПисьмаРазбора(Подкаталог, Задание, Состояние, НеЗавершен);
	Исключение
		Причина = ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Не ПустаяСтрока(Причина) Тогда
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_sort_mail_not_sent",
			СтрШаблон("Подкаталог=%1; %2", Подкаталог, Причина), "Предупреждение");
	КонецЕсли;
	Возврат Причина;

КонецФункции

// Собирает и отправляет письмо итога разбора.
//
// Параметры:
//  Подкаталог  - Строка - подкаталог договора.
//  Задание     - Соответствие - задание разбора.
//  Состояние   - Соответствие, Неопределено - состояние разбора.
//  НеЗавершен  - Булево - письмо о незавершенном разборе.
//
// Возвращаемое значение:
//  Строка - причина неотправки; пустая строка - отправлено.
//
Функция ПричинаНеотправкиПисьмаРазбора(Знач Подкаталог, Знач Задание, Знач Состояние, Знач НеЗавершен)

	Инициатор = ИнициаторЗадания(Задание);
	Если Инициатор = Неопределено Тогда
		Возврат НСтр("ru = 'инициатор не найден'");
	КонецЕсли;

	АдресПочты = ar_Уведомления.EmailПользователя(Инициатор);
	Если ПустаяСтрока(АдресПочты) Тогда
		Возврат НСтр("ru = 'у инициатора нет адреса почты'");
	КонецЕсли;

	ВыборУЗ = УчетнаяЗаписьПисьмаРазбора();
	Если ВыборУЗ.Ссылка = Неопределено Тогда
		Возврат НСтр("ru = 'нет учетной записи почты для отправки'");
	КонецЕсли;

	ОписаниеДоговора = СтрШаблон(НСтр("ru = '№ %1 от %2'"), ПолеОбъекта(Задание, "contract_number"),
		Формат(ДатаИзСтрокиФайла(ПолеОбъекта(Задание, "contract_date")), "ДФ=dd.MM.yyyy"));

	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Отправитель = ВыборУЗ.Адрес;
	Письмо.ИмяОтправителя = "AgentRunner";
	Если НеЗавершен Тогда
		Письмо.Тема = СтрШаблон(НСтр("ru = 'Разбор выгрузки ДО не завершен: договор %1'"), ОписаниеДоговора);
	Иначе
		Письмо.Тема = СтрШаблон(НСтр("ru = 'Разбор выгрузки ДО: договор %1'"), ОписаниеДоговора);
	КонецЕсли;
	Письмо.Тексты.Добавить(ТекстПисьмаРазбора(Подкаталог, Состояние, НеЗавершен),
		ТипТекстаПочтовогоСообщения.ПростойТекст);
	Письмо.Получатели.Добавить(АдресПочты, Строка(Инициатор));

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ВыборУЗ.Ссылка, Письмо);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если РезультатОтправки.ОшибочныеПолучатели.Количество() > 0 Тогда
		Возврат НСтр("ru = 'почтовый сервер отклонил получателя'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Инициатор задания по initiator_uuid; не задан, удален - Неопределено.
//
// Параметры:
//  Задание - Соответствие - задание разбора.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено.
//
Функция ИнициаторЗадания(Знач Задание)

	Попытка
		УИДИнициатора = Новый УникальныйИдентификатор(СокрЛП(ПолеОбъекта(Задание, "initiator_uuid")));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Инициатор = Справочники.Пользователи.ПолучитьСсылку(УИДИнициатора);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Инициатор, "ПометкаУдаления") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Инициатор;

КонецФункции

// Текст письма итога разбора.
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//  Состояние  - Соответствие, Неопределено - состояние разбора.
//  НеЗавершен - Булево - письмо о незавершенном разборе.
//
// Возвращаемое значение:
//  Строка - текст письма.
//
Функция ТекстПисьмаРазбора(Знач Подкаталог, Знач Состояние, Знач НеЗавершен)

	Строки = Новый Массив;
	Для Каждого ПроверкаДО Из ПолеОбъекта(Состояние, "do_contract_check", Новый Массив) Цикл
		Если ПолеОбъекта(ПроверкаДО, "result") = "mismatch" Тогда
			Строки.Добавить(СтрШаблон(
				НСтр("ru = 'Из ДО выгружен другой договор (№ %1 от %2) - проверьте выгрузку.'"),
				ПолеОбъекта(ПроверкаДО, "do_number"), ПолеОбъекта(ПроверкаДО, "do_date")));
		КонецЕсли;
	КонецЦикла;

	Если НеЗавершен Тогда
		Строки.Добавить(НСтр("ru = 'Разбор выгрузки ДО не завершен: запуски агента не закончили работу.
			|Разложено то, что успели; остальное разберите вручную.'"));
	Иначе
		Строки.Добавить(НСтр("ru = 'Разбор выгрузки ДО завершен.'"));
	КонецЕсли;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Папка разбора: %1'"), Подкаталог + "\" + ИмяПапкиРазбора()));

	Если Состояние <> Неопределено Тогда
		Счетчики = СчетчикиРазбора(Состояние);
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Относится к договору: %1; не относится: %2; не распознано: %3;
			|спорно: %4; ошибок копирования: %5.'"), Счетчики.related, Счетчики.unrelated, Счетчики.unrecognized,
			Счетчики.disputed, Счетчики.copy_errors));
		ДобавитьСписокФайловВПисьмо(Строки, Состояние, КатегорияНеРаспознано(),
			НСтр("ru = 'Не распознано (разберите вручную):'"));
		ДобавитьСписокФайловВПисьмо(Строки, Состояние, КатегорияСпорно(),
			НСтр("ru = 'Спорно - решить вручную:'"));
	КонецЕсли;

	Строки.Добавить(СтрШаблон(НСтр("ru = 'Подробности - в файле «%1».'"), ИмяФайлаЖурналаРазбора()));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Добавляет в письмо список имен файлов категории (основные файлы, без подписей): до 50 имен, дальше -
// «и еще N, см. журнал».
//
// Параметры:
//  Строки     - Массив из Строка - строки письма (дополняется).
//  Состояние  - Соответствие - состояние разбора.
//  Категория  - Строка - код категории.
//  Заголовок  - Строка - заголовок списка.
//
Процедура ДобавитьСписокФайловВПисьмо(Знач Строки, Знач Состояние, Знач Категория, Знач Заголовок)

	ПределИмен = 50;
	Имена = Новый Массив;
	Всего = 0;
	Для Каждого ЭлементФайла Из ПолеОбъекта(Состояние, "files", Новый Массив) Цикл
		Если ПолеОбъекта(ЭлементФайла, "category") <> Категория
			Или Не ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "main")) Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если Имена.Количество() < ПределИмен Тогда
			ПричинаФайла = ПолеОбъекта(ЭлементФайла, "reason");
			Имена.Добавить("- " + ПолеОбъекта(ЭлементФайла, "name")
				+ ?(ПустаяСтрока(ПричинаФайла), "", " (" + ПричинаФайла + ")"));
		КонецЕсли;
	КонецЦикла;

	Если Всего = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить("");
	Строки.Добавить(Заголовок);
	Для Каждого ИмяФайла Из Имена Цикл
		Строки.Добавить(ИмяФайла);
	КонецЦикла;
	Если Всего > Имена.Количество() Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'и еще %1, см. журнал'"), Всего - Имена.Количество()));
	КонецЕсли;

КонецПроцедуры

// Учетная запись отправки письма итога - как у ar_ОтправитьАгентуКонтрагента.УчетнаяЗаписьОтправки:
// настройка ядра ПочтаУчетнаяЗаписьУведомлений -> системная -> первая доступная для отправки.
//
// Возвращаемое значение:
//  Структура - {Ссылка: СправочникСсылка.УчетныеЗаписиЭлектроннойПочты, Неопределено; Адрес: Строка}.
//
Функция УчетнаяЗаписьПисьмаРазбора()

	Результат = Новый Структура("Ссылка, Адрес", Неопределено, "");

	Настройка = ar_Настройки.ЗначениеНастройкиБезКэша("ПочтаУчетнаяЗаписьУведомлений");
	Если ТипЗнч(Настройка) = Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") И ЗначениеЗаполнено(Настройка) Тогда
		Реквизиты = Неопределено;
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "ПометкаУдаления, АдресЭлектроннойПочты");
		Исключение
			Реквизиты = Неопределено;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);

		Если Реквизиты <> Неопределено И Не Реквизиты.ПометкаУдаления Тогда
			Результат.Ссылка = Настройка;
			Результат.Адрес = СокрЛП(Строка(Реквизиты.АдресЭлектроннойПочты));
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Записи = РаботаСПочтовымиСообщениями.ДоступныеУчетныеЗаписи(Истина, , Истина);
	Если Записи.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ВыбраннаяЗапись = Записи[0];
	СистемнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ссылка = СистемнаяЗапись Тогда
			ВыбраннаяЗапись = Запись;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат.Ссылка = ВыбраннаяЗапись.Ссылка;
	Результат.Адрес = СокрЛП(ВыбраннаяЗапись.Адрес);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнструментРазбораВыгрузкиДО

// Реализация инструмента contract_termination_documents_sort (спека Г.1): задание ищется по договору запуска (не по
// комментарию - он в момент вызова недоступен), владение разбором - по run_id в «Состоянии разбора» (Е.5),
// обход файлов списков выгрузки с извлечением текста, решение по категориям, копирование в «Разбор\<категория>»,
// спорные - модели (до 20). Нет спорных для модели - разбор сразу завершается (Г.3).
//
// Параметры:
//  АргументыJSON - Строка    - JSON аргументов (аргументов нет, читается _dry_run).
//  Контекст      - Структура - контекст запуска (RunId, ...); может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. ОтветРазбора) либо {error, message[, next]}.
//
Функция ВыполнитьРазборДокументов(Знач АргументыJSON, Знач Контекст)

	Подготовка = ПодготовкаРазбора(Контекст, Ложь);
	Если Не ПустаяСтрока(Подготовка.ОтветОшибки) Тогда
		Возврат Подготовка.ОтветОшибки;
	КонецЕсли;

	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON(ИмяИнструментаРазбора(),
			ПланРазбораДляОтвета(Подготовка.Найденное.Подкаталог));
	КонецЕсли;

	Разбор = НовыйКонтекстРазбора(Подготовка, RunIdИзКонтекста(Контекст));
	ОткрытьЖурналРазбора(Разбор);
	ОтветОшибки = "";
	Попытка
		ОтветОшибки = ОшибкаВладенияРазбором(Разбор, Истина);
		Если ПустаяСтрока(ОтветОшибки) И Не РазборЗакончен(Разбор.Состояние) Тогда
			ВыполнитьОбходРазбора(Разбор);
			ОтветОшибки = ОтветОшибкиЗаписиСостояния(Разбор);
		КонецЕсли;
		Если ПустаяСтрока(ОтветОшибки) И Не РазборЗакончен(Разбор.Состояние) Тогда
			ВосстановитьРешенияПоДиску(Разбор);
			ЗавершитьРазборЕслиРешено(Разбор);
			ОтветОшибки = ОтветОшибкиЗаписиСостояния(Разбор);
		КонецЕсли;
	Исключение
		ЗакрытьЖурнал(Разбор.Журнал);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьЖурнал(Разбор.Журнал);

	Если Не ПустаяСтрока(ОтветОшибки) Тогда
		Возврат ОтветОшибки;
	КонецЕсли;
	Возврат ОтветРазбора(Разбор);

КонецФункции

// Реализация инструмента contract_termination_documents_resolve (спека Г.2): спорный файл ищется по ref из disputed
// (не по имени), переносится из «Спорно» в «Относится» или «Не относится» вместе с подписями; решен последний
// спорный из выданных модели - разбор завершается.
//
// Параметры:
//  АргументыJSON - Строка    - JSON аргументов {ref, decision}.
//  Контекст      - Структура - контекст запуска; может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. ОтветРазбора, с полем resolved) либо {error, message[, allowed][, next]}.
//
Функция ВыполнитьРешениеСпорного(Знач АргументыJSON, Знач Контекст)

	Аргументы = ar_JSON.ИзJSON(АргументыJSON);
	РефФайла = КодАргумента(ПолеОбъекта(Аргументы, "ref"));
	Решение = КодАргумента(ПолеОбъекта(Аргументы, "decision"));
	Если Решение <> КатегорияОтносится() И Решение <> КатегорияНеОтносится() Тогда
		Возврат ОшибкаАргумента("invalid_decision",
			НСтр("ru = 'Решение decision - только related (относится) или unrelated (не относится).'"),
			ДопустимыеРешения());
	КонецЕсли;

	Подготовка = ПодготовкаРазбора(Контекст, Истина);
	Если Не ПустаяСтрока(Подготовка.ОтветОшибки) Тогда
		Возврат Подготовка.ОтветОшибки;
	КонецЕсли;

	Если Не ОбходРазбораПройден(Подготовка.Найденное.Состояние) Тогда
		Возврат ОшибкаАргумента("sort_not_done",
			НСтр("ru = 'Разбор еще не прошел все файлы - сначала вызовите contract_termination_documents_sort.'"));
	КонецЕсли;

	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		План = Новый Структура("ref, decision, directory", РефФайла, Решение,
			Подготовка.Найденное.Подкаталог + "\" + ИмяПапкиРазбора() + "\" + ИмяПапкиКатегории(Решение));
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON(ИмяИнструментаРешения(), План);
	КонецЕсли;

	Разбор = НовыйКонтекстРазбора(Подготовка, RunIdИзКонтекста(Контекст));
	ОткрытьЖурналРазбора(Разбор);
	ОтветОшибки = "";
	Попытка
		ОтветОшибки = ОшибкаВладенияРазбором(Разбор, Ложь);
		Если ПустаяСтрока(ОтветОшибки) И Не РазборЗакончен(Разбор.Состояние) Тогда
			ВосстановитьРешенияПоДиску(Разбор);
			ОтветОшибки = ОшибкаРешенияСпорного(Разбор, РефФайла, Решение);
		КонецЕсли;
		Если ПустаяСтрока(ОтветОшибки) И Не РазборЗакончен(Разбор.Состояние) Тогда
			ЗавершитьРазборЕслиРешено(Разбор);
			ОтветОшибки = ОтветОшибкиЗаписиСостояния(Разбор);
		КонецЕсли;
	Исключение
		ЗакрытьЖурнал(Разбор.Журнал);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьЖурнал(Разбор.Журнал);

	Если Не ПустаяСтрока(ОтветОшибки) Тогда
		Возврат ОтветОшибки;
	КонецЕсли;
	Возврат ОтветРазбора(Разбор, РефФайла);

КонецФункции

// Общая подготовка обоих инструментов: предмет запуска - договор, каталог задан, найдено задание разбора.
//
// Параметры:
//  Контекст        - Структура - контекст запуска.
//  ТолькоНачатые   - Булево - искать только задания с начатым разбором (для contract_termination_documents_resolve).
//
// Возвращаемое значение:
//  Структура:
//   * ОтветОшибки - Строка - JSON ошибки; пустая строка - подготовка удалась.
//   * Договор     - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//   * Найденное   - Структура - {Подкаталог, Задание, Состояние} (см. ЗаданияРазбораДоговора).
//
Функция ПодготовкаРазбора(Знач Контекст, Знач ТолькоНачатые)

	Результат = Новый Структура("ОтветОшибки, Договор, Найденное", "", Неопределено, Неопределено);

	Шапка = ШапкаЗапуска(RunIdИзКонтекста(Контекст));
	Если ТипЗнч(Шапка.Предмет) <> Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Результат.ОтветОшибки = ОшибкаЗавершенияИнструмента("not_contract",
			НСтр("ru = 'Предмет запуска не является договором контрагента.'"));
		Возврат Результат;
	КонецЕсли;
	Результат.Договор = Шапка.Предмет;

	КаталогДокументов = КаталогДокументовИзНастройки();
	Если ПустаяСтрока(КаталогДокументов) Тогда
		Результат.ОтветОшибки = ОшибкаЗавершенияИнструмента("no_directory",
			СтрШаблон(НСтр("ru = 'Не задан каталог документов (доп. настройка «%1»).'"), КлючНастройкиКаталога()));
		Возврат Результат;
	КонецЕсли;

	Результат.Найденное = ЗаданиеДляРазбора(КаталогДокументов, Шапка.Предмет, ТолькоНачатые);
	Если Результат.Найденное = Неопределено Тогда
		Результат.ОтветОшибки = ОшибкаЗавершенияИнструмента("no_pending_sort",
			НСтр("ru = 'По договору нет выгрузки ДО, ожидающей разбора.'"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Задание для разбора по договору (спека Г.1): queued, или waiting с готовым списком выгрузки, разбор не
// закончен; из нескольких - сначала с начатым разбором, затем самое раннее по created.
//
// Параметры:
//  КаталогДокументов - Строка - каталог из настройки.
//  Договор           - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  ТолькоНачатые     - Булево - только задания с «Состоянием разбора».
//
// Возвращаемое значение:
//  Структура, Неопределено - {Подкаталог, Задание, Состояние}; Неопределено - задания нет.
//
Функция ЗаданиеДляРазбора(Знач КаталогДокументов, Знач Договор, Знач ТолькоНачатые)

	Выбранное = Неопределено;
	Для Каждого НайденноеЗадание Из ЗаданияРазбораДоговора(КаталогДокументов, Договор) Цикл
		СтатусЗадания = ПолеОбъекта(НайденноеЗадание.Задание, "status");
		Начато = НайденноеЗадание.Состояние <> Неопределено;
		Если РазборЗакончен(НайденноеЗадание.Состояние) Или (ТолькоНачатые И Не Начато) Тогда
			Продолжить;
		КонецЕсли;
		Подходит = (СтатусЗадания = СтатусЗаданияВОчереди())
			Или (СтатусЗадания = СтатусЗаданияОжидает()
				И (Начато Или ЕстьСписокВыгрузки(НайденноеЗадание.Подкаталог)));
		Если Не Подходит Тогда
			Продолжить;
		КонецЕсли;
		Если Выбранное = Неопределено Или ЗаданиеРазбораРаньше(НайденноеЗадание, Выбранное) Тогда
			Выбранное = НайденноеЗадание;
		КонецЕсли;
	КонецЦикла;
	Возврат Выбранное;

КонецФункции

// Порядок выбора задания: начатый разбор раньше не начатого, затем по created.
//
// Параметры:
//  Первое - Структура - {Задание, Состояние}.
//  Второе - Структура - {Задание, Состояние}.
//
// Возвращаемое значение:
//  Булево - Истина, если Первое выбирается раньше Второго.
//
Функция ЗаданиеРазбораРаньше(Знач Первое, Знач Второе)

	ПервоеНачато = Первое.Состояние <> Неопределено;
	ВтороеНачато = Второе.Состояние <> Неопределено;
	Если ПервоеНачато <> ВтороеНачато Тогда
		Возврат ПервоеНачато;
	КонецЕсли;
	Возврат ДатаИзСтрокиФайла(ПолеОбъекта(Первое.Задание, "created"))
		< ДатаИзСтрокиФайла(ПолеОбъекта(Второе.Задание, "created"));

КонецФункции

// Контекст разбора одного вызова инструмента.
//
// Параметры:
//  Подготовка           - Структура - результат ПодготовкаРазбора.
//  ИдентификаторЗапуска - Строка - RunId текущего запуска.
//
// Возвращаемое значение:
//  Структура - контекст разбора.
//
Функция НовыйКонтекстРазбора(Знач Подготовка, Знач ИдентификаторЗапуска)

	Подкаталог = Подготовка.Найденное.Подкаталог;
	Разбор = Новый Структура;
	Разбор.Вставить("Предмет", Подготовка.Договор);
	Разбор.Вставить("Подкаталог", Подкаталог);
	Разбор.Вставить("КаталогРазбора", Подкаталог + "\" + ИмяПапкиРазбора());
	Разбор.Вставить("Задание", Подготовка.Найденное.Задание);
	Разбор.Вставить("Состояние", Подготовка.Найденное.Состояние);
	Разбор.Вставить("RunId", ИдентификаторЗапуска);
	Разбор.Вставить("Журнал", Неопределено);
	Разбор.Вставить("ИндексФайлов", Новый Соответствие);
	Разбор.Вставить("МоментЗаписи", ТекущаяДатаСеанса());
	Разбор.Вставить("ФайловДоЗаписи", 0);
	Разбор.Вставить("ОшибкаЗаписиСостояния", "");
	// Пульс запуска ядра во время долгого обхода - как у сбора (ОбновитьПульсСбора).
	Разбор.Вставить("МоментПульса", ТекущаяДатаСеанса());
	Разбор.Вставить("СбойПульсаЗаписан", Ложь);
	ПостроитьИндексФайловРазбора(Разбор);
	Возврат Разбор;

КонецФункции

// Индекс элементов files состояния по ref (объекты те же - изменения видны в состоянии).
//
// Параметры:
//  Разбор - Структура - контекст разбора (изменяется ИндексФайлов).
//
Процедура ПостроитьИндексФайловРазбора(Знач Разбор)

	Разбор.ИндексФайлов = Новый Соответствие;
	Для Каждого ЭлементФайла Из ПолеОбъекта(Разбор.Состояние, "files", Новый Массив) Цикл
		Разбор.ИндексФайлов.Вставить(ПолеОбъекта(ЭлементФайла, "ref"), ЭлементФайла);
	КонецЦикла;

КонецПроцедуры

// Открывает журнал разбора «Журнал разбора ДО.txt» на дописывание (журнал только дописывается, спека Е.5).
//
// Параметры:
//  Разбор - Структура - контекст разбора (изменяется Журнал).
//
Процедура ОткрытьЖурналРазбора(Знач Разбор)

	ПутьЖурнала = Разбор.Подкаталог + "\" + ИмяФайлаЖурналаРазбора();
	Журнал = Новый Структура("Запись, Путь, ОшибкаЗаписи", Неопределено, ПутьЖурнала, "");
	Попытка
		Журнал.Запись = Новый ЗаписьТекста(ПутьЖурнала, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Исключение
		Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_log_write_failed", Журнал.ОшибкаЗаписи, "Ошибка",
			Разбор.RunId, Разбор.Предмет);
	КонецПопытки;
	Разбор.Журнал = Журнал;

КонецПроцедуры

// Строка журнала разбора: время, ref, путь, категория, причина - через табуляцию.
//
// Параметры:
//  Разбор    - Структура - контекст разбора.
//  РефФайла  - Строка - ref файла (пусто для строк о разборе в целом).
//  Путь      - Строка - путь файла относительно папки «ДО».
//  Категория - Строка - код категории или пусто.
//  Причина   - Строка - причина, пояснение.
//
Процедура ЗаписатьСтрокуЖурналаРазбора(Знач Разбор, Знач РефФайла, Знач Путь, Знач Категория, Знач Причина)

	ИмяКатегории = "";
	Если Не ПустаяСтрока(Категория) Тогда
		ИмяКатегории = ИмяПапкиКатегории(Категория);
	КонецЕсли;
	МоментСтроки = Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");

	Поля = Новый Массив;
	Поля.Добавить(МоментСтроки);
	Поля.Добавить(РефФайла);
	Поля.Добавить(Путь);
	Поля.Добавить(ИмяКатегории);
	Поля.Добавить(Причина);
	ДописатьСтрокуВЖурнал(Разбор.Журнал, СтрСоединить(Поля, Символы.Таб));

КонецПроцедуры

// Владение разбором (спека Е.5): состояния нет - создать с текущим запуском (только разбор); run_id текущего
// запуска - продолжить; живой чужой запуск - sort_in_progress; мертвый - перехватить с записью в журнал.
// Закончен - ничего не меняется (вызывающий вернет итог из состояния).
//
// Параметры:
//  Разбор      - Структура - контекст разбора (изменяется Состояние).
//  МожноСоздать - Булево - создать состояние, если его нет.
//
// Возвращаемое значение:
//  Строка - JSON ошибки; пустая строка - разбор ведет текущий запуск.
//
Функция ОшибкаВладенияРазбором(Знач Разбор, Знач МожноСоздать)

	Если Разбор.Состояние = Неопределено Тогда
		Если Не МожноСоздать Тогда
			Возврат ОшибкаЗавершенияИнструмента("no_pending_sort",
				НСтр("ru = 'Разбор по договору не начат.'"));
		КонецЕсли;
		СоздатьКаталог(Разбор.КаталогРазбора);
		Разбор.Состояние = НовоеСостояниеРазбора(Разбор.RunId);
		ПостроитьИндексФайловРазбора(Разбор);
		ЗаписатьСтрокуЖурналаРазбора(Разбор, "", "", "",
			СтрШаблон(НСтр("ru = 'Начало разбора, запуск %1, задание %2'"), Разбор.RunId,
				ПутьЗаданияРазбора(Разбор.Подкаталог)));
		ЗаписатьСостояниеРазбора(Разбор);
		Возврат ОтветОшибкиЗаписиСостояния(Разбор);
	КонецЕсли;

	ВладелецРазбора = ПолеОбъекта(Разбор.Состояние, "run_id");
	Если РазборЗакончен(Разбор.Состояние) Или ВладелецРазбора = Разбор.RunId Тогда
		Возврат "";
	КонецЕсли;

	Если ЗапускРазбораЖив(Разбор.Состояние) Тогда
		Возврат ОшибкаЗавершенияИнструмента("sort_in_progress",
			СтрШаблон(НСтр("ru = 'Разбор по договору ведет другой запуск агента (%1).'"), ВладелецРазбора));
	КонецЕсли;

	Разбор.Состояние.Вставить("run_id", Разбор.RunId);
	ЗаписатьСтрокуЖурналаРазбора(Разбор, "", "", "",
		СтрШаблон(НСтр("ru = 'Продолжение после сбоя запуска %1'"), ВладелецРазбора));
	ЗаписатьСостояниеРазбора(Разбор);
	Возврат ОтветОшибкиЗаписиСостояния(Разбор);

КонецФункции

// Новое «Состояние разбора» (спека Е.5).
//
// Параметры:
//  ИдентификаторЗапуска - Строка - run_id запуска-владельца.
//
// Возвращаемое значение:
//  Соответствие - состояние.
//
Функция НовоеСостояниеРазбора(Знач ИдентификаторЗапуска)

	ТекущийМомент = СтрокаДатыФайла(ТекущаяДатаСеанса());
	Состояние = Новый Соответствие;
	Состояние.Вставить("version", 1);
	Состояние.Вставить("run_id", ИдентификаторЗапуска);
	Состояние.Вставить("started", ТекущийМомент);
	Состояние.Вставить("heartbeat", ТекущийМомент);
	Состояние.Вставить("files", Новый Массив);
	Состояние.Вставить("finished", "");
	Состояние.Вставить("mail", "");
	Состояние.Вставить("mail_reason", "");
	Возврат Состояние;

КонецФункции

// Записывает «Состояние разбора» атомарно, обновляя heartbeat; сбой записи - в контекст разбора (ответ
// state_write_failed) и служебный лог.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
// Возвращаемое значение:
//  Булево - Истина, если записано.
//
Функция ЗаписатьСостояниеРазбора(Знач Разбор)

	Разбор.Состояние.Вставить("heartbeat", СтрокаДатыФайла(ТекущаяДатаСеанса()));
	ОшибкаЗаписи = ОшибкаАтомарнойЗаписиФайла(ПутьСостоянияРазбора(Разбор.Подкаталог), Разбор.Состояние);
	Разбор.МоментЗаписи = ТекущаяДатаСеанса();
	Разбор.ФайловДоЗаписи = 0;
	Если ПустаяСтрока(ОшибкаЗаписи) Тогда
		Возврат Истина;
	КонецЕсли;

	Разбор.ОшибкаЗаписиСостояния = ОшибкаЗаписи;
	ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_do_state_write_failed",
		СтрШаблон("Подкаталог=%1; %2", Разбор.Подкаталог, ОшибкаЗаписи), "Ошибка", Разбор.RunId, Разбор.Предмет);
	Возврат Ложь;

КонецФункции

// Пишет состояние по ходу обхода: после каждых 20 файлов, но не реже раза в минуту (спека Г.1).
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
Процедура ЗаписатьСостояниеПоХоду(Знач Разбор)

	Разбор.ФайловДоЗаписи = Разбор.ФайловДоЗаписи + 1;
	ФайловМеждуЗаписями = 20;
	СекундМеждуЗаписями = 60;
	Если Разбор.ФайловДоЗаписи >= ФайловМеждуЗаписями
		Или ТекущаяДатаСеанса() - Разбор.МоментЗаписи >= СекундМеждуЗаписями Тогда
		ЗаписатьСостояниеРазбора(Разбор);
	КонецЕсли;
	ОбновитьПульсСбора(Разбор);

КонецПроцедуры

// Ответ state_write_failed, если состояние не записалось.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
// Возвращаемое значение:
//  Строка - JSON ошибки; пустая строка - ошибок записи не было.
//
Функция ОтветОшибкиЗаписиСостояния(Знач Разбор)

	Если ПустаяСтрока(Разбор.ОшибкаЗаписиСостояния) Тогда
		Возврат "";
	КонецЕсли;
	СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Не удалось записать файл состояния разбора: %1'"),
		Разбор.ОшибкаЗаписиСостояния);
	Возврат ОшибкаЗавершенияИнструмента("state_write_failed", СообщениеОбОшибке);

КонецФункции

// Обход файлов выгрузки (спека Г.1): первый проход - основные файлы (извлечение текста и решение), второй -
// подписи (категория основного файла). Файлы, уже скопированные (copied), пропускаются - продолжение после
// сбоя. В конце первого полного обхода фиксируется disputed_for_model (до 20 спорных, далее не меняется).
//
// Параметры:
//  Разбор - Структура - контекст разбора (изменяется Состояние).
//
Процедура ВыполнитьОбходРазбора(Знач Разбор)

	Если ОбходРазбораПройден(Разбор.Состояние) Тогда
		Возврат; // Обход уже пройден - остались решения модели.
	КонецЕсли;

	Сверка = ДанныеСверкиДоговора(Разбор.Предмет);
	Элементы = ЭлементыВыгрузки(Разбор, Сверка);
	Разбор.Состояние.Вставить("do_contract_check", Сверка.ПроверкиДО);

	Для Каждого Элемент Из Элементы Цикл
		Если Не Элемент.ЭтоПодпись Тогда
			ОбработатьФайлРазбора(Разбор, Элемент, Сверка);
		КонецЕсли;
		Если Не ПустаяСтрока(Разбор.ОшибкаЗаписиСостояния) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.ЭтоПодпись Тогда
			ОбработатьФайлРазбора(Разбор, Элемент, Сверка);
		КонецЕсли;
		Если Не ПустаяСтрока(Разбор.ОшибкаЗаписиСостояния) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	СпорныеДляМодели = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		ЭлементФайла = Разбор.ИндексФайлов.Получить(Элемент.КлючФайла);
		СпорныйФайл = Не Элемент.ЭтоПодпись И ПолеОбъекта(ЭлементФайла, "category") = КатегорияСпорно();
		Если СпорныйФайл И СпорныеДляМодели.Количество() < МаксимумСпорныхДляМодели() Тогда
			СпорныеДляМодели.Добавить(Элемент.КлючФайла);
		КонецЕсли;
	КонецЦикла;
	Разбор.Состояние.Вставить("disputed_for_model", СпорныеДляМодели);

	Счетчики = СчетчикиРазбора(Разбор.Состояние);
	ШаблонИтога = НСтр("ru = 'Обход завершен: относится %1, не относится %2, не распознано %3, спорно %4,
		|ошибок копирования %5'");
	ТекстИтога = СтрШаблон(СтрЗаменить(ШаблонИтога, Символы.ПС, " "), Счетчики.related, Счетчики.unrelated,
		Счетчики.unrecognized, Счетчики.disputed, Счетчики.copy_errors);
	ЗаписатьСтрокуЖурналаРазбора(Разбор, "", "", "", ТекстИтога);
	ЗаписатьСостояниеРазбора(Разбор);

КонецПроцедуры

// Пройден ли обход файлов: в состоянии зафиксирован список disputed_for_model (спека Г.1).
//
// Параметры:
//  Состояние - Соответствие, Неопределено - состояние разбора.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОбходРазбораПройден(Знач Состояние)

	Возврат ТипЗнч(Состояние) = Тип("Соответствие")
		И ТипЗнч(Состояние.Получить("disputed_for_model")) = Тип("Массив");

КонецФункции

// Обрабатывает один файл выгрузки: решение (у подписи - категория основного файла), копирование в папку
// категории, запись в состояние и журнал. Уже скопированный - пропускается.
//
// Параметры:
//  Разбор  - Структура - контекст разбора.
//  Элемент - Структура - элемент выгрузки (см. НовыйЭлементВыгрузки).
//  Сверка  - Структура - данные сверки договора (см. ДанныеСверкиДоговора).
//
Процедура ОбработатьФайлРазбора(Знач Разбор, Знач Элемент, Знач Сверка)

	ЭлементФайла = Разбор.ИндексФайлов.Получить(Элемент.КлючФайла);
	Если ЭлементФайла <> Неопределено И ПолеОбъекта(ЭлементФайла, "copied", Ложь) Тогда
		Возврат;
	КонецЕсли;

	Если Элемент.ЭтоПодпись Тогда
		Решение = РешениеПоПодписи(Разбор, Элемент);
	Иначе
		Решение = РешениеПоФайлу(Элемент, Сверка);
	КонецЕсли;

	ПутьКопии = ПутьКопииФайла(Разбор.КаталогРазбора, Решение.Категория, Элемент.Путь, Элемент.КлючФайла,
		Элемент.Имя);
	ОшибкаКопирования = "";
	Если Элемент.ФайлЕсть Тогда
		ОшибкаКопирования = ОшибкаКопированияФайла(Элемент.Источник, ПутьКопии);
		Скопирован = ПустаяСтрока(ОшибкаКопирования);
	Иначе
		// Файла нет на диске - копировать нечего, повторно не разбирается.
		Скопирован = Истина;
	КонецЕсли;

	Если ЭлементФайла = Неопределено Тогда
		ЭлементФайла = Новый Соответствие;
		ПолеОбъекта(Разбор.Состояние, "files", Новый Массив).Добавить(ЭлементФайла);
		Разбор.ИндексФайлов.Вставить(Элемент.КлючФайла, ЭлементФайла);
	КонецЕсли;
	ЭлементФайла.Вставить("ref", Элемент.КлючФайла);
	ЭлементФайла.Вставить("source", Элемент.Источник);
	ЭлементФайла.Вставить("path", Элемент.Путь);
	ЭлементФайла.Вставить("name", Элемент.Имя);
	ЭлементФайла.Вставить("main", Элемент.КлючОсновного);
	ЭлементФайла.Вставить("note", Элемент.Пометка);
	ЭлементФайла.Вставить("category", Решение.Категория);
	ЭлементФайла.Вставить("reason", Решение.Причина);
	ЭлементФайла.Вставить("fragment", Решение.Фрагмент);
	ЭлементФайла.Вставить("target", ПутьКопии);
	ЭлементФайла.Вставить("copied", Скопирован);
	ЭлементФайла.Вставить("copy_error", ОшибкаКопирования);
	ЭлементФайла.Вставить("decision", "");

	ПричинаЖурнала = Решение.Причина;
	Если Не ПустаяСтрока(Элемент.Пометка) Тогда
		ПричинаЖурнала = СокрЛП(Элемент.Пометка + "; " + ПричинаЖурнала);
	КонецЕсли;
	Если Не ПустаяСтрока(ОшибкаКопирования) Тогда
		ПричинаЖурнала = ПричинаЖурнала + "; " + НСтр("ru = 'ошибка копирования'") + ": " + ОшибкаКопирования;
	КонецЕсли;
	ЗаписатьСтрокуЖурналаРазбора(Разбор, Элемент.КлючФайла, Элемент.Путь, Решение.Категория, ПричинаЖурнала);
	ЗаписатьСостояниеПоХоду(Разбор);

КонецПроцедуры

// Решение по подписи: категория основного файла; основного файла нет - «Не распознано», «подпись без
// документа».
//
// Параметры:
//  Разбор  - Структура - контекст разбора.
//  Элемент - Структура - элемент выгрузки (подпись).
//
// Возвращаемое значение:
//  Структура - {Категория, Причина, Фрагмент}.
//
Функция РешениеПоПодписи(Знач Разбор, Знач Элемент)

	ОсновнойФайл = Разбор.ИндексФайлов.Получить(Элемент.КлючОсновного);
	Если ПустаяСтрока(Элемент.КлючОсновного) Или ОсновнойФайл = Неопределено Тогда
		Возврат НовоеРешениеРазбора(КатегорияНеРаспознано(), НСтр("ru = 'подпись без документа'"));
	КонецЕсли;
	Возврат НовоеРешениеРазбора(ПолеОбъекта(ОсновнойФайл, "category"),
		СтрШаблон(НСтр("ru = 'подпись к %1'"), Элемент.КлючОсновного));

КонецФункции

// Решение по файлу (спека Г.1, детерминированно): нет текста - «Не распознано»; номера нет - «Не относится»;
// номер и (дата или ИНН) без номера другого договора контрагента - «Относится»; иначе - «Спорно» с фрагментом
// ±200 символов вокруг номера.
//
// Параметры:
//  Элемент - Структура - элемент выгрузки.
//  Сверка  - Структура - данные сверки договора.
//
// Возвращаемое значение:
//  Структура - {Категория, Причина, Фрагмент}.
//
Функция РешениеПоФайлу(Знач Элемент, Знач Сверка)

	Если Не Элемент.ФайлЕсть Тогда
		Возврат НовоеРешениеРазбора(КатегорияНеРаспознано(), НСтр("ru = 'файл не найден на диске'"));
	КонецЕсли;

	Извлечение = ТекстФайлаРазбора(Элемент.Источник);
	Если Не ПустаяСтрока(Извлечение.Причина) Тогда
		Возврат НовоеРешениеРазбора(КатегорияНеРаспознано(), Извлечение.Причина);
	КонецЕсли;

	ИсходныйТекст = Извлечение.Текст;
	НормализованныйТекст = НормализованныйТекстРазбора(ИсходныйТекст);
	Если ЧислоБуквИЦифрНеБольше(НормализованныйТекст, МинимумЗнаковТекста()) < МинимумЗнаковТекста() Тогда
		Возврат НовоеРешениеРазбора(КатегорияНеРаспознано(), НСтр("ru = 'мало текста'"));
	КонецЕсли;

	ПозицияНомера = 0;
	ДлинаНомера = 0;
	Для Каждого Вариант Из Сверка.ВариантыНомера Цикл
		ПозицияНомера = ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, Вариант.Токены, Ложь,
			Вариант.Короткий);
		Если ПозицияНомера > 0 Тогда
			ДлинаНомера = СтрДлина(СтрСоединить(Вариант.Токены, "-"));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияНомера = 0 Тогда
		Возврат НовоеРешениеРазбора(КатегорияНеОтносится(), НСтр("ru = 'номера договора нет'"));
	КонецЕсли;

	ЕстьДатаИлиИНН = ЕстьСовпадениеВТексте(НормализованныйТекст, ИсходныйТекст, Сверка.ТокеныДат, Истина)
		Или ЕстьСовпадениеВТексте(НормализованныйТекст, ИсходныйТекст, Сверка.ТокеныИНН, Истина);
	// Номер другого договора внутри своего номера («15» в «15/2024») не засчитывается.
	УчасткиНомера = УчасткиСвоегоНомера(НормализованныйТекст, ИсходныйТекст, Сверка.ВариантыНомера);
	НомерДругого = "";
	Для Каждого ДругойНомер Из Сверка.ДругиеНомера Цикл
		Если ЕстьНомерВнеУчастков(НормализованныйТекст, ИсходныйТекст, ДругойНомер, УчасткиНомера) Тогда
			НомерДругого = ДругойНомер.Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьДатаИлиИНН И ПустаяСтрока(НомерДругого) Тогда
		Возврат НовоеРешениеРазбора(КатегорияОтносится(), НСтр("ru = 'номер и дата или ИНН'"));
	КонецЕсли;

	Причина = ?(ПустаяСтрока(НомерДругого), НСтр("ru = 'номер есть, даты договора и ИНН нет'"),
		СтрШаблон(НСтр("ru = 'есть номер другого договора контрагента: %1'"), НомерДругого));
	ДлинаОкна = 200;
	Начало = Макс(1, ПозицияНомера - ДлинаОкна);
	Фрагмент = Сред(ИсходныйТекст, Начало, ПозицияНомера - Начало + ДлинаНомера + ДлинаОкна);
	Возврат НовоеРешениеРазбора(КатегорияСпорно(), Причина, Фрагмент);

КонецФункции

// Решение по файлу.
//
// Параметры:
//  Категория - Строка - код категории.
//  Причина   - Строка - причина решения.
//  Фрагмент  - Строка - фрагмент текста (для спорных).
//
// Возвращаемое значение:
//  Структура - {Категория, Причина, Фрагмент}.
//
Функция НовоеРешениеРазбора(Знач Категория, Знач Причина, Знач Фрагмент = "")

	Возврат Новый Структура("Категория, Причина, Фрагмент", Категория, Причина, Фрагмент);

КонецФункции

// Текст файла с диска (спека Г.1): расширение - из настройки, размер - не больше лимита, извлечение -
// РаботаСФайламиСлужебный.ИзвлечьТекстИзФайлаНаДиске прямо с диска, без временных файлов.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Структура - {Текст: Строка; Причина: Строка - причина «Не распознано», пусто - текст извлечен}.
//
Функция ТекстФайлаРазбора(Знач ПолноеИмя)

	Результат = Новый Структура("Текст, Причина", "", "");
	ФайлВыгрузки = Новый Файл(ПолноеИмя);
	Расширение = НРег(СтрЗаменить(ФайлВыгрузки.Расширение, ".", ""));
	Если РасширенияРазбора().Найти(Расширение) = Неопределено Тогда
		Результат.Причина = НСтр("ru = 'расширение'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		РазмерФайла = ФайлВыгрузки.Размер();
	Исключение
		Результат.Причина = НСтр("ru = 'ошибка'") + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	БайтВМегабайте = 1048576;
	Если РазмерФайла > МаксРазмерФайлаРазбораМБ() * БайтВМегабайте Тогда
		Результат.Причина = НСтр("ru = 'размер'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Извлечение = РаботаСФайламиСлужебный.ИзвлечьТекстИзФайлаНаДиске(ПолноеИмя);
	Исключение
		Результат.Причина = НСтр("ru = 'ошибка'") + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если Извлечение = Неопределено
		Или Извлечение.СтатусИзвлеченияТекста <> Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		Результат.Причина = НСтр("ru = 'нет текста'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Извлечение.ТекстХранилище) = Тип("ХранилищеЗначения") Тогда
		Текст = Извлечение.ТекстХранилище.Получить();
		Результат.Текст = ?(ТипЗнч(Текст) = Тип("Строка"), Текст, "");
	КонецЕсли;
	Если ПустаяСтрока(Результат.Текст) Тогда
		Результат.Причина = НСтр("ru = 'нет текста'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Минимум букв и цифр в тексте, чтобы считать его текстом документа, а не сканом с колонтитулом (спека Г.1).
//
// Возвращаемое значение:
//  Число.
//
Функция МинимумЗнаковТекста()

	Возврат 100;

КонецФункции

// Не больше стольких спорных отдается модели (спека Г.1), остальные - человеку.
//
// Возвращаемое значение:
//  Число.
//
Функция МаксимумСпорныхДляМодели()

	Возврат 20;

КонецФункции

// Копирует файл в папку категории (с перезаписью - продолжение после сбоя перезаписывает недокопированный).
//
// Параметры:
//  Источник - Строка - полное имя исходного файла.
//  Приемник - Строка - полное имя копии.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - скопирован.
//
Функция ОшибкаКопированияФайла(Знач Источник, Знач Приемник)

	Попытка
		ФайлПриемника = Новый Файл(Приемник);
		СоздатьКаталог(ФайлПриемника.Путь);
		КопироватьФайл(Источник, Приемник);
	Исключение
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

// Путь копии файла: «<Разбор>\<папка категории>\<путь относительно ДО>». Длиннее 250 знаков - «<ref> <имя
// файла>» в папке категории, имя обрезается с сохранением расширения (спека Г.1).
//
// Параметры:
//  КаталогРазбора - Строка - папка «Разбор».
//  Категория      - Строка - код категории.
//  Путь           - Строка - путь файла относительно папки «ДО».
//  РефФайла       - Строка - ref файла.
//  ИмяФайла       - Строка - имя файла.
//
// Возвращаемое значение:
//  Строка - полное имя копии.
//
Функция ПутьКопииФайла(Знач КаталогРазбора, Знач Категория, Знач Путь, Знач РефФайла, Знач ИмяФайла)

	КаталогКатегории = КаталогРазбора + "\" + ИмяПапкиКатегории(Категория);
	ПолныйПуть = КаталогКатегории + "\" + Путь;
	Если СтрДлина(ПолныйПуть) <= МаксимальнаяДлинаПути() Тогда
		Возврат ПолныйПуть;
	КонецЕсли;

	КороткоеИмя = ОчиститьИмяФайла(РефФайла + " " + ИмяФайла);
	Доступно = МаксимальнаяДлинаПути() - СтрДлина(КаталогКатегории) - 1;
	Если СтрДлина(КороткоеИмя) > Доступно Тогда
		ФайлИмени = Новый Файл(КороткоеИмя);
		Расширение = ФайлИмени.Расширение;
		ДоступноИмени = Доступно - СтрДлина(Расширение);
		КороткоеИмя = ?(ДоступноИмени > 0, Лев(ФайлИмени.ИмяБезРасширения, ДоступноИмени), РефФайла) + Расширение;
	КонецЕсли;
	Возврат КаталогКатегории + "\" + КороткоеИмя;

КонецФункции

// Коды категорий разбора (ключи контракта состояния и ответа, спека Г.1).
//
// Возвращаемое значение:
//  Строка - код категории.
//
Функция КатегорияОтносится()

	Возврат "related";

КонецФункции

