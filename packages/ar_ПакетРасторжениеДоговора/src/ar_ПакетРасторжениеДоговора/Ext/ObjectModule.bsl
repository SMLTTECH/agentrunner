#Область ЗаявкиНаРасходованиеДС

// Заявки на расходование ДС по списаниям с расчетного счета из документов акта (спека Ж): один запрос на шаг -
// реквизит sd_Заявка ОБЪЕДИНИТЬ ВСЕ ДокументОснование платежной позиции из табличной части
// бит_РаспределениеБюджета. Привилегированно с парным сбросом (как выборка файлов шага): RLS БИТ по ЦФО
// и статьям не должна скрыть вложения договора у агента. Списаний нет - запроса нет.
//
// Параметры:
//  СтрокиДокументов - Массив из Структура - документы акта {Ссылка, ...}.
//
// Возвращаемое значение:
//  Структура:
//   * ПоСписанию     - Соответствие - списание -> Массив из Структура {Ссылка, Номер, Дата} без повторов.
//   * Заявки         - Массив - заявки без повторов (в порядке появления).
//   * ДокументыАкта  - Соответствие - документ акта -> Истина.
//   * СохраненоФайлов - Число - сохранено файлов заявок (считает ЗаписатьФайлыЗаданий).
//   * Ошибка         - Строка - текст сбоя запроса; пусто - запрос выполнен или не нужен.
//
Функция ЗаявкиСписанийАкта(Знач СтрокиДокументов)

	Результат = Новый Структура("ПоСписанию, Заявки, ДокументыАкта, СохраненоФайлов, Ошибка",
		Новый Соответствие, Новый Массив, Новый Соответствие, 0, "");

	Списания = Новый Массив;
	ТипСписания = Тип("ДокументСсылка.СписаниеСРасчетногоСчета");
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл
		Результат.ДокументыАкта.Вставить(СтрокаДокумента.Ссылка, Истина);
		Если ТипЗнч(СтрокаДокумента.Ссылка) = ТипСписания Тогда
			Списания.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Списания.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Списания.Ссылка КАК Списание,
		|	Списания.sd_Заявка КАК Заявка,
		|	Списания.sd_Заявка.Номер КАК НомерЗаявки,
		|	Списания.sd_Заявка.Дата КАК ДатаЗаявки
		|ИЗ
		|	Документ.СписаниеСРасчетногоСчета КАК Списания
		|ГДЕ
		|	Списания.Ссылка В (&Списания)
		|	И Списания.sd_Заявка <> ЗНАЧЕНИЕ(Документ.бит_ЗаявкаНаРасходованиеСредств.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Распределение.Ссылка,
		|	Распределение.ДокументПланирования.ДокументОснование,
		|	Распределение.ДокументПланирования.ДокументОснование.Номер,
		|	Распределение.ДокументПланирования.ДокументОснование.Дата
		|ИЗ
		|	Документ.СписаниеСРасчетногоСчета.бит_РаспределениеБюджета КАК Распределение
		|ГДЕ
		|	Распределение.Ссылка В (&Списания)
		|	И Распределение.ДокументПланирования.ДокументОснование ССЫЛКА Документ.бит_ЗаявкаНаРасходованиеСредств
		|	И Распределение.ДокументПланирования.ДокументОснование
		|		<> ЗНАЧЕНИЕ(Документ.бит_ЗаявкаНаРасходованиеСредств.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Списания", Списания);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_docs_ds_requests_failed",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	УчтенныеЗаявки = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ДобавитьЗаявкуСписания(Результат, УчтенныеЗаявки, Выборка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавляет пару «списание - заявка» из выборки без повторов: у списания заявка один раз (два пути связи
// могут дать одну заявку), в общем списке заявок - один раз на все списания.
//
// Параметры:
//  Результат      - Структура - результат ЗаявкиСписанийАкта (изменяются ПоСписанию, Заявки).
//  УчтенныеЗаявки - Соответствие - заявка -> Истина (дополняется).
//  Выборка        - ВыборкаИзРезультатаЗапроса - строка: Списание, Заявка, НомерЗаявки, ДатаЗаявки.
//
Процедура ДобавитьЗаявкуСписания(Знач Результат, Знач УчтенныеЗаявки, Знач Выборка)

	ЗаявкиСписания = Результат.ПоСписанию.Получить(Выборка.Списание);
	Если ЗаявкиСписания = Неопределено Тогда
		ЗаявкиСписания = Новый Массив;
		Результат.ПоСписанию.Вставить(Выборка.Списание, ЗаявкиСписания);
	КонецЕсли;
	Для Каждого ЗаявкаСписания Из ЗаявкиСписания Цикл
		Если ЗаявкаСписания.Ссылка = Выборка.Заявка Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	НомерЗаявки = ?(ПустаяСтрока(Выборка.НомерЗаявки), НСтр("ru = 'б/н'"), Выборка.НомерЗаявки);
	ДанныеЗаявки = Новый Структура("Ссылка, Номер, Дата", Выборка.Заявка, НомерЗаявки, Выборка.ДатаЗаявки);
	ЗаявкиСписания.Добавить(ДанныеЗаявки);
	Если УчтенныеЗаявки.Получить(Выборка.Заявка) = Неопределено Тогда
		УчтенныеЗаявки.Вставить(Выборка.Заявка, Истина);
		Результат.Заявки.Добавить(Выборка.Заявка);
	КонецЕсли;

КонецПроцедуры

// Задания на сохранение файлов заявок списания (спека Ж.3): имя «<№ списания> от <дата> - заявка <№> от <дата>
// - <имя>», папка шага act_documents. Заявка уже сохранена при другом списании - метка «файлы заявки уже
// сохранены: <имя>»; заявка - сама строка акта - строка журнала; списание без заявки - «заявка на
// расходование ДС не найдена»; заявка без файлов - «файлов заявки нет».
//
// Параметры:
//  Сбор               - Структура - контекст сбора (ЗаявкиАкта).
//  СтрокаДокумента    - Структура - документ акта {Ссылка, Номер, Дата, Вид}.
//  Задания            - Массив - пополняемые задания на сохранение.
//  СохраненныеЗаявки  - Соответствие - заявка -> первое задание ее файлов.
//  ФайлыВладельцев    - Соответствие - владелец -> Массив ссылок файлов.
//
Процедура ЗаполнитьЗаданияЗаявокСписания(Знач Сбор, Знач СтрокаДокумента, Задания, Знач СохраненныеЗаявки,
	Знач ФайлыВладельцев)

	ЗаявкиАкта = Сбор.ЗаявкиАкта;
	Если ЗаявкиАкта = Неопределено Или Не ПустаяСтрока(ЗаявкиАкта.Ошибка)
		Или ТипЗнч(СтрокаДокумента.Ссылка) <> Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		Возврат;
	КонецЕсли;

	ИмяШага = ИмяШагаЖурнала(КодШагаДокументовАкта());
	ВидСписания = СтрокаДокумента.Вид;
	Если ПустаяСтрока(ВидСписания) Тогда
		ВидСписания = ВидДокументаШага(КодШагаДокументовАкта());
	КонецЕсли;
	ИсточникСписания = ПредставлениеДокументаЖурнала(ВидСписания, СтрокаДокумента.Номер, СтрокаДокумента.Дата);

	ЗаявкиСписания = ЗаявкиАкта.ПоСписанию.Получить(СтрокаДокумента.Ссылка);
	Если ЗаявкиСписания = Неопределено Тогда
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникСписания, "", "", 0,
			НСтр("ru = 'заявка на расходование ДС не найдена'"));
		Возврат;
	КонецЕсли;

	ПрефиксСписания = ПрефиксИмениФайлаДокумента(СтрокаДокумента.Номер, СтрокаДокумента.Дата);
	Для Каждого Заявка Из ЗаявкиСписания Цикл
		ИсточникЗаявки = ИсточникЗаявкиЖурнала(Заявка, СтрокаДокумента);
		Если ЗаявкиАкта.ДокументыАкта.Получить(Заявка.Ссылка) <> Неопределено Тогда
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникЗаявки, "", "", 0,
				НСтр("ru = 'файлы заявки уже сохранены: заявка - документ акта сверки'"));
		Иначе
			ДобавитьЗаданияФайловЗаявки(Сбор, Заявка, ИсточникЗаявки, ПрефиксСписания, Задания, СохраненныеЗаявки,
				ФайлыВладельцев);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Представление заявки для журнала сбора: «Заявка на расходование ДС № <№> от <дата> (заявка списания № <№>
// от <дата>)».
//
// Параметры:
//  Заявка          - Структура - {Ссылка, Номер, Дата}.
//  СтрокаДокумента - Структура - списание {Номер, Дата}.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЗаявкиЖурнала(Знач Заявка, Знач СтрокаДокумента)

	ПредставлениеЗаявки = ПредставлениеДокументаЖурнала(НСтр("ru = 'Заявка на расходование ДС'"), Заявка.Номер,
		Заявка.Дата);
	ДатаСписания = Формат(СтрокаДокумента.Дата, "ДФ=dd.MM.yyyy");
	ПрипискаСписания = СтрШаблон(НСтр("ru = 'заявка списания № %1 от %2'"), СокрЛП(СтрокаДокумента.Номер),
		ДатаСписания);
	Возврат СтрШаблон("%1 (%2)", ПредставлениеЗаявки, ПрипискаСписания);

КонецФункции

// Задания на сохранение файлов одной заявки списания (спека Ж.3): заявка уже сохранена при другом списании -
// метка повтора «файлы заявки уже сохранены: <имя>»; файлов нет - строка журнала «файлов заявки нет».
//
// Параметры:
//  Сбор              - Структура - контекст сбора.
//  Заявка            - Структура - {Ссылка, Номер, Дата}.
//  ИсточникЗаявки    - Строка - представление заявки для журнала.
//  ПрефиксСписания   - Строка - префикс имени файла списания.
//  Задания           - Массив - пополняемые задания на сохранение.
//  СохраненныеЗаявки - Соответствие - заявка -> первое задание ее файлов (дополняется).
//  ФайлыВладельцев   - Соответствие - владелец -> Массив ссылок файлов.
//
Процедура ДобавитьЗаданияФайловЗаявки(Знач Сбор, Знач Заявка, Знач ИсточникЗаявки, Знач ПрефиксСписания, Задания,
	Знач СохраненныеЗаявки, Знач ФайлыВладельцев)

	ПервоеЗадание = СохраненныеЗаявки.Получить(Заявка.Ссылка);
	Если ПервоеЗадание <> Неопределено Тогда
		ЗаданиеПовтора = НовоеЗаданиеФайла(Неопределено, "", ИсточникЗаявки);
		ЗаданиеПовтора.УжеСохранено = Истина;
		ЗаданиеПовтора.ПервоеЗадание = ПервоеЗадание;
		ЗаданиеПовтора.Вставить("ШаблонПовтора", НСтр("ru = 'файлы заявки уже сохранены: %1'"));
		Задания.Добавить(ЗаданиеПовтора);
		Возврат;
	КонецЕсли;

	ФайлыЗаявки = ФайлыВладельца(ФайлыВладельцев, Заявка.Ссылка);
	Если ФайлыЗаявки.Количество() = 0 Тогда
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШагаЖурнала(КодШагаДокументовАкта()), ИсточникЗаявки, "", "", 0,
			НСтр("ru = 'файлов заявки нет'"));
		Возврат;
	КонецЕсли;

	ПрефиксЗаявки = ПрефиксСписания + НСтр("ru = 'заявка'") + " "
		+ СтрШаблон("%1 от %2 - ", СокрЛП(Заявка.Номер), Формат(Заявка.Дата, "ДФ=dd.MM.yyyy"));
	Для Каждого СсылкаФайла Из ФайлыЗаявки Цикл
		ЗаданиеЗаявки = НовоеЗаданиеФайла(СсылкаФайла, ПрефиксЗаявки, ИсточникЗаявки);
		ЗаданиеЗаявки.Вставить("ЭтоФайлЗаявки", Истина);
		Задания.Добавить(ЗаданиеЗаявки);
		Если СохраненныеЗаявки.Получить(Заявка.Ссылка) = Неопределено Тогда
			СохраненныеЗаявки.Вставить(Заявка.Ссылка, ЗаданиеЗаявки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ФайлыРазбораДО

// Файлы задачи agentrunner-480 лежат рядом с выгрузкой, блокировок нет (спека раздел Е): у каждого файла один
// писатель, JSON-файлы заменяются атомарно (временный файл с уникальным именем и переименование), читаются
// с повтором. Даты во всех файлах - местное время сервера ГГГГ-ММ-ДДTЧЧ:ММ:СС (XMLСтрока).

// Имя файла задания разбора в подкаталоге договора - контракт файла (спека А.2).
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайлаЗаданияРазбора()

	Возврат "Задание разбора ДО.json";

КонецФункции

