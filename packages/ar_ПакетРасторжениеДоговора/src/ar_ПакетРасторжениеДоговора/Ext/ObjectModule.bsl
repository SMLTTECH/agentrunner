// Заготовка шага ответа (ключи JSON-контракта - латиницей).
//
// Параметры:
//  КодШага - Строка - код шага.
//
// Возвращаемое значение:
//  Структура - {step, status, message, documents, skipped, files, files_total}.
//
Функция НовыйШагОтвета(Знач КодШага)

	Возврат Новый Структура("step, status, message, documents, skipped, files, files_total",
		КодШага, "", "", 0, 0, Новый Массив, 0);

КонецФункции

// Добавляет файл в список шага (не больше 50 строк на шаг - спека п.3);
// итоги (files_total, СохраненоФайлов) считает вызывающий код.
//
// Параметры:
//  Шаг      - Структура - шаг ответа.
//  ИмяФайла - Строка    - имя файла (без каталога).
//  Размер   - Число     - размер файла, байт.
//
Процедура ДобавитьФайлВШаг(Знач Шаг, Знач ИмяФайла, Знач Размер)

	Если Шаг.files.Количество() < МаксимальноФайловВОтветеШага() Тогда
		СтрокаФайла = Новый Структура;
		СтрокаФайла.Вставить("name", ИмяФайла);
		СтрокаФайла.Вставить("size", Размер);
		Шаг.files.Добавить(СтрокаФайла);
	КонецЕсли;

КонецПроцедуры

// Максимальное число файлов в списке files шага ответа (спека п.3: не больше
// 50 строк {name, size} на шаг) - константа модуля.
//
// Возвращаемое значение:
//  Число - максимальное число файлов в ответе шага.
//
Функция МаксимальноФайловВОтветеШага()

	Возврат 50;

КонецФункции

// Успешный ответ инструмента: {directory, log_file, saved_files, steps,
// [log_error]} (спека п.3). Шаги передаются как есть - ключи шага уже
// соответствуют контракту; служебное поле ОшибокЗаписи в ответ не входит.
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ОтветОбУспехе(Знач Сбор)

	ШагиОтвета = Новый Массив;
	Для Каждого Шаг Из Сбор.Шаги Цикл
		ШагОтвета = Новый Структура("step, status, message, documents, skipped, files, files_total",
			Шаг.step, Шаг.status, Шаг.message, Шаг.documents, Шаг.skipped, Шаг.files, Шаг.files_total);
		Если Шаг.Свойство("reused") Тогда
			ШагОтвета.Вставить("reused", Шаг.reused);
		КонецЕсли;
		ШагиОтвета.Добавить(ШагОтвета);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("directory", Сбор.КаталогПодкаталога);
	Ответ.Вставить("log_file", Сбор.Журнал.Путь);
	Ответ.Вставить("saved_files", Сбор.СохраненоФайлов);
	Если Не ПустаяСтрока(Сбор.Журнал.ОшибкаЗаписи) Тогда
		Ответ.Вставить("log_error", Сбор.Журнал.ОшибкаЗаписи);
	КонецЕсли;
	Ответ.Вставить("steps", ШагиОтвета);

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Ошибка-observation с завершением запуска: ошибки, которые аргументом не
// исправить (not_contract, no_directory, directory_unavailable).
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Сообщение - Строка - причина для модели.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>","message":...,"next":"finish"}.
//
Функция ОшибкаЗавершенияИнструмента(Знач КодОшибки, Знач Сообщение)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("message", Сообщение);
	Объект.Вставить("next", "finish");
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

// Формирует JSON-строку ошибки-observation.
