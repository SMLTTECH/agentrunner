// План сбора для режима без записи: путь подкаталога, найден ли доп. отчет,
// число документов каждого вида, будет ли акт сверки взят повторно (спека п.3).
//
// Параметры:
//  Предмет            - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  КаталогДокументов  - Строка    - каталог из настройки.
//  РеквизитыДоговора  - Структура - реквизиты договора.
//  ДатаНачала         - Дата      - дата начала периода.
//
// Возвращаемое значение:
//  Структура - {directory, report_found, documents: {ks2, commission_reports,
//  ks2_corrections, act_documents, ds_requests}, act_reused}; act_documents и ds_requests -
//  документов и заявок на расходование ДС в акте, взятом повторно; null - акт будет создан
//  при сборе.
//
Функция ПланСбораДляОтвета(Знач Предмет, Знач КаталогДокументов, Знач РеквизитыДоговора, Знач ДатаНачала)

	План = Новый Структура;
	План.Вставить("directory",
		КаталогДокументов + "\" + ИмяПодкаталогаСбора(КаталогДокументов, РеквизитыДоговора));

	СсылкиОтчета = СсылкиДопОтчетаПлатежных();
	План.Вставить("report_found", СсылкиОтчета.Количество() = 1);

	ДокументыПлана = Новый Структура;
	ДокументыПлана.Вставить(КодШагаКС2(), 0);
	ДокументыПлана.Вставить(КодШагаОтчетовКомитенту(), 0);
	ДокументыПлана.Вставить(КодШагаКорректировочныхКС2(), 0);
	Попытка
		СтрокиДокументов = ДокументыВложенийПоДоговору(Предмет);
		Для Каждого Пара Из СтрокиДокументов Цикл
			ДокументыПлана.Вставить(Пара.Ключ, Пара.Значение.Количество());
		КонецЦикла;
	Исключение
		// План без числа документов хуже плана с числом, но не причина отказывать
		// в ответе режима без записи.
		ТекстОшибки = СтрШаблон("Договор=%1; Шаг=dry_run_documents; %2", Строка(Предмет),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_docs_step_failed", ТекстОшибки,
			"Ошибка", , Предмет);
	КонецПопытки;
	СегодняшнийАкт = СегодняшнийАктСверки(Предмет, ДатаНачала);
	ДокументыПлана.Вставить(КодШагаДокументовАкта(), Неопределено);
	ДокументыПлана.Вставить("ds_requests", Неопределено);
	Если СегодняшнийАкт <> Неопределено Тогда
		ДокументыАкта = ДокументыАктаСверки(СегодняшнийАкт.Ссылка);
		ДокументыПлана.Вставить(КодШагаДокументовАкта(), ДокументыАкта.Количество());
		// Заявки на расходование ДС по списаниям акта (agentrunner-480, спека Ж.4).
		ЗаявкиАкта = ЗаявкиСписанийАкта(ДокументыАкта);
		ДокументыПлана.Вставить("ds_requests", ЗаявкиАкта.Заявки.Количество());
	КонецЕсли;
	План.Вставить("documents", ДокументыПлана);

	План.Вставить("act_reused", СегодняшнийАкт <> Неопределено);

	Возврат План;

КонецФункции

#КонецОбласти

#Область ЖурналСбора

// Открывает журнал сбора «Журнал сбора документов.txt» для дописывания:
// UTF-8 с BOM (открывается в Блокноте и Excel), строки дописываются по ходу
// работы, файл закрывается в любом исходе (спека п.3 «журнал работы»).
//
// Параметры:
//  ПутьЖурнала - Строка - полный путь файла журнала.
//
// Возвращаемое значение:
//  Структура:
//   * Запись       - ЗаписьТекста, Неопределено - открытая запись (Неопределено -
//                    не удалось создать файл, причина в ОшибкаЗаписи).
//   * Путь         - Строка - путь файла журнала.
//   * ОшибкаЗаписи - Строка - первая ошибка записи (создание - в вызывающий код).
//
Функция ОткрытьЖурналСбора(Знач ПутьЖурнала)

	Журнал = Новый Структура("Запись, Путь, ОшибкаЗаписи", Неопределено, ПутьЖурнала, "");

	Попытка
		// Файл новый (новый подкаталог): без дописывания - платформа пишет BOM.
		Журнал.Запись = Новый ЗаписьТекста(ПутьЖурнала, КодировкаТекста.UTF8, Символы.ПС, Ложь);
	Исключение
		Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Журнал;

КонецФункции

// Шапка журнала: договор, контрагент, организация, инициатор, запуск, агент,
// период и время начала (спека п.3 «журнал работы»).
//
// Параметры:
//  Сбор     - Структура - контекст сбора.
//  Контекст - Структура - контекст вызова инструмента (Агент - при наличии).
//
Процедура ЗаписатьШапкуЖурнала(Знач Сбор, Знач Контекст)

	РеквизитыДоговора = Сбор.РеквизитыДоговора;
	ФорматДаты = "ДФ=dd.MM.yyyy";

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Договор: № %1 от %2'"),
		СокрЛП(РеквизитыДоговора.Номер), Формат(РеквизитыДоговора.Дата, ФорматДаты));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Контрагент: %1'"), Строка(РеквизитыДоговора.Владелец));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Организация: %1'"), Строка(РеквизитыДоговора.Организация));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Инициатор: %1'"), Строка(Сбор.Инициатор));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Запуск AgentRunner: %1'"), Сбор.RunId);
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	ИмяАгента = "";
	Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("Агент") Тогда
		ИмяАгента = Строка(Контекст.Агент);
	КонецЕсли;
	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Агент: %1'"), ?(ПустаяСтрока(ИмяАгента), "-", ИмяАгента));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Период: %1 - %2'"), Формат(Сбор.ДатаНачала, ФорматДаты),
		Формат(Сбор.ДатаОкончания, ФорматДаты));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Начало: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	ДописатьСтрокуВЖурнал(Сбор.Журнал, "");

КонецПроцедуры

// Дописывает строку события в журнал; поля - через табуляцию (столбцы в Excel):
// время ЧЧ:ММ:СС, шаг, документ-источник, исходный файл, сохранен как,
// размер (байт), результат (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал           - Структура - журнал сбора.
//  Шаг              - Строка - имя шага журнала («Акт сверки», «КС-2», ...).
//  ДокументИсточник - Строка - представление документа-источника.
//  ИсходныйФайл     - Строка - имя исходного присоединенного файла.
//  СохраненКак      - Строка - путь относительно подкаталога.
//  Размер           - Число - размер сохраненного файла, байт.
//  Результат        - Строка - результат события.
//
Процедура ЗаписатьСтрокуЖурнала(Знач Журнал, Знач Шаг, Знач ДокументИсточник = "", Знач ИсходныйФайл = "",
	Знач СохраненКак = "", Знач Размер = 0, Знач Результат = "")

	Поля = Новый Массив;
	Поля.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss"));
	Поля.Добавить(Шаг);
	Поля.Добавить(ДокументИсточник);
	Поля.Добавить(ИсходныйФайл);
	Поля.Добавить(СохраненКак);
	Поля.Добавить(Формат(Размер, "ЧГ=0"));
	Поля.Добавить(Результат);

	ДописатьСтрокуВЖурнал(Журнал, СтрСоединить(Поля, Символы.Таб));

КонецПроцедуры

// Дописывает готовую строку в журнал. Ошибка записи (кроме создания) не прерывает
// работу: причина запоминается в журнале (в ответ попадает log_error) и пишется
// в служебный лог - один раз (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал - Структура - журнал сбора.
//  Текст  - Строка    - строка журнала.
//
Процедура ДописатьСтрокуВЖурнал(Знач Журнал, Знач Текст)

	Если Журнал.Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Журнал.Запись.ЗаписатьСтроку(Текст);
	Исключение
		Если ПустаяСтрока(Журнал.ОшибкаЗаписи) Тогда
			Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_log_write_failed",
				Журнал.ОшибкаЗаписи, "Ошибка");
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Итог журнала: время окончания, сохранено, пропущено, ошибок и статус по шагам
// (спека п.3 «журнал работы»).
//
// Параметры:
//  Сбор - Структура - контекст сбора.
//
Процедура ЗаписатьИтогЖурнала(Знач Сбор)

	ФорматЧисла = "ЧГ=0";

	ДописатьСтрокуВЖурнал(Сбор.Журнал, "");

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Окончание: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Сохранено файлов: %1'"),
		Формат(Сбор.СохраненоФайлов, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Пропущено: %1'"),
		Формат(Сбор.ПропущеноФайлов, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Ошибок: %1'"), Формат(Сбор.Ошибок, ФорматЧисла));
	ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);

	Для Каждого Шаг Из Сбор.Шаги Цикл
		СтрокаЖурнала = СтрШаблон(НСтр("ru = 'Шаг %1: %2'"), ИмяШагаЖурнала(Шаг.step), Шаг.status);
		ДлительностьМс = Сбор.ДлительностиШагов.Получить(Шаг.step);
		Если ДлительностьМс <> Неопределено Тогда
			СтрокаЖурнала = СтрокаЖурнала + СтрШаблон(НСтр("ru = ', %1 с'"),
				Формат(ДлительностьМс / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0"));
		КонецЕсли;
		ДописатьСтрокуВЖурнал(Сбор.Журнал, СтрокаЖурнала);
	КонецЦикла;

КонецПроцедуры

// Закрывает журнал; при сбое закрытия повторная попытка не выполняется - файл
// остается с тем, что успели (спека п.3 «журнал работы»).
//
// Параметры:
//  Журнал - Структура - журнал сбора.
//
Процедура ЗакрытьЖурнал(Знач Журнал)

	Если Журнал.Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Журнал.Запись.Закрыть();
	Исключение
		Если ПустаяСтрока(Журнал.ОшибкаЗаписи) Тогда
			Журнал.ОшибкаЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "contract_log_close_failed",
				Журнал.ОшибкаЗаписи, "Ошибка");
		КонецЕсли;
	КонецПопытки;
	Журнал.Запись = Неопределено;

КонецПроцедуры

