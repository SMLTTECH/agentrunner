//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция РасширенияРазбора()

	Значение = ar_Настройки.ЗначениеНастройки(КлючНастройкиРасширений(), РасширенияРазбораПоУмолчанию());
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Значение = РасширенияРазбораПоУмолчанию();
	КонецЕсли;

	Расширения = Новый Массив;
	Для Каждого Расширение Из СтрРазделить(НРег(Значение), ",;", Ложь) Цикл
		ЧистоеРасширение = СтрЗаменить(СокрЛП(Расширение), ".", "");
		Если Не ПустаяСтрока(ЧистоеРасширение) Тогда
			Расширения.Добавить(ЧистоеРасширение);
		КонецЕсли;
	КонецЦикла;
	Возврат Расширения;

