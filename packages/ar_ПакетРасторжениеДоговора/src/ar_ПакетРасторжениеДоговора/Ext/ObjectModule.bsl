	Возврат "unrecognized";

КонецФункции

// См. КатегорияОтносится.
//
Функция КатегорияСпорно()

	Возврат "disputed";

КонецФункции

// Короткое имя папки категории в «Разборе» (спека Г.1: короткие имена - запас длины пути).
//
// Параметры:
//  Категория - Строка - код категории.
//
// Возвращаемое значение:
//  Строка - имя папки.
//
Функция ИмяПапкиКатегории(Знач Категория)

	Если Категория = КатегорияОтносится() Тогда
		Возврат НСтр("ru = 'Относится'");
	ИначеЕсли Категория = КатегорияНеОтносится() Тогда
		Возврат НСтр("ru = 'Не относится'");
	ИначеЕсли Категория = КатегорияСпорно() Тогда
		Возврат НСтр("ru = 'Спорно'");
	Иначе
		Возврат НСтр("ru = 'Не распознано'");
	КонецЕсли;

КонецФункции

// Счетчики разбора по основным файлам (без подписей) и ошибки копирования по всем файлам.
//
// Параметры:
//  Состояние - Соответствие - состояние разбора.
//
// Возвращаемое значение:
//  Структура - {related, unrelated, unrecognized, disputed, copy_errors}.
//
Функция СчетчикиРазбора(Знач Состояние)

	Счетчики = Новый Структура("related, unrelated, unrecognized, disputed, copy_errors", 0, 0, 0, 0, 0);
	Для Каждого ЭлементФайла Из ПолеОбъекта(Состояние, "files", Новый Массив) Цикл
		Если Не ПолеОбъекта(ЭлементФайла, "copied", Ложь)
			И Не ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "copy_error")) Тогда
			Счетчики.copy_errors = Счетчики.copy_errors + 1;
		КонецЕсли;
		Если Не ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "main")) Тогда
			Продолжить;
		КонецЕсли;
		Категория = ПолеОбъекта(ЭлементФайла, "category");
		Если Счетчики.Свойство(Категория) Тогда
			Счетчики[Категория] = Счетчики[Категория] + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счетчики;

КонецФункции

#КонецОбласти

#Область ЭлементыВыгрузкиИСверка

// Элементы выгрузки по всем спискам «ДО\<папка>\Выгрузка ДО.json» (спека Г.1): файлы списка (ref
// «<номер списка>.<ref>») и файлы на диске в тех же папках вне списка («<номер списка>.x0001», пометка «вне
// списка выгрузки»); подпись вне списка (.sig, .p7s) - за файлом с тем же именем без расширения подписи.
// Служебные файлы (список, *.tmp) в обход не входят. Попутно - сверка договора ДО каждого списка.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//  Сверка - Структура - данные сверки (изменяются ВариантыНомера, ПроверкиДО).
//
// Возвращаемое значение:
//  Массив из Структура - элементы выгрузки (см. НовыйЭлементВыгрузки).
//
Функция ЭлементыВыгрузки(Знач Разбор, Знач Сверка)

	Элементы = Новый Массив;
	НомерСписка = 0;
	Для Каждого ПапкаСписка Из ПапкиСписковВыгрузки(Разбор.Подкаталог) Цикл
		НомерСписка = НомерСписка + 1;
		КодСписка = Формат(НомерСписка, "ЧГ=0");
		ФайлПапки = Новый Файл(ПапкаСписка);
		ИмяПапки = ФайлПапки.Имя;
		Чтение = ПрочитатьФайлДанных(ПапкаСписка + "\" + ИмяФайлаСпискаВыгрузки());
		Если Чтение.Данные = Неопределено Тогда
			ЗаписатьСтрокуЖурналаРазбора(Разбор, "", ИмяПапки, "", НСтр("ru = 'список выгрузки не читается'"));
			Продолжить;
		КонецЕсли;
		ДобавитьПроверкуДоговораДО(Разбор, Сверка, КодСписка, Чтение.Данные);

		РефыПутей = Новый Соответствие;
		ДобавитьЭлементыСписка(Элементы, РефыПутей, Чтение.Данные, ПапкаСписка, ИмяПапки, КодСписка);
		ДобавитьЭлементыВнеСписка(Элементы, РефыПутей, ПапкаСписка, ИмяПапки, КодСписка);
	КонецЦикла;
	Возврат Элементы;

КонецФункции

// Добавляет элементы файлов списка выгрузки; у подписи КлючОсновного - ref файла по пути signature_of.
//
// Параметры:
//  Элементы    - Массив - элементы выгрузки (дополняется).
//  РефыПутей   - Соответствие - путь в нижнем регистре -> ref (дополняется).
//  Список      - Соответствие - разобранный «Выгрузка ДО.json».
//  ПапкаСписка - Строка - полный путь папки списка.
//  ИмяПапки    - Строка - имя папки списка.
//  КодСписка   - Строка - номер списка.
//
Процедура ДобавитьЭлементыСписка(Знач Элементы, Знач РефыПутей, Знач Список, Знач ПапкаСписка, Знач ИмяПапки,
	Знач КодСписка)

	Подписи = Новый Соответствие;
	Для Каждого ФайлСписка Из ПолеОбъекта(Список, "files", Новый Массив) Цикл
		ПутьФайла = СокрЛП(ПолеОбъекта(ФайлСписка, "path"));
		РефСписка = СокрЛП(ПолеОбъекта(ФайлСписка, "ref"));
		Если ПустаяСтрока(ПутьФайла) Или ПустаяСтрока(РефСписка) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = НовыйЭлементВыгрузки(КодСписка + "." + РефСписка, ПапкаСписка, ИмяПапки, ПутьФайла);
		ПутьОсновного = СокрЛП(ПолеОбъекта(ФайлСписка, "signature_of"));
		Если Не ПустаяСтрока(ПутьОсновного) Тогда
			Элемент.ЭтоПодпись = Истина;
			Подписи.Вставить(Элемент, ПутьОсновного);
		КонецЕсли;
		РефыПутей.Вставить(НРег(ПутьФайла), Элемент.КлючФайла);
		Элементы.Добавить(Элемент);
	КонецЦикла;

	СвязатьПодписиСОсновнымиФайлами(Подписи, РефыПутей);

КонецПроцедуры

// Добавляет элементы файлов папки списка, которых нет в списке выгрузки (по пути, по порядку пути -
// ref стабилен между вызовами).
//
// Параметры:
//  Элементы    - Массив - элементы выгрузки (дополняется).
//  РефыПутей   - Соответствие - путь в нижнем регистре -> ref (дополняется).
//  ПапкаСписка - Строка - полный путь папки списка.
//  ИмяПапки    - Строка - имя папки списка.
//  КодСписка   - Строка - номер списка.
//
Процедура ДобавитьЭлементыВнеСписка(Знач Элементы, Знач РефыПутей, Знач ПапкаСписка, Знач ИмяПапки,
	Знач КодСписка)

	ПутиНаДиске = Новый СписокЗначений;
	Для Каждого НайденныйФайл Из НайтиФайлы(ПапкаСписка, "*", Истина) Цикл
		Если Не НайденныйФайл.ЭтоФайл() Или СтрЗаканчиваетсяНа(НРег(НайденныйФайл.Имя), ".tmp") Тогда
			Продолжить;
		КонецЕсли;
		ПутьФайла = Сред(НайденныйФайл.ПолноеИмя, СтрДлина(ПапкаСписка + "\") + 1);
		Если НРег(ПутьФайла) = НРег(ИмяФайлаСпискаВыгрузки())
			Или РефыПутей.Получить(НРег(ПутьФайла)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПутиНаДиске.Добавить(ПутьФайла);
	КонецЦикла;
	ПутиНаДиске.СортироватьПоЗначению();

	Подписи = Новый Соответствие;
	НомерВне = 0;
	Для Каждого ЭлементСписка Из ПутиНаДиске Цикл
		ПутьФайла = ЭлементСписка.Значение;
		НомерВне = НомерВне + 1;
		РефФайла = КодСписка + ".x" + Формат(НомерВне, "ЧЦ=4; ЧВН=; ЧГ=0");
		Элемент = НовыйЭлементВыгрузки(РефФайла, ПапкаСписка, ИмяПапки, ПутьФайла);
		Элемент.Пометка = НСтр("ru = 'вне списка выгрузки'");
		ФайлПути = Новый Файл(ПутьФайла);
		Если РасширенияПодписи().Найти(НРег(ФайлПути.Расширение)) <> Неопределено Тогда
			Элемент.ЭтоПодпись = Истина;
			Подписи.Вставить(Элемент, Лев(ПутьФайла, СтрДлина(ПутьФайла) - СтрДлина(ФайлПути.Расширение)));
		КонецЕсли;
		РефыПутей.Вставить(НРег(ПутьФайла), РефФайла);
		Элементы.Добавить(Элемент);
	КонецЦикла;

	СвязатьПодписиСОсновнымиФайлами(Подписи, РефыПутей);

КонецПроцедуры

// Связывает подписи с основными файлами по пути: у подписи КлючОсновного - ключ файла, путь которого указан
// у подписи; файла нет - пусто (подпись уйдет в «Не распознано», «подпись без документа»).
//
// Параметры:
//  Подписи   - Соответствие - элемент выгрузки подписи -> путь основного файла.
//  РефыПутей - Соответствие - путь в нижнем регистре -> ключ файла.
//
Процедура СвязатьПодписиСОсновнымиФайлами(Знач Подписи, Знач РефыПутей)

	Для Каждого Подпись Из Подписи Цикл
		КлючОсновного = РефыПутей.Получить(НРег(Подпись.Значение));
		Подпись.Ключ.КлючОсновного = ?(КлючОсновного = Неопределено, "", КлючОсновного);
	КонецЦикла;

КонецПроцедуры

// Элемент выгрузки.
//
// Параметры:
//  РефФайла    - Строка - составной ref файла.
//  ПапкаСписка - Строка - полный путь папки списка.
//  ИмяПапки    - Строка - имя папки списка.
//  ПутьФайла   - Строка - путь файла относительно папки списка.
//
// Возвращаемое значение:
//  Структура - {КлючФайла (ref), Источник, Путь (относительно «ДО»), Имя, ЭтоПодпись, КлючОсновного, Пометка,
//  ФайлЕсть}.
//
Функция НовыйЭлементВыгрузки(Знач РефФайла, Знач ПапкаСписка, Знач ИмяПапки, Знач ПутьФайла)

	Источник = ПапкаСписка + "\" + ПутьФайла;
	ФайлИсточника = Новый Файл(Источник);
	Элемент = Новый Структура("КлючФайла, Источник, Путь, Имя, ЭтоПодпись, КлючОсновного, Пометка, ФайлЕсть",
		РефФайла, Источник, ИмяПапки + "\" + ПутьФайла, ФайлИсточника.Имя, Ложь, "", "", ФайлИсточника.Существует());
	Возврат Элемент;

КонецФункции

// Расширения файлов подписи (с точкой, нижний регистр).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция РасширенияПодписи()

	Расширения = Новый Массив;
	Расширения.Добавить(".sig");
	Расширения.Добавить(".p7s");
	Возврат Расширения;

КонецФункции

// Данные сверки договора (один раз за вызов, до обхода; запросов в цикле нет): варианты номера (БИТ; номера
// ДО добавляются по спискам), даты договора, ИНН контрагента, номера других договоров контрагента.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//
// Возвращаемое значение:
//  Структура - {ВариантыНомера, ТокеныДат, ТокеныИНН, ДругиеНомера, КодДО, ПроверкиДО}.
//
Функция ДанныеСверкиДоговора(Знач Договор)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Номер, Дата, Владелец, sd_КодДО");
	ИННКонтрагента = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Владелец, "ИНН")));

	Сверка = Новый Структура;
	Сверка.Вставить("ВариантыНомера", Новый Массив);
	Сверка.Вставить("КодДО", СокрЛП(Реквизиты.sd_КодДО));
	Сверка.Вставить("ПроверкиДО", Новый Массив);
	ДобавитьВариантНомера(Сверка.ВариантыНомера, Реквизиты.Номер);

	Сверка.Вставить("ТокеныДат", ТокеныДатыДоговора(Реквизиты.Дата));
	ТокеныИНН = Новый Массив;
	Если Не ПустаяСтрока(ИННКонтрагента) Тогда
		ТокеныИНН.Добавить(ТокеныНомера(ИННКонтрагента));
	КонецЕсли;
	Сверка.Вставить("ТокеныИНН", ТокеныИНН);

	ДругиеНомера = Новый Массив;
	Для Каждого НомерДоговора Из НомераДругихДоговоровКонтрагента(Договор, Реквизиты.Владелец) Цикл
		ДобавитьВариантНомера(ДругиеНомера, НомерДоговора, Сверка.ВариантыНомера);
	КонецЦикла;
	Сверка.Вставить("ДругиеНомера", ДругиеНомера);

	Возврат Сверка;

КонецФункции

// Номера других договоров контрагента (не помеченных на удаление) - один запрос до обхода файлов,
// привилегированно.
// Владелец - поле подчиненного справочника, индексируется платформой; договоров у контрагента - десятки.
//
// Параметры:
//  Договор    - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//  Контрагент - СправочникСсылка.Контрагенты - владелец договора.
//
// Возвращаемое значение:
//  Массив из Строка - номера.
//
Функция НомераДругихДоговоровКонтрагента(Знач Договор, Знач Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Договоры.Номер КАК Номер
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.Ссылка <> &Договор
		|	И НЕ Договоры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);

	// Привилегированно с парным сбросом: ограничения доступа к договорам у пользователя агента не должны
	// скрыть номер чужого договора (иначе его документ ушел бы в «Относится») или уронить разбор.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Номера = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Номера.Добавить(Выборка.Номер);
	КонецЦикла;
	Возврат Номера;

КонецФункции

// Добавляет вариант номера без повторов (по токенам); пустой номер не добавляется. Вариант, совпадающий
// с исключаемым (номер другого договора равен номеру договора запуска), не добавляется.
//
// Параметры:
//  Варианты    - Массив из Структура - варианты {Номер, Токены, Короткий} (дополняется).
//  Номер       - Строка - номер.
//  Исключаемые - Массив из Структура, Неопределено - варианты, которые не повторять.
//
Процедура ДобавитьВариантНомера(Знач Варианты, Знач Номер, Знач Исключаемые = Неопределено)

	Токены = ТокеныНомера(Номер);
	Если Токены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КлючНомера = СтрСоединить(Токены, "-");
	Для Каждого Вариант Из Варианты Цикл
		Если СтрСоединить(Вариант.Токены, "-") = КлючНомера Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если Исключаемые <> Неопределено Тогда
		Для Каждого Вариант Из Исключаемые Цикл
			Если СтрСоединить(Вариант.Токены, "-") = КлючНомера Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	МинимумЗнаковДлинногоНомера = 4; // Короче - только после «№» или «договор» (спека Г.1).
	КороткийНомер = СтрДлина(СтрСоединить(Токены, "")) < МинимумЗнаковДлинногоНомера;
	Варианты.Добавить(Новый Структура("Номер, Токены, Короткий", СокрЛП(Номер), Токены, КороткийНомер));

КонецПроцедуры

// Сверка договора ДО списка выгрузки (спека Г.1): do_contract.code и sd_КодДО договора БИТ - точное сравнение
// после СокрЛП. match - совпали; unknown - один из кодов пуст; mismatch - выгружен другой договор ДО, его
// номер в варианты не берется, строка журнала. Номер ДО списка при match/unknown - вариант номера.
//
// Параметры:
//  Разбор    - Структура - контекст разбора.
//  Сверка    - Структура - данные сверки (изменяются ВариантыНомера, ПроверкиДО).
//  КодСписка - Строка - номер списка.
//  Список    - Соответствие - разобранный «Выгрузка ДО.json».
//
Процедура ДобавитьПроверкуДоговораДО(Знач Разбор, Знач Сверка, Знач КодСписка, Знач Список)

	ДоговорДО = ПолеОбъекта(Список, "do_contract", Новый Соответствие);
	КодДоговораДОСписка = СокрЛП(ПолеОбъекта(ДоговорДО, "code"));
	НомерДО = СокрЛП(ПолеОбъекта(ДоговорДО, "number"));
	ДатаДО = Формат(ДатаИзСтрокиФайла(ПолеОбъекта(ДоговорДО, "date")), "ДФ=dd.MM.yyyy");

	Если ПустаяСтрока(Сверка.КодДО) Или ПустаяСтрока(КодДоговораДОСписка) Тогда
		ИтогСверки = "unknown";
	ИначеЕсли Сверка.КодДО = КодДоговораДОСписка Тогда
		ИтогСверки = "match";
	Иначе
		ИтогСверки = "mismatch";
	КонецЕсли;

	Проверка = Новый Соответствие;
	Проверка.Вставить("list", КодСписка);
	Проверка.Вставить("result", ИтогСверки);
	Проверка.Вставить("do_number", НомерДО);
	Проверка.Вставить("do_date", ДатаДО);
	Сверка.ПроверкиДО.Добавить(Проверка);

	Если ИтогСверки = "mismatch" Тогда
		ТекстСтроки = СтрШаблон(НСтр("ru = 'выгружен другой договор ДО: код %1, у договора БИТ %2'"),
			КодДоговораДОСписка, Сверка.КодДО);
		ЗаписатьСтрокуЖурналаРазбора(Разбор, "", КодСписка, "", ТекстСтроки);
	Иначе
		ДобавитьВариантНомера(Сверка.ВариантыНомера, НомерДО);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПоискНомераВТексте

// Нормализованный текст (спека Г.1) той же длины, что исходный: нижний регистр, «е» вместо «ё»; пробелы
// (в том числе неразрывные и узкие), кавычки, «№», разделители номера «/ \ - _ .» и тире заменяются на «-».
// Длина сохраняется - позиции совпадений годятся для фрагмента исходного текста.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - нормализованный текст.
//
Функция НормализованныйТекстРазбора(Знач Текст)

	КодБуквыЕСТочками = 1105; // В коде модуля буква не пишется (стандарт), только ее код.
	КодБуквыЕ = 1077;
	Результат = СтрЗаменить(НРег(Текст), Символ(КодБуквыЕСТочками), Символ(КодБуквыЕ));
	Для Каждого Разделитель Из РазделителиТекста() Цикл
		Результат = СтрЗаменить(Результат, Разделитель, "-");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Символы, которые в нормализованном тексте становятся разделителем «-» (по одному символу - длина текста
// не меняется).
//
// Возвращаемое значение:
//  Массив из Строка - символы.
//
Функция РазделителиТекста()

	Разделители = Новый Массив;
	ПечатныеРазделители = " /\_.,:;()'№""";
	Для Позиция = 1 По СтрДлина(ПечатныеРазделители) Цикл
		Разделители.Добавить(Сред(ПечатныеРазделители, Позиция, 1));
	КонецЦикла;
	// Таб, ПС, ВК, ПФ, неразрывный, узкий неразрывный, цифровой, тонкий, en/em-пробелы, дефис, тире, кавычки.
	КодыРазделителей = "9,10,13,12,160,8239,8199,8201,8194,8195,8208,8211,8212,171,187,8222,8220,8221";
	Для Каждого КодРазделителя Из СтрРазделить(КодыРазделителей, ",", Ложь) Цикл
		Разделители.Добавить(Символ(Число(КодРазделителя)));
	КонецЦикла;
	Возврат Разделители;

КонецФункции

// Токены номера: нормализованный номер, разбитый по «-»; ведущие «n», «no» отбрасываются.
//
// Параметры:
//  Номер - Строка - номер договора или ИНН.
//
// Возвращаемое значение:
//  Массив из Строка - токены.
//
Функция ТокеныНомера(Знач Номер)

	Токены = СтрРазделить(НормализованныйТекстРазбора(СокрЛП(Номер)), "-", Ложь);
	Если Токены.Количество() > 1 И (Токены[0] = "n" Или Токены[0] = "no") Тогда
		Токены.Удалить(0);
	КонецЕсли;
	Возврат Токены;

КонецФункции

// Токены даты договора в видах дд.мм.гггг, дд.мм.гг, д месяца гггг; день с ведущим нулем и без.
//
// Параметры:
//  ДатаДоговора - Дата - дата договора.
//
// Возвращаемое значение:
//  Массив из Массив - наборы токенов.
//
Функция ТокеныДатыДоговора(Знач ДатаДоговора)

	Наборы = Новый Массив;
	Если Не ЗначениеЗаполнено(ДатаДоговора) Тогда
		Возврат Наборы;
	КонецЕсли;

	Дни = Новый Массив;
	Дни.Добавить(Формат(ДатаДоговора, "ДФ=dd"));
	Если Дни.Найти(Формат(ДатаДоговора, "ДФ=d")) = Неопределено Тогда
		Дни.Добавить(Формат(ДатаДоговора, "ДФ=d"));
	КонецЕсли;
	НомерМесяца = Формат(ДатаДоговора, "ДФ=MM");
	ГодПолный = Формат(ДатаДоговора, "ДФ=yyyy");
	ГодКраткий = Формат(ДатаДоговора, "ДФ=yy");
	ИмяМесяца = ИменаМесяцевРодительный()[Месяц(ДатаДоговора) - 1];

	Для Каждого День Из Дни Цикл
		Наборы.Добавить(СтрРазделить(День + "-" + НомерМесяца + "-" + ГодПолный, "-"));
		Наборы.Добавить(СтрРазделить(День + "-" + НомерМесяца + "-" + ГодКраткий, "-"));
		Наборы.Добавить(СтрРазделить(День + "-" + ИмяМесяца + "-" + ГодПолный, "-"));
	КонецЦикла;
	Возврат Наборы;

КонецФункции

// Названия месяцев в родительном падеже (нижний регистр).
//
// Возвращаемое значение:
//  Массив из Строка - 12 названий.
//
Функция ИменаМесяцевРодительный()

	ИменаМесяцев = НСтр("ru = 'января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря'");
	Возврат СтрРазделить(ИменаМесяцев, ",");

КонецФункции

// Есть ли в тексте хоть один набор токенов (границы - по цифрам).
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  ИсходныйТекст        - Строка - исходный текст.
//  Наборы               - Массив из Массив - наборы токенов.
//  ГраницыЦифр          - Булево - границы совпадения - только по цифрам.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьСовпадениеВТексте(Знач НормализованныйТекст, Знач ИсходныйТекст, Знач Наборы, Знач ГраницыЦифр)

	Для Каждого Токены Из Наборы Цикл
		Если ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, Токены, ГраницыЦифр, Ложь) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Позиция первого совпадения токенов в нормализованном тексте: токены подряд, между ними 1-3 разделителя «-»;
// до и после совпадения - не буква и не цифра (ГраницыЦифр - не цифра); перед номером допускается «n», «no».
// Короткий номер засчитывается, только если в 30 знаках перед ним в исходном тексте есть «№» или «договор».
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  ИсходныйТекст        - Строка - исходный текст (та же длина).
//  Токены               - Массив из Строка - токены.
//  ГраницыЦифр          - Булево - границы только по цифрам (даты, ИНН).
//  ТребоватьПризнак     - Булево - короткий номер: нужен «№» или «договор» перед ним.
//  НачалоПоиска         - Число - позиция, с которой искать.
//
// Возвращаемое значение:
//  Число - позиция; 0 - не найдено.
//
Функция ПозицияТокеновВТексте(Знач НормализованныйТекст, Знач ИсходныйТекст, Знач Токены, Знач ГраницыЦифр,
	Знач ТребоватьПризнак, Знач НачалоПоиска = 1)

	Если Токены.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ДлинаТекста = СтрДлина(НормализованныйТекст);
	Пока НачалоПоиска <= ДлинаТекста Цикл
		Позиция = СтрНайти(НормализованныйТекст, Токены[0], НаправлениеПоиска.СНачала, НачалоПоиска);
		Если Позиция = 0 Тогда
			Возврат 0;
		КонецЕсли;
		КонецСовпадения = КонецСовпаденияТокенов(НормализованныйТекст, Позиция, Токены);
		ЕстьГраницы = КонецСовпадения > 0
			И ЕстьГраницаПеред(НормализованныйТекст, Позиция, ГраницыЦифр)
			И ЕстьГраницаПосле(НормализованныйТекст, КонецСовпадения, ГраницыЦифр);
		Если ЕстьГраницы И (Не ТребоватьПризнак Или ЕстьПризнакНомераПеред(ИсходныйТекст, Позиция)) Тогда
			Возврат Позиция;
		КонецЕсли;
		НачалоПоиска = Позиция + 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Участки текста, занятые номером договора запуска: все вхождения всех вариантов номера.
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  ИсходныйТекст        - Строка - исходный текст (та же длина).
//  ВариантыНомера       - Массив из Структура - варианты {Номер, Токены, Короткий}.
//
// Возвращаемое значение:
//  Массив из Структура - {Начало, Конец} - позиции первого и последнего символа вхождения.
//
Функция УчасткиСвоегоНомера(Знач НормализованныйТекст, Знач ИсходныйТекст, Знач ВариантыНомера)

	Участки = Новый Массив;
	Для Каждого Вариант Из ВариантыНомера Цикл
		Позиция = ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, Вариант.Токены, Ложь,
			Вариант.Короткий);
		Пока Позиция > 0 Цикл
			КонецУчастка = КонецСовпаденияТокенов(НормализованныйТекст, Позиция, Вариант.Токены);
			Участки.Добавить(Новый Структура("Начало, Конец", Позиция, КонецУчастка));
			Позиция = ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, Вариант.Токены, Ложь,
				Вариант.Короткий, Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	Возврат Участки;

КонецФункции

// Есть ли в тексте номер другого договора вне участков своего номера: совпадение, целиком лежащее внутри
// своего номера («15» в «15/2024»), не засчитывается; номер длиннее своего («15/2024-1») - засчитывается.
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  ИсходныйТекст        - Строка - исходный текст (та же длина).
//  ДругойНомер          - Структура - вариант номера другого договора {Номер, Токены, Короткий}.
//  УчасткиНомера        - Массив из Структура - участки своего номера {Начало, Конец}.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьНомерВнеУчастков(Знач НормализованныйТекст, Знач ИсходныйТекст, Знач ДругойНомер, Знач УчасткиНомера)

	Позиция = ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, ДругойНомер.Токены, Ложь,
		ДругойНомер.Короткий);
	Пока Позиция > 0 Цикл
		КонецСовпадения = КонецСовпаденияТокенов(НормализованныйТекст, Позиция, ДругойНомер.Токены);
		ВнутриСвоего = Ложь;
		Для Каждого Участок Из УчасткиНомера Цикл
			Если Участок.Начало <= Позиция И КонецСовпадения <= Участок.Конец Тогда
				ВнутриСвоего = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ВнутриСвоего Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = ПозицияТокеновВТексте(НормализованныйТекст, ИсходныйТекст, ДругойНомер.Токены, Ложь,
			ДругойНомер.Короткий, Позиция + 1);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Позиция последнего символа совпадения токенов с позиции первого токена; 0 - токены не совпали.
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  Позиция              - Число - позиция первого токена.
//  Токены               - Массив из Строка - токены.
//
// Возвращаемое значение:
//  Число.
//
Функция КонецСовпаденияТокенов(Знач НормализованныйТекст, Знач Позиция, Знач Токены)

	МаксимумРазделителей = 3;
	ТекущаяПозиция = Позиция + СтрДлина(Токены[0]);
	Для Индекс = 1 По Токены.ВГраница() Цикл
		ЧислоРазделителей = 0;
		Пока ЧислоРазделителей < МаксимумРазделителей И Сред(НормализованныйТекст, ТекущаяПозиция, 1) = "-" Цикл
			ТекущаяПозиция = ТекущаяПозиция + 1;
			ЧислоРазделителей = ЧислоРазделителей + 1;
		КонецЦикла;
		Токен = Токены[Индекс];
		Если ЧислоРазделителей = 0 Или Сред(НормализованныйТекст, ТекущаяПозиция, СтрДлина(Токен)) <> Токен Тогда
			Возврат 0;
		КонецЕсли;
		ТекущаяПозиция = ТекущаяПозиция + СтрДлина(Токен);
	КонецЦикла;
	Возврат ТекущаяПозиция - 1;

КонецФункции

// Граница перед совпадением: начало текста или не буква/цифра (ГраницыЦифр - не цифра); для номера
// допускаются «n» и «no» перед ним, если перед ними граница.
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  Позиция              - Число - позиция совпадения.
//  ГраницыЦифр          - Булево - границы только по цифрам.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьГраницаПеред(Знач НормализованныйТекст, Знач Позиция, Знач ГраницыЦифр)

	Если Позиция = 1 Тогда
		Возврат Истина;
	КонецЕсли;
	Предыдущий = Сред(НормализованныйТекст, Позиция - 1, 1);
	Если ГраницыЦифр Тогда
		Возврат Не ЭтоЦифра(Предыдущий);
	КонецЕсли;
	Если Не ЭтоБукваИлиЦифра(Предыдущий) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Префикс Из СтрРазделить("no,n", ",") Цикл
		ДлинаПрефикса = СтрДлина(Префикс);
		НачалоПрефикса = Позиция - ДлинаПрефикса;
		ЕстьПрефикс = НачалоПрефикса >= 1 И Сред(НормализованныйТекст, НачалоПрефикса, ДлинаПрефикса) = Префикс;
		ГраницаПередПрефиксом = (НачалоПрефикса = 1)
			Или (НачалоПрефикса > 1 И Не ЭтоБукваИлиЦифра(Сред(НормализованныйТекст, НачалоПрефикса - 1, 1)));
		Если ЕстьПрефикс И ГраницаПередПрефиксом Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Граница после совпадения: конец текста или не буква/цифра (ГраницыЦифр - не цифра).
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  КонецСовпадения      - Число - позиция последнего символа совпадения.
//  ГраницыЦифр          - Булево - границы только по цифрам.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьГраницаПосле(Знач НормализованныйТекст, Знач КонецСовпадения, Знач ГраницыЦифр)

	Если КонецСовпадения >= СтрДлина(НормализованныйТекст) Тогда
		Возврат Истина;
	КонецЕсли;
	Следующий = Сред(НормализованныйТекст, КонецСовпадения + 1, 1);
	Возврат ?(ГраницыЦифр, Не ЭтоЦифра(Следующий), Не ЭтоБукваИлиЦифра(Следующий));

КонецФункции

// Признак номера перед коротким номером: «№» или слово на «договор» в 30 знаках перед ним.
//
// Параметры:
//  ИсходныйТекст - Строка - исходный текст.
//  Позиция       - Число - позиция номера.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПризнакНомераПеред(Знач ИсходныйТекст, Знач Позиция)

	ДлинаОкна = 30;
	НачалоОкна = Макс(1, Позиция - ДлинаОкна);
	Окно = НРег(Сред(ИсходныйТекст, НачалоОкна, Позиция - НачалоОкна));
	Возврат СтрНайти(Окно, "№") > 0 Или СтрНайти(Окно, НСтр("ru = 'договор'")) > 0;

КонецФункции

// Число букв и цифр в нормализованном тексте, считается до предела (скан с колонтитулом - мало текста).
//
// Параметры:
//  НормализованныйТекст - Строка - нормализованный текст.
//  Предел               - Число - до скольких считать.
//
// Возвращаемое значение:
//  Число - не больше Предел.
//
Функция ЧислоБуквИЦифрНеБольше(Знач НормализованныйТекст, Знач Предел)

	Найдено = 0;
	ДлинаТекста = СтрДлина(НормализованныйТекст);
	Позиция = 1;
	Пока Позиция <= ДлинаТекста И Найдено < Предел Цикл
		Если ЭтоБукваИлиЦифра(Сред(НормализованныйТекст, Позиция, 1)) Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Символ нормализованного текста - буква или цифра.
//
// Параметры:
//  ПроверяемыйСимвол - Строка - символ.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоБукваИлиЦифра(Знач ПроверяемыйСимвол)

	// Буква - символ, у которого есть заглавный и строчный вид (латиница, кириллица).
	Возврат ЭтоЦифра(ПроверяемыйСимвол) Или ВРег(ПроверяемыйСимвол) <> НРег(ПроверяемыйСимвол);

КонецФункции

// Символ - цифра.
//
// Параметры:
//  ПроверяемыйСимвол - Строка - символ.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЦифра(Знач ПроверяемыйСимвол)

	Возврат СтрДлина(ПроверяемыйСимвол) = 1 И СтрНайти("0123456789", ПроверяемыйСимвол) > 0;

КонецФункции

#КонецОбласти

#Область РешенияИЗавершениеРазбора

// Решение спорного файла моделью (спека Г.2): ref - из disputed_for_model (сравнение без регистра и
// пробелов); неизвестный - unknown_ref со списком нерешенных; уже решенный - не ошибка (прежний итог). Перенос
// из «Спорно» вместе с подписями, запись в состояние и журнал.
//
// Параметры:
//  Разбор   - Структура - контекст разбора.
//  РефФайла - Строка - ref (нормализован КодАргумента).
//  Решение  - Строка - related / unrelated.
//
// Возвращаемое значение:
//  Строка - JSON ошибки; пустая строка - решение записано или было записано раньше.
//
Функция ОшибкаРешенияСпорного(Знач Разбор, Знач РефФайла, Знач Решение)

	ЭлементФайла = Неопределено;
	Для Каждого РефСпорного Из ПолеОбъекта(Разбор.Состояние, "disputed_for_model", Новый Массив) Цикл
		Если КодАргумента(РефСпорного) = РефФайла Тогда
			ЭлементФайла = Разбор.ИндексФайлов.Получить(РефСпорного);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЭлементФайла = Неопределено Тогда
		Возврат ОшибкаАргумента("unknown_ref",
			НСтр("ru = 'ref нет среди спорных файлов разбора - передайте ref из списка disputed.'"),
			НерешенныеСпорные(Разбор));
	КонецЕсли;

	Если Не ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "decision")) Тогда
		Возврат ""; // Уже решен - прежний итог.
	КонецЕсли;

	ОшибкаПереноса = ОшибкаПереносаСпорного(Разбор, ЭлементФайла, Решение);
	Если Не ПустаяСтрока(ОшибкаПереноса) Тогда
		ЗаписатьСтрокуЖурналаРазбора(Разбор, ПолеОбъекта(ЭлементФайла, "ref"), ПолеОбъекта(ЭлементФайла, "path"),
			КатегорияСпорно(), НСтр("ru = 'ошибка переноса'") + ": " + ОшибкаПереноса);
		Возврат ОшибкаЗавершенияИнструмента("move_failed",
			СтрШаблон(НСтр("ru = 'Не удалось перенести файл из папки «Спорно»: %1'"), ОшибкаПереноса));
	КонецЕсли;

	ЗаписатьСтрокуЖурналаРазбора(Разбор, ПолеОбъекта(ЭлементФайла, "ref"), ПолеОбъекта(ЭлементФайла, "path"),
		Решение, НСтр("ru = 'решение модели'"));
	ЗаписатьСостояниеРазбора(Разбор);
	Возврат ОтветОшибкиЗаписиСостояния(Разбор);

КонецФункции

// Переносит спорный файл и его подписи в папку решения и отмечает решение в состоянии.
//
// Параметры:
//  Разбор       - Структура - контекст разбора.
//  ЭлементФайла - Соответствие - элемент files спорного файла.
//  Решение      - Строка - related / unrelated.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка - перенесено.
//
Функция ОшибкаПереносаСпорного(Знач Разбор, Знач ЭлементФайла, Знач Решение)

	Переносимые = ЭлементыСПодписями(Разбор, ПолеОбъекта(ЭлементФайла, "ref"));
	Для Каждого Переносимый Из Переносимые Цикл
		Откуда = ПолеОбъекта(Переносимый, "target");
		Куда = ПутьКопииФайла(Разбор.КаталогРазбора, Решение, ПолеОбъекта(Переносимый, "path"),
			ПолеОбъекта(Переносимый, "ref"), ПолеОбъекта(Переносимый, "name"));
		Если ПолеОбъекта(Переносимый, "copied", Ложь) И ФайлСуществует(Откуда) Тогда
			Попытка
				ФайлПриемника = Новый Файл(Куда);
				СоздатьКаталог(ФайлПриемника.Путь);
				Если ФайлСуществует(Куда) Тогда
					УдалитьФайлы(Куда);
				КонецЕсли;
				ПереместитьФайл(Откуда, Куда);
			Исключение
				Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
		КонецЕсли;
		ОтметитьРешениеВСостоянии(Переносимый, Решение, Куда);
	КонецЦикла;
	Возврат "";

КонецФункции

// Элемент files и элементы его подписей.
//
// Параметры:
//  Разбор   - Структура - контекст разбора.
//  РефФайла - Строка - ref основного файла.
//
// Возвращаемое значение:
//  Массив из Соответствие - основной файл первым, затем подписи.
//
Функция ЭлементыСПодписями(Знач Разбор, Знач РефФайла)

	Элементы = Новый Массив;
	Основной = Разбор.ИндексФайлов.Получить(РефФайла);
	Если Основной <> Неопределено Тогда
		Элементы.Добавить(Основной);
	КонецЕсли;
	Для Каждого ЭлементФайла Из ПолеОбъекта(Разбор.Состояние, "files", Новый Массив) Цикл
		Если ПолеОбъекта(ЭлементФайла, "main") = РефФайла Тогда
			Элементы.Добавить(ЭлементФайла);
		КонецЕсли;
	КонецЦикла;
	Возврат Элементы;

КонецФункции

// Отмечает решение в элементе состояния: категория решения, новый путь копии.
//
// Параметры:
//  ЭлементФайла - Соответствие - элемент files.
//  Решение      - Строка - related / unrelated.
//  НовыйПуть    - Строка - путь копии в папке решения.
//
Процедура ОтметитьРешениеВСостоянии(Знач ЭлементФайла, Знач Решение, Знач НовыйПуть)

	ЭлементФайла.Вставить("decision", Решение);
	ЭлементФайла.Вставить("category", Решение);
	ЭлементФайла.Вставить("target", НовыйПуть);

КонецПроцедуры

// Сверка спорных по диску (спека Е.5): у ref из disputed_for_model без решения файла нет в «Спорно», но он
// есть в «Относится» или «Не относится» - решение восстанавливается по месту файла (сбой между переносом
// и записью состояния). Подписи, оставшиеся в «Спорно», переносятся следом.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
Процедура ВосстановитьРешенияПоДиску(Знач Разбор)

	Восстановлено = Ложь;
	Для Каждого РефСпорного Из ПолеОбъекта(Разбор.Состояние, "disputed_for_model", Новый Массив) Цикл
		ЭлементФайла = Разбор.ИндексФайлов.Получить(РефСпорного);
		Если ЭлементФайла = Неопределено Или Не ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "decision"))
			Или ФайлСуществует(ПолеОбъекта(ЭлементФайла, "target")) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Решение Из ДопустимыеРешения() Цикл
			ПутьРешения = ПутьКопииФайла(Разбор.КаталогРазбора, Решение, ПолеОбъекта(ЭлементФайла, "path"),
				РефСпорного, ПолеОбъекта(ЭлементФайла, "name"));
			Если ФайлСуществует(ПутьРешения) Тогда
				ОшибкаПереноса = ОшибкаПереносаСпорного(Разбор, ЭлементФайла, Решение);
				ПричинаЖурнала = НСтр("ru = 'решение восстановлено по месту файла'");
				Если Не ПустаяСтрока(ОшибкаПереноса) Тогда
					ПричинаЖурнала = ПричинаЖурнала + "; " + ОшибкаПереноса;
				КонецЕсли;
				ЗаписатьСтрокуЖурналаРазбора(Разбор, РефСпорного, ПолеОбъекта(ЭлементФайла, "path"), Решение,
					ПричинаЖурнала);
				Восстановлено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Восстановлено Тогда
		ЗаписатьСостояниеРазбора(Разбор);
	КонецЕсли;

КонецПроцедуры

// Нерешенные ref из disputed_for_model.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция НерешенныеСпорные(Знач Разбор)

	Нерешенные = Новый Массив;
	Для Каждого РефСпорного Из ПолеОбъекта(Разбор.Состояние, "disputed_for_model", Новый Массив) Цикл
		ЭлементФайла = Разбор.ИндексФайлов.Получить(РефСпорного);
		Если ЭлементФайла <> Неопределено И ПустаяСтрока(ПолеОбъекта(ЭлементФайла, "decision")) Тогда
			Нерешенные.Добавить(РефСпорного);
		КонецЕсли;
	КонецЦикла;
	Возврат Нерешенные;

КонецФункции

// Завершает разбор, если обход пройден и спорных для модели не осталось (спека Г.3): finished и mail =
// pending, письмо инициатору, затем mail = sent / not_sent. Статус done в файле задания ставит регламент.
//
// Параметры:
//  Разбор - Структура - контекст разбора.
//
Процедура ЗавершитьРазборЕслиРешено(Знач Разбор)

	Если Не ОбходРазбораПройден(Разбор.Состояние) Или НерешенныеСпорные(Разбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Разбор.Состояние.Вставить("finished", СтрокаДатыФайла(ТекущаяДатаСеанса()));
	Разбор.Состояние.Вставить("mail", СтатусПисьмаОжидает());
	Если Не ЗаписатьСостояниеРазбора(Разбор) Тогда
		Возврат;
	КонецЕсли;

	Счетчики = СчетчикиРазбора(Разбор.Состояние);
	ШаблонИтога = НСтр("ru = 'Разбор завершен: относится %1, не относится %2, не распознано %3,
		|спорно (для человека) %4, ошибок копирования %5'");
	ТекстИтога = СтрШаблон(СтрЗаменить(ШаблонИтога, Символы.ПС, " "), Счетчики.related, Счетчики.unrelated,
		Счетчики.unrecognized, Счетчики.disputed, Счетчики.copy_errors);
	ЗаписатьСтрокуЖурналаРазбора(Разбор, "", "", "", ТекстИтога);

	ПричинаНеотправки = ОтправитьПисьмоИтогаРазбора(Разбор.Подкаталог, Разбор.Задание, Разбор.Состояние, Ложь);
	Разбор.Состояние.Вставить("mail", ?(ПустаяСтрока(ПричинаНеотправки), "sent", "not_sent"));
	Разбор.Состояние.Вставить("mail_reason", ПричинаНеотправки);
	ТекстПисьма = НСтр("ru = 'Письмо инициатору отправлено'");
	Если Не ПустаяСтрока(ПричинаНеотправки) Тогда
		ТекстПисьма = НСтр("ru = 'Письмо инициатору не отправлено'") + ": " + ПричинаНеотправки;
	КонецЕсли;
	ЗаписатьСтрокуЖурналаРазбора(Разбор, "", "", "", ТекстПисьма);
	ЗаписатьСостояниеРазбора(Разбор);

КонецПроцедуры

// Ответ инструментов разбора: directory, task, do_contract_check, counts, disputed (нерешенные, до 20: ref,
// name, fragment), disputed_left_for_human, finished, mail (после завершения) и resolved (у решения).
//
// Параметры:
//  Разбор   - Структура - контекст разбора.
//  РефФайла - Строка - ref решенного файла (для contract_termination_documents_resolve).
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ОтветРазбора(Знач Разбор, Знач РефФайла = "")

	Ответ = Новый Структура;
	Ответ.Вставить("directory", Разбор.КаталогРазбора);
	Ответ.Вставить("task", ПутьЗаданияРазбора(Разбор.Подкаталог));

	ПроверкиДО = Новый Массив;
	Для Каждого ПроверкаДО Из ПолеОбъекта(Разбор.Состояние, "do_contract_check", Новый Массив) Цикл
		ПроверкиДО.Добавить(Новый Структура("list, result, do_number", ПолеОбъекта(ПроверкаДО, "list"),
			ПолеОбъекта(ПроверкаДО, "result"), ПолеОбъекта(ПроверкаДО, "do_number")));
	КонецЦикла;
	Ответ.Вставить("do_contract_check", ПроверкиДО);
	Ответ.Вставить("counts", СчетчикиРазбора(Разбор.Состояние));

	Спорные = Новый Массив;
	Для Каждого РефСпорного Из НерешенныеСпорные(Разбор) Цикл
		ЭлементФайла = Разбор.ИндексФайлов.Получить(РефСпорного);
		Спорные.Добавить(Новый Структура("ref, name, fragment", РефСпорного, ПолеОбъекта(ЭлементФайла, "name"),
			ПолеОбъекта(ЭлементФайла, "fragment")));
	КонецЦикла;
	Ответ.Вставить("disputed", Спорные);
	Ответ.Вставить("disputed_left_for_human", Макс(0, Ответ.counts.disputed - Спорные.Количество()));

	Если Не ПустаяСтрока(РефФайла) Тогда
		ЭлементФайла = Разбор.ИндексФайлов.Получить(РефФайла);
		Ответ.Вставить("resolved", Новый Структура("ref, decision", РефФайла,
			ПолеОбъекта(ЭлементФайла, "decision")));
	КонецЕсли;

	Ответ.Вставить("finished", РазборЗакончен(Разбор.Состояние));
	Если Ответ.finished Тогда
		Ответ.Вставить("mail", ПолеОбъекта(Разбор.Состояние, "mail"));
		Ответ.Вставить("mail_reason", ПолеОбъекта(Разбор.Состояние, "mail_reason"));
	КонецЕсли;
	Если Не ПустаяСтрока(Разбор.Журнал.ОшибкаЗаписи) Тогда
		Ответ.Вставить("log_error", Разбор.Журнал.ОшибкаЗаписи);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// План разбора для режима без записи (спека Г.4): задание, число файлов в списках выгрузки, пути категорий.
//
// Параметры:
//  Подкаталог - Строка - подкаталог договора.
//
// Возвращаемое значение:
//  Структура - {task, files, directories}.
//
Функция ПланРазбораДляОтвета(Знач Подкаталог)

	ЧислоФайлов = 0;
	Для Каждого ПапкаСписка Из ПапкиСписковВыгрузки(Подкаталог) Цикл
		Список = ПрочитатьФайлДанных(ПапкаСписка + "\" + ИмяФайлаСпискаВыгрузки()).Данные;
		ЧислоФайлов = ЧислоФайлов + ПолеОбъекта(Список, "files", Новый Массив).Количество();
	КонецЦикла;

	КаталогРазбора = Подкаталог + "\" + ИмяПапкиРазбора();
	Каталоги = Новый Массив;
	Категории = ДопустимыеРешения();
	Категории.Добавить(КатегорияНеРаспознано());
	Категории.Добавить(КатегорияСпорно());
	Для Каждого Категория Из Категории Цикл
		Каталоги.Добавить(КаталогРазбора + "\" + ИмяПапкиКатегории(Категория));
	КонецЦикла;

	Возврат Новый Структура("task, files, directories", ПутьЗаданияРазбора(Подкаталог), ЧислоФайлов, Каталоги);

КонецФункции

// Допустимые решения модели (enum аргумента decision).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеРешения()

	Решения = Новый Массив;
	Решения.Добавить(КатегорияОтносится());
	Решения.Добавить(КатегорияНеОтносится());
	Возврат Решения;

КонецФункции

// Код аргумента модели для сравнения: без регистра и без пробелов (правило AGENTS.md для кодов и ref).
//
// Параметры:
//  Значение - Произвольный - значение аргумента.
//
// Возвращаемое значение:
//  Строка.
//
Функция КодАргумента(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Результат = НРег(Значение);
	Пробелы = Новый Массив;
	Пробелы.Добавить(" ");
	Пробелы.Добавить(Символы.Таб);
	КодНеразрывногоПробела = 160;
	КодУзкогоНеразрывногоПробела = 8239;
	Пробелы.Добавить(Символ(КодНеразрывногоПробела));
	Пробелы.Добавить(Символ(КодУзкогоНеразрывногоПробела));
	Для Каждого Пробел Из Пробелы Цикл
		Результат = СтрЗаменить(Результат, Пробел, "");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ошибка аргумента без завершения запуска: модель может исправить вызов.
//
// Параметры:
//  КодОшибки  - Строка - код ошибки.
//  Сообщение  - Строка - причина по-русски.
//  Допустимые - Массив, Неопределено - допустимые значения.
//
// Возвращаемое значение:
//  Строка - JSON {error, message[, allowed]}.
//
Функция ОшибкаАргумента(Знач КодОшибки, Знач Сообщение, Знач Допустимые = Неопределено)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("message", Сообщение);
	Если Допустимые <> Неопределено Тогда
		Объект.Вставить("allowed", Допустимые);
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

#КонецОбласти

#КонецОбласти
