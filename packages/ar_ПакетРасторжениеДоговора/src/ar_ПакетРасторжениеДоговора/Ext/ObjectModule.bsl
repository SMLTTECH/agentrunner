КонецФункции

// Имя файла отчета по платежным поручениям - константа модуля (спека п.3).
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайлаОтчетаПлатежных()

	Возврат НСтр("ru = 'Отчет по платежным поручениям.xlsx'");

КонецФункции

// Шаг вложений (ks2 / commission_reports / ks2_corrections): по найденным по
// договору документам - вложения в папку шага с номером и датой документа в имени
// файла. Корректировочные КС-2 берут файлы документа-основания - один раз на
// основание за шаг (решение человека 19.11.2026). Зашифрованные файлы и файлы без
// двоичных данных пропускаются (skipped). Нет документов - no_documents,
// документы без файлов - no_files (спека п.3).
//
// Параметры:
//  Сбор             - Структура - контекст сбора.
//  КодШага          - Строка - код шага вложений.
//  СтрокиДокументов - Массив, Неопределено - документы вида шага.
//
// Возвращаемое значение:
//  Структура - шаг ответа.
//
Функция ВыполнитьШагВложений(Знач Сбор, Знач КодШага, Знач СтрокиДокументов)

	ИмяШага = ИмяШагаЖурнала(КодШага);
	Шаг = НовыйШагОтвета(КодШага);

	Если СтрокиДокументов = Неопределено Или СтрокиДокументов.Количество() = 0 Тогда
		Шаг.status = "no_documents";
		Шаг.message = НСтр("ru = 'Документы по договору не найдены.'");
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, "", "", "", 0, НСтр("ru = 'документов нет'"));
		Возврат Шаг;
	КонецЕсли;

	Шаг.documents = СтрокиДокументов.Количество();
	КаталогПапки = Сбор.КаталогПодкаталога + "\" + ИмяПапкиШага(КодШага);
	СоздатьКаталог(КаталогПапки);

	// Ссылки файлов всех документов шага (и оснований корректировочных) - одним
	// запросом на шаг, без запроса на каждый документ (agentrunner-485).
	ФайлыВладельцев = ФайлыВладельцевГруппой(ВладельцыФайловШага(КодШага, СтрокиДокументов));

	// Первый проход: задания на сохранение и строки журнала, не зависящие
	// от свойств файлов (нет файлов, основание не указано).
	Задания = Новый Массив;
	СохраненныеОснования = Новый Соответствие;
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл
		ОбновитьПульсСбора(Сбор);
		Если КодШага = КодШагаКорректировочныхКС2() Тогда
			ЗаполнитьЗаданияКорректировочного(Сбор, СтрокаДокумента, Задания, СохраненныеОснования,
				ФайлыВладельцев);
		Иначе
			ЗаполнитьЗаданияДокументаВложений(Сбор, КодШага, СтрокаДокумента, Задания, ФайлыВладельцев);
		КонецЕсли;
	КонецЦикла;

	Если Задания.Количество() = 0 Тогда
		Шаг.status = "no_files";
		Шаг.message = НСтр("ru = 'У найденных документов нет присоединённых файлов.'");
		Возврат Шаг;
	КонецЕсли;

	// Свойства файлов - одним чтением БСП на тип справочника файлов, без запроса
	// на каждый файл (спека п.3 «вложения»).
	СвойстваФайлов = СвойстваФайловГруппой(СсылкиФайловЗаданий(Задания));
	ЗаписатьФайлыЗаданий(Сбор, Шаг, Задания, СвойстваФайлов, КаталогПапки, ИмяШага);

	Шаг.status = "ok";
	Возврат Шаг;

КонецФункции

// Второй проход шага вложений: запись файлов заданий в папку шага - по одному
// файлу (прочитал - записал), ошибка одного файла не останавливает остальные
// (строка журнала «ошибка», итоги считаются). Метки повтора основания дают
// только строку журнала «файлы основания уже сохранены» (спека п.3).
//
// Параметры:
//  Сбор            - Структура - контекст сбора (изменяются итоги).
//  Шаг             - Структура - шаг ответа (skipped, files, files_total).
//  Задания         - Массив    - задания на сохранение.
//  СвойстваФайлов  - Соответствие - Ссылка -> {Наименование, Расширение, Зашифрован}.
//  КаталогПапки    - Строка    - папка шага.
//  ИмяШага         - Строка    - имя шага журнала.
//
Процедура ЗаписатьФайлыЗаданий(Знач Сбор, Знач Шаг, Знач Задания, Знач СвойстваФайлов,
	Знач КаталогПапки, Знач ИмяШага)

	Для Каждого Задание Из Задания Цикл
		ОбновитьПульсСбора(Сбор);
		Если Задание.УжеСохранено Тогда
			РезультатПовтора = СтрШаблон(НСтр("ru = 'файлы основания уже сохранены: %1'"),
				Задание.ПервоеЗадание.ФактическоеИмя);
			ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, Задание.Источник, "", "", 0, РезультатПовтора);
			Продолжить;
		КонецЕсли;

		СвойстваФайла = СвойстваФайлов.Получить(Задание.СсылкаФайла);
		ИсходноеИмя = ИмяИсходногоФайла(СвойстваФайла);
		Если СвойстваФайла = Неопределено Или СвойстваФайла.Зашифрован Тогда
			ПричинаПропуска = ?(СвойстваФайла = Неопределено, НСтр("ru = 'нет данных файла'"),
				НСтр("ru = 'зашифрован'"));
			УчестьПропускФайла(Сбор, Шаг, ИмяШага, Задание, ИсходноеИмя, ПричинаПропуска);
			Продолжить;
		КонецЕсли;

		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(Задание.СсылкаФайла, Ложь);
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			УчестьПропускФайла(Сбор, Шаг, ИмяШага, Задание, ИсходноеИмя,
				НСтр("ru = 'нет данных файла'"));
			Продолжить;
		КонецЕсли;

		ИмяФайла = ИмяФайлаВложения(КаталогПапки, Задание.ПрефиксИмени,
			СвойстваФайла.Наименование, СвойстваФайла.Расширение);
		ПутьФайла = ФайловаяСистема.УникальноеИмяФайла(КаталогПапки + "\" + ИмяФайла);
		Если Не ЗаписатьФайлЗадания(Сбор, ДвоичныеДанные, ПутьФайла, ИмяШага, Задание,
			ИсходноеИмя, ИмяФайла) Тогда
			Продолжить;
		КонецЕсли;

		Задание.ФактическоеИмя = ИмяФайлаОтносительноКаталога(ПутьФайла, Сбор.КаталогПодкаталога);
		Шаг.files_total = Шаг.files_total + 1;
		Сбор.СохраненоФайлов = Сбор.СохраненоФайлов + 1;
		ДобавитьФайлВШаг(Шаг, Задание.ФактическоеИмя, ДвоичныеДанные.Размер());
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, Задание.Источник, ИсходноеИмя,
			Задание.ФактическоеИмя, ДвоичныеДанные.Размер(), НСтр("ru = 'сохранён'"));
	КонецЦикла;

КонецПроцедуры

// Учитывает пропуск файла (зашифрован, нет данных): итоги шага и сбора, строка
// журнала «пропущен: <причина>» (спека п.3).
//
// Параметры:
//  Сбор          - Структура - контекст сбора (изменяется ПропущеноФайлов).
//  Шаг           - Структура - шаг ответа (изменяется skipped).
//  ИмяШага       - Строка    - имя шага журнала.
//  Задание       - Структура - задание файла (источник для журнала).
//  ИсходноеИмя   - Строка    - имя исходного файла (может быть пустым).
//  Причина       - Строка    - причина пропуска.
//
Процедура УчестьПропускФайла(Знач Сбор, Знач Шаг, Знач ИмяШага, Знач Задание,
	Знач ИсходноеИмя, Знач Причина)

	РезультатПропуска = НСтр("ru = 'пропущен'") + ": " + Причина;
	Шаг.skipped = Шаг.skipped + 1;
	Сбор.ПропущеноФайлов = Сбор.ПропущеноФайлов + 1;
	ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, Задание.Источник, ИсходноеИмя, "", 0, РезультатПропуска);

КонецПроцедуры

// Записывает двоичные данные файла в папку шага; ошибка записи не останавливает
// шаг - строка журнала «ошибка: <текст>», итог ошибок сбора считается (спека п.3).
//
// Параметры:
//  Сбор            - Структура      - контекст сбора (изменяется Ошибок).
//  ДвоичныеДанные  - ДвоичныеДанные - данные файла.
//  ПутьФайла       - Строка         - полный путь файла.
//  ИмяШага         - Строка         - имя шага журнала.
//  Задание         - Структура      - задание файла (источник для журнала).
//  ИсходноеИмя     - Строка         - имя исходного файла.
//  ИмяФайла        - Строка         - имя сохраняемого файла.
//
// Возвращаемое значение:
//  Булево - Истина, если файл записан.
//
Функция ЗаписатьФайлЗадания(Знач Сбор, Знач ДвоичныеДанные, Знач ПутьФайла, Знач ИмяШага,
	Знач Задание, Знач ИсходноеИмя, Знач ИмяФайла)

	Попытка
		ДвоичныеДанные.Записать(ПутьФайла);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		РезультатОшибки = НСтр("ru = 'ошибка'") + ": " + ТекстОшибки;
		Сбор.Ошибок = Сбор.Ошибок + 1;
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, Задание.Источник, ИсходноеИмя, ИмяФайла, 0,
			РезультатОшибки);
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Задания на сохранение вложений обычного документа (КС-2, отчет комитенту):
// файлы документа с префиксом «<№ документа> от <дата> - ». Документ без файлов -
// строка журнала «файлов нет» (спека п.3 «журнал работы»).
//
// Параметры:
//  Сбор             - Структура - контекст сбора.
//  КодШага          - Строка - код шага вложений.
//  СтрокаДокумента  - Структура - документ шага {Ссылка, Номер, Дата}.
//  Задания          - Массив - пополняемые задания на сохранение.
//  ФайлыВладельцев  - Соответствие - владелец -> Массив ссылок файлов
//                     (см. ФайлыВладельцевГруппой).
//
Процедура ЗаполнитьЗаданияДокументаВложений(Знач Сбор, Знач КодШага, Знач СтрокаДокумента, Задания,
	Знач ФайлыВладельцев)

	ВидДокумента = ВидДокументаШага(КодШага);
	Источник = ПредставлениеДокументаЖурнала(ВидДокумента, СтрокаДокумента.Номер, СтрокаДокумента.Дата);

	СсылкиФайлов = ФайлыВладельца(ФайлыВладельцев, СтрокаДокумента.Ссылка);
	Если СсылкиФайлов.Количество() = 0 Тогда
		ИмяШага = ИмяШагаЖурнала(КодШага);
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, Источник, "", "", 0, НСтр("ru = 'файлов нет'"));
		Возврат;
	КонецЕсли;

	ПрефиксИмени = ПрефиксИмениФайлаДокумента(СтрокаДокумента.Номер, СтрокаДокумента.Дата);
	Для Каждого СсылкаФайла Из СсылкиФайлов Цикл
		Задания.Добавить(НовоеЗаданиеФайла(СсылкаФайла, ПрефиксИмени, Источник));
	КонецЦикла;

КонецПроцедуры

// Задания на сохранение вложений корректировочного КС-2 (решение человека
// 19.11.2026, спека п.3): собственных файлов у документа нет (хранилище не
// определено), берутся файлы документа-основания - один раз на основание за шаг,
// даже если на него ссылаются несколько корректировочных; имя файла
// «<№ корр.> от <дата> - основание <№ КС-2> от <дата> - <имя>». Собственные файлы
// корректировочного (если метод их вернет) тоже сохраняются. Основание не
// заполнено - строка журнала «основание не указано». Повторное основание -
// задание-метка для строки журнала «файлы основания уже сохранены: <имя>».
//
// Параметры:
//  Сбор                 - Структура - контекст сбора.
//  СтрокаДокумента      - Структура - документ шага {Ссылка, Номер, Дата,
//                         Основание, НомерОснования, ДатаОснования}.
//  Задания              - Массив - пополняемые задания на сохранение.
//  СохраненныеОснования - Соответствие - Основание -> первое задание файлов
//                         основания (для дедупликации и строки журнала).
//  ФайлыВладельцев      - Соответствие - владелец -> Массив ссылок файлов
//                         (см. ФайлыВладельцевГруппой).
//
Процедура ЗаполнитьЗаданияКорректировочного(Знач Сбор, Знач СтрокаДокумента, Задания, Знач СохраненныеОснования,
	Знач ФайлыВладельцев)

	ИмяШага = ИмяШагаЖурнала(КодШагаКорректировочныхКС2());
	ВидКорр = НСтр("ru = 'Корректировочный КС-2'");
	ИсточникКорр = ПредставлениеДокументаЖурнала(ВидКорр, СтрокаДокумента.Номер, СтрокаДокумента.Дата);
	ПрефиксКорр = ПрефиксИмениФайлаДокумента(СтрокаДокумента.Номер, СтрокаДокумента.Дата);

	// Собственные файлы корректировочного - если метод их вернет.
	СобственныеФайлы = ФайлыВладельца(ФайлыВладельцев, СтрокаДокумента.Ссылка);
	Для Каждого СсылкаФайла Из СобственныеФайлы Цикл
		Задания.Добавить(НовоеЗаданиеФайла(СсылкаФайла, ПрефиксКорр, ИсточникКорр));
	КонецЦикла;

	Если Не ЗначениеЗаполнено(СтрокаДокумента.Основание) Тогда
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникКорр, "", "", 0,
			НСтр("ru = 'основание не указано'"));
		Возврат;
	КонецЕсли;

	ПервичноеЗадание = СохраненныеОснования.Получить(СтрокаДокумента.Основание);
	Если ПервичноеЗадание <> Неопределено Тогда
		ЗаданиеПовтора = НовоеЗаданиеФайла(Неопределено, "", ИсточникКорр);
		ЗаданиеПовтора.УжеСохранено = Истина;
		ЗаданиеПовтора.ПервоеЗадание = ПервичноеЗадание;
		Задания.Добавить(ЗаданиеПовтора);
		Возврат;
	КонецЕсли;

	ПредставлениеОснования = ПредставлениеДокументаЖурнала("КС-2",
		СтрокаДокумента.НомерОснования, СтрокаДокумента.ДатаОснования);
	ПрипискаКорр = СтрШаблон(НСтр("ru = 'основание корр. КС-2 № %1 от %2'"), СокрЛП(СтрокаДокумента.Номер),
		Формат(СтрокаДокумента.Дата, "ДФ=dd.MM.yyyy"));
	ИсточникОснования = СтрШаблон("%1 (%2)", ПредставлениеОснования, ПрипискаКорр);

	ФайлыОснования = ФайлыВладельца(ФайлыВладельцев, СтрокаДокумента.Основание);
	Если ФайлыОснования.Количество() = 0 Тогда
		ЗаписатьСтрокуЖурнала(Сбор.Журнал, ИмяШага, ИсточникОснования, "", "", 0,
			НСтр("ru = 'файлов нет'"));
		Возврат;
	КонецЕсли;

	ПрефиксОснования = ПрефиксКорр + " - " + НСтр("ru = 'основание'") + " "
		+ ПрефиксИмениФайлаДокумента(СтрокаДокумента.НомерОснования, СтрокаДокумента.ДатаОснования);
	Для Каждого СсылкаФайла Из ФайлыОснования Цикл
		ЗаданиеОснования = НовоеЗаданиеФайла(СсылкаФайла, ПрефиксОснования, ИсточникОснования);
		Задания.Добавить(ЗаданиеОснования);
		Если СохраненныеОснования.Получить(СтрокаДокумента.Основание) = Неопределено Тогда
			СохраненныеОснования.Вставить(СтрокаДокумента.Основание, ЗаданиеОснования);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Владельцы файлов шага вложений: документы шага, для корректировочных КС-2 -
// еще и заполненные документы-основания (без повторов).
//
// Параметры:
//  КодШага          - Строка - код шага вложений.
//  СтрокиДокументов - Массив из Структура - документы шага {Ссылка, Основание, ...}.
//
// Возвращаемое значение:
//  Массив - ссылки владельцев файлов.
//
Функция ВладельцыФайловШага(Знач КодШага, Знач СтрокиДокументов)

	Владельцы = Новый Массив;
	УчтенныеОснования = Новый Соответствие;
	ЭтоКорректировочные = (КодШага = КодШагаКорректировочныхКС2());
	Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл
		Владельцы.Добавить(СтрокаДокумента.Ссылка);
		Если ЭтоКорректировочные И ЗначениеЗаполнено(СтрокаДокумента.Основание)
			И УчтенныеОснования.Получить(СтрокаДокумента.Основание) = Неопределено Тогда
			УчтенныеОснования.Вставить(СтрокаДокумента.Основание, Истина);
			Владельцы.Добавить(СтрокаДокумента.Основание);
		КонецЕсли;
	КонецЦикла;

	Возврат Владельцы;

КонецФункции

// Ссылки присоединенных файлов группы владельцев - одним запросом на весь шаг:
// по всем справочникам хранения файлов типов владельцев (РаботаСФайламиСлужебный.
// ИменаСправочниковХраненияФайлов), ВладелецФайла В (&Владельцы), без помеченных
// на удаление и без групп - те же условия, что у РаботаСФайламиСлужебный.
// ПрисоединенныеФайлыКОбъекту(Владелец, Истина), но без запроса на каждый
// документ (agentrunner-485). Привилегированный режим - как в методе БСП: файлы
// читаются от имени пользователя агента, ограничения доступа к ним не должны
// скрыть вложения договора.
//
// Параметры:
//  Владельцы - Массив - ссылки владельцев файлов (разных типов).
//
// Возвращаемое значение:
//  Соответствие - владелец -> Массив ссылок файлов; владельцев без файлов нет.
//
Функция ФайлыВладельцевГруппой(Знач Владельцы)

	ФайлыВладельцев = Новый Соответствие;

	ТекстЗапроса = ТекстЗапросаФайловВладельцев(Владельцы);
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат ФайлыВладельцев;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владельцы", Владельцы);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Пока Выборка.Следующий() Цикл
		ФайлыВладельца = ФайлыВладельцев.Получить(Выборка.Владелец);
		Если ФайлыВладельца = Неопределено Тогда
			ФайлыВладельца = Новый Массив;
			ФайлыВладельцев.Вставить(Выборка.Владелец, ФайлыВладельца);
		КонецЕсли;
		ФайлыВладельца.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат ФайлыВладельцев;

КонецФункции

// Текст запроса файлов владельцев: справочники хранения всех типов владельцев
// без повторов, по справочнику - часть ОБЪЕДИНИТЬ ВСЕ с отбором ВладелецФайла В
// (&Владельцы). Имя справочника подставляется в текст (имя таблицы параметром не
// передать) и берется из метаданных, а не из данных. Тип без справочников
// хранения (корректировочный КС-2) частей не дает.
//
// Параметры:
//  Владельцы - Массив - ссылки владельцев файлов.
//
// Возвращаемое значение:
//  Строка - текст запроса; пустая строка, если справочников хранения нет.
//
Функция ТекстЗапросаФайловВладельцев(Знач Владельцы)

	УчтенныеТипы = Новый Соответствие;
	ИменаСправочников = Новый Массив;
	Для Каждого Владелец Из Владельцы Цикл
		ТипВладельца = ТипЗнч(Владелец);
		Если УчтенныеТипы.Получить(ТипВладельца) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УчтенныеТипы.Вставить(ТипВладельца, Истина);
		ИменаТипа = РаботаСФайламиСлужебный.ИменаСправочниковХраненияФайлов(ТипВладельца, Истина);
		Для Каждого КлючИЗначение Из ИменаТипа Цикл
			Если ИменаСправочников.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
				ИменаСправочников.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЧастиЗапроса = Новый Массив;
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		ТекстЧасти =
			"ВЫБРАТЬ
			|	ПрисоединенныеФайлы.ВладелецФайла КАК Владелец,
			|	ПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	&ИмяСправочника КАК ПрисоединенныеФайлы
			|ГДЕ
			|	ПрисоединенныеФайлы.ВладелецФайла В (&Владельцы)
			|	И НЕ ПрисоединенныеФайлы.ПометкаУдаления";
		Если Метаданные.Справочники[ИмяСправочника].Иерархический = Истина Тогда
			ТекстЧасти = ТекстЧасти + "
				|	И НЕ ПрисоединенныеФайлы.ЭтоГруппа";
		КонецЕсли;
		ЧастиЗапроса.Добавить(СтрЗаменить(ТекстЧасти, "&ИмяСправочника", "Справочник." + ИмяСправочника));
	КонецЦикла;

	РазделительЧастей = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	Возврат СтрСоединить(ЧастиЗапроса, РазделительЧастей);

КонецФункции

// Ссылки файлов владельца из результата ФайлыВладельцевГруппой.
//
// Параметры:
//  ФайлыВладельцев - Соответствие - владелец -> Массив ссылок файлов.
//  Владелец        - ЛюбаяСсылка - владелец файлов.
//
// Возвращаемое значение:
//  Массив - ссылки файлов; пустой, если файлов нет.
//
Функция ФайлыВладельца(Знач ФайлыВладельцев, Знач Владелец)

	СсылкиФайлов = ФайлыВладельцев.Получить(Владелец);
	Если СсылкиФайлов = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат СсылкиФайлов;

КонецФункции

// Задание на сохранение одного файла.
//
// Параметры:
//  СсылкаФайла  - СправочникСсылка, Неопределено - файл (для меток повтора - пусто).
//  ПрефиксИмени - Строка - префикс имени файла (номер и дата документа).
//  Источник     - Строка - документ-источник для журнала.
//
// Возвращаемое значение:
//  Структура - {СсылкаФайла, ПрефиксИмени, Источник, УжеСохранено, ПервоеЗадание,
//  ФактическоеИмя}.
//
Функция НовоеЗаданиеФайла(Знач СсылкаФайла, Знач ПрефиксИмени, Знач Источник)

	Возврат Новый Структура("СсылкаФайла, ПрефиксИмени, Источник, УжеСохранено, ПервоеЗадание, ФактическоеИмя",
		СсылкаФайла, ПрефиксИмени, Источник, Ложь, Неопределено, "");

КонецФункции

// Ссылки файлов из заданий (для группового чтения свойств).
//
// Параметры:
//  Задания - Массив из Структура - задания на сохранение.
//
// Возвращаемое значение:
//  Массив - ссылки файлов (без меток повтора).
//
Функция СсылкиФайловЗаданий(Знач Задания)

	Ссылки = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Если Не Задание.УжеСохранено Тогда
			Ссылки.Добавить(Задание.СсылкаФайла);
		КонецЕсли;
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

// Свойства файлов (Наименование, Расширение, Зашифрован) группой по типу
// справочника файлов: один вызов ЗначенияРеквизитовОбъектов на тип, без запроса
// на каждый файл (спека п.3 «вложения»).
//
// Параметры:
//  СсылкиФайлов - Массив - ссылки присоединенных файлов разных справочников.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Наименование, Расширение, Зашифрован}.
//
Функция СвойстваФайловГруппой(Знач СсылкиФайлов)

	СсылкиПоТипам = Новый Соответствие;
	Для Каждого СсылкаФайла Из СсылкиФайлов Цикл
		ТипСправочника = ТипЗнч(СсылкаФайла);
		СсылкиТипа = СсылкиПоТипам.Получить(ТипСправочника);
		Если СсылкиТипа = Неопределено Тогда
			СсылкиТипа = Новый Массив;
			СсылкиПоТипам.Вставить(ТипСправочника, СсылкиТипа);
		КонецЕсли;
		СсылкиТипа.Добавить(СсылкаФайла);
	КонецЦикла;

	Свойства = Новый Соответствие;
	Для Каждого Пара Из СсылкиПоТипам Цикл
		СвойстваТипа = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Пара.Значение,
			"Наименование, Расширение, Зашифрован");
		Для Каждого ЭлементСвойств Из СвойстваТипа Цикл
			Свойства.Вставить(ЭлементСвойств.Ключ, ЭлементСвойств.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Свойства;

КонецФункции

// Документы вложений по договору одним пакетным запросом: КС-2, отчеты комитенту
// и корректировочные КС-2 с условием ДоговорКонтрагента = &Договор, не помеченные
// на удаление (проведенные и непроведенные); для корректировочных - документ-
// основание с номером и датой. ДоговорКонтрагента в этих документах не
// индексирован (выгрузка БИТ), просмотр таблиц - цена одного запроса на ручной
// запуск по кнопке (спека п. «Производительность»).
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов - договор запуска.
//
// Возвращаемое значение:
//  Соответствие - код шага -> Массив из Структура {Ссылка, Номер, Дата,
//  Основание, НомерОснования, ДатаОснования}.
//
Функция ДокументыВложенийПоДоговору(Знач Договор)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	""ks2"" КАК КодШага,
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.Номер КАК Номер,
		|	Документы.Дата КАК Дата,
		|	ЗНАЧЕНИЕ(Документ.бит_стр_АктОПриемкеВыполненныхРабот_КС2.ПустаяСсылка) КАК Основание,
		|	"""" КАК НомерОснования,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОснования
		|ИЗ
		|	Документ.бит_стр_АктОПриемкеВыполненныхРабот_КС2 КАК Документы
		|ГДЕ
		|	Документы.ДоговорКонтрагента = &Договор
		|	И НЕ Документы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""commission_reports"",
		|	Документы.Ссылка,
		|	Документы.Номер,
		|	Документы.Дата,
		|	ЗНАЧЕНИЕ(Документ.бит_стр_АктОПриемкеВыполненныхРабот_КС2.ПустаяСсылка),
		|	"""",
		|	ДАТАВРЕМЯ(1, 1, 1)
		|ИЗ
		|	Документ.ОтчетКомитентуОПродажах КАК Документы
		|ГДЕ
		|	Документы.ДоговорКонтрагента = &Договор
		|	И НЕ Документы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ks2_corrections"",
		|	Документы.Ссылка,
		|	Документы.Номер,
		|	Документы.Дата,
		|	Документы.ДокументОснование,
		|	Документы.ДокументОснование.Номер,
		|	Документы.ДокументОснование.Дата
		|ИЗ
		|	Документ.sd_КорректировочныйАктОПриемкеВыполненныхРабот_КС2 КАК Документы
		|ГДЕ
		|	Документы.ДоговорКонтрагента = &Договор
		|	И НЕ Документы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Договор", Договор);

	СтрокиПоВидам = Новый Соответствие;
	Для Каждого ВидШага Из ВидыШаговВложений() Цикл
		СтрокиПоВидам.Вставить(ВидШага, Новый Массив);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиВида = СтрокиПоВидам.Получить(Выборка.КодШага);
		Если СтрокиВида <> Неопределено Тогда
			СтрокаДокумента = Новый Структура("Ссылка, Номер, Дата, Основание, НомерОснования, ДатаОснования",
				Выборка.Ссылка, Выборка.Номер, Выборка.Дата, Выборка.Основание,
				Выборка.НомерОснования, Выборка.ДатаОснования);
			СтрокиВида.Добавить(СтрокаДокумента);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрокиПоВидам;

КонецФункции

// Вид документа для представлений журнала по коду шага вложений.
//
// Параметры:
//  КодШага - Строка - код шага вложений.
//
// Возвращаемое значение:
//  Строка - вид документа («КС-2», «Отчет комитенту», «Корректировочный КС-2»).
//
Функция ВидДокументаШага(Знач КодШага)

	Если КодШага = КодШагаКС2() Тогда
		Возврат "КС-2";
	ИначеЕсли КодШага = КодШагаОтчетовКомитенту() Тогда
		Возврат НСтр("ru = 'Отчет комитенту'");
	ИначеЕсли КодШага = КодШагаКорректировочныхКС2() Тогда
		Возврат НСтр("ru = 'Корректировочный КС-2'");
	Иначе
		Возврат КодШага;
	КонецЕсли;

КонецФункции

// Представление документа для журнала: «<Вид> № <Номер> от <Дата>»
// (спека п.3 «журнал работы»).
//
// Параметры:
//  ВидДокумента - Строка - вид документа.
//  Номер        - Строка - номер документа.
//  Дата         - Дата   - дата документа.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция ПредставлениеДокументаЖурнала(Знач ВидДокумента, Знач Номер, Знач Дата)

	Возврат СтрШаблон("%1 %2 %3 от %4", ВидДокумента, НСтр("ru = '№'"), СокрЛП(Номер),
		Формат(Дата, "ДФ=dd.MM.yyyy"));

КонецФункции

// Префикс имени файла вложения: «№ <Номер> от <ДД.ММ.ГГГГ> - »
// (номер и дата документа в имени файла, спека п.3).
//
// Параметры:
//  Номер - Строка - номер документа.
//  Дата  - Дата   - дата документа.
//
// Возвращаемое значение:
//  Строка - префикс имени файла (с завершающим разделителем).
//
Функция ПрефиксИмениФайлаДокумента(Знач Номер, Знач Дата)

	Возврат СтрШаблон("%1 %2 от %3 - ", НСтр("ru = '№'"), СокрЛП(Номер), Формат(Дата, "ДФ=dd.MM.yyyy"));

КонецФункции

// Имя файла вложения: «<Префикс><имя>.<расш>» с очисткой недопустимых символов;
// имя файла обрезается так, чтобы полный путь был не длиннее 250 символов,
// расширение сохраняется (спека п.3 «имена»).
//
// Параметры:
//  КаталогПапки - Строка - папка шага.
//  ПрефиксИмени - Строка - префикс (номер и дата документа).
//  Наименование - Строка - наименование присоединенного файла.
//  Расширение   - Строка - расширение файла (без точки).
//
// Возвращаемое значение:
//  Строка - имя файла (без каталога).
//
Функция ИмяФайлаВложения(Знач КаталогПапки, Знач ПрефиксИмени, Знач Наименование, Знач Расширение)

	РасширениеСТочкой = "";
	Если Не ПустаяСтрока(Расширение) Тогда
		РасширениеСТочкой = "." + СокрЛП(Расширение);
	КонецЕсли;

	ИмяБезРасширения = СокрЛП(Наименование);
	Если ПустаяСтрока(ИмяБезРасширения) Тогда
		ИмяБезРасширения = НСтр("ru = 'файл'");
	КонецЕсли;

	ДоступноИмени = МаксимальнаяДлинаПути() - СтрДлина(КаталогПапки) - 1
		- СтрДлина(ПрефиксИмени) - СтрДлина(РасширениеСТочкой);
	Если СтрДлина(ИмяБезРасширения) > ДоступноИмени Тогда
		Если ДоступноИмени > 0 Тогда
			ИмяБезРасширения = Лев(ИмяБезРасширения, ДоступноИмени);
		Иначе
			ИмяБезРасширения = НСтр("ru = 'файл'");
		КонецЕсли;
	КонецЕсли;

	Возврат ОчиститьИмяФайла(ПрефиксИмени + ИмяБезРасширения + РасширениеСТочкой);

КонецФункции

// Путь файла относительно подкаталога договора (для журнала).
//
// Параметры:
//  ПутьФайла           - Строка - полный путь файла.
//  КаталогПодкаталога - Строка - подкаталог договора.
//
// Возвращаемое значение:
//  Строка - относительный путь.
//
Функция ИмяФайлаОтносительноКаталога(Знач ПутьФайла, Знач КаталогПодкаталога)

	РазделительКаталогов = "\";
	Если СтрНачинаетсяС(ПутьФайла, КаталогПодкаталога + РазделительКаталогов) Тогда
		// Сред возвращает с единицы - пропускаем каталог и разделитель.
		НачалоОтносительногоПути = СтрДлина(КаталогПодкаталога) + СтрДлина(РазделительКаталогов) + 1;
		Возврат Сред(ПутьФайла, НачалоОтносительногоПути);
	КонецЕсли;
	Возврат ПутьФайла;

КонецФункции

// Имя исходного файла для журнала: наименование с расширением.
//
// Параметры:
//  СвойстваФайла - Структура, Неопределено - {Наименование, Расширение}.
//
// Возвращаемое значение:
//  Строка - имя исходного файла.
//
Функция ИмяИсходногоФайла(Знач СвойстваФайла)

	Если СвойстваФайла = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Наименование = СокрЛП(СвойстваФайла.Наименование);
	Расширение = СокрЛП(СвойстваФайла.Расширение);
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Наименование;
	КонецЕсли;
	Если ПустаяСтрока(Расширение) Тогда
		Возврат Наименование;
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(НРег(Наименование), "." + НРег(Расширение)) Тогда
		Возврат Наименование;
	КонецЕсли;
	Возврат Наименование + "." + Расширение;

КонецФункции

// Очищает имя файла/каталога от недопустимых символов (БСП) и краевых пробелов.
//
// Параметры:
//  Имя - Строка - исходное имя.
//
// Возвращаемое значение:
//  Строка - очищенное имя.
//
Функция ОчиститьИмяФайла(Знач Имя)

	Очищенное = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Имя, "-");
	Возврат СокрЛП(Очищенное);

КонецФункции

