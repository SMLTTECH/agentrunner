// Имя шага для журнала по коду шага ответа (спека п.3 «журнал работы»).
//
// Параметры:
//  КодШага - Строка - код шага (reconciliation_act, payment_report, ks2,
//             commission_reports, ks2_corrections).
//
// Возвращаемое значение:
//  Строка - имя шага журнала.
//
Функция ИмяШагаЖурнала(Знач КодШага)

	Если КодШага = КодШагаАктаСверки() Тогда
		Возврат НСтр("ru = 'Акт сверки'");
	ИначеЕсли КодШага = КодШагаОтчетаПлатежных() Тогда
		Возврат НСтр("ru = 'Отчет по платежным поручениям'");
	ИначеЕсли КодШага = КодШагаКС2() Тогда
		Возврат "КС-2";
	ИначеЕсли КодШага = КодШагаОтчетовКомитенту() Тогда
		Возврат НСтр("ru = 'Отчеты комитенту'");
	ИначеЕсли КодШага = КодШагаКорректировочныхКС2() Тогда
		Возврат НСтр("ru = 'Корректировочные КС-2'");
	Иначе
		Возврат КодШага;
	КонецЕсли;

КонецФункции

// Имя папки вложений шага в подкаталоге договора (спека п.3 «вложения»).
//
// Параметры:
