#Область ПрограммныйИнтерфейс

// Внешняя дополнительная обработка «Обслуживание служебных данных AgentRunner»
// (задача agentrunner-312, спека v5).
//
// Останавливает рост регистров ar_СлужебныйЛог и ar_Сессии на базах, где
// расширение AgentRunner нельзя обновить, и показывает администратору объемы и
// настройки. Два независимых действия:
//  1. Очистка ar_Сессии тактом - только по расписанию или кнопкой: сессии,
//     у которых ar_Обновлена старше ar_СессияTTLДней + запас;
//  2. Выгрузка и очистка ar_СлужебныйЛог кнопкой из формы: журнал пишется
//     в zip-файлы на компьютере администратора (JSON Lines), затем регистр
//     одной командой заменяется оставляемыми записями. Порционное удаление
//     журнала не используется: на проде 12 млн записей, тактом оно не успевает.
//
// Обращения к объектам ar_* - только по имени строкой после проверки в
// Метаданные, вызовов модулей ar_* нет: при отключенном расширении действия
// завершаются записью в журнал регистрации.
//
// Настройки общие - ХранилищеНастроек элемента справочника
// ДополнительныеОтчетыИОбработки. Код их только читает: запись элемента каждые
// сутки конфликтовала бы с формой карточки. Итог каждого действия - журнал
// регистрации, событие «AgentRunner.Обслуживание служебных данных».
//
// Права на регистры ar_* есть только у роли расширения, поэтому чтение и удаление
// идут в привилегированном режиме. Форма доступна только полноправному
// пользователю, проверка - до подъема привилегий, в каждой серверной функции
// обработки. Команду по расписанию вызывает задание БСП, пользователь задания
// задается в карточке обработки.
//
// БезопасныйРежим = Ложь: иначе платформа запрещает привилегированный режим.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки».
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: обслуживание служебных данных'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Выгрузка журнала ar_СлужебныйЛог в файлы
		|и очистка регистра одной командой, очистка ar_Сессии по расписанию, диагностика объемов.
		|Порядок внедрения: 1) регистрация полноправным пользователем, при профилях безопасности разрешить
		|небезопасный режим; 2) диагностика и предпросмотр, цифры сохранить; 3) штатная резервная копия;
		|4) ночью в тонком клиенте выгрузить и очистить журнал кнопкой (форма открыта, компьютер не спит);
		|5) включить режим и задать расписание очистки ar_Сессии на ночь после 03:00; 6) обслуживание таблиц -
		|силами администратора СУБД, диск сам не освободится. Откат - не запускать кнопку и выключить режим.'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	// Очистка ar_Сессии по расписанию - расписание задает администратор в карточке обработки.
	КомандаТакта = ПараметрыРегистрации.Команды.Добавить();
	КомандаТакта.Представление        = НСтр("ru = 'AgentRunner Пакет инструментов: Очистка регистра сведений ar_Сессии'");
	КомандаТакта.Идентификатор        = ИдентификаторКомандыТакта();
	КомандаТакта.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаТакта.ПоказыватьОповещение = Ложь;

	// Форма настроек, предпросмотра, выгрузки журнала, ручного такта и диагностики.
	КомандаФормы = ПараметрыРегистрации.Команды.Добавить();
	КомандаФормы.Представление        = НСтр("ru = 'AgentRunner: обслуживание служебных данных'");
	КомандаФормы.Идентификатор        = "ОткрытьФормуНастроек";
	КомандаФормы.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	КомандаФормы.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП «Дополнительные отчеты и обработки». Ошибки такта не
// роняют регламентное задание: такт перехватывает их и пишет в журнал регистрации.
//
// Параметры:
//  ИдентификаторКоманды       - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП
//                               (ДополнительнаяОбработкаСсылка - элемент
//                               справочника этой обработки).
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = ИдентификаторКомандыТакта() Тогда
		СсылкаОбработки = Неопределено;
		Если ТипЗнч(ПараметрыВыполненияКоманды) = Тип("Структура") Тогда
			ПараметрыВыполненияКоманды.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки);
		КонецЕсли;
		ТактОбслуживания(0, СсылкаОбработки);
	КонецЕсли;

КонецПроцедуры

// Ручной такт из формы: предел времени 5 минут независимо от настроек, потому
// что серверный вызов формы не должен ждать полчаса.
//
// Возвращаемое значение:
//  Строка - итог такта для показа в форме.
//
Функция РучнойТакт() Экспорт

	ПроверитьПолныеПрава();
	Итог = ТактОбслуживания(ПределРучногоТактаМинут(), Неопределено);
	Возврат ТекстИтогаТакта(Итог);

КонецФункции

// Проверка полных прав текущего пользователя. Привилегированный режим не
// учитывается: право нельзя получить из самого кода обработки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПолныеПрава() Экспорт

	Возврат Пользователи.ЭтоПолноправныйПользователь(, , Ложь);

КонецФункции

// Проверка регистрации обработки в справочнике «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
//  Булево - Истина - элемент найден.
//
Функция ОбработкаЗарегистрирована() Экспорт

	ПроверитьПолныеПрава();
	Возврат ЗначениеЗаполнено(НайденныйЭлементОбработки(Неопределено));

КонецФункции

// Настройки обработки из ХранилищеНастроек элемента справочника
// ДополнительныеОтчетыИОбработки.
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки,
//                    Неопределено - поиск элемента по имени объекта.
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию.
//
Функция НастройкиОбработки(Знач СсылкаОбработки = Неопределено) Экспорт

	Итог = НастройкиПоУмолчанию();
	Сохраненные = ХранилищеНастроекОбработки(СсылкаОбработки);
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Итог, Сохраненные);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Проверка диапазонов настроек.
//
// Параметры:
//  Настройки - Структура - см. НастройкиПоУмолчанию.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Поле  - Строка - имя настройки.
//   * Текст - Строка - текст ошибки.
//
Функция ОшибкиНастроек(Знач Настройки) Экспорт

	Ошибки = Новый Массив;
	Для Каждого Диапазон Из ДиапазоныНастроек() Цикл
		Значение = Настройки[Диапазон.Поле];
		Если Значение < Диапазон.Минимум ИЛИ Значение > Диапазон.Максимум Тогда
			Ошибки.Добавить(Новый Структура("Поле, Текст", Диапазон.Поле,
				СтрШаблон(НСтр("ru = '%1: допустимо от %2 до %3.'"), Диапазон.Представление,
					Формат(Диапазон.Минимум, "ЧГ=0"), Формат(Диапазон.Максимум, "ЧГ=0"))));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Сохранение настроек (форма) в ХранилищеНастроек элемента справочника
// ДополнительныеОтчетыИОбработки. Изменение режима - запись в журнал регистрации.
//
// Параметры:
//  Настройки - Структура - см. НастройкиПоУмолчанию; диапазоны проверены
//              функцией ОшибкиНастроек.
//
Процедура СохранитьНастройки(Знач Настройки) Экспорт

	ПроверитьПолныеПрава();
	Если ОшибкиНастроек(Настройки).Количество() > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Значения настроек вне допустимого диапазона.'");
	КонецЕсли;

	ЭлементСправочника = НайденныйЭлементОбработки(Неопределено);
	Если НЕ ЗначениеЗаполнено(ЭлементСправочника) Тогда
		ВызватьИсключение НСтр("ru = 'Настройки не сохранены: обработка не зарегистрирована
			|в справочнике «Дополнительные отчеты и обработки».'");
	КонецЕсли;
	Прежние = НастройкиОбработки(ЭлементСправочника);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбъектЭлемента = ЭлементСправочника.ПолучитьОбъект();
		ОбъектЭлемента.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
		ОбъектЭлемента.ОбменДанными.Загрузка = Истина;
		ОбъектЭлемента.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Настройки не сохранены: '") + ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Прежние.РежимВключен <> Настройки.РежимВключен Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Режим: %1 (было: %2), пользователь: %3'"),
			РежимСтрокой(Настройки.РежимВключен), РежимСтрокой(Прежние.РежимВключен), ИмяПользователя());
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Информация, , , ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Параметры запуска выгрузки и очистки журнала: момент начала, счетчики записей
// и параметры частей по сохраненным настройкам. Ничего не удаляет. Вызывается
// формой до вопроса пользователю.
//
// Возвращаемое значение:
//  Структура:
//   * Причина              - Строка - причина отказа, пустая - можно продолжать.
//   * МоментНачала         - Дата.
//   * Было                 - Число - всего записей регистра.
//   * КВыгрузке            - Число - записей уйдет в файлы (без отладочных, если
//                            настройка «Выгружать debug_*» снята).
//   * Останется            - Число - записей останется в регистре.
//   * РазмерЧасти          - Число - записей в одном файле.
//   * ВыгружатьОтладку     - Булево.
//   * МаксимальноОставляемых - Число - предел оставляемых записей.
//
Функция ПараметрыОчисткиЖурнала() Экспорт

	ПроверитьПолныеПрава();

	Настройки = НастройкиОбработки();
	Итог = Новый Структура;
	Итог.Вставить("Причина", "");
	Итог.Вставить("МоментНачала", Дата(1, 1, 1));
	Итог.Вставить("Было", 0);
	Итог.Вставить("КВыгрузке", 0);
	Итог.Вставить("Останется", 0);
	Итог.Вставить("РазмерЧасти", Настройки.ЗаписейВФайлеЖурнала);
	Итог.Вставить("ВыгружатьОтладку", Настройки.ВыгружатьОтладку);
	Итог.Вставить("МаксимальноОставляемых", МаксимальноОставляемыхЗаписей());

	Если НЕ РегистрДоступен(ИмяРегистраЛога()) Тогда
		Итог.Причина = НСтр("ru = 'Регистр сведений ar_СлужебныйЛог недоступен: расширение AgentRunner отключено.'");
		Возврат Итог;
	КонецЕсли;

	Итог.МоментНачала = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаОкна", ГраницаОкнаЖурнала(Итог.МоментНачала, Настройки));
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ВсегоЗаписей,
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА %2 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Отладочных
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|;
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Оставляемых
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|ГДЕ
		|	%3", ИмяРегистраЛога(), УсловиеОтладочнойЗаписи(), УсловиеОставляемыхЗаписей());

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Итоги = Результаты[0].Выбрать();
	Итоги.Следующий();
	Оставляемые = Результаты[1].Выбрать();
	Оставляемые.Следующий();

	Итог.Было      = Итоги.ВсегоЗаписей;
	Итог.КВыгрузке = ?(Настройки.ВыгружатьОтладку, Итоги.ВсегоЗаписей, Итоги.ВсегоЗаписей - Итоги.Отладочных);
	Итог.Останется = Оставляемые.Оставляемых;

	Возврат Итог;

КонецФункции

// Одна часть журнала для выгрузки: записи с ar_ЗаписьId больше переданного
// ключа, по настройке без отладочных, упакованные в zip-архив. Временный файл
// удаляется на всех ветках, клиенту передается только архив.
//
// Параметры:
//  ПоследнийКлюч   - Строка - ключ последней записи предыдущей части, "" - с начала.
//  РазмерЧасти     - Число  - записей в части.
//  ВыгружатьОтладку - Булево - выгружать записи уровня «Отладка» и debug_*.
//
// Возвращаемое значение:
//  Структура:
//   * Данные       - ДвоичныеДанные - zip с одним файлом JSON Lines (UTF-8).
//   * ПоследнийКлюч - Строка - ключ последней записи части, "" - записей нет.
//   * Записей      - Число.
//
Функция ЧастьЖурналаДляВыгрузки(Знач ПоследнийКлюч, Знач РазмерЧасти, Знач ВыгружатьОтладку) Экспорт

	ПроверитьПолныеПрава();
	Если НЕ РегистрДоступен(ИмяРегистраЛога()) Тогда
		ВызватьИсключение НСтр("ru = 'Регистр сведений ar_СлужебныйЛог недоступен: расширение AgentRunner отключено.'");
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапросаЧастиЖурнала(РазмерЧасти, ВыгружатьОтладку));
	Запрос.УстановитьПараметр("ПоследнийКлюч", ПоследнийКлюч);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Итог = АрхивВыборкиЖурнала(Выборка);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Итог;

КонецФункции

// Хвост выгрузки: записи с ar_Момент не раньше момента начала - все, что
// появилось в регистре за время выгрузки. Дубли с основной выгрузкой допустимы:
// это записи, которые останутся в регистре. Фильтр отладочных - как в основной
// выгрузке.
//
// Параметры:
//  МоментНачала    - Дата - момент начала выгрузки.
//  ВыгружатьОтладку - Булево.
//
// Возвращаемое значение:
//  Структура - см. ЧастьЖурналаДляВыгрузки.
//
Функция ХвостЖурналаДляВыгрузки(Знач МоментНачала, Знач ВыгружатьОтладку) Экспорт

	ПроверитьПолныеПрава();
	Если НЕ РегистрДоступен(ИмяРегистраЛога()) Тогда
		ВызватьИсключение НСтр("ru = 'Регистр сведений ar_СлужебныйЛог недоступен: расширение AgentRunner отключено.'");
	КонецЕсли;

	Условие = "Т.ar_Момент >= &МоментНачала";
	Если НЕ ВыгружатьОтладку Тогда
		Условие = Условие + "
			|	И НЕ (" + УсловиеОтладочнойЗаписи() + ")";
	КонецЕсли;

	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	Т.ar_ЗаписьId КАК ar_ЗаписьId,
		|	Т.ar_Момент КАК ar_Момент,
		|	Т.ar_Источник КАК ar_Источник,
		|	Т.ar_Событие КАК ar_Событие,
		|	Т.ar_Уровень КАК ar_Уровень,
		|	Т.ar_RunId КАК ar_RunId,
		|	Т.ar_ОбъектСсылка КАК ar_ОбъектСсылка,
		|	Т.ar_Текст КАК ar_Текст
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|ГДЕ
		|	%2
		|УПОРЯДОЧИТЬ ПО
		|	Т.ar_ЗаписьId", ИмяРегистраЛога(), Условие));
	Запрос.УстановитьПараметр("МоментНачала", МоментНачала);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Итог = АрхивВыборкиЖурнала(Выборка);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Итог;

КонецФункции

// Замена регистра журнала оставляемыми записями одной командой. Оставляемые
// записи читаются в набор вне транзакции, замена - в транзакции: при ошибке
// откат, регистр остается как был. Записи, появившиеся между чтением и заменой,
// теряются: окно в секунды, запись в этот лог и так best-effort.
//
// Параметры:
//  МоментНачала - Дата - момент начала выгрузки, от него отсчитывается окно
//                 настройки «Оставлять записи журнала, часов».
//
// Возвращаемое значение:
//  Структура:
//   * Оставлено - Число - записей записано в регистр.
//   * Стало     - Число - записей в регистре после замены.
//
Функция ЗаменитьЖурналОставляемыми(Знач МоментНачала) Экспорт

	ПроверитьПолныеПрава();
	Если НЕ РегистрДоступен(ИмяРегистраЛога()) Тогда
		ВызватьИсключение НСтр("ru = 'Регистр сведений ar_СлужебныйЛог недоступен: расширение AgentRunner отключено.'");
	КонецЕсли;

	Настройки = НастройкиОбработки();
	Если КоличествоОставляемыхЗаписей(ГраницаОкнаЖурнала(МоментНачала, Настройки)) > МаксимальноОставляемыхЗаписей() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Оставляемых записей больше %1: уменьшите окно
			|«Оставлять записи журнала, часов» и повторите.'"),
			Формат(МаксимальноОставляемыхЗаписей(), "ЧГ=0"));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаОкна", ГраницаОкнаЖурнала(МоментНачала, Настройки));
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	Т.ar_ЗаписьId КАК ar_ЗаписьId,
		|	Т.ar_Момент КАК ar_Момент,
		|	Т.ar_Источник КАК ar_Источник,
		|	Т.ar_Событие КАК ar_Событие,
		|	Т.ar_Уровень КАК ar_Уровень,
		|	Т.ar_RunId КАК ar_RunId,
		|	Т.ar_ОбъектСсылка КАК ar_ОбъектСсылка,
		|	Т.ar_Текст КАК ar_Текст
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|ГДЕ
		|	%2", ИмяРегистраЛога(), УсловиеОставляемыхЗаписей());

	Набор = РегистрыСведений[ИмяРегистраЛога()].СоздатьНаборЗаписей();
	Оставлено = 0;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = Набор.Добавить();
			Запись.ar_ЗаписьId    = Выборка.ar_ЗаписьId;
			Запись.ar_Момент      = Выборка.ar_Момент;
			Запись.ar_Источник    = Выборка.ar_Источник;
			Запись.ar_Событие     = Выборка.ar_Событие;
			Запись.ar_Уровень     = Выборка.ar_Уровень;
			Запись.ar_RunId       = Выборка.ar_RunId;
			Запись.ar_ОбъектСсылка = Выборка.ar_ОбъектСсылка;
			Запись.ar_Текст       = Выборка.ar_Текст;
			Оставлено = Оставлено + 1;
		КонецЦикла;

		НачатьТранзакцию();
		Попытка
			Набор.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
				НСтр("ru = 'Замена регистра сведений ar_СлужебныйЛог не выполнена: '")
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;

		Стало = КоличествоЗаписейРегистра(ИмяРегистраЛога());
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Новый Структура("Оставлено, Стало", Оставлено, Стало);

КонецФункции

// Итог очистки журнала: счетчик «стало», текст итога и запись в журнал
// регистрации. Вызывается формой при любом завершении выгрузки - выполнено,
// отменено или остановлено: счет «после» нужен и тогда.
//
// Параметры:
//  Было           - Число  - записей в регистре на момент начала (из ПараметрыОчисткиЖурнала).
//  Выгружено      - Число  - записей во всех файлах.
//  Файлов         - Число  - записано zip-файлов.
//  СекундВсего    - Число  - время всего запуска.
//  СекундВыгрузки - Число  - время выгрузки частей и хвоста.
//  СекундЗамены   - Число  - время замены регистра.
//  Оставлено      - Число  - записей оставлено (0, если замены не было).
//  Состояние      - Строка - «выполнено» или причина остановки.
//
// Возвращаемое значение:
//  Строка - текст итога для показа в форме.
//
Функция ИтогОчисткиЖурнала(Знач Было, Знач Выгружено, Знач Файлов, Знач СекундВсего,
	Знач СекундВыгрузки, Знач СекундЗамены, Знач Оставлено, Знач Состояние) Экспорт

	ПроверитьПолныеПрава();
	Стало = КоличествоЗаписейРегистра(ИмяРегистраЛога());
	Текст = ТекстИтогаОчисткиЖурнала(Было, Стало, Выгружено, Файлов, СекундВсего,
		СекундВыгрузки, СекундЗамены, Оставлено, Состояние);
	ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Информация, , , Текст);
	Возврат Текст;

КонецФункции

// Количество записей по каждому действию, ничего не удаляет. Предпросмотр
// берет сохраненные настройки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Шаг (Строка), Записей (Строка), Граница (Строка).
//
Функция Предпросмотр() Экспорт

	ПроверитьПолныеПрава();

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Шаг", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Записей", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Граница", Новый ОписаниеТипов("Строка"));

	Настройки = НастройкиОбработки();
	Момент = ТекущаяДатаСеанса();
	ГраницаСессий = Момент - (СрокЖизниСессииДней() + Настройки.ЗапасСессийДней) * 86400;

	СтрокаСессий = Таблица.Добавить();
	СтрокаСессий.Шаг = НСтр("ru = 'Сессии к удалению (очистка ar_Сессии)'");
	СтрокаСессий.Граница = Формат(ГраницаСессий, "ДЛФ=DT");

	СтрокаВыгрузки = Таблица.Добавить();
	СтрокаВыгрузки.Шаг = НСтр("ru = 'Записи журнала к выгрузке (ar_СлужебныйЛог)'");
	СтрокаВыгрузки.Граница = ?(Настройки.ВыгружатьОтладку,
		НСтр("ru = 'весь журнал'"), НСтр("ru = 'весь журнал, кроме отладочных'"));

	СтрокаОстатка = Таблица.Добавить();
	СтрокаОстатка.Шаг = НСтр("ru = 'Записи журнала, которые останутся'");
	СтрокаОстатка.Граница = НСтр("ru = 'не старее '") + Формат(ГраницаОкнаЖурнала(Момент, Настройки), "ДЛФ=DT");

	ТекстыЗапросов = Новый Массив;
	Индексы = Новый Массив;
	Запрос = Новый Запрос;

	Если РегистрДоступен(ИмяРегистраСессий()) Тогда
		Запрос.УстановитьПараметр("ГраницаСессий", ГраницаСессий);
		ТекстыЗапросов.Добавить(СтрШаблон(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Записей ИЗ РегистрСведений.%1 КАК Т ГДЕ Т.ar_Обновлена < &ГраницаСессий",
			ИмяРегистраСессий()));
		Индексы.Добавить(Таблица.Индекс(СтрокаСессий));
	Иначе
		СтрокаСессий.Записей = НСтр("ru = 'расширение недоступно'");
	КонецЕсли;

	Если РегистрДоступен(ИмяРегистраЛога()) Тогда
		Запрос.УстановитьПараметр("ГраницаОкна", ГраницаОкнаЖурнала(Момент, Настройки));
		УсловиеВыгрузки = "ИСТИНА";
		Если НЕ Настройки.ВыгружатьОтладку Тогда
			УсловиеВыгрузки = "НЕ (" + УсловиеОтладочнойЗаписи() + ")";
		КонецЕсли;
		ТекстыЗапросов.Добавить(СтрШаблон("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Записей ИЗ РегистрСведений.%1 КАК Т ГДЕ %2",
			ИмяРегистраЛога(), УсловиеВыгрузки));
		Индексы.Добавить(Таблица.Индекс(СтрокаВыгрузки));
		ТекстыЗапросов.Добавить(СтрШаблон("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Записей ИЗ РегистрСведений.%1 КАК Т ГДЕ %2",
			ИмяРегистраЛога(), УсловиеОставляемыхЗаписей()));
		Индексы.Добавить(Таблица.Индекс(СтрокаОстатка));
	Иначе
		СтрокаВыгрузки.Записей = НСтр("ru = 'расширение недоступно'");
		СтрокаОстатка.Записей = НСтр("ru = 'расширение недоступно'");
	КонецЕсли;

	Если ТекстыЗапросов.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ";" + Символы.ПС);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Для Номер = 0 По Результаты.ВГраница() Цикл
		Выборка = Результаты[Номер].Выбрать();
		Выборка.Следующий();
		Таблица[Индексы[Номер]].Записей = ЧислоСтрокой(Выборка.Записей);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Диагностика, только чтение: журнал, запуски, размеры таблиц, сессии, константы,
// провайдеры, агенты, рутины.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Раздел, Показатель, Значение, Примечание (Строка).
//
Функция Диагностика() Экспорт

	ПроверитьПолныеПрава();

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Раздел,Показатель,Значение,Примечание", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка"));
	КонецЦикла;

	Если НЕ РасширениеДоступно() Тогда
		ДобавитьПоказатель(Таблица, НСтр("ru = 'Расширение'"), "AgentRunner", НСтр("ru = 'недоступно'"));
		Возврат Таблица;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ДобавитьПоказателиЖурнала(Таблица);
		ДобавитьПоказателиЗапусков(Таблица);
		ДобавитьРазмерыТаблиц(Таблица);
		ДобавитьПоказателиСессий(Таблица);
		ДобавитьКонстанты(Таблица);
		ДобавитьПоказателиСправочников(Таблица);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТактСессий

// Один такт очистки сессий. Ошибка не выходит наружу: она записана в журнал
// регистрации и в итог. Счет «после» берется и при ошибке, «до» - только если
// такт дошел до удалений.
//
// Параметры:
//  ПределМинут     - Число - предел времени; 0 - из настроек.
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки, Неопределено.
//
// Возвращаемое значение:
//  Структура - см. НовыйИтогТакта.
//
Функция ТактОбслуживания(Знач ПределМинут, Знач СсылкаОбработки)

	Итог = НовыйИтогТакта();
	Попытка
		ВыполнитьТакт(Итог, ПределМинут, СсылкаОбработки);
	Исключение
		Итог.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Итог.Выполнен Тогда
			Итог.Конец = ТекущаяДатаСеанса();
			Итог.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Итог.НачалоМс) / 1000;
			Итог.Стало = КоличествоЗаписейРегистра(ИмяРегистраСессий());
			Итог.Очищено = РазностьСчетчиков(Итог.Было, Итог.Стало);
		КонецЕсли;
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстИтогаТакта(Итог));
	КонецПопытки;
	Возврат Итог;

КонецФункции

// Проверки такта и удаление сессий порциями, пока не исчерпан предел времени.
// Время проверяется между порциями, оставшееся доделает следующий такт.
Процедура ВыполнитьТакт(Итог, Знач ПределМинут, Знач СсылкаОбработки)

	ЭлементСправочника = НайденныйЭлементОбработки(СсылкаОбработки);
	Если НЕ ЗначениеЗаполнено(ЭлементСправочника) Тогда
		ПропуститьТакт(Итог, НСтр("ru = 'Такт пропущен: обработка не найдена в справочнике
			|«Дополнительные отчеты и обработки».'"));
		Возврат;
	КонецЕсли;

	Настройки = НастройкиОбработки(ЭлементСправочника);
	Если НЕ Настройки.РежимВключен Тогда
		ПропуститьТакт(Итог, НСтр("ru = 'Такт пропущен: режим выключен.'"));
		Возврат;
	КонецЕсли;

	Если НЕ РасширениеДоступно() Тогда
		ПропуститьТакт(Итог, НСтр("ru = 'Такт пропущен: расширение AgentRunner недоступно.'"));
		Возврат;
	КонецЕсли;

	Если ПределМинут = 0 Тогда
		ПределМинут = Настройки.ПределМинут;
	КонецЕсли;

	Итог.Выполнен = Истина;
	Итог.Начало = ТекущаяДатаСеанса();
	Итог.НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Такт начат: очистка регистра сведений ar_Сессии, предел %1 мин, порция %2.'"),
			Формат(ПределМинут, "ЧГ=0"), Формат(Настройки.РазмерПорцииСессий, "ЧГ=0")));

	Итог.Было = КоличествоЗаписейРегистра(ИмяРегистраСессий());
	Граница = Итог.Начало - (СрокЖизниСессииДней() + Настройки.ЗапасСессийДней) * 86400;
	ОкончаниеМс = Итог.НачалоМс + ПределМинут * 60000;

	УдалитьПорцииСессий(Граница, Настройки.РазмерПорцииСессий, ОкончаниеМс, Итог);

	Итог.Конец = ТекущаяДатаСеанса();
	Итог.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Итог.НачалоМс) / 1000;
	Итог.Стало = КоличествоЗаписейРегистра(ИмяРегистраСессий());
	Итог.Очищено = РазностьСчетчиков(Итог.Было, Итог.Стало);
	ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Информация, , ,
		ТекстИтогаТакта(Итог));

КонецПроцедуры

// Такт не идет: причина в итог и в журнал регистрации.
Процедура ПропуститьТакт(Итог, Знач Причина)

	Итог.Причина = Причина;
	ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Информация, , , Причина);

КонецПроцедуры

// Порции сессий. Цикл завершается, когда порция неполная (записей больше нет) или
// в полной порции не удалено ни одной записи (записи обновились после выборки):
// повторов по одним и тем же записям нет.
Процедура УдалитьПорцииСессий(Знач Граница, Знач РазмерПорции, Знач ОкончаниеМс, Итог)

	Запрос = Новый Запрос(ТекстЗапросаПорцииСессий(РазмерПорции));
	Запрос.УстановитьПараметр("Граница", Граница);

	Пока Истина Цикл

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= ОкончаниеМс Тогда
			Итог.ОстановленПоПределу = Истина;
			Прервать;
		КонецЕсли;

		Выбрано = 0;
		Удалено = УдалитьПорциюСессий(Запрос, Граница, Выбрано);

		Если Выбрано < РазмерПорции ИЛИ Удалено = 0 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Одна порция: ключи сессий и удаление по ключу, в привилегированном режиме.
//
// Параметры:
//  Запрос  - Запрос - запрос порции, только измерения.
//  Граница - Дата   - граница срока.
//  Выбрано - Число  - выходной параметр: выбрано записей.
//
// Возвращаемое значение:
//  Число - удалено записей.
//
Функция УдалитьПорциюСессий(Знач Запрос, Знач Граница, Выбрано)

	Выбрано = 0;
	Удалено = 0;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Записи = Запрос.Выполнить().Выгрузить();
		Выбрано = Записи.Количество();
		Для Каждого Запись Из Записи Цикл
			Если УдалитьСессию(Запись, Граница) Тогда
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Удалено;

КонецФункции

// Удаление сессии под исключительной блокировкой с повторной проверкой срока:
// запись могла обновиться после выборки порции. Срок читается запросом, а не
// МенеджерЗаписи.Прочитать(): менеджер загрузил бы всю сжатую историю.
//
// Параметры:
//  Запись  - СтрокаТаблицыЗначений - ключ сессии.
//  Граница - Дата - граница срока.
//
// Возвращаемое значение:
//  Булево - Истина - запись удалена.
//
Функция УдалитьСессию(Знач Запись, Знач Граница)

	Удалена = Ложь;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений." + ИмяРегистраСессий());
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ar_Агент", Запись.ar_Агент);
		ЭлементБлокировки.УстановитьЗначение("ar_Якорь", Запись.ar_Якорь);
		Блокировка.Заблокировать();

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Агент", Запись.ar_Агент);
		Запрос.УстановитьПараметр("Якорь", Запись.ar_Якорь);
		Запрос.УстановитьПараметр("Граница", Граница);
		Запрос.Текст = СтрШаблон(
			"ВЫБРАТЬ
			|	1 КАК ЕстьЗапись
			|ИЗ
			|	РегистрСведений.%1 КАК Т
			|ГДЕ
			|	Т.ar_Агент = &Агент
			|	И Т.ar_Якорь = &Якорь
			|	И Т.ar_Обновлена < &Граница", ИмяРегистраСессий());

		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Набор = РегистрыСведений[ИмяРегистраСессий()].СоздатьНаборЗаписей();
			Набор.Отбор.ar_Агент.Установить(Запись.ar_Агент);
			Набор.Отбор.ar_Якорь.Установить(Запись.ar_Якорь);
			Набор.Записать();
			Удалена = Истина;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	Возврат Удалена;

КонецФункции

// Новый итог такта. Было, Стало и Очищено - Неопределено, когда счет не выполнялся
// или закончился ошибкой: в тексте это «нет данных».
//
// Возвращаемое значение:
//  Структура:
//   * Выполнен            - Булево - удаление запускалось.
//   * Причина             - Строка - почему такт пропущен.
//   * Ошибка              - Строка - ошибка такта.
//   * Начало, Конец       - Дата.
//   * НачалоМс, Секунд    - Число  - замер длительности.
//   * ОстановленПоПределу - Булево.
//   * Было, Стало, Очищено - Число, Неопределено.
//
Функция НовыйИтогТакта()

	Итог = Новый Структура;
	Итог.Вставить("Выполнен", Ложь);
	Итог.Вставить("Причина", "");
	Итог.Вставить("Ошибка", "");
	Итог.Вставить("Начало", Дата(1, 1, 1));
	Итог.Вставить("Конец", Дата(1, 1, 1));
	Итог.Вставить("НачалоМс", 0);
	Итог.Вставить("Секунд", 0);
	Итог.Вставить("ОстановленПоПределу", Ложь);
	Итог.Вставить("Было", Неопределено);
	Итог.Вставить("Стало", Неопределено);
	Итог.Вставить("Очищено", Неопределено);
	Возврат Итог;

КонецФункции

// Текст итога такта для журнала регистрации и формы.
//
// Параметры:
//  Итог - Структура - см. НовыйИтогТакта.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстИтогаТакта(Знач Итог)

	Строки = Новый Массив;
	Если НЕ ПустаяСтрока(Итог.Причина) Тогда
		Строки.Добавить(Итог.Причина);
	КонецЕсли;
	Если Итог.Выполнен Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Регистр сведений ar_Сессии: было %1, стало %2, очищено %3, за %4 сек%5'"),
			ЧислоИлиНетДанных(Итог.Было), ЧислоИлиНетДанных(Итог.Стало), ЧислоИлиНетДанных(Итог.Очищено),
			ЧислоИлиНетДанных(Окр(Итог.Секунд)),
			?(Итог.ОстановленПоПределу, НСтр("ru = ', остановлен по пределу времени'"), "")));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Итог.Ошибка) Тогда
		Строки.Добавить(НСтр("ru = 'Ошибка: '") + Итог.Ошибка);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ВыгрузкаЖурнала

// Текст запроса одной части журнала: все поля, отбор по ключу, при снятой
// настройке - без отладочных. ar_ЗаписьId - первое измерение регистра, ведущее
// поле индекса: часть не замедляется к концу прохода. Число - в тексте:
// ПЕРВЫЕ не принимает параметр.
//
// Параметры:
//  РазмерЧасти      - Число  - записей в части.
//  ВыгружатьОтладку - Булево.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаЧастиЖурнала(Знач РазмерЧасти, Знач ВыгружатьОтладку)

	Условие = "Т.ar_ЗаписьId > &ПоследнийКлюч";
	Если НЕ ВыгружатьОтладку Тогда
		Условие = Условие + "
			|	И НЕ (" + УсловиеОтладочнойЗаписи() + ")";
	КонецЕсли;

	Возврат СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	Т.ar_ЗаписьId КАК ar_ЗаписьId,
		|	Т.ar_Момент КАК ar_Момент,
		|	Т.ar_Источник КАК ar_Источник,
		|	Т.ar_Событие КАК ar_Событие,
		|	Т.ar_Уровень КАК ar_Уровень,
		|	Т.ar_RunId КАК ar_RunId,
		|	Т.ar_ОбъектСсылка КАК ar_ОбъектСсылка,
		|	Т.ar_Текст КАК ar_Текст
		|ИЗ
		|	РегистрСведений.%2 КАК Т
		|ГДЕ
		|	%3
		|УПОРЯДОЧИТЬ ПО
		|	Т.ar_ЗаписьId", Формат(РазмерЧасти, "ЧГ=0"), ИмяРегистраЛога(), Условие);

КонецФункции

// Запись выборки журнала в архив: строки JSON Lines во временный файл, файл
// упаковывается в zip, временный файл удаляется на всех ветках. Файл пишется
// без метки BOM: строгий разбор JSON Lines ломается о BOM первой строки.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - записи журнала, все поля.
//
// Возвращаемое значение:
//  Структура - см. ЧастьЖурналаДляВыгрузки.
//
Функция АрхивВыборкиЖурнала(Знач Выборка)

	Данные = Неопределено;
	ПоследнийКлюч = "";
	Записей = 0;

	ИмяФайлаДанных = ПолучитьИмяВременногоФайла("jsonl");
	ЗаписьДанныхФайла = Неопределено;
	Попытка
		ЗаписьДанныхФайла = Новый ЗаписьДанных(ИмяФайлаДанных, КодировкаТекста.UTF8, , , , , Ложь);
		Пока Выборка.Следующий() Цикл
			ЗаписьДанныхФайла.ЗаписатьСтроку(СтрокаЖурналаJSON(Выборка));
			ПоследнийКлюч = Выборка.ar_ЗаписьId;
			Записей = Записей + 1;
		КонецЦикла;
		ЗаписьДанныхФайла.Закрыть();
		ЗаписьДанныхФайла = Неопределено;

		Архив = Новый ЗаписьZipФайла;
		Архив.Добавить(ИмяФайлаДанных);
		Данные = Архив.ПолучитьДвоичныеДанные();
	Исключение
		Если ЗаписьДанныхФайла <> Неопределено Тогда
			ЗаписьДанныхФайла.Закрыть();
		КонецЕсли;
		УдалитьФайлы(ИмяФайлаДанных);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ИмяФайлаДанных);

	Возврат Новый Структура("Данные, ПоследнийКлюч, Записей", Данные, ПоследнийКлюч, Записей);

КонецФункции

// Одна запись журнала строкой JSON: все поля регистра под их именами, дата - ISO,
// переносов строк нет - одна запись занимает одну строку файла (JSON Lines).
// Запись - платформенным ЗаписатьJSON: метода ОбщегоНазначения.ЗначениеВJSON нет в
// библиотеке конфигурации стенда (проверено при сборке 1.1.0).
//
// Параметры:
//  Запись - ВыборкаИзРезультатаЗапроса - запись журнала, все поля.
//
// Возвращаемое значение:
//  Строка - однострочный JSON.
//
Функция СтрокаЖурналаJSON(Знач Запись)

	Поля = Новый Структура(
		"ar_ЗаписьId, ar_Момент, ar_Источник, ar_Событие, ar_Уровень, ar_RunId, ar_ОбъектСсылка, ar_Текст",
		Запись.ar_ЗаписьId, Запись.ar_Момент, Запись.ar_Источник, Запись.ar_Событие,
		Запись.ar_Уровень, Запись.ar_RunId, Запись.ar_ОбъектСсылка, Запись.ar_Текст);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Поля);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Условие отладочной записи: уровень «Отладка» или событие debug_*.
//
// Возвращаемое значение:
//  Строка - условие запроса с псевдонимом Т.
//
Функция УсловиеОтладочнойЗаписи()

	Возврат "Т.ar_Уровень = ""Отладка""
		|	ИЛИ Т.ar_Событие ПОДОБНО ""debug~_%"" СПЕЦСИМВОЛ ""~""";

КонецФункции

// Условие оставляемых записей: события-исключения за все время и записи окна
// настройки, кроме отладочных и sess_*; уровень «Ошибка» остается всегда.
//
// Возвращаемое значение:
//  Строка - условие запроса с псевдонимом Т и параметром &ГраницаОкна.
//
Функция УсловиеОставляемыхЗаписей()

	Возврат "Т.ar_Событие В (""code_tools_disabled"", ""tool_access_rules_widened"")
		|	ИЛИ (Т.ar_Момент >= &ГраницаОкна
		|		И (Т.ar_Уровень = ""Ошибка""
		|			ИЛИ НЕ (Т.ar_Уровень = ""Отладка""
		|				ИЛИ Т.ar_Событие ПОДОБНО ""debug~_%"" СПЕЦСИМВОЛ ""~""
		|				ИЛИ Т.ar_Событие ПОДОБНО ""sess~_%"" СПЕЦСИМВОЛ ""~"")))";

КонецФункции

// Граница окна оставляемых записей журнала.
//
// Параметры:
//  Момент    - Дата     - момент начала.
//  Настройки - Структура - см. НастройкиПоУмолчанию.
//
// Возвращаемое значение:
//  Дата.
//
Функция ГраницаОкнаЖурнала(Знач Момент, Знач Настройки)

	Возврат Момент - Настройки.ОставлятьЗаписейЧасов * 3600;

КонецФункции

// Количество оставляемых записей журнала для границы окна.
//
// Параметры:
//  ГраницаОкна - Дата.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоОставляемыхЗаписей(Знач ГраницаОкна)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаОкна", ГраницаОкна);
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Оставляемых ИЗ РегистрСведений.%1 КАК Т ГДЕ %2",
		ИмяРегистраЛога(), УсловиеОставляемыхЗаписей());

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Выборка.Следующий();
	Возврат Выборка.Оставляемых;

КонецФункции

// Текст запроса порции сессий: только измерения, без ar_ИсторияСжатая и без
// сортировки, чтобы запрос останавливался на N-й записи. Число - в тексте:
// ПЕРВЫЕ не принимает параметр.
//
// Параметры:
//  РазмерПорции - Число.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаПорцииСессий(Знач РазмерПорции)

	Возврат СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1 Т.ar_Агент КАК ar_Агент, Т.ar_Якорь КАК ar_Якорь
		|ИЗ РегистрСведений.%2 КАК Т ГДЕ Т.ar_Обновлена < &Граница",
		Формат(РазмерПорции, "ЧГ=0"), ИмяРегистраСессий());

КонецФункции

// Текст итога очистки журнала по метрикам спеки.
//
// Параметры:
//  См. ИтогОчисткиЖурнала.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстИтогаОчисткиЖурнала(Знач Было, Знач Стало, Знач Выгружено, Знач Файлов,
	Знач СекундВсего, Знач СекундВыгрузки, Знач СекундЗамены, Знач Оставлено, Знач Состояние)

	Очищено = РазностьСчетчиков(Было, Стало);

	Возврат СтрШаблон(НСтр("ru = 'Регистр сведений ar_СлужебныйЛог: было %1, стало %2, очищено %3,
		|за %4 сек (выгрузка %5, замена %6), выгружено %7 в %8 файлах, оставлено %9. %10'"),
		ЧислоИлиНетДанных(Было), ЧислоИлиНетДанных(Стало), ЧислоИлиНетДанных(Очищено),
		ЧислоИлиНетДанных(Окр(СекундВсего)), ЧислоИлиНетДанных(Окр(СекундВыгрузки)),
		ЧислоИлиНетДанных(Окр(СекундЗамены)), ЧислоИлиНетДанных(Выгружено),
		ЧислоИлиНетДанных(Файлов), ЧислоИлиНетДанных(Оставлено), Состояние);

КонецФункции

// Разность счетчиков «было» и «стало»; Неопределено, если какой-то счет не выполнен.
//
// Возвращаемое значение:
//  Число, Неопределено.
//
Функция РазностьСчетчиков(Знач Было, Знач Стало)

	Если Было = Неопределено ИЛИ Стало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Было - Стало;

КонецФункции

// Число строкой для итога; Неопределено - «нет данных».
//
// Параметры:
//  Значение - Число, Неопределено.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЧислоИлиНетДанных(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат НСтр("ru = 'нет данных'");
	КонецЕсли;
	Возврат ЧислоСтрокой(Значение);

КонецФункции

// Предел оставляемых записей: больше - очистка не выполняется, окно настройки
// велико.
//
// Возвращаемое значение:
//  Число.
//
Функция МаксимальноОставляемыхЗаписей()

	Возврат 100000;

КонецФункции

// Количество записей регистра запросом КОЛИЧЕСТВО(*) без отбора. Ошибка или
// недоступный регистр - Неопределено: счет не должен отменять работу.
//
// Параметры:
//  ИмяРегистра - Строка.
//
// Возвращаемое значение:
//  Число, Неопределено.
//
Функция КоличествоЗаписейРегистра(Знач ИмяРегистра)

	Если НЕ РегистрДоступен(ИмяРегистра) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ВсегоЗаписей ИЗ РегистрСведений.%1", ИмяРегистра));

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Подсчет записей не выполнен: '")
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Выборка.Следующий();
	Возврат Выборка.ВсегоЗаписей;

КонецФункции

#КонецОбласти

#Область Диагностика

// Журнал: первые 50 событий по количеству, итоги, длина sess_write_verify.
Процедура ДобавитьПоказателиЖурнала(Таблица)

	Раздел = НСтр("ru = 'Журнал ar_СлужебныйЛог'");
	Если НЕ РегистрДоступен(ИмяРегистраЛога()) Тогда
		ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Регистр'"), НСтр("ru = 'недоступен'"));
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ВсегоЗаписей,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|		КОГДА Т.ar_Событие ПОДОБНО ""debug~_%%"" СПЕЦСИМВОЛ ""~"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Отладочных,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|		КОГДА Т.ar_Событие = ""late_completion_ignored"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК ПозднихЗавершений
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 50
		|	Т.ar_Событие КАК ИмяСобытия,
		|	КОЛИЧЕСТВО(*) КАК Записей,
		|	МИНИМУМ(Т.ar_Момент) КАК СамаяСтарая
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.ar_Событие
		|УПОРЯДОЧИТЬ ПО
		|	Записей УБЫВ", ИмяРегистраЛога());
	Результаты = Запрос.ВыполнитьПакет();

	Итоги = Результаты[0].Выбрать();
	Итоги.Следующий();
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Всего записей'"), ЧислоСтрокой(Итоги.ВсегоЗаписей));
	ДобавитьПоказатель(Таблица, Раздел, "debug_*", ЧислоСтрокой(Итоги.Отладочных));
	ДобавитьПоказатель(Таблица, Раздел, "late_completion_ignored", ЧислоСтрокой(Итоги.ПозднихЗавершений));
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Наибольшая длина текста sess_write_verify'"),
		НаибольшаяДлинаТекстаПроверки());

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьПоказатель(Таблица, Раздел, Выборка.ИмяСобытия, ЧислоСтрокой(Выборка.Записей),
			НСтр("ru = 'самая старая: '") + Формат(Выборка.СамаяСтарая, "ДЛФ=DT"));
	КонецЦикла;

КонецПроцедуры

// Наибольшая длина текста sess_write_verify. Длина считается только для этого
// события. Функция языка запросов в выгрузке БИТ не встречается, поэтому ошибка
// ее выполнения не должна мешать остальной диагностике.
//
// Возвращаемое значение:
//  Строка.
//
Функция НаибольшаяДлинаТекстаПроверки()

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	МАКСИМУМ(ДЛИНАСТРОКИ(Т.ar_Текст)) КАК НаибольшаяДлина
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|ГДЕ
		|	Т.ar_Событие = ""sess_write_verify""", ИмяРегистраЛога());

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Возврат ?(Выборка.НаибольшаяДлина = NULL, "-", ЧислоСтрокой(Выборка.НаибольшаяДлина));
	Исключение
		ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат НСтр("ru = 'недоступно'");
	КонецПопытки;

КонецФункции

// Запуски по статусам и запуски за 30 дней с ошибкой ПолучитьЧасть, без чтения
// ar_StateSnapshot.
Процедура ДобавитьПоказателиЗапусков(Таблица)

	Раздел = НСтр("ru = 'Запуски ar_Запуски'");
	ИмяРегистра = "ar_Запуски";
	Если НЕ РегистрДоступен(ИмяРегистра) Тогда
		ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Регистр'"), НСтр("ru = 'недоступен'"));
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 30 * 86400);
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Записей
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|ГДЕ
		|	Т.ar_ЗавершенВ >= &Граница
		|	И ВЫРАЗИТЬ(Т.ar_ОтветLLM КАК СТРОКА(1000)) ПОДОБНО ""%%ПолучитьЧасть%%""
		|;
		|ВЫБРАТЬ
		|	Т.ar_Статус КАК Статус,
		|	КОЛИЧЕСТВО(*) КАК Записей
		|ИЗ
		|	РегистрСведений.%1 КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.ar_Статус", ИмяРегистра);
	Результаты = Запрос.ВыполнитьПакет();

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьПоказатель(Таблица, Раздел, Строка(Выборка.Статус), ЧислоСтрокой(Выборка.Записей));
	КонецЦикла;

	Ошибки = Результаты[0].Выбрать();
	Ошибки.Следующий();
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'С ошибкой ПолучитьЧасть за 30 дней'"),
		ЧислоСтрокой(Ошибки.Записей));

КонецПроцедуры

// Размер таблиц регистров. Платформа может не считать объекты расширений: и
// ошибка, и нулевой размер показываются как «недоступно».
Процедура ДобавитьРазмерыТаблиц(Таблица)

	Раздел = НСтр("ru = 'Размер таблиц'");
	ИменаРегистров = СтрРазделить(
		"ar_СлужебныйЛог,ar_Сессии,ar_СобытияЗапуска,ar_Запуски,ar_ДействияАгента,ar_ЛентаДиалога", ",");

	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Если НЕ РегистрДоступен(ИмяРегистра) Тогда
			Продолжить;
		КонецЕсли;
		Объекты = Новый Массив;
		Объекты.Добавить("РегистрСведений." + ИмяРегистра);
		Значение = НСтр("ru = 'недоступно'");
		Попытка
			Размер = ПолучитьРазмерДанныхБазыДанных(Новый Массив, Объекты);
			Если Размер > 0 Тогда
				Значение = ЧислоСтрокой(Окр(Размер / 1048576, 1)) + " " + НСтр("ru = 'МБ'");
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(СобытиеОбслуживания(), УровеньЖурналаРегистрации.Ошибка, , ,
				ИмяРегистра + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		ДобавитьПоказатель(Таблица, Раздел, ИмяРегистра, Значение);
	КонецЦикла;

КонецПроцедуры

// Сессии: всего, активные, закрытые, активные старше TTL (отставание ротации).
Процедура ДобавитьПоказателиСессий(Таблица)

	Раздел = НСтр("ru = 'Сессии ar_Сессии'");
	Если НЕ РегистрДоступен(ИмяРегистраСессий()) Тогда
		ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Регистр'"), НСтр("ru = 'недоступен'"));
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - СрокЖизниСессииДней() * 86400);
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ВсегоЗаписей,
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Т.ar_Активна ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Активных,
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Т.ar_Активна И Т.ar_Обновлена < &Граница ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0)
		|		КАК АктивныхСтаршеСрока
		|ИЗ
		|	РегистрСведений.%1 КАК Т", ИмяРегистраСессий());
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Всего'"), ЧислоСтрокой(Выборка.ВсегоЗаписей));
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Активных'"), ЧислоСтрокой(Выборка.Активных));
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Закрытых'"),
		ЧислоСтрокой(Выборка.ВсегоЗаписей - Выборка.Активных));
	ДобавитьПоказатель(Таблица, Раздел, НСтр("ru = 'Активных старше TTL'"),
		ЧислоСтрокой(Выборка.АктивныхСтаршеСрока));

КонецПроцедуры

// Значения констант AgentRunner.
Процедура ДобавитьКонстанты(Таблица)

	Раздел = НСтр("ru = 'Константы'");
	ИменаКонстант = СтрРазделить("ar_РазрешитьОчисткуAudit,ar_МаксРазмерОтветаHTTP,ar_СессияTTLДней", ",");
	Для Каждого ИмяКонстанты Из ИменаКонстант Цикл
		Значение = ЗначениеКонстанты(ИмяКонстанты);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Значение = ЧислоСтрокой(Значение);
		ИначеЕсли Значение = Неопределено Тогда
			Значение = "-";
		КонецЕсли;
		ДобавитьПоказатель(Таблица, Раздел, ИмяКонстанты, Строка(Значение));
	КонецЦикла;

КонецПроцедуры

// Провайдеры и ar_MaxContext, агенты с сессиями, активные cron-рутины.
Процедура ДобавитьПоказателиСправочников(Таблица)

	ЧастиЗапроса = Новый Массив;
	ДоступныПровайдеры = Метаданные.Справочники.Найти("ar_LLMПровайдеры") <> Неопределено;
	ДоступныАгенты = Метаданные.Справочники.Найти("ar_Агенты") <> Неопределено;
	ДоступныРутины = Метаданные.Справочники.Найти("ar_Рутины") <> Неопределено;

	Если ДоступныПровайдеры Тогда
		ЧастиЗапроса.Добавить(
			"ВЫБРАТЬ ПЕРВЫЕ 50
			|	Т.Наименование КАК Наименование,
			|	Т.ar_MaxContext КАК Значение
			|ИЗ
			|	Справочник.ar_LLMПровайдеры КАК Т
			|ГДЕ
			|	НЕ Т.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Наименование");
	КонецЕсли;
	Если ДоступныАгенты Тогда
		ЧастиЗапроса.Добавить(
			"ВЫБРАТЬ ПЕРВЫЕ 50
			|	Т.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ar_Агенты КАК Т
			|ГДЕ
			|	НЕ Т.ПометкаУдаления
			|	И Т.ar_ИспользоватьСессии
			|УПОРЯДОЧИТЬ ПО
			|	Наименование");
	КонецЕсли;
	Если ДоступныРутины Тогда
		ЧастиЗапроса.Добавить(
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Записей
			|ИЗ
			|	Справочник.ar_Рутины КАК Т
			|ГДЕ
			|	НЕ Т.ПометкаУдаления
			|	И Т.ar_Активна
			|	И Т.ar_ТипТриггера = ""cron""");
	КонецЕсли;
	Если ЧастиЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(СтрСоединить(ЧастиЗапроса, ";" + Символы.ПС));
	Результаты = Запрос.ВыполнитьПакет();
	Номер = 0;

	Если ДоступныПровайдеры Тогда
		Выборка = Результаты[Номер].Выбрать();
		Номер = Номер + 1;
		Пока Выборка.Следующий() Цикл
			ДобавитьПоказатель(Таблица, НСтр("ru = 'Провайдеры, ar_MaxContext'"), Выборка.Наименование,
				ЧислоСтрокой(Выборка.Значение));
		КонецЦикла;
	КонецЕсли;

	Если ДоступныАгенты Тогда
		Выборка = Результаты[Номер].Выбрать();
		Номер = Номер + 1;
		Пока Выборка.Следующий() Цикл
			ДобавитьПоказатель(Таблица, НСтр("ru = 'Агенты с ar_ИспользоватьСессии'"), Выборка.Наименование,
				НСтр("ru = 'да'"));
		КонецЦикла;
	КонецЕсли;

	Если ДоступныРутины Тогда
		Выборка = Результаты[Номер].Выбрать();
		Выборка.Следующий();
		ДобавитьПоказатель(Таблица, НСтр("ru = 'Рутины'"), НСтр("ru = 'Активных с триггером cron'"),
			ЧислоСтрокой(Выборка.Записей));
	КонецЕсли;

КонецПроцедуры

// Добавляет строку диагностики.
Процедура ДобавитьПоказатель(Таблица, Знач Раздел, Знач Показатель, Знач Значение, Знач Примечание = "")

	СтрокаПоказателя = Таблица.Добавить();
	СтрокаПоказателя.Раздел = Раздел;
	СтрокаПоказателя.Показатель = Показатель;
	СтрокаПоказателя.Значение = Значение;
	СтрокаПоказателя.Примечание = Примечание;

КонецПроцедуры

#КонецОбласти

#Область НастройкиИМетаданные

// Настройки по умолчанию: режим выключен, первый запуск на большом регистре -
// после предпросмотра и сознательного включения.
//
// Возвращаемое значение:
//  Структура.
//
Функция НастройкиПоУмолчанию()

	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", Ложь);
	Настройки.Вставить("ЗапасСессийДней", 30);
	Настройки.Вставить("РазмерПорцииСессий", 1000);
	Настройки.Вставить("ПределМинут", 30);
	Настройки.Вставить("ЗаписейВФайлеЖурнала", 20000);
	Настройки.Вставить("ОставлятьЗаписейЧасов", 24);
	Настройки.Вставить("ВыгружатьОтладку", Истина);
	Возврат Настройки;

КонецФункции

// Допустимые диапазоны числовых настроек.
//
// Возвращаемое значение:
//  Массив из Структура - Поле, Представление, Минимум, Максимум.
//
Функция ДиапазоныНастроек()

	Диапазоны = Новый Массив;
	Шаблон = "Поле, Представление, Минимум, Максимум";
	Диапазоны.Добавить(Новый Структура(Шаблон, "ЗапасСессийДней",
		НСтр("ru = 'Запас хранения сессий после TTL, дней'"), 1, 3650));
	Диапазоны.Добавить(Новый Структура(Шаблон, "РазмерПорцииСессий",
		НСтр("ru = 'Размер порции сессий, записей'"), 100, 10000));
	Диапазоны.Добавить(Новый Структура(Шаблон, "ПределМинут",
		НСтр("ru = 'Предел такта по расписанию, минут'"), 1, 240));
	Диапазоны.Добавить(Новый Структура(Шаблон, "ЗаписейВФайлеЖурнала",
		НСтр("ru = 'Записей в файле журнала'"), 1000, 100000));
	Диапазоны.Добавить(Новый Структура(Шаблон, "ОставлятьЗаписейЧасов",
		НСтр("ru = 'Оставлять записи журнала, часов'"), 1, 720));
	Возврат Диапазоны;

КонецФункции

// Отказ, если у пользователя нет полных прав. Вызывается до подъема привилегий.
Процедура ПроверитьПолныеПрава()

	Если НЕ ЕстьПолныеПрава() Тогда
		ВызватьИсключение НСтр("ru = 'Для работы с обработкой нужны полные права.'");
	КонецЕсли;

КонецПроцедуры

// Элемент справочника обработки в привилегированном режиме: пользователю задания
// справочник может быть недоступен.
//
// Параметры:
//  СсылкаОбработки - см. ЭлементОбработки.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - пустая ссылка, если не найден.
//
Функция НайденныйЭлементОбработки(Знач СсылкаОбработки)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Элемент = ЭлементОбработки(СсылкаОбработки);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Элемент;

КонецФункции

// Элемент справочника ДополнительныеОтчетыИОбработки этой обработки. Переданная
// ссылка проверяется на существование; иначе - поиск по имени объекта.
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки,
//                    Неопределено - поиск по имени объекта.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - пустая ссылка, если не найден.
//
Функция ЭлементОбработки(Знач СсылкаОбработки)

	Если ЗначениеЗаполнено(СсылкаОбработки)
		И ОбщегоНазначения.СсылкаСуществует(СсылкаОбработки) Тогда
		Возврат СсылкаОбработки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъектаОбработки());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
		|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();

КонецФункции

// Значение ХранилищеНастроек элемента обработки. Элемент не найден - Неопределено.
//
// Параметры:
//  СсылкаОбработки - см. ЭлементОбработки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено.
//
Функция ХранилищеНастроекОбработки(Знач СсылкаОбработки)

	Значение = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Элемент = ЭлементОбработки(СсылкаОбработки);
		Если ЗначениеЗаполнено(Элемент) Тогда
			Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, "ХранилищеНастроек");
			Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
				Значение = Значение.Получить();
			КонецЕсли;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Значение;

КонецФункции

// Расширение AgentRunner подключено: доступен хотя бы один из обслуживаемых регистров.
//
// Возвращаемое значение:
//  Булево.
//
Функция РасширениеДоступно()

	Возврат РегистрДоступен(ИмяРегистраЛога()) ИЛИ РегистрДоступен(ИмяРегистраСессий());

КонецФункции

// Регистр сведений есть в метаданных.
//
// Параметры:
//  ИмяРегистра - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция РегистрДоступен(Знач ИмяРегистра)

	Возврат Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;

КонецФункции

// Значение константы по имени в привилегированном режиме.
//
// Параметры:
//  ИмяКонстанты - Строка.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - константы нет в метаданных.
//
Функция ЗначениеКонстанты(Знач ИмяКонстанты)

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Значение = Константы[ИмяКонстанты].Получить();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Значение;

КонецФункции

// Срок жизни сессии: ar_СессияTTLДней; меньше или равный нулю трактуется как 30.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниСессииДней()

	Значение = ЗначениеКонстанты("ar_СессияTTLДней");
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 30;

КонецФункции

// Строковое представление числа: без группировки, ноль показывается.
//
