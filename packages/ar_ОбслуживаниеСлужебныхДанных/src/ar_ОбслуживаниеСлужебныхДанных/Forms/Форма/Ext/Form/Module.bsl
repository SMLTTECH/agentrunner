#Область ОписаниеПеременных

// Состояние идущей выгрузки журнала (Структура, см. ПослеПодтвержденияОчисткиЖурнала),
// Неопределено - выгрузка не идет.
Перем ПараметрыВыгрузкиЖурнала;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Форма удаляет данные в привилегированном режиме, поэтому без полных прав она
// не открывается. Проверка - на сервере, до подъема привилегий.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если НЕ ОбъектОбработки.ЕстьПолныеПрава() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для работы с обработкой нужны полные права.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбъектОбработки.НастройкиОбработки());

	// Открытие файла обработки не заменяет регистрацию: настройки хранятся в
	// элементе справочника, очистку ar_Сессии по расписанию исполняет задание БСП.
	Если НЕ ОбъектОбработки.ОбработкаЗарегистрирована() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Обработка не найдена в справочнике «Дополнительные отчеты и обработки»:
				|настройки не сохраняются, очистка по расписанию не выполняется.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Запись настроек: значение вне диапазона не сохраняется.
&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНастройкиНаСервере();
КонецПроцедуры

// Количество записей по действиям, ничего не удаляет.
&НаКлиенте
Процедура ПоказатьПредпросмотр(Команда)
	ПоказатьПредпросмотрНаСервере();
КонецПроцедуры

// Ручная очистка ar_Сессии - тот же такт, что по расписанию, с пределом 5 минут.
&НаКлиенте
Процедура ВыполнитьТакт(Команда)
	ВыполнитьТактНаСервере();
КонецПроцедуры

// Диагностика, только чтение.
&НаКлиенте
Процедура ОбновитьДиагностику(Команда)
	ОбновитьДиагностикуНаСервере();
КонецПроцедуры

// Выгрузка журнала в файлы и очистка регистра. Шаг 1: каталог выбирает
// администратор на своем компьютере: с сервера 1С доступны не все каталоги.
&НаКлиенте
Процедура ВыгрузитьЖурнал(Команда)

	Если ПараметрыВыгрузкиЖурнала <> Неопределено Тогда
		ПоказатьСообщение(НСтр("ru = 'Выгрузка уже идет: дождитесь завершения или отмените ее.'"));
		Возврат;
	КонецЕсли;

	ОповещениеВыбора = Новый ОписаниеОповещения("ПослеВыбораКаталогаЖурнала", ЭтотОбъект);
	ФайловаяСистемаКлиент.ВыбратьКаталог(ОповещениеВыбора,
		НСтр("ru = 'Каталог для файлов выгрузки журнала'"));

КонецПроцедуры

// Отмена выгрузки: действует между частями, после отмены ничего не удаляется.
&НаКлиенте
Процедура ОтменитьВыгрузку(Команда)

	Если ПараметрыВыгрузкиЖурнала <> Неопределено Тогда
		ПараметрыВыгрузкиЖурнала.Отменена = Истина;
		ХодВыгрузки = НСтр("ru = 'Отмена: выгрузка остановится после текущей части.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыгрузкаЖурнала

// Пустой каталог: в веб-клиенте без расширения для работы с 1С выбора нет, в
// тонком клиенте это отказ пользователя.
&НаКлиенте
Процедура ПослеВыбораКаталогаЖурнала(ПутьККаталогу, ДополнительныеПараметры) Экспорт

	Если ПустаяСтрока(ПутьККаталогу) Тогда
		ПоказатьСообщение(НСтр("ru = 'Каталог не выбран: для выгрузки нужны тонкий клиент
			|или расширение для работы с файлами 1С.'"));
		Возврат;
	КонецЕсли;

	Попытка
		ПараметрыВыгрузки = ПараметрыОчисткиЖурналаНаСервере();
	Исключение
		ПоказатьСообщение(НСтр("ru = 'Очистка не начата: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если НЕ ПустаяСтрока(ПараметрыВыгрузки.Причина) Тогда
		ПоказатьСообщение(ПараметрыВыгрузки.Причина);
		Возврат;
	КонецЕсли;

	Если ПараметрыВыгрузки.Останется > ПараметрыВыгрузки.МаксимальноОставляемых Тогда
		ПоказатьСообщение(СтрШаблон(НСтр("ru = 'Оставляемых записей %1 больше предела %2:
			|уменьшите окно «Оставлять записи журнала, часов» в настройках.'"),
			ЧислоСтрокой(ПараметрыВыгрузки.Останется), ЧислоСтрокой(ПараметрыВыгрузки.МаксимальноОставляемых)));
		Возврат;
	КонецЕсли;

	ПараметрыВыгрузки.Вставить("КаталогВыгрузки", ПутьККаталогу);

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Регистр сведений ar_СлужебныйЛог:
		|в файлы будет выгружено %1 записей, в регистре останется %2 записей. Продолжить?'"),
		ЧислоСтрокой(ПараметрыВыгрузки.КВыгрузке), ЧислоСтрокой(ПараметрыВыгрузки.Останется));
	ОписаниеВопроса = Новый ОписаниеОповещения("ПослеПодтвержденияОчисткиЖурнала", ЭтотОбъект, ПараметрыВыгрузки);
	ПоказатьВопрос(ОписаниеВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Вопрос подтвержден: подкаталог выгрузки и первый шаг цикла выгрузки.
&НаКлиенте
Процедура ПослеПодтвержденияОчисткиЖурнала(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КаталогВыгрузки = ДополнительныеПараметры.КаталогВыгрузки + "\ar_log_"
		+ Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss");
	Попытка
		СоздатьКаталог(КаталогВыгрузки);
	Исключение
		ПоказатьСообщение(НСтр("ru = 'Не удалось создать каталог выгрузки: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ДополнительныеПараметры.КаталогВыгрузки = КаталогВыгрузки;
	ДополнительныеПараметры.Вставить("ПоследнийКлюч", "");
	ДополнительныеПараметры.Вставить("НомерФайла", 0);
	ДополнительныеПараметры.Вставить("Выгружено", 0);
	ДополнительныеПараметры.Вставить("Оставлено", 0);
	ДополнительныеПараметры.Вставить("Отменена", Ложь);
	ДополнительныеПараметры.Вставить("СекундВыгрузки", 0);
	ДополнительныеПараметры.Вставить("СекундЗамены", 0);
	ДополнительныеПараметры.Вставить("НачалоВсегоМс", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ДополнительныеПараметры.Вставить("НачалоВыгрузкиМс", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ПараметрыВыгрузкиЖурнала = ДополнительныеПараметры;

	ХодВыгрузки = НСтр("ru = 'Выгрузка начата.'");
	Итог = "";
	Элементы.КнопкаОтменитьВыгрузку.Доступность = Истина;

	ПодключитьОбработчикОжидания("ШагВыгрузкиЖурнала", 0.1, Истина);

КонецПроцедуры

// Один шаг цикла выгрузки: сервер читает часть, клиент пишет файл. Между частями
// действует отмена. Обработчик ожидания однократный: следующий шаг подключает
// обработчик записи файла.
&НаКлиенте
Процедура ШагВыгрузкиЖурнала()

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	Если ПараметрыВыгрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыВыгрузки.Отменена Тогда
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка отменена пользователем: регистр не очищался.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Часть = ВыгрузитьЧастьЖурналаНаСервере(ПараметрыВыгрузки.ПоследнийКлюч, ПараметрыВыгрузки.РазмерЧасти,
			ПараметрыВыгрузки.ВыгружатьОтладку);
	Исключение
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка остановлена: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Часть.Записей = 0 Тогда
		Если ПараметрыВыгрузки.Выгружено < ПараметрыВыгрузки.КВыгрузке Тогда
			ЗавершитьВыгрузкуЖурнала(СтрШаблон(НСтр("ru = 'Выгрузка остановлена: выгружено %1 из %2 записей,
				|очистка отменена.'"), ЧислоСтрокой(ПараметрыВыгрузки.Выгружено), ЧислоСтрокой(ПараметрыВыгрузки.КВыгрузке)));
			Возврат;
		КонецЕсли;
		НачатьХвостВыгрузки();
		Возврат;
	КонецЕсли;

	ПараметрыВыгрузки.ПоследнийКлюч = Часть.ПоследнийКлюч;
	ЗаписатьФайлВыгрузки(Часть.Данные, Часть.Записей, "Часть");

КонецПроцедуры

// Хвост: записи, появившиеся за время выгрузки, последним файлом. Дубли с
// основной выгрузкой допустимы.
&НаКлиенте
Процедура НачатьХвостВыгрузки()

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	Если ПараметрыВыгрузки.Отменена Тогда
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка отменена пользователем: регистр не очищался.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Хвост = ХвостЖурналаНаСервере(ПараметрыВыгрузки.МоментНачала, ПараметрыВыгрузки.ВыгружатьОтладку);
	Исключение
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка остановлена: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Хвост.Записей = 0 Тогда
		НачатьЗаменуЖурнала();
	Иначе
		ЗаписатьФайлВыгрузки(Хвост.Данные, Хвост.Записей, "Хвост");
	КонецЕсли;

КонецПроцедуры

// Асинхронная запись файла части: ДвоичныеДанные.НачатьЗапись.
//
// Параметры:
//  Данные  - ДвоичныеДанные - zip-архив части.
//  Записей - Число  - записей в части.
//  Фаза    - Строка - "Часть" или "Хвост": после хвоста продолжения нет.
//
&НаКлиенте
Процедура ЗаписатьФайлВыгрузки(Знач Данные, Знач Записей, Знач Фаза)

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	НомерФайла = ПараметрыВыгрузки.НомерФайла + 1;
	ИмяФайла = ПараметрыВыгрузки.КаталогВыгрузки + "\" + ИмяФайлаВыгрузки(НомерФайла);

	ДанныеОповещения = Новый Структура("Фаза, Записей, НомерФайла", Фаза, Записей, НомерФайла);
	ОписаниеЗаписи = Новый ОписаниеОповещения("ПослеЗаписиФайлаВыгрузки", ЭтотОбъект,
		ДанныеОповещения, "ПослеОшибкеЗаписиФайлаВыгрузки", ЭтотОбъект);

	Данные.НачатьЗапись(ОписаниеЗаписи, ИмяФайла);

КонецПроцедуры

// Файл записан: счетчики, ход выгрузки и продолжение цикла.
&НаКлиенте
Процедура ПослеЗаписиФайлаВыгрузки(ДополнительныеПараметры) Экспорт

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	Если ПараметрыВыгрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыВыгрузки.НомерФайла = ДополнительныеПараметры.НомерФайла;
	ПараметрыВыгрузки.Выгружено = ПараметрыВыгрузки.Выгружено + ДополнительныеПараметры.Записей;
	ХодВыгрузки = СтрШаблон(НСтр("ru = 'Выгружено записей: %1, файлов: %2.'"),
		ЧислоСтрокой(ПараметрыВыгрузки.Выгружено), ЧислоСтрокой(ПараметрыВыгрузки.НомерФайла));

	Если ДополнительныеПараметры.Фаза = "Хвост" Тогда
		НачатьЗаменуЖурнала();
	Иначе
		ПодключитьОбработчикОжидания("ШагВыгрузкиЖурнала", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

// Ошибка записи файла (например, каталог без права записи): остановка без удаления.
&НаКлиенте
Процедура ПослеОшибкеЗаписиФайлаВыгрузки(ИнформацияОбОшибке, СтандартнаяОбработка,
	ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка остановлена: ошибка записи файла: '")
		+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Замена регистра оставляемыми записями: решающий шаг, после успешной выгрузки.
&НаКлиенте
Процедура НачатьЗаменуЖурнала()

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	Если ПараметрыВыгрузки.Отменена Тогда
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выгрузка отменена пользователем: регистр не очищался.'"));
		Возврат;
	КонецЕсли;

	ПараметрыВыгрузки.СекундВыгрузки = (ТекущаяУниверсальнаяДатаВМиллисекундах()
		- ПараметрыВыгрузки.НачалоВыгрузкиМс) / 1000;
	НачалоЗаменыМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ХодВыгрузки = НСтр("ru = 'Замена регистра сведений ar_СлужебныйЛог.'");

	Попытка
		РезультатЗамены = ЗаменитьЖурналНаСервере(ПараметрыВыгрузки.МоментНачала);
	Исключение
		ПараметрыВыгрузки.СекундЗамены = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗаменыМс) / 1000;
		ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Замена регистра не выполнена, регистр не менялся: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПараметрыВыгрузки.Оставлено = РезультатЗамены.Оставлено;
	ПараметрыВыгрузки.СекундЗамены = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗаменыМс) / 1000;
	ЗавершитьВыгрузкуЖурнала(НСтр("ru = 'Выполнено.'"));

КонецПроцедуры

// Завершение выгрузки при любом исходе: итог в форму и журнал регистрации,
// сброс состояния. Счет «стало» сервер берет и при остановке, и при отмене.
//
// Параметры:
//  Состояние - Строка - «выполнено» или причина остановки.
//
&НаКлиенте
Процедура ЗавершитьВыгрузкуЖурнала(Знач Состояние)

	Элементы.КнопкаОтменитьВыгрузку.Доступность = Ложь;

	ПараметрыВыгрузки = ПараметрыВыгрузкиЖурнала;
	Если ПараметрыВыгрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыВыгрузкиЖурнала = Неопределено;

	СекундВсего = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ПараметрыВыгрузки.НачалоВсегоМс) / 1000;

	Попытка
		ТекстИтога = ИтогОчисткиНаСервере(ПараметрыВыгрузки.Было, ПараметрыВыгрузки.Выгружено,
			ПараметрыВыгрузки.НомерФайла, СекундВсего, ПараметрыВыгрузки.СекундВыгрузки,
			ПараметрыВыгрузки.СекундЗамены, ПараметрыВыгрузки.Оставлено, Состояние);
	Исключение
		ТекстИтога = Состояние + Символы.ПС + НСтр("ru = 'Итог не записан: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог = ТекстИтога;
	ХодВыгрузки = "";

КонецПроцедуры

// Имя файла выгрузки: ar_log_0001.zip, номер с ведущими нулями до четырех цифр.
//
// Параметры:
//  Номер - Число.
//
// Возвращаемое значение:
//  Строка.
//
&НаКлиенте
Функция ИмяФайлаВыгрузки(Знач Номер)

	НомерСтрокой = Строка(Номер);
	Пока СтрДлина(НомерСтрокой) < 4 Цикл
		НомерСтрокой = "0" + НомерСтрокой;
	КонецЦикла;
	Возврат "ar_log_" + НомерСтрокой + ".zip";

КонецФункции

// Число строкой: без группировки, ноль показывается.
//
// Параметры:
//  Значение - Число.
//
// Возвращаемое значение:
//  Строка.
//
&НаКлиенте
Функция ЧислоСтрокой(Знач Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Сообщение пользователю из клиентского кода.
//
// Параметры:
//  Текст - Строка.
//
&НаКлиенте
Процедура ПоказатьСообщение(Знач Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

// Настройки из реквизитов формы.
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию модуля объекта.
//
&НаСервере
Функция НастройкиИзФормы()

	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", РежимВключен);
	Настройки.Вставить("ЗапасСессийДней", ЗапасСессийДней);
	Настройки.Вставить("РазмерПорцииСессий", РазмерПорцииСессий);
	Настройки.Вставить("ПределМинут", ПределМинут);
	Настройки.Вставить("ЗаписейВФайлеЖурнала", ЗаписейВФайлеЖурнала);
	Настройки.Вставить("ОставлятьЗаписейЧасов", ОставлятьЗаписейЧасов);
	Настройки.Вставить("ВыгружатьОтладку", ВыгружатьОтладку);
	Возврат Настройки;

КонецФункции

// Проверка диапазонов и сохранение настроек.
&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Настройки = НастройкиИзФормы();

	Ошибки = ОбъектОбработки.ОшибкиНастроек(Настройки);
	Для Каждого Ошибка Из Ошибки Цикл
		ОбщегоНазначения.СообщитьПользователю(Ошибка.Текст, , Ошибка.Поле);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	ОбъектОбработки.СохранитьНастройки(Настройки);
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Настройки записаны.'"));

КонецПроцедуры

// Предпросмотр - в таблицу формы.
&НаСервере
Процедура ПоказатьПредпросмотрНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбъектОбработки.Предпросмотр(), "ТаблицаПредпросмотра");

КонецПроцедуры

// Ручной такт, итог - в поле формы.
&НаСервере
Процедура ВыполнитьТактНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Итог = ОбъектОбработки.РучнойТакт();

КонецПроцедуры

// Диагностика - в таблицу формы.
&НаСервере
Процедура ОбновитьДиагностикуНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбъектОбработки.Диагностика(), "ТаблицаДиагностики");

КонецПроцедуры

// Параметры начала выгрузки журнала.
//
// Возвращаемое значение:
//  Структура - см. ПараметрыОчисткиЖурнала модуля объекта.
//
&НаСервере
Функция ПараметрыОчисткиЖурналаНаСервере()

	Возврат РеквизитФормыВЗначение("Объект").ПараметрыОчисткиЖурнала();

КонецФункции

// Одна часть журнала с сервера.
//
// Возвращаемое значение:
//  Структура - см. ЧастьЖурналаДляВыгрузки модуля объекта.
//
&НаСервере
Функция ВыгрузитьЧастьЖурналаНаСервере(Знач ПоследнийКлюч, Знач РазмерЧасти, Знач ВыгружатьОтладку)

	Возврат РеквизитФормыВЗначение("Объект").ЧастьЖурналаДляВыгрузки(ПоследнийКлюч, РазмерЧасти, ВыгружатьОтладку);

КонецФункции

// Хвост выгрузки с сервера.
//
// Возвращаемое значение:
//  Структура - см. ХвостЖурналаДляВыгрузки модуля объекта.
//
&НаСервере
Функция ХвостЖурналаНаСервере(Знач МоментНачала, Знач ВыгружатьОтладку)

	Возврат РеквизитФормыВЗначение("Объект").ХвостЖурналаДляВыгрузки(МоментНачала, ВыгружатьОтладку);

