//  Структура - см. ЗаменитьЖурналОставляемыми модуля объекта.
//
&НаСервере
Функция ЗаменитьЖурналНаСервере(Знач МоментНачала)

	Возврат РеквизитФормыВЗначение("Объект").ЗаменитьЖурналОставляемыми(МоментНачала);

КонецФункции

// Итог очистки журнала: счет «стало», текст и запись в журнал регистрации.
//
// Возвращаемое значение:
//  Строка - см. ИтогОчисткиЖурнала модуля объекта.
//
&НаСервере
Функция ИтогОчисткиНаСервере(Знач Было, Знач Выгружено, Знач Файлов, Знач СекундВсего,
	Знач СекундВыгрузки, Знач СекундЗамены, Знач Оставлено, Знач Состояние)

	Возврат РеквизитФормыВЗначение("Объект").ИтогОчисткиЖурнала(Было, Выгружено, Файлов,
		СекундВсего, СекундВыгрузки, СекундЗамены, Оставлено, Состояние);

КонецФункции

#КонецОбласти
