#Область ОбработчикиСобытийФормы

// Форма удаляет данные в привилегированном режиме, поэтому без полных прав она
// не открывается. Проверка - на сервере, до подъема привилегий.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если НЕ ОбъектОбработки.ЕстьПолныеПрава() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для работы с обработкой нужны полные права.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбъектОбработки.НастройкиОбработки());

	// Открытие файла обработки не заменяет регистрацию: настройки хранятся в
	// элементе справочника, такт по расписанию исполняет задание БСП.
	Если НЕ ОбъектОбработки.ОбработкаЗарегистрирована() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Обработка не найдена в справочнике «Дополнительные отчеты и обработки»:
				|настройки не сохраняются, такт не выполняется.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Запись настроек: значение вне диапазона не сохраняется.
&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	ЗаписатьНастройкиНаСервере();
КонецПроцедуры

// Количество записей по шагам, ничего не удаляет.
&НаКлиенте
Процедура ПоказатьПредпросмотр(Команда)
	ПоказатьПредпросмотрНаСервере();
КонецПроцедуры

// Тот же такт, что по расписанию, с пределом 5 минут.
&НаКлиенте
Процедура ВыполнитьТакт(Команда)
	ВыполнитьТактНаСервере();
КонецПроцедуры

// Диагностика, только чтение.
&НаКлиенте
Процедура ОбновитьДиагностику(Команда)
	ОбновитьДиагностикуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройки из реквизитов формы.
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию модуля объекта.
//
&НаСервере
Функция НастройкиИзФормы()

	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", РежимВключен);
	Настройки.Вставить("ХранитьПроверкиДней", ХранитьПроверкиДней);
	Настройки.Вставить("ХранитьОтладкуДней", ХранитьОтладкуДней);
	Настройки.Вставить("ХранитьЖурналДней", ХранитьЖурналДней);
	Настройки.Вставить("ЗапасСессийДней", ЗапасСессийДней);
	Настройки.Вставить("РазмерПорции", РазмерПорции);
	Настройки.Вставить("ПределМинут", ПределМинут);
	Возврат Настройки;

КонецФункции

// Проверка диапазонов и сохранение настроек.
&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Настройки = НастройкиИзФормы();

	Ошибки = ОбъектОбработки.ОшибкиНастроек(Настройки);
	Для Каждого Ошибка Из Ошибки Цикл
		ОбщегоНазначения.СообщитьПользователю(Ошибка.Текст, , Ошибка.Поле);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	ОбъектОбработки.СохранитьНастройки(Настройки);
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Настройки записаны.'"));

КонецПроцедуры

// Предпросмотр - в таблицу формы.
&НаСервере
Процедура ПоказатьПредпросмотрНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбъектОбработки.Предпросмотр(), "ТаблицаПредпросмотра");

КонецПроцедуры

// Ручной такт, итог - в поле формы.
&НаСервере
Процедура ВыполнитьТактНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ИтогТакта = ОбъектОбработки.РучнойТакт();

КонецПроцедуры

// Диагностика - в таблицу формы.
&НаСервере
Процедура ОбновитьДиагностикуНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбъектОбработки.Диагностика(), "ТаблицаДиагностики");

КонецПроцедуры

#КонецОбласти
