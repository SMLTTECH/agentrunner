// Проверка «ИНН не меняется» (спека п. 4а): нормализованный ИНН «стало»
// отличается от «было» - не пройдена. ИНН читается из моделей заявки, ключ
// "ИНН" (карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаИНННеМеняется(Знач ОписаниеПроверки, Знач Контекст)
	
	ИННБыло = НормализованныйИНН(ЗначениеМодели(Контекст.МодельБыло, "ИНН"));
	ИННСтало = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	
	Если ИННБыло = ИННСтало Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'ИНН не изменен: %1'"), ЗначениеДляВывода(ИННСтало)), ИННСтало, ИННБыло);
	КонецЕсли;
	
	// Спека п. 4а: было X, стало Y и подсказка об оформлении новой карточки.
	Пояснение = СтрШаблон(НСтр("ru = 'Заявка меняет ИНН контрагента: было %1, стало %2.'"),
			ЗначениеДляВывода(ИННБыло), ЗначениеДляВывода(ИННСтало))
		+ Символы.ПС
		+ НСтр("ru = 'Изменение ИНН юрлица / ИП не допускается - оформите новую карточку контрагента.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ИННСтало, ИННБыло);
	
КонецФункции

// Проверка «Нет дубля по ИНН, КПП и наименованию» (спека п. 4б): один запрос
// к Справочник.Контрагенты без помеченных на удаление (решение В3); не пройдена
// при совпадении всех трех атрибутов - наименование без учета регистра и
// крайних пробелов.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаДубляИННКППНаименование(Знач ОписаниеПроверки, Знач Контекст)
	
	ИНН = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	КПП = СокрЛП(Строка(ЗначениеМодели(Контекст.МодельСтало, "КПП")));
	Наименование = СокрЛП(Строка(ЗначениеМодели(Контекст.МодельСтало, "Наименование")));
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'ИНН %1, КПП %2, «%3»'"),
		ЗначениеДляВывода(ИНН), ЗначениеДляВывода(КПП), Наименование);
	
	// Страховка: применимость гарантирует заполненный ИНН; запрос с пустым ИНН
	// дал бы ложные совпадения по всем контрагентам без ИНН.
	Если ПустаяСтрока(ИНН) Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(),
			НСтр("ru = 'ИНН в заявке не заполнен - проверка дубля не выполнена.'"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка) КАК Представление,
		|	Контрагенты.Код КАК Код,
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП
		|	И НЕ Контрагенты.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НРег(СокрЛП(Выборка.Наименование)) <> НРег(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1 (код %2)'"), Выборка.Представление, Выборка.Код);
		Пояснение = СтрШаблон(НСтр("ru = 'Найден контрагент с теми же ИНН, КПП и наименованием: %1.'"),
				ЗначениеВБазе)
			+ Символы.ПС
			+ НСтр("ru = 'Измените КПП или наименование, либо используйте существующую карточку контрагента.'");
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
			Пояснение, ЗначениеВЗаявке, ЗначениеВБазе);
		
	КонецЦикла;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		НСтр("ru = 'Контрагентов с теми же ИНН, КПП и наименованием нет.'"), ЗначениеВЗаявке);
	
КонецФункции

// Проверка «Паспорт РФ: серия и номер» (спека п. 4в): серия - 4 цифры,
// номер - 6 цифр (без пробелов); отдельное пояснение для серии и для номера.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаПаспортРФСерияНомер(Знач ОписаниеПроверки, Знач Контекст)
	
	Серия = СтрокаБезПробелов(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументСерия"));
	Номер = СтрокаБезПробелов(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументНомер"));
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'серия «%1», номер «%2»'"),
		ЗначениеДляВывода(Серия), ЗначениеДляВывода(Номер));
	
	СерияВерна = СтрДлина(Серия) = ДлинаСерииПаспортаРФ() И ТолькоЦифры(Серия);
	НомерВерен = СтрДлина(Номер) = ДлинаНомераПаспортаРФ() И ТолькоЦифры(Номер);
	
	Если СерияВерна И НомерВерен Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			НСтр("ru = 'Серия и номер паспорта соответствуют формату (4 и 6 цифр).'"), ЗначениеВЗаявке);
	КонецЕсли;
	
	// Отдельное пояснение на серию и на номер (спека п. 4в).
	Пояснение = "";
	Если НЕ СерияВерна Тогда
		Пояснение = СтрШаблон(НСтр("ru = 'Серия паспорта РФ - 4 цифры, в заявке «%1».'"),
			ЗначениеДляВывода(Серия));
	КонецЕсли;
	Если НЕ НомерВерен Тогда
		ТекстНомера = СтрШаблон(НСтр("ru = 'Номер паспорта РФ - 6 цифр, в заявке «%1».'"),
			ЗначениеДляВывода(Номер));
		Пояснение = ?(ПустаяСтрока(Пояснение), ТекстНомера, Пояснение + Символы.ПС + ТекстНомера);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ЗначениеВЗаявке);
	
КонецФункции

// Проверка «КПП крупнейшего налогоплательщика» (спека п. 2.1): смена КПП
// крупнейшего налогоплательщика (5-6 знаки «50») допускается только на КПП
// крупнейшего налогоплательщика; КПП справочника - текущее значение карточки
// предмета заявки (карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаКППКрупнейшегоНалогоплательщика(Знач ОписаниеПроверки, Знач Контекст)
	
	КППСправочника = КППВСправочнике(Контекст);
	КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
	
	Если ЭтоКППКрупнейшегоНалогоплательщика(КППСправочника)
		И НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППВЗаявке) Тогда
		// Спека п. 2.1: пояснение с КПП справочника и КПП заявки.
		Пояснение = СтрШаблон(НСтр("ru = 'Смена КПП крупнейшего налогоплательщика допускается
			|только на КПП крупнейшего налогоплательщика: было %1, стало %2.'"),
			ЗначениеДляВывода(КППСправочника), ЗначениеДляВывода(КППВЗаявке));
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение,
			КППВЗаявке, КППСправочника);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		СтрШаблон(НСтр("ru = 'Смена КПП допустима: КПП в справочнике %1, КПП в заявке %2.'"),
			ЗначениеДляВывода(КППСправочника), ЗначениеДляВывода(КППВЗаявке)),
		КППВЗаявке, КППСправочника);
	
КонецФункции

// Проверка «Обособленное подразделение крупнейшего налогоплательщика»
// (спека п. 2.2): у ОП головного-крупнейшего налогоплательщика должен быть
// собственный КПП, отличный от КПП головного контрагента.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаОПКрупнейшегоНалогоплательщика(Знач ОписаниеПроверки, Знач Контекст)
	
	ДанныеГоловного = ДанныеГоловногоКонтрагента(Контекст);
	Если ДанныеГоловного = Неопределено Тогда
		// Страховка: применимость гарантирует головного контрагента.
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(),
			НСтр("ru = 'головной контрагент в заявке не указан - проверка не выполнена.'"));
	КонецЕсли;
	
	КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
	ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1: КПП %2'"), Строка(ДанныеГоловного.Ссылка), ДанныеГоловного.КПП);
	
	Если НЕ ПустаяСтрока(КППВЗаявке) И КППВЗаявке <> ДанныеГоловного.КПП Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Создание ОП крупнейшего налогоплательщика разрешено: КПП ОП %1, КПП головного %2.'"),
				КППВЗаявке, ДанныеГоловного.КПП),
			КППВЗаявке, ЗначениеВБазе);
	КонецЕсли;
	
	// Спека п. 2.2: у ОП собственного КПП нет - данные заявки неверны.
	Пояснение = СтрШаблон(
			НСтр("ru = 'Обособленному подразделению нужен собственный КПП, отличный от КПП головного контрагента (%1).'"),
			ДанныеГоловного.КПП)
		+ Символы.ПС
		+ НСтр("ru = 'Данные заявки неверны - заявку вернуть инициатору на исправление.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение,
		КППВЗаявке, ЗначениеВБазе);
	
КонецФункции

// Проверка «Банковский счёт (дополнительные реквизиты)» (спека п. 2.3): номер
// счёта резидента РФ - ровно 20 цифр, у ИП / ФЛ - префиксы 40802 или 40817;
// значения - из таблицы ДополнительныеРеквизиты модели заявки (карта
// реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаБанковскийСчетДопРеквизиты(Знач ОписаниеПроверки, Знач Контекст)
	
	ЗначенияДопРеквизитов = ЗначенияДопРеквизитовЗаявки(Контекст);
	НомерСчета = СтрокаБезПробелов(ЗначенияДопРеквизитов.Получить("НомерБанковскогоСчета"));
	БИК = ЗначенияДопРеквизитов.Получить("БИКБанка");
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'счёт %1, БИК %2'"),
		ЗначениеДляВывода(НомерСчета), ЗначениеДляВывода(БИК));
	
	// Действуют все применимые правила, нарушения перечисляются через перевод строки.
	Нарушения = Новый Массив;
	Если Контекст.Юрисдикция = ЮрисдикцияРезидента()
		И НЕ (СтрДлина(НомерСчета) = 20 И ТолькоЦифры(НомерСчета)) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Номер счёта резидента РФ - ровно 20 цифр (только цифры), в заявке «%1».'"),
			ЗначениеДляВывода(НомерСчета)));
	КонецЕсли;
	Если (Контекст.ВидКонтрагента = ВидИП() Или Контекст.ВидКонтрагента = ВидФЛ())
		И НЕ (СтрНачинаетсяС(НомерСчета, "40802") Или СтрНачинаетсяС(НомерСчета, "40817")) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Номер счёта ИП / ФЛ начинается с 40802 или 40817, в заявке «%1».'"),
			ЗначениеДляВывода(НомерСчета)));
	КонецЕсли;
	
	Если Нарушения.Количество() = 0 Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Номер счёта соответствует правилам: %1.'"), ЗначениеВЗаявке),
			ЗначениеВЗаявке);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
		СтрСоединить(Нарушения, Символы.ПС), ЗначениеВЗаявке);
	
КонецФункции

// ИНН только из цифр: разделители и оформление отбрасываются (спека п. 4а -
// «нормализованный ИНН (только цифры)»).
//
// Параметры:
//  Значение - Строка, Число, произвольное.
//
// Возвращаемое значение:
//  Строка - только цифры значения.
//
Функция НормализованныйИНН(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	Иначе
		Возврат ЦифрыСтроки(Значение);
	КонецЕсли;
	
КонецФункции

// Только цифры строки: разделители и оформление отбрасываются.
//
// Параметры:
//  Строка - Строка.
//
// Возвращаемое значение:
//  Строка - только цифры.
//
Функция ЦифрыСтроки(Знач Строка)
	
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;
	
КонецФункции

// Строка значения без пробелов: «12 3» -> «123» (спека п. 4в - «после удаления
// пробелов»); нестроковые значения приводятся к строке.
//
// Параметры:
//  Значение - Строка, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаБезПробелов(Знач Значение)
	Возврат СтрЗаменить(Строка(Значение), " ", "");
КонецФункции

// Длина серии паспорта РФ (спека п. 4в: 4 цифры); единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаСерииПаспортаРФ()
	Возврат 4;
КонецФункции

// Длина номера паспорта РФ (спека п. 4в: 6 цифр); единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаНомераПаспортаРФ()
	Возврат 6;
КонецФункции

// Все символы строки - цифры; пустая строка - Ложь (пустая серия - не «4 цифры»).
//
// Параметры:
//  Строка - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТолькоЦифры(Знач Строка)
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

// Значение для текста пользователю: пустое значение - «(пусто)».
//
// Параметры:
//  Значение - Строка, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеДляВывода(Знач Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = Строка(Значение);
	КонецЕсли;
	Возврат ?(ПустаяСтрока(Значение), НСтр("ru = '(пусто)'"), Значение);
	
КонецФункции

// КПП строкой без крайних пробелов: нестроковое или отсутствующее значение -
// пустая строка (реквизит КПП - строка, карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  Значение - Строка, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция НормализованныйКПП(Знач Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
	
КонецФункции

// Признак КПП крупнейшего налогоплательщика (спека п. 2.1): 5-6 знаки КПП -
// «50»; пустой или короткий КПП - признака нет, без исключения.
//
// Параметры:
//  КПП - Строка - КПП, см. НормализованныйКПП().
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКППКрупнейшегоНалогоплательщика(Знач КПП)
	
	Возврат СтрДлина(КПП) >= 6 И Сред(КПП, 5, 2) = "50";
	
КонецФункции

// КПП контрагента из карточки: значение реквизита КПП (карта реквизитов -
// mcp.md [P3]); незаполненная или битая ссылка - пустая строка.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция КППКонтрагента(Знач Контрагент)
	
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты")
		Или НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НормализованныйКПП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "КПП"));
	
КонецФункции

// КПП справочника по предмету заявки (спека п. 2.1): текущее значение карточки
// контрагента; кэшируется в контексте - проверка применимости и сама проверка
// используют одно чтение (ЗначениеРеквизитаОбъекта кэша не имеет).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка.
//
Функция КППВСправочнике(Знач Контекст)
	
	Если Контекст.Свойство("КППВСправочнике", КПП) Тогда
		Возврат КПП;
	КонецЕсли;
	
	КПП = КППКонтрагента(Контекст.Предмет);
	Контекст.Вставить("КППВСправочнике", КПП);
	Возврат КПП;
	
КонецФункции

// Признак «обособленное подразделение» заявки - тем же способом, что признаки
// ИП: флаги ОбособленноеПодразделение / sd_ОП из модели (карта реквизитов -
// mcp.md [P3]).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоОбособленноеПодразделение(Знач Контекст)
	
	Возврат ПризнакКонтекста(Контекст, "ОбособленноеПодразделение") = Истина
		Или ПризнакКонтекста(Контекст, "sd_ОП") = Истина;
	
КонецФункции

// Головной контрагент заявки и его КПП: ссылка - из модели (реквизит
// ГоловнойКонтрагент), КПП - из карточки (спека п. 2.2); данные кэшируются в
// контексте - проверка применимости и сама проверка используют одно чтение.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура, Неопределено - {Ссылка, КПП}; Неопределено - головной не указан.
//
Функция ДанныеГоловногоКонтрагента(Знач Контекст)
	
	Если Контекст.Свойство("ДанныеГоловного", Данные) Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные = Неопределено;
	Головной = ПризнакКонтекста(Контекст, "ГоловнойКонтрагент");
	Если ТипЗнч(Головной) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Головной) Тогда
		Данные = Новый Структура("Ссылка, КПП", Головной, КППКонтрагента(Головной));
	КонецЕсли;
	
	Контекст.Вставить("ДанныеГоловного", Данные);
	Возврат Данные;
	
КонецФункции

// Значения дополнительных реквизитов заявки по программным именам: таблица
// ДополнительныеРеквизиты модели «стало» (спека п. 2.3); значения кэшируются в
// контексте - проверка применимости и сама проверка используют одно чтение.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> значение (строка); пустое - реквизитов нет.
//
Функция ЗначенияДопРеквизитовЗаявки(Знач Контекст)
	
	Если Контекст.Свойство("ЗначенияДопРеквизитов", Значения) Тогда
		Возврат Значения;
	КонецЕсли;
	
	Значения = ЗначенияДопРеквизитовПоИменам(ТаблицаМодели(Контекст.МодельСтало, "ДополнительныеРеквизиты"));
	Контекст.Вставить("ЗначенияДопРеквизитов", Значения);
	Возврат Значения;
	
КонецФункции

// Значения дополнительных реквизитов таблицы модели по программным именам
// (реквизит Имя ПВХ ДополнительныеРеквизитыИСведения, карта реквизитов -
// mcp.md [P3]): имена всех свойств таблицы читаются одним вызовом БСП, не в
// цикле к базе.
//
// Параметры:
//  Таблица - Массив - строки ТЧ ДополнительныеРеквизиты модели, см. ТаблицаМодели().
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> значение (строка).
//
Функция ЗначенияДопРеквизитовПоИменам(Знач Таблица)
	
	Свойства = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекции(СтрокаТаблицы, "Свойство");
		Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения")
			И ЗначениеЗаполнено(Свойство) Тогда
			Свойства.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
	
	Значения = Новый Соответствие;
	Если Свойства.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;
	
	ИменаСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Свойства, "Имя");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИмяРеквизита = ИменаСвойств.Получить(ЗначениеИзКоллекции(СтрокаТаблицы, "Свойство"));
		Если ТипЗнч(ИмяРеквизита) <> Тип("Строка") Или ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(ИмяРеквизита, ЗначениеСтрокиДопРеквизита(СтрокаТаблицы));
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

// Значение дополнительного реквизита строки таблицы модели: ТекстоваяСтрока,
// если заполнена, иначе Строка(Значение) (строковые дополнительные реквизиты
// БСП хранятся в ТекстоваяСтрока, карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  СтрокаТаблицы - Структура, Соответствие - строка ТЧ ДополнительныеРеквизиты модели.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеСтрокиДопРеквизита(Знач СтрокаТаблицы)
	
	ТекстоваяСтрока = ЗначениеИзКоллекции(СтрокаТаблицы, "ТекстоваяСтрока");
	Если ТипЗнч(ТекстоваяСтрока) = Тип("Строка") И НЕ ПустаяСтрока(ТекстоваяСтрока) Тогда
		Возврат СокрЛП(ТекстоваяСтрока);
	КонецЕсли;
	
	Значение = ЗначениеИзКоллекции(СтрокаТаблицы, "Значение");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

#КонецОбласти

#КонецОбласти
