// Проверка «Заполнены вид операции, юридическое / физическое лицо, юрисдикция и
// страна регистрации» (1.6.0): от этих реквизитов зависят условия применимости
// каталога - при пустом виде операции, не определенном виде лица или
// юрисдикции остальные проверки молча становились «не применима», и заявка
// проходила проверку. Страна регистрации обязательна для юрлица: от нее
// зависит проверка КПП (см. ПричинаСтранаРегистрацииНеРоссия).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаЗаполненыРеквизитыУсловийПроверок(Знач ОписаниеПроверки, Знач Контекст)

	Незаполненные = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Контекст.ВидОперации) Тогда
		Незаполненные.Добавить(НСтр("ru = '«Вид операции» заявки'"));
	КонецЕсли;
	// Вид карточки не определен только при пустом (или неизвестном) реквизите
	// «Юридическое / физическое лицо» - см. ВидКарточкиПоМодели.
	Если ПустаяСтрока(Контекст.ВидКарточки) Тогда
		Незаполненные.Добавить(НСтр("ru = '«Юридическое / физическое лицо»'"));
	КонецЕсли;
	СтранаРегистрации = ЗначениеМодели(Контекст.МодельСтало, "СтранаРегистрации");
	Если Контекст.Юрисдикция = ЮрисдикцияНеОпределена() Тогда
		Незаполненные.Добавить(НСтр("ru = '«Нерезидент» или «Страна регистрации»'"));
	КонецЕсли;
	// Юрисдикция определена по признаку «Нерезидент», а страна юрлица пуста - от
	// нее зависит проверка КПП (при неопределенной юрисдикции страна уже названа).
	Если Контекст.Юрисдикция <> ЮрисдикцияНеОпределена()
		И Контекст.ВидКонтрагента = ВидЮЛ()
		И НЕ ЗначениеЗаполнено(СтранаРегистрации) Тогда
		Незаполненные.Добавить(НСтр("ru = '«Страна регистрации» юридического лица'"));
	КонецЕсли;

	ЗначениеВЗаявке = СтрШаблон(
		НСтр("ru = 'вид операции: %1, вид контрагента: %2, юрисдикция: %3, страна регистрации: %4'"),
		ЗначениеДляВывода(Контекст.ВидОперации), ВидКарточкиДляВывода(Контекст.ВидКарточки),
		Контекст.Юрисдикция, ЗначениеДляВывода(СтранаРегистрации));

	Если Незаполненные.Количество() = 0 Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Заполнены: %1.'"), ЗначениеВЗаявке), ЗначениеВЗаявке);
	КонецЕсли;

	Пояснение = СтрШаблон(НСтр("ru = 'В заявке не заполнено: %1.'"), СтрСоединить(Незаполненные, ", "))
		+ Символы.ПС
		+ НСтр("ru = 'От этих реквизитов зависит, какие проверки выполняются: заполните их и повторите проверку.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ЗначениеВЗаявке);

КонецФункции

// Проверка «КПП юридического лица, зарегистрированного в России: 9 цифр»
// (1.6.0): у юрлица (в том числе обособленного подразделения и
// государственного органа - вид «ЮЛ») со страной регистрации «Россия» КПП
// обязателен и состоит ровно из 9 цифр.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаКППЮрлицаРФ(Знач ОписаниеПроверки, Знач Контекст)

	КПП = КППЗаявки(Контекст);

	Если ПустаяСтрока(КПП) Тогда
		Пояснение = СтрШаблон(
				НСтр("ru = 'В заявке не заполнен КПП, вид контрагента «%1», страна регистрации - Россия.'"),
				ВидКарточкиДляВывода(Контекст.ВидКарточки))
			+ Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Для юридического лица, зарегистрированного в России, КПП обязателен:
				|укажите КПП из %1 цифр.'"), ДлинаКПП());
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, КПП);
	КонецЕсли;

	Если СтрДлина(КПП) <> ДлинаКПП() Или НЕ ТолькоЦифры(КПП) Тогда
		Пояснение = СтрШаблон(
			НСтр("ru = 'КПП в заявке «%1» (длина - %2) не соответствует формату: КПП юридического лица,
			|зарегистрированного в России, состоит из %3 цифр.'"),
			КПП, СтрДлина(КПП), ДлинаКПП());
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, КПП);
	КонецЕсли;

	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		СтрШаблон(НСтр("ru = 'КПП заполнен: %1'"), КПП), КПП);

КонецФункции

// Проверка «ИНН заполнен и соответствует виду лица» (с 1.5.0 вместо «ИНН
// юридического лица заполнен»): у юрлица-резидента РФ (в том числе обособленного
// подразделения и государственного органа - вид «ЮЛ») ИНН обязателен и состоит
// из 10 цифр; у ИП - обязателен из 12 цифр; у физического лица (и самозанятого)
// ИНН не обязателен, заполненный - 12 цифр. Нормализация ИНН отсекает
// нецифровые разделители до проверки длины.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаИННПоВидуЛица(Знач ОписаниеПроверки, Знач Контекст)

	ИНН = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	ТребуемаяДлина = ?(Контекст.ВидКонтрагента = ВидЮЛ(), ДлинаИННЮЛ(), ДлинаИННФизЛица());

	Если ПустаяСтрока(ИНН) Тогда
		Если Контекст.ВидКонтрагента = ВидФЛ() Тогда
			Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
				НСтр("ru = 'ИНН не заполнен - для физического лица допускается.'"), ИНН);
		КонецЕсли;
		ТребованиеЗаполнения = ?(Контекст.ВидКонтрагента = ВидИП(),
			НСтр("ru = 'Для индивидуального предпринимателя - резидента РФ ИНН обязателен: укажите ИНН в заявке.'"),
			НСтр("ru = 'Для юридического лица - резидента РФ ИНН обязателен: укажите ИНН в заявке.'"));
		Пояснение = СтрШаблон(НСтр("ru = 'В заявке не заполнен ИНН, вид контрагента «%1», резидент РФ.'"),
				ВидКарточкиДляВывода(Контекст.ВидКарточки))
			+ Символы.ПС
			+ ТребованиеЗаполнения;
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ИНН);
	КонецЕсли;

	Если СтрДлина(ИНН) <> ТребуемаяДлина Тогда
		Пояснение = СтрШаблон(
			НСтр("ru = 'ИНН в заявке - %1 знаков, для вида контрагента «%2» требуется ИНН из %3 знаков.'"),
			СтрДлина(ИНН), ВидКарточкиДляВывода(Контекст.ВидКарточки), ТребуемаяДлина);
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ИНН);
	КонецЕсли;

	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		СтрШаблон(НСтр("ru = 'ИНН заполнен: %1'"), ИНН), ИНН);

КонецФункции

// Проверка «ИНН не меняется» (спека п. 4а): нормализованный ИНН «стало»
// отличается от «было» - не пройдена. ИНН читается из моделей заявки, ключ
// "ИНН" (карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаИНННеМеняется(Знач ОписаниеПроверки, Знач Контекст)
	
	ИННБыло = НормализованныйИНН(ЗначениеМодели(Контекст.МодельБыло, "ИНН"));
	ИННСтало = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	
	Если ИННБыло = ИННСтало Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'ИНН не изменен: %1'"), ЗначениеДляВывода(ИННСтало)), ИННСтало, ИННБыло);
	КонецЕсли;
	
	// Спека п. 4а: было X, стало Y и подсказка об оформлении новой карточки.
	Пояснение = СтрШаблон(НСтр("ru = 'Заявка меняет ИНН контрагента: было %1, стало %2.'"),
			ЗначениеДляВывода(ИННБыло), ЗначениеДляВывода(ИННСтало))
		+ Символы.ПС
		+ НСтр("ru = 'Изменение заполненного ИНН не допускается - оформите новую карточку контрагента.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ИННСтало, ИННБыло);
	
КонецФункции

// Проверка «Нет дубля» (код НетДубляИННКППНаименование): физическое лицо с
// заполненными в заявке серией и номером документа ищется по документу (1.7.0);
// документ не найден и ИНН заполнен - дальше по ИНН, КПП и наименованию, как у
// остальных контрагентов (прежняя проверка не ослабляется).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе, СсылкаВБазе}.
//
Функция ПроверкаДубляКонтрагента(Знач ОписаниеПроверки, Знач Контекст)

	Если НЕ ДубльИщетсяПоДокументу(Контекст) Тогда
		Возврат ПроверкаДубляИННКППНаименование(ОписаниеПроверки, Контекст);
	КонецЕсли;

	РезультатПоДокументу = ПроверкаДубляДокументаФизлица(ОписаниеПроверки, Контекст);
	Если РезультатПоДокументу.Статус <> СтатусПройдена()
		Или ПустаяСтрока(НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"))) Тогда
		Возврат РезультатПоДокументу;
	КонецЕсли;

	РезультатПоИНН = ПроверкаДубляИННКППНаименование(ОписаниеПроверки, Контекст);
	Если РезультатПоИНН.Статус <> СтатусПройдена() Тогда
		Возврат РезультатПоИНН;
	КонецЕсли;

	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		РезультатПоДокументу.Пояснение + Символы.ПС + РезультатПоИНН.Пояснение,
		РезультатПоДокументу.ЗначениеВЗаявке + "; " + РезультатПоИНН.ЗначениеВЗаявке);

КонецФункции

// Проверка «Нет дубля по ИНН, КПП и наименованию» (спека п. 4б): один запрос
// к Справочник.Контрагенты без помеченных на удаление (решение В3); не пройдена
// при совпадении всех трех атрибутов - наименование без учета регистра и
// крайних пробелов.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаДубляИННКППНаименование(Знач ОписаниеПроверки, Знач Контекст)
	
	ИНН = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	КПП = СокрЛП(Строка(ЗначениеМодели(Контекст.МодельСтало, "КПП")));
	Наименование = СокрЛП(Строка(ЗначениеМодели(Контекст.МодельСтало, "Наименование")));
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'ИНН %1, КПП %2, «%3»'"),
		ЗначениеДляВывода(ИНН), ЗначениеДляВывода(КПП), Наименование);
	
	// Страховка: применимость гарантирует заполненный ИНН; запрос с пустым ИНН
	// дал бы ложные совпадения по всем контрагентам без ИНН.
	Если ПустаяСтрока(ИНН) Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(),
			НСтр("ru = 'ИНН в заявке не заполнен - проверка дубля не выполнена.'"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка) КАК Представление,
		|	Контрагенты.Код КАК Код,
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП
		|	И НЕ Контрагенты.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НРег(СокрЛП(Выборка.Наименование)) <> НРег(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1 (код %2)'"), Выборка.Представление, Выборка.Код);
		Пояснение = СтрШаблон(НСтр("ru = 'Найден контрагент с теми же ИНН, КПП и наименованием: %1.'"),
				ЗначениеВБазе)
			+ Символы.ПС
			+ НСтр("ru = 'Измените КПП или наименование, либо используйте существующую карточку контрагента.'");
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
			Пояснение, ЗначениеВЗаявке, ЗначениеВБазе,
			ПолучитьНавигационнуюСсылку(Выборка.Ссылка));
		
	КонецЦикла;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		НСтр("ru = 'Контрагентов с теми же ИНН, КПП и наименованием нет.'"), ЗначениеВЗаявке);
	
КонецФункции

// Проверка «Нет второй карточки юридического лица» (1.8.0, код
// НетДубляЮЛПоОснованиюУчетаКПП): при создании юрлица ищется карточка с тем же
// ИНН, не ОП и не государственный орган, код причины КПП которой парный к коду
// заявки («01» - «50»). Такие КПП относятся к одному юрлицу и различаются
// основанием постановки на учет, поэтому полные значения КПП и наименования не
// сравниваются. Архивные, технические и ликвидированные карточки учитываются,
// как и в проверке НетДубляИННКППНаименование.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе, СсылкаВБазе}.
//
Функция ПроверкаДубляЮЛПоОснованиюУчетаКПП(Знач ОписаниеПроверки, Знач Контекст)

	ИНН = НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"));
	КППВЗаявке = КППЗаявки(Контекст);
	ПарныйКод = ПарныйКодПричиныКППЮрлица(КодПричиныКПП(КППВЗаявке));
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'ИНН %1, КПП %2'"), ИНН, КППВЗаявке);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("ПарныйКод", ПарныйКод);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка) КАК Представление,
		|	Контрагенты.Код КАК Код,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.КПП КАК КПП
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И ПОДСТРОКА(Контрагенты.КПП, 5, 2) = &ПарныйКод
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.ОбособленноеПодразделение
		|	И НЕ Контрагенты.sd_ОП
		|	И НЕ Контрагенты.ГосударственныйОрган
		|	И НЕ Контрагенты.sd_ГосударственныеОрганы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Карточек юридического лица с этим ИНН и кодом причины КПП «%1» нет.'"), ПарныйКод),
			ЗначениеВЗаявке);
	КонецЕсли;

	Ссылка = Выборка.Ссылка;
	ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1 (код %2)'"), Выборка.Представление, Выборка.Код);
	ШаблонПояснения = НСтр("ru = 'В справочнике уже существует юридическое лицо с ИНН %1, КПП %2 - %3.'")
		+ " " + НСтр("ru = 'Указанные КПП относятся к одному юридическому лицу'")
		+ " " + НСтр("ru = 'и различаются основанием постановки на налоговый учёт.'")
		+ " " + НСтр("ru = 'Создание дублирующей записи не допускается.'");
	Пояснение = СтрШаблон(ШаблонПояснения, ИНН, СокрЛП(Выборка.КПП), СокрЛП(Выборка.Наименование))
		+ Символы.ПС
		+ ПодсказкаСменыКПП(ПарныйКод);

	ОстальныеКарточки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ОстальныеКарточки.Добавить(СтрШаблон(НСтр("ru = '%1 (код %2)'"), Выборка.Представление, Выборка.Код));
	КонецЦикла;
	Если ОстальныеКарточки.Количество() > 0 Тогда
		Пояснение = Пояснение + Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Также найдены: %1.'"), СтрСоединить(ОстальныеКарточки, "; "));
	КонецЕсли;

	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
		Пояснение, ЗначениеВЗаявке, ЗначениеВБазе, ПолучитьНавигационнуюСсылку(Ссылка));

КонецФункции

// Что делать, если КПП в заявке верен, а КПП карточки устарел. Смена «50» на «01»
// запрещена проверкой КППКрупнейшегоНалогоплательщика (регламент 3.2) - ее делает
// сотрудник НСИ вручную; смена «01» на «50» проходит заявкой на изменение.
//
// Параметры:
//  КодВСправочнике - Строка - код причины КПП существующей карточки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодсказкаСменыКПП(Знач КодВСправочнике)

	Если КодВСправочнике = "50" Тогда
		Возврат НСтр("ru = 'Если организация утратила статус крупнейшего налогоплательщика,
			|смену КПП в существующей карточке выполняет сотрудник НСИ вручную.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Смену КПП оформите заявкой на изменение существующей карточки.'");

КонецФункции

// Парный код причины КПП юрлица: «01» (место нахождения) - «50» (крупнейший
// налогоплательщик).
//
// Параметры:
//  КодПричины - Строка - знаки 5-6 КПП.
//
// Возвращаемое значение:
//  Строка - парный код; "" - пары нет.
//
Функция ПарныйКодПричиныКППЮрлица(Знач КодПричины)

	Если КодПричины = "01" Тогда
		Возврат "50";
	ИначеЕсли КодПричины = "50" Тогда
		Возврат "01";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Дубль физического лица по документу (1.7.0): один запрос к Справочник.Контрагенты
// по sd_ДокументСерия и sd_ДокументНомер (значения заявки без крайних пробелов) без
// помеченных на удаление; вид документа и наименование не сравниваются. Не пройдена,
// если найден хотя бы один контрагент.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе, СсылкаВБазе}.
//
Функция ПроверкаДубляДокументаФизлица(Знач ОписаниеПроверки, Знач Контекст)

	Документ = ДокументФизлицаЗаявки(Контекст);
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'серия документа «%1», номер «%2»'"), Документ.Серия, Документ.Номер);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Серия", Документ.Серия);
	Запрос.УстановитьПараметр("Номер", Документ.Номер);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка) КАК Представление,
		|	Контрагенты.Код КАК Код
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.sd_ДокументСерия = &Серия
		|	И Контрагенты.sd_ДокументНомер = &Номер
		|	И НЕ Контрагенты.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			НСтр("ru = 'Контрагентов с теми же серией и номером документа нет.'"), ЗначениеВЗаявке);
	КонецЕсли;

	ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1 (код %2)'"), Выборка.Представление, Выборка.Код);
	Пояснение = СтрШаблон(НСтр("ru = 'Найден контрагент с теми же серией и номером документа: %1.'"),
			ЗначениеВБазе)
		+ Символы.ПС
		+ НСтр("ru = 'Проверьте серию и номер документа либо используйте существующую карточку контрагента.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
		Пояснение, ЗначениеВЗаявке, ЗначениеВБазе,
		ПолучитьНавигационнуюСсылку(Выборка.Ссылка));

КонецФункции

// Дубль ищется по документу (1.7.0): контрагент - физическое лицо (вид «ФЛ» или «ИП»,
// см. ВидКонтрагентаПоВидуКарточки), в заявке заполнены и серия, и номер документа.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Булево.
//
Функция ДубльИщетсяПоДокументу(Знач Контекст)

	Если Контекст.ВидКонтрагента <> ВидФЛ() И Контекст.ВидКонтрагента <> ВидИП() Тогда
		Возврат Ложь;
	КонецЕсли;
	Документ = ДокументФизлицаЗаявки(Контекст);
	Возврат НЕ ПустаяСтрока(Документ.Серия) И НЕ ПустаяСтрока(Документ.Номер);

КонецФункции

// Серия и номер документа физического лица из модели «стало» без крайних пробелов.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Серия, Номер} - Строка.
//
Функция ДокументФизлицаЗаявки(Знач Контекст)

	Серия = ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументСерия");
	Номер = ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументНомер");
	Возврат Новый Структура("Серия, Номер",
		?(Серия = Неопределено, "", СокрЛП(Строка(Серия))),
		?(Номер = Неопределено, "", СокрЛП(Строка(Номер))));

КонецФункции

// Проверка «Паспорт РФ: серия и номер» (спека п. 4в): серия - 4 цифры,
// номер - 6 цифр (без пробелов); отдельное пояснение для серии и для номера.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаПаспортРФСерияНомер(Знач ОписаниеПроверки, Знач Контекст)
	
	Серия = СтрокаБезПробелов(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументСерия"));
	Номер = СтрокаБезПробелов(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументНомер"));
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'серия «%1», номер «%2»'"),
		ЗначениеДляВывода(Серия), ЗначениеДляВывода(Номер));
	
	СерияВерна = СтрДлина(Серия) = ДлинаСерииПаспортаРФ() И ТолькоЦифры(Серия);
	НомерВерен = СтрДлина(Номер) = ДлинаНомераПаспортаРФ() И ТолькоЦифры(Номер);
	
	Если СерияВерна И НомерВерен Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			НСтр("ru = 'Серия и номер паспорта соответствуют формату (4 и 6 цифр).'"), ЗначениеВЗаявке);
	КонецЕсли;
	
	// Отдельное пояснение на серию и на номер (спека п. 4в).
	Пояснение = "";
	Если НЕ СерияВерна Тогда
		Пояснение = СтрШаблон(НСтр("ru = 'Серия паспорта РФ - 4 цифры, в заявке «%1».'"),
			ЗначениеДляВывода(Серия));
	КонецЕсли;
	Если НЕ НомерВерен Тогда
		ТекстНомера = СтрШаблон(НСтр("ru = 'Номер паспорта РФ - 6 цифр, в заявке «%1».'"),
			ЗначениеДляВывода(Номер));
		Пояснение = ?(ПустаяСтрока(Пояснение), ТекстНомера, Пояснение + Символы.ПС + ТекстНомера);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ЗначениеВЗаявке);
	
КонецФункции

// Проверка «Знаки 5-6 КПП соответствуют виду контрагента»: код причины
// постановки на учет (знаки 5-6 КПП) сопоставляется с видом «Обособленное
// подразделение» в заявке. Не пройдена: вид ОП и код юрлица (01, 50); вид не ОП
// и код обособленного подразделения (43, 44, 45). Остальные коды с видом не
// сопоставляются.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаКППИВидКонтрагента(Знач ОписаниеПроверки, Знач Контекст)

	КПП = КППЗаявки(Контекст);
	КодПричины = КодПричиныКПП(КПП);
	ОписаниеКода = ОписаниеКодаПричиныКПП(КодПричины);
	ВидКарточки = ВидКарточкиДляВывода(Контекст.ВидКарточки);
	ЭтоОП = Контекст.ВидКарточки = ВидКарточкиОП();
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'КПП %1, вид контрагента «%2»'"), КПП, ВидКарточки);

	ТекстКода = СтрШаблон(НСтр("ru = 'знаки 5-6 КПП «%1»'"), КодПричины)
		+ ?(ПустаяСтрока(ОписаниеКода), "", " - " + ОписаниеКода);

	Если ЭтоОП И КодыПричиныКППЮрлица().Найти(КодПричины) <> Неопределено Тогда
		Пояснение = СтрШаблон(
				НСтр("ru = 'В заявке вид контрагента «обособленное подразделение», а КПП %1 (%2) -
				|КПП юридического лица.'"),
				КПП, ТекстКода)
			+ Символы.ПС
			+ НСтр("ru = 'Создание обособленного подразделения с таким КПП запрещено: укажите КПП
				|подразделения (знаки 5-6 - 43, 44 или 45) либо вид «Юридическое лицо».'");
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ЗначениеВЗаявке);
	КонецЕсли;

	Если НЕ ЭтоОП И КодыПричиныКППОП().Найти(КодПричины) <> Неопределено Тогда
		Пояснение = СтрШаблон(
				НСтр("ru = 'КПП %1 (%2) - КПП обособленного подразделения, а вид контрагента в заявке - «%3».'"),
				КПП, ТекстКода, ВидКарточки)
			+ Символы.ПС
			+ НСтр("ru = 'Создание запрещено: укажите вид «Обособленное подразделение» и головного
				|контрагента либо исправьте КПП.'");
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ЗначениеВЗаявке);
	КонецЕсли;

	Если ПустаяСтрока(ОписаниеКода) Тогда
		Пояснение = СтрШаблон(НСтр("ru = 'КПП %1: %2 - с видом контрагента не сопоставляются.'"), КПП, ТекстКода);
	Иначе
		Пояснение = СтрШаблон(НСтр("ru = 'КПП %1: %2 - соответствует виду «%3».'"), КПП, ТекстКода, ВидКарточки);
	КонецЕсли;
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(), Пояснение, ЗначениеВЗаявке);

КонецФункции

// Проверка «Индивидуальный предприниматель не меняет вид»: в карточке
// («было») вид - ИП, в заявке («стало») - другой вид - не пройдена; переход ИП
// в другой вид через форму запрещен, нужна заявка на новое физическое лицо.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаИПНеМеняетВид(Знач ОписаниеПроверки, Знач Контекст)

	ВидБыло = ВидКарточкиДляВывода(Контекст.ВидКарточкиБыло);
	ВидСтало = ВидКарточкиДляВывода(Контекст.ВидКарточки);

	Если Контекст.ВидКарточки = ВидКарточкиИП() Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Вид контрагента не изменен: %1.'"), ВидСтало), ВидСтало, ВидБыло);
	КонецЕсли;

	Пояснение = СтрШаблон(НСтр("ru = 'Заявка меняет вид контрагента: было «%1», стало «%2».'"), ВидБыло, ВидСтало)
		+ Символы.ПС
		+ НСтр("ru = 'Переход индивидуального предпринимателя в другой вид через форму запрещен -
			|заявку отклонить, создать заявку на новое физическое лицо.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, ВидСтало, ВидБыло);

КонецФункции

// Проверка «Паспорт РФ: код подразделения»: код подразделения паспорта РФ -
// 6 цифр по шаблону ХХХ-ХХХ.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаПаспортРФКодПодразделения(Знач ОписаниеПроверки, Знач Контекст)

	КодПодразделения = СокрЛП(Строка(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументКодПодразделения")));

	Если КодПодразделенияВерен(КодПодразделения) Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Код подразделения «%1» соответствует шаблону ХХХ-ХХХ.'"), КодПодразделения),
			КодПодразделения);
	КонецЕсли;

	Пояснение = СтрШаблон(
		НСтр("ru = 'Код подразделения паспорта РФ - 6 цифр по шаблону ХХХ-ХХХ (например, 770-001), в заявке «%1».'"),
		КодПодразделения);
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, КодПодразделения);

КонецФункции

// Проверка «У контрагента ВГО меняются только телефон и электронная почта»: модели
// «было» и «стало» сравниваются по реквизитам, стандартным реквизитам и
// табличным частям; в ТЧ КонтактнаяИнформация строки телефона и электронной почты не
// сравниваются, служебные Код и Ссылка моделей и головной контрагент «сам себе» -
// тоже (см. ИзмененияКромеКонтактов). Любое другое изменение - не пройдена.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаВГОМеняютсяТолькоКонтакты(Знач ОписаниеПроверки, Знач Контекст)

	Изменения = ИзмененияКромеКонтактов(Контекст.МодельБыло, Контекст.МодельСтало, Контекст.Предмет);

	Если Изменения.Количество() = 0 Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			НСтр("ru = 'Заявка не меняет данные контрагента ВГО, кроме телефона и электронной почты.'"));
	КонецЕсли;

	СписокИзменений = СтрСоединить(Изменения, ", ");
	Пояснение = СтрШаблон(
			НСтр("ru = 'Контрагент входит в ВГО: по заявке можно менять только телефон и электронную почту,
			|а заявка меняет также: %1.'"),
			СписокИзменений)
		+ Символы.ПС
		+ НСтр("ru = 'Уберите из заявки изменения, кроме телефона и электронной почты.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение, СписокИзменений);

КонецФункции

// Проверка-запрет снятия признака контрагента (1.5.0, по одной на признак -
// ЖКХ и ЗУП): признак установлен в карточке («было»), а в заявке («стало»)
// снят - не пройдена. Отсутствие ключа признака в модели - то же, что Ложь
// (ПризнакМоделиУстановлен: установлен - только Истина).
//
// Параметры:
//  ОписаниеПроверки      - Структура - см. ДобавитьПроверку().
//  Контекст              - Структура - см. КонтекстПроверки().
//  ИмяПризнака           - Строка    - имя булева реквизита Контрагентов.
//  ПредставлениеПризнака - Строка    - представление признака для текста.
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаПризнакНеСнимается(Знач ОписаниеПроверки, Знач Контекст,
	Знач ИмяПризнака, Знач ПредставлениеПризнака)

	Если НЕ ПризнакМоделиУстановлен(Контекст.МодельБыло, ИмяПризнака)
		Или ПризнакМоделиУстановлен(Контекст.МодельСтало, ИмяПризнака) Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Признак «%1» не снимается.'"), ПредставлениеПризнака));
	КонецЕсли;

	Пояснение = СтрШаблон(
			НСтр("ru = 'В карточке контрагента установлен признак «%1», заявка его снимает.'"),
			ПредставлениеПризнака)
		+ Символы.ПС
		+ НСтр("ru = 'Снятие признака не допускается - восстановите признак в заявке.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение);

КонецФункции

// Проверка «Адрес электронной почты»: каждый адрес заявки (табличная часть
// КонтактнаяИнформация модели «стало») - ровно один «@», без пробелов и
// непечатных символов, структура имя@домен.зона - методом БСП
// ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям.
// По каждому неверному адресу - отдельное пояснение.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе}.
//
Функция ПроверкаАдресаЭлектроннойПочты(Знач ОписаниеПроверки, Знач Контекст)

	Адреса = АдресаЭлектроннойПочтыЗаявки(Контекст);
	ЗначениеВЗаявке = СтрСоединить(Адреса, "; ");

	Ошибки = Новый Массив;
	Для Каждого Адрес Из Адреса Цикл
		ОшибкаАдреса = ОшибкаАдресаЭлектроннойПочты(Адрес);
		Если НЕ ПустаяСтрока(ОшибкаАдреса) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Адрес «%1»: %2.'"), Адрес, ОшибкаАдреса));
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() = 0 Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Адреса электронной почты соответствуют формату: %1.'"), ЗначениеВЗаявке),
			ЗначениеВЗаявке);
	КонецЕсли;

	Ошибки.Добавить(НСтр("ru = 'Исправьте адрес: одна запись - один адрес вида имя@домен.зона.'"));
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
		СтрСоединить(Ошибки, Символы.ПС), ЗначениеВЗаявке);

КонецФункции

// Ошибка адреса электронной почты словами: число «@», пробелы, непечатные
// символы; если их нет - структура адреса методом БСП.
//
// Параметры:
//  Адрес - Строка - адрес как в заявке, без обрезки пробелов.
//
// Возвращаемое значение:
//  Строка - описание ошибок через «; »; "" - адрес верен.
//
Функция ОшибкаАдресаЭлектроннойПочты(Знач Адрес)

	Ошибки = Новый Массив;

	ЧислоСобак = СтрЧислоВхождений(Адрес, "@");
	Если ЧислоСобак <> 1 Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = 'символ «@» встречается %1 раз(а), нужен ровно один'"), ЧислоСобак));
	КонецЕсли;

	ОшибкаСимволов = ОшибкаСимволовАдреса(Адрес);
	Если НЕ ПустаяСтрока(ОшибкаСимволов) Тогда
		Ошибки.Добавить(ОшибкаСимволов);
	КонецЕсли;

	Если Ошибки.Количество() = 0
		И НЕ ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(Адрес) Тогда
		Ошибки.Добавить(НСтр("ru = 'структура адреса не соответствует формату имя@домен.зона (недопустимые
			|символы, две точки подряд, точка или дефис в начале или конце домена, нет зоны домена)'"));
	КонецЕсли;

	Возврат СтрСоединить(Ошибки, "; ");

КонецФункции

// Пробелы и непечатные символы в адресе: пробел и неразрывный пробел -
// «пробелы»; управляющие символы, символы нулевой ширины и метка порядка
// байтов - «непечатные символы» с кодами (см. ЭтоНепечатныйСимвол).
//
// Параметры:
//  Адрес - Строка.
//
// Возвращаемое значение:
//  Строка - описание найденного; "" - таких символов нет.
//
Функция ОшибкаСимволовАдреса(Знач Адрес)

	ЕстьПробелы = Ложь;
	КодыНепечатных = Новый Массив;
	Для Индекс = 1 По СтрДлина(Адрес) Цикл

		Символ = Сред(Адрес, Индекс, 1);
		Код = КодСимвола(Символ);
		Если Символ = " " Или Символ = Символы.НПП Тогда
			ЕстьПробелы = Истина;
		ИначеЕсли ЭтоНепечатныйСимвол(Код) И КодыНепечатных.Найти(Код) = Неопределено Тогда
			КодыНепечатных.Добавить(Код);
		Иначе
			// Печатный символ или код уже учтен.
			Продолжить;
		КонецЕсли;

	КонецЦикла;

	Части = Новый Массив;
	Если ЕстьПробелы Тогда
		Части.Добавить(НСтр("ru = 'есть пробелы'"));
	КонецЕсли;
	Если КодыНепечатных.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'есть непечатные символы (коды %1)'"),
			СтрСоединить(КодыНепечатных, ", ")));
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Непечатный символ по коду: управляющие символы (0-31, 127-159), символы
// нулевой ширины (8203-8205, 8288) и метка порядка байтов (65279).
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоНепечатныйСимвол(Знач Код)

	ПоследнийУправляющий = 31;
	НачалоУправляющихС1 = 127;
	КонецУправляющихС1 = 159;
	НачалоНулевойШирины = 8203;
	КонецНулевойШирины = 8205;
	СоединительСлов = 8288;
	МеткаПорядкаБайтов = 65279;

	Возврат Код <= ПоследнийУправляющий
		Или (Код >= НачалоУправляющихС1 И Код <= КонецУправляющихС1)
		Или (Код >= НачалоНулевойШирины И Код <= КонецНулевойШирины)
		Или Код = СоединительСлов
		Или Код = МеткаПорядкаБайтов;

КонецФункции

// Адреса электронной почты из заявки: строки табличной части
// КонтактнаяИнформация модели «стало» с типом АдресЭлектроннойПочты; адрес -
// колонка АдресЭП, при пустой - Представление. Значение не обрезается:
// пробелы по краям - тоже ошибка адреса.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Массив из Строка - непустые адреса.
//
Функция АдресаЭлектроннойПочтыЗаявки(Знач Контекст)

	Адреса = Новый Массив;
	СтрокиКИ = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Контекст.МодельСтало, "ТабличныеЧасти"),
		"КонтактнаяИнформация");
	Если ТипЗнч(СтрокиКИ) <> Тип("Массив") Тогда
		Возврат Адреса;
	КонецЕсли;

	ТипАдресаЭП = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	Для Каждого СтрокаКИ Из СтрокиКИ Цикл

		Если ТипКонтактнойИнформацииСтроки(СтрокаКИ) <> ТипАдресаЭП Тогда
			Продолжить;
		КонецЕсли;

		Адрес = ЗначениеИзКоллекции(СтрокаКИ, "АдресЭП");
		Если ТипЗнч(Адрес) <> Тип("Строка") Или ПустаяСтрока(Адрес) Тогда
			Адрес = ЗначениеИзКоллекции(СтрокаКИ, "Представление");
		КонецЕсли;
		Если ТипЗнч(Адрес) = Тип("Строка") И НЕ ПустаяСтрока(Адрес) Тогда
			Адреса.Добавить(Адрес);
		КонецЕсли;

	КонецЦикла;
	Возврат Адреса;

КонецФункции

// Тип контактной информации строки табличной части модели: колонка
// type_description (протокол «БИТ», карта реквизитов agentrunner-30), при ее
// отсутствии - Тип.
//
// Параметры:
//  СтрокаКИ - Структура, Соответствие - строка ТЧ КонтактнаяИнформация.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ТипыКонтактнойИнформации, Неопределено.
//
Функция ТипКонтактнойИнформацииСтроки(Знач СтрокаКИ)

	ТипКИ = ЗначениеИзКоллекции(СтрокаКИ, "type_description");
	Если ТипКИ = Неопределено Тогда
		ТипКИ = ЗначениеИзКоллекции(СтрокаКИ, "Тип");
	КонецЕсли;
	Возврат ТипКИ;

КонецФункции

// Вид документа в заявке («стало») - «Паспорт гражданина РФ»: сравнение по
// ссылке на предопределенный элемент (решение В2 задачи FANDIT-18887).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Булево.
//
Функция ДокументЗаявкиПаспортРФ(Знач Контекст)
	
	ВидДокумента = ЗначениеМодели(Контекст.МодельСтало, "sd_ВидДокумента");
	ПаспортРФ = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
	Если ВидДокумента = ПаспортРФ Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Модель могла прийти с представлением вместо ссылки или с другим
	// элементом справочника с тем же наименованием: сравниваем по наименованию.
	Если ТипЗнч(ВидДокумента) = Тип("Строка")
		Или ТипЗнч(ВидДокумента) = Тип("СправочникСсылка.ВидыДокументовФизическихЛиц") Тогда
		Возврат ВРег(СокрЛП(Строка(ВидДокумента))) = ВРег(СокрЛП(Строка(ПаспортРФ)));
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

// КПП из заявки («стало») без крайних пробелов.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка.
//
Функция КППЗаявки(Знач Контекст)

	КПП = ЗначениеМодели(Контекст.МодельСтало, "КПП");
	Возврат ?(ТипЗнч(КПП) = Тип("Строка"), СокрЛП(КПП), "");

КонецФункции

// Код причины постановки на учет - знаки 5-6 КПП.
//
// Параметры:
//  КПП - Строка.
//
// Возвращаемое значение:
//  Строка - два знака; "" - КПП короче 6 знаков.
//
Функция КодПричиныКПП(Знач КПП)

	ПозицияКода = 5;
	ДлинаКода = 2;
	Если СтрДлина(КПП) < ПозицияКода + ДлинаКода - 1 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(КПП, ПозицияКода, ДлинаКода);

КонецФункции

// Коды причины КПП юридического лица (не обособленного подразделения).
//
// Возвращаемое значение:
//  Массив из Строка - "01", "50".
//
Функция КодыПричиныКППЮрлица()

	Коды = Новый Массив;
	Коды.Добавить("01");
	Коды.Добавить("50");
	Возврат Коды;

КонецФункции

// Коды причины КПП обособленного подразделения.
//
// Возвращаемое значение:
//  Массив из Строка - "43", "44", "45".
//
Функция КодыПричиныКППОП()

	Коды = Новый Массив;
	Коды.Добавить("43");
	Коды.Добавить("44");
	Коды.Добавить("45");
	Возврат Коды;

КонецФункции

// Описание кода причины КПП (знаки 5-6) для текста пользователю.
//
// Параметры:
//  КодПричины - Строка - знаки 5-6 КПП.
//
// Возвращаемое значение:
//  Строка - описание; "" - код не сопоставляется с видом контрагента.
//
Функция ОписаниеКодаПричиныКПП(Знач КодПричины)

	Если КодПричины = "01" Тогда
		Возврат НСтр("ru = 'головная организация, учет по месту нахождения (ЮЛ)'");
	ИначеЕсли КодПричины = "43" Тогда
		Возврат НСтр("ru = 'филиал (ОП)'");
	ИначеЕсли КодПричины = "44" Тогда
		Возврат НСтр("ru = 'представительство (ОП)'");
	ИначеЕсли КодПричины = "45" Тогда
		Возврат НСтр("ru = 'иное обособленное подразделение (ОП)'");
	ИначеЕсли КодПричины = "50" Тогда
		Возврат НСтр("ru = 'крупнейший налогоплательщик (ЮЛ)'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Код подразделения паспорта РФ соответствует шаблону ХХХ-ХХХ (Х - цифра).
//
// Параметры:
//  КодПодразделения - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция КодПодразделенияВерен(Знач КодПодразделения)

	ДлинаЧасти = 3;
	ПозицияДефиса = ДлинаЧасти + 1;
	Если СтрДлина(КодПодразделения) <> ПозицияДефиса + ДлинаЧасти Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Сред(КодПодразделения, ПозицияДефиса, 1) = "-"
		И ТолькоЦифры(Лев(КодПодразделения, ДлинаЧасти))
		И ТолькоЦифры(Прав(КодПодразделения, ДлинаЧасти));

КонецФункции

// Что меняет заявка, кроме телефона и электронной почты: реквизиты и стандартные
// реквизиты с разными значениями «было» и «стало», табличные части с разными
// строками (в ТЧ КонтактнаяИнформация строки телефона и электронной почты не сравниваются).
// Не сравниваются служебные Код и Ссылка: у моделей «было» и «стало» они свои,
// пользователь их не меняет (заявка 00-00093887: Код 00-770586 и 00-770600),
// и РасширенноеПредставлениеИНН / РасширенноеПредставлениеКПП - их формирует
// форма контрагента по ИНН и КПП (заявка 00-00093919).
// «Головной контрагент» не сравнивается, если в обеих моделях головной - сам
// контрагент (см. ГоловнойКонтрагентНеМеняется).
//
// Параметры:
//  МодельБыло  - Структура, Соответствие - модель «было».
//  МодельСтало - Структура, Соответствие - модель «стало».
//  Предмет     - СправочникСсылка.Контрагенты, Неопределено - предмет заявки.
//
// Возвращаемое значение:
//  Массив из Строка - представления измененных реквизитов и табличных частей.
//
Функция ИзмененияКромеКонтактов(Знач МодельБыло, Знач МодельСтало, Знач Предмет)

	МетаданныеКонтрагентов = Метаданные.Справочники.Контрагенты;
	Изменения = Новый Массив;

	НеСравниваемые = СтрРазделить("Код,Ссылка,РасширенноеПредставлениеИНН,РасширенноеПредставлениеКПП", ",");
	Если ГоловнойКонтрагентНеМеняется(МодельБыло, МодельСтало, Предмет) Тогда
		НеСравниваемые.Добавить("ГоловнойКонтрагент");
	КонецЕсли;

	Для Каждого ИмяГруппы Из СтрРазделить("Реквизиты,СтандартныеРеквизиты", ",") Цикл
		ГруппаБыло = ЗначениеИзКоллекции(МодельБыло, ИмяГруппы);
		ГруппаСтало = ЗначениеИзКоллекции(МодельСтало, ИмяГруппы);
		Для Каждого Ключ Из КлючиКоллекций(ГруппаБыло, ГруппаСтало) Цикл
			Если НеСравниваемые.Найти(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеБыло = ЗначениеИзКоллекции(ГруппаБыло, Ключ);
			Если НЕ ЗначенияМоделиРавны(ЗначениеБыло, ЗначениеИзКоллекции(ГруппаСтало, Ключ)) Тогда
				Изменения.Добавить(ПредставлениеЭлементаМетаданных(МетаданныеКонтрагентов.Реквизиты, Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ТЧБыло = ЗначениеИзКоллекции(МодельБыло, "ТабличныеЧасти");
	ТЧСтало = ЗначениеИзКоллекции(МодельСтало, "ТабличныеЧасти");
	Для Каждого ИмяТЧ Из КлючиКоллекций(ТЧБыло, ТЧСтало) Цикл

		СтрокиБыло = ЗначениеИзКоллекции(ТЧБыло, ИмяТЧ);
		СтрокиСтало = ЗначениеИзКоллекции(ТЧСтало, ИмяТЧ);
		ЭтоКонтакты = ИмяТЧ = "КонтактнаяИнформация";
		Если ЭтоКонтакты Тогда
			СтрокиБыло = СтрокиБезТелефонаИПочты(СтрокиБыло);
			СтрокиСтало = СтрокиБезТелефонаИПочты(СтрокиСтало);
		КонецЕсли;

		Если НЕ ЗначенияМоделиРавны(СтрокиБыло, СтрокиСтало) Тогда
			ПредставлениеТЧ = СтрШаблон(НСтр("ru = 'табличная часть «%1»'"),
				ПредставлениеЭлементаМетаданных(МетаданныеКонтрагентов.ТабличныеЧасти, ИмяТЧ));
			Если ЭтоКонтакты Тогда
				ПредставлениеТЧ = ПредставлениеТЧ + " " + НСтр("ru = '(кроме телефона и электронной почты)'");
			КонецЕсли;
			Изменения.Добавить(ПредставлениеТЧ);
		КонецЕсли;

	КонецЦикла;

	Возврат Изменения;

КонецФункции

// «Головной контрагент» заявкой не меняется: значения моделей равны или в обеих
// моделях головной - сам контрагент (см. ГоловнойЭтоСамКонтрагент). Модели «было»
// и «стало» - отдельные объекты-копии, головной в каждой ссылается на свою копию,
// которой в базе нет (заявка 00-00093887).
//
// Параметры:
//  МодельБыло  - Структура, Соответствие - модель «было».
//  МодельСтало - Структура, Соответствие - модель «стало».
//  Предмет     - СправочникСсылка.Контрагенты, Неопределено - предмет заявки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ГоловнойКонтрагентНеМеняется(Знач МодельБыло, Знач МодельСтало, Знач Предмет)

	ГоловнойБыло = ЗначениеМодели(МодельБыло, "ГоловнойКонтрагент");
	ГоловнойСтало = ЗначениеМодели(МодельСтало, "ГоловнойКонтрагент");
	Если ЗначенияМоделиРавны(ГоловнойБыло, ГоловнойСтало) Тогда
		Возврат Истина;
	КонецЕсли;

	Существующие = СуществующиеКонтрагенты(ОбаЗначения(ГоловнойБыло, ГоловнойСтало));
	Возврат ГоловнойЭтоСамКонтрагент(ГоловнойБыло, МодельБыло, Предмет, Существующие)
		И ГоловнойЭтоСамКонтрагент(ГоловнойСтало, МодельСтало, Предмет, Существующие);

КонецФункции

// Головной контрагент модели - сам контрагент: не заполнен, равен предмету заявки
// или ссылке самой модели, либо ссылается на элемент, которого в базе нет
// (ссылка на объект-копию модели).
//
// Параметры:
//  Головной     - Произвольный - значение реквизита ГоловнойКонтрагент модели.
//  Модель       - Структура, Соответствие - модель «было» или «стало».
//  Предмет      - СправочникСсылка.Контрагенты, Неопределено - предмет заявки.
//  Существующие - Массив из СправочникСсылка.Контрагенты - см. СуществующиеКонтрагенты.
//
// Возвращаемое значение:
//  Булево.
//
Функция ГоловнойЭтоСамКонтрагент(Знач Головной, Знач Модель, Знач Предмет, Знач Существующие)

	Если ПустоеЗначениеМодели(Головной) Или Головной = Предмет
		Или Головной = ЗначениеМодели(Модель, "Ссылка") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ТипЗнч(Головной) = Тип("СправочникСсылка.Контрагенты")
		И Существующие.Найти(Головной) = Неопределено;

КонецФункции

// Контрагенты из списка, которые есть в базе: одним запросом; значения других
// типов и пустые ссылки не проверяются.
//
// Параметры:
//  Значения - Массив из Произвольный - проверяемые значения.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты.
//
Функция СуществующиеКонтрагенты(Знач Значения)

	Ссылки = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Значение) Тогда
			Ссылки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Ссылки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Ссылки)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Строки ТЧ КонтактнаяИнформация модели без строк телефона и электронной почты. Тип
// контактной информации - колонка type_description (протокол «БИТ», карта
// реквизитов agentrunner-30), при ее отсутствии - Тип.
//
// Параметры:
//  СтрокиТЧ - Массив, произвольное - строки ТЧ модели.
//
// Возвращаемое значение:
//  Массив, произвольное - отобранные строки; не массив - как есть.
//
Функция СтрокиБезТелефонаИПочты(Знач СтрокиТЧ)

	Если ТипЗнч(СтрокиТЧ) <> Тип("Массив") Тогда
		Возврат СтрокиТЧ;
	КонецЕсли;

	Отобранные = Новый Массив;
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл

		ТипКИ = ТипКонтактнойИнформацииСтроки(СтрокаТЧ);
		Если ТипКИ <> Перечисления.ТипыКонтактнойИнформации.Телефон
			И ТипКИ <> Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			Отобранные.Добавить(СтрокаТЧ);
		КонецЕсли;

	КонецЦикла;
	Возврат Отобранные;

КонецФункции

// Ключи двух коллекций модели (Структура или Соответствие) без повторов: сначала
// ключи первой, затем недостающие ключи второй.
//
// Параметры:
//  Первая - Структура, Соответствие, произвольное.
//  Вторая - Структура, Соответствие, произвольное.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция КлючиКоллекций(Знач Первая, Знач Вторая)

	Ключи = Новый Массив;
	Для Каждого Коллекция Из ОбаЗначения(Первая, Вторая) Цикл
		Если ТипЗнч(Коллекция) <> Тип("Структура") И ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Коллекция Цикл
			Если Ключи.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
				Ключи.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Массив из двух значений - для общего обхода пары коллекций.
//
// Параметры:
//  Первое - Произвольный.
//  Второе - Произвольный.
//
// Возвращаемое значение:
//  Массив.
//
Функция ОбаЗначения(Знач Первое, Знач Второе)

	Значения = Новый Массив;
	Значения.Добавить(Первое);
	Значения.Добавить(Второе);
	Возврат Значения;

КонецФункции

// Значения модели равны: коллекции - по ключам / по строкам в том же порядке,
// строки - без пробелов и переводов строки по краям (заявка 00-00093919:
// «было» с переводом строки в конце), прочие - сравнением; отсутствующее
// значение равно пустому (ключа нет в одной модели, а в другой - пустая строка,
// Ложь, пустая ссылка).
//
// Параметры:
//  Первое - Произвольный - значение модели «было».
//  Второе - Произвольный - значение модели «стало».
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗначенияМоделиРавны(Знач Первое, Знач Второе)

	Если ЭтоКоллекцияСКлючами(Первое) Или ЭтоКоллекцияСКлючами(Второе) Тогда
		Для Каждого Ключ Из КлючиКоллекций(Первое, Второе) Цикл
			Если НЕ ЗначенияМоделиРавны(ЗначениеИзКоллекции(Первое, Ключ), ЗначениеИзКоллекции(Второе, Ключ)) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Первое) = Тип("Массив") Или ТипЗнч(Второе) = Тип("Массив") Тогда
		Возврат МассивыМоделиРавны(Первое, Второе);
	КонецЕсли;

	Если Первое = Второе Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Первое) = Тип("Строка") И ТипЗнч(Второе) = Тип("Строка") Тогда
		Возврат СокрЛП(Первое) = СокрЛП(Второе);
	КонецЕсли;
	Возврат ПустоеЗначениеМодели(Первое) И ПустоеЗначениеМодели(Второе);

КонецФункции

// Массивы строк модели равны: одинаковое количество, попарно равные элементы;
// не массив считается пустым массивом.
//
// Параметры:
//  Первый - Массив, произвольное.
//  Второй - Массив, произвольное.
//
// Возвращаемое значение:
//  Булево.
//
Функция МассивыМоделиРавны(Знач Первый, Знач Второй)

	Если ТипЗнч(Первый) <> Тип("Массив") Тогда
		Первый = Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Второй) <> Тип("Массив") Тогда
		Второй = Новый Массив;
	КонецЕсли;

	Если Первый.Количество() <> Второй.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Первый.ВГраница() Цикл
		Если НЕ ЗначенияМоделиРавны(Первый[Индекс], Второй[Индекс]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Значение - коллекция модели с ключами (Структура или Соответствие).
//
// Параметры:
//  Значение - Произвольный.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКоллекцияСКлючами(Знач Значение)
	Возврат ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие");
КонецФункции

// Пустое значение модели: Неопределено, Null или незаполненный примитив / ссылка.
//
// Параметры:
//  Значение - Произвольный - не коллекция.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПустоеЗначениеМодели(Знач Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ПустаяСтрока(Значение);
	КонецЕсли;
	Возврат НЕ ЗначениеЗаполнено(Значение);

КонецФункции

// Представление реквизита или табличной части Контрагентов: синоним из
// метаданных, для стандартных реквизитов и неизвестных имен - имя.
//
// Параметры:
//  Коллекция - КоллекцияОбъектовМетаданных - реквизиты или табличные части.
//  Имя       - Строка - имя элемента.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПредставлениеЭлементаМетаданных(Знач Коллекция, Знач Имя)

	Элемент = Коллекция.Найти(Имя);
	Если Элемент = Неопределено Или ПустаяСтрока(Элемент.Синоним) Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Элемент.Синоним;

КонецФункции

// ИНН только из цифр: разделители и оформление отбрасываются (спека п. 4а -
// «нормализованный ИНН (только цифры)»).
//
// Параметры:
//  Значение - Строка, Число, произвольное.
//
// Возвращаемое значение:
//  Строка - только цифры значения.
//
Функция НормализованныйИНН(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	Иначе
		Возврат ЦифрыСтроки(Значение);
	КонецЕсли;
	
КонецФункции

// Только цифры строки: разделители и оформление отбрасываются.
//
// Параметры:
//  Строка - Строка.
//
// Возвращаемое значение:
//  Строка - только цифры.
//
Функция ЦифрыСтроки(Знач Строка)
	
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;
	
КонецФункции

// Строка значения без пробелов: «12 3» -> «123» (спека п. 4в - «после удаления
// пробелов»); нестроковые значения приводятся к строке.
//
// Параметры:
//  Значение - Строка, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаБезПробелов(Знач Значение)
	Возврат СтрЗаменить(Строка(Значение), " ", "");
КонецФункции

// Длина серии паспорта РФ (спека п. 4в: 4 цифры); единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаСерииПаспортаРФ()
	Возврат 4;
КонецФункции

// Длина номера паспорта РФ (спека п. 4в: 6 цифр); единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаНомераПаспортаРФ()
	Возврат 6;
КонецФункции

// Длина ИНН юридического лица - 10 знаков (Приказ ФНС России от 29.06.2012
// N ММВ-7-6/435@, подтверждение длин - mcp.md [P1]); единая точка.
//
// Возвращаемое значение:
//  Число - количество знаков ИНН.
//
Функция ДлинаИННЮЛ()
	Возврат 10;
КонецФункции

// Длина ИНН физического лица и индивидуального предпринимателя - 12 знаков
// (тот же приказ); единая точка.
//
// Возвращаемое значение:
//  Число - количество знаков ИНН.
//
Функция ДлинаИННФизЛица()
	Возврат 12;
КонецФункции

// Длина КПП юридического лица, зарегистрированного в России, - 9 цифр; единая точка.
//
// Возвращаемое значение:
//  Число - количество знаков КПП.
//
Функция ДлинаКПП()
	Возврат 9;
КонецФункции

// Все символы строки - цифры; пустая строка - Ложь (пустая серия - не «4 цифры»).
//
// Параметры:
//  Строка - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТолькоЦифры(Знач Строка)
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

// Значение для текста пользователю: пустое значение - «(пусто)».
//
// Параметры:
//  Значение - Строка, произвольное.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеДляВывода(Знач Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = Строка(Значение);
	КонецЕсли;
	Возврат ?(ПустаяСтрока(Значение), НСтр("ru = '(пусто)'"), Значение);
	
КонецФункции

#КонецОбласти

#Область КППОПКрупнейшегоИБанковскийСчет

// Табличная часть модели: строки таблицы по имени (группа «ТабличныеЧасти»);
// отсутствие модели, группы или таблицы - пустой массив: проверка «не
// применима», а не ошибка (спека п. 2.3).
//
// Параметры:
//  Модель     - Структура, Соответствие, Неопределено - модель предмета заявки.
//  ИмяТаблицы - Строка - имя табличной части предмета ("ДополнительныеРеквизиты").
//
// Возвращаемое значение:
//  Массив из Структура, Соответствие - строки табличной части; пустой массив,
//  если таблицы в модели нет.
//
Функция ТаблицаМодели(Знач Модель, Знач ИмяТаблицы)
	
	Таблица = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "ТабличныеЧасти"), ИмяТаблицы);
	Если ТипЗнч(Таблица) = Тип("Массив") Тогда
		Возврат Таблица;
	КонецЕсли;
	Возврат Новый Массив;
	
КонецФункции

// КПП строкой без крайних пробелов: нестроковое или отсутствующее значение -
// пустая строка (реквизит КПП - строка, карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  Значение - Строка, произвольное - значение КПП.
//
// Возвращаемое значение:
//  Строка - КПП без крайних пробелов; нестроковое значение - пустая строка.
//
Функция НормализованныйКПП(Знач Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
	
КонецФункции

// Признак КПП крупнейшего налогоплательщика (спека п. 2.1): 5-6 знаки КПП -
// «50»; пустой или короткий КПП - признака нет, без исключения.
//
// Параметры:
//  КПП - Строка - КПП, см. НормализованныйКПП().
//
// Возвращаемое значение:
//  Булево - Истина, если 5-6 знаки КПП равны «50».
//
Функция ЭтоКППКрупнейшегоНалогоплательщика(Знач КПП)
	
	Возврат СтрДлина(КПП) >= 6 И Сред(КПП, 5, 2) = "50";
	
КонецФункции

// КПП контрагента из карточки: значение реквизита КПП (карта реквизитов -
// mcp.md [P3]); незаполненная или битая ссылка - пустая строка.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, произвольное - ссылка на контрагента.
//
// Возвращаемое значение:
//  Строка - КПП контрагента; незаполненная ссылка - пустая строка.
//
Функция КППКонтрагента(Знач Контрагент)
	
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты")
		Или НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НормализованныйКПП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "КПП"));
	
КонецФункции

// КПП справочника по предмету заявки (спека п. 2.1): текущее значение карточки
// контрагента; кэшируется в контексте - проверка применимости и сама проверка
// используют одно чтение (ЗначениеРеквизитаОбъекта кэша не имеет).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - КПП карточки предмета заявки; нет предмета - пустая строка.
//
Функция КППВСправочнике(Знач Контекст)

	Перем КПП;

	Если Контекст.Свойство("КППВСправочнике", КПП) Тогда
		Возврат КПП;
	КонецЕсли;
	
	КПП = КППКонтрагента(Контекст.Предмет);
	Контекст.Вставить("КППВСправочнике", КПП);
	Возврат КПП;
	
КонецФункции

// Признак «обособленное подразделение» заявки: вид карточки «стало» - обособленное
// подразделение (см. ВидКарточкиПоМодели; признаки ОбособленноеПодразделение / sd_ОП
// из заявки, модель «было» не подставляется).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Булево - Истина, если заявка на обособленное подразделение.
//
Функция ЭтоОбособленноеПодразделение(Знач Контекст)
	
	Возврат Контекст.ВидКарточки = ВидКарточкиОП();
	
КонецФункции

// Головной контрагент заявки и его КПП: ссылка - из модели (реквизит
// ГоловнойКонтрагент), КПП - из карточки (спека п. 2.2); данные кэшируются в
// контексте - проверка применимости и сама проверка используют одно чтение.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура, Неопределено - {Ссылка, КПП}; Неопределено - головной не указан.
//
Функция ДанныеГоловногоКонтрагента(Знач Контекст)

	Перем Данные;

	Если Контекст.Свойство("ДанныеГоловного", Данные) Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные = Неопределено;
	Головной = ЗначениеМодели(Контекст.МодельСтало, "ГоловнойКонтрагент");
	Если ТипЗнч(Головной) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Головной) Тогда
		Данные = Новый Структура("Ссылка, КПП", Головной, КППКонтрагента(Головной));
	КонецЕсли;
	
	Контекст.Вставить("ДанныеГоловного", Данные);
	Возврат Данные;
	
КонецФункции

// Значения дополнительных реквизитов заявки по программным именам: таблица
// ДополнительныеРеквизиты модели «стало» (спека п. 2.3); значения кэшируются в
// контексте - проверка применимости и сама проверка используют одно чтение.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> значение (строка); пустое - реквизитов нет.
//
Функция ЗначенияДопРеквизитовЗаявки(Знач Контекст)

	Перем Значения;

	Если Контекст.Свойство("ЗначенияДопРеквизитов", Значения) Тогда
		Возврат Значения;
	КонецЕсли;
	
	Значения = ЗначенияДопРеквизитовПоИменам(ТаблицаМодели(Контекст.МодельСтало, "ДополнительныеРеквизиты"));
	Контекст.Вставить("ЗначенияДопРеквизитов", Значения);
	Возврат Значения;
	
КонецФункции

// Значения дополнительных реквизитов таблицы модели по программным именам
// (реквизит Имя ПВХ ДополнительныеРеквизитыИСведения, карта реквизитов -
// mcp.md [P3]): имена всех свойств таблицы читаются одним вызовом БСП, не в
// цикле к базе.
//
// Параметры:
//  Таблица - Массив - строки ТЧ ДополнительныеРеквизиты модели, см. ТаблицаМодели().
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> значение (строка).
//
Функция ЗначенияДопРеквизитовПоИменам(Знач Таблица)
	
	Свойства = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекции(СтрокаТаблицы, "Свойство");
		Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения")
			И ЗначениеЗаполнено(Свойство) Тогда
			Свойства.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
	
	Значения = Новый Соответствие;
	Если Свойства.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;
	
	ИменаСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Свойства, "Имя");
	КодыБанков = КодыБанковДопРеквизитов(Таблица);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИмяРеквизита = ИменаСвойств.Получить(ЗначениеИзКоллекции(СтрокаТаблицы, "Свойство"));
		Если ТипЗнч(ИмяРеквизита) <> Тип("Строка") Или ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(ИмяРеквизита, ЗначениеСтрокиДопРеквизита(СтрокаТаблицы, КодыБанков));
	КонецЦикла;
	Возврат Значения;
	
КонецФункции

// Значение дополнительного реквизита строки таблицы модели: ТекстоваяСтрока,
// если заполнена; банк (БИКБанка типа Справочник.Банки) - кодом, то есть БИК;
// иначе Строка(Значение) (строковые дополнительные реквизиты БСП хранятся в
// ТекстоваяСтрока, карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  СтрокаТаблицы - Структура, Соответствие - строка ТЧ ДополнительныеРеквизиты модели.
//  КодыБанков    - Соответствие - банк -> код, см. КодыБанковДопРеквизитов().
//
// Возвращаемое значение:
//  Строка - значение реквизита; незаполненное значение - пустая строка.
//
Функция ЗначениеСтрокиДопРеквизита(Знач СтрокаТаблицы, Знач КодыБанков)
	
	ТекстоваяСтрока = ЗначениеИзКоллекции(СтрокаТаблицы, "ТекстоваяСтрока");
	Если ТипЗнч(ТекстоваяСтрока) = Тип("Строка") И НЕ ПустаяСтрока(ТекстоваяСтрока) Тогда
		Возврат СокрЛП(ТекстоваяСтрока);
	КонецЕсли;
	
	Значение = ЗначениеИзКоллекции(СтрокаТаблицы, "Значение");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") Тогда
		Возврат СокрЛП(Строка(КодыБанков.Получить(Значение)));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

// Коды (БИК) банков в значениях таблицы ДополнительныеРеквизиты модели - одним
// вызовом БСП, не в цикле к базе.
//
// Параметры:
//  Таблица - Массив - строки ТЧ ДополнительныеРеквизиты модели, см. ТаблицаМодели().
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.Банки -> Строка (код).
//
Функция КодыБанковДопРеквизитов(Знач Таблица)
	
	Банки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значение = ЗначениеИзКоллекции(СтрокаТаблицы, "Значение");
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") И ЗначениеЗаполнено(Значение)
			И Банки.Найти(Значение) = Неопределено Тогда
			Банки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если Банки.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Банки, "Код");
	
КонецФункции

// Причина неприменимости проверки банковского счёта (спека п. 2.3): нужны
// таблица ДополнительныеРеквизиты заявки с реквизитами БИКБанка и
// НомерОсновногоБанковскогоСчета, заполненный номер и правила для резидента РФ либо
// для ИП / ФЛ. Пустая строка - проверка применима.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеприменимостиСчета(Знач Контекст)
	
	ЗначенияДопРеквизитов = ЗначенияДопРеквизитовЗаявки(Контекст);
	НомерСчета = ЗначенияДопРеквизитов.Получить("НомерОсновногоБанковскогоСчета");
	Если НомерСчета = Неопределено
		Или ЗначенияДопРеквизитов.Получить("БИКБанка") = Неопределено Тогда
		Возврат НСтр("ru = 'в дополнительных реквизитах нет БИКБанка и НомерОсновногоБанковскогоСчета'");
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаБезПробелов(НомерСчета)) Тогда
		Возврат НСтр("ru = 'номер банковского счёта не заполнен'");
	КонецЕсли;
	
	Если Контекст.ВидКонтрагента <> ВидИП() И Контекст.ВидКонтрагента <> ВидФЛ()
		И Контекст.Юрисдикция <> ЮрисдикцияРезидента() Тогда
		Возврат НСтр("ru = 'правила счёта заданы для резидента РФ и для ИП / ФЛ'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Причина неприменимости проверки КПП крупнейшего налогоплательщика
// (спека п. 2.1): КПП заявки отличается от КПП справочника и хотя бы один из
// них - КПП крупнейшего налогоплательщика. Пустая строка - проверка применима.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеприменимостиКППКрупнейшегоНалогоплательщика(Знач Контекст)
	
	КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
	КППСправочника = КППВСправочнике(Контекст);
	
	Если КППВЗаявке = КППСправочника Тогда
		Возврат НСтр("ru = 'КПП не меняется'");
	КонецЕсли;
	
	Если НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППВЗаявке)
		И НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППСправочника) Тогда
		Возврат НСтр("ru = 'ни один КПП не является КПП крупнейшего налогоплательщика'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Причина неприменимости проверки обособленного подразделения крупнейшего
// налогоплательщика (спека п. 2.2): заявка на ОП, головной контрагент указан и
// его КПП - КПП крупнейшего налогоплательщика. Пустая строка - проверка применима.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеприменимостиОПКрупнейшегоНалогоплательщика(Знач Контекст)
	
	Если НЕ ЭтоОбособленноеПодразделение(Контекст) Тогда
		Возврат НСтр("ru = 'заявка не на обособленное подразделение'");
	КонецЕсли;
	
	ДанныеГоловного = ДанныеГоловногоКонтрагента(Контекст);
	Если ДанныеГоловного = Неопределено Тогда
		Возврат НСтр("ru = 'головной контрагент в заявке не указан'");
	КонецЕсли;
	
	Если НЕ ЭтоКППКрупнейшегоНалогоплательщика(ДанныеГоловного.КПП) Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'головной контрагент - не крупнейший налогоплательщик (КПП %1)'"),
			ЗначениеДляВывода(ДанныеГоловного.КПП));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Проверка «КПП крупнейшего налогоплательщика» (спека п. 2.1): смена КПП
// крупнейшего налогоплательщика (5-6 знаки «50») допускается только на КПП
// крупнейшего налогоплательщика; КПП справочника - текущее значение карточки
// предмета заявки (карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура - результат проверки {Код, Наименование, Статус, Пояснение,
//  ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция ПроверкаКППКрупнейшегоНалогоплательщика(Знач ОписаниеПроверки, Знач Контекст)
	
	КППСправочника = КППВСправочнике(Контекст);
	КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
	
	Если ЭтоКППКрупнейшегоНалогоплательщика(КППСправочника)
		И НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППВЗаявке) Тогда
		// Спека п. 2.1: пояснение с КПП справочника и КПП заявки.
		Пояснение = СтрШаблон(НСтр("ru = 'Смена КПП крупнейшего налогоплательщика допускается
			|только на КПП крупнейшего налогоплательщика: было %1, стало %2.'"),
			ЗначениеДляВывода(КППСправочника), ЗначениеДляВывода(КППВЗаявке));
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение,
			КППВЗаявке, КППСправочника);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
		СтрШаблон(НСтр("ru = 'Смена КПП допустима: КПП в справочнике %1, КПП в заявке %2.'"),
			ЗначениеДляВывода(КППСправочника), ЗначениеДляВывода(КППВЗаявке)),
		КППВЗаявке, КППСправочника);
	
КонецФункции

// Проверка «Обособленное подразделение крупнейшего налогоплательщика»
// (спека п. 2.2): у ОП головного-крупнейшего налогоплательщика должен быть
// собственный КПП, отличный от КПП головного контрагента.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура - результат проверки {Код, Наименование, Статус, Пояснение,
//  ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция ПроверкаОПКрупнейшегоНалогоплательщика(Знач ОписаниеПроверки, Знач Контекст)
	
	ДанныеГоловного = ДанныеГоловногоКонтрагента(Контекст);
	Если ДанныеГоловного = Неопределено Тогда
		// Страховка: применимость гарантирует головного контрагента.
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(),
			НСтр("ru = 'головной контрагент в заявке не указан - проверка не выполнена.'"));
	КонецЕсли;
	
	КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
	ЗначениеВБазе = СтрШаблон(НСтр("ru = '%1: КПП %2'"), Строка(ДанныеГоловного.Ссылка), ДанныеГоловного.КПП);
	
	Если НЕ ПустаяСтрока(КППВЗаявке) И КППВЗаявке <> ДанныеГоловного.КПП Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Создание ОП крупнейшего налогоплательщика разрешено: КПП ОП %1, КПП головного %2.'"),
				КППВЗаявке, ДанныеГоловного.КПП),
			КППВЗаявке, ЗначениеВБазе);
	КонецЕсли;
	
	// Спека п. 2.2: у ОП собственного КПП нет - данные заявки неверны.
	Пояснение = СтрШаблон(
			НСтр("ru = 'Обособленному подразделению нужен собственный КПП, отличный от КПП головного контрагента (%1).'"),
			ДанныеГоловного.КПП)
		+ Символы.ПС
		+ НСтр("ru = 'Данные заявки неверны - заявку вернуть инициатору на исправление.'");
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(), Пояснение,
		КППВЗаявке, ЗначениеВБазе);
	
КонецФункции

// Проверка «Банковский счёт (дополнительные реквизиты)» (спека п. 2.3): номер
// счёта резидента РФ - ровно 20 цифр, у ИП / ФЛ - префиксы 40802, 40817 или 40824;
// значения - из таблицы ДополнительныеРеквизиты модели заявки (карта
// реквизитов - mcp.md [P3]).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура - результат проверки {Код, Наименование, Статус, Пояснение,
//  ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция ПроверкаБанковскийСчетДопРеквизиты(Знач ОписаниеПроверки, Знач Контекст)
	
	ЗначенияДопРеквизитов = ЗначенияДопРеквизитовЗаявки(Контекст);
	НомерСчета = СтрокаБезПробелов(ЗначенияДопРеквизитов.Получить("НомерОсновногоБанковскогоСчета"));
	БИК = ЗначенияДопРеквизитов.Получить("БИКБанка");
	ЗначениеВЗаявке = СтрШаблон(НСтр("ru = 'счёт %1, БИК %2'"),
		ЗначениеДляВывода(НомерСчета), ЗначениеДляВывода(БИК));
	
	// Действуют все применимые правила, нарушения перечисляются через перевод строки.
	Нарушения = Новый Массив;
	Если Контекст.Юрисдикция = ЮрисдикцияРезидента()
		И НЕ (СтрДлина(НомерСчета) = 20 И ТолькоЦифры(НомерСчета)) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Номер счёта резидента РФ - ровно 20 цифр (только цифры), в заявке «%1».'"),
			ЗначениеДляВывода(НомерСчета)));
	КонецЕсли;
	Если (Контекст.ВидКонтрагента = ВидИП() Или Контекст.ВидКонтрагента = ВидФЛ())
		И НЕ (СтрНачинаетсяС(НомерСчета, "40802") Или СтрНачинаетсяС(НомерСчета, "40817")
			Или СтрНачинаетсяС(НомерСчета, "40824")) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Номер счёта ИП / ФЛ начинается с 40802, 40817 или 40824, в заявке «%1».'"),
			ЗначениеДляВывода(НомерСчета)));
	КонецЕсли;
	
	Если Нарушения.Количество() = 0 Тогда
		Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусПройдена(),
			СтрШаблон(НСтр("ru = 'Номер счёта соответствует правилам: %1.'"), ЗначениеВЗаявке),
			ЗначениеВЗаявке);
	КонецЕсли;
	
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПройдена(),
		СтрСоединить(Нарушения, Символы.ПС), ЗначениеВЗаявке);
	
КонецФункции

#КонецОбласти

#КонецОбласти
