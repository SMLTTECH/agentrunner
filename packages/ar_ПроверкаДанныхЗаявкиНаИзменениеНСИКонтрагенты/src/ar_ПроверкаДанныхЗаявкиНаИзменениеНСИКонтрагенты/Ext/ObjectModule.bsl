#Область ПрограммныйИнтерфейс

// Внешняя печатная форма «Проверка данных» для заявки НСИ на изменение
// (Документ.бит_мдм_ЗаявкаНаИзменение), задача FANDIT-18887.
//
// Три команды печати БСП:
//   * Протокол     - «Проверка данных (протокол)» - все проверки каталога со
//                    статусами, пояснениями и итогом;
//   * Результат    - «Проверка данных (результат)» - итог и только непройденные
//                    проверки с пояснениями;
//   * РезультатДляМодели - «Проверка данных (результат, JSON)» - тот же результат
//                    JSON-текстом для языковой модели: признак «проверка пройдена»,
//                    сводка, замечания и готовый текст замечаний для отправки
//                    (см. ДанныеРезультатаДляМодели). Тот же JSON без печати -
//                    экспортная РезультатПроверкиДляМодели.
//
// Проверки работают для заявок по справочнику «Контрагенты»
// (ОписаниеОбъекта.Имя = "Контрагенты"); для остальных объектов обмена
// печатается одна строка «проверка данных не выполняется», без исключения.
// Данные заявки - модели «стало» (ХранилищеМодельОбъекта) и «было»
// (ХранилищеМодельОбъектаПред). Новые данные проверяются только по заявке:
// реквизиты шапки заявки (если есть в метаданных документа), иначе модель
// «стало», табличные части - из модели «стало»; «было» не подставляется в
// «стало» и служит только для сравнения с карточкой. Ключи моделей - имена реквизитов справочника
// Контрагенты (карта реквизитов - mcp.md [P3] задачи FANDIT-18887). Пустая
// модель - проверки «не применима», не ошибка.
//
// Механизм: КаталогПроверок() - каждая проверка одной строкой ДобавитьПроверку:
// код, наименование, пункт регламента и условия применимости (виды
// контрагента, юрисдикции, операции заявки, особое условие словами);
// ПричинаНеПрименимости(Описание, Контекст) проверяет общие условия по каталогу,
// особые - ОсобаяПричинаНеПрименимости; РезультатВыполненияПроверки(Описание,
// Контекст) - выполнение. Новая проверка: строка каталога + ветка в
// РезультатВыполненияПроверки + функция проверки (+ ветка особого условия, если
// оно есть); механизм, вывод и текст условия в протоколе не меняются (спека п. 3,
// доработка на приемке по решению человека 2026-10-09). Проверки: заполнены
// вид операции, юр/физ лицо, юрисдикция и страна регистрации юрлица (от них
// зависит применимость), ИНН
// заполнен и соответствует виду лица (ЮЛ - 10 знаков, ИП - 12, физическое лицо -
// 12, если заполнен; резиденты РФ, создание и изменение), ИНН не
// меняется (ЮЛ/ИП/ФЛ-резидент РФ, изменение, ИНН в карточке был заполнен), нет
// дубля по ИНН + КПП + наименованию, у физического лица с серией и номером
// документа - также по ним (создание), нет второй карточки юрлица с тем же ИНН и
// парным кодом КПП «01» / «50» (создание), КПП юрлица со страной
// регистрации Россия - 9 цифр (создание и изменение), серия и номер паспорта РФ,
// код подразделения паспорта РФ, знаки 5-6 КПП и вид контрагента (ОП; для
// государственного органа не применяется), ИП не меняет вид, у ВГО меняются
// только телефон и электронная почта, признаки ЖКХ и ЗУП контрагента не
// снимаются (изменение), адрес электронной почты (один «@», без пробелов и
// непечатных символов, структура - методом БСП).
//
// Вид контрагента - как поле «Вид контрагента» формы элемента Контрагентов
// (расширение «БИТ», ФормаЭлемента): ЮридическоеФизическоеЛицо, затем
// ОбособленноеПодразделение / sd_ОП, ИндивидуальныйПредприниматель / sd_ИП,
// ГосударственныйОрган / sd_ГосударственныеОрганы, Самозанятый (см.
// ВидКарточкиПоМодели). Флажки группы «Характеристики контрагента» (sd_ВГО,
// sd_Подрядчик и др.) вид не задают.
//
// Обработка самостоятельная: без форм и макетов, без зависимости от
// ar_ПакетНСИ; отчет собирается строками в табличный документ моноширинным
// шрифтом. БезопасныйРежим = Истина - проверки читают только данные заявки
// и базы, сеть и файлы не нужны.
//
// Статусы проверки: «пройдена», «не пройдена», «не применима» (с причиной),
// «ошибка проверки» (исключение одной проверки не мешает остальным).

// Результат проверки заявок JSON-текстом - то же, что печатает команда
// «Проверка данных (результат, JSON)», но без печатной формы: для вызова кодом.
//
// Пример вызова (обработка подключена в справочнике «Дополнительные отчеты и
// обработки»; элемент ищется по имени объекта обработки - реквизит ИмяОбъекта,
// он равен имени этой обработки в метаданных):
//
//   Запрос = Новый Запрос;
//   Запрос.Текст =
//   	"ВЫБРАТЬ ПЕРВЫЕ 1
//   	|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
//   	|ИЗ
//   	|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
//   	|ГДЕ
//   	|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
//   	|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
//   	|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
//   	|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";
//   Запрос.УстановитьПараметр("ИмяОбъекта",
//   	"ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты");
//   Выборка = Запрос.Выполнить().Выбрать();
//   Если Выборка.Следующий() Тогда
//   	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Выборка.Ссылка);
//   	ТекстJSON = Обработка.РезультатПроверкиДляМодели(ЗаявкаСсылка);
//   КонецЕсли;
//
// Параметры:
//  Заявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение, Массив - заявка или массив заявок.
//
// Возвращаемое значение:
//  Строка - JSON: объект по одной заявке, массив объектов по нескольким
//  (состав - см. ДанныеРезультатаДляМодели).
//
Функция РезультатПроверкиДляМодели(Знач Заявки) Экспорт

	Если ТипЗнч(Заявки) = Тип("Массив") Тогда
		Возврат ТекстРезультатаДляМодели(Заявки);
	КонецЕсли;

	ОднаЗаявка = Новый Массив;
	ОднаЗаявка.Добавить(Заявки);
	Возврат ТекстРезультатаДляМодели(ОднаЗаявка);
	
КонецФункции

// Регистрация внешней печатной формы в подсистеме БСП «Дополнительные отчеты
// и обработки».
//
// Возвращаемое значение:
//  Структура - сведения о внешней обработке, см.
//  ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	// 1.1.0 - команда РезультатДляМодели, проверки КПП/вида, перехода ИП, кода
	//         подразделения, изменений ВГО; ИНН не проверяется при пустом «было».
	// 1.2.0 - новые данные только из заявки (без подстановки из «было»),
	//         проверка адреса электронной почты.
	// 1.3.0 - ИНН юрлица-резидента обязателен.
	// 1.4.0 - обработка переименована (Проверка данных заявки на изменение НСИ -
	//         контрагенты), проверки КПП и ОП крупнейшего налогоплательщика,
	//         банковского счёта (дополнительные реквизиты).
	// 1.4.1 - JSON: вместо passed и result (строка) - булево all_checks_passed.
	// 1.4.2 - РезультатПроверкиДляМодели вынесен в начало с примером вызова.
	// 1.4.3 - банковский счёт ИП / ФЛ: допустим также префикс 40824.
	// 1.4.4 - паспорт РФ: вид документа сравнивается и по наименованию, в причине
	//         неприменимости - фактическое значение.
	// 1.4.5 - юр/физ лицо «стало» - из модели заявки, а не из реквизита шапки
	//         sd_ЮридическоеФизическоеЛицо (вид контрагента определялся как ЮЛ).
	// 1.4.6 - дубль ИНН/КПП/наименования: в замечании навигационная ссылка
	//         найденной карточки (ref_in_base) - для вопроса инициатору.
	// 1.5.0 - ИНН по виду лица (10/12/12), знаки 5-6 КПП не проверяются
	//         для государственного органа, запрет снятия признаков ЖКХ и ЗУП.
	// 1.6.0 - КПП юрлица со страной регистрации Россия - 9 цифр; не заполненные
	//         вид операции, юр/физ лицо, юрисдикция или страна регистрации юрлица -
	//         замечание (а не молчаливое «не применима»).
	// 1.6.2 - проверка ВГО не сравнивает служебные Код и Ссылку моделей, а
	//         «Головной контрагент» - если в обеих моделях головной - сам контрагент.
	// 1.6.3 - проверка ВГО: строки сравниваются без пробелов и переводов строки
	//         по краям, РасширенноеПредставлениеИНН/КПП не сравниваются.
	// 1.7.0 - дубль физического лица (вид ФЛ или ИП) с заполненными в заявке
	//         серией и номером документа ищется по sd_ДокументСерия и
	//         sd_ДокументНомер (в том числе без ИНН), затем, если ИНН заполнен, -
	//         по ИНН, КПП и наименованию, как раньше.
	// 1.7.1 - юр/физ лицо «стало» - только из модели заявки (ХранилищеМодельОбъекта),
	//         без подстановки из реквизита шапки sd_ЮридическоеФизическоеЛицо: не
	//         заполненное в заявке поле - замечание.
	// 1.7.2 - «ИНН не меняется» - и для физического лица: заполненный в карточке
	//         ИНН заявка изменить не может.
	// 1.8.0 - вторая карточка юрлица: тот же ИНН, КПП «01» в заявке и «50» в
	//         справочнике или наоборот - замечание НетДубляЮЛПоОснованиюУчетаКПП
	//         (agentrunner-308).
	ПараметрыРегистрации.Версия = "1.8.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Проверка данных заявки на изменение НСИ (контрагенты)'");
	
	// Проверки читают модели заявки и справочник Контрагенты: сеть, файлы,
	// внешние компоненты не требуются (спека п. 1).
	ПараметрыРегистрации.БезопасныйРежим = Истина;
	
	ПараметрыРегистрации.Назначение.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
	
	// Идентификаторы и представления команд - из единых точек (спека п. 1).
	Для Каждого ИдентификаторКоманды Из ИдентификаторыКоманд() Цикл
		ДобавитьКомандуПроверки(ПараметрыРегистрации,
			ИдентификаторКоманды, ПредставлениеКоманды(ИдентификаторКоманды));
	КонецЦикла;
	
	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик печати БСП (вызывается УправлениеПечатью.ПечатьПоВнешнемуИсточнику):
// по каждой своей команде из коллекции печатных форм заполняет табличный
// документ отчета по заявкам назначения. Несколько заявок печатаются подряд,
// с разделителем (спека п. 1).
//
// Параметры:
//  ОбъектыНазначения     - Массив          - ссылки ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - строки команд печати (заполняется).
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов и областей печати (не используется,
//                                            параметр контракта БСП).
//  ПараметрыВывода       - Структура       - параметры вывода печати (не используется, параметр контракта БСП).
//
Процедура Печать(ОбъектыНазначения, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого ИдентификаторКоманды Из ИдентификаторыКоманд() Цикл
		
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, ИдентификаторКоманды);
		Если ПечатнаяФорма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокументОтчета(ОбъектыНазначения, ИдентификаторКоманды);
		ПечатнаяФорма.СинонимМакета = ПредставлениеКоманды(ИдентификаторКоманды);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КомандыПечати

// Идентификаторы команд печати обработки (спека п. 1).
//
// Возвращаемое значение:
//  Массив из Строка - "Протокол", "Результат", "РезультатДляМодели".
//
Функция ИдентификаторыКоманд()
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ИдентификаторКомандыПротокол());
	Идентификаторы.Добавить(ИдентификаторКомандыРезультата());
	Идентификаторы.Добавить(ИдентификаторКомандыРезультатаДляМодели());
	Возврат Идентификаторы;
	
КонецФункции

// Идентификатор команды «протокол» (полный список проверок) - единая точка.
//
// Возвращаемое значение:
//  Строка - "Протокол".
//
Функция ИдентификаторКомандыПротокол()
	Возврат "Протокол";
КонецФункции

// Идентификатор команды «результат» (итог и непройденные) - единая точка.
//
// Возвращаемое значение:
//  Строка - "Результат".
//
Функция ИдентификаторКомандыРезультата()
	Возврат "Результат";
КонецФункции

// Идентификатор команды «результат JSON» (результат для языковой модели) -
// единая точка.
//
// Возвращаемое значение:
//  Строка - "РезультатДляМодели".
//
Функция ИдентификаторКомандыРезультатаДляМодели()
	Возврат "РезультатДляМодели";
КонецФункции

// Представление команды печати для заголовка отчета и синонима макета.
//
// Параметры:
//  ИдентификаторКоманды - Строка - см. ИдентификаторыКоманд().
//
// Возвращаемое значение:
//  Строка - представление команды.
//
Функция ПредставлениеКоманды(Знач ИдентификаторКоманды)
	
	Если ИдентификаторКоманды = ИдентификаторКомандыРезультата() Тогда
		Возврат НСтр("ru = 'Проверка данных (результат)'");
	ИначеЕсли ИдентификаторКоманды = ИдентификаторКомандыРезультатаДляМодели() Тогда
		Возврат НСтр("ru = 'Проверка данных (результат, JSON)'");
	Иначе
		Возврат НСтр("ru = 'Проверка данных (протокол)'");
	КонецЕсли;
	
КонецФункции

// Добавляет команду печати в параметры регистрации БСП: серверный метод,
// модификатор "ПечатьMXL" - вывод табличным документом (контракт печатных форм).
//
// Параметры:
//  ПараметрыРегистрации - Структура - см. СведенияОВнешнейОбработке().
//  ИдентификаторКоманды - Строка    - внутреннее имя команды.
//  Представление        - Строка    - пользовательское представление команды.
//
Процедура ДобавитьКомандуПроверки(ПараметрыРегистрации, Знач ИдентификаторКоманды, Знач Представление)
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = Представление;
	НоваяКоманда.Идентификатор        = ИдентификаторКоманды;
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	НоваяКоманда.Модификатор          = "ПечатьMXL";
	
КонецПроцедуры

#КонецОбласти

#Область СборкаОтчета

// Табличный документ отчета по всем заявкам назначения.
//
// Параметры:
//  ОбъектыНазначения    - Массив - ссылки ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИдентификаторКоманды - Строка - "Протокол" или "Результат".
//
// Возвращаемое значение:
//  ТабличныйДокумент - текстовый отчет моноширинным шрифтом.
//
Функция ТабличныйДокументОтчета(Знач ОбъектыНазначения, Знач ИдентификаторКоманды)
	
	СтрокиОтчета = Новый Массив;
	Если ИдентификаторКоманды = ИдентификаторКомандыРезультатаДляМодели() Тогда
		ДополнитьСтрокиТекстом(СтрокиОтчета, ТекстРезультатаДляМодели(ОбъектыНазначения));
		Возврат ТабличныйДокументИзСтрок(СтрокиОтчета);
	КонецЕсли;

	Для Каждого Заявка Из ОбъектыНазначения Цикл
		ДополнитьОтчетПоЗаявке(СтрокиОтчета, Заявка, ИдентификаторКоманды);
	КонецЦикла;
	Возврат ТабличныйДокументИзСтрок(СтрокиОтчета);
	
КонецФункции

// Дополняет отчет по одной заявке: одна строка для не-контрагентов (спека п. 2),
// иначе шапка и тело по команде печати.
//
// Параметры:
//  СтрокиОтчета         - Массив - пополняемый массив строк отчета.
//  Заявка               - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИдентификаторКоманды - Строка - "Протокол" или "Результат".
//
Процедура ДополнитьОтчетПоЗаявке(СтрокиОтчета, Знач Заявка, Знач ИдентификаторКоманды)
	
	Если СтрокиОтчета.Количество() > 0 Тогда
		СтрокиОтчета.Добавить(СтрокаРазделителя());
	КонецЕсли;
	
	Контекст = КонтекстПроверки(Заявка);
	
	Если НЕ Контекст.ПоКонтрагентам Тогда
		ДополнитьСтрокиТекстом(СтрокиОтчета, СтрШаблон(
			НСтр("ru = 'Заявка оформлена не по справочнику «Контрагенты» (%1) - проверка данных не выполняется.'"),
			?(ПустаяСтрока(Контекст.ИмяОбъекта), НСтр("ru = 'объект обмена не указан'"), Контекст.ИмяОбъекта)));
		Возврат;
	КонецЕсли;
	
	ДобавитьШапкуОтчета(СтрокиОтчета, Контекст, ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = ИдентификаторКомандыРезультата() Тогда
		ДобавитьРезультатПроверок(СтрокиОтчета, Контекст);
	Иначе
		ДобавитьПротоколПроверок(СтрокиОтчета, Контекст);
	КонецЕсли;
	
КонецПроцедуры

// Шапка отчета: команда, документ, ссылка, база, время, проверяющий и
// контрагент (спека п. 5).
//
// Параметры:
//  СтрокиОтчета         - Массив    - пополняемый массив строк отчета.
//  Контекст             - Структура - см. КонтекстПроверки().
//  ИдентификаторКоманды - Строка    - "Протокол" или "Результат".
//
Процедура ДобавитьШапкуОтчета(СтрокиОтчета, Знач Контекст, Знач ИдентификаторКоманды)
	
	СтрокиОтчета.Добавить(ПредставлениеКоманды(ИдентификаторКоманды));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Документ: %1'"), Контекст.Представление));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Ссылка: %1'"), ПолучитьНавигационнуюСсылку(Контекст.Ссылка)));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'База: %1'"), СтрокаСоединенияИнформационнойБазы()));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Время проверки: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ='дд.ММ.гггг ЧЧ:мм:сс'")));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Проверил: %1'"), Строка(Пользователи.ТекущийПользователь())));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Контрагент: %1, %2, %3'"),
		ВидКарточкиДляВывода(Контекст.ВидКарточки),
		Контекст.Юрисдикция,
		Контекст.Операция));
	СтрокиОтчета.Добавить("");
	
КонецПроцедуры

// Протокол: все проверки каталога со статусами и пояснениями; для «не применима» -
// условие применимости и причина; итог (спека п. 5).
//
// Параметры:
//  СтрокиОтчета - Массив    - пополняемый массив строк отчета.
//  Контекст     - Структура - см. КонтекстПроверки().
//
Процедура ДобавитьПротоколПроверок(СтрокиОтчета, Знач Контекст)
	
	Результаты = РезультатыПроверок(Контекст);
	
	НомерПроверки = 0;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл
		
		НомерПроверки = НомерПроверки + 1;
		Результат = Результаты.Получить(ОписаниеПроверки.Код);
		
		СтрокиОтчета.Добавить(ЗаголовокПроверкиВОтчете(НомерПроверки, ОписаниеПроверки, Результат.Статус));
		
		Если Результат.Статус = СтатусНеПрименима() Тогда
			СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = '   Проверка выполняется, если: %1.'"),
				ОписаниеПроверки.УсловиеТекстом));
			ДополнитьСтрокиТекстом(СтрокиОтчета,
				СтрШаблон(НСтр("ru = 'Причина: %1'"), Результат.Пояснение), "   ");
		Иначе
			ДополнитьСтрокиТекстом(СтрокиОтчета, Результат.Пояснение, "   ");
		КонецЕсли;
		
	КонецЦикла;
	
	Сводка = СводкаПоСтатусам(Результаты);
	СтрокиОтчета.Добавить("");
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Итого: пройдено %1 из %2 применимых, не пройдено %3.'"),
		Сводка.Пройдено,
		Сводка.Пройдено + Сводка.НеПройдено + Сводка.Ошибок,
		Сводка.НеПройдено + Сводка.Ошибок));
	
КонецПроцедуры

// Результат: итог и только непройденные проверки со статусом «не пройдена»
// и «ошибка проверки» (спека п. 5).
//
// Параметры:
//  СтрокиОтчета - Массив    - пополняемый массив строк отчета.
//  Контекст     - Структура - см. КонтекстПроверки().
//
Процедура ДобавитьРезультатПроверок(СтрокиОтчета, Знач Контекст)
	
	Результаты = РезультатыПроверок(Контекст);
	Сводка = СводкаПоСтатусам(Результаты);
	
	НеПройдено = Сводка.НеПройдено + Сводка.Ошибок;
	Если НеПройдено = 0 Тогда
		СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Проверки пройдены (%1).'"), Сводка.Пройдено));
		Возврат;
	КонецЕсли;
	
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Не пройдены проверки: %1.'"), НеПройдено));
	СтрокиОтчета.Добавить("");
	
	НомерПроверки = 0;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл
		
		НомерПроверки = НомерПроверки + 1;
		Результат = Результаты.Получить(ОписаниеПроверки.Код);
		
		Если Результат.Статус <> СтатусНеПройдена() И Результат.Статус <> СтатусОшибкиПроверки() Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиОтчета.Добавить(ЗаголовокПроверкиВОтчете(НомерПроверки, ОписаниеПроверки, Результат.Статус));
		ДополнитьСтрокиТекстом(СтрокиОтчета, Результат.Пояснение, "   ");
		
	КонецЦикла;
	
КонецПроцедуры

// Заголовок проверки в отчете: номер, пункт регламента (если указан),
// наименование и статус.
//
// Параметры:
//  НомерПроверки    - Число     - порядковый номер в каталоге.
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Статус           - Строка    - статус проверки.
//
// Возвращаемое значение:
//  Строка - строка заголовка проверки для отчета.
//
Функция ЗаголовокПроверкиВОтчете(Знач НомерПроверки, Знач ОписаниеПроверки, Знач Статус)

	Если ПустаяСтрока(ОписаниеПроверки.ПунктРегламента) Тогда
		Возврат СтрШаблон(НСтр("ru = '%1. %2 - %3'"), НомерПроверки, ОписаниеПроверки.Наименование, Статус);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1. [п. %2] %3 - %4'"),
		НомерПроверки, ОписаниеПроверки.ПунктРегламента, ОписаниеПроверки.Наименование, Статус);

КонецФункции

// Табличный документ из массива строк: по строке текста на строку таблицы,
// моноширинный шрифт (спека п. 1: «текстовый отчет» печатается табличным
// документом - контракт БСП).
//
// Параметры:
//  СтрокиОтчета - Массив из Строка.
//
// Возвращаемое значение:
//  ТабличныйДокумент.
//
Функция ТабличныйДокументИзСтрок(Знач СтрокиОтчета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Если СтрокиОтчета.Количество() = 0 Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;
	
	ОбластьОтчета = ТабличныйДокумент.Область(1, 1, СтрокиОтчета.Количество(), 1);
	ОбластьОтчета.Шрифт = ШрифтОтчета();
	
	НомерСтроки = 0;
	Для Каждого СтрокаОтчета Из СтрокиОтчета Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = СтрокаОтчета;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Добавляет текст в массив строк отчета: пояснение может быть многострочным
// (переводы строки внутри пояснения), каждая часть - отдельная строка отчета.
//
// Параметры:
//  СтрокиОтчета - Массив - пополняемый массив строк отчета.
//  Текст        - Строка - текст с переводами строк; пустой текст ничего не добавляет.
//  Отступ       - Строка - префикс каждой строки (отступ пояснения под заголовком).
//
Процедура ДополнитьСтрокиТекстом(СтрокиОтчета, Знач Текст, Знач Отступ = "")
	
	Для Каждого Часть Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		СтрокиОтчета.Добавить(Отступ + СокрП(Часть));
	КонецЦикла;
	
КонецПроцедуры

// Разделитель отчетов по нескольким заявкам (спека п. 1) - 60 дефисов.
Функция СтрокаРазделителя()
	Возврат "------------------------------------------------------------";
КонецФункции

// Шрифт текстового отчета - моноширинный (спека п. 1); единая точка.
//
// Возвращаемое значение:
//  Шрифт.
//
Функция ШрифтОтчета()
	Возврат Новый Шрифт(ИмяШрифтаОтчета(), РазмерШрифтаОтчета());
КонецФункции

// Имя моноширинного шрифта отчета; стилей конфигурации у внешней обработки нет.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяШрифтаОтчета()
	Возврат "Courier New";
КонецФункции

// Размер шрифта отчета; единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерШрифтаОтчета()
	Возврат 9;
КонецФункции

#КонецОбласти

#Область РезультатДляМодели

// JSON-текст результата проверки по заявкам: одна заявка - объект, несколько -
// массив объектов (состав - см. ДанныеРезультатаДляМодели).
//
// Параметры:
//  Заявки - Массив - ссылки ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Строка - JSON с отступами.
//
Функция ТекстРезультатаДляМодели(Знач Заявки)

	Результаты = Новый Массив;
	Для Каждого Заявка Из Заявки Цикл
		Результаты.Добавить(ДанныеРезультатаДляМодели(КонтекстПроверки(Заявка)));
	КонецЦикла;

	Если Результаты.Количество() = 1 Тогда
		Возврат СериализованныйТекст(Результаты[0]);
	КонецЕсли;
	Возврат СериализованныйТекст(Результаты);

КонецФункции

// Результат проверки одной заявки для языковой модели. Ключи - латиницей
// (внешний контракт JSON), значения - по-русски.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура:
//   * request      - Строка  - представление заявки.
//   * ref          - Строка  - навигационная ссылка заявки.
//   * checked_at   - Строка  - время проверки (ГГГГ-ММ-ДДTЧЧ:ММ:СС).
//   * checked      - Булево  - проверка выполнялась (заявка по справочнику «Контрагенты»).
//   * all_checks_passed - Булево, Неопределено - Истина: нет проверок со статусами «не пройдена»
//                    и «ошибка проверки»; Ложь - есть; null - проверка не выполнялась.
//   * reason       - Строка  - почему проверка не выполнялась (только при checked = false).
//   * counterparty - Структура {kind, jurisdiction, operation} - вид контрагента,
//                    юрисдикция и операция заявки.
//   * summary      - Структура {passed, failed, errors, not_applicable} - число проверок.
//   * remarks      - Массив из Структура {code, name, status, message, value_in_request,
//                    value_in_base} - проверки со статусами «не пройдена» и «ошибка проверки».
//   * remarks_text - Строка  - нумерованный список замечаний «не пройдена» для отправки
//                    инициатору заявки; пустая строка - замечаний нет.
//
Функция ДанныеРезультатаДляМодели(Знач Контекст)

	Данные = Новый Структура;
	Данные.Вставить("request", Контекст.Представление);
	Данные.Вставить("ref", ПолучитьНавигационнуюСсылку(Контекст.Ссылка));
	Данные.Вставить("checked_at", XMLСтрока(ТекущаяДатаСеанса()));

	Если НЕ Контекст.ПоКонтрагентам Тогда
		Данные.Вставить("checked", Ложь);
		Данные.Вставить("all_checks_passed", Неопределено);
		Данные.Вставить("reason", СтрШаблон(
			НСтр("ru = 'Заявка оформлена не по справочнику «Контрагенты» (%1).'"),
			?(ПустаяСтрока(Контекст.ИмяОбъекта), НСтр("ru = 'объект обмена не указан'"), Контекст.ИмяОбъекта)));
		Данные.Вставить("remarks", Новый Массив);
		Данные.Вставить("remarks_text", "");
		Возврат Данные;
	КонецЕсли;

	Результаты = РезультатыПроверок(Контекст);
	Сводка = СводкаПоСтатусам(Результаты);
	Пройдена = Сводка.НеПройдено + Сводка.Ошибок = 0;

	Данные.Вставить("checked", Истина);
	Данные.Вставить("all_checks_passed", Пройдена);

	Контрагент = Новый Структура;
	Контрагент.Вставить("kind", ВидКарточкиДляВывода(Контекст.ВидКарточки));
	Контрагент.Вставить("jurisdiction", Контекст.Юрисдикция);
	Контрагент.Вставить("operation", Контекст.Операция);
	Данные.Вставить("counterparty", Контрагент);

	СводкаДляМодели = Новый Структура;
	СводкаДляМодели.Вставить("passed", Сводка.Пройдено);
	СводкаДляМодели.Вставить("failed", Сводка.НеПройдено);
	СводкаДляМодели.Вставить("errors", Сводка.Ошибок);
	СводкаДляМодели.Вставить("not_applicable", Сводка.НеПрименимо);
	Данные.Вставить("summary", СводкаДляМодели);

	Замечания = Новый Массив;
	ТекстыЗамечаний = Новый Массив;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл

		Результат = Результаты.Получить(ОписаниеПроверки.Код);
		Если Результат.Статус <> СтатусНеПройдена() И Результат.Статус <> СтатусОшибкиПроверки() Тогда
			Продолжить;
		КонецЕсли;

		Замечания.Добавить(ЗамечаниеДляМодели(Результат));
		Если Результат.Статус = СтатусНеПройдена() Тогда
			ТекстыЗамечаний.Добавить(СтрШаблон(НСтр("ru = '%1. %2: %3'"),
				ТекстыЗамечаний.Количество() + 1, Результат.Наименование,
				СтрЗаменить(Результат.Пояснение, Символы.ПС, " ")));
		КонецЕсли;

	КонецЦикла;
	Данные.Вставить("remarks", Замечания);
	Данные.Вставить("remarks_text", СтрСоединить(ТекстыЗамечаний, Символы.ПС));

	Возврат Данные;

КонецФункции

// Замечание для JSON по результату проверки.
//
// Параметры:
//  Результат - Структура - см. НовыйРезультатПроверки().
//
// Возвращаемое значение:
//  Структура {code, name, status, message, value_in_request, value_in_base,
//  ref_in_base - только если проверка нашла объект в базе}.
//
Функция ЗамечаниеДляМодели(Знач Результат)

	Замечание = Новый Структура;
	Замечание.Вставить("code", Результат.Код);
	Замечание.Вставить("name", Результат.Наименование);
	Замечание.Вставить("status", Результат.Статус);
	Замечание.Вставить("message", Результат.Пояснение);
	Замечание.Вставить("value_in_request", Результат.ЗначениеВЗаявке);
	Замечание.Вставить("value_in_base", Результат.ЗначениеВБазе);
	Если НЕ ПустаяСтрока(Результат.СсылкаВБазе) Тогда
		Замечание.Вставить("ref_in_base", Результат.СсылкаВБазе);
	КонецЕсли;
	Возврат Замечание;

КонецФункции

// JSON-текст значения: отступ - два пробела, перевод строки - LF, кириллица
// без экранирования.
//
// Параметры:
//  Значение - Структура, Массив - сериализуемое значение.
//
// Возвращаемое значение:
//  Строка.
//
Функция СериализованныйТекст(Знач Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  "));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область КонтекстПроверки

// Контекст проверки заявки (спека п. 3): строится один раз на заявку.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка         - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//   * Представление  - Строка    - представление заявки.
//   * МодельСтало    - Структура, Неопределено - модель заявки «стало».
//   * МодельБыло     - Структура, Неопределено - модель заявки «было».
//   * Предмет        - СправочникСсылка - предмет заявки (для заявок по
//                      контрагентам при «Изменении» - ссылка на контрагента).
//   * ИмяОбъекта     - Строка    - имя объекта обмена (бит_мдм_ОписанияОбъектовОбмена.Имя).
//   * ПоКонтрагентам - Булево   - заявка по справочнику «Контрагенты».
//   * ЮрФизЛицо      - ПеречислениеСсылка.ЮридическоеФизическоеЛицо, Неопределено - из модели «стало».
//   * ВидКарточки    - Строка   - вид по модели «стало», как поле «Вид контрагента» формы
//                                 (см. ВидКарточкиПоМодели); "" - не определен.
//   * ВидКарточкиБыло - Строка  - то же по модели «было»; "" - модели нет или вид не определен.
//   * ВидКонтрагента - Строка   - см. ВидЮЛ/ВидИП/ВидФЛ или "" (не определен).
//   * Юрисдикция     - Строка   - см. ЮрисдикцияРезидента/ЮрисдикцияНерезидента/ЮрисдикцияНеОпределена.
//   * ВидОперации    - ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение - вид операции шапки.
//   * Операция       - Строка   - см. ОперацияСоздание/ОперацияИзменение/ОперацияПрочее.
//
Функция КонтекстПроверки(Знач Заявка)
	
	// Шапка заявки одним вызовом БСП (стандарт: не через точку).
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка,
		"ОписаниеОбъекта,ВидОперации,Предмет,"
		+ "ХранилищеМодельОбъекта,ХранилищеМодельОбъектаПред");
	
	Контекст = Новый Структура;
	Контекст.Вставить("Ссылка", Заявка);
	Контекст.Вставить("Представление", Строка(Заявка));
	// Новые данные («стало») - только из заявки: реквизиты шапки заявки, если они
	// есть в метаданных документа, иначе модель «стало» (как ar_ПакетНСИ).
	// Модель «было» - данные карточки на момент заявки, только для сравнения.
	МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
	ДополнитьМодельРеквизитамиШапки(МодельСтало, Заявка);
	Контекст.Вставить("МодельСтало", МодельСтало);
	Контекст.Вставить("МодельБыло", МодельИзХранилища(Шапка.ХранилищеМодельОбъектаПред));
	Контекст.Вставить("Предмет", Шапка.Предмет);
	
	ИмяОбъекта = "";
	Если ЗначениеЗаполнено(Шапка.ОписаниеОбъекта) Тогда
		ИмяОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.ОписаниеОбъекта, "Имя");
	КонецЕсли;
	Контекст.Вставить("ИмяОбъекта", ИмяОбъекта);
	
	// Применимость: объект обмена «Контрагенты»; при «Изменение» дополнительно
	// предмет - ссылка на контрагента (спека п. 2).
	ПоКонтрагентам = ИмяОбъекта = "Контрагенты"
		И (Шапка.ВидОперации <> Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение
			Или ТипЗнч(Шапка.Предмет) = Тип("СправочникСсылка.Контрагенты"));
	Контекст.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	
	// Юр/физ лицо «стало» - только реквизит ЮридическоеФизическоеЛицо модели «стало»
	// (ХранилищеМодельОбъекта, его правит пользователь в форме заявки). Реквизит шапки
	// документа sd_ЮридическоеФизическоеЛицо для контрагентов не ведется и заполнен по
	// умолчанию: подстановка из него скрывала незаполненное поле (1.7.1).
	ЮрФизСтало = ЗначениеМодели(Контекст.МодельСтало, "ЮридическоеФизическоеЛицо");
	Контекст.Вставить("ЮрФизЛицо", ЮрФизСтало);

	// Вид «стало» и признаки вида - только из заявки (модель «было» не подставляется).
	ВидКарточки = "";
	ВидКарточкиБыло = "";
	Если ПоКонтрагентам Тогда
		ВидКарточки = ВидКарточкиПоМодели(Контекст.МодельСтало, ЮрФизСтало);
		ВидКарточкиБыло = ВидКарточкиПоМодели(Контекст.МодельБыло,
			ЗначениеМодели(Контекст.МодельБыло, "ЮридическоеФизическоеЛицо"));
	КонецЕсли;
	Контекст.Вставить("ВидКарточки", ВидКарточки);
	Контекст.Вставить("ВидКарточкиБыло", ВидКарточкиБыло);
	Контекст.Вставить("ВидКонтрагента", ВидКонтрагентаПоВидуКарточки(ВидКарточки));
	Контекст.Вставить("Юрисдикция", ?(ПоКонтрагентам, ЮрисдикцияКонтекста(Контекст), ""));
	Контекст.Вставить("ВидОперации", Шапка.ВидОперации);
	Контекст.Вставить("Операция", ОперацияКонтекста(Шапка.ВидОперации));
	
	Возврат Контекст;
	
КонецФункции

// Модель заявки из хранилища значения: Структура или Соответствие; пустое или
// нестандартное хранилище - Неопределено (защита от старых заявок, спека п. 2).
//
// Параметры:
//  Хранилище - ХранилищеЗначения.
//
// Возвращаемое значение:
//  Структура, Соответствие, Неопределено.
//
Функция МодельИзХранилища(Знач Хранилище)
	
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Модель = Хранилище.Получить();
	Если ТипЗнч(Модель) = Тип("Структура") Или ТипЗнч(Модель) = Тип("Соответствие") Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Значение реквизита предмета из модели: группа «Реквизиты», затем
// «СтандартныеРеквизиты» (ключи моделей - имена реквизитов Контрагентов,
// mcp.md [P3] задачи).
//
// Параметры:
//  Модель       - Структура, Соответствие, Неопределено.
//  ИмяРеквизита - Строка - имя реквизита предмета ("ИНН", "Наименование"...).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - группа или ключ отсутствуют.
//
Функция ЗначениеМодели(Знач Модель, Знач ИмяРеквизита)
	
	Если Модель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "Реквизиты"), ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Значение = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "СтандартныеРеквизиты"), ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

// Значение из коллекции модели: Структура - по свойству, Соответствие - по
// ключу; иное или отсутствие - Неопределено.
//
// Параметры:
//  Коллекция - Структура, Соответствие, произвольное.
//  Ключ      - Строка.
//
// Возвращаемое значение:
//  Произвольный, Неопределено.
//
Функция ЗначениеИзКоллекции(Знач Коллекция, Знач Ключ)
	
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Дополняет модель «стало» значениями реквизитов контрагента из шапки заявки:
// реквизиты из ИменаРеквизитовКонтрагентаЗаявки, которые есть в метаданных
// документа, читаются одним вызовом БСП и заменяют значения модели (шапка -
// источник новых данных первым, как ar_ПакетНСИ.ПризнакиСубъектаСценария). В
// конфигурации «БИТ» таких реквизитов в шапке сейчас нет - модель не меняется.
//
// Параметры:
//  Модель - Структура, Соответствие, Неопределено - модель «стало» (изменяется).
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
Процедура ДополнитьМодельРеквизитамиШапки(Модель, Знач Заявка)

	Если НЕ ЭтоКоллекцияСКлючами(Модель) Тогда
		Возврат;
	КонецЕсли;

	МетаданныеЗаявки = Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение;
	ИменаВШапке = Новый Массив;
	Для Каждого ИмяРеквизита Из ИменаРеквизитовКонтрагентаЗаявки() Цикл
		Если МетаданныеЗаявки.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			ИменаВШапке.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Если ИменаВШапке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗначенияШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, СтрСоединить(ИменаВШапке, ","));
	Реквизиты = ЗначениеИзКоллекции(Модель, "Реквизиты");
	Если НЕ ЭтоКоллекцияСКлючами(Реквизиты) Тогда
		Реквизиты = Новый Структура;
		Модель.Вставить("Реквизиты", Реквизиты);
	КонецЕсли;
	Для Каждого КлючИЗначение Из ЗначенияШапки Цикл
		Реквизиты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

// Реквизиты контрагента, которые проверки читают из заявки (список
// ar_ПакетНСИ.ИменаШапкиКонтрагента и реквизиты новых проверок).
//
// Возвращаемое значение:
//  Массив из Строка - имена реквизитов Справочник.Контрагенты.
//
Функция ИменаРеквизитовКонтрагентаЗаявки()
	
	Возврат СтрРазделить("ИНН,КПП,НаименованиеПолное,ЮридическоеФизическоеЛицо,sd_Нерезидент,СтранаРегистрации,"
		+ "sd_ИП,ИндивидуальныйПредприниматель,Самозанятый,sd_ОП,ОбособленноеПодразделение,sd_ВГО,"
		+ "ГосударственныйОрган,sd_ГосударственныеОрганы,sd_ВидДокумента,sd_ДокументСерия,sd_ДокументНомер,"
		+ "sd_ДокументКодПодразделения,ГоловнойКонтрагент", ",");
	
КонецФункции

// Вид карточки контрагента по модели - как поле «Вид контрагента» формы элемента
// Контрагентов (расширение «БИТ»): физлицо - самозанятый, ИП или физическое
// лицо; юрлицо - обособленное подразделение, ИП (старые карточки: юрлицо с
// флажком sd_ИП), государственный орган или юридическое лицо. Признаки вида -
// пары реквизитов типовой конфигурации и «Самолета» (ОбособленноеПодразделение /
// sd_ОП, ИндивидуальныйПредприниматель / sd_ИП, ГосударственныйОрган /
// sd_ГосударственныеОрганы), как в ar_ПакетНСИ.ВидПоМодели.
//
// Параметры:
//  Модель    - Структура, Соответствие, Неопределено - модель «стало» или «было».
//  ЮрФизЛицо - ПеречислениеСсылка.ЮридическоеФизическоеЛицо, Неопределено.
//
// Возвращаемое значение:
//  Строка - см. ВидКарточкиЮЛ() и далее; "" - модели нет или вид не определен.
//
Функция ВидКарточкиПоМодели(Знач Модель, Знач ЮрФизЛицо)
	
	Если Модель = Неопределено Тогда
		Возврат "";
	ИначеЕсли ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат ВидКарточкиФизлица(Модель);
	ИначеЕсли ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		Возврат ВидКарточкиЮрлица(Модель);
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Вид карточки физического лица: самозанятый, ИП или физическое лицо (см.
// ВидКарточкиПоМодели).
//
// Параметры:
//  Модель - Структура, Соответствие - модель заявки.
//
// Возвращаемое значение:
//  Строка - ВидКарточкиСамозанятый(), ВидКарточкиИП() или ВидКарточкиФЛ().
//
Функция ВидКарточкиФизлица(Знач Модель)

	Если ПризнакМоделиУстановлен(Модель, "Самозанятый") Тогда
		Возврат ВидКарточкиСамозанятый();
	ИначеЕсли ПризнакИПВМодели(Модель) Тогда
		Возврат ВидКарточкиИП();
	Иначе
		Возврат ВидКарточкиФЛ();
	КонецЕсли;

КонецФункции

// Вид карточки юридического лица: обособленное подразделение, ИП (старые
// карточки), государственный орган или юридическое лицо (см. ВидКарточкиПоМодели).
//
// Параметры:
//  Модель - Структура, Соответствие - модель заявки.
//
// Возвращаемое значение:
//  Строка - ВидКарточкиОП(), ВидКарточкиИП(), ВидКарточкиГосорган() или ВидКарточкиЮЛ().
//
Функция ВидКарточкиЮрлица(Знач Модель)

	Если ПризнакМоделиУстановлен(Модель, "ОбособленноеПодразделение")
		Или ПризнакМоделиУстановлен(Модель, "sd_ОП") Тогда
		Возврат ВидКарточкиОП();
	ИначеЕсли ПризнакИПВМодели(Модель) Тогда
		Возврат ВидКарточкиИП();
	ИначеЕсли ПризнакМоделиУстановлен(Модель, "ГосударственныйОрган")
		Или ПризнакМоделиУстановлен(Модель, "sd_ГосударственныеОрганы") Тогда
		Возврат ВидКарточкиГосорган();
	Иначе
		Возврат ВидКарточкиЮЛ();
	КонецЕсли;

КонецФункции

// Признак ИП в модели: ИндивидуальныйПредприниматель или sd_ИП.
//
// Параметры:
//  Модель - Структура, Соответствие - модель заявки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПризнакИПВМодели(Знач Модель)
	Возврат ПризнакМоделиУстановлен(Модель, "ИндивидуальныйПредприниматель")
		Или ПризнакМоделиУстановлен(Модель, "sd_ИП");
КонецФункции

// Булев признак контрагента установлен в модели.
//
// Параметры:
//  Модель - Структура, Соответствие - модель заявки.
//  ИмяРеквизита   - Строка - имя булева реквизита Контрагентов.
//
// Возвращаемое значение:
//  Булево - Истина, только если значение признака - Истина.
//
Функция ПризнакМоделиУстановлен(Знач Модель, Знач ИмяРеквизита)

	Возврат ЗначениеМодели(Модель, ИмяРеквизита) = Истина;

КонецФункции

// Вид контрагента для условий каталога по виду карточки: юрлица (в том числе
// обособленное подразделение и государственный орган) - "ЮЛ", ИП - "ИП",
// физическое лицо и самозанятый - "ФЛ".
//
// Параметры:
//  ВидКарточки - Строка - см. ВидКарточкиПоМодели().
//
// Возвращаемое значение:
//  Строка - ВидЮЛ(), ВидИП(), ВидФЛ() или "" (не определен).
//
Функция ВидКонтрагентаПоВидуКарточки(Знач ВидКарточки)

	Если ВидКарточки = ВидКарточкиЮЛ()
		Или ВидКарточки = ВидКарточкиОП()
		Или ВидКарточки = ВидКарточкиГосорган() Тогда
		Возврат ВидЮЛ();
	ИначеЕсли ВидКарточки = ВидКарточкиИП() Тогда
			Возврат ВидИП();
	ИначеЕсли ВидКарточки = ВидКарточкиФЛ() Или ВидКарточки = ВидКарточкиСамозанятый() Тогда
		Возврат ВидФЛ();
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Вид карточки для текста пользователю: пустой - «вид не определен».
//
// Параметры:
//  ВидКарточки - Строка - см. ВидКарточкиПоМодели().
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидКарточкиДляВывода(Знач ВидКарточки)
	Возврат ?(ПустаяСтрока(ВидКарточки), НСтр("ru = 'вид не определен'"), ВидКарточки);
КонецФункции

// Юрисдикция контрагента по данным заявки («стало»): по sd_Нерезидент; дублер - СтранаРегистрации
// (РФ - резидент, иная страна - нерезидент); иначе «не определена» (спека п. 3).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка.
//
Функция ЮрисдикцияКонтекста(Знач Контекст)
	
	Нерезидент = ЗначениеМодели(Контекст.МодельСтало, "sd_Нерезидент");
	Если ТипЗнч(Нерезидент) = Тип("Булево") Тогда
		Возврат ?(Нерезидент, ЮрисдикцияНерезидента(), ЮрисдикцияРезидента());
	КонецЕсли;
	
	СтранаРегистрации = ЗначениеМодели(Контекст.МодельСтало, "СтранаРегистрации");
	Если ЗначениеЗаполнено(СтранаРегистрации) Тогда
		Возврат ?(СтранаРегистрации = Справочники.СтраныМира.Россия,
			ЮрисдикцияРезидента(), ЮрисдикцияНерезидента());
	КонецЕсли;
	
	Возврат ЮрисдикцияНеОпределена();
	
КонецФункции

// Операция заявки по ВидОперации шапки: "создание", "изменение" или "прочее"
// (спека п. 3).
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияКонтекста(Знач ВидОперации)
	
	Если ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового Тогда
		Возврат ОперацияСоздание();
	ИначеЕсли ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		Возврат ОперацияИзменение();
	Иначе
		Возврат ОперацияПрочее();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область МеханизмПроверок

// Каталог проверок обработки (спека п. 3): каждая проверка - одна строка
// ДобавитьПроверку. Условия применимости по виду контрагента, юрисдикции и
// операции проверяет механизм (ПричинаНеПрименимости); особое условие
// проверки - ветка в ОсобаяПричинаНеПрименимости, текст условия для протокола
// строится из этих полей.
//
// Возвращаемое значение:
//  Массив из Структура - см. ДобавитьПроверку().
//
Функция КаталогПроверок()

	Каталог = Новый Массив;

	СозданиеИлиИзменение = ОперацияСоздание() + "," + ОперацияИзменение();

	// Первой: без этих реквизитов остальные проверки становятся «не применима».
	ДобавитьПроверку(Каталог, "ЗаполненыРеквизитыУсловийПроверок",
		НСтр("ru = 'Заполнены вид операции, юридическое / физическое лицо, юрисдикция и страна регистрации'"), "",
		"", "", "", "");

	ДобавитьПроверку(Каталог, "ИННПоВидуЛица", НСтр("ru = 'ИНН заполнен и соответствует виду лица'"), "",
		ВидЮЛ() + "," + ВидИП() + "," + ВидФЛ(), ЮрисдикцияРезидента(), СозданиеИлиИзменение, "");

	ДобавитьПроверку(Каталог, "ИНННеМеняется", НСтр("ru = 'ИНН не меняется'"), "",
		ВидЮЛ() + "," + ВидИП() + "," + ВидФЛ(), ЮрисдикцияРезидента(), ОперацияИзменение(),
		НСтр("ru = 'ИНН в карточке контрагента («было») заполнен'"));

	// Код проверки сохранен: по нему ar_ПакетНСИ и ar_АварийноеИсполнениеЗаявокНСИ
	// находят замечание о дубле (у физического лица - также по документу).
	ДобавитьПроверку(Каталог, "НетДубляИННКППНаименование",
		НСтр("ru = 'Нет дубля по ИНН, КПП и наименованию (физическое лицо - также по серии и номеру документа)'"), "",
		"", "", ОперацияСоздание(),
		НСтр("ru = 'ИНН в заявке заполнен либо физическое лицо с заполненными серией и номером документа'"));

	ДобавитьПроверку(Каталог, "НетДубляЮЛПоОснованиюУчетаКПП",
		НСтр("ru = 'Нет второй карточки юридического лица (КПП с кодами «01» и «50»)'"), "",
		ВидЮЛ(), ЮрисдикцияРезидента(), ОперацияСоздание(),
		НСтр("ru = 'заявка не на ОП и не на государственный орган, КПП - 9 цифр с кодом «01» или «50»'"));

	ДобавитьПроверку(Каталог, "КППЮрлицаРФ",
		НСтр("ru = 'КПП юридического лица, зарегистрированного в России: 9 цифр'"), "",
		ВидЮЛ(), "", СозданиеИлиИзменение, НСтр("ru = 'страна регистрации в заявке - Россия'"));

	ДобавитьПроверку(Каталог, "КППИВидКонтрагента",
		НСтр("ru = 'Знаки 5-6 КПП соответствуют виду контрагента'"), "",
		ВидЮЛ(), "", СозданиеИлиИзменение,
		НСтр("ru = 'КПП в заявке - не короче 6 знаков, контрагент - не государственный орган'"));

	ДобавитьПроверку(Каталог, "ИПНеМеняетВид",
		НСтр("ru = 'Индивидуальный предприниматель не меняет вид'"), "",
		"", "", ОперацияИзменение(),
		НСтр("ru = 'в карточке контрагента («было») вид - индивидуальный предприниматель'"));

	ДобавитьПроверку(Каталог, "ПаспортРФСерияНомер", НСтр("ru = 'Паспорт РФ: серия и номер'"), "",
		ВидФЛ() + "," + ВидИП(), "", СозданиеИлиИзменение,
		НСтр("ru = 'вид документа - «Паспорт гражданина РФ»'"));

	ДобавитьПроверку(Каталог, "ПаспортРФКодПодразделения",
		НСтр("ru = 'Паспорт РФ: код подразделения'"), "",
		ВидФЛ() + "," + ВидИП(), "", СозданиеИлиИзменение,
		НСтр("ru = 'вид документа - «Паспорт гражданина РФ», код подразделения заполнен'"));

	ДобавитьПроверку(Каталог, "АдресЭлектроннойПочты",
		НСтр("ru = 'Адрес электронной почты: один «@», без пробелов и непечатных символов'"), "",
		"", "", СозданиеИлиИзменение, НСтр("ru = 'в заявке есть адрес электронной почты'"));

	ДобавитьПроверку(Каталог, "ВГОМеняютсяТолькоКонтакты",
		НСтр("ru = 'У контрагента ВГО меняются только телефон и электронная почта'"), "",
		"", "", ОперацияИзменение(), НСтр("ru = 'в карточке контрагента («было») установлен признак ВГО'"));

	ДобавитьПроверку(Каталог, "ЖКХНеСнимается", НСтр("ru = 'Признак «ЖКХ» контрагента не снимается'"), "",
		"", "", ОперацияИзменение(),
		НСтр("ru = 'в карточке контрагента («было») установлен признак ЖКХ'"));

	ДобавитьПроверку(Каталог, "ЗУПНеСнимается", НСтр("ru = 'Признак «ЗУП» контрагента не снимается'"), "",
		"", "", ОперацияИзменение(),
		НСтр("ru = 'в карточке контрагента («было») установлен признак ЗУП'"));

	ДобавитьПроверку(Каталог, "КППКрупнейшегоНалогоплательщика",
		НСтр("ru = 'КПП крупнейшего налогоплательщика'"), "",
		ВидЮЛ(), "", ОперацияИзменение(),
		НСтр("ru = 'КПП в заявке отличается от КПП в справочнике, хотя бы один из них - КПП крупнейшего налогоплательщика'"));

	ДобавитьПроверку(Каталог, "ОПКрупнейшегоНалогоплательщика",
		НСтр("ru = 'Обособленное подразделение крупнейшего налогоплательщика'"), "",
		ВидЮЛ(), "", ОперацияСоздание(),
		НСтр("ru = 'заявка на обособленное подразделение, головной контрагент - крупнейший налогоплательщик (КПП с «50»)'"));

	ДобавитьПроверку(Каталог, "БанковскийСчетДопРеквизиты",
		НСтр("ru = 'Банковский счёт (дополнительные реквизиты)'"), "",
		"", "", СозданиеИлиИзменение,
		НСтр("ru = 'в дополнительных реквизитах заявки есть БИКБанка и НомерОсновногоБанковскогоСчета'"));

	Возврат Каталог;

КонецФункции

// Добавить проверку в каталог: описание проверки и условия ее применимости.
//
// Параметры:
//  Каталог         - Массив - пополняемый каталог проверок.
//  Код             - Строка - идентификатор проверки (ветка в РезультатВыполненияПроверки).
//  Наименование    - Строка - наименование для отчета.
//  ПунктРегламента - Строка - номер пункта регламента НСИ ("" - не указан).
//  Виды            - Строка - виды контрагента через запятую (ВидЮЛ() и др.); "" - любые.
//  Юрисдикции      - Строка - юрисдикции через запятую (ЮрисдикцияРезидента() и др.); "" - любые.
//  Операции        - Строка - операции заявки через запятую (ОперацияСоздание() и др.); "" - любые.
//  ОсобоеУсловие   - Строка - особое условие словами (проверяет ОсобаяПричинаНеПрименимости); "" - нет.
//
Процедура ДобавитьПроверку(Каталог, Знач Код, Знач Наименование, Знач ПунктРегламента,
	Знач Виды, Знач Юрисдикции, Знач Операции, Знач ОсобоеУсловие)

	ОписаниеПроверки = Новый Структура;
	ОписаниеПроверки.Вставить("Код", Код);
	ОписаниеПроверки.Вставить("Наименование", Наименование);
	ОписаниеПроверки.Вставить("ПунктРегламента", ПунктРегламента);
	ОписаниеПроверки.Вставить("Виды", ЗначенияСписка(Виды));
	ОписаниеПроверки.Вставить("Юрисдикции", ЗначенияСписка(Юрисдикции));
	ОписаниеПроверки.Вставить("Операции", ЗначенияСписка(Операции));
	ОписаниеПроверки.Вставить("ОсобоеУсловие", ОсобоеУсловие);
	ОписаниеПроверки.Вставить("УсловиеТекстом", УсловиеПрименимостиТекстом(ОписаниеПроверки));
	Каталог.Добавить(ОписаниеПроверки);

КонецПроцедуры

// Значения списка условия: строка через запятую - массив значений без
// крайних пробелов; пустая строка - пустой массив (условие не задано).
//
// Параметры:
//  Список - Строка - значения условия через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - значения без крайних пробелов.
//
Функция ЗначенияСписка(Знач Список)

	Значения = Новый Массив;
	Для Каждого Значение Из СтрРазделить(Список, ",", Ложь) Цикл
		Если НЕ ПустаяСтрока(Значение) Тогда
			Значения.Добавить(СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Условие применимости проверки словами для протокола - из полей каталога,
// чтобы текст условия не расходился с проверкой применимости.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//
// Возвращаемое значение:
//  Строка - условие применимости словами.
//
Функция УсловиеПрименимостиТекстом(Знач ОписаниеПроверки)

	Части = Новый Массив;
	Если ОписаниеПроверки.Виды.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'контрагент - %1'"),
			СтрСоединить(ОписаниеПроверки.Виды, " или ")));
	КонецЕсли;
	Если ОписаниеПроверки.Юрисдикции.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'юрисдикция - %1'"),
			СтрСоединить(ОписаниеПроверки.Юрисдикции, " или ")));
	КонецЕсли;
	Если ОписаниеПроверки.Операции.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'операция заявки - %1'"),
			СтрСоединить(ОписаниеПроверки.Операции, " или ")));
	КонецЕсли;
	Если НЕ ПустаяСтрока(ОписаниеПроверки.ОсобоеУсловие) Тогда
		Части.Добавить(ОписаниеПроверки.ОсобоеУсловие);
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат НСтр("ru = 'всегда'");
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Результаты всех проверок каталога для контекста (спека п. 3): неприменимая -
// статус «не применима» с причиной; исключение одной проверки не мешает
// остальным - статус «ошибка проверки».
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Соответствие - Код проверки -> Структура {Код, Наименование, Статус,
//  Пояснение, ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция РезультатыПроверок(Знач Контекст)

	Результаты = Новый Соответствие;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл

		Причина = ПричинаНеПрименимости(ОписаниеПроверки, Контекст);
		Если НЕ ПустаяСтрока(Причина) Тогда
			Результаты.Вставить(ОписаниеПроверки.Код,
				НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПрименима(), Причина));
			Продолжить;
		КонецЕсли;

		Попытка
			Результаты.Вставить(ОписаниеПроверки.Код, РезультатВыполненияПроверки(ОписаниеПроверки, Контекст));
		Исключение
			Результаты.Вставить(ОписаниеПроверки.Код, РезультатОшибкиПроверки(ОписаниеПроверки));
		КонецПопытки;

	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Причина неприменимости проверки к контексту (спека п. 3-4): общие условия
// каталога - вид контрагента, юрисдикция, операция заявки; затем особое
// условие проверки. Пустая строка - проверка применима.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеПрименимости(Знач ОписаниеПроверки, Знач Контекст)

	// Общая причина: заявка без данных модели - проверять нечего (спека п. 2).
	Если Контекст.МодельСтало = Неопределено Тогда
		Возврат НСтр("ru = 'в заявке нет данных модели'");
	КонецЕсли;

	Если ОписаниеПроверки.Виды.Количество() > 0
		И ОписаниеПроверки.Виды.Найти(Контекст.ВидКонтрагента) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'вид контрагента - %1, проверка для: %2'"),
			?(ПустаяСтрока(Контекст.ВидКонтрагента), НСтр("ru = 'не определен'"), Контекст.ВидКонтрагента),
			СтрСоединить(ОписаниеПроверки.Виды, ", "));
	КонецЕсли;

	Если ОписаниеПроверки.Юрисдикции.Количество() > 0
		И ОписаниеПроверки.Юрисдикции.Найти(Контекст.Юрисдикция) = Неопределено Тогда
		Если Контекст.Юрисдикция = ЮрисдикцияНеОпределена() Тогда
			Возврат НСтр("ru = 'юрисдикция контрагента не определена'");
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'юрисдикция - %1, проверка для: %2'"),
			Контекст.Юрисдикция, СтрСоединить(ОписаниеПроверки.Юрисдикции, ", "));
	КонецЕсли;

	Если ОписаниеПроверки.Операции.Количество() > 0
		И ОписаниеПроверки.Операции.Найти(Контекст.Операция) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'операция заявки - %1, проверка для: %2'"),
			Контекст.Операция, СтрСоединить(ОписаниеПроверки.Операции, ", "));
	КонецЕсли;

	Возврат ОсобаяПричинаНеПрименимости(ОписаниеПроверки.Код, Контекст);

КонецФункции

// Причина неприменимости по особому условию проверки (поле ОсобоеУсловие
// каталога); проверки без особого условия здесь не описываются.
//
// Параметры:
//  Код      - Строка    - идентификатор проверки.
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ОсобаяПричинаНеПрименимости(Знач Код, Знач Контекст)
	
	Если Код = "ИНННеМеняется" Тогда
		Возврат ПричинаПустогоИННВКарточке(Контекст);
	ИначеЕсли Код = "НетДубляИННКППНаименование" Тогда
		Возврат ПричинаНеприменимостиПроверкиДубля(Контекст);
	ИначеЕсли Код = "НетДубляЮЛПоОснованиюУчетаКПП" Тогда
		Возврат ПричинаНеприменимостиДубляЮЛПоОснованиюУчетаКПП(Контекст);
	ИначеЕсли Код = "КППЮрлицаРФ" Тогда
		Возврат ПричинаСтранаРегистрацииНеРоссия(Контекст);
	ИначеЕсли Код = "КППИВидКонтрагента" Тогда
		Возврат ПричинаНеприменимостиКПП(Контекст);
	ИначеЕсли Код = "ИПНеМеняетВид" Тогда
		Возврат ПричинаВидВКарточкеНеИП(Контекст);
	ИначеЕсли Код = "ПаспортРФСерияНомер" Тогда
		Возврат ПричинаДокументНеПаспортРФ(Контекст);
	ИначеЕсли Код = "ПаспортРФКодПодразделения" Тогда
		Возврат ПричинаНетКодаПодразделения(Контекст);
	ИначеЕсли Код = "АдресЭлектроннойПочты" Тогда
		Возврат ПричинаНетАдресаЭлектроннойПочты(Контекст);
	ИначеЕсли Код = "ВГОМеняютсяТолькоКонтакты" Тогда
		Возврат ПричинаКарточкаНеВГО(Контекст);
	ИначеЕсли Код = "ЖКХНеСнимается" Тогда
		Возврат ПричинаПризнакНеУстановленВКарточке(Контекст, "sd_КонтрагентЖКХ", НСтр("ru = 'ЖКХ'"));
	ИначеЕсли Код = "ЗУПНеСнимается" Тогда
		Возврат ПричинаПризнакНеУстановленВКарточке(Контекст, "sd_КонтрагентЗУП", НСтр("ru = 'ЗУП'"));
	ИначеЕсли Код = "КППКрупнейшегоНалогоплательщика" Тогда
		Возврат ПричинаНеприменимостиКППКрупнейшегоНалогоплательщика(Контекст);
	ИначеЕсли Код = "ОПКрупнейшегоНалогоплательщика" Тогда
		Возврат ПричинаНеприменимостиОПКрупнейшегоНалогоплательщика(Контекст);
	ИначеЕсли Код = "БанковскийСчетДопРеквизиты" Тогда
		Возврат ПричинаНеприменимостиСчета(Контекст);
	Иначе
		// Проверка без особого условия: применимость решают общие условия каталога.
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Особые причины неприменимости (см. ОсобаяПричинаНеПрименимости) - по функции
// на условие каталога.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаПустогоИННВКарточке(Знач Контекст)
	
	// Пустой ИНН в карточке разрешено заполнить (решение человека 2026-10-09).
	Если ПустаяСтрока(НормализованныйИНН(ЗначениеМодели(Контекст.МодельБыло, "ИНН"))) Тогда
		Возврат НСтр("ru = 'ИНН в карточке контрагента не был заполнен - заполнение ИНН допускается'");
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Физическое лицо с серией и номером документа проверяется на дубль по документу
// и без ИНН (1.7.0, см. ДубльИщетсяПоДокументу); иначе нужен ИНН.
Функция ПричинаНеприменимостиПроверкиДубля(Знач Контекст)
	
	Если ДубльИщетсяПоДокументу(Контекст) Тогда
		Возврат "";
	КонецЕсли;
	Если ПустаяСтрока(НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"))) Тогда
		Возврат НСтр("ru = 'ИНН в заявке не заполнен (у физического лица не заполнены серия или номер документа)'");
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПричинаКороткогоКПП(Знач Контекст)
	
	Если ПустаяСтрока(КодПричиныКПП(КППЗаявки(Контекст))) Тогда
		Возврат НСтр("ru = 'КПП в заявке не заполнен или короче 6 знаков'");
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПричинаВидВКарточкеНеИП(Знач Контекст)
	
	Если Контекст.ВидКарточкиБыло <> ВидКарточкиИП() Тогда
		Возврат СтрШаблон(НСтр("ru = 'вид контрагента в карточке («было») - %1'"),
			ВидКарточкиДляВывода(Контекст.ВидКарточкиБыло));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПричинаДокументНеПаспортРФ(Знач Контекст)
	
	Если НЕ ДокументЗаявкиПаспортРФ(Контекст) Тогда
		ВидДокумента = ЗначениеМодели(Контекст.МодельСтало, "sd_ВидДокумента");
		Если ВидДокумента = Неопределено Или ПустаяСтрока(Строка(ВидДокумента)) Тогда
			Возврат НСтр("ru = 'вид документа (sd_ВидДокумента) в заявке не заполнен'");
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'вид документа в заявке - «%1» (%2), не «Паспорт гражданина РФ»'"),
			Строка(ВидДокумента), ТипЗнч(ВидДокумента));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПричинаНетКодаПодразделения(Знач Контекст)
	
	Причина = ПричинаДокументНеПаспортРФ(Контекст);
	Если ПустаяСтрока(Причина)
		И ПустаяСтрока(Строка(ЗначениеМодели(Контекст.МодельСтало, "sd_ДокументКодПодразделения"))) Тогда
		Причина = НСтр("ru = 'код подразделения в заявке не заполнен'");
	КонецЕсли;
	Возврат Причина;
	
КонецФункции

Функция ПричинаНетАдресаЭлектроннойПочты(Знач Контекст)

	Если АдресаЭлектроннойПочтыЗаявки(Контекст).Количество() = 0 Тогда
		Возврат НСтр("ru = 'в заявке нет адреса электронной почты'");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПричинаКарточкаНеВГО(Знач Контекст)
	
	Если ЗначениеМодели(Контекст.МодельБыло, "sd_ВГО") <> Истина Тогда
		Возврат НСтр("ru = 'в карточке контрагента («было») признак ВГО не установлен'");
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Причина неприменимости проверки КПП юрлица (1.6.0): страна регистрации в
// заявке («стало») - не Россия или не заполнена (незаполненную страну у юрлица
// отмечает проверка ЗаполненыРеквизитыУсловийПроверок).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаСтранаРегистрацииНеРоссия(Знач Контекст)

	СтранаРегистрации = ЗначениеМодели(Контекст.МодельСтало, "СтранаРегистрации");
	Если НЕ ЗначениеЗаполнено(СтранаРегистрации) Тогда
		Возврат НСтр("ru = 'страна регистрации в заявке не заполнена'");
	КонецЕсли;
	Если СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		Возврат СтрШаблон(НСтр("ru = 'страна регистрации в заявке - %1'"), Строка(СтранаРегистрации));
	КонецЕсли;
	Возврат "";

КонецФункции

// Причина неприменимости проверки знаков 5-6 КПП: у государственного органа код
// причины постановки на учет не подчиняется правилу видовых кодов (1.5.0).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаКарточкаГосорган(Знач Контекст)

	Если Контекст.ВидКарточки = ВидКарточкиГосорган() Тогда
		Возврат НСтр("ru = 'контрагент - государственный орган'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Причина неприменимости проверки знаков 5-6 КПП (см. ОсобаяПричинаНеПрименимости):
// условие каталога - «КПП в заявке - не короче 6 знаков, контрагент - не
// государственный орган».
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаНеприменимостиКПП(Знач Контекст)

	Причина = ПричинаКарточкаГосорган(Контекст);
	Если ПустаяСтрока(Причина) Тогда
		Причина = ПричинаКороткогоКПП(Контекст);
	КонецЕсли;
	Возврат Причина;

КонецФункции

// Причина неприменимости проверки второй карточки юрлица (1.8.0): ОП и
// государственный орган не проверяются, ИНН и 9-значный КПП с кодом «01» или
// «50» в заявке обязательны - пустое значение совпадением не считается.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаНеприменимостиДубляЮЛПоОснованиюУчетаКПП(Знач Контекст)

	Если ЭтоОбособленноеПодразделение(Контекст) Тогда
		Возврат НСтр("ru = 'заявка на обособленное подразделение'");
	КонецЕсли;

	Причина = ПричинаКарточкаГосорган(Контекст);
	Если НЕ ПустаяСтрока(Причина) Тогда
		Возврат Причина;
	КонецЕсли;

	Если ПустаяСтрока(НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"))) Тогда
		Возврат НСтр("ru = 'ИНН в заявке не заполнен'");
	КонецЕсли;

	КПП = КППЗаявки(Контекст);
	Если СтрДлина(КПП) <> ДлинаКПП() Или НЕ ТолькоЦифры(КПП) Тогда
		Возврат НСтр("ru = 'КПП в заявке - не 9 цифр'");
	КонецЕсли;

	КодПричины = КодПричиныКПП(КПП);
	Если ПустаяСтрока(ПарныйКодПричиныКППЮрлица(КодПричины)) Тогда
		Возврат СтрШаблон(НСтр("ru = 'код причины КПП в заявке - «%1», не «01» и не «50»'"), КодПричины);
	КонецЕсли;
	Возврат "";

КонецФункции

// Причина неприменимости проверки-запрета снятия признака: признака нет
// в карточке («было») - снимать нечего. Признак задан парой «имя реквизита
// Контрагентов - представление для текста» (карта реквизитов - mcp.md [P3]).
//
// Параметры:
//  Контекст              - Структура - см. КонтекстПроверки().
//  ИмяПризнака           - Строка    - имя булева реквизита Контрагентов.
//  ПредставлениеПризнака - Строка    - представление признака для текста.
//
// Возвращаемое значение:
//  Строка - причина или "" (условие выполнено, проверка применима).
//
Функция ПричинаПризнакНеУстановленВКарточке(Знач Контекст, Знач ИмяПризнака, Знач ПредставлениеПризнака)

	Если НЕ ПризнакМоделиУстановлен(Контекст.МодельБыло, ИмяПризнака) Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'в карточке контрагента («было») признак «%1» не установлен'"), ПредставлениеПризнака);
	КонецЕсли;
	Возврат "";

КонецФункции

// Результат выполнения применимой проверки (спека п. 3): ветка по коду
// вызывает функцию проверки.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе} - статус «пройдена» или «не пройдена».
//
Функция РезультатВыполненияПроверки(Знач ОписаниеПроверки, Знач Контекст)

	Код = ОписаниеПроверки.Код;
	Если Код = "ЗаполненыРеквизитыУсловийПроверок" Тогда
		Возврат ПроверкаЗаполненыРеквизитыУсловийПроверок(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ИННПоВидуЛица" Тогда
		Возврат ПроверкаИННПоВидуЛица(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ИНННеМеняется" Тогда
		Возврат ПроверкаИНННеМеняется(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "НетДубляИННКППНаименование" Тогда
		Возврат ПроверкаДубляКонтрагента(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "НетДубляЮЛПоОснованиюУчетаКПП" Тогда
		Возврат ПроверкаДубляЮЛПоОснованиюУчетаКПП(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "КППЮрлицаРФ" Тогда
		Возврат ПроверкаКППЮрлицаРФ(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "КППИВидКонтрагента" Тогда
		Возврат ПроверкаКППИВидКонтрагента(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ИПНеМеняетВид" Тогда
		Возврат ПроверкаИПНеМеняетВид(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ПаспортРФСерияНомер" Тогда
		Возврат ПроверкаПаспортРФСерияНомер(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ПаспортРФКодПодразделения" Тогда
		Возврат ПроверкаПаспортРФКодПодразделения(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "АдресЭлектроннойПочты" Тогда
		Возврат ПроверкаАдресаЭлектроннойПочты(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ВГОМеняютсяТолькоКонтакты" Тогда
		Возврат ПроверкаВГОМеняютсяТолькоКонтакты(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ЖКХНеСнимается" Тогда
		Возврат ПроверкаПризнакНеСнимается(ОписаниеПроверки, Контекст,
			"sd_КонтрагентЖКХ", НСтр("ru = 'ЖКХ'"));
	ИначеЕсли Код = "ЗУПНеСнимается" Тогда
		Возврат ПроверкаПризнакНеСнимается(ОписаниеПроверки, Контекст,
			"sd_КонтрагентЗУП", НСтр("ru = 'ЗУП'"));
	ИначеЕсли Код = "КППКрупнейшегоНалогоплательщика" Тогда
		Возврат ПроверкаКППКрупнейшегоНалогоплательщика(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ОПКрупнейшегоНалогоплательщика" Тогда
		Возврат ПроверкаОПКрупнейшегоНалогоплательщика(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "БанковскийСчетДопРеквизиты" Тогда
		Возврат ПроверкаБанковскийСчетДопРеквизиты(ОписаниеПроверки, Контекст);
	Иначе
		// Неизвестный код каталога: исключение выходит наружу как «ошибка
		// проверки» (см. РезультатыПроверок).
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Для проверки «%1» не задан алгоритм выполнения.'"), Код);
	КонецЕсли;

КонецФункции

// Новый результат проверки с полями по спеке (п. 3).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Статус           - Строка - см. СтатусПройдена() и далее.
//  Пояснение        - Строка - текст для пользователя.
//  ЗначениеВЗаявке  - Строка - проверяемое значение из заявки.
//  ЗначениеВБазе    - Строка - сопоставленное значение из базы.
//  СсылкаВБазе      - Строка - навигационная ссылка найденного объекта базы.
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке, ЗначениеВБазе,
//  СсылкаВБазе}.
//
Функция НовыйРезультатПроверки(Знач ОписаниеПроверки, Знач Статус, Знач Пояснение,
	Знач ЗначениеВЗаявке = "", Знач ЗначениеВБазе = "", Знач СсылкаВБазе = "")
	
	Результат = Новый Структура;
	Результат.Вставить("Код", ОписаниеПроверки.Код);
	Результат.Вставить("Наименование", ОписаниеПроверки.Наименование);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("ЗначениеВЗаявке", ЗначениеВЗаявке);
	Результат.Вставить("ЗначениеВБазе", ЗначениеВБазе);
	Результат.Вставить("СсылкаВБазе", СсылкаВБазе);
	Возврат Результат;
	
КонецФункции

// Результат «ошибка проверки» для перехваченного исключения (спека п. 3):
// текст ошибки - краткое представление, без стека.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция РезультатОшибкиПроверки(Знач ОписаниеПроверки)
	
	Пояснение = СтрШаблон(НСтр("ru = 'Проверка завершилась ошибкой: %1'"),
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(), Пояснение);
	
КонецФункции

// Количество проверок по статусам (для итогов протокола и результата).
//
// Параметры:
//  Результаты - Соответствие - см. РезультатыПроверок().
//
// Возвращаемое значение:
//  Структура {Пройдено, НеПройдено, НеПрименимо, Ошибок} - Число.
//
Функция СводкаПоСтатусам(Знач Результаты)
	
	Сводка = Новый Структура("Пройдено, НеПройдено, НеПрименимо, Ошибок", 0, 0, 0, 0);
	Для Каждого КодИРезультат Из Результаты Цикл
		
		Если КодИРезультат.Значение.Статус = СтатусПройдена() Тогда
			Сводка.Пройдено = Сводка.Пройдено + 1;
		ИначеЕсли КодИРезультат.Значение.Статус = СтатусНеПройдена() Тогда
			Сводка.НеПройдено = Сводка.НеПройдено + 1;
		ИначеЕсли КодИРезультат.Значение.Статус = СтатусНеПрименима() Тогда
			Сводка.НеПрименимо = Сводка.НеПрименимо + 1;
		Иначе
			Сводка.Ошибок = Сводка.Ошибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Сводка;
	
КонецФункции

