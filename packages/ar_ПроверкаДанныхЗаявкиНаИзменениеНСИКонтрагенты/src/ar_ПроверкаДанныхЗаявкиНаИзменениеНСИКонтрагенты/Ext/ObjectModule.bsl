#Область ПрограммныйИнтерфейс

// Внешняя печатная форма «Проверка данных» для заявки НСИ на изменение
// (Документ.бит_мдм_ЗаявкаНаИзменение), задача agentrunner-60. Обработка создана
// по задаче FANDIT-18887 (доработка - agentrunner-81): добавлены проверки КПП
// крупнейшего налогоплательщика, обособленного подразделения крупнейшего
// налогоплательщика и банковского счёта из дополнительных реквизитов.
//
// Две команды печати БСП:
//   * Протокол  - «Проверка данных (протокол)» - все проверки каталога со
//                 статусами, пояснениями и итогом;
//   * Результат - «Проверка данных (результат)» - итог и только непройденные
//                 проверки с пояснениями.
//
// Проверки работают для заявок по справочнику «Контрагенты»
// (ОписаниеОбъекта.Имя = "Контрагенты"); для остальных объектов обмена
// печатается одна строка «проверка данных не выполняется», без исключения.
// Данные заявки - модели «стало» (ХранилищеМодельОбъекта) и «было»
// (ХранилищеМодельОбъектаПред), ключи моделей - имена реквизитов справочника
// Контрагенты (карта реквизитов - mcp.md [P3] задачи agentrunner-60). Пустая
// модель - проверки «не применима», не ошибка.
//
// Механизм: КаталогПроверок() - каждая проверка одной строкой ДобавитьПроверку:
// код, наименование, пункт регламента и условия применимости (виды
// контрагента, юрисдикции, операции заявки, особое условие словами);
// ПричинаНеПрименимости(Описание, Контекст) проверяет общие условия по каталогу,
// особые - ОсобаяПричинаНеПрименимости; РезультатВыполненияПроверки(Описание,
// Контекст) - выполнение. Новая проверка: строка каталога + ветка в
// РезультатВыполненияПроверки + функция проверки (+ ветка особого условия, если
// оно есть); механизм, вывод и текст условия в протоколе не меняются (спека п. 3,
// доработка на приемке по решению человека 2026-10-09). Шаблон задачи -
// три проверки: ИНН не меняется (ЮЛ/ИП-резидент РФ, изменение), нет дубля по
// ИНН + КПП + наименованию (создание), серия и номер паспорта РФ (ФЛ с видом
// документа «Паспорт гражданина РФ»).
//
// Обработка самостоятельная: без форм и макетов, без зависимости от
// ar_ПакетНСИ; отчет собирается строками в табличный документ моноширинным
// шрифтом. БезопасныйРежим = Истина - проверки читают только данные заявки
// и базы, сеть и файлы не нужны.
//
// Статусы проверки: «пройдена», «не пройдена», «не применима» (с причиной),
// «ошибка проверки» (исключение одной проверки не мешает остальным).

// Регистрация внешней печатной формы в подсистеме БСП «Дополнительные отчеты
// и обработки».
//
// Возвращаемое значение:
//  Структура - сведения о внешней обработке, см.
//  ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.1.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Проверка данных заявки на изменение НСИ (контрагенты)'");
	
	// Проверки читают модели заявки и справочник Контрагенты: сеть, файлы,
	// внешние компоненты не требуются (спека п. 1).
	ПараметрыРегистрации.БезопасныйРежим = Истина;
	
	ПараметрыРегистрации.Назначение.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
	
	// Идентификаторы и представления команд - из единых точек (спека п. 1).
	ИдентификаторПротокола = ИдентификаторКомандыПротокол();
	ИдентификаторРезультата = ИдентификаторКомандыРезультата();
	ДобавитьКомандуПроверки(ПараметрыРегистрации,
		ИдентификаторПротокола, ПредставлениеКоманды(ИдентификаторПротокола));
	ДобавитьКомандуПроверки(ПараметрыРегистрации,
		ИдентификаторРезультата, ПредставлениеКоманды(ИдентификаторРезультата));
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Обработчик печати БСП (вызывается УправлениеПечатью.ПечатьПоВнешнемуИсточнику):
// по каждой своей команде из коллекции печатных форм заполняет табличный
// документ отчета по заявкам назначения. Несколько заявок печатаются подряд,
// с разделителем (спека п. 1).
//
// Параметры:
//  ОбъектыНазначения     - Массив          - ссылки ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - строки команд печати (заполняется).
//  ОбъектыПечати         - СписокЗначений  - соответствие объектов и областей печати (не используется,
//                                            параметр контракта БСП).
//  ПараметрыВывода       - Структура       - параметры вывода печати (не используется, параметр контракта БСП).
//
Процедура Печать(ОбъектыНазначения, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого ИдентификаторКоманды Из ИдентификаторыКоманд() Цикл
		
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, ИдентификаторКоманды);
		Если ПечатнаяФорма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокументОтчета(ОбъектыНазначения, ИдентификаторКоманды);
		ПечатнаяФорма.СинонимМакета = ПредставлениеКоманды(ИдентификаторКоманды);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КомандыПечати

// Идентификаторы команд печати обработки (спека п. 1).
//
// Возвращаемое значение:
//  Массив из Строка - "Протокол", "Результат".
//
Функция ИдентификаторыКоманд()
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ИдентификаторКомандыПротокол());
	Идентификаторы.Добавить(ИдентификаторКомандыРезультата());
	Возврат Идентификаторы;
	
КонецФункции

// Идентификатор команды «протокол» (полный список проверок) - единая точка.
//
// Возвращаемое значение:
//  Строка - "Протокол".
//
Функция ИдентификаторКомандыПротокол()
	Возврат "Протокол";
КонецФункции

// Идентификатор команды «результат» (итог и непройденные) - единая точка.
//
// Возвращаемое значение:
//  Строка - "Результат".
//
Функция ИдентификаторКомандыРезультата()
	Возврат "Результат";
КонецФункции

// Представление команды печати для заголовка отчета и синонима макета.
//
// Параметры:
//  ИдентификаторКоманды - Строка - "Протокол" или "Результат".
//
// Возвращаемое значение:
//  Строка - представление команды.
//
Функция ПредставлениеКоманды(Знач ИдентификаторКоманды)
	
	Если ИдентификаторКоманды = ИдентификаторКомандыРезультата() Тогда
		Возврат НСтр("ru = 'Проверка данных (результат)'");
	КонецЕсли;
	Возврат НСтр("ru = 'Проверка данных (протокол)'");
	
КонецФункции

// Добавляет команду печати в параметры регистрации БСП: серверный метод,
// модификатор "ПечатьMXL" - вывод табличным документом (контракт печатных форм).
//
// Параметры:
//  ПараметрыРегистрации - Структура - см. СведенияОВнешнейОбработке().
//  ИдентификаторКоманды - Строка    - внутреннее имя команды.
//  Представление        - Строка    - пользовательское представление команды.
//
Процедура ДобавитьКомандуПроверки(ПараметрыРегистрации, Знач ИдентификаторКоманды, Знач Представление)
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = Представление;
	НоваяКоманда.Идентификатор        = ИдентификаторКоманды;
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	НоваяКоманда.Модификатор          = "ПечатьMXL";
	
КонецПроцедуры

#КонецОбласти

#Область СборкаОтчета

// Табличный документ отчета по всем заявкам назначения.
//
// Параметры:
//  ОбъектыНазначения    - Массив - ссылки ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИдентификаторКоманды - Строка - "Протокол" или "Результат".
//
// Возвращаемое значение:
//  ТабличныйДокумент - текстовый отчет моноширинным шрифтом.
//
Функция ТабличныйДокументОтчета(Знач ОбъектыНазначения, Знач ИдентификаторКоманды)
	
	СтрокиОтчета = Новый Массив;
	Для Каждого Заявка Из ОбъектыНазначения Цикл
		ДополнитьОтчетПоЗаявке(СтрокиОтчета, Заявка, ИдентификаторКоманды);
	КонецЦикла;
	Возврат ТабличныйДокументИзСтрок(СтрокиОтчета);
	
КонецФункции

// Дополняет отчет по одной заявке: одна строка для не-контрагентов (спека п. 2),
// иначе шапка и тело по команде печати.
//
// Параметры:
//  СтрокиОтчета         - Массив - пополняемый массив строк отчета.
//  Заявка               - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИдентификаторКоманды - Строка - "Протокол" или "Результат".
//
Процедура ДополнитьОтчетПоЗаявке(СтрокиОтчета, Знач Заявка, Знач ИдентификаторКоманды)
	
	Если СтрокиОтчета.Количество() > 0 Тогда
		СтрокиОтчета.Добавить(СтрокаРазделителя());
	КонецЕсли;
	
	Контекст = КонтекстПроверки(Заявка);
	
	Если НЕ Контекст.ПоКонтрагентам Тогда
		ДополнитьСтрокиТекстом(СтрокиОтчета, СтрШаблон(
			НСтр("ru = 'Заявка оформлена не по справочнику «Контрагенты» (%1) - проверка данных не выполняется.'"),
			?(ПустаяСтрока(Контекст.ИмяОбъекта), НСтр("ru = 'объект обмена не указан'"), Контекст.ИмяОбъекта)));
		Возврат;
	КонецЕсли;
	
	ДобавитьШапкуОтчета(СтрокиОтчета, Контекст, ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = ИдентификаторКомандыРезультата() Тогда
		ДобавитьРезультатПроверок(СтрокиОтчета, Контекст);
	Иначе
		ДобавитьПротоколПроверок(СтрокиОтчета, Контекст);
	КонецЕсли;
	
КонецПроцедуры

// Шапка отчета: команда, документ, ссылка, база, время, проверяющий и
// контрагент (спека п. 5).
//
// Параметры:
//  СтрокиОтчета         - Массив    - пополняемый массив строк отчета.
//  Контекст             - Структура - см. КонтекстПроверки().
//  ИдентификаторКоманды - Строка    - "Протокол" или "Результат".
//
Процедура ДобавитьШапкуОтчета(СтрокиОтчета, Знач Контекст, Знач ИдентификаторКоманды)
	
	СтрокиОтчета.Добавить(ПредставлениеКоманды(ИдентификаторКоманды));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Документ: %1'"), Контекст.Представление));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Ссылка: %1'"), ПолучитьНавигационнуюСсылку(Контекст.Ссылка)));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'База: %1'"), СтрокаСоединенияИнформационнойБазы()));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Время проверки: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ='дд.ММ.гггг ЧЧ:мм:сс'")));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Проверил: %1'"), Строка(Пользователи.ТекущийПользователь())));
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Контрагент: %1, %2, %3'"),
		?(ПустаяСтрока(Контекст.ВидКонтрагента), НСтр("ru = 'вид не определен'"), Контекст.ВидКонтрагента),
		Контекст.Юрисдикция,
		Контекст.Операция));
	СтрокиОтчета.Добавить("");
	
КонецПроцедуры

// Протокол: все проверки каталога со статусами и пояснениями; для «не применима» -
// условие применимости и причина; итог (спека п. 5).
//
// Параметры:
//  СтрокиОтчета - Массив    - пополняемый массив строк отчета.
//  Контекст     - Структура - см. КонтекстПроверки().
//
Процедура ДобавитьПротоколПроверок(СтрокиОтчета, Знач Контекст)
	
	Результаты = РезультатыПроверок(Контекст);
	
	НомерПроверки = 0;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл
		
		НомерПроверки = НомерПроверки + 1;
		Результат = Результаты.Получить(ОписаниеПроверки.Код);
		
		СтрокиОтчета.Добавить(ЗаголовокПроверкиВОтчете(НомерПроверки, ОписаниеПроверки, Результат.Статус));
		
		Если Результат.Статус = СтатусНеПрименима() Тогда
			СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = '   Проверка выполняется, если: %1.'"),
				ОписаниеПроверки.УсловиеТекстом));
			ДополнитьСтрокиТекстом(СтрокиОтчета,
				СтрШаблон(НСтр("ru = 'Причина: %1'"), Результат.Пояснение), "   ");
		Иначе
			ДополнитьСтрокиТекстом(СтрокиОтчета, Результат.Пояснение, "   ");
		КонецЕсли;
		
	КонецЦикла;
	
	Сводка = СводкаПоСтатусам(Результаты);
	СтрокиОтчета.Добавить("");
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Итого: пройдено %1 из %2 применимых, не пройдено %3.'"),
		Сводка.Пройдено,
		Сводка.Пройдено + Сводка.НеПройдено + Сводка.Ошибок,
		Сводка.НеПройдено + Сводка.Ошибок));
	
КонецПроцедуры

// Результат: итог и только непройденные проверки со статусом «не пройдена»
// и «ошибка проверки» (спека п. 5).
//
// Параметры:
//  СтрокиОтчета - Массив    - пополняемый массив строк отчета.
//  Контекст     - Структура - см. КонтекстПроверки().
//
Процедура ДобавитьРезультатПроверок(СтрокиОтчета, Знач Контекст)
	
	Результаты = РезультатыПроверок(Контекст);
	Сводка = СводкаПоСтатусам(Результаты);
	
	НеПройдено = Сводка.НеПройдено + Сводка.Ошибок;
	Если НеПройдено = 0 Тогда
		СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Проверки пройдены (%1).'"), Сводка.Пройдено));
		Возврат;
	КонецЕсли;
	
	СтрокиОтчета.Добавить(СтрШаблон(НСтр("ru = 'Не пройдены проверки: %1.'"), НеПройдено));
	СтрокиОтчета.Добавить("");
	
	НомерПроверки = 0;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл
		
		НомерПроверки = НомерПроверки + 1;
		Результат = Результаты.Получить(ОписаниеПроверки.Код);
		
		Если Результат.Статус <> СтатусНеПройдена() И Результат.Статус <> СтатусОшибкиПроверки() Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиОтчета.Добавить(ЗаголовокПроверкиВОтчете(НомерПроверки, ОписаниеПроверки, Результат.Статус));
		ДополнитьСтрокиТекстом(СтрокиОтчета, Результат.Пояснение, "   ");
		
	КонецЦикла;
	
КонецПроцедуры

// Заголовок проверки в отчете: номер, пункт регламента (если указан),
// наименование и статус.
//
// Параметры:
//  НомерПроверки    - Число     - порядковый номер в каталоге.
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Статус           - Строка    - статус проверки.
//
// Возвращаемое значение:
//  Строка - строка заголовка проверки для отчета.
//
Функция ЗаголовокПроверкиВОтчете(Знач НомерПроверки, Знач ОписаниеПроверки, Знач Статус)

	Если ПустаяСтрока(ОписаниеПроверки.ПунктРегламента) Тогда
		Возврат СтрШаблон(НСтр("ru = '%1. %2 - %3'"), НомерПроверки, ОписаниеПроверки.Наименование, Статус);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1. [п. %2] %3 - %4'"),
		НомерПроверки, ОписаниеПроверки.ПунктРегламента, ОписаниеПроверки.Наименование, Статус);

КонецФункции

// Табличный документ из массива строк: по строке текста на строку таблицы,
// моноширинный шрифт (спека п. 1: «текстовый отчет» печатается табличным
// документом - контракт БСП).
//
// Параметры:
//  СтрокиОтчета - Массив из Строка.
//
// Возвращаемое значение:
//  ТабличныйДокумент.
//
Функция ТабличныйДокументИзСтрок(Знач СтрокиОтчета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Если СтрокиОтчета.Количество() = 0 Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;
	
	ОбластьОтчета = ТабличныйДокумент.Область(1, 1, СтрокиОтчета.Количество(), 1);
	ОбластьОтчета.Шрифт = ШрифтОтчета();
	
	НомерСтроки = 0;
	Для Каждого СтрокаОтчета Из СтрокиОтчета Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = СтрокаОтчета;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Добавляет текст в массив строк отчета: пояснение может быть многострочным
// (переводы строки внутри пояснения), каждая часть - отдельная строка отчета.
//
// Параметры:
//  СтрокиОтчета - Массив - пополняемый массив строк отчета.
//  Текст        - Строка - текст с переводами строк; пустой текст ничего не добавляет.
//  Отступ       - Строка - префикс каждой строки (отступ пояснения под заголовком).
//
Процедура ДополнитьСтрокиТекстом(СтрокиОтчета, Знач Текст, Знач Отступ = "")
	
	Для Каждого Часть Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		СтрокиОтчета.Добавить(Отступ + СокрП(Часть));
	КонецЦикла;
	
КонецПроцедуры

// Разделитель отчетов по нескольким заявкам (спека п. 1) - 60 дефисов.
Функция СтрокаРазделителя()
	Возврат "------------------------------------------------------------";
КонецФункции

// Шрифт текстового отчета - моноширинный (спека п. 1); единая точка.
//
// Возвращаемое значение:
//  Шрифт.
//
Функция ШрифтОтчета()
	Возврат Новый Шрифт(ИмяШрифтаОтчета(), РазмерШрифтаОтчета());
КонецФункции

// Имя моноширинного шрифта отчета; стилей конфигурации у внешней обработки нет.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяШрифтаОтчета()
	Возврат "Courier New";
КонецФункции

// Размер шрифта отчета; единая точка.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерШрифтаОтчета()
	Возврат 9;
КонецФункции

#КонецОбласти

#Область КонтекстПроверки

// Контекст проверки заявки (спека п. 3): строится один раз на заявку.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка         - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//   * Представление  - Строка    - представление заявки.
//   * МодельСтало    - Структура, Неопределено - модель заявки «стало».
//   * МодельБыло     - Структура, Неопределено - модель заявки «было».
//   * Предмет        - СправочникСсылка - предмет заявки (для заявок по
//                      контрагентам при «Изменении» - ссылка на контрагента).
//   * ИмяОбъекта     - Строка    - имя объекта обмена (бит_мдм_ОписанияОбъектовОбмена.Имя).
//   * ПоКонтрагентам - Булево   - заявка по справочнику «Контрагенты».
//   * ЮрФизЛицо      - ПеречислениеСсылка.ЮридическоеФизическоеЛицо.
//   * ВидКонтрагента - Строка   - см. ВидЮЛ/ВидИП/ВидФЛ или "" (не определен).
//   * Юрисдикция     - Строка   - см. ЮрисдикцияРезидента/ЮрисдикцияНерезидента/ЮрисдикцияНеОпределена.
//   * Операция       - Строка   - см. ОперацияСоздание/ОперацияИзменение/ОперацияПрочее.
//
// Функции проверок дополняют контекст прочитанными из базы данными
// (КППВСправочнике, ДанныеГоловного, ЗначенияДопРеквизитов): проверка
// применимости и сама проверка используют одно чтение, БСП-методы чтения
// реквизитов кэша не имеют.
//
Функция КонтекстПроверки(Знач Заявка)
	
	// Шапка заявки одним вызовом БСП (стандарт: не через точку).
	Шапка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка,
		"ОписаниеОбъекта,ВидОперации,sd_ЮридическоеФизическоеЛицо,Предмет,"
		+ "ХранилищеМодельОбъекта,ХранилищеМодельОбъектаПред");
	
	Контекст = Новый Структура;
	Контекст.Вставить("Ссылка", Заявка);
	Контекст.Вставить("Представление", Строка(Заявка));
	Контекст.Вставить("МодельСтало", МодельИзХранилища(Шапка.ХранилищеМодельОбъекта));
	Контекст.Вставить("МодельБыло", МодельИзХранилища(Шапка.ХранилищеМодельОбъектаПред));
	Контекст.Вставить("Предмет", Шапка.Предмет);
	
	ИмяОбъекта = "";
	Если ЗначениеЗаполнено(Шапка.ОписаниеОбъекта) Тогда
		ИмяОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.ОписаниеОбъекта, "Имя");
	КонецЕсли;
	Контекст.Вставить("ИмяОбъекта", ИмяОбъекта);
	
	// Применимость: объект обмена «Контрагенты»; при «Изменение» дополнительно
	// предмет - ссылка на контрагента (спека п. 2).
	ПоКонтрагентам = ИмяОбъекта = "Контрагенты"
		И (Шапка.ВидОперации <> Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение
			Или ТипЗнч(Шапка.Предмет) = Тип("СправочникСсылка.Контрагенты"));
	Контекст.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	
	Контекст.Вставить("ЮрФизЛицо", Шапка.sd_ЮридическоеФизическоеЛицо);
	Контекст.Вставить("ВидКонтрагента", ?(ПоКонтрагентам, ВидКонтрагентаКонтекста(Контекст), ""));
	Контекст.Вставить("Юрисдикция", ?(ПоКонтрагентам, ЮрисдикцияКонтекста(Контекст), ""));
	Контекст.Вставить("Операция", ОперацияКонтекста(Шапка.ВидОперации));
	
	Возврат Контекст;
	
КонецФункции

// Модель заявки из хранилища значения: Структура или Соответствие; пустое или
// нестандартное хранилище - Неопределено (защита от старых заявок, спека п. 2).
//
// Параметры:
//  Хранилище - ХранилищеЗначения.
//
// Возвращаемое значение:
//  Структура, Соответствие, Неопределено.
//
Функция МодельИзХранилища(Знач Хранилище)
	
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Модель = Хранилище.Получить();
	Если ТипЗнч(Модель) = Тип("Структура") Или ТипЗнч(Модель) = Тип("Соответствие") Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Значение реквизита предмета из модели: группа «Реквизиты», затем
// «СтандартныеРеквизиты» (ключи моделей - имена реквизитов Контрагентов,
// mcp.md [P3] задачи).
//
// Параметры:
//  Модель       - Структура, Соответствие, Неопределено.
//  ИмяРеквизита - Строка - имя реквизита предмета ("ИНН", "Наименование"...).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - группа или ключ отсутствуют.
//
Функция ЗначениеМодели(Знач Модель, Знач ИмяРеквизита)
	
	Если Модель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "Реквизиты"), ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Значение = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "СтандартныеРеквизиты"), ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

// Значение из коллекции модели: Структура - по свойству, Соответствие - по
// ключу; иное или отсутствие - Неопределено.
//
// Параметры:
//  Коллекция - Структура, Соответствие, произвольное.
//  Ключ      - Строка.
//
// Возвращаемое значение:
//  Произвольный, Неопределено.
//
Функция ЗначениеИзКоллекции(Знач Коллекция, Знач Ключ)
	
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Табличная часть модели: строки таблицы по имени (группа «ТабличныеЧасти»);
// отсутствие модели, группы или таблицы - пустой массив: проверка «не
// применима», а не ошибка (спека п. 2.3).
//
// Параметры:
//  Модель     - Структура, Соответствие, Неопределено - модель предмета заявки.
//  ИмяТаблицы - Строка - имя табличной части предмета ("ДополнительныеРеквизиты").
//
// Возвращаемое значение:
//  Массив из Структура, Соответствие - строки табличной части; пустой массив,
//  если таблицы в модели нет.
//
Функция ТаблицаМодели(Знач Модель, Знач ИмяТаблицы)
	
	Таблица = ЗначениеИзКоллекции(ЗначениеИзКоллекции(Модель, "ТабличныеЧасти"), ИмяТаблицы);
	Если ТипЗнч(Таблица) = Тип("Массив") Тогда
		Возврат Таблица;
	КонецЕсли;
	Возврат Новый Массив;
	
КонецФункции

// Признак контрагента из модели: берется из модели «стало», при отсутствии -
// из «было» (заявка на изменение, где признак не менялся пользователем).
//
// Параметры:
//  Контекст     - Структура - см. КонтекстПроверки().
//  ИмяРеквизита - Строка - "sd_ИП", "ИндивидуальныйПредприниматель",
//                 "sd_Нерезидент", "СтранаРегистрации".
//
// Возвращаемое значение:
//  Произвольный, Неопределено - признак не найден ни в одной модели.
//
Функция ПризнакКонтекста(Знач Контекст, Знач ИмяРеквизита)
	
	Значение = ЗначениеМодели(Контекст.МодельСтало, ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеМодели(Контекст.МодельБыло, ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

// Вид контрагента по юр/физ заявки и признакам ИП из модели: "ЮЛ", "ИП", "ФЛ";
// пустая строка - вид не определен.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидКонтрагентаКонтекста(Знач Контекст)
	
	Если Контекст.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		// У предпринимателя вид заявки - «Юридическое лицо», ИП выделяется флагами.
		Если ПризнакКонтекста(Контекст, "sd_ИП") = Истина
			Или ПризнакКонтекста(Контекст, "ИндивидуальныйПредприниматель") = Истина Тогда
			Возврат ВидИП();
		КонецЕсли;
		Возврат ВидЮЛ();
	ИначеЕсли Контекст.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат ВидФЛ();
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Юрисдикция контрагента: по sd_Нерезидент; дублер - СтранаРегистрации
// (РФ - резидент, иная страна - нерезидент); иначе «не определена» (спека п. 3).
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка.
//
Функция ЮрисдикцияКонтекста(Знач Контекст)
	
	Нерезидент = ПризнакКонтекста(Контекст, "sd_Нерезидент");
	Если ТипЗнч(Нерезидент) = Тип("Булево") Тогда
		Возврат ?(Нерезидент, ЮрисдикцияНерезидента(), ЮрисдикцияРезидента());
	КонецЕсли;
	
	СтранаРегистрации = ПризнакКонтекста(Контекст, "СтранаРегистрации");
	Если ЗначениеЗаполнено(СтранаРегистрации) Тогда
		Возврат ?(СтранаРегистрации = Справочники.СтраныМира.Россия,
			ЮрисдикцияРезидента(), ЮрисдикцияНерезидента());
	КонецЕсли;
	
	Возврат ЮрисдикцияНеОпределена();
	
КонецФункции

// Операция заявки по ВидОперации шапки: "создание", "изменение" или "прочее"
// (спека п. 3).
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияКонтекста(Знач ВидОперации)
	
	Если ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового Тогда
		Возврат ОперацияСоздание();
	ИначеЕсли ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		Возврат ОперацияИзменение();
	Иначе
		Возврат ОперацияПрочее();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область МеханизмПроверок

// Каталог проверок обработки (спека п. 3): каждая проверка - одна строка
// ДобавитьПроверку. Условия применимости по виду контрагента, юрисдикции и
// операции проверяет механизм (ПричинаНеПрименимости); особое условие
// проверки - ветка в ОсобаяПричинаНеПрименимости, текст условия для протокола
// строится из этих полей.
//
// Возвращаемое значение:
//  Массив из Структура - см. ДобавитьПроверку().
//
Функция КаталогПроверок()

	Каталог = Новый Массив;

	ДобавитьПроверку(Каталог, "ИНННеМеняется", НСтр("ru = 'ИНН не меняется'"), "",
		ВидЮЛ() + "," + ВидИП(), ЮрисдикцияРезидента(), ОперацияИзменение(), "");

	ДобавитьПроверку(Каталог, "НетДубляИННКППНаименование",
		НСтр("ru = 'Нет дубля по ИНН, КПП и наименованию'"), "",
		"", "", ОперацияСоздание(), НСтр("ru = 'ИНН в заявке заполнен'"));

	ДобавитьПроверку(Каталог, "ПаспортРФСерияНомер", НСтр("ru = 'Паспорт РФ: серия и номер'"), "",
		ВидФЛ(), "", ОперацияСоздание() + "," + ОперацияИзменение(),
		НСтр("ru = 'вид документа - «Паспорт гражданина РФ»'"));

	ДобавитьПроверку(Каталог, "КППКрупнейшегоНалогоплательщика",
		НСтр("ru = 'КПП крупнейшего налогоплательщика'"), "",
		ВидЮЛ(), "", ОперацияИзменение(),
		НСтр("ru = 'КПП в заявке отличается от КПП в справочнике, хотя бы один из них - КПП крупнейшего налогоплательщика'"));

	ДобавитьПроверку(Каталог, "ОПКрупнейшегоНалогоплательщика",
		НСтр("ru = 'Обособленное подразделение крупнейшего налогоплательщика'"), "",
		ВидЮЛ(), "", ОперацияСоздание(),
		НСтр("ru = 'заявка на обособленное подразделение, головной контрагент - крупнейший налогоплательщик (КПП с «50»)'"));

	ДобавитьПроверку(Каталог, "БанковскийСчетДопРеквизиты",
		НСтр("ru = 'Банковский счёт (дополнительные реквизиты)'"), "",
		"", "", ОперацияСоздание() + "," + ОперацияИзменение(),
		НСтр("ru = 'в дополнительных реквизитах заявки есть БИКБанка и НомерБанковскогоСчета'"));

	Возврат Каталог;

КонецФункции

// Добавить проверку в каталог: описание проверки и условия ее применимости.
//
// Параметры:
//  Каталог         - Массив - пополняемый каталог проверок.
//  Код             - Строка - идентификатор проверки (ветка в РезультатВыполненияПроверки).
//  Наименование    - Строка - наименование для отчета.
//  ПунктРегламента - Строка - номер пункта регламента НСИ ("" - не указан).
//  Виды            - Строка - виды контрагента через запятую (ВидЮЛ() и др.); "" - любые.
//  Юрисдикции      - Строка - юрисдикции через запятую (ЮрисдикцияРезидента() и др.); "" - любые.
//  Операции        - Строка - операции заявки через запятую (ОперацияСоздание() и др.); "" - любые.
//  ОсобоеУсловие   - Строка - особое условие словами (проверяет ОсобаяПричинаНеПрименимости); "" - нет.
//
Процедура ДобавитьПроверку(Каталог, Знач Код, Знач Наименование, Знач ПунктРегламента,
	Знач Виды, Знач Юрисдикции, Знач Операции, Знач ОсобоеУсловие)

	ОписаниеПроверки = Новый Структура;
	ОписаниеПроверки.Вставить("Код", Код);
	ОписаниеПроверки.Вставить("Наименование", Наименование);
	ОписаниеПроверки.Вставить("ПунктРегламента", ПунктРегламента);
	ОписаниеПроверки.Вставить("Виды", ЗначенияСписка(Виды));
	ОписаниеПроверки.Вставить("Юрисдикции", ЗначенияСписка(Юрисдикции));
	ОписаниеПроверки.Вставить("Операции", ЗначенияСписка(Операции));
	ОписаниеПроверки.Вставить("ОсобоеУсловие", ОсобоеУсловие);
	ОписаниеПроверки.Вставить("УсловиеТекстом", УсловиеПрименимостиТекстом(ОписаниеПроверки));
	Каталог.Добавить(ОписаниеПроверки);

КонецПроцедуры

// Значения списка условия: строка через запятую - массив значений без
// крайних пробелов; пустая строка - пустой массив (условие не задано).
//
// Параметры:
//  Список - Строка - значения условия через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - значения без крайних пробелов.
//
Функция ЗначенияСписка(Знач Список)

	Значения = Новый Массив;
	Для Каждого Значение Из СтрРазделить(Список, ",", Ложь) Цикл
		Если НЕ ПустаяСтрока(Значение) Тогда
			Значения.Добавить(СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Условие применимости проверки словами для протокола - из полей каталога,
// чтобы текст условия не расходился с проверкой применимости.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//
// Возвращаемое значение:
//  Строка - условие применимости словами.
//
Функция УсловиеПрименимостиТекстом(Знач ОписаниеПроверки)

	Части = Новый Массив;
	Если ОписаниеПроверки.Виды.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'контрагент - %1'"),
			СтрСоединить(ОписаниеПроверки.Виды, " или ")));
	КонецЕсли;
	Если ОписаниеПроверки.Юрисдикции.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'юрисдикция - %1'"),
			СтрСоединить(ОписаниеПроверки.Юрисдикции, " или ")));
	КонецЕсли;
	Если ОписаниеПроверки.Операции.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'операция заявки - %1'"),
			СтрСоединить(ОписаниеПроверки.Операции, " или ")));
	КонецЕсли;
	Если НЕ ПустаяСтрока(ОписаниеПроверки.ОсобоеУсловие) Тогда
		Части.Добавить(ОписаниеПроверки.ОсобоеУсловие);
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат НСтр("ru = 'всегда'");
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Результаты всех проверок каталога для контекста (спека п. 3): неприменимая -
// статус «не применима» с причиной; исключение одной проверки не мешает
// остальным - статус «ошибка проверки».
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Соответствие - Код проверки -> Структура {Код, Наименование, Статус,
//  Пояснение, ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция РезультатыПроверок(Знач Контекст)

	Результаты = Новый Соответствие;
	Для Каждого ОписаниеПроверки Из КаталогПроверок() Цикл

		Причина = ПричинаНеПрименимости(ОписаниеПроверки, Контекст);
		Если НЕ ПустаяСтрока(Причина) Тогда
			Результаты.Вставить(ОписаниеПроверки.Код,
				НовыйРезультатПроверки(ОписаниеПроверки, СтатусНеПрименима(), Причина));
			Продолжить;
		КонецЕсли;

		Попытка
			Результаты.Вставить(ОписаниеПроверки.Код, РезультатВыполненияПроверки(ОписаниеПроверки, Контекст));
		Исключение
			Результаты.Вставить(ОписаниеПроверки.Код, РезультатОшибкиПроверки(ОписаниеПроверки));
		КонецПопытки;

	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Причина неприменимости проверки к контексту (спека п. 3-4): общие условия
// каталога - вид контрагента, юрисдикция, операция заявки; затем особое
// условие проверки. Пустая строка - проверка применима.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеПрименимости(Знач ОписаниеПроверки, Знач Контекст)

	// Общая причина: заявка без данных модели - проверять нечего (спека п. 2).
	Если Контекст.МодельСтало = Неопределено Тогда
		Возврат НСтр("ru = 'в заявке нет данных модели'");
	КонецЕсли;

	Если ОписаниеПроверки.Виды.Количество() > 0
		И ОписаниеПроверки.Виды.Найти(Контекст.ВидКонтрагента) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'вид контрагента - %1, проверка для: %2'"),
			?(ПустаяСтрока(Контекст.ВидКонтрагента), НСтр("ru = 'не определен'"), Контекст.ВидКонтрагента),
			СтрСоединить(ОписаниеПроверки.Виды, ", "));
	КонецЕсли;

	Если ОписаниеПроверки.Юрисдикции.Количество() > 0
		И ОписаниеПроверки.Юрисдикции.Найти(Контекст.Юрисдикция) = Неопределено Тогда
		Если Контекст.Юрисдикция = ЮрисдикцияНеОпределена() Тогда
			Возврат НСтр("ru = 'юрисдикция контрагента не определена'");
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'юрисдикция - %1, проверка для: %2'"),
			Контекст.Юрисдикция, СтрСоединить(ОписаниеПроверки.Юрисдикции, ", "));
	КонецЕсли;

	Если ОписаниеПроверки.Операции.Количество() > 0
		И ОписаниеПроверки.Операции.Найти(Контекст.Операция) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'операция заявки - %1, проверка для: %2'"),
			Контекст.Операция, СтрСоединить(ОписаниеПроверки.Операции, ", "));
	КонецЕсли;

	Возврат ОсобаяПричинаНеПрименимости(ОписаниеПроверки.Код, Контекст);

КонецФункции

// Причина неприменимости по особому условию проверки (поле ОсобоеУсловие
// каталога); проверки без особого условия здесь не описываются.
//
// Параметры:
//  Код      - Строка    - идентификатор проверки.
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ОсобаяПричинаНеПрименимости(Знач Код, Знач Контекст)
	
	Причина = "";
	Если Код = "НетДубляИННКППНаименование" Тогда
		Если ПустаяСтрока(НормализованныйИНН(ЗначениеМодели(Контекст.МодельСтало, "ИНН"))) Тогда
			Причина = НСтр("ru = 'ИНН в заявке не заполнен'");
		КонецЕсли;
	ИначеЕсли Код = "ПаспортРФСерияНомер" Тогда
		// Сравнение по ссылке на предопределенный элемент (решение В2).
		Если ЗначениеМодели(Контекст.МодельСтало, "sd_ВидДокумента")
			<> Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
			Причина = НСтр("ru = 'вид документа в заявке - не «Паспорт гражданина РФ»'");
		КонецЕсли;
	ИначеЕсли Код = "КППКрупнейшегоНалогоплательщика" Тогда
		// Особое условие: КПП заявки отличается от КПП справочника и хотя бы
		// один из них - КПП крупнейшего налогоплательщика (спека п. 2.1).
		КППВЗаявке = НормализованныйКПП(ЗначениеМодели(Контекст.МодельСтало, "КПП"));
		КППСправочника = КППВСправочнике(Контекст);
		Если КППВЗаявке = КППСправочника Тогда
			Причина = НСтр("ru = 'КПП не меняется'");
		ИначеЕсли НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППВЗаявке)
			И НЕ ЭтоКППКрупнейшегоНалогоплательщика(КППСправочника) Тогда
			Причина = НСтр("ru = 'ни один КПП не является КПП крупнейшего налогоплательщика'");
		КонецЕсли;
	ИначеЕсли Код = "ОПКрупнейшегоНалогоплательщика" Тогда
		// Особое условие: заявка на обособленное подразделение, головной
		// контрагент - крупнейший налогоплательщик (спека п. 2.2).
		Если НЕ ЭтоОбособленноеПодразделение(Контекст) Тогда
			Причина = НСтр("ru = 'заявка не на обособленное подразделение'");
		Иначе
			ДанныеГоловного = ДанныеГоловногоКонтрагента(Контекст);
			Если ДанныеГоловного = Неопределено Тогда
				Причина = НСтр("ru = 'головной контрагент в заявке не указан'");
			ИначеЕсли НЕ ЭтоКППКрупнейшегоНалогоплательщика(ДанныеГоловного.КПП) Тогда
				Причина = СтрШаблон(
					НСтр("ru = 'головной контрагент - не крупнейший налогоплательщик (КПП %1)'"),
					ЗначениеДляВывода(ДанныеГоловного.КПП));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Код = "БанковскийСчетДопРеквизиты" Тогда
		// Особое условие: в дополнительных реквизитах заявки есть оба реквизита
		// счета и номер заполнен (спека п. 2.3).
		Причина = ПричинаНеприменимостиСчета(Контекст);
	Иначе
		// Проверка без особого условия: применимость решают общие условия каталога.
		Причина = "";
	КонецЕсли;
	
	Возврат Причина;
	
КонецФункции

// Причина неприменимости проверки банковского счёта (спека п. 2.3): нужны
// таблица ДополнительныеРеквизиты заявки с реквизитами БИКБанка и
// НомерБанковскогоСчета, заполненный номер и правила для резидента РФ либо
// для ИП / ФЛ. Пустая строка - проверка применима.
//
// Параметры:
//  Контекст - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Строка - причина или "".
//
Функция ПричинаНеприменимостиСчета(Знач Контекст)
	
	ЗначенияДопРеквизитов = ЗначенияДопРеквизитовЗаявки(Контекст);
	НомерСчета = ЗначенияДопРеквизитов.Получить("НомерБанковскогоСчета");
	Если НомерСчета = Неопределено
		Или ЗначенияДопРеквизитов.Получить("БИКБанка") = Неопределено Тогда
		Возврат НСтр("ru = 'в дополнительных реквизитах нет БИКБанка и НомерБанковскогоСчета'");
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаБезПробелов(НомерСчета)) Тогда
		Возврат НСтр("ru = 'номер банковского счёта не заполнен'");
	КонецЕсли;
	
	Если Контекст.ВидКонтрагента <> ВидИП() И Контекст.ВидКонтрагента <> ВидФЛ()
		И Контекст.Юрисдикция <> ЮрисдикцияРезидента() Тогда
		Возврат НСтр("ru = 'правила счёта заданы для резидента РФ и для ИП / ФЛ'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Результат выполнения применимой проверки (спека п. 3): ветка по коду
// вызывает функцию проверки.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Контекст         - Структура - см. КонтекстПроверки().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке,
//  ЗначениеВБазе} - статус «пройдена» или «не пройдена».
//
Функция РезультатВыполненияПроверки(Знач ОписаниеПроверки, Знач Контекст)

	Код = ОписаниеПроверки.Код;
	Если Код = "ИНННеМеняется" Тогда
		Возврат ПроверкаИНННеМеняется(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "НетДубляИННКППНаименование" Тогда
		Возврат ПроверкаДубляИННКППНаименование(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ПаспортРФСерияНомер" Тогда
		Возврат ПроверкаПаспортРФСерияНомер(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "КППКрупнейшегоНалогоплательщика" Тогда
		Возврат ПроверкаКППКрупнейшегоНалогоплательщика(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "ОПКрупнейшегоНалогоплательщика" Тогда
		Возврат ПроверкаОПКрупнейшегоНалогоплательщика(ОписаниеПроверки, Контекст);
	ИначеЕсли Код = "БанковскийСчетДопРеквизиты" Тогда
		Возврат ПроверкаБанковскийСчетДопРеквизиты(ОписаниеПроверки, Контекст);
	Иначе
		// Неизвестный код каталога: исключение выходит наружу как «ошибка
		// проверки» (см. РезультатыПроверок).
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Для проверки «%1» не задан алгоритм выполнения.'"), Код);
	КонецЕсли;

КонецФункции

// Новый результат проверки с полями по спеке (п. 3).
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//  Статус           - Строка - см. СтатусПройдена() и далее.
//  Пояснение        - Строка - текст для пользователя.
//  ЗначениеВЗаявке  - Строка - проверяемое значение из заявки.
//  ЗначениеВБазе    - Строка - сопоставленное значение из базы.
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция НовыйРезультатПроверки(Знач ОписаниеПроверки, Знач Статус, Знач Пояснение,
	Знач ЗначениеВЗаявке = "", Знач ЗначениеВБазе = "")
	
	Результат = Новый Структура;
	Результат.Вставить("Код", ОписаниеПроверки.Код);
	Результат.Вставить("Наименование", ОписаниеПроверки.Наименование);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("ЗначениеВЗаявке", ЗначениеВЗаявке);
	Результат.Вставить("ЗначениеВБазе", ЗначениеВБазе);
	Возврат Результат;
	
КонецФункции

// Результат «ошибка проверки» для перехваченного исключения (спека п. 3):
// текст ошибки - краткое представление, без стека.
//
// Параметры:
//  ОписаниеПроверки - Структура - см. ДобавитьПроверку().
//
// Возвращаемое значение:
//  Структура {Код, Наименование, Статус, Пояснение, ЗначениеВЗаявке, ЗначениеВБазе}.
//
Функция РезультатОшибкиПроверки(Знач ОписаниеПроверки)
	
	Пояснение = СтрШаблон(НСтр("ru = 'Проверка завершилась ошибкой: %1'"),
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	Возврат НовыйРезультатПроверки(ОписаниеПроверки, СтатусОшибкиПроверки(), Пояснение);
	
КонецФункции

// Количество проверок по статусам (для итогов протокола и результата).
//
// Параметры:
//  Результаты - Соответствие - см. РезультатыПроверок().
//
// Возвращаемое значение:
//  Структура {Пройдено, НеПройдено, НеПрименимо, Ошибок} - Число.
//
Функция СводкаПоСтатусам(Знач Результаты)
	
	Сводка = Новый Структура("Пройдено, НеПройдено, НеПрименимо, Ошибок", 0, 0, 0, 0);
	Для Каждого КодИРезультат Из Результаты Цикл
		
		Если КодИРезультат.Значение.Статус = СтатусПройдена() Тогда
			Сводка.Пройдено = Сводка.Пройдено + 1;
		ИначеЕсли КодИРезультат.Значение.Статус = СтатусНеПройдена() Тогда
			Сводка.НеПройдено = Сводка.НеПройдено + 1;
		ИначеЕсли КодИРезультат.Значение.Статус = СтатусНеПрименима() Тогда
			Сводка.НеПрименимо = Сводка.НеПрименимо + 1;
		Иначе
			Сводка.Ошибок = Сводка.Ошибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Сводка;
	
КонецФункции

