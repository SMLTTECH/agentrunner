////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Форма обработки «Выгрузка документов по договору» (agentrunner-472).
// Отбор документов - серверные функции модуля объекта; получение файлов - фоновое задание БСП
// порциями до 100 МБ (ДлительныеОперации), запись на диск - асинхронные методы платформы на клиенте.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем ПорцииВыгрузки;       // Массив из массивов строк таблицы Документы - порции выгрузки.
&НаКлиенте
Перем НомерТекущейПорции;   // Число - номер выполняемой порции, начиная с 1.
&НаКлиенте
Перем ИдентификаторЗадания; // УникальныйИдентификатор - активное фоновое задание порции.
&НаКлиенте
Перем ИдетВыгрузка;         // Булево - выгрузка запущена.
&НаКлиенте
Перем ПрерваноПользователем;// Булево - пользователь нажал «Отменить».
&НаКлиенте
Перем СохраненоФайлов;      // Число - записанные на диск файлы (без подписей).
&НаКлиенте
Перем СохраненоПодписей;    // Число - записанные на диск файлы подписей.
&НаКлиенте
Перем ЗаписанныеФайлы;      // Массив из Структура - ОтносительныйПуть, ЭтоПодпись, ОсновнойФайл: записанные
                            // на диск файлы выгрузки - для списка «Выгрузка ДО.json» (agentrunner-480).

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КаталогИзНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ar_ВыгрузкаДокументовПоДоговору", "Каталог");
	Если ТипЗнч(КаталогИзНастроек) = Тип("Строка") Тогда
		Каталог = КаталогИзНастроек;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИдетВыгрузка = Ложь;
	ПрерваноПользователем = Ложь;
	СохраненоФайлов = 0;
	СохраненоПодписей = 0;
	ЗаписанныеФайлы = Новый Массив;

	Если ПустаяСтрока(Каталог) Тогда
		Попытка
			Каталог = КаталогДокументов() + "\Выгрузка ДО";
		Исключение
			Каталог = ""; // Каталог документов недоступен (веб-клиент без расширения) - пользователь выберет сам.
		КонецПопытки;
	Иначе
		// Каталог из прошлого запуска может быть папкой «ДО» задания разбора: договор - по заданию, иначе
		// документы другого договора уйдут в эту папку.
		ПодставитьДоговорИзЗаданияРазбора();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, СтандартнаяОбработка)

	Если ИдетВыгрузка Тогда
		Отказ = Истина;
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаПрерватьВыгрузку", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Прервать выгрузку?'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаПрерватьВыгрузку(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ПрерваноПользователем = Истина;
		ОтменитьЗаданиеНаСервере(ИдентификаторЗадания);
		ИдетВыгрузка = Ложь;
		ВывестиИтог(Истина);
		Закрыть(); // Пользователь подтверждал закрытие формы; ПередЗакрытием пропустит - выгрузка уже не идет.
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОчиститьРезультатыПоиска();
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЭтоДоговорНаСервере(Договор) Тогда
		Договор = ПредопределенноеЗначение("Справочник.ВнутренниеДокументы.ПустаяСсылка");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Выберите договор: вид выбранного документа не является договором.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("КаталогПослеВыбораВДиалоге", ЭтотОбъект);
	ФайловаяСистемаКлиент.ВыбратьКаталог(Оповещение, НСтр("ru = 'Выберите каталог для сохранения файлов'"), Каталог);

КонецПроцедуры

&НаКлиенте
Процедура КаталогПослеВыбораВДиалоге(Результат, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(Результат) Тогда
		Каталог = Результат;
		СохранитьКаталогНаСервере();
		ПодставитьДоговорИзЗаданияРазбора();
	КонецЕсли;

КонецПроцедуры

// Путь вставляют и вручную (из письма сбора документов расторжения) - договор подставляется так же, как
// после выбора в диалоге.
&НаКлиенте
Процедура КаталогПриИзменении(Элемент)

	Если ПустаяСтрока(Каталог) Тогда
		Возврат;
	КонецЕсли;
	СохранитьКаталогНаСервере();
	ПодставитьДоговорИзЗаданияРазбора();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиДоговор(Команда)

	Если ПустаяСтрока(НомерДоговора) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введите номер договора.'"));
		Возврат;
	КонецЕсли;

	Договоры = НайтиДоговорыНаСервере(НомерДоговора);

	Если Договоры.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Договор с номером %1 не найден.'"), СокрЛП(НомерДоговора)));
	ИначеЕсли Договоры.Количество() = 1 Тогда
		ПодставитьДоговор(Договоры[0].Договор);
	Иначе
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаДоговора Из Договоры Цикл
			СписокВыбора.Добавить(СтрокаДоговора.Договор, ПредставлениеДоговораВыбора(СтрокаДоговора));
		КонецЦикла;
		Оповещение = Новый ОписаниеОповещения("ДоговорПослеВыбораИзСписка", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, СписокВыбора, НСтр("ru = 'Выберите договор'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДоговорПослеВыбораИзСписка(Элемент, ДополнительныеПараметры) Экспорт

	Если Элемент <> Неопределено Тогда
		ПодставитьДоговор(Элемент.Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументы(Команда)

	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала найдите договор.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Проект) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Укажите проект: без проекта отбор по договору не выполняется.'"));
		Возврат;
	КонецЕсли;

	ПрогрессВыгрузки = 0;
	ХодВыгрузки = "";
	Итог = "";
	ЗаполнитьТаблицуДокументовНаСервере();

	Если Документы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'По договору и проекту документы не найдены.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	Если ИдетВыгрузка Тогда
		Возврат;
	КонецЕсли;

	ОтмеченныеДокументы = Документы.НайтиСтроки(Новый Структура("Сохранять", Истина));
	Если ОтмеченныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Отметьте документы для сохранения: сначала найдите их кнопкой «Найти документы».'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Каталог) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите каталог для сохранения файлов.'"));
		Возврат;
	КонецЕсли;

	// Запись по полным путям требует установленного расширения работы с файлами (веб-клиент).
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиРасширенияРаботыСФайлами", ЭтотОбъект);
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(Оповещение,
		НСтр("ru = 'Для сохранения файлов на диск установите расширение для работы с файлами.'"), Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиРасширенияРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт

	Если РасширениеПодключено Тогда
		НачатьВыгрузку();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Установите расширение для работы с файлами и повторите сохранение.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыгрузку(Команда)

	Если НЕ ИдетВыгрузка Тогда
		Возврат;
	КонецЕсли;

	ПрерваноПользователем = Истина;
	ОтменитьЗаданиеНаСервере(ИдентификаторЗадания);
	ХодВыгрузки = НСтр("ru = 'Выгрузка отменяется...'");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодставитьДоговор(ВыбранныйДоговор)

	Если ИдетВыгрузка = Истина Тогда
		Возврат; // Договор выгрузки не меняется до ее окончания.
	КонецЕсли;
	Если Договор <> ВыбранныйДоговор Тогда
		ОчиститьРезультатыПоиска();
	КонецЕсли;
	Договор = ВыбранныйДоговор; // ПриИзменении поля проверит, что вид документа - договор.
	РеквизитыДоговора = РеквизитыДоговораНаСервере(Договор);
	НомерДоговора = РеквизитыДоговора.РегистрационныйНомер;
	Проект = РеквизитыДоговора.Проект;

КонецПроцедуры

// Очищает найденные документы и итог прошлой выгрузки при смене договора: иначе «Сохранить» записал бы
// документы прежнего договора в каталог и список выгрузки нового.
//
&НаКлиенте
Процедура ОчиститьРезультатыПоиска()

	Если ИдетВыгрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	Документы.Очистить();
	Пропущенные.Очистить();
	ПрогрессВыгрузки = 0;
	ХодВыгрузки = "";
	Итог = "";

КонецПроцедуры

&НаКлиенте
Функция ПредставлениеДоговораВыбора(СтрокаДоговора)

	НомерБезЗначения = ?(ПустаяСтрока(СтрокаДоговора.РегистрационныйНомер),
		НСтр("ru = 'б-н'"), СтрокаДоговора.РегистрационныйНомер);

	Части = Новый Массив;
	Части.Добавить(НомерБезЗначения);
	Если ЗначениеЗаполнено(СтрокаДоговора.ДатаРегистрации) Тогда
		Части.Добавить(Формат(СтрокаДоговора.ДатаРегистрации, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Если НЕ ПустаяСтрока(СтрокаДоговора.Заголовок) Тогда
		Части.Добавить(СтрокаДоговора.Заголовок);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаДоговора.Корреспондент) Тогда
		Части.Добавить(Строка(СтрокаДоговора.Корреспондент));
	КонецЕсли;

	Возврат СтрСоединить(Части, " - ");

КонецФункции

&НаСервере
Функция НайтиДоговорыНаСервере(Знач ИскомыйНомер)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ДоговорыДляКлиента(ОбработкаОбъект.НайтиДоговорыПоНомеру(ИскомыйНомер));

КонецФункции

// Строки найденных договоров для клиента: таблица значений на тонкий клиент не передается.
//
// Параметры:
//   ТаблицаДоговоров - ТаблицаЗначений - колонки Договор, РегистрационныйНомер, ДатаРегистрации, Заголовок,
//                      Корреспондент.
//
// Возвращаемое значение:
//   Массив из Структура - те же поля; Корреспондент - представление (строка).
//
&НаСервереБезКонтекста
Функция ДоговорыДляКлиента(ТаблицаДоговоров)

	Договоры = Новый Массив;
	Для Каждого СтрокаДоговора Из ТаблицаДоговоров Цикл
		ОписаниеДоговора = Новый Структура("Договор, РегистрационныйНомер, ДатаРегистрации, Заголовок, Корреспондент");
		ЗаполнитьЗначенияСвойств(ОписаниеДоговора, СтрокаДоговора);
		ОписаниеДоговора.Корреспондент = ?(ЗначениеЗаполнено(СтрокаДоговора.Корреспондент),
			Строка(СтрокаДоговора.Корреспондент), "");
		Договоры.Добавить(ОписаниеДоговора);
	КонецЦикла;
	Возврат Договоры;

КонецФункции

// Подставляет договор из «Задание разбора ДО.json» сбора документов расторжения (пакет агента БИТ
// ar_ПакетРасторжениеДоговора, agentrunner-498). Задание лежит в папке договора сбора, выгрузка идет в ее
// подпапку «ДО»: выбрана папка «ДО» - задание ищется уровнем выше; выбрана сама папка договора - каталог
// выгрузки меняется на ее папку «ДО». Договор ищется по коду ДО (ключ обмена с БИТ), затем по номеру.
// Задания нет или файл недоступен - форма работает как раньше: договор ищут по номеру вручную.
//
&НаКлиенте
Асинх Процедура ПодставитьДоговорИзЗаданияРазбора()

	Если ИдетВыгрузка = Истина Или ПустаяСтрока(Каталог) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Пути = Ждать ПутиЗаданияРазбора(СокрЛП(Каталог));
		Если ПустаяСтрока(Пути.ПутьЗадания) Тогда
			Возврат;
		КонецЕсли;
		ДанныеЗадания = Ждать СоздатьДвоичныеДанныеИзФайлаАсинх(Пути.ПутьЗадания);
	Исключение
		// Каталог недоступен или нет расширения работы с файлами (веб-клиент): договор найдут по номеру.
		Возврат;
	КонецПопытки;
	ПутьЗадания = Пути.ПутьЗадания;
	КаталогВыгрузкиДО = Пути.КаталогВыгрузкиДО;

	Если НЕ ПустаяСтрока(КаталогВыгрузкиДО) Тогда
		Каталог = КаталогВыгрузкиДО;
		СохранитьКаталогНаСервере();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Выбрана папка договора сбора документов: файлы будут сохранены в ее папку «ДО» - %1'"),
			КаталогВыгрузкиДО));
	КонецЕсли;

	Найденное = ДоговорыИзЗаданияРазбораНаСервере(ДанныеЗадания);
	Если НЕ ПустаяСтрока(Найденное.Ошибка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Не удалось прочитать %1 (%2): найдите договор по номеру.'"), ПутьЗадания, Найденное.Ошибка));
		Возврат;
	КонецЕсли;

	Если Найденное.Договоры.Количество() = 1 Тогда
		ПодставитьДоговор(Найденное.Договоры[0].Договор);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Договор № %1 подставлен из задания разбора ДО (%2).
			|Проверьте его и нажмите «Найти документы».'"),
			НомерДоговора, Найденное.СпособПоиска));
	ИначеЕсли Найденное.Договоры.Количество() > 1 Тогда
		НомерДоговора = Найденное.НомерБИТ;
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаДоговора Из Найденное.Договоры Цикл
			СписокВыбора.Добавить(СтрокаДоговора.Договор, ПредставлениеДоговораВыбора(СтрокаДоговора));
		КонецЦикла;
		Оповещение = Новый ОписаниеОповещения("ДоговорПослеВыбораИзСписка", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, СписокВыбора,
			СтрШаблон(НСтр("ru = 'Выберите договор № %1 из задания разбора ДО'"), Найденное.НомерБИТ));
	Иначе
		Если ПустаяСтрока(НомерДоговора) Тогда
			НомерДоговора = Найденное.НомерБИТ;
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'В задании разбора ДО договор № %1 от %2 (код ДО «%3»), в ДО он не найден:
			|найдите договор по номеру.'"),
			Найденное.НомерБИТ, Найденное.ДатаБИТ, Найденное.КодДО));
	КонецЕсли;

КонецПроцедуры

// Где лежит задание разбора для выбранного каталога: в нем самом (выбрана папка договора сбора - тогда выгрузка
// идет в ее папку «ДО», если она есть) или уровнем выше (выбрана папка «ДО»). Ошибки доступа к файлам не
// перехватываются - их перехватывает вызывающий.
//
// Параметры:
//   ВыбранныйКаталог - Строка - каталог выгрузки.
//
// Возвращаемое значение:
//   Обещание - Структура - ПутьЗадания (пусто - задания нет), КаталогВыгрузкиДО (пусто - каталог не меняется).
//
&НаКлиенте
Асинх Функция ПутиЗаданияРазбора(Знач ВыбранныйКаталог)

	Пути = Новый Структура("ПутьЗадания, КаталогВыгрузкиДО", "", "");
	Пока СтрЗаканчиваетсяНа(ВыбранныйКаталог, "\") Или СтрЗаканчиваетсяНа(ВыбранныйКаталог, "/") Цикл
		ВыбранныйКаталог = Лев(ВыбранныйКаталог, СтрДлина(ВыбранныйКаталог) - 1);
	КонецЦикла;

	ФайлЗадания = Новый Файл(ВыбранныйКаталог + "\" + ИмяФайлаЗаданияРазбора());
	Если Ждать ФайлЗадания.СуществуетАсинх() Тогда
		Пути.ПутьЗадания = ФайлЗадания.ПолноеИмя;
		ПапкаДО = Новый Файл(ВыбранныйКаталог + "\" + ИмяПапкиВыгрузкиДО());
		Если Ждать ПапкаДО.СуществуетАсинх() Тогда
			Пути.КаталогВыгрузкиДО = ПапкаДО.ПолноеИмя;
		КонецЕсли;
		Возврат Пути;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(ВыбранныйКаталог, "\", НаправлениеПоиска.СКонца);
	Если ПозицияРазделителя > 1 Тогда
		ФайлЗадания = Новый Файл(Лев(ВыбранныйКаталог, ПозицияРазделителя) + ИмяФайлаЗаданияРазбора());
		Если Ждать ФайлЗадания.СуществуетАсинх() Тогда
			Пути.ПутьЗадания = ФайлЗадания.ПолноеИмя;
		КонецЕсли;
	КонецЕсли;
	Возврат Пути;

КонецФункции

// Читает «Задание разбора ДО.json» и ищет договор ДО: по коду ДО (do_contract_code, ключ обмена с БИТ), не
// нашелся - по номеру договора БИТ (contract_number) как регистрационному номеру ДО.
//
// Параметры:
//   ДанныеЗадания - ДвоичныеДанные - содержимое файла задания (UTF-8, возможно с BOM).
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка       - Строка - текст ошибки чтения; пусто - файл прочитан.
//     * Договоры     - Массив из Структура - найденные договоры (см. ДоговорыДляКлиента).
//     * СпособПоиска - Строка - «по коду ДО» или «по номеру».
//     * НомерБИТ, ДатаБИТ, КодДО - Строка - данные договора из задания для сообщений.
//
&НаСервере
Функция ДоговорыИзЗаданияРазбораНаСервере(Знач ДанныеЗадания)

	Найденное = Новый Структура("Ошибка, Договоры, СпособПоиска, НомерБИТ, ДатаБИТ, КодДО",
		"", Новый Массив, "", "", "", "");

	Попытка
		ТекстЗадания = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЗадания, КодировкаТекста.UTF8);
		Если СтрНачинаетсяС(ТекстЗадания, Символ(65279)) Тогда
			ТекстЗадания = Сред(ТекстЗадания, 2);
		КонецЕсли;
		ЧтениеЗадания = Новый ЧтениеJSON;
		ЧтениеЗадания.УстановитьСтроку(ТекстЗадания);
		Задание = ПрочитатьJSON(ЧтениеЗадания, Истина);
		ЧтениеЗадания.Закрыть();
	Исключение
		Найденное.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Найденное;
	КонецПопытки;

	Если ТипЗнч(Задание) <> Тип("Соответствие") Тогда
		Найденное.Ошибка = НСтр("ru = 'в файле нет объекта задания'");
		Возврат Найденное;
	КонецЕсли;

	Найденное.НомерБИТ = СокрЛП(СтрокаПоляЗадания(Задание, "contract_number"));
	Найденное.ДатаБИТ = Лев(СтрокаПоляЗадания(Задание, "contract_date"), 10);
	Найденное.КодДО = СокрЛП(СтрокаПоляЗадания(Задание, "do_contract_code"));

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если НЕ ПустаяСтрока(Найденное.КодДО) Тогда
		Найденное.Договоры = ДоговорыДляКлиента(ОбработкаОбъект.НайтиДоговорыПоКоду(Найденное.КодДО));
		Найденное.СпособПоиска = НСтр("ru = 'по коду ДО'");
	КонецЕсли;
	Если Найденное.Договоры.Количество() = 0 И НЕ ПустаяСтрока(Найденное.НомерБИТ) Тогда
		Найденное.Договоры = ДоговорыДляКлиента(ОбработкаОбъект.НайтиДоговорыПоНомеру(Найденное.НомерБИТ));
		Найденное.СпособПоиска = НСтр("ru = 'по номеру'");
	КонецЕсли;

	Возврат Найденное;

КонецФункции

// Значение поля задания строкой; нет поля или не строка - пустая строка.
//
// Параметры:
//   Задание - Соответствие - прочитанный JSON задания.
//   Ключ    - Строка - ключ поля.
//
// Возвращаемое значение:
//   Строка - значение.
//
&НаСервереБезКонтекста
Функция СтрокаПоляЗадания(Задание, Ключ)

	Значение = Задание.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Функция ЭтоДоговорНаСервере(Знач ПроверяемыйДокумент)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроверяемыйДокумент, "ВидДокумента.ЯвляетсяДоговором");

КонецФункции

&НаСервере
Функция РеквизитыДоговораНаСервере(Знач ДоговорСсылка)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорСсылка, "Проект, РегистрационныйНомер");

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуДокументовНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатОтбора = ОбработкаОбъект.ДокументыПоДоговору(Договор, Проект);

	ФайлыПоВладельцу = Новый Соответствие;
	Для Каждого СтрокаФайлов Из РезультатОтбора.Файлы Цикл
		ФайлыПоВладельцу.Вставить(СтрокаФайлов.ВладелецФайла, СтрокаФайлов);
	КонецЦикла;

	ЗанятыеПути = Новый Соответствие; // Путь папки в нижнем регистре -> истина.
	// Папка договора - по регистрационному номеру договора (поле номера могло не обновиться при выборе договора).
	НомерДляПапки = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "РегистрационныйНомер"));
	ПапкаДоговора = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(
		?(ПустаяСтрока(НомерДляПапки), НСтр("ru = 'б-н'"), НомерДляПапки), " ");
	Документы.Очистить();
	Пропущенные.Очистить();

	Для Каждого СтрокаОтбора Из РезультатОтбора.Документы Цикл

		НоваяСтрока = Документы.Добавить();
		НоваяСтрока.Сохранять = Истина;
		НоваяСтрока.Вид = СтрокаОтбора.ВидДокумента;
		НоваяСтрока.Документ = СтрокаОтбора.Документ;
		НоваяСтрока.Номер = ?(ПустаяСтрока(СтрокаОтбора.Номер), НСтр("ru = 'б-н'"), СтрокаОтбора.Номер);
		НоваяСтрока.Дата = СтрокаОтбора.ДатаДокумента;
		НоваяСтрока.Заголовок = СтрокаОтбора.Заголовок;

		ДанныеФайлов = ФайлыПоВладельцу.Получить(СтрокаОтбора.Документ);
		Если ДанныеФайлов <> Неопределено Тогда
			НоваяСтрока.ЧислоФайлов = ДанныеФайлов.ЧислоФайлов;
			НоваяСтрока.РазмерФайлов = ДанныеФайлов.РазмерФайлов;
		КонецЕсли;

		НоваяСтрока.ПутьПапки = СокрЛП(ПапкаДоговора) + "\" + ПутьПапкиДокумента(НоваяСтрока, ЗанятыеПути);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПапкаВидаДокумента(ВидДокумента)

	Если ВидДокумента = "Исходящий" Тогда
		Возврат НСтр("ru = 'Исходящие'");
	ИначеЕсли ВидДокумента = "Входящий" Тогда
		Возврат НСтр("ru = 'Входящие'");
	ИначеЕсли ВидДокумента = "Письмо" Тогда
		Возврат НСтр("ru = 'Письма'");
	КонецЕсли;

	Возврат НСтр("ru = 'Внутренние'");

КонецФункции

&НаСервере
Функция ПутьПапкиДокумента(СтрокаДокументы, ЗанятыеПути)

	ИмяПапки = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СтрокаДокументы.Номер, " ");
	Если ЗначениеЗаполнено(СтрокаДокументы.Дата) Тогда
		ИмяПапки = ИмяПапки + " от " + Формат(СтрокаДокументы.Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	ИмяПапки = СокрЛП(ИмяПапки);

	ПутьПапки = ПапкаВидаДокумента(СтрокаДокументы.Вид) + "\" + ИмяПапки;
	БазовыйПуть = ПутьПапки;

	НомерДубля = 1;
	Пока ЗанятыеПути.Получить(НРег(ПутьПапки)) <> Неопределено Цикл
		НомерДубля = НомерДубля + 1;
		ПутьПапки = БазовыйПуть + " (" + НомерДубля + ")";
	КонецЦикла;
	ЗанятыеПути.Вставить(НРег(ПутьПапки), Истина);

	Возврат ПутьПапки;

КонецФункции

&НаКлиенте
Асинх Процедура НачатьВыгрузку()

	Если ИдетВыгрузка Тогда
		Возврат;
	КонецЕсли;

	ПорцииВыгрузки = ПорцииОтмеченныхДокументов();
	Если ПорцииВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдетВыгрузка = Истина;

	// Прежний список выгрузки удаляется до первой порции (agentrunner-480): пока идет повторная выгрузка,
	// списка нет - разбор агентом не начнется по недописанным файлам.
	ИмяСписка = ПолноеИмяСпискаВыгрузки(ПорцииВыгрузки[0][0].ПутьПапки);
	ОшибкаУдаления = Ждать ОшибкаУдаленияСпискаВыгрузки(ИмяСписка);
	Если Не ПустаяСтрока(ОшибкаУдаления) Тогда
		ИдетВыгрузка = Ложь;
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось удалить прежний список «%1»: закройте файл и повторите сохранение. %2'"),
			ИмяФайлаСпискаВыгрузки(), ОшибкаУдаления);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ПрерваноПользователем = Ложь;
	НомерТекущейПорции = 0;
	СохраненоФайлов = 0;
	СохраненоПодписей = 0;
	ЗаписанныеФайлы = Новый Массив;
	Пропущенные.Очистить();
	Итог = "";
	СохранитьКаталогНаСервере();

	Элементы.КнопкаСохранить.Доступность = Ложь;
	Элементы.КнопкаНайтиДокументы.Доступность = Ложь;
	Элементы.КнопкаОтменитьВыгрузку.Доступность = Истина;

	ЗапуститьПорцию(1);

КонецПроцедуры

&НаКлиенте
Функция ПорцииОтмеченныхДокументов()

	РазмерМегабайта = 1024 * 1024;
	ПределПорцииМегабайт = 100; // Спека: порция не больше 100 МБ.
	ПределПорции = ПределПорцииМегабайт * РазмерМегабайта;

	Порции = Новый Массив;
	ТекущаяПорция = Новый Массив;
	РазмерПорции = 0;

	Для Каждого СтрокаДокументы Из Документы Цикл

		Если НЕ СтрокаДокументы.Сохранять Тогда
			Продолжить;
		КонецЕсли;

		Если ТекущаяПорция.Количество() > 0
			И РазмерПорции + СтрокаДокументы.РазмерФайлов > ПределПорции Тогда
			Порции.Добавить(ТекущаяПорция);
			ТекущаяПорция = Новый Массив;
			РазмерПорции = 0;
		КонецЕсли;

		ТекущаяПорция.Добавить(СтрокаДокументы);
		РазмерПорции = РазмерПорции + СтрокаДокументы.РазмерФайлов;

	КонецЦикла;

	Если ТекущаяПорция.Количество() > 0 Тогда
		Порции.Добавить(ТекущаяПорция);
	КонецЕсли;

	Возврат Порции;

КонецФункции

&НаКлиенте
Процедура ЗапуститьПорцию(НомерПорции)

	НомерТекущейПорции = НомерПорции;
	ПрогрессВыгрузки = 0;
	ХодВыгрузки = СтрШаблон(НСтр("ru = 'Порция %1 из %2'"),
		НомерПорции, ПорцииВыгрузки.Количество());

	ДокументыПорции = Новый Массив;
	Для Каждого СтрокаДокументы Из ПорцииВыгрузки[НомерПорции - 1] Цикл
		ДокументПорции = Новый Структура("Документ, ПутьПапки",
			СтрокаДокументы.Документ, СтрокаДокументы.ПутьПапки);
		ДокументыПорции.Добавить(ДокументПорции);
	КонецЦикла;

	ДлительнаяОперация = ЗапуститьПолучениеФайловНаСервере(ДокументыПорции);
	Если ДлительнаяОперация = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Добавьте обработку в дополнительные обработки: без регистрации выгрузка невозможна.'"));
		ЗавершитьВыгрузку(Истина);
		Возврат;
	КонецЕсли;

	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения =
		Новый ОписаниеОповещения("ОбработатьПрогрессПорции", ЭтотОбъект);

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПорцияЗавершена", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьПолучениеФайловНаСервере(ДокументыПорции)

	СсылкаОбработки = СсылкаЗарегистрированнойОбработки();
	Если НЕ ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Возврат Неопределено; // Обработка не зарегистрирована в дополнительных обработках.
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = СтрШаблон(
		НСтр("ru = 'Выгрузка документов по договору %1'"), СокрЛП(НомерДоговора));

	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("ДополнительнаяОбработкаСсылка", СсылкаОбработки);
	ПараметрыКоманды.Вставить("ИдентификаторКоманды", "ar_ПолучитьФайлыВФоне");
	ПараметрыКоманды.Вставить("ОбъектыНазначения", Неопределено);
	ПараметрыКоманды.Вставить("Документы", ДокументыПорции);

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"ДополнительныеОтчетыИОбработки.ВыполнитьКоманду", ПараметрыКоманды);

КонецФункции

// Элемент справочника «Дополнительные отчеты и обработки» этой обработки. Из команды БСП
// ссылка приходит параметром формы; при открытии через «Файл - Открыть» параметра нет -
// поиск зарегистрированной обработки по имени объекта. Отключенная копия не подходит: БСП ее
// не подключит, фоновое задание упадет. Из нескольких копий - сначала опубликованная
// («Используется»), затем в режиме отладки; среди равных - по строке версии убыванию (порядок предсказуем; «1.1.10» строкой меньше «1.1.9»).
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки, Неопределено - не зарегистрирована.
//
&НаСервере
Функция СсылкаЗарегистрированнойОбработки()

	СсылкаОбработки = Неопределено;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки)
		И ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Возврат СсылкаОбработки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", "ar_ВыгрузкаДокументовПоДоговору");
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
		|	И ДополнительныеОтчетыИОбработки.Публикация <> ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	ДополнительныеОтчетыИОбработки.Версия УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ОтменитьЗаданиеНаСервере(ОтменяемоеЗадание)

	ДлительныеОперации.ОтменитьВыполнениеЗадания(ОтменяемоеЗадание);

КонецПроцедуры

&НаСервере
Процедура СохранитьКаталогНаСервере()

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		"ar_ВыгрузкаДокументовПоДоговору", "Каталог", Каталог);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПрогрессПорции(Прогресс, ДополнительныеПараметры) Экспорт

	Если Прогресс = Неопределено Или Прогресс.Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураПрогресса = Прогресс.Прогресс;
	Если СтруктураПрогресса.Свойство("Процент") Тогда
		ПрогрессВыгрузки = СтруктураПрогресса.Процент;
	КонецЕсли;

	Если СтруктураПрогресса.Свойство("Текст") Тогда
		ХодВыгрузки = СтрШаблон(НСтр("ru = 'Порция %1 из %2, %3'"),
			НомерТекущейПорции, ПорцииВыгрузки.Количество(), СтруктураПрогресса.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПорцияЗавершена(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Ошибка выгрузки: %1'"), Результат.КраткоеПредставлениеОшибки));
		ЗавершитьВыгрузку(Ложь);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Отменено" Или ПрерваноПользователем Тогда
		ЗавершитьВыгрузку(Истина);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Выполнено" Тогда

		РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);

		РезультатЗаписи = Ждать ЗаписатьФайлыПорции(РезультатВыполнения.ФайлыПорции);
		Если РезультатЗаписи.Свойство("Ошибка") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Ошибка записи на диск: %1'"), РезультатЗаписи.Ошибка));
			ЗавершитьВыгрузку(Ложь);
			Возврат;
		КонецЕсли;

		СохраненоФайлов = СохраненоФайлов + РезультатЗаписи.ЗаписаноФайлов;
		СохраненоПодписей = СохраненоПодписей + РезультатЗаписи.ЗаписаноПодписей;

		Для Каждого СтрокаПропуска Из РезультатВыполнения.ПропущенныеФайлы Цикл
			НоваяСтрока = Пропущенные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПропуска);
		КонецЦикла;

		Если НомерТекущейПорции < ПорцииВыгрузки.Количество() Тогда
			ЗапуститьПорцию(НомерТекущейПорции + 1);
		Иначе
			// Список выгруженных файлов - только после успешной последней порции (agentrunner-480):
			// при ошибке и отмене его нет, и агент не разбирает неполную выгрузку.
			ЗавершитьУспешнуюВыгрузку();
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Завершает выгрузку после успешной последней порции: пишет список «Выгрузка ДО.json» для разбора агентом
// (agentrunner-480) и выводит итог; список не записан - сообщение и пометка в итоге.
//
&НаКлиенте
Асинх Процедура ЗавершитьУспешнуюВыгрузку()

	ОшибкаСписка = Ждать ОшибкаЗаписиСпискаВыгрузки();
	ЗавершитьВыгрузку(Ложь);
	Если ПустаяСтрока(ОшибкаСписка) Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = СтрШаблон(НСтр("ru = 'Не записан список файлов «%1»: %2'"), ИмяФайлаСпискаВыгрузки(),
		ОшибкаСписка);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Итог = Итог + НСтр("ru = '. Список файлов для разбора не записан'");

КонецПроцедуры

// Записывает файлы порции на диск асинхронными методами платформы: каталоги документа создаются
// по мере необходимости, файлы от прошлых выгрузок перезаписываются.
//
// Параметры:
//   ФайлыПорции - Массив - структуры ОтносительныйПуть, ДвоичныеДанные, ЭтоПодпись, ОсновнойФайл.
//
// Возвращаемое значение:
//   Структура - ЗаписаноФайлов, ЗаписаноПодписей; при ошибке - ключ Ошибка с текстом. Записанные файлы
//   добавляются в ЗаписанныеФайлы (список выгрузки для разбора, agentrunner-480).
//
&НаКлиенте
Асинх Функция ЗаписатьФайлыПорции(ФайлыПорции)

	ЗаписаноФайлов = 0;
	ЗаписаноПодписей = 0;

	Для Каждого ФайлПорции Из ФайлыПорции Цикл

		ПолныйПуть = Каталог + "\" + ФайлПорции.ОтносительныйПуть;
		ПозицияРазделителя = СтрНайти(ПолныйПуть, "\", НаправлениеПоиска.СКонца);
		ПапкаФайла = Лев(ПолныйПуть, ПозицияРазделителя - 1);

		ПапкаФайлаИнфо = Новый Файл(ПапкаФайла);
		Если НЕ Ждать ПапкаФайлаИнфо.СуществуетАсинх() Тогда
			Ждать СоздатьКаталогАсинх(ПапкаФайла);
		КонецЕсли;

		Попытка
			Ждать ФайлПорции.ДвоичныеДанные.ЗаписатьАсинх(ПолныйПуть);
		Исключение
			ТекстОшибкиЗаписи = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Новый Структура("Ошибка", ТекстОшибкиЗаписи + ": " + ПолныйПуть);
		КонецПопытки;

		Если ФайлПорции.ЭтоПодпись Тогда
			ЗаписаноПодписей = ЗаписаноПодписей + 1;
		Иначе
			ЗаписаноФайлов = ЗаписаноФайлов + 1;
		КонецЕсли;
		// Записанный файл - в список выгрузки для разбора агентом (agentrunner-480).
		ЗаписанныйФайл = Новый Структура("ОтносительныйПуть, ЭтоПодпись, ОсновнойФайл",
			ФайлПорции.ОтносительныйПуть, ФайлПорции.ЭтоПодпись, ФайлПорции.ОсновнойФайл);
		ЗаписанныеФайлы.Добавить(ЗаписанныйФайл);

	КонецЦикла;

	Возврат Новый Структура("ЗаписаноФайлов, ЗаписаноПодписей", ЗаписаноФайлов, ЗаписаноПодписей);

КонецФункции

&НаКлиенте
Процедура ЗавершитьВыгрузку(Прервано)

	ИдетВыгрузка = Ложь;

	Элементы.КнопкаСохранить.Доступность = Истина;
	Элементы.КнопкаНайтиДокументы.Доступность = Истина;
	Элементы.КнопкаОтменитьВыгрузку.Доступность = Ложь;
	ПрогрессВыгрузки = 0;
	ХодВыгрузки = "";

	ВывестиИтог(Прервано);

КонецПроцедуры

&НаКлиенте
Процедура ВывестиИтог(Прервано)

	Итог = СтрШаблон(НСтр("ru = 'Сохранено файлов: %1, подписей: %2, пропущено: %3'"),
		СохраненоФайлов, СохраненоПодписей, Пропущенные.Количество());

	Если Прервано Тогда
		Итог = Итог + НСтр("ru = '. Выгрузка прервана'");
	КонецЕсли;

КонецПроцедуры

#Область СписокВыгрузкиДляРазбора

// Имя файла списка выгруженных файлов в папке договора - контракт с пакетом агента
// ar_ПакетРасторжениеДоговора (agentrunner-480).
//
// Возвращаемое значение:
//   Строка - имя файла.
//
&НаКлиенте
Функция ИмяФайлаСпискаВыгрузки()

	Возврат "Выгрузка ДО.json";

КонецФункции

// Имя файла задания разбора в папке договора сбора документов расторжения - контракт с пакетом агента
// ar_ПакетРасторжениеДоговора (agentrunner-498).
//
// Возвращаемое значение:
//   Строка - имя файла.
//
&НаКлиенте
Функция ИмяФайлаЗаданияРазбора()

	Возврат "Задание разбора ДО.json";

КонецФункции

// Имя папки выгрузки ДО в папке договора сбора документов расторжения (контракт с пакетом агента).
//
// Возвращаемое значение:
//   Строка - имя папки.
//
&НаКлиенте
Функция ИмяПапкиВыгрузкиДО()

	Возврат "ДО";

КонецФункции

// Полное имя списка выгрузки: «<Каталог>\<папка договора>\Выгрузка ДО.json»; папка договора - первый
// сегмент пути относительно каталога.
//
// Параметры:
//   ОтносительныйПуть - Строка - путь папки документа или файла относительно каталога.
//
// Возвращаемое значение:
//   Строка - полное имя файла.
//
&НаКлиенте
Функция ПолноеИмяСпискаВыгрузки(ОтносительныйПуть)

	Возврат Каталог + "\" + ПапкаДоговораВыгрузки(ОтносительныйПуть) + "\" + ИмяФайлаСпискаВыгрузки();

КонецФункции

// Папка договора - первый сегмент относительного пути.
//
// Параметры:
//   ОтносительныйПуть - Строка - путь относительно каталога выгрузки.
//
// Возвращаемое значение:
//   Строка - имя папки договора.
//
&НаКлиенте
Функция ПапкаДоговораВыгрузки(ОтносительныйПуть)

	ПозицияРазделителя = СтрНайти(ОтносительныйПуть, "\");
	Если ПозицияРазделителя = 0 Тогда
		Возврат ОтносительныйПуть;
	КонецЕсли;
	Возврат Лев(ОтносительныйПуть, ПозицияРазделителя - 1);

КонецФункции

// Путь относительно папки договора: относительный путь без первого сегмента.
//
// Параметры:
//   ОтносительныйПуть - Строка - путь относительно каталога выгрузки.
//
// Возвращаемое значение:
//   Строка - путь внутри папки договора.
//
&НаКлиенте
Функция ПутьВнутриПапкиДоговора(ОтносительныйПуть)

	ПозицияРазделителя = СтрНайти(ОтносительныйПуть, "\");
	Если ПозицияРазделителя = 0 Тогда
		Возврат ОтносительныйПуть;
	КонецЕсли;
	Возврат Сред(ОтносительныйПуть, ПозицияРазделителя + 1);

КонецФункции

// Удаляет прежний список выгрузки перед началом выгрузки; файла нет - не ошибка.
//
// Параметры:
//   ПолноеИмя - Строка - полное имя списка выгрузки.
//
// Возвращаемое значение:
//   Строка - текст ошибки удаления; пустая строка - файла нет или он удален.
//
&НаКлиенте
Асинх Функция ОшибкаУдаленияСпискаВыгрузки(ПолноеИмя)

	Попытка
		ФайлСписка = Новый Файл(ПолноеИмя);
		Если Ждать ФайлСписка.СуществуетАсинх() Тогда
			Ждать УдалитьФайлыАсинх(ПолноеИмя);
		КонецЕсли;
	Исключение
		Возврат ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

// Записывает список «Выгрузка ДО.json» в папку договора: временный файл с уникальным именем, затем
// переименование на место списка - агент не прочитает недописанный файл. У файла один писатель - форма,
// поэтому замена без повторов (спека agentrunner-480, Е.2).
//
// Возвращаемое значение:
//   Строка - текст ошибки; пустая строка - список записан.
//
&НаКлиенте
Асинх Функция ОшибкаЗаписиСпискаВыгрузки()

	// Список пишется и без записанных файлов (все пропущены): иначе задание разбора ждало бы его до конца
	// срока, а так разбор завершится сразу и инициатор получит письмо с итогом.
	ПутьПервойПапки = ПорцииВыгрузки[0][0].ПутьПапки;
	ПапкаДоговора = Каталог + "\" + ПапкаДоговораВыгрузки(ПутьПервойПапки);
	ПолноеИмя = ПолноеИмяСпискаВыгрузки(ПутьПервойПапки);
	ВременноеИмя = ПолноеИмя + "." + Строка(Новый УникальныйИдентификатор) + ".tmp";
	Попытка
		Ждать СоздатьКаталогАсинх(ПапкаДоговора);
		ТекстСписка = ТекстСпискаВыгрузки(ДанныеСпискаВыгрузкиНаСервере(Договор));
		ДанныеСписка = ПолучитьДвоичныеДанныеИзСтроки(ТекстСписка, КодировкаТекста.UTF8);
		Ждать ДанныеСписка.ЗаписатьАсинх(ВременноеИмя);
		Ждать ПереместитьФайлАсинх(ВременноеИмя, ПолноеИмя);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			Ждать УдалитьФайлыАсинх(ВременноеИмя);
		Исключение
			// Временный файл мог не создаться; остаток удалит регламент разбора (файлы *.tmp старше суток).
			ТекстОшибки = ТекстОшибки + " (" + НСтр("ru = 'временный файл не удален'") + ")";
		КонецПопытки;
		Возврат ТекстОшибки;
	КонецПопытки;

	Возврат "";

КонецФункции

// Текст списка выгрузки (JSON, ключи - контракт с пакетом агента): version, do_contract {code, number, date,
// project}, finished, files [{ref, path, kind, number, date, title, signature_of}], skipped [{file, document,
// reason}]. Пути - относительно папки договора; даты - ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//
// Параметры:
//   ДанныеСервера - Структура - do_contract, finished (см. ДанныеСпискаВыгрузкиНаСервере).
//
// Возвращаемое значение:
//   Строка - JSON.
//
&НаКлиенте
Функция ТекстСпискаВыгрузки(ДанныеСервера)

	ДокументыПоПапкам = Новый Соответствие;
	Для Каждого СтрокаДокументы Из Документы Цикл
		ДокументыПоПапкам.Вставить(НРег(СтрокаДокументы.ПутьПапки), СтрокаДокументы);
	КонецЦикла;

	ФайлыСписка = Новый Массив;
	НомерФайла = 0;
	Для Каждого ЗаписанныйФайл Из ЗаписанныеФайлы Цикл
		НомерФайла = НомерФайла + 1;
		ЭлементФайла = ЭлементФайлаСписка(ЗаписанныйФайл, НомерФайла, ДокументыПоПапкам);
		ФайлыСписка.Добавить(ЭлементФайла);
	КонецЦикла;

	ПропущенныеСписка = Новый Массив;
	Для Каждого СтрокаПропуска Из Пропущенные Цикл
		ПропущенныеСписка.Добавить(Новый Структура("file, document, reason",
			СтрокаПропуска.Файл, Строка(СтрокаПропуска.Документ), СтрокаПропуска.Причина));
	КонецЦикла;

	Список = Новый Структура;
	Список.Вставить("version", 1);
	Список.Вставить("do_contract", ДанныеСервера.do_contract);
	Список.Вставить("finished", ДанныеСервера.finished);
	Список.Вставить("files", ФайлыСписка);
	Список.Вставить("skipped", ПропущенныеСписка);

	ЗаписьСписка = Новый ЗаписьJSON;
	ЗаписьСписка.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьСписка, Список);
	Возврат ЗаписьСписка.Закрыть();

КонецФункции

// Элемент files списка выгрузки: ref по порядку (f0001...), путь внутри папки договора, вид, номер, дата
// и заголовок документа - по папке файла (строка таблицы Документы), у подписи - путь подписанного файла.
//
// Параметры:
//   ЗаписанныйФайл    - Структура - ОтносительныйПуть, ЭтоПодпись, ОсновнойФайл.
//   НомерФайла        - Число - порядковый номер файла в списке.
//   ДокументыПоПапкам - Соответствие - путь папки в нижнем регистре -> строка таблицы Документы.
//
// Возвращаемое значение:
//   Структура - ref, path, kind, number, date, title, signature_of.
//
&НаКлиенте
Функция ЭлементФайлаСписка(ЗаписанныйФайл, НомерФайла, ДокументыПоПапкам)

	ЭлементФайла = Новый Структура("ref, path, kind, number, date, title, signature_of",
		"f" + Формат(НомерФайла, "ЧЦ=4; ЧВН=; ЧГ=0"),
		ПутьВнутриПапкиДоговора(ЗаписанныйФайл.ОтносительныйПуть), "", "", "", "", "");

	ПозицияРазделителя = СтрНайти(ЗаписанныйФайл.ОтносительныйПуть, "\", НаправлениеПоиска.СКонца);
	ПапкаФайла = НРег(Лев(ЗаписанныйФайл.ОтносительныйПуть, ПозицияРазделителя - 1));
	СтрокаДокументы = ДокументыПоПапкам.Получить(ПапкаФайла);
	Если СтрокаДокументы <> Неопределено Тогда
		ЭлементФайла.kind = СтрокаДокументы.Вид;
		ЭлементФайла.number = СтрокаДокументы.Номер;
		ЭлементФайла.date = ?(ЗначениеЗаполнено(СтрокаДокументы.Дата), XMLСтрока(СтрокаДокументы.Дата), "");
		ЭлементФайла.title = СтрокаДокументы.Заголовок;
	КонецЕсли;

	Если ЗаписанныйФайл.ЭтоПодпись Тогда
		ЭлементФайла.signature_of = ПутьВнутриПапкиДоговора(ЗаписанныйФайл.ОсновнойФайл);
	КонецЕсли;

	Возврат ЭлементФайла;

КонецФункции

// Данные сервера для списка выгрузки: договор ДО - код элемента (ключ обмена с БИТ, его хранит sd_КодДО
// договора БИТ), регистрационный номер, дата регистрации, проект - и время завершения выгрузки (дата сеанса).
// Договор читается по реквизиту формы в момент записи списка: его могли выбрать и без поиска по номеру.
//
// Параметры:
//   ДоговорСсылка - СправочникСсылка.ВнутренниеДокументы - договор.
//
// Возвращаемое значение:
//   Структура:
//     * do_contract - Структура - code, number, date (ГГГГ-ММ-ДДTЧЧ:ММ:СС или пусто), project (представление).
//     * finished    - Строка - время завершения выгрузки, ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//
&НаСервереБезКонтекста
Функция ДанныеСпискаВыгрузкиНаСервере(Знач ДоговорСсылка)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорСсылка,
		"Код, РегистрационныйНомер, ДатаРегистрации, Проект");

	ДанныеДоговора = Новый Структура;
	ДанныеДоговора.Вставить("code", СокрЛП(Реквизиты.Код));
	ДанныеДоговора.Вставить("number", СокрЛП(Реквизиты.РегистрационныйНомер));
	ДанныеДоговора.Вставить("date", ?(ЗначениеЗаполнено(Реквизиты.ДатаРегистрации),
		XMLСтрока(Реквизиты.ДатаРегистрации), ""));
	ПредставлениеПроекта = "";
	Если ЗначениеЗаполнено(Реквизиты.Проект) Тогда
		ПредставлениеПроекта = Строка(Реквизиты.Проект);
	КонецЕсли;
	ДанныеДоговора.Вставить("project", ПредставлениеПроекта);

	Возврат Новый Структура("do_contract, finished", ДанныеДоговора, XMLСтрока(ТекущаяДатаСеанса()));

КонецФункции

#КонецОбласти

#КонецОбласти
