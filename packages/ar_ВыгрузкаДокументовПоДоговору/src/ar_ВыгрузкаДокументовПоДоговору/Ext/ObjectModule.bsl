////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Доп. обработка «Выгрузка документов по договору» для 1С:Документооборота (agentrunner-472).
// Сохраняет на диск пользователя файлы документов по договору и проекту вместе с файлами электронных
// подписей (.sig). Файлы получает фоновое задание БСП (скрытая команда ar_ПолучитьФайлыВФоне),
// обработка данные ДО только читает. ВидДокумента, sdОсновнойДоговор/sdДоговор - см. spec.md задачи.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки.

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//   Структура - см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке().
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.0.2.306");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	// 1.1.0 - список выгруженных файлов «Выгрузка ДО.json» для разбора агентом, поле ОсновнойФайл
	// у подписи в данных порции (agentrunner-480).
	// 1.1.1 - форма: допустимые для платформы свойства групп и полей (Representation, EditMode), обработка
	// собирается (agentrunner-497).
	ПараметрыРегистрации.Версия = "1.1.11";
	// Безопасный режим отключен: чтение файлов из томов на диске сервера и привилегированное чтение
	// версий внутри методов ДО не работают в безопасном режиме (см. spec.md, п. 1).
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Выгрузка документов по договору'");

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Выгрузка документов по договору'");
	Команда.Идентификатор = "ar_ВыгрузкаДокументовПоДоговору";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Фоновое получение файлов (выгрузка документов по договору)'");
	Команда.Идентификатор = "ar_ПолучитьФайлыВФоне";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Ложь;
	Команда.Скрыть = Истина;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик серверных команд. Обработка глобальная (без объектов назначения): БСП вызывает
// ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды) - два параметра. Сигнатура назначаемой
// обработки (с ОбъектыНазначения вторым) получала параметры не туда: команда ничего не делала.
//
// Параметры:
//   ИдентификаторКоманды - Строка - имя команды из СведенияОВнешнейОбработке().
//   ПараметрыВыполнения - Структура - контекст команды, в т.ч. Документы
//       (структуры Документ, ПутьПапки) и РезультатВыполнения (структура БСП),
//       куда кладется результат порции.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения = Неопределено) Экспорт

	Если ИдентификаторКоманды = "ar_ПолучитьФайлыВФоне" И ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
		ПолучитьФайлыПорции(ПараметрыВыполнения);
	КонецЕсли;

КонецПроцедуры

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Находит договоры (внутренние документы вида «договор») по регистрационному номеру.
//
// Параметры:
//   НомерДоговора - Строка - регистрационный номер договора, как его видит пользователь.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Договор, РегистрационныйНомер, ДатаРегистрации, Заголовок, Корреспондент.
//
Функция НайтиДоговорыПоНомеру(Знач НомерДоговора) Экспорт

	Возврат ДоговорыПоОтбору("РегистрационныйНомер", СокрЛП(НомерДоговора));

КонецФункции

// Находит договоры (внутренние документы вида «договор») по коду элемента - ключу обмена с БИТ (его хранит
// sd_КодДО договора БИТ и «Задание разбора ДО.json» сбора документов расторжения, agentrunner-498).
//
// Параметры:
//   КодДоговора - Строка - код договора в ДО.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Договор, РегистрационныйНомер, ДатаРегистрации, Заголовок, Корреспондент.
//
Функция НайтиДоговорыПоКоду(Знач КодДоговора) Экспорт

	Возврат ДоговорыПоОтбору("Код", СокрЛП(КодДоговора));

КонецФункции

// Договоры с отбором по одному полю справочника.
//
// Параметры:
//   ИмяПоля  - Строка - поле отбора: «РегистрационныйНомер» или «Код» (только константы модуля).
//   Значение - Строка - значение отбора.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Договор, РегистрационныйНомер, ДатаРегистрации, Заголовок, Корреспондент.
//
Функция ДоговорыПоОтбору(Знач ИмяПоля, Знач Значение)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.РегистрационныйНомер КАК РегистрационныйНомер,
		|	Договоры.ДатаРегистрации КАК ДатаРегистрации,
		|	Договоры.Заголовок КАК Заголовок,
		|	Договоры.Корреспондент КАК Корреспондент
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Договоры
		|ГДЕ
		|	Договоры.ПолеОтбора = &Значение
		|	И Договоры.ВидДокумента.ЯвляетсяДоговором
		|	И НЕ Договоры.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРегистрации";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Договоры.ПолеОтбора", "Договоры." + ИмяПоля);
	Запрос.УстановитьПараметр("Значение", Значение);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отбирает документы выгрузки по договору и проекту одним пакетным запросом.
//
// Параметры:
//   Договор - СправочникСсылка.ВнутренниеДокументы - договор (вид «договор»).
//   Проект  - СправочникСсылка.Проекты - проект, обязательный фильтр (поля договора не индексированы).
//
// Возвращаемое значение:
//   Структура:
//       * Документы - ТаблицаЗначений - колонки Документ, ВидДокумента, Номер, ДатаДокумента, Заголовок;
//       * Файлы     - ТаблицаЗначений - колонки ВладелецФайла, ЧислоФайлов, РазмерФайлов.
//
Функция ДокументыПоДоговору(Договор, Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящиеДокументы.Ссылка КАК Документ,
		|	""Исходящий"" КАК ВидДокумента,
		|	ИсходящиеДокументы.РегистрационныйНомер КАК Номер,
		|	ИсходящиеДокументы.ДатаРегистрации КАК ДатаДокумента,
		|	ИсходящиеДокументы.Заголовок КАК Заголовок
		|ПОМЕСТИТЬ ВТ_ДокументыБезПисем
		|ИЗ
		|	Справочник.ИсходящиеДокументы КАК ИсходящиеДокументы
		|ГДЕ
		|	ИсходящиеДокументы.Проект = &Проект
		|	И ИсходящиеДокументы.sdОсновнойДоговор = &Договор
		|	И ИсходящиеДокументы.ПодписанЭП
		|	И НЕ ИсходящиеДокументы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВнутренниеДокументы.Ссылка,
		|	""Внутренний"",
		|	ВнутренниеДокументы.РегистрационныйНомер,
		|	ВнутренниеДокументы.ДатаРегистрации,
		|	ВнутренниеДокументы.Заголовок
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
		|ГДЕ
		|	ВнутренниеДокументы.Проект = &Проект
		|	И ВнутренниеДокументы.sdОсновнойДоговор = &Договор
		|	И ВнутренниеДокументы.ПодписанЭП
		|	И НЕ ВнутренниеДокументы.Ссылка = &Договор
		|	И НЕ ВнутренниеДокументы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Договор.Ссылка,
		|	""Внутренний"",
		|	Договор.РегистрационныйНомер,
		|	Договор.ДатаРегистрации,
		|	Договор.Заголовок
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Договор
		|ГДЕ
		|	Договор.Ссылка = &Договор
		|	И Договор.ПодписанЭП
		|	И НЕ Договор.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВходящиеДокументы.Ссылка,
		|	""Входящий"",
		|	ВходящиеДокументы.РегистрационныйНомер,
		|	ВходящиеДокументы.ДатаРегистрации,
		|	ВходящиеДокументы.Заголовок
		|ИЗ
		|	Справочник.ВходящиеДокументы КАК ВходящиеДокументы
		|ГДЕ
		|	ВходящиеДокументы.Проект = &Проект
		|	И ВходящиеДокументы.sdДоговор = &Договор
		|	И НЕ ВходящиеДокументы.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Письма.Ссылка КАК Документ,
		|	""Письмо"" КАК ВидДокумента,
		|	ПОДСТРОКА(Письма.Тема, 1, 50) КАК Номер,
		|	Письма.ДатаПолучения КАК ДатаДокумента,
		|	Письма.Тема КАК Заголовок
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	Документ.ВходящееПисьмо КАК Письма
		|ГДЕ
		|	Письма.Предмет В
		|		(ВЫБРАТЬ
		|			ВТ_ДокументыБезПисем.Документ КАК Документ
		|		ИЗ
		|			ВТ_ДокументыБезПисем КАК ВТ_ДокументыБезПисем)
		|	И НЕ Письма.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДокументыБезПисем.Документ,
		|	ВТ_ДокументыБезПисем.ВидДокумента,
		|	ВТ_ДокументыБезПисем.Номер,
		|	ВТ_ДокументыБезПисем.ДатаДокумента,
		|	ВТ_ДокументыБезПисем.Заголовок
		|ИЗ
		|	ВТ_ДокументыБезПисем КАК ВТ_ДокументыБезПисем
		|;
		|
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документы.Документ КАК Документ,
		|	ВТ_Документы.ВидДокумента КАК ВидДокумента,
		|	ВТ_Документы.Номер КАК Номер,
		|	ВТ_Документы.ДатаДокумента КАК ДатаДокумента,
		|	ВТ_Документы.Заголовок КАК Заголовок
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы
		|УПОРЯДОЧИТЬ ПО
		|	ВидДокумента,
		|	ДатаДокумента,
		|	Номер
		|;
		|
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ВладелецФайла КАК ВладелецФайла,
		|	КОЛИЧЕСТВО(*) КАК ЧислоФайлов,
		|	СУММА(Файлы.ТекущаяВерсияРазмер) КАК РазмерФайлов
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыПочтовыхВложений КАК ИдентификаторыПочтовыхВложений
		|		ПО (ИдентификаторыПочтовыхВложений.Файл = Файлы.Ссылка)
		|ГДЕ
		|	Файлы.ВладелецФайла В
		|		(ВЫБРАТЬ
		|			ВТ_Документы.Документ КАК Документ
		|		ИЗ
		|			ВТ_Документы КАК ВТ_Документы)
		|	И НЕ Файлы.ПометкаУдаления
		|	И (НЕ Файлы.ВладелецФайла ССЫЛКА Документ.ВходящееПисьмо
		|		ИЛИ ЕСТЬNULL(ИдентификаторыПочтовыхВложений.Идентификатор, """") = """")
		|СГРУППИРОВАТЬ ПО
		|	Файлы.ВладелецФайла";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Проект", Проект);

	Результаты = Запрос.ВыполнитьПакет();

	// Части 1-2 пакета создают временные таблицы (их результаты - счетчики записей),
	// данные документов и файлов - в частях 3-4.
	Результат = Новый Структура;
	Результат.Вставить("Документы", Результаты[2].Выгрузить());
	Результат.Вставить("Файлы", Результаты[3].Выгрузить());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает файлы и подписи документов порции и кладет их в РезультатВыполнения параметров команды:
//   ФайлыПорции   - Массив из структур ОтносительныйПуть, ДвоичныеДанные, ЭтоПодпись, ОсновнойФайл;
//   ПропущенныеФайлы - Массив из структур Файл, Документ, Причина.
// Выполняется в фоновом задании от имени пользователя; запросы РАЗРЕШЕННЫЕ, привилегированное чтение
// версии и подписей - только внутри методов ДО (как у команды «Сохранить как»).
//
// Параметры:
//   ПараметрыВыполнения - Структура - контекст команды ar_ПолучитьФайлыВФоне:
//       * Документы - Массив из структур Документ (ссылка), ПутьПапки (относительный путь папки документа).
//
Процедура ПолучитьФайлыПорции(ПараметрыВыполнения)

	ДокументыПорции = ПараметрыВыполнения.Документы;
	ИдентификаторХранилища = Новый УникальныйИдентификатор;

	ФайлыПоДокументам = ФайлыДокументовПорции(ДокументыПорции);
	ЗанятыеИмена = Новый Соответствие; // ПутьПапки -> соответствие занятых имен файлов (в нижнем регистре).

	ФайлыПорции = Новый Массив;
	ПропущенныеФайлы = Новый Массив;

	ВсегоДокументов = ДокументыПорции.Количество();
	ПроцентПолный = 100;
	НомерДокумента = 0;
	Для Каждого ДокументПорции Из ДокументыПорции Цикл

		НомерДокумента = НомерДокумента + 1;
		ФайлыДокумента = ФайлыПоДокументам.Получить(ДокументПорции.Документ);

		Если ФайлыДокумента <> Неопределено Тогда
			ИменаПапки = ЗанятыеИмена[ДокументПорции.ПутьПапки];
			Если ИменаПапки = Неопределено Тогда
				ИменаПапки = Новый Соответствие;
				ЗанятыеИмена.Вставить(ДокументПорции.ПутьПапки, ИменаПапки);
			КонецЕсли;

			Для Каждого ФайлДокумента Из ФайлыДокумента Цикл
				ДобавитьФайлВДанныеПорции(ФайлДокумента, ДокументПорции, ИменаПапки,
					ИдентификаторХранилища, ФайлыПорции, ПропущенныеФайлы);
			КонецЦикла;
		КонецЕсли;

		ПроцентВыполнения = Цел(НомерДокумента / ВсегоДокументов * ПроцентПолный);
		ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения,
			СтрШаблон(НСтр("ru = 'Документ %1 из %2'"), НомерДокумента, ВсегоДокументов));

	КонецЦикла;

	ПараметрыВыполнения.РезультатВыполнения.Вставить("ФайлыПорции", ФайлыПорции);
	ПараметрыВыполнения.РезультатВыполнения.Вставить("ПропущенныеФайлы", ПропущенныеФайлы);

КонецПроцедуры

// Выбирает файлы документов порции одним запросом: без пометки удаления, у писем - только вложения
// (файлы с пустым идентификатором почтового вложения, как у ВстроеннаяПочтаСервер.ПисьмоИмеетВложения).
//
// Параметры:
//   ДокументыПорции - Массив - структуры Документ, ПутьПапки.
//
// Возвращаемое значение:
//   Соответствие - Документ -> ТаблицаЗначений с колонками Файл, Расширение, ТекущаяВерсия,
//       Зашифрован, ПодписанЭП, ПолноеНаименование.
//
Функция ФайлыДокументовПорции(ДокументыПорции)

	МассивДокументов = Новый Массив;
	Для Каждого ДокументПорции Из ДокументыПорции Цикл
		МассивДокументов.Добавить(ДокументПорции.Документ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.Ссылка КАК Файл,
		|	Файлы.ВладелецФайла КАК ВладелецФайла,
		|	Файлы.ПолноеНаименование КАК ПолноеНаименование,
		|	Файлы.ТекущаяВерсияРасширение КАК Расширение,
		|	Файлы.ТекущаяВерсия КАК ТекущаяВерсия,
		|	Файлы.Зашифрован КАК Зашифрован,
		|	Файлы.ПодписанЭП КАК ПодписанЭП
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыПочтовыхВложений КАК ИдентификаторыПочтовыхВложений
		|		ПО (ИдентификаторыПочтовыхВложений.Файл = Файлы.Ссылка)
		|ГДЕ
		|	Файлы.ВладелецФайла В (&Документы)
		|	И НЕ Файлы.ПометкаУдаления
		|	И (НЕ Файлы.ВладелецФайла ССЫЛКА Документ.ВходящееПисьмо
		|		ИЛИ ЕСТЬNULL(ИдентификаторыПочтовыхВложений.Идентификатор, """") = """")
		|УПОРЯДОЧИТЬ ПО
		|	Файлы.ВладелецФайла";
	Запрос.УстановитьПараметр("Документы", МассивДокументов);

	ФайлыПоДокументам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ФайлыДокумента = ФайлыПоДокументам.Получить(Выборка.ВладелецФайла);
		Если ФайлыДокумента = Неопределено Тогда
			ФайлыДокумента = Новый ТаблицаЗначений;
			ФайлыДокумента.Колонки.Добавить("Файл", Новый ОписаниеТипов("СправочникСсылка.Файлы"));
			ФайлыДокумента.Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
			ФайлыДокумента.Колонки.Добавить("ТекущаяВерсия", Новый ОписаниеТипов("СправочникСсылка.ВерсииФайлов"));
			ФайлыДокумента.Колонки.Добавить("Зашифрован", Новый ОписаниеТипов("Булево"));
			ФайлыДокумента.Колонки.Добавить("ПодписанЭП", Новый ОписаниеТипов("Булево"));
			ФайлыДокумента.Колонки.Добавить("ПолноеНаименование", Новый ОписаниеТипов("Строка"));
			ФайлыПоДокументам.Вставить(Выборка.ВладелецФайла, ФайлыДокумента);
		КонецЕсли;
		СтрокаФайла = ФайлыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФайла, Выборка);
	КонецЦикла;

	Возврат ФайлыПоДокументам;

КонецФункции

// Читает один файл порции и его подписи методами ДО и добавляет их в массивы порции.
// Ошибки чтения не прерывают порцию: проблемный файл или подпись попадает в пропущенные.
//
// Параметры:
//   ФайлДокумента        - СтрокаТаблицыЗначений - Файл, Расширение, ТекущаяВерсия, Зашифрован,
//       ПодписанЭП, ПолноеНаименование.
//   ДокументПорции       - Структура - Документ, ПутьПапки.
//   ИменаПапки           - Соответствие - занятые имена файлов папки документа (нижний регистр).
//   ИдентификаторХранилища - УникальныйИдентификатор - общий идентификатор временного хранилища задания.
//   ФайлыПорции          - Массив - структуры ОтносительныйПуть, ДвоичныеДанные, ЭтоПодпись, ОсновнойФайл.
//   ПропущенныеФайлы     - Массив - структуры Файл, Документ, Причина.
//
Процедура ДобавитьФайлВДанныеПорции(ФайлДокумента, ДокументПорции, ИменаПапки,
	ИдентификаторХранилища, ФайлыПорции, ПропущенныеФайлы)

	ПредставлениеФайла = СокрЛП(ФайлДокумента.ПолноеНаименование);
	ПредставлениеДокумента = Строка(ДокументПорции.Документ);

	Если ФайлДокумента.Зашифрован Тогда
		ДобавитьПропущенный(ПропущенныеФайлы, ПредставлениеФайла, ПредставлениеДокумента, НСтр("ru = 'зашифрован'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФайлДокумента.ТекущаяВерсия) Тогда
		ДобавитьПропущенный(ПропущенныеФайлы, ПредставлениеФайла, ПредставлениеДокумента, НСтр("ru = 'нет версии'"));
		Возврат;
	КонецЕсли;

	ИмяБезКоллизий = ИмяФайлаДляСохранения(ФайлДокумента.ПолноеНаименование, ФайлДокумента.Расширение);
	ИмяФайла = УникальноеИмяВПапке(ИменаПапки, ИмяБезКоллизий);

	ДвоичныеДанные = ДвоичныеДанныеФайла(ФайлДокумента.Файл, ИдентификаторХранилища);
	Если ДвоичныеДанные = Неопределено Тогда
		ДобавитьПропущенный(ПропущенныеФайлы, ПредставлениеФайла, ПредставлениеДокумента, НСтр("ru = 'нет в хранилище'"));
		Возврат;
	КонецЕсли;

	// ОсновнойФайл - у подписи относительный путь подписанного файла (agentrunner-480): первая подпись
	// сохраняется под исходным именем, и по имени связь с документом не восстановить.
	ОтносительныйПутьФайла = ДокументПорции.ПутьПапки + "\" + ИмяФайла;
	ФайлПорции = Новый Структура("ОтносительныйПуть, ДвоичныеДанные, ЭтоПодпись, ОсновнойФайл",
		ОтносительныйПутьФайла, ДвоичныеДанные, Ложь, "");
	ФайлыПорции.Добавить(ФайлПорции);

	Если НЕ ФайлДокумента.ПодписанЭП Тогда
		Возврат;
	КонецЕсли;

	Подписи = Неопределено;
	Попытка
		Подписи = РаботаСФайламиВызовСервера.ПолучитьВсеПодписи(ФайлДокумента.Файл, ИдентификаторХранилища);
	Исключение
		ПричинаОтказа = НСтр("ru = 'ошибка чтения подписи'");
		ДобавитьПропущенный(ПропущенныеФайлы, ИмяФайла + ".sig", ПредставлениеДокумента, ПричинаОтказа);
		Возврат;
	КонецПопытки;

	НомерПодписи = 0;
	Для Каждого Подпись Из Подписи Цикл

		НомерПодписи = НомерПодписи + 1;
		ИмяПодписиБезКоллизий = ИмяПодписиДляСохранения(НомерПодписи, Подпись.ИмяФайлаПодписи, ИмяФайла);

		ДвоичныеДанныеПодписи = Неопределено;
		Попытка
			ДвоичныеДанныеПодписи = ПолучитьИзВременногоХранилища(Подпись.АдресПодписи);
			УдалитьИзВременногоХранилища(Подпись.АдресПодписи);
		Исключение
			ДвоичныеДанныеПодписи = Неопределено;
		КонецПопытки;

		Если ДвоичныеДанныеПодписи = Неопределено Тогда
			ПричинаОтказа = НСтр("ru = 'ошибка чтения подписи'");
			ДобавитьПропущенный(ПропущенныеФайлы, ИмяПодписиБезКоллизий, ПредставлениеДокумента, ПричинаОтказа);
			Продолжить;
		КонецЕсли;

		ИмяПодписи = УникальноеИмяВПапке(ИменаПапки, ИмяПодписиБезКоллизий);
		ПодписьПорции = Новый Структура("ОтносительныйПуть, ДвоичныеДанные, ЭтоПодпись, ОсновнойФайл",
			ДокументПорции.ПутьПапки + "\" + ИмяПодписи, ДвоичныеДанныеПодписи, Истина, ОтносительныйПутьФайла);
		ФайлыПорции.Добавить(ПодписьПорции);

	КонецЦикла;

КонецПроцедуры

// Читает двоичные данные файла методом ДО «Сохранить как»: файл из тома приходит во временном
// хранилище (адрес удаляется сразу), файл из информационной базы - из ХранимыеФайлыВерсий.
//
// Параметры:
//   Файл                   - СправочникСсылка.Файлы - файл.
//   ИдентификаторХранилища - УникальныйИдентификатор - идентификатор временного хранилища задания.
//
// Возвращаемое значение:
//   ДвоичныеДанные, Неопределено - данные файла; Неопределено - файла нет в хранилище.
//
Функция ДвоичныеДанныеФайла(Файл, ИдентификаторХранилища)

	Попытка
		ДанныеФайла = РаботаСФайламиВызовСервера.ДанныеФайлаДляСохранения(Файл, Неопределено, ИдентификаторХранилища);

		Если ЭтоАдресВременногоХранилища(ДанныеФайла.НавигационнаяСсылкаТекущейВерсии) Тогда
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.НавигационнаяСсылкаТекущейВерсии);
			УдалитьИзВременногоХранилища(ДанныеФайла.НавигационнаяСсылкаТекущейВерсии);
			Возврат ДвоичныеДанные;
		КонецЕсли;

		ХранилищеФайла = РаботаСФайламиВызовСервера.ПолучитьХранилищеФайлаИзИнформационнойБазы(ДанныеФайла.Версия);
		Возврат ХранилищеФайла.Получить();
	Исключение
		// Нет файла в томе и другие ошибки чтения хранилища.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует имя файла для сохранения: очищенное полное наименование с расширением,
// не длиннее 100 символов (предел длины пути Windows).
//
// Параметры:
//   ПолноеНаименование - Строка - полное наименование файла.
//   Расширение         - Строка - расширение текущей версии.
//
// Возвращаемое значение:
//   Строка - имя файла с расширением.
//
Функция ИмяФайлаДляСохранения(Знач ПолноеНаименование, Знач Расширение)

	ЛимитДлиныИмени = 100; // Предел длины имени файла (см. spec.md).

	БазаИмени = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СокрЛП(ПолноеНаименование), "_");
	Расширение = СокрЛП(Расширение);

	Если ПустаяСтрока(Расширение) Тогда
		ЛимитБазы = ЛимитДлиныИмени;
	Иначе
		ЛимитБазы = ЛимитДлиныИмени - СтрДлина(Расширение) - 1;
	КонецЕсли;

	БазаИмени = Лев(БазаИмени, ЛимитБазы);
	Пока СтрДлина(БазаИмени) > 0 И (Прав(БазаИмени, 1) = "." Или Прав(БазаИмени, 1) = " ") Цикл
		БазаИмени = Лев(БазаИмени, СтрДлина(БазаИмени) - 1); // Windows не допускает точку и пробел в конце.
	КонецЦикла;

	Если ПустаяСтрока(БазаИмени) Тогда
		БазаИмени = "Файл";
	КонецЕсли;

	Если ПустаяСтрока(Расширение) Тогда
		Возврат БазаИмени;
	КонецЕсли;

	Возврат БазаИмени + "." + Расширение;

КонецФункции

// Формирует имя файла подписи: у первой подписи - сохраненное имя (если корректное),
// далее - имя файла с суффиксом номера.
//
// Параметры:
//   НомерПодписи     - Число - порядковый номер подписи файла, начиная с 1.
//   ИмяФайлаПодписи  - Строка - имя из данных подписи.
//   ИмяФайла         - Строка - имя подписанного файла.
//
// Возвращаемое значение:
//   Строка - имя файла подписи.
//
Функция ИмяПодписиДляСохранения(НомерПодписи, ИмяФайлаПодписи, ИмяФайла)

	ЛимитДлиныИмени = 100;      // Предел длины имени файла (см. spec.md).
	ДлинаРасширенияПодписи = 4; // ".sig" и ".p7s".

	ИмяФайлаПодписи = СокрЛП(ИмяФайлаПодписи);
	ИмяВНижнемРегистре = НРег(ИмяФайлаПодписи);
	ЭтоИмяПодписи = Прав(ИмяВНижнемРегистре, ДлинаРасширенияПодписи) = ".sig"
		Или Прав(ИмяВНижнемРегистре, ДлинаРасширенияПодписи) = ".p7s";

	Если НомерПодписи = 1 И НЕ ПустаяСтрока(ИмяФайлаПодписи) И ЭтоИмяПодписи Тогда
		Возврат Лев(ИмяФайлаПодписи, ЛимитДлиныИмени);
	КонецЕсли;

	СуффиксНомера = "";
	Если НомерПодписи > 1 Тогда
		СуффиксНомера = " (" + НомерПодписи + ")";
	КонецЕсли;

	Возврат Лев(ИмяФайла, ЛимитДлиныИмени - СтрДлина(СуффиксНомера) - ДлинаРасширенияПодписи)
		+ СуффиксНомера + ".sig";

КонецФункции

// Подбирает уникальное имя файла в папке документа: при совпадении добавляет суффикс « (2)», « (3)»...
//
// Параметры:
//   ИменаПапки - Соответствие - занятые имена папки (ключ - имя в нижнем регистре).
//   Имя        - Строка - проверяемое имя файла.
//
// Возвращаемое значение:
//   Строка - свободное имя файла (занимается в ИменаПапки).
//
Функция УникальноеИмяВПапке(ИменаПапки, Знач Имя)

	ПозицияТочки = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки = 0 Тогда
		БазаИмени = Имя;
		ТочкаРасширения = "";
	Иначе
		БазаИмени = Лев(Имя, ПозицияТочки - 1);
		ТочкаРасширения = Сред(Имя, ПозицияТочки);
	КонецЕсли;

	НомерДубля = 1;
	Пока ИменаПапки.Получить(НРег(Имя)) <> Неопределено Цикл
		НомерДубля = НомерДубля + 1;
		Имя = БазаИмени + " (" + НомерДубля + ")" + ТочкаРасширения;
	КонецЦикла;

	ИменаПапки.Вставить(НРег(Имя), Истина);

	Возврат Имя;

КонецФункции

// Добавляет запись о пропущенном файле или подписи.
//
// Параметры:
//   ПропущенныеФайлы     - Массив - структуры Файл, Документ, Причина.
//   ПредставлениеФайла   - Строка - имя файла или подписи.
//   ПредставлениеДокумента - Строка - представление документа-владельца.
//   Причина              - Строка - причина пропуска.
//
Процедура ДобавитьПропущенный(ПропущенныеФайлы, ПредставлениеФайла, ПредставлениеДокумента, Причина)

	ЗаписьПропуска = Новый Структура("Файл, Документ, Причина",
		ПредставлениеФайла, ПредставлениеДокумента, Причина);
	ПропущенныеФайлы.Добавить(ЗаписьПропуска);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
