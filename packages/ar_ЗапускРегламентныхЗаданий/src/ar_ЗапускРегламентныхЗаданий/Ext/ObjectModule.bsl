#Область ПрограммныйИнтерфейс

// Внешняя дополнительная обработка «AgentRunner: запуск регламентных заданий»
// (задача agentrunner-489, спека v3).
//
// В базах, где запуск фоновых заданий заблокирован (нет планировщика фоновых
// заданий), регламентные задания расширения AgentRunner не выполняются
// автоматически. Обработка показывает список заданий расширения и по кнопке
// выполняет выбранные задания прямым синхронным серверным вызовом их
// обработчиков: явная диспетчеризация по имени задания, без механизма фоновых
// заданий и без Выполнить()/Вычислить() (стиль проекта, прецедент
// ar_ОбновлениеРасширения.ВызватьОбработчикПоИдентификатору). Готовые механизмы
// ручного запуска БСП не подходят: в серверной ИБ они всегда идут через
// ФоновыеЗадания.Выполнить.
//
// Обработка рассчитана на базу с установленным расширением AgentRunner: без
// него строки списка получают пометку «задание не найдено», запуск невозможен.
// Вызов модулей ядра - по позднему связыванию: переименование в ядре ломает
// обработку на этапе исполнения (обновлять отдельной задачей).
//
// Чтение платформенных данных регламентных заданий требует права
// администрирования, поэтому список читается в привилегированном режиме; для
// него в регистрации БезопасныйРежим = Ложь. Привилегированный режим вокруг
// вызова обработчика не ставится: его поднимает сам обработчик через
// ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания (оттуда же могут
// прийти исключения: обновление ИБ, РИБ, функциональные опции - диспетчер
// ловит их поштучно).
//
// Форма доступна только полноправному пользователю: проверка на сервере до
// подъема привилегированного режима, в каждой серверной функции обработки
// (прецедент ar_ОбслуживаниеСлужебныхДанных).

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки».
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: запуск регламентных заданий'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Список регламентных заданий расширения AgentRunner
		|и ручной запуск выбранных заданий прямым серверным вызовом обработчиков -
		|для баз, где фоновые задания заблокированы. Выполнение синхронное,
		|форма отвечает после каждого задания; итог каждого запуска пишется
		|в служебный лог AgentRunner (события sched_manual_run).'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	// Форма списка заданий и запуска. Идентификатор команды не меняется:
	// на нем назначение команды пользователям в карточке обработки.
	КомандаФормы = ПараметрыРегистрации.Команды.Добавить();
	КомандаФормы.Представление        = НСтр("ru = 'Запуск регламентных заданий'");
	КомандаФормы.Идентификатор        = "ОткрытьФормуЗапуска";
	КомандаФормы.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	КомандаФормы.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Проверка полных прав текущего пользователя. Привилегированный режим не
// учитывается: право нельзя получить из самого кода обработки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПолныеПрава() Экспорт

	Возврат Пользователи.ЭтоПолноправныйПользователь(, , Ложь);

КонецФункции

// Список регламентных заданий расширения AgentRunner с платформенными данными:
// использование, расписание, последний запуск. Чтение - в привилегированном
// режиме (требуется право администрирования). Отдельное задание читается в
// своей Попытке: сбой одного задания (например, при обновлении ИБ) попадает в
// «Пояснение» строки и не рушит весь список.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя              - Строка - имя регламентного задания в метаданных.
//   * Синоним          - Строка - название задания для формы.
//   * Найден           - Булево - задание есть в метаданных.
//   * Использование    - Булево - задание включено (Ложь, если не найдено).
//   * ПериодПовтораСек - Число  - период повтора в течение дня, секунд;
//                                 0 и меньше - задание раз в день.
//   * ПоследнийЗапуск  - Дата   - конец последнего задания планировщика
//                                 ('00010101', если не запускалось).
//   * Пояснение        - Строка - «задание не найдено» либо текст сбоя чтения;
//                                 пустая при успехе.
//
Функция СписокЗаданий() Экспорт

	ПроверитьПолныеПрава();

	Результат = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Описание Из ПереченьЗаданий() Цикл
			Результат.Добавить(ДанныеОдногоЗадания(Описание));
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Ручной запуск одного регламентного задания прямым синхронным вызовом
// обработчика ядра. Исключения наружу не выходят: итог возвращается структурой
// и пишется в служебный лог расширения (sched_manual_run / sched_manual_run_error) -
// в базах без фоновых заданий это единственный след запуска.
//
// Параметры:
//  ИмяМетаданных - Строка - имя регламентного задания, как в списке формы.
//
// Возвращаемое значение:
//  Структура:
//   * Имя       - Строка - имя задания.
//   * Выполнено - Булево - обработчик отработал без ошибок.
//   * Сообщение - Строка - текст ошибки, пустая при успехе.
//
Функция ВыполнитьЗадание(Знач ИмяМетаданных) Экспорт

	ПроверитьПолныеПрава();

	Итог = Новый Структура("Имя, Выполнено, Сообщение", ИмяМетаданных, Ложь, "");
	Ошибка = "";

	Если Метаданные.РегламентныеЗадания.Найти(ИмяМетаданных) = Неопределено Тогда
		// Неизвестное имя или расширение снято/задание переименовано.
		Ошибка = НСтр("ru = 'задание не найдено в метаданных (расширение AgentRunner
			|снято или задание переименовано)'");
	Иначе
		Попытка
			// Исключение может прийти из обработчика: обновление ИБ, РИБ,
			// функциональные опции, региональные настройки.
			ВызватьОбработчик(ИмяМетаданных);
		Исключение
			Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Итог.Выполнено = ПустаяСтрока(Ошибка);
	Итог.Сообщение = Ошибка;

	ЗаписатьИтогЗапуска(Итог);

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перечень регламентных заданий расширения AgentRunner: имя и название.
// Копия перечня ar_Планировщик.ДиагностикаПланировщика (ядро расширения
// обработкой не меняется, третьей общей точки без правки ядра нет): при
// переименованиях в ядре обработку обновлять отдельной задачей.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя     - Строка.
//   * Синоним - Строка.
//
Функция ПереченьЗаданий()

	Результат = Новый Массив;

	Синоним = НСтр("ru = 'Планировщик агентов'");
	Результат.Добавить(ОписаниеЗадания("ar_ПланировщикАгентов", Синоним));
	Синоним = НСтр("ru = 'Опрос подписок агентов'");
	Результат.Добавить(ОписаниеЗадания("ar_ОпросПодписокАгентов", Синоним));
	Синоним = НСтр("ru = 'Очистка зависших запусков'");
	Результат.Добавить(ОписаниеЗадания("ar_ОчисткаЗависших", Синоним));
	Синоним = НСтр("ru = 'Ротация сессий'");
	Результат.Добавить(ОписаниеЗадания("ar_РотацияСессий", Синоним));
	Синоним = НСтр("ru = 'Обработка упоминаний'");
	Результат.Добавить(ОписаниеЗадания("ar_ОбработчикУпоминаний", Синоним));
	Синоним = НСтр("ru = 'Автообновление памяти агентов'");
	Результат.Добавить(ОписаниеЗадания("ar_ОбновлениеПамятиAuto", Синоним));
	Синоним = НСтр("ru = 'Сжатие аудита'");
	Результат.Добавить(ОписаниеЗадания("ar_КомпакцияAudit", Синоним));
	Синоним = НСтр("ru = 'Очистка служебного лога'");
	Результат.Добавить(ОписаниеЗадания("ar_ОчисткаСлужебногоЛога", Синоним));
	Синоним = НСтр("ru = 'Автовозобновление запусков'");
	Результат.Добавить(ОписаниеЗадания("ar_АвтовозобновлениеЗапусков", Синоним));
	Синоним = НСтр("ru = 'Возобновление после подтверждения'");
	Результат.Добавить(ОписаниеЗадания("ar_ВозобновлениеПослеApproval", Синоним));
	Синоним = НСтр("ru = 'Проверка версии'");
	Результат.Добавить(ОписаниеЗадания("ar_ПроверкаВерсии", Синоним));

	Возврат Результат;

КонецФункции

// Описание одного задания для перечня.
//
// Параметры:
//  Имя     - Строка - имя регламентного задания в метаданных.
//  Синоним - Строка - название задания.
//
// Возвращаемое значение:
//  Структура - {Имя, Синоним}.
//
Функция ОписаниеЗадания(Знач Имя, Знач Синоним)

	Возврат Новый Структура("Имя, Синоним", Имя, Синоним);

КонецФункции

// Данные одного задания для списка формы. Чтение платформенных данных - в
// своей Попытке (вызывается уже в привилегированном режиме СписокЗаданий):
// сбой попадает в «Пояснение», строка возвращается заполненной по умолчанию.
//
// Параметры:
//  Описание - Структура - см. ОписаниеЗадания.
//
// Возвращаемое значение:
//  Структура - см. СписокЗаданий.
//
Функция ДанныеОдногоЗадания(Знач Описание)

	СтрокаСписка = Новый Структура;
	СтрокаСписка.Вставить("Имя", Описание.Имя);
	СтрокаСписка.Вставить("Синоним", Описание.Синоним);
	СтрокаСписка.Вставить("Найден", Ложь);
	СтрокаСписка.Вставить("Использование", Ложь);
	СтрокаСписка.Вставить("ПериодПовтораСек", 0);
	СтрокаСписка.Вставить("ПоследнийЗапуск", '00010101');
	СтрокаСписка.Вставить("Пояснение", "");

	Попытка
		ОбъектМетаданных = Метаданные.РегламентныеЗадания.Найти(Описание.Имя);
		Если ОбъектМетаданных = Неопределено Тогда
			// Расширение снято или задание переименовано: строка остается в
			// списке, чтобы пропуск не молчал и не сбивал нумерацию.
			СтрокаСписка.Пояснение = НСтр("ru = 'задание не найдено'");
			Возврат СтрокаСписка;
		КонецЕсли;

		Задание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(ОбъектМетаданных);
		СтрокаСписка.Найден = Истина;
		СтрокаСписка.Использование = Задание.Использование;
		СтрокаСписка.ПериодПовтораСек = Задание.Расписание.ПериодПовтораВТечениеДня;
		Если Задание.ПоследнееЗадание <> Неопределено
			И ЗначениеЗаполнено(Задание.ПоследнееЗадание.Конец) Тогда
			СтрокаСписка.ПоследнийЗапуск = Задание.ПоследнееЗадание.Конец;
		КонецЕсли;
	Исключение
		СтрокаСписка.Пояснение = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат СтрокаСписка;

КонецФункции

// Явная диспетчеризация обработчиков регламентных заданий расширения по имени
// задания, без Выполнить()/Вычислить() (стиль проекта, прецедент
// ar_ОбновлениеРасширения.ВызватьОбработчикПоИдентификатору). Соответствие имен
// задания -> обработчик сверено с метаданными src/ScheduledJobs (mcp.md [P3]).
// Все обработчики без параметров; задания с параметрами не поддерживаются.
//
// Параметры:
//  ИмяМетаданных - Строка - имя регламентного задания.
//
Процедура ВызватьОбработчик(Знач ИмяМетаданных)

	Если ИмяМетаданных = "ar_ПланировщикАгентов" Тогда
		ar_Планировщик.ОбработатьПланировщик();
	ИначеЕсли ИмяМетаданных = "ar_ОпросПодписокАгентов" Тогда
		ar_Планировщик.ОбработатьОпросПодписок();
	ИначеЕсли ИмяМетаданных = "ar_ОчисткаЗависших" Тогда
		ar_Планировщик.ОбработатьОчисткуЗависших();
	ИначеЕсли ИмяМетаданных = "ar_РотацияСессий" Тогда
		ar_Планировщик.ОбработатьРотациюСессий();
	ИначеЕсли ИмяМетаданных = "ar_ОбработчикУпоминаний" Тогда
		ar_Планировщик.ОбработатьУпоминания();
	ИначеЕсли ИмяМетаданных = "ar_ОбновлениеПамятиAuto" Тогда
		ar_Планировщик.ОбработатьОбновлениеПамятиAuto();
	ИначеЕсли ИмяМетаданных = "ar_КомпакцияAudit" Тогда
		ar_Планировщик.ОбработатьКомпакциюAudit();
	ИначеЕсли ИмяМетаданных = "ar_ОчисткаСлужебногоЛога" Тогда
		ar_Планировщик.ОбработатьОчисткуСлужебногоЛога();
	ИначеЕсли ИмяМетаданных = "ar_АвтовозобновлениеЗапусков" Тогда
		ar_Планировщик.ОбработатьАвтовозобновление();
	ИначеЕсли ИмяМетаданных = "ar_ВозобновлениеПослеApproval" Тогда
		ar_Планировщик.ОбработатьВозобновление();
	ИначеЕсли ИмяМетаданных = "ar_ПроверкаВерсии" Тогда
		ar_ПроверкаОбновлений.ПроверитьВерсиюРегламентнымЗаданием();
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У задания %1 нет обработчика в этой обработке:
			|обновите обработку до текущей версии расширения AgentRunner.'"), ИмяМетаданных);
	КонецЕсли;

КонецПроцедуры

// Запись итога ручного запуска в служебный лог расширения - в собственной
// Попытке: падение записи (модуль ядра недоступен, регистр заблокирован) не
// должно съедать результат запуска, пользователь всегда получает итог в форму.
//
// Параметры:
//  Итог - Структура - см. ВыполнитьЗадание.
//
Процедура ЗаписатьИтогЗапуска(Знач Итог)

	Попытка
		Если Итог.Выполнено Тогда
			ar_СлужебныйЛог.Записать(ИсточникЛогаЗапуска(), "sched_manual_run",
				Итог.Имя, "Информация");
		Иначе
			ar_СлужебныйЛог.Записать(ИсточникЛогаЗапуска(), "sched_manual_run_error",
				СтрШаблон(НСтр("ru = '%1: %2'"), Итог.Имя, Итог.Сообщение), "Ошибка");
		КонецЕсли;
	Исключение
		// Результат запуска важнее записи о нем: сбой лога не меняет итог.
		Событие = СобытиеОбработки();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Не записан итог ручного запуска в служебный лог: '") + ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Проверка полных прав с исключением: вызывается серверными функциями обработки
// до подъема привилегированного режима.
Процедура ПроверитьПолныеПрава()

	Если НЕ ЕстьПолныеПрава() Тогда
		ВызватьИсключение НСтр("ru = 'Для работы с обработкой нужны полные права.'");
	КонецЕсли;

КонецПроцедуры

// Источник записей служебного лога (стиль «Модуль.Метод»).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЛогаЗапуска()

	Возврат "ar_ЗапускРегламентныхЗаданий.ВыполнитьЗадание";

КонецФункции

// Имя события журнала регистрации.
//
// Возвращаемое значение:
//  Строка.
