#Область ОписаниеПеременных

// Имена отмеченных заданий, еще не выполненных в текущем запуске; Неопределено -
// запуск не идет.
&НаКлиенте
Перем ОчередьЗапуска;

// Имя задания, которое выполняется (строка уже помечена «Выполняется...»).
&НаКлиенте
Перем ТекущееЗадание;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Форма читает данные регламентных заданий в привилегированном режиме, поэтому
// без полных прав она не открывается. Проверка - на сервере, до подъема
// привилегированного режима.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если НЕ ОбъектОбработки.ЕстьПолныеПрава() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для работы с обработкой нужны полные права.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьТаблицуЗаданий(ОбъектОбработки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выполнение отмеченных заданий по одному: на каждое задание - отдельный
// серверный вызов из своего обработчика ожидания, чтобы форма перерисовывалась
// между заданиями («Выполняется...» у текущей строки, «Результат» - сразу после
// задания); в одном клиентском цикле форма обновилась бы только после последнего.
// Одно упавшее задание не останавливает остальные. На время выполнения команды
// «Выполнить выбранные» и «Обновить» недоступны.
&НаКлиенте
Процедура ВыполнитьВыбранные(Команда)

	Если ОчередьЗапуска <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отмеченные = Новый Массив;
	Для Каждого СтрокаЗадания Из Задания Цикл
		Если СтрокаЗадания.Отметка Тогда
			Отмеченные.Добавить(СтрокаЗадания.Имя);
		КонецЕсли;
	КонецЦикла;

	Если Отмеченные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте задания для запуска.'"));
		Возврат;
	КонецЕсли;

	ОчередьЗапуска = Отмеченные;
	ТекущееЗадание = "";
	УстановитьДоступностьКоманд(Ложь);
	ПодключитьОбработчикОжидания("НачатьСледующееЗадание", 0.1, Истина);

КонецПроцедуры

// Обновление списка заданий: использование, расписание, последний запуск.
// Отметки сбрасываются. Во время запуска не выполняется: строки с итогами
// текущего запуска не затираются.
&НаКлиенте
Процедура ОбновитьСписок(Команда)

	Если ОчередьЗапуска <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбновитьСписокНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Шаг запуска: следующее задание очереди помечается «Выполняется...», сам
// серверный вызов - в следующем обработчике ожидания, после перерисовки формы.
// Очередь пуста - запуск завершен.
&НаКлиенте
Процедура НачатьСледующееЗадание()

	Если ОчередьЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ОчередьЗапуска.Количество() = 0 Тогда
		ЗавершитьЗапуск("");
		Возврат;
	КонецЕсли;

	ТекущееЗадание = ОчередьЗапуска[0];
	ОчередьЗапуска.Удалить(0);
	УстановитьРезультатСтроки(ТекущееЗадание, НСтр("ru = 'Выполняется...'"));

	ПодключитьОбработчикОжидания("ВыполнитьТекущееЗадание", 0.1, Истина);

КонецПроцедуры

// Шаг запуска: серверный вызов текущего задания и его итог в строку. Ошибку
// обработчика задания сервер возвращает итогом; исключение здесь - сбой самого
// серверного вызова (связь, сеанс): запуск останавливается с сообщением, итоги
// выполненных заданий остаются в строках.
&НаКлиенте
Процедура ВыполнитьТекущееЗадание()

	Если ОчередьЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		РезультатЗапуска = ВыполнитьЗаданиеНаСервере(ТекущееЗадание);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		УстановитьРезультатСтроки(ТекущееЗадание, НСтр("ru = 'Ошибка: '") + ТекстОшибки);
		ЗавершитьЗапуск(НСтр("ru = 'Выполнение прервано: '") + ТекстОшибки);
		Возврат;
	КонецПопытки;

	УстановитьРезультатСтроки(РезультатЗапуска.Имя, РезультатЗапуска.ТекстРезультата);

	ПодключитьОбработчикОжидания("НачатьСледующееЗадание", 0.1, Истина);

КонецПроцедуры

// Конец запуска: очередь сбрасывается, команды снова доступны.
//
// Параметры:
//  ТекстПрерывания - Строка - причина остановки для сообщения; пустая - запуск
//                             завершен штатно.
//
&НаКлиенте
Процедура ЗавершитьЗапуск(Знач ТекстПрерывания)

	ОчередьЗапуска = Неопределено;
	ТекущееЗадание = "";
	УстановитьДоступностьКоманд(Истина);

	Если ЗначениеЗаполнено(ТекстПрерывания) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПрерывания);
	КонецЕсли;

КонецПроцедуры

// Доступность команд формы на время запуска.
//
// Параметры:
//  Доступны - Булево - Ложь на время запуска.
//
&НаКлиенте
Процедура УстановитьДоступностьКоманд(Знач Доступны)

	Элементы.КнопкаВыполнитьВыбранные.Доступность = Доступны;
	Элементы.КнопкаОбновитьСписок.Доступность = Доступны;

КонецПроцедуры

// Текст колонки «Результат» строки задания.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания.
//  Текст      - Строка - текст результата.
//
&НаКлиенте
Процедура УстановитьРезультатСтроки(Знач ИмяЗадания, Знач Текст)

	СтрокаЗадания = СтрокаПоИмениЗадания(ИмяЗадания);
	Если СтрокаЗадания <> Неопределено Тогда
		СтрокаЗадания.Результат = Текст;
	КонецЕсли;

КонецПроцедуры

// Чтение списка заданий в таблицу формы.
//
// Параметры:
//  ОбъектОбработки - ВнешняяОбработкаОбъект.ar_ЗапускРегламентныхЗаданий.
//
&НаСервере
Процедура ЗаполнитьТаблицуЗаданий(Знач ОбъектОбработки)

	Задания.Очистить();
	Для Каждого ДанныеЗадания Из ОбъектОбработки.СписокЗаданий() Цикл
		СтрокаЗадания = Задания.Добавить();
		СтрокаЗадания.Имя             = ДанныеЗадания.Имя;
		СтрокаЗадания.Название        = ДанныеЗадания.Синоним;
		// Ненайденное задание показывается выключенным, причина - в «Результате».
		СтрокаЗадания.Включено        = ДанныеЗадания.Найден И ДанныеЗадания.Использование;
		СтрокаЗадания.Расписание      = ПредставлениеРасписания(ДанныеЗадания);
		СтрокаЗадания.ПоследнийЗапуск = ПредставлениеПоследнегоЗапуска(ДанныеЗадания);
		СтрокаЗадания.Результат       = ДанныеЗадания.Пояснение;
	КонецЦикла;

КонецПроцедуры

// Обновление списка по кнопке.
&НаСервере
Процедура ОбновитьСписокНаСервере()

	ЗаполнитьТаблицуЗаданий(РеквизитФормыВЗначение("Объект"));

КонецПроцедуры

// Один запуск задания на сервере; итог запуска и время сеанса - одной строкой
// для колонки «Результат» (время результата считается на сервере).
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания.
//
// Возвращаемое значение:
//  Структура:
//   * Имя            - Строка - имя задания.
//   * ТекстРезультата - Строка - «Выполнено ЧЧ:ММ:СС» либо «Ошибка: ...».
//
&НаСервере
Функция ВыполнитьЗаданиеНаСервере(Знач ИмяЗадания)

	Итог = РеквизитФормыВЗначение("Объект").ВыполнитьЗадание(ИмяЗадания);

	Если Итог.Выполнено Тогда
		ВремяЗапуска = Формат(ТекущаяДатаСеанса(), "ДЛФ=T");
		Возврат Новый Структура("Имя, ТекстРезультата", Итог.Имя,
			НСтр("ru = 'Выполнено'") + " " + ВремяЗапуска);
	КонецЕсли;

	Возврат Новый Структура("Имя, ТекстРезультата", Итог.Имя,
		НСтр("ru = 'Ошибка: '") + Итог.Сообщение);

КонецФункции

// Представление расписания задания: период повтора или «раз в день».
//
// Параметры:
//  ДанныеЗадания - Структура - см. СписокЗаданий модуля объекта.
//
// Возвращаемое значение:
//  Строка.
//
&НаСервере
Функция ПредставлениеРасписания(Знач ДанныеЗадания)

	Если НЕ ДанныеЗадания.Найден Тогда
		Возврат "";
	КонецЕсли;
	Если ДанныеЗадания.ПериодПовтораСек <= 0 Тогда
		Возврат НСтр("ru = 'раз в день'");
	КонецЕсли;
	Если ДанныеЗадания.ПериодПовтораСек < СекундВМинуте() Тогда
		Возврат СтрШаблон(НСтр("ru = 'раз в %1 сек.'"),
			Формат(ДанныеЗадания.ПериодПовтораСек, "ЧГ=0"));
	КонецЕсли;
	Минут = Окр(ДанныеЗадания.ПериодПовтораСек / СекундВМинуте());
	Возврат СтрШаблон(НСтр("ru = 'раз в %1 мин.'"), Формат(Минут, "ЧГ=0"));

КонецФункции

// Секунд в минуте - именованная константа для представления расписания.
//
// Возвращаемое значение:
//  Число.
//
&НаСервере
Функция СекундВМинуте()

	Возврат 60;

КонецФункции

// Представление последнего запуска. Показывает платформенную статистику
// задания: ручной прямой вызов обработчика она не отражает - след ручного
// запуска только в служебном логе (подсказка на форме об этом говорит).
//
// Параметры:
//  ДанныеЗадания - Структура - см. СписокЗаданий модуля объекта.
//
// Возвращаемое значение:
//  Строка.
//
&НаСервере
Функция ПредставлениеПоследнегоЗапуска(Знач ДанныеЗадания)

	Если НЕ ДанныеЗадания.Найден ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗадания.ПоследнийЗапуск) Тогда
		Возврат НСтр("ru = 'не запускалось'");
	КонецЕсли;
	Возврат Формат(ДанныеЗадания.ПоследнийЗапуск, "ДЛФ=DT");

КонецФункции

// Строка таблицы заданий по имени задания.
//
// Параметры:
//  ИмяЗадания - Строка.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка не найдена.
//
&НаКлиенте
Функция СтрокаПоИмениЗадания(Знач ИмяЗадания)

	Для Каждого СтрокаЗадания Из Задания Цикл
		Если СтрокаЗадания.Имя = ИмяЗадания Тогда
			Возврат СтрокаЗадания;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
