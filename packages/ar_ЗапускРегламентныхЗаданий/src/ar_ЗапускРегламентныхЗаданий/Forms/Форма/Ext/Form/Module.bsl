#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Форма читает данные регламентных заданий в привилегированном режиме, поэтому
// без полных прав она не открывается. Проверка - на сервере, до подъема
// привилегированного режима.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Если НЕ ОбъектОбработки.ЕстьПолныеПрава() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для работы с обработкой нужны полные права.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьТаблицуЗаданий();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выполнение отмеченных заданий по одному: на каждое задание - отдельный
// серверный вызов, «Результат» строки обновляется после каждого задания, одно
// упавшее задание не останавливает остальные. На время выполнения команда
// недоступна: повторный клик невозможен.
&НаКлиенте
Процедура ВыполнитьВыбранные(Команда)

	Отмеченные = Новый Массив;
	Для Каждого СтрокаЗадания Из Задания Цикл
		Если СтрокаЗадания.Отметка Тогда
			Отмеченные.Добавить(СтрокаЗадания.Имя);
		КонецЕсли;
	КонецЦикла;

	Если Отмеченные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте задания для запуска.'"));
		Возврат;
	КонецЕсли;

	Элементы.КнопкаВыполнитьВыбранные.Доступность = Ложь;
	Для Каждого ИмяЗадания Из Отмеченные Цикл
		РезультатЗапуска = ВыполнитьЗаданиеНаСервере(ИмяЗадания);
		СтрокаЗадания = СтрокаПоИмениЗадания(ИмяЗадания);
		Если СтрокаЗадания <> Неопределено Тогда
			Если РезультатЗапуска.Выполнено Тогда
				СтрокаЗадания.Результат = НСтр("ru = 'Выполнено'") + " "
					+ Формат(ТекущаяДата(), "ДЛФ=T");
			Иначе
				СтрокаЗадания.Результат = НСтр("ru = 'Ошибка: '") + РезультатЗапуска.Сообщение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Элементы.КнопкаВыполнитьВыбранные.Доступность = Истина;

КонецПроцедуры

// Обновление списка заданий: использование, расписание, последний запуск.
// Отметки сбрасываются.
&НаКлиенте
Процедура ОбновитьСписок(Команда)

	ОбновитьСписокНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Чтение списка заданий в таблицу формы.
&НаСервере
Процедура ЗаполнитьТаблицуЗаданий()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");

	Задания.Очистить();
	Для Каждого ДанныеЗадания Из ОбъектОбработки.СписокЗаданий() Цикл
		СтрокаЗадания = Задания.Добавить();
		СтрокаЗадания.Имя             = ДанныеЗадания.Имя;
		СтрокаЗадания.Название        = ДанныеЗадания.Синоним;
		СтрокаЗадания.Включено        = ДанныеЗадания.Найден И ДанныеЗадания.Использование;
		СтрокаЗадания.Расписание      = ПредставлениеРасписания(ДанныеЗадания);
		СтрокаЗадания.ПоследнийЗапуск = ПредставлениеПоследнегоЗапуска(ДанныеЗадания);
		СтрокаЗадания.Результат       = ДанныеЗадания.Пояснение;
	КонецЦикла;

КонецПроцедуры

// Обновление списка по кнопке.
&НаСервере
Процедура ОбновитьСписокНаСервере()

	ЗаполнитьТаблицуЗаданий();

КонецПроцедуры

// Один запуск задания на сервере.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания.
//
// Возвращаемое значение:
//  Структура - см. ВыполнитьЗадание модуля объекта.
//
&НаСервере
Функция ВыполнитьЗаданиеНаСервере(Знач ИмяЗадания)

	Возврат РеквизитФормыВЗначение("Объект").ВыполнитьЗадание(ИмяЗадания);

КонецФункции

// Представление расписания задания: период повтора или «раз в день».
//
// Параметры:
//  ДанныеЗадания - Структура - см. СписокЗаданий модуля объекта.
//
// Возвращаемое значение:
//  Строка.
//
&НаСервере
Функция ПредставлениеРасписания(Знач ДанныеЗадания)

	Если НЕ ДанныеЗадания.Найден Тогда
		Возврат "";
	КонецЕсли;
	Если ДанныеЗадания.ПериодПовтораСек <= 0 Тогда
		Возврат НСтр("ru = 'раз в день'");
	КонецЕсли;
	Если ДанныеЗадания.ПериодПовтораСек < 60 Тогда
		Возврат СтрШаблон(НСтр("ru = 'раз в %1 сек.'"),
			Формат(ДанныеЗадания.ПериодПовтораСек, "ЧГ=0"));
	КонецЕсли;
	Минут = Окр(ДанныеЗадания.ПериодПовтораСек / 60);
	Возврат СтрШаблон(НСтр("ru = 'раз в %1 мин.'"), Формат(Минут, "ЧГ=0"));

КонецФункции

// Представление последнего запуска. Показывает платформенную статистику
// задания: ручной прямой вызов обработчика она не отражает - след ручного
// запуска только в служебном логе (подсказка на форме об этом говорит).
//
// Параметры:
//  ДанныеЗадания - Структура - см. СписокЗаданий модуля объекта.
//
// Возвращаемое значение:
//  Строка.
//
&НаСервере
Функция ПредставлениеПоследнегоЗапуска(Знач ДанныеЗадания)

	Если НЕ ДанныеЗадания.Найден ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗадания.ПоследнийЗапуск) Тогда
		Возврат НСтр("ru = 'не запускалось'");
	КонецЕсли;
	Возврат Формат(ДанныеЗадания.ПоследнийЗапуск, "ДЛФ=DT");

КонецФункции

// Строка таблицы заданий по имени задания.
//
// Параметры:
//  ИмяЗадания - Строка.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка не найдена.
//
&НаКлиенте
Функция СтрокаПоИмениЗадания(Знач ИмяЗадания)

	Для Каждого СтрокаЗадания Из Задания Цикл
		Если СтрокаЗадания.Имя = ИмяЗадания Тогда
			Возврат СтрокаЗадания;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
