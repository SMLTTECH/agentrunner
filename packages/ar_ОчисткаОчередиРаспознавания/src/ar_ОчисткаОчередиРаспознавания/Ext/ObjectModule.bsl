#Область ПрограммныйИнтерфейс

// Внешняя дополнительная обработка «Очистка очереди распознавания и извлеченных
// текстов исполненных заявок НСИ» (задача agentrunner-343, спека v1).
//
// Тексты, извлеченные из файлов заявок НСИ (кэш ТекстХранилище), и строки очереди
// предварительного распознавания ar_ОчередьРаспознавания нужны агенту только пока
// заявка в работе; у исполненных и закрытых заявок обработка удаляет их. Сами
// файлы (двоичные данные, том, MinIO) не трогаются.
//
// Порядок такта:
//  1. Дата среза - настройка НСИДатаНачалаОбработкиЗаявок (копия разбора из
//     ar_ПакетНСИ, спека п. 3);
//  2. Один запрос на запуск: исполненные («Исполнена» или «Закрыт») заявки НСИ
//     не раньше даты среза - множество навигационных ссылок (п. 2);
//  3. Проход очереди порциями по курсору ar_Файл: строки заявок из множества
//     удаляются (кроме processing - файл в работе воркера, спека п. 5);
//  4. Проход файлов порциями по курсору Ссылка: файлы со статусом «Извлечен»
//     очищаются (ТекстХранилище = "", статус - пустая ссылка, спека п. 4, 6).
//     Если проход очереди остановлен по пределу времени, файлы не чистятся:
//     множество файлов в работе неполное, очистка откладывается до следующего
//     запуска.
//
// Сбой одного файла или строки очереди не прерывает такт - запись в ar_СлужебныйЛог
// recognition_cleanup_file_failed и переход к следующему (п. 7). Ошибка запроса -
// recognition_cleanup_failed («Ошибка»), исключение не пробрасывается: регламентное
// задание не падает. Итог такта - recognition_cleanup_done («Информация», п. 8).
//
// Права на ar_* есть только у роли расширения, чтение и запись идут в
// привилегированном режиме. БезопасныйРежим = Ложь: иначе платформа запрещает
// привилегированный режим.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки».
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: очистка очереди распознавания и текстов исполненных заявок НСИ'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Удаляет строки очереди распознавания
		|ar_ОчередьРаспознавания и очищает кэш извлеченных текстов файлов исполненных и
		|закрытых заявок НСИ (справочник бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы).
		|Сами файлы не трогаются. Запуск - команда по расписанию (расписание задает
		|администратор в карточке обработки) или вручную из списка дополнительных обработок.'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	// Одна команда: на нее администратор ставит расписание (идентификатор не менять
	// в следующих версиях - спека п. 1). Представление - точный текст из спеки.
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление =
		НСтр("ru = 'AgentRunner Пакет инструментов: Очистка очереди распознавания и текстов исполненных заявок НСИ'");
	Команда.Идентификатор        = ИдентификаторКомандыОчистки();
	Команда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП «Дополнительные отчеты и обработки». Ошибки такта не
// роняют регламентное задание: перехватываются внутри и пишутся в ar_СлужебныйЛог.
//
// Параметры:
//  ИдентификаторКоманды       - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП
//                               (ДополнительнаяОбработкаСсылка - элемент
//                               справочника этой обработки).
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = ИдентификаторКомандыОчистки() Тогда
		ВыполнитьОчистку();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТактОчистки

// Один такт очистки. Ошибка запроса не выходит наружу: такт прерывается с записью
// recognition_cleanup_failed («Ошибка»), регламентное задание не падает (спека п. 7).
Процедура ВыполнитьОчистку()

	Итог = НовыйИтогТакта();
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОкончаниеМс = НачалоМс + ПределТактаМинут() * 60000;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Дата среза - до отбора заявок: ее источник входит в итог такта (спека п. 3, 8).
		РазборДаты = РазборДатыНачалаОбработкиЗаявок();
		Итог.ДатаНачала = НачалоДня(РазборДаты.Дата);
		Итог.ИсточникДаты = РазборДаты.Источник;

		// Один запрос на запуск (спека п. 2).
		МножествоЗаявок = СсылкиИсполненныхЗаявок(Итог.ДатаНачала);
		Итог.Заявок = МножествоЗаявок.Количество();

		// Очередь - до файлов: не удаленные строки processing дают файлы, которые
		// в проходе файлов не очищаются (спека п. 5).
		ФайлыВРаботе = ОчиститьОчередь(МножествоЗаявок, ОкончаниеМс, Итог);

		Если НЕ Итог.ОстановленПоПределу Тогда
			// Очередь дочитана до конца - множество файлов в работе полное.
			ОчиститьФайлы(ФайлыВРаботе, Итог.ДатаНачала, ОкончаниеМс, Итог);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Итог.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс) / 1000;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Такт прерван ошибкой за %1 сек: %2'"),
			ЧислоСтрокой(Окр(Итог.Секунд)),
			ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		ar_СлужебныйЛог.Записать(ИсточникЛога(), СобытиеОшибкиТакта(), ТекстОшибки, "Ошибка");
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Итог.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс) / 1000;
	ar_СлужебныйЛог.Записать(ИсточникЛога(), СобытиеИтогаТакта(), ТекстИтогаТакта(Итог), "Информация");

КонецПроцедуры

// Новый итог такта - все поля идут в запись recognition_cleanup_done (спека п. 8).
//
// Возвращаемое значение:
//  Структура:
//   * ДатаНачала          - Дата   - нормализованная дата среза.
//   * ИсточникДаты        - Строка - setting / default / invalid.
//   * Заявок              - Число  - заявок в отборе.
//   * ФайловОчищено       - Число  - файлов с очищенным кэшем текста.
//   * СтрокУдалено        - Число  - строк очереди удалено.
//   * ПропущеноОбработки  - Число  - строк processing пропущено.
//   * Ошибок              - Число  - сбоев отдельных файлов и строк.
//   * ОстановленПоПределу - Булево - такт остановлен по пределу времени.
//   * Секунд              - Число  - длительность такта.
//
Функция НовыйИтогТакта()

	Итог = Новый Структура;
	Итог.Вставить("ДатаНачала", Дата(1, 1, 1));
	Итог.Вставить("ИсточникДаты", "");
	Итог.Вставить("Заявок", 0);
	Итог.Вставить("ФайловОчищено", 0);
	Итог.Вставить("СтрокУдалено", 0);
	Итог.Вставить("ПропущеноОбработки", 0);
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("ОстановленПоПределу", Ложь);
	Итог.Вставить("Секунд", 0);
	Возврат Итог;

КонецФункции

// Текст итога такта для записи recognition_cleanup_done.
//
// Параметры:
//  Итог - Структура - см. НовыйИтогТакта.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстИтогаТакта(Знач Итог)

	Возврат СтрШаблон(НСтр("ru = 'Очистка исполненных заявок НСИ: срез %1 (источник: %2),
		|заявок %3, файлов очищено %4, строк очереди удалено %5, пропущено processing %6,
		|ошибок %7, за %8 сек%9'"),
		Формат(Итог.ДатаНачала, "ДЛФ=D"), Итог.ИсточникДаты, ЧислоСтрокой(Итог.Заявок),
		ЧислоСтрокой(Итог.ФайловОчищено), ЧислоСтрокой(Итог.СтрокУдалено),
		ЧислоСтрокой(Итог.ПропущеноОбработки), ЧислоСтрокой(Итог.Ошибок),
		ЧислоСтрокой(Окр(Итог.Секунд)),
		?(Итог.ОстановленПоПределу, НСтр("ru = ', остановлен по пределу времени'"), ""));

КонецФункции

#КонецОбласти

#Область ОтборЗаявок

// Множество навигационных ссылок исполненных и закрытых заявок НСИ (спека п. 2) -
// тот же формат, что пишут в ar_Владелец оба писателя очереди. Один запрос на запуск.
//
// Параметры:
//  ДатаНачала - Дата - нормализованная дата среза, отбор по дате документа.
//
// Возвращаемое значение:
//  Соответствие - ключи - навигационные ссылки заявок, значения - Истина.
//
Функция СсылкиИсполненныхЗаявок(Знач ДатаНачала)

	Множество = Новый Соответствие;

	Запрос = Новый Запрос(ТекстЗапросаИсполненныхЗаявок());
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Множество.Вставить(ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка), Истина);
	КонецЦикла;

	Возврат Множество;

КонецФункции

// Условие «исполнена или закрыта» из РегистрСведений.бит_СтатусыОбъектов - то же
// определение, что в ar_ПакетПрисоединённыеФайлы.ТекстСекцииКандидатов
// (agentrunner-220): ВидСтатуса = Статус, статус ЗаявкаНаИзменение_Исполнена
// либо Закрыт (отдельного статуса «Исполнено» у части заявок нет).
//
// Возвращаемое значение:
//  Строка - условия соединения со Статусы (псевдоним таблицы заявок - Заявка).
//
Функция УсловиеИсполненнойЗаявки()

	Возврат "Статусы.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.бит_ВидыСтатусовОбъектов.Статус)
		|	И Статусы.Статус В (ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена),
		|		ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.Закрыт))";

КонецФункции

// Текст запроса исполненных и закрытых заявок не раньше даты среза.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаИсполненныхЗаявок()

	Возврат "ВЫБРАТЬ
		|	Заявка.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК Статусы
		|		ПО Заявка.Ссылка = Статусы.Объект
		|			И " + УсловиеИсполненнойЗаявки() + "
		|ГДЕ
		|	Заявка.Дата >= &ДатаНачала";

КонецФункции

#КонецОбласти

#Область ПроходОчереди

// Проход очереди порциями по ключевому курсору ar_Файл (индексированное измерение):
// строка удаляется, если владелец - заявка из отбора и статус не processing.
// Строки processing не трогаются и считаются в «пропущено» (спека п. 5); их файлы
// запоминаются в ФайлыВРаботе и в проходе файлов не очищаются - иначе воркер
// допишет текст после очистки.
//
// Параметры:
//  МножествоЗаявок - Соответствие - см. СсылкиИсполненныхЗаявок.
//  ОкончаниеМс     - Число        - предел времени такта (мс, универсальная дата).
//  Итог            - Структура    - см. НовыйИтогТакта; поля ПропущеноОбработки,
//                    СтрокУдалено, Ошибок, ОстановленПоПределу изменяются.
//
// Возвращаемое значение:
//  Соответствие - файлы в работе: ключи - навигационные ссылки файлов,
//                 значения - Истина.
//
Функция ОчиститьОчередь(Знач МножествоЗаявок, Знач ОкончаниеМс, Итог)

	ФайлыВРаботе = Новый Соответствие;

	Запрос = Новый Запрос(ТекстЗапросаПорцииОчереди());
	ПоследнийФайл = "";

	Пока Истина Цикл

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= ОкончаниеМс Тогда
			Итог.ОстановленПоПределу = Истина;
			Прервать;
		КонецЕсли;

		Запрос.УстановитьПараметр("ПоследнийФайл", ПоследнийФайл);
		Выборка = Запрос.Выполнить().Выбрать();

		Обработано = 0;
		Пока Выборка.Следующий() Цикл
			Обработано = Обработано + 1;
			// Курсор двигается по всем строкам порции: удаленные и чужие строки
			// в следующую порцию не попадут (аргумент ar_Файл > &ПоследнийФайл).
			ПоследнийФайл = Выборка.ar_Файл;

			Если МножествоЗаявок.Получить(Выборка.ar_Владелец) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Выборка.ar_Статус = "processing" Тогда
				Итог.ПропущеноОбработки = Итог.ПропущеноОбработки + 1;
				ФайлыВРаботе.Вставить(Выборка.ar_Файл, Истина);
				Продолжить;
			КонецЕсли;

			Попытка
				УдалитьСтрокуОчереди(Выборка.ar_Файл);
				Итог.СтрокУдалено = Итог.СтрокУдалено + 1;
			Исключение
				// Сбой одной строки не прерывает такт (спека п. 7).
				Итог.Ошибок = Итог.Ошибок + 1;
				ЗаписатьСбойФайла(Выборка.ar_Файл,
					НСтр("ru = 'удаление строки очереди'"), ИнформацияОбОшибке());
			КонецПопытки;
		КонецЦикла;

		Если Обработано < РазмерПорцииОчереди() Тогда
			// Неполная порция - записей больше нет.
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат ФайлыВРаботе;

КонецФункции

// Удаление всех строк одного файла пустым набором записей с отбором по
// ar_Файл - как ar_ОчередьРаспознавания.УдалитьЗакрытыеСтарше.
//
// Параметры:
//  СсылкаФайла - Строка - навигационная ссылка файла (значение ar_Файл).
//
Процедура УдалитьСтрокуОчереди(Знач СсылкаФайла)

	НаборЗаписей = РегистрыСведений.ar_ОчередьРаспознавания.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ar_Файл.Использование = Истина;
	НаборЗаписей.Отбор.ar_Файл.Значение = СсылкаФайла;
	НаборЗаписей.Записать();

КонецПроцедуры

// Текст запроса порции очереди. Число - в тексте: ПЕРВЫЕ не принимает параметр
// (прием ar_ОбслуживаниеСлужебныхДанных.ТекстЗапросаПорцииСессий). Без сортировки
// по неиндексированным полям - упорядочивание только по курсору ar_Файл.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаПорцииОчереди()

	Возврат СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1
		|	Т.ar_Файл КАК ar_Файл,
		|	Т.ar_Владелец КАК ar_Владелец,
		|	Т.ar_Статус КАК ar_Статус
		|ИЗ
		|	РегистрСведений.ar_ОчередьРаспознавания КАК Т
		|ГДЕ
		|	Т.ar_Файл > &ПоследнийФайл
		|УПОРЯДОЧИТЬ ПО
		|	Т.ar_Файл", Формат(РазмерПорцииОчереди(), "ЧГ=0"));

КонецФункции

#КонецОбласти

#Область ОчисткаФайлов

// Проход файлов исполненных заявок порциями по ключевому курсору Ссылка: у файлов
// со статусом «Извлечен» кэш текста очищается, у файлов из ФайлыВРаботе - нет
// (спека п. 4, 5). Пропущенные по ошибке файлы остаются «Извлечен» и подхватываются
// следующим запуском - курсор двигается по всем строкам порции.
//
// Параметры:
//  ФайлыВРаботе - Соответствие - файлы в работе воркера (см. ОчиститьОчередь).
//  ДатаНачала   - Дата        - нормализованная дата среза.
//  ОкончаниеМс  - Число       - предел времени такта (мс, универсальная дата).
//  Итог         - Структура   - см. НовыйИтогТакта; поля ФайловОчищено, Ошибок,
//                 ОстановленПоПределу изменяются.
//
Процедура ОчиститьФайлы(Знач ФайлыВРаботе, Знач ДатаНачала, Знач ОкончаниеМс, Итог)

	Запрос = Новый Запрос(ТекстЗапросаПорцииФайлов());
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ПоследняяСсылка = Справочники.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы.ПустаяСсылка();

	Пока Истина Цикл

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= ОкончаниеМс Тогда
			Итог.ОстановленПоПределу = Истина;
			Прервать;
		КонецЕсли;

		Запрос.УстановитьПараметр("ПоследняяСсылка", ПоследняяСсылка);
		Выборка = Запрос.Выполнить().Выбрать();

		Обработано = 0;
		Пока Выборка.Следующий() Цикл
			Обработано = Обработано + 1;
			ПоследняяСсылка = Выборка.Ссылка;

			Если ФайлыВРаботе.Получить(ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка)) <> Неопределено Тогда
				// Файл в работе воркера RAGU/S.Docster - очистится следующим запуском.
				Продолжить;
			КонецЕсли;

			ТекстОшибки = "";
			Если НЕ ОчиститьФайл(Выборка.Ссылка, ТекстОшибки) Тогда
				// Сбой одного файла не прерывает такт (спека п. 7).
				Итог.Ошибок = Итог.Ошибок + 1;
				ЗаписатьСбойФайла(Выборка.Ссылка, НСтр("ru = 'очистка кэша текста'"), ТекстОшибки);
			Иначе
				Итог.ФайловОчищено = Итог.ФайловОчищено + 1;
			КонецЕсли;
		КонецЦикла;

		Если Обработано < РазмерПорцииФайлов() Тогда
			// Неполная порция - файлов больше нет.
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Очистка кэша текста одного файла по образцу
// ar_ПакетПрисоединённыеФайлы.ЗаписатьТекстФайла: отдельная транзакция на файл,
// управляемая блокировка по ссылке + ЗаблокироватьДанныеДляРедактирования,
// запись ОбновлениеИнформационнойБазы.ЗаписатьДанные (без бизнес-логики и
// подписок, в том числе выгрузки в MinIO). Файл (двоичные данные, том,
// sd_СсылкаMinio) не меняется. Пустой статус после очистки - решение человека
// (спека В1).
//
// Параметры:
//  ФайлСсылка  - ЛюбаяСсылка - файл, у которого очищается кэш текста.
//  ТекстОшибки - Строка      - очищенный текст ошибки при неудаче (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если кэш очищен.
//
Функция ОчиститьФайл(Знач ФайлСсылка, ТекстОшибки)

	Очищено = Ложь;
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(ФайлСсылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НачатьТранзакцию();
		Попытка
			БлокировкаДанных.Заблокировать();
			ЗаблокироватьДанныеДляРедактирования(ФайлСсылка);
			ОбъектФайла = ФайлСсылка.ПолучитьОбъект();
			ОбъектФайла.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.ПустаяСсылка();
			ОбъектФайла.ТекстХранилище = Новый ХранилищеЗначения("");
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ОбъектФайла);
			Очищено = Истина;
			// ЗафиксироватьТранзакцию - последний оператор попытки: после него
			// откат уже невозможен.
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		// Блокировка занята либо ошибка записи - сбой одного файла, такт
		// продолжается (спека п. 7).
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Очищено;

КонецФункции

// Текст запроса порции файлов. Условие отбора заявок повторяется соединениями
// (не параметром-списком ссылок - спека п. 2, 4): владелец файла - заявка не
// раньше даты среза с терминальным статусом. Условие Ссылка > &ПоследняяСсылка -
// ключевой курсор: файлы, пропущенные в порции (ошибки, processing), остаются
// «Извлечен» и без курсора выбирались бы снова - такт крутился бы на одной
// порции до предела времени. Упорядочивание по Ссылка - под курсор.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаПорцииФайлов()

	Возврат СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1
		|	Ф.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Ф
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявка
		|		ПО Ф.ВладелецФайла = Заявка.Ссылка
		|			И Заявка.Дата >= &ДатаНачала
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК Статусы
		|		ПО Заявка.Ссылка = Статусы.Объект
		|			И %2
		|ГДЕ
		|	Ф.Ссылка > &ПоследняяСсылка
		|	И Ф.СтатусИзвлеченияТекста = ЗНАЧЕНИЕ(Перечисление.СтатусыИзвлеченияТекстаФайлов.Извлечен)
		|УПОРЯДОЧИТЬ ПО
		|	Ф.Ссылка", Формат(РазмерПорцииФайлов(), "ЧГ=0"), УсловиеИсполненнойЗаявки());

КонецФункции

#КонецОбласти

#Область ДатаНачалаОбработки

// Разбор значения настройки НСИДатаНачалаОбработкиЗаявок - копия
// ar_ПакетНСИ.РазборДатыНачалаОбработкиЗаявок (agentrunner-41, agentrunner-202):
// функция пакета приватная, во внешней обработке переносится копией (спека п. 3).
// Тип Дата - как есть; строка «ДД.ММ.ГГГГ» или «ГГГГММДД» - разбор; пусто/нет
// настройки - дефолт 01.11.2026 без записи в журнал; неразборчиво - дефолт и
// запись «Предупреждение» (корень инцидента 2c8c5f3b).
//
// Возвращаемое значение:
//  Структура:
//   * Дата     - Дата   - применяемая дата начала (без нормализации к началу дня).
//   * Источник - Строка - "setting" (значение настройки), "default" (настройки
//                нет или пусто) либо "invalid" (значение не распознано).
//
Функция РазборДатыНачалаОбработкиЗаявок()

	ИменаПолей = "Дата, Источник";
	Дефолт = Дата(2026, 11, 1);

	Значение = ar_Настройки.ЗначениеНастройки("НСИДатаНачалаОбработкиЗаявок", Неопределено);

	Если Значение = Неопределено Тогда
		// Ключа нет, настройка выключена либо это настройка-список.
		Возврат Новый Структура(ИменаПолей, Дефолт, "default");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Новый Структура(ИменаПолей, Значение, "setting");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
		Если ПустаяСтрока(Текст) Тогда
			Возврат Новый Структура(ИменаПолей, Дефолт, "default");
		КонецЕсли;
		Результат = ДатаИзСтрокиНачала(Текст);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Новый Структура(ИменаПолей, Результат, "setting");
		КонецЕсли;
	КонецЕсли;

	// Значение есть, но даты из него не получилось.
	ТекстЖурнала = СтрШаблон(НСтр("ru = 'Настройка НСИДатаНачалаОбработкиЗаявок не содержит даты:
		|значение «%1» (тип %2), применена дата по умолчанию 01.11.2026.'"),
		Строка(Значение), Строка(ТипЗнч(Значение)));
	ar_СлужебныйЛог.Записать(ИсточникЛога(), СобытиеНеДаты(), ТекстЖурнала, "Предупреждение");

	Возврат Новый Структура(ИменаПолей, Дефолт, "invalid");

КонецФункции

// Дата из строкового значения настройки - копия ar_ПакетНСИ.ДатаИзСтрокиНачала:
// «ДД.ММ.ГГГГ» через БСП СтроковыеФункцииКлиентСервер.СтрокаВДату; строка из
// ровно 8 цифр («ГГГГММДД») - платформенным Дата(). Не разобралось - пустая дата.
//
// Параметры:
//  Текст - Строка - непустое строковое значение настройки.
//
// Возвращаемое значение:
//  Дата - разобранная дата либо пустая.
//
Функция ДатаИзСтрокиНачала(Знач Текст)

	Результат = СтроковыеФункцииКлиентСервер.СтрокаВДату(Текст);
	Если Не ЗначениеЗаполнено(Результат)
		И СтрДлина(Текст) = 8
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
		Попытка
			Результат = Дата(Текст);
		Исключение
			Результат = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебноеВЖурнал

// Запись сбоя одного файла или строки очереди в ar_СлужебныйЛог (спека п. 7):
// event recognition_cleanup_file_failed, уровень «Предупреждение», ссылка на
// файл и очищенный текст ошибки. Best-effort: ar_СлужебныйЛог.Записать ошибки
// не бросает.
//
// Параметры:
//  Файл         - Строка, ЛюбаяСсылка - файл (навигационная ссылка либо ссылка).
//  Что          - Строка              - какая операция не удалась.
//  Ошибка       - Строка, ИнформацияОбОшибке - текст ошибки либо информация об ней.
//
Процедура ЗаписатьСбойФайла(Знач Файл, Знач Что, Знач Ошибка)

	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка));
	Иначе
		ТекстОшибки = Ошибка;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИсточникЛога(), СобытиеСбояФайла(),
		СтрШаблон(НСтр("ru = '%1: %2'"), Что, ТекстОшибки), "Предупреждение", , Файл);

КонецПроцедуры

#КонецОбласти

