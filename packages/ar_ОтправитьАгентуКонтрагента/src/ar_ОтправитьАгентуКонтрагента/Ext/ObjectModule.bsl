#Область ПрограммныйИнтерфейс

// Пакет инструментов AgentRunner «Отправить агенту контрагента» (задача
// agentrunner-453, первое прикладное применение ядра командного запуска
// agentrunner-436). Все в одной обработке:
//   * команда "ar_ОтправитьАгенту" («Отправить агенту») для карточек и списков
//     контрагентов - ставит предмет в очередь ядра командных подписок
//     (ar_ЗапросыАгентам.Отправить с явным агентом «Вложения контрагента
//     на почту»), агент отправляет присоединенные файлы контрагента письмом
//     инициатору запуска;
//   * инструмент counterparty_send_files - отправка письма с вложениями на
//     почту инициатора командного запуска (адрес модель не передает:
//     получатель всегда инициатор, по Контекст.RunId из РегистрСведений.ar_Запуски).
//
// Регистрация в БСП «Дополнительные отчеты и обработки»: вид =
// ЗаполнениеОбъекта (1.0.1, приёмка agentrunner-453: в БИТ команды назначенных
// обработок попадают в формы объектов только у этого вида - подменю «Заполнить»
// карточки и списка; у ДополнительнаяОбработка кнопки в форме нет, факт verify
// agentrunner-436), назначение Справочник.Контрагенты, БезопасныйРежим =
// Ложь (иначе ar_ЗапросыАгентам.Отправить вернет unsafe_mode; решение человека
// 2026-10-01 по пакетам - ядро пишет предупреждение package_registered_unsafe_mode).
// Команда с Идентификатор = "ar_ToolPack" - маркер принадлежности пакета
// AgentRunner (см. .docs/Контракт-пакета-tools.md 1.2): ядро отбирает кандидатов
// на регистрацию запросом к ТЧ Команды, вид обработки не проверяется.
//
// Манифест - схема 2 (русские ключи). Уровень риска counterparty_send_files -
// «Запись» без подтверждения с обоснованием (спека agentrunner-453 п.1):
// письмо уходит только инициатору запуска на адрес из его контактной
// информации, данные ИБ не изменяются.
//
// Латиницей - только внешний протокол: имя инструмента counterparty_send_files,
// ключи JSON (files, comment, status, to, ref, name, size, total_size, limit),
// коды ошибок. Имена процедур, переменных и тексты - по-русски.
//
// Исполнение: весь код - серверный (ВызовСерверногоМетода); привилегированный
// режим поднимается точечно с парным сбросом (чтение ar_Запуски, ar_Агенты,
// отправка письма - реквизиты УЗ под RLS).

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки» (см. .docs/Контракт-пакета-tools.md 1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиЗаполнениеОбъекта();
	// 1.0.2 - обработчик ВыполнитьКоманду под два контракта БСП: назначаемый
	// вызов (ИдентификаторКоманды, ОбъектыНазначения, ПараметрыКоманды) -
	// кнопка в «Заполнить»; вызов из карточки обработки - (ИдентификаторКоманды,
	// ПараметрыКоманды). Раньше было два параметра - назначаемый вызов падал
	// «Слишком много фактических параметров».
	// 1.0.1 - вид регистрации ЗаполнениеОбъекта вместо ДополнительнаяОбработка
	// (приёмка agentrunner-453): команда «Отправить агенту» появляется в подменю
	// «Заполнить» карточки контрагента (в списке - «Дополнительные обработки
	// заполнения...»). Побочно в «Заполнить» виден и маркер ar_ToolPack.
	// 1.0.0 - первая версия (agentrunner-453): команда «Отправить агенту»
	// для контрагентов + инструмент counterparty_send_files.
	ПараметрыРегистрации.Версия = ВерсияПакета();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: отправить агенту контрагента'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Кнопка «Отправить агенту» в карточке контрагента ставит его в очередь агента,
		|и пакет инструментов counterparty_send_files: агент отправляет присоединённые файлы контрагента
		|письмом на почту пользователя, нажавшего кнопку.'");
	// Ядро командного запуска отказывает в безопасном режиме (unsafe_mode).
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Назначение.Добавить("Справочник.Контрагенты");

	КомандаМаркера = ПараметрыРегистрации.Команды.Добавить();
	КомандаМаркера.Представление = НСтр("ru = 'Служебная: маркер пакета AgentRunner (не нажимать)'");
	КомандаМаркера.Идентификатор = "ar_ToolPack";
	КомандаМаркера.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаМаркера.ПоказыватьОповещение = Ложь;

	КомандаОтправки = ПараметрыРегистрации.Команды.Добавить();
	КомандаОтправки.Представление = НСтр("ru = 'Отправить агенту'");
	КомандаОтправки.Идентификатор = "ar_ОтправитьАгенту";
	КомандаОтправки.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаОтправки.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Версия пакета - одна для регистрации обработки (СведенияОВнешнейОбработке)
// и манифеста (ar_ОписаниеИнструментов), правило «версия регистрации =
// версия манифеста» (решение человека, agentrunner-213).
//
// Возвращаемое значение:
//  Строка - версия пакета.
//
Функция ВерсияПакета()

	Возврат "1.0.2";

КонецФункции

// Обработчик команд БСП "Дополнительные отчеты и обработки" - два контракта
// вызова (см. ДополнительныеОтчетыИОбработки.ВыполнитьКоманду):
//   * назначаемая команда (вид ЗаполнениеОбъекта, кнопка в подменю
//     «Заполнить» формы контрагента) - (ИдентификаторКоманды,
//     ОбъектыНазначения[, ПараметрыКоманды]): ОбъектыНазначения - Массив ссылок
//     или Неопределено;
//   * команда из карточки обработки («Выполнить») - (ИдентификаторКоманды
//     [, ПараметрыКоманды]): Структура параметров приходит вторым параметром.
// Варианты различаются типом второго параметра и приводятся к общему виду.
// Команда "ar_ToolPack" - маркерная: интерактивный вызов не предусмотрен,
// обработчик только поясняет. Команда "ar_ОтправитьАгенту" ставит объекты
// назначения в очередь ядра командных подписок.
//
// Параметры:
//  ИдентификаторКоманды         - Строка - идентификатор вызванной команды.
//  ОбъектыНазначения            - Массив, Неопределено, Структура - ссылки
//                                 назначения (назначаемый вызов) либо Структура
//                                 параметров команды (вызов из карточки).
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения = Неопределено, ПараметрыВыполненияКоманды = Неопределено) Экспорт

	Если ТипЗнч(ОбъектыНазначения) = Тип("Структура") Тогда
		// Вызов из карточки обработки: второй параметр - структура параметров.
		ПараметрыВыполненияКоманды = ОбъектыНазначения;
		ОбъектыНазначения = Неопределено;
	КонецЕсли;

	Объекты = Новый Массив;
	Если ОбъектыНазначения <> Неопределено Тогда
		Объекты = ОбъектыНазначения;
	ИначеЕсли ПараметрыВыполненияКоманды <> Неопределено
		И ПараметрыВыполненияКоманды.Свойство("ОбъектыНазначения") Тогда
		Объекты = ПараметрыВыполненияКоманды.ОбъектыНазначения;
	КонецЕсли;

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ОтправитьАгентуКонтрагента.ВыполнитьКоманду", "counterparty_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,
				|прикладного действия по этой команде не предусмотрено.'"));
	ИначеЕсли ИдентификаторКоманды = "ar_ОтправитьАгенту" Тогда
		ВыполнитьКомандуОтправкиАгенту(Объекты);
	Иначе
		ar_СлужебныйЛог.Записать("ar_ОтправитьАгентуКонтрагента.ВыполнитьКоманду", "counterparty_command_unknown",
			ИдентификаторКоманды, "Предупреждение");
	КонецЕсли;

КонецПроцедуры

// Манифест пакета инструментов - контракт AgentRunner, схема 2 (см.
// .docs/Контракт-пакета-tools.md 1.4). Вызывается ядром при регистрации/
// переподтверждении пакета.
//
// Возвращаемое значение:
//  Структура - манифест пакета:
//   * ВерсияСхемы, ПространствоИмен, Версия, Категории, Инструменты, Настройки.
//
Функция ar_ОписаниеИнструментов() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("ВерсияСхемы", 2);
	Манифест.Вставить("ПространствоИмён", "counterparty");
	// 1.0.2 - подпись ВыполнитьКоманду под назначаемый вызов БСП (3 параметра).
	// 1.0.1 - вид регистрации ЗаполнениеОбъекта (приёмка agentrunner-453).
	// 1.0.0 - первая версия (agentrunner-453).
	Манифест.Вставить("Версия", ВерсияПакета());

	Категория = Новый Структура;
	Категория.Вставить("Имя", "files");
	Категория.Вставить("Представление", НСтр("ru = 'Присоединённые файлы'"));
	Категория.Вставить("ОписаниеДляLLM",
		НСтр("ru = 'Файлы контрагента: список (files_list пакета присоединённых файлов) и отправка на почту инициатора запуска'"));
	Категория.Вставить("Порядок", 2);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаОтправкиФайлов());
	Манифест.Вставить("Инструменты", Инструменты);

	Манифест.Вставить("Настройки", ОписанияНастроекПакета());

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md 1.6). Диспетчеризация по имени, без
// Выполнить()/Вычислить().
//
// Параметры:
//  ИмяTool       - Строка    - полное имя инструмента ("counterparty_send_files").
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащенный ядром
//                  системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = "counterparty_send_files" Тогда
		Возврат ВыполнитьОтправкуФайлов(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаИнструмента("unknown_tool");
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КомандаОтправкиАгенту

// Команда «Отправить агенту»: ставит объекты назначения в очередь ядра
// командных подписок с явным агентом «Вложения контрагента на почту» - чтобы
// не будить другие командные подписки на Справочник.Контрагенты (спека
// agentrunner-453 п.2). Агент не настроен - сообщение пользователю, в очередь
// ничего не ставится. Итоги ядра - по строке в сообщение.
//
// Параметры:
//  Объекты - Массив из ЛюбаяСсылка - объекты назначения команды.
//
Процедура ВыполнитьКомандуОтправкиАгенту(Знач Объекты)

	Агент = АгентВложенийКонтрагента();
	Если Агент.Пустая() Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Агент «%1» не настроен: обратитесь к администратору.'"),
			НаименованиеАгентаПакета());
		Сообщить(ТекстСообщения);
		Возврат;
	КонецЕсли;

	Результат = ar_ЗапросыАгентам.Отправить(Объекты, Новый Структура("Агент", Агент));
	Для Каждого Итог Из Результат Цикл
		Сообщить(Итог.Текст);
	КонецЦикла;

КонецПроцедуры

// Элемент справочника ar_Агенты для команды «Отправить агенту» (константа
// модуля - наименование агента из пресета задачи). Чтение - привилегированно
// с парным сбросом: у нажимающего кнопку может не быть прав на ar_Агенты.
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты - агент; пустая ссылка, если не найден.
//
Функция АгентВложенийКонтрагента()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Агенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.Наименование = &Наименование
		|	И НЕ Агенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", НаименованиеАгентаПакета());

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ar_Агенты.ПустаяСсылка();

КонецФункции

// Наименование агента пресета «Вложения контрагента на почту» - константа
// модуля (совпадает с именем в preset/ВложенияКонтрагентаНаПочту.json).
//
// Возвращаемое значение:
//  Строка - наименование агента.
//
Функция НаименованиеАгентаПакета()

	Возврат НСтр("ru = 'Вложения контрагента на почту'");

КонецФункции

#КонецОбласти

#Область ОписаниеИнструментов

// Описание инструмента counterparty_send_files для манифеста пакета.
// УровеньРиска = «Запись» без подтверждения с обоснованием (ядро проверяет
// непустой ОбоснованиеЗаписиБезПодтверждения): письмо уходит только
// инициатору запуска, данные ИБ не изменяются.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаОтправкиФайлов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "counterparty_send_files");
	Описание.Вставить("Описание",
		НСтр("ru = 'Отправляет присоединённые файлы контрагента одним письмом на почту инициатора запуска
			|(получатель не задаётся аргументом). Файлы передаются навигационными ссылками из ответа files_list;
			|не больше 20 файлов, суммарный размер - не больше лимита пакета (превышение - отправляйте частями,
			|несколькими вызовами).'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Файлы контрагента письмом инициатору запуска'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовОтправкиФайлов());
	Описание.Вставить("УровеньРиска", "Запись");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'agentrunner-453 (решение человека 17.11.2026): письмо уходит только инициатору запуска
			|на адрес из его контактной информации, данные ИБ не изменяются.'"));
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов counterparty_send_files в OpenAI tool-format:
// files (массив ref, обязательный) и comment (строка, необязательный).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовОтправкиФайлов()

	СвойствоСтроки = Новый Структура;
	СвойствоСтроки.Вставить("type", "string");

	СвойствоФайлов = Новый Структура;
	СвойствоФайлов.Вставить("type", "array");
	СвойствоФайлов.Вставить("items", СвойствоСтроки);
	СвойствоФайлов.Вставить("description",
		НСтр("ru = 'Навигационные ссылки e1cib/data/... на присоединённые файлы контрагента (ref из ответа
			|files_list). От 1 до 20 за вызов.'"));

	СвойствоКомментария = Новый Структура;
	СвойствоКомментария.Вставить("type", "string");
	СвойствоКомментария.Вставить("description",
		НСтр("ru = 'Необязательный комментарий - добавляется в текст письма перед списком файлов.'"));

	Свойства = Новый Структура;
	Свойства.Вставить("files", СвойствоФайлов);
	Свойства.Вставить("comment", СвойствоКомментария);

	Обязательные = Новый Массив;
	Обязательные.Добавить("files");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("counterparty_send_files",
		НСтр("ru = 'Отправить файлы контрагента письмом инициатору запуска.'"), Параметры);

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
//
// Параметры:
//  Имя       - Строка    - полное имя инструмента (с пространством имен).
//  Описание  - Строка    - человекочитаемое описание инструмента для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, ...}).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)

	ОписаниеФункции = Новый Структура;
	ОписаниеФункции.Вставить("name", Имя);
	ОписаниеФункции.Вставить("description", Описание);
	ОписаниеФункции.Вставить("parameters", Параметры);

	ОберткаФормата = Новый Структура;
	ОберткаФормата.Вставить("type", "function");
	ОберткаФормата.Вставить("function", ОписаниеФункции);
	Возврат ar_JSON.ВЗначениеJSON(ОберткаФормата);

КонецФункции

// Настройки пакета (создаются ядром при регистрации, ключи - глобальные в
// ar_Настройки, поэтому с приставкой пакета).
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписанияНастроекПакета()

	Настройки = Новый Массив;

	Настройки.Добавить(ОписаниеНастройки("КонтрагентФайлыМаксимальныйРазмерВложенийМБ",
		НСтр("ru = 'Контрагент: максимальный размер вложений письма, МБ'"),
		НСтр("ru = 'Суммарный размер файлов одного вызова counterparty_send_files. Превышение - ошибка
			|attachments_too_large: агент отправляет файлы частями, несколькими вызовами.'"),
		20));

	Возврат Настройки;

КонецФункции

// Элемент массива Настройки манифеста.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (глобальный в ar_Настройки).
//  Наименование        - Строка - наименование для администратора.
//  Описание            - Строка - описание настройки.
//  ЗначениеПоУмолчанию - Строка, Число, Булево, Дата - значение по умолчанию.
//
// Возвращаемое значение:
//  Структура - {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	Настройка = Новый Структура;
	Настройка.Вставить("Ключ", Ключ);
	Настройка.Вставить("Наименование", Наименование);
	Настройка.Вставить("Описание", Описание);
	Настройка.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Возврат Настройка;

КонецФункции

#КонецОбласти

#Область ИнструментОтправкиФайлов

// Реализация инструмента counterparty_send_files (спека agentrunner-453 п.1).
// Порядок: адресат (инициатор по RunId, серверно) -> файлы (только ref из
// files_list, владелец = предмет запуска) -> DryRun (план без отправки) ->
// лимит размера по реквизиту Размер (до чтения двоичных данных) -> письмо
// с вложениями инициатору. Ошибки аргументов - не терминальные, с кодом,
// причиной и допустимыми значениями.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"files": [...], "comment": "..."}.
//  Контекст      - Структура - контекст запуска (RunId, ...); может быть
//                  Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {"status":"sent","to",...,"files":[{ref,name,size}],
//  "total_size"} либо {"error": код, [детали]}.
//
Функция ВыполнитьОтправкуФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Комментарий = "";
	Если Аргументы.Получить("comment") <> Неопределено Тогда
		Комментарий = Аргументы.Получить("comment");
		Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда
			Возврат ОшибкаИнструмента("invalid_comment");
		КонецЕсли;
	КонецЕсли;

	// Получатель - инициатор командного запуска: адрес модель не передает.
	Шапка = ШапкаЗапуска(RunIdИзКонтекста(Контекст));
	Если Не ЗначениеЗаполнено(Шапка.Пользователь) Тогда
		Возврат ОшибкаИнструмента("no_initiator");
	КонецЕсли;
	АдресПочты = ar_Уведомления.EmailПользователя(Шапка.Пользователь);
	Если ПустаяСтрока(АдресПочты) Тогда
		Возврат ОшибкаИнструмента("no_recipient_email");
	КонецЕсли;

	Выборка = ВыбратьФайлыОтправки(Аргументы, Шапка.Предмет);
	Если Выборка.Отказ Тогда
		Возврат Выборка.ОтветJSON;
	КонецЕсли;

	// DryRun: после проверок аргументов и до чтения двоичных данных -
	// ничего не читаем и не отправляем, возвращаем план.
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("counterparty_send_files",
			ПланОтправки(АдресПочты, Выборка.Свойства));
	КонецЕсли;

	// Лимит вложений - до чтения двоичных данных (по реквизиту Размер).
	ЛимитБайт = ЛимитВложенийМБ() * 1024 * 1024;
	Если Выборка.СуммарныйРазмер > ЛимитБайт Тогда
		Детали = Новый Структура("total_size, limit", Выборка.СуммарныйРазмер, ЛимитБайт);
		Возврат ОшибкаИнструментаСДеталями("attachments_too_large", Детали);
	КонецЕсли;

	ДвоичныеДанные = ДвоичныеДанныеВложений(Выборка.Свойства);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ОшибкаИнструментаСДеталями("send_failed",
			Новый Структура("reason", НСтр("ru = 'двоичные данные файла не прочитаны'")));
	КонецЕсли;

	ВыборУЗ = УчетнаяЗаписьОтправки();
	Если ВыборУЗ.Ссылка = Неопределено Тогда
		Возврат ОшибкаИнструмента("no_email_account");
	КонецЕсли;

	ИтогОтправки = ОтправитьПисьмоСФайлами(ВыборУЗ, АдресПочты, Шапка.Пользователь,
		Шапка.Предмет, Комментарий, Выборка.Свойства, ДвоичныеДанные);
	Если Не ИтогОтправки.Отправлено Тогда
		Возврат ИтогОтправки.ОтветJSON;
	КонецЕсли;

	Возврат ОтветОбОтправке(АдресПочты, Выборка.Свойства);

КонецФункции

// Шапка запуска по RunId (прецедент - ar_ИнструментыВзаимодействие.
// ШапкаЗапускаДляПравила): предмет и инициатор из РегистрСведений.ar_Запуски.
// Чтение - привилегированно с парным сбросом: у сеанса запуска может не быть
// прав на регистр.
//
// Параметры:
//  RunId - Строка - идентификатор запуска из контекста инструмента.
//
// Возвращаемое значение:
//  Структура - {Предмет: ЛюбаяСсылка, Неопределено; Пользователь:
//  СправочникСсылка.Пользователи}.
//
Функция ШапкаЗапуска(Знач RunId)

	Результат = Новый Структура("Предмет, Пользователь", Неопределено,
		Справочники.Пользователи.ПустаяСсылка());

	Если ТипЗнч(RunId) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(RunId)) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_Предмет КАК Предмет,
		|	Запуски.ar_ПользовательРеф КАК Пользователь
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId";
	Запрос.УстановитьПараметр("RunId", СокрЛП(RunId));

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Результат.Предмет = Выборка.Предмет;
		Результат.Пользователь = Выборка.Пользователь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выбирает и проверяет файлы отправки: массив files (ref из files_list)
// разбирается в ссылки КонтрагентыПрисоединенныеФайлы, свойства читаются одним
// запросом; каждый файл должен существовать, не быть помеченным на удаление,
// не быть зашифрованным и принадлежать предмету запуска (ВладелецФайла).
// Отказ - с кодом, именем файла и списком допустимых ref (файлы предмета).
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//  Предмет   - ЛюбаяСсылка, Неопределено - предмет запуска.
//
// Возвращаемое значение:
//  Структура:
//   * Отказ          - Булево - Истина при ошибке (ОтветJSON заполнен).
//   * ОтветJSON      - Строка - ответ-отказ.
//   * Свойства       - Соответствие - Ссылка -> Структура {Наименование,
//                     Расширение, Размер, Зашифрован, ПометкаУдаления, ВладелецФайла}.
//   * СуммарныйРазмер - Число - сумма Размер по выбранным файлам, байт.
//
Функция ВыбратьФайлыОтправки(Знач Аргументы, Знач Предмет)

	Результат = Новый Структура("Отказ, ОтветJSON, Свойства, СуммарныйРазмер",
		Ложь, "", Новый Соответствие, 0);

	СписокРефов = Аргументы.Получить("files");
	Если ТипЗнч(СписокРефов) <> Тип("Массив") Или СписокРефов.Количество() = 0 Тогда
		Результат.Отказ = Истина;
		Результат.ОтветJSON = ОшибкаИнструментаСДеталями("invalid_files",
			Новый Структура("reason", НСтр("ru = 'files - обязательный массив ref из ответа files_list'")));
		Возврат Результат;
	КонецЕсли;

	Если СписокРефов.Количество() > 20 Тогда
		Результат.Отказ = Истина;
		Результат.ОтветJSON = ОшибкаИнструментаСДеталями("too_many_files",
			Новый Структура("count, limit", СписокРефов.Количество(), 20));
		Возврат Результат;
	КонецЕсли;

	// Разбор ref с дедупликацией (модель могла передать одну ссылку дважды);
	// любой неразобранный или чужого типа ref - отказ всего набора со списком
	// допустимых ref: частичная отправка была бы «успешным» ответом с молча
	// потерянным файлом (правило AGENTS.md - «Аргументы модели»: ядро отсекает
	// повтор только неудачного вызова).
	УникальныеСсылки = Новый Соответствие;
	Для Каждого Реф Из СписокРефов Цикл
		Ссылка = Неопределено;
		Если ТипЗнч(Реф) = Тип("Строка") Тогда
			Ссылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(Реф);
		КонецЕсли;
		Если Ссылка = Неопределено
			Или ТипЗнч(Ссылка) <> Тип("СправочникСсылка.КонтрагентыПрисоединенныеФайлы") Тогда
			Результат.Отказ = Истина;
			Результат.ОтветJSON = ОтветСДопустимымиФайлами("file_not_found", "", Предмет);
			Возврат Результат;
		КонецЕсли;
		УникальныеСсылки.Вставить(Ссылка, Истина);
	КонецЦикла;

	Ссылки = Новый Массив;
	Для Каждого Пара Из УникальныеСсылки Цикл
		Ссылки.Добавить(Пара.Ключ);
	КонецЦикла;

	Свойства = СвойстваФайловПоСсылкам(Ссылки);

	// Не найденные в базе файлы - отказ (запрос возвращает только существующие).
	Если Свойства.Количество() <> Ссылки.Количество() Тогда
		Результат.Отказ = Истина;
		Результат.ОтветJSON = ОтветСДопустимымиФайлами("file_not_found", "", Предмет);
		Возврат Результат;
	КонецЕсли;

	Проверка = ПроверитьФайлыОтправки(Свойства, Предмет);
	Если Проверка.Отказ Тогда
		Результат.Отказ = Истина;
		Результат.ОтветJSON = Проверка.ОтветJSON;
		Возврат Результат;
	КонецЕсли;

	Результат.Свойства = Свойства;
	Результат.СуммарныйРазмер = Проверка.СуммарныйРазмер;
	Возврат Результат;

КонецФункции

// Проверяет каждый файл отправки: не помечен на удаление, не зашифрован,
// владелец = предмет запуска (спека п.1 - агент не может отправить чужие файлы).
//
// Параметры:
//  Свойства - Соответствие - Ссылка -> Структура свойств файла.
//  Предмет  - ЛюбаяСсылка, Неопределено - предмет запуска.
//
// Возвращаемое значение:
//  Структура - {Отказ: Булево; ОтветJSON: Строка; СуммарныйРазмер: Число}.
//
Функция ПроверитьФайлыОтправки(Знач Свойства, Знач Предмет)

	Результат = Новый Структура("Отказ, ОтветJSON, СуммарныйРазмер", Ложь, "", 0);

	Для Каждого Пара Из Свойства Цикл
		СвойствоФайла = Пара.Значение;
		Если СвойствоФайла.ПометкаУдаления Тогда
			Результат.Отказ = Истина;
			Результат.ОтветJSON = ОшибкаИнструментаСДеталями("file_deleted",
				Новый Структура("file", СвойствоФайла.Наименование));
			Возврат Результат;
		КонецЕсли;
		Если СвойствоФайла.Зашифрован Тогда
			Результат.Отказ = Истина;
			Результат.ОтветJSON = ОшибкаИнструментаСДеталями("file_encrypted",
				Новый Структура("file", СвойствоФайла.Наименование));
			Возврат Результат;
		КонецЕсли;
		Если Предмет = Неопределено Или СвойствоФайла.ВладелецФайла <> Предмет Тогда
			Результат.Отказ = Истина;
			Результат.ОтветJSON = ОтветСДопустимымиФайлами("file_not_of_subject",
				СвойствоФайла.Наименование, Предмет);
			Возврат Результат;
		КонецЕсли;
		Результат.СуммарныйРазмер = Результат.СуммарныйРазмер + СвойствоФайла.Размер;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Свойства файлов по явному массиву ссылок одним запросом (файлы одного
// справочника). Ссылка в отборе - стандартный индекс справочника.
//
// Параметры:
//  СсылкиФайлов - Массив из СправочникСсылка.КонтрагентыПрисоединенныеФайлы.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Наименование, Расширение, Размер,
//  Зашифрован, ПометкаУдаления, ВладелецФайла}.
//
Функция СвойстваФайловПоСсылкам(Знач СсылкиФайлов)

	Свойства = Новый Соответствие;
	Если СсылкиФайлов.Количество() = 0 Тогда
		Возврат Свойства;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка,
		|	Файлы.Наименование КАК Наименование,
		|	Файлы.Расширение КАК Расширение,
		|	Файлы.Размер КАК Размер,
		|	Файлы.Зашифрован КАК Зашифрован,
		|	Файлы.ПометкаУдаления КАК ПометкаУдаления,
		|	Файлы.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	Справочник.КонтрагентыПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", СсылкиФайлов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СвойствоФайла = Новый Структура("Наименование, Расширение, Размер, Зашифрован, ПометкаУдаления, ВладелецФайла",
			Выборка.Наименование, Выборка.Расширение, Выборка.Размер, Выборка.Зашифрован,
			Выборка.ПометкаУдаления, Выборка.ВладелецФайла);
		Свойства.Вставить(Выборка.Ссылка, СвойствоФайла);
	КонецЦикла;

	Возврат Свойства;

КонецФункции

// Допустимые ref для ответов-отказов: не помеченные на удаление файлы
// предмета запуска. ВладелецФайла - стандартный индекс справочника файлов.
//
// Параметры:
//  Предмет - ЛюбаяСсылка, Неопределено - предмет запуска.
//
// Возвращаемое значение:
//  Массив из Строка - навигационные ссылки файлов предмета.
//
Функция СсылкиФайловПредмета(Знач Предмет)

	Ссылки = Новый Массив;
	Если Предмет = Неопределено Или Не ЗначениеЗаполнено(Предмет) Тогда
		Возврат Ссылки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтрагентыПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Предмет
		|	И НЕ Файлы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Предмет", Предмет);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка));
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// План отправки для DryRun-ответа: адресат, файлы и суммарный размер.
//
// Параметры:
//  АдресПочты    - Строка - адрес инициатора.
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Структура - {to, files: [{ref, name, size}], total_size}.
//
Функция ПланОтправки(Знач АдресПочты, Знач СвойстваФайлов)

	План = Новый Структура;
	План.Вставить("to", АдресПочты);
	План.Вставить("files", ЭлементыОтветаОФайлах(СвойстваФайлов));
	План.Вставить("total_size", СуммарныйРазмерФайлов(СвойстваФайлов));

	Возврат План;

КонецФункции

// Суммарный размер файлов отправки, байт.
//
// Параметры:
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Число - сумма по реквизиту Размер.
//
Функция СуммарныйРазмерФайлов(Знач СвойстваФайлов)

	СуммарныйРазмер = 0;
	Для Каждого Пара Из СвойстваФайлов Цикл
		СуммарныйРазмер = СуммарныйРазмер + Пара.Значение.Размер;
	КонецЦикла;

	Возврат СуммарныйРазмер;

КонецФункции

// Массив files ответа: ref, имя вложения и размер по свойствам файлов.
//
// Параметры:
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Массив из Структура - {ref, name, size}.
//
Функция ЭлементыОтветаОФайлах(Знач СвойстваФайлов)

	Элементы = Новый Массив;
	Для Каждого Пара Из СвойстваФайлов Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Пара.Ключ));
		Элемент.Вставить("name", ИмяВложенияФайла(Пара.Значение));
		Элемент.Вставить("size", Пара.Значение.Размер);
		Элементы.Добавить(Элемент);
	КонецЦикла;

	Возврат Элементы;

КонецФункции

// Имя файла-вложения: наименование с расширением (спека: Имя.Расширение);
// если наименование уже заканчивается расширением - без повтора.
//
// Параметры:
//  СвойствоФайла - Структура - {Наименование, Расширение, ...}.
//
// Возвращаемое значение:
//  Строка - имя файла-вложения.
//
Функция ИмяВложенияФайла(Знач СвойствоФайла)

	Наименование = СокрЛП(СвойствоФайла.Наименование);
	Расширение = СокрЛП(СвойствоФайла.Расширение);

	Если ПустаяСтрока(Наименование) Тогда
		Возврат "file";
	КонецЕсли;
	Если ПустаяСтрока(Расширение) Тогда
		Возврат Наименование;
	КонецЕсли;

	ОжидаемоеОкончание = "." + Расширение;
	Если СтрЗаканчиваетсяНа(НРег(Наименование), НРег(ОжидаемоеОкончание)) Тогда
		Возврат Наименование;
	КонецЕсли;
	Возврат Наименование + ОжидаемоеОкончание;

КонецФункции

// Текст письма: комментарий пользователя (если передан) и перечень файлов
// с размерами.
//
// Параметры:
//  Комментарий     - Строка - комментарий из аргументов инструмента.
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Строка - текст письма (простой текст).
//
Функция ТекстПисьмаОтправки(Знач Комментарий, Знач СвойстваФайлов)

	Строки = Новый Массив;
	Если Не ПустаяСтрока(Комментарий) Тогда
		Строки.Добавить(Комментарий);
	КонецЕсли;

	Для Каждого Пара Из СвойстваФайлов Цикл
		РазмерКБ = Окр(Пара.Значение.Размер / 1024);
		Строки.Добавить(СтрШаблон(НСтр("ru = '- %1 (%2 КБ)'"),
			ИмяВложенияФайла(Пара.Значение), Формат(РазмерКБ, "ЧГ=0")));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Учетная запись отправки - как у уведомлений ядра, но кодом пакета
// (внутренние функции ar_Уведомления не экспортируются): типовая настройка
// ПочтаУчетнаяЗаписьУведомлений (без кэша сеанса) -> системная -> первая
// доступная для отправки.
//
// Возвращаемое значение:
//  Структура - {Ссылка: СправочникСсылка.УчетныеЗаписиЭлектроннойПочты,
//  Неопределено; Адрес: Строка}.
//
Функция УчетнаяЗаписьОтправки()

	Результат = Новый Структура("Ссылка, Адрес", Неопределено, "");

	Настройка = ar_Настройки.ЗначениеНастройкиБезКэша("ПочтаУчетнаяЗаписьУведомлений");
	Если ТипЗнч(Настройка) = Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты")
		И ЗначениеЗаполнено(Настройка) Тогда

		// Адрес и пометка удаления - привилегированно: у записи может быть
		// владелец, отличный от пользователя сеанса (RLS; как в ядре).
		Реквизиты = Неопределено;
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,
				"ПометкаУдаления, АдресЭлектроннойПочты");
		Исключение
			Реквизиты = Неопределено;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);

		Если Реквизиты <> Неопределено И Не Реквизиты.ПометкаУдаления Тогда
			Результат.Ссылка = Настройка;
			Результат.Адрес = СокрЛП(Строка(Реквизиты.АдресЭлектроннойПочты));
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Записи = РаботаСПочтовымиСообщениями.ДоступныеУчетныеЗаписи(Истина, , Истина);
	Если Записи.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ВыбраннаяЗапись = Записи[0];
	СистемнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ссылка = СистемнаяЗапись Тогда
			ВыбраннаяЗапись = Запись;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат.Ссылка = ВыбраннаяЗапись.Ссылка;
	Результат.Адрес = СокрЛП(ВыбраннаяЗапись.Адрес);
	Возврат Результат;

КонецФункции

// Лимит вложений одного вызова, МБ (настройка пакета, по умолчанию 20):
// не число или меньше 1 - значение по умолчанию.
//
// Возвращаемое значение:
//  Число - лимит, МБ.
//
Функция ЛимитВложенийМБ()

	Значение = ar_Настройки.ЗначениеНастройки("КонтрагентФайлыМаксимальныйРазмерВложенийМБ", 20);
	Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 1 Тогда
		Возврат 20;
	КонецЕсли;
	Возврат Окр(Значение, 0);

КонецФункции

// Двоичные данные вложений одним вызовом БСП (все файлы одного справочника);
// отсутствующие данные файла не бросают исключение (ВызыватьИсключение = Ложь).
//
// Параметры:
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> ДвоичныеДанные; Неопределено, если хоть у одного
//  файла данных нет (отправка без него потеряла бы файл молча).
//
Функция ДвоичныеДанныеВложений(Знач СвойстваФайлов)

	Ссылки = Новый Массив;
	Для Каждого Пара Из СвойстваФайлов Цикл
		Ссылки.Добавить(Пара.Ключ);
	КонецЦикла;

	Попытка
		Данные = РаботаСФайлами.ДвоичныеДанныеФайлов(Ссылки, Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Пара Из СвойстваФайлов Цикл
		Если ТипЗнч(Данные.Получить(Пара.Ключ)) <> Тип("ДвоичныеДанные") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Данные;

КонецФункции

// Собирает и отправляет письмо с вложениями инициатору. Отправка - с явно
// заданной учетной записью в привилегированном режиме с парным сбросом
// (реквизиты записи под RLS; как в ar_Уведомления.ОтправитьПисьмоИнициатору).
//
// Параметры:
//  ВыборУЗ         - Структура - {Ссылка, Адрес} учетной записи отправки.
//  АдресПочты      - Строка - адрес инициатора.
//  Инициатор       - СправочникСсылка.Пользователи - получатель.
//  Предмет         - ЛюбаяСсылка, Неопределено - предмет запуска (контрагент).
//  Комментарий     - Строка - комментарий из аргументов инструмента.
//  СвойстваФайлов  - Соответствие - Ссылка -> Структура свойств файла.
//  ДвоичныеДанные  - Соответствие - Ссылка -> ДвоичныеДанные.
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево; ОтветJSON: Строка - JSON-отказ
//  (send_failed) при неудаче, "" при успехе}.
//
Функция ОтправитьПисьмоСФайлами(Знач ВыборУЗ, Знач АдресПочты, Знач Инициатор, Знач Предмет,
	Знач Комментарий, Знач СвойстваФайлов, Знач ДвоичныеДанные)

	Результат = Новый Структура("Отправлено, ОтветJSON", Ложь, "");

	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Отправитель = ВыборУЗ.Адрес;
	Письмо.ИмяОтправителя = "AgentRunner";
	Письмо.Тема = СтрШаблон(НСтр("ru = 'Файлы контрагента %1'"), Строка(Предмет));
	Письмо.Тексты.Добавить(ТекстПисьмаОтправки(Комментарий, СвойстваФайлов),
		ТипТекстаПочтовогоСообщения.ПростойТекст);

	Письмо.Получатели.Добавить(АдресПочты, Строка(Инициатор));

	Для Каждого Пара Из СвойстваФайлов Цикл
		Письмо.Вложения.Добавить(ДвоичныеДанные.Получить(Пара.Ключ), ИмяВложенияФайла(Пара.Значение));
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ВыборУЗ.Ссылка, Письмо);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.ОтветJSON = ОшибкаИнструментаСДеталями("send_failed",
			Новый Структура("reason", ТекстОшибки));
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если РезультатSMTP.ОшибочныеПолучатели.Количество() > 0 Тогда
		Результат.ОтветJSON = ОшибкаИнструментаСДеталями("send_failed",
			Новый Структура("reason", НСтр("ru = 'SMTP отклонил получателя'")));
		Возврат Результат;
	КонецЕсли;

	Результат.Отправлено = Истина;
	Возврат Результат;

КонецФункции

// Успешный ответ инструмента: {status, to, files, total_size}.
//
// Параметры:
//  АдресПочты    - Строка - адрес инициатора.
//  СвойстваФайлов - Соответствие - Ссылка -> Структура свойств файла.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ОтветОбОтправке(Знач АдресПочты, Знач СвойстваФайлов)

	Ответ = Новый Структура;
	Ответ.Вставить("status", "sent");
	Ответ.Вставить("to", АдресПочты);
	Ответ.Вставить("files", ЭлементыОтветаОФайлах(СвойстваФайлов));
	Ответ.Вставить("total_size", СуммарныйРазмерФайлов(СвойстваФайлов));
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

#КонецОбласти

#Область АргументыИОшибки

// Разбирает JSON-строку аргументов инструмента в Соответствие.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; Неопределено при пустом входе или
//  ошибке разбора JSON.
//
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ar_JSON.ИзJSON(АргументыJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует JSON-строку ошибки-observation.
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>"}.
//
Функция ОшибкаИнструмента(Знач КодОшибки)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

// Формирует JSON-строку ошибки-observation с деталями (причина, допустимые
// значения, лимиты) - ошибка аргумента не терминальная, модель может
// исправить вызов по деталям.
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Детали    - Структура - дополнительные поля ответа.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>", "<поле>": значение, ...}.
//
Функция ОшибкаИнструментаСДеталями(Знач КодОшибки, Знач Детали)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Для Каждого Пара Из Детали Цикл
		Объект.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

// Ответ-отказ по файлу со списком допустимых ref (файлы предмета запуска):
// модель исправляет вызов, взяв ref из списка (правило AGENTS.md -
// допустимые значения в ошибке аргумента).
//
// Параметры:
//  КодОшибки - Строка - код ошибки (file_not_found, file_not_of_subject).
//  ИмяФайла  - Строка - имя проблемного файла (если известно).
//  Предмет   - ЛюбаяСсылка, Неопределено - предмет запуска.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>", "file": имя, "allowed": [ref...]}.
//
Функция ОтветСДопустимымиФайлами(Знач КодОшибки, Знач ИмяФайла, Знач Предмет)

	Детали = Новый Структура;
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		Детали.Вставить("file", ИмяФайла);
	КонецЕсли;
	Детали.Вставить("allowed", СсылкиФайловПредмета(Предмет));
	Возврат ОшибкаИнструментаСДеталями(КодОшибки, Детали);

КонецФункции

// Достает RunId из контекста вызова инструмента.
//
// Параметры:
//  Контекст - Структура - контекст запуска; может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - RunId либо "".
//
Функция RunIdИзКонтекста(Знач Контекст)

	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	RunId = "";
	Контекст.Свойство("RunId", RunId);
	Возврат ?(ТипЗнч(RunId) = Тип("Строка"), RunId, "");

КонецФункции

#КонецОбласти

#КонецОбласти
