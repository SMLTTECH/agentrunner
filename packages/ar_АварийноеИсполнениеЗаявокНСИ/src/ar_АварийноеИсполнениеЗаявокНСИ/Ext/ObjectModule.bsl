// Действующий GUID визы этапа: настройка НСИГУИДВизыЭтап1 / НСИГУИДВизыЭтап2
// справочника общих настроек ar_ДополнительныеНастройки (значение базы, как
// ГУИДВизыЭтап1 пакета ar_ПакетНСИ); настройки этапа нет (справочник недоступен
// или активной записи не найдено) - поле настроек обработки (форма). Существующая
// настройка с пустым значением гасит этап (GUID не задан) и значением формы
// не подменяется.
//
// Параметры:
//  НомерЭтапа  - Число  - 1 или 2.
//  ГуидИзФормы - Строка - GUID из настроек обработки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ГУИДВизыЭтапаДействующий(Знач НомерЭтапа, Знач ГуидИзФормы)

	ИзНастройки = ГуидВизыЭтапаИзНастройки(НомерЭтапа);
	Если ИзНастройки = Неопределено Тогда
		Возврат ГуидИзФормы;
	КонецЕсли;

	Возврат ИзНастройки;

КонецФункции

// GUID визы этапа из настройки справочника общих настроек (см. шапку; чтение -
// СтрокаНастройкиОбщих).
//
// Параметры:
//  НомерЭтапа - Число - 1 или 2.
//
// Возвращаемое значение:
//  Строка       - значение настройки (может быть пустым: этап погашен),
//  Неопределено - справочник недоступен или активной записи настройки нет.
//
Функция ГуидВизыЭтапаИзНастройки(Знач НомерЭтапа) Экспорт

	Если НЕ ДоступныОбщиеНастройки() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НомерЭтапа = 1 Тогда
		Ключ = "НСИГУИДВизыЭтап1";
	Иначе
		Ключ = "НСИГУИДВизыЭтап2";
	КонецЕсли;

	Возврат СтрокаНастройкиОбщих(Ключ, Неопределено);

КонецФункции

// Строковое значение настройки справочника ar_ДополнительныеНастройки (чтение -
// привилегированно, как настройки самой обработки; обращение к справочнику -
// только запросом по имени, без модулей ar_*, см. шапку): активный элемент по
// Код, значение - ar_ЗначениеСтрока, иначе строковое представление ar_Значение.
// Настройки нет - значение по умолчанию; запись без значения - пустая строка
// (этап не ведется).
//
// Параметры:
//  Ключ        - Строка - код элемента справочника.
//  ПоУмолчанию - Строка, Неопределено - значение при отсутствии настройки
//                (Неопределено - признак «записи нет» для вызывающего).
//
// Возвращаемое значение:
//  Строка, Неопределено.
//
Функция СтрокаНастройкиОбщих(Знач Ключ, Знач ПоУмолчанию)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.ar_ЗначениеСтрока КАК ЗначениеСтрока,
		|	Настройки.ar_Значение КАК Значение
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|ГДЕ
		|	Настройки.Код = &Ключ
		|	И Настройки.ar_Включено
		|	И НЕ Настройки.ПометкаУдаления";

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если НЕ Выборка.Следующий() Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если НЕ ПустаяСтрока(Выборка.ЗначениеСтрока) Тогда
		Возврат СокрЛП(Выборка.ЗначениеСтрока);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Значение) Тогда
		Возврат СокрЛП(Строка(Выборка.Значение));
	КонецЕсли;
	Возврат "";

КонецФункции

