#Область ПрограммныйИнтерфейс

// Внешняя дополнительная обработка «Аварийное исполнение заявок НСИ»
// (задача agentrunner-252, спека v2).
//
// Когда агент НСИ не работает (недоступна LLM, остановлено ядро/пул, агент
// выключен), заявки НСИ на контрагентов лежат на визах пользователя агента и
// процесс стоит. Обработка по расписанию БСП (РЗ «ЗапускДополнительныхОбработок»,
// команда "ar_ТактИсполнения") за такт берет очередь пакета ar_ПакетНСИ
// (ar_ОбъектыКОбработке) и ведет заявки инструментами пакета
// (ar_ВыполнитьИнструмент, Контекст: Агент + ИсполнениеОбработкой) по
// детерминированным правилам, без LLM:
//  - заявка актуализации    - nsi_actualize_request (пакет сам: ЕГР, запись,
//                             проведение, визы, отложения, передача);
//  - этап 2                 - nsi_get_request, действие по полю next
//                             (approve / return / restart / handover);
//  - этап 1, обычная заявка - nsi_get_request, nsi_verify_request, решение по
//                             вердикту: files_pending - пропуск (следующий
//                             такт); return / reject_candidate / handover -
//                             соответствующее решение с основанием из сверки;
//                             ready либо files_not_submitted - approve
//                             (согласование без проверки файлов); незакрытые
//                             пункты needs_review - handover.
// Логика сверки, лимитов и отложений - только пакет, не копируется; работа
// возможна только при загруженном расширении AgentRunner.
//
// Режим включается администратором в форме; настройки общие для всех
// пользователей - хранилище общих настроек БСП (ключ "ar_АварийноеИсполнениеЗаявокНСИ").
// Пока режим выключен, такт сразу выходит и ничего не пишет. Изменение режима -
// запись в журнал регистрации (пользователь, значение). Ошибка такта (в том
// числе пакет не найден или расширение не загружено) не роняет РЗ - перехват и
// запись в журнал регистрации (Ошибка).
//
// БезопасныйРежим = Ложь: пакет вызывает сервис ЕГРЮЛ/ЕГРИП (сеть) и пишет
// протоколы присоединенными файлами.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки».
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: исполнение заявок НСИ без LLM'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Аварийное исполнение заявок НСИ на контрагентов без
		|LLM инструментами пакета ar_ПакетНСИ: актуализация, возврат, отклонение, согласование без
		|проверки файлов, этап 2. Включается администратором в форме, только пока агент НСИ не работает.
		|Запуск - по расписанию (команда «Исполнение заявок НСИ без LLM») или кнопкой в форме.'");
	// Спека agentrunner-252 п. 1: пакет ходит в ЕГР и пишет файлы протоколов -
	// в безопасном режиме платформа запрещает сеть и внешние действия.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	// Такт по расписанию - расписание задает администратор в карточке обработки;
	// исполняет РЗ БСП «ЗапускДополнительныхОбработок».
	КомандаТакта = ПараметрыРегистрации.Команды.Добавить();
	КомандаТакта.Представление        = НСтр("ru = 'AgentRunner Пакет инструментов: Исполнение заявок НСИ без LLM'");
	КомандаТакта.Идентификатор        = "ar_ТактИсполнения";
	КомандаТакта.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаТакта.ПоказыватьОповещение = Ложь;

	// Форма настроек и ручного такта.
	КомандаФормы = ПараметрыРегистрации.Команды.Добавить();
	КомандаФормы.Представление        = НСтр("ru = 'AgentRunner: исполнение заявок НСИ без LLM'");
	КомандаФормы.Идентификатор        = "ОткрытьФормуНастроек";
	КомандаФормы.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	КомандаФормы.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП «Дополнительные отчеты и обработки». Команда
// "ar_ТактИсполнения" - такт аварийного исполнения по расписанию; команда
// открытия формы исполняется БСП сама (основная форма обработки).
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ТактИсполнения" Тогда
		// Ошибки такта (включая отказ подключения пакета) не роняют РЗ:
		// ТактИсполнения перехватывает и пишет в журнал регистрации (Ошибка).
		ТактИсполнения(Истина);
	КонецЕсли;

КонецПроцедуры

// Один такт аварийного исполнения (спека п. 3): очередь пакета - по заявке на
// решение. Каждая заявка - в своей попытке: ошибка одной не останавливает такт.
//
// Параметры:
//  ЗаписьВБазу - Булево - Истина: решения записываются (режим должен быть
//               включен), журнал регистрации пишется; Ложь: «Показать без
//               записи» - решения с "_dry_run", в базу ничего не пишется.
//
// Возвращаемое значение:
//  Структура:
//   * Строки - ТаблицаЗначений - заявка / этап / вердикт / решение / причина.
//   * Ошибка - Строка - текст ошибки такта (пусто - ошибок нет); при записи
//             в базу ошибка уже записана в журнал регистрации.
//
Функция ТактИсполнения(Знач ЗаписьВБазу) Экспорт

	Результат = НовыйРезультатТакта();

	Попытка
		ВыполнитьТакт(Результат, ЗаписьВБазу);
	Исключение
		Результат.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЗаписьВБазу Тогда
			ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Настройки обработки из хранилища общих настроек БСП. Читает любой
// пользователь (в том числе пользователь РЗ): без права
// «СохранениеДанныхПользователя» загрузка вернет значения по умолчанию -
// режим считается выключенным, такт не выполняется (безопасный исход).
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию.
//
Функция НастройкиОбработки() Экспорт

	Итог = НастройкиПоУмолчанию();
	Сохраненные = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		КлючОбъектаНастроек(), КлючНастроек(), Неопределено);
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Итог, Сохраненные);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Сохранение настроек обработки (форма). Изменение режима включен/выключен -
// запись в журнал регистрации (пользователь виден в журнале).
//
// Параметры:
//  Настройки - Структура - РежимВключен, АгентНаименование, ЛимитЗаявок.
//
Процедура СохранитьНастройки(Знач Настройки) Экспорт

	Прежние = НастройкиОбработки();
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		КлючОбъектаНастроек(), КлючНастроек(), Настройки,
		НСтр("ru = 'Аварийное исполнение заявок НСИ: настройки'"));

	Если Прежние.РежимВключен <> Настройки.РежимВключен Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Режим: %1 (было: %2)'"),
			РежимСтрокой(Настройки.РежимВключен), РежимСтрокой(Прежние.РежимВключен));
		ЗаписьЖурналаРегистрации(СобытиеРежима(), УровеньЖурналаРегистрации.Информация, , , ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исполнение такта: настройки, подключение пакета, очередь, решения.
Процедура ВыполнитьТакт(Результат, Знач ЗаписьВБазу)

	Настройки = НастройкиОбработки();
	// Спека п. 3: режим выключен - сразу выход, ничего не пишет. «Показать без
	// записи» работает и при выключенном режиме - это просмотр, не запись.
	Если ЗаписьВБазу И НЕ Настройки.РежимВключен Тогда
		Возврат;
	КонецЕсли;

	Пакет = ПодключитьПакетНСИ();
	Если Пакет = Неопределено Тогда
		ТекстОтказа = НСтр("ru = 'Пакет инструментов ar_ПакетНСИ не найден среди
			|подключенных дополнительных обработок (или не загружено расширение AgentRunner).'");
		ОтказТакта(Результат, ЗаписьВБазу, ТекстОтказа);
		Возврат;
	КонецЕсли;

	Агент = АгентОбработки(Настройки.АгентНаименование);
	Если Агент = Неопределено Тогда
		ТекстОтказа = СтрШаблон(
			НСтр("ru = 'Агент НСИ с наименованием ""%1"" не найден в справочнике ar_Агенты
				|или не задан в настройках обработки.'"),
			Настройки.АгентНаименование);
		ОтказТакта(Результат, ЗаписьВБазу, ТекстОтказа);
		Возврат;
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Агент", Агент);
	Контекст.Вставить("ИсполнениеОбработкой", Истина);

	Заявки = ОчередьПакета(Пакет, Агент, Настройки.ЛимитЗаявок, Результат, ЗаписьВБазу);
	Если Заявки = Неопределено Тогда
		Возврат; // Отказ очереди уже записан.
	КонецЕсли;

	Для Каждого Заявка Из Заявки Цикл
		СтрокаИтога = Результат.Строки.Добавить();
		ИтогЗаявки = ОбработатьЗаявку(Пакет, Контекст, Заявка, ЗаписьВБазу);
		ЗаполнитьЗначенияСвойств(СтрокаИтога, ИтогЗаявки);
	КонецЦикла;

	Если ЗаписьВБазу Тогда
		ЗаписатьИтогТакта(Результат);
	КонецЕсли;

КонецПроцедуры

// Отказ такта до очереди: текст ошибки в результат и журнал регистрации.
Процедура ОтказТакта(Результат, Знач ЗаписьВБазу, Знач Причина)

	Результат.Ошибка = Причина;
	Если ЗаписьВБазу Тогда
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , , Причина);
	КонецЕсли;

КонецПроцедуры

// Зарегистрированная обработка пакета НСИ (спека п. 3: как пакет находит
// обработку проверки данных) - по имени объекта, публикация «Используется».
//
// Возвращаемое значение:
//  ВнешняяОбработка - объект пакета (ar_ОбъектыКОбработке, ar_ВыполнитьИнструмент);
//  Неопределено - не найдена или не подключена.
//
Функция ПодключитьПакетНСИ()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяПакетаНСИ());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
		|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Выборка.Ссылка);

КонецФункции

// Имя объекта зарегистрированного пакета НСИ (имя файла epf без расширения).
Функция ИмяПакетаНСИ()

	Возврат "ar_ПакетНСИ";

КонецФункции

// Агент НСИ по наименованию из настроек (как форма «Инструменты» пакета).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты, Неопределено - не задан или не найден.
//
Функция АгентОбработки(Знач Наименование)

	НаименованиеАгента = СокрЛП(Наименование);
	Агент = Справочники.ar_Агенты.НайтиПоНаименованию(НаименованиеАгента, Истина);
	Если Агент.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Агент;

КонецФункции

// Очередь пакета (спека п. 3.1): ar_ОбъектыКОбработке - визы агента и заявки
// актуализации, отложения пакет учитывает сам. Ошибка - в результат и журнал.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.бит_мдм_ЗаявкаНаИзменение; Неопределено - отказ.
//
Функция ОчередьПакета(Знач Пакет, Знач Агент, Знач Лимит, Результат, Знач ЗаписьВБазу)

	Попытка
		Возврат Пакет.ar_ОбъектыКОбработке(Агент, Лимит);
	Исключение
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Очередь пакета не прочитана: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЗаписьВБазу Тогда
			ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , ,
				Результат.Ошибка);
		КонецЕсли;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Обработка одной заявки такта (спека п. 3.2). Ошибка одной заявки не
// останавливает такт - причина в строке результата и журнале регистрации.
//
// Параметры:
//  Пакет       - ВнешняяОбработка - подключенный пакет НСИ.
//  Контекст    - Структура    - Агент + ИсполнениеОбработкой.
//  Заявка      - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ЗаписьВБазу - Булево.
//
// Возвращаемое значение:
//  Структура - заявка / этап / вердикт / решение / причина.
//
Функция ОбработатьЗаявку(Знач Пакет, Знач Контекст, Знач Заявка, Знач ЗаписьВБазу)

	Итог = НовыйСтрокаИтога(Заявка);

	Попытка
		Решение = РешениеПоЗаявке(Пакет, Контекст, Заявка, ЗаписьВБазу);
		ЗаполнитьЗначенияСвойств(Итог, Решение);
	Исключение
		Итог.Решение = МеткаОшибки();
		Итог.Причина = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Решение по заявке: чтение nsi_get_request, ветка по сценарию/этапу.
Функция РешениеПоЗаявке(Знач Пакет, Знач Контекст, Знач Заявка, Знач ЗаписьВБазу)

	Итог = НовыйСтрокаИтога(Заявка);

	АргументыЧтения = Новый Соответствие;
	АргументыЧтения.Вставить("request", НавигационнаяСсылкаЗаявки(Заявка));
	АргументыЧтения.Вставить("full", Истина);
	ОтветЧтенияСтрока = ВызватьИнструментПакета(Пакет, "nsi_get_request",
		АргументыЧтения, Контекст, Ложь);
	ОтветЧтения = РазобратьJSON(ОтветЧтенияСтрока);
	Если ОтветЧтения = Неопределено Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу,
			НСтр("ru = 'Ответ nsi_get_request не разобран как JSON-объект.'"));
		Возврат Итог;
	КонецЕсли;

	Отказ = ОтказИнструмента(ОтветЧтения);
	Если НЕ ПустаяСтрока(Отказ.Код) Тогда
		// Отказ пакета - заявку оставляем в очереди (спека п. 3).
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу, Отказ.Сообщение);
		Возврат Итог;
	КонецЕсли;

	Сценарий = Строка(ОтветЧтения.Получить("scenario"));
	Этап = ОтветЧтения.Получить("stage");
	Итог.Этап = Строка(Этап);
	Итог.Вердикт = Сценарий;

	Если Сценарий = "actualize" Тогда
		АктуализироватьЗаявку(Пакет, Контекст, Заявка, Итог, ЗаписьВБазу);
	ИначеЕсли Этап = 2 Тогда
		РешитьЭтапДва(Пакет, Контекст, Заявка, ОтветЧтения, Итог, ЗаписьВБазу);
	Иначе
		РешитьЭтапОдин(Пакет, Контекст, Заявка, ОтветЧтения, Итог, ЗаписьВБазу);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Заявка актуализации - nsi_actualize_request (пакет сам: ЕГР, запись,
// проведение, визы, отложение при недоступном ЕГР, передача при сбоях).
Процедура АктуализироватьЗаявку(Знач Пакет, Знач Контекст, Знач Заявка, Итог, Знач ЗаписьВБазу)

	Аргументы = Новый Соответствие;
	Аргументы.Вставить("request", НавигационнаяСсылкаЗаявки(Заявка));

	ОтветСтрока = ВызватьИнструментПакета(Пакет, "nsi_actualize_request",
		Аргументы, Контекст, НЕ ЗаписьВБазу);
	Ответ = РазобратьJSON(ОтветСтрока);
	Если Ответ = Неопределено Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу,
			НСтр("ru = 'Ответ nsi_actualize_request не разобран как JSON-объект.'"));
		Возврат;
	КонецЕсли;

	Отказ = ОтказИнструмента(Ответ);
	Если НЕ ПустаяСтрока(Отказ.Код) Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу, Отказ.Сообщение);
		Возврат;
	КонецЕсли;

	РезультатАктуализации = Строка(Ответ.Получить("result"));
	Итог.Решение = МеткаАктуализации(РезультатАктуализации);
	Итог.Причина = СоединитьЗамечания(ЗамечанияОтвета(Ответ), РезультатАктуализации);
	ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Этап 2: действие диктует поле next ответа nsi_get_request (спека п. 3).
Процедура РешитьЭтапДва(Знач Пакет, Знач Контекст, Знач Заявка, Знач ОтветЧтения, Итог,
	Знач ЗаписьВБазу)

	ХешМодели = Строка(ОтветЧтения.Получить("model_hash"));
	СледующийШаг = Строка(ОтветЧтения.Получить("next"));
	Итог.Вердикт = СледующийШаг;

	Если СледующийШаг = "nsi_set_visa_decision" Тогда
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "approve", "", Итог, ЗаписьВБазу);
	ИначеЕсли СтрНачинаетсяС(СледующийШаг, "return: ") Тогда
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "return",
			СокрЛП(Сред(СледующийШаг, СтрДлина("return: ") + 1)), Итог, ЗаписьВБазу);
	ИначеЕсли СтрНачинаетсяС(СледующийШаг, "handover: ") Тогда
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "handover",
			СокрЛП(Сред(СледующийШаг, СтрДлина("handover: ") + 1)), Итог, ЗаписьВБазу);
	ИначеЕсли СтрНачинаетсяС(СледующийШаг, "restart: ") Тогда
		Причина = СокрЛП(Сред(СледующийШаг, СтрДлина("restart: ") + 1));
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "restart", "", Итог, ЗаписьВБазу);
		Если Итог.Решение <> МеткаОшибки() Тогда
			Итог.Причина = Причина;
		КонецЕсли;
	Иначе
		// finish либо неизвестный шаг - заявка остается до следующего такта.
		Итог.Решение = МеткаОтложено();
		Итог.Причина = СтрШаблон(НСтр("ru = 'Следующий шаг пакета: %1 - решение не требуется.'"),
			СледующийШаг);
		ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);
	КонецЕсли;

КонецПроцедуры

// Этап 1, обычная заявка: сверка nsi_verify_request и решение по вердикту
// (таблица спеки п. 3).
Процедура РешитьЭтапОдин(Знач Пакет, Знач Контекст, Знач Заявка, Знач ОтветЧтения, Итог,
	Знач ЗаписьВБазу)

	ХешМодели = Строка(ОтветЧтения.Получить("model_hash"));

	Аргументы = Новый Соответствие;
	Аргументы.Вставить("request", НавигационнаяСсылкаЗаявки(Заявка));
	Аргументы.Вставить("model_hash", ХешМодели);

	ОтветСверкиСтрока = ВызватьИнструментПакета(Пакет, "nsi_verify_request",
		Аргументы, Контекст, Ложь);
	ОтветСверки = РазобратьJSON(ОтветСверкиСтрока);
	Если ОтветСверки = Неопределено Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу,
			НСтр("ru = 'Ответ nsi_verify_request не разобран как JSON-объект.'"));
		Возврат;
	КонецЕсли;

	Отказ = ОтказИнструмента(ОтветСверки);
	Если НЕ ПустаяСтрока(Отказ.Код) Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу, Отказ.Сообщение);
		Возврат;
	КонецЕсли;

	Вердикт = Строка(ОтветСверки.Получить("verdict"));
	Итог.Вердикт = Вердикт;

	Если Вердикт = "files_pending" Тогда
		// Файлы распознаются - заявка вернется в очереди к следующему такту.
		Итог.Решение = МеткаОтложено();
		Итог.Причина = НСтр("ru = 'Файлы заявки еще распознаются.'");
		ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);
		Возврат;
	КонецЕсли;

	Если Вердикт = "return" Или Вердикт = "reject_candidate" Или Вердикт = "handover" Тогда
		Если Вердикт = "reject_candidate" Тогда
			КодРешения = "reject";
		ИначеЕсли Вердикт = "handover" Тогда
			КодРешения = "handover";
		Иначе
			КодРешения = "return";
		КонецЕсли;
		Основание = СоединитьЗамечания(ЗамечанияОтвета(ОтветСверки), "");
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, КодРешения, Основание, Итог, ЗаписьВБазу);
		Возврат;
	КонецЕсли;

	// ready либо files_not_submitted: согласование без проверки файлов
	// (признак ИсполнениеОбработкой пакета); незакрытые пункты needs_review -
	// передача сотруднику НСИ (спека п. 3).
	Незакрытые = НезакрытыеПунктыReview(ОтветСверки);
	Если Незакрытые.Количество() > 0 Тогда
		Основание = СтрШаблон(НСтр("ru = 'Требуется разбор пунктов needs_review: %1'"),
			СтрСоединить(Незакрытые, ", "));
		РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "handover", Основание, Итог, ЗаписьВБазу);
		Возврат;
	КонецЕсли;

	РешитьПоВизе(Пакет, Контекст, Заявка, ХешМодели, "approve", "", Итог, ЗаписьВБазу);

КонецПроцедуры

// Решение по визе через nsi_set_visa_decision (спека п. 3.2). При «Показать
// без записи» аргументы уходят с "_dry_run" - пакет возвращает план, ничего
// не записывая.
//
// Параметры:
//  Комментарий - Строка - основание (обязателен пакетом для return, reject
//               и handover; для approve и restart не передается).
//
Процедура РешитьПоВизе(Знач Пакет, Знач Контекст, Знач Заявка, Знач ХешМодели, Знач КодРешения,
	Знач Комментарий, Итог, Знач ЗаписьВБазу)

	Аргументы = Новый Соответствие;
	Аргументы.Вставить("request", НавигационнаяСсылкаЗаявки(Заявка));
	Аргументы.Вставить("decision", КодРешения);
	Аргументы.Вставить("model_hash", ХешМодели);
	Если НЕ ПустаяСтрока(Комментарий) Тогда
		Аргументы.Вставить("comment", Комментарий);
	КонецЕсли;

	ОтветСтрока = ВызватьИнструментПакета(Пакет, "nsi_set_visa_decision",
		Аргументы, Контекст, НЕ ЗаписьВБазу);
	Ответ = РазобратьJSON(ОтветСтрока);
	Если Ответ = Неопределено Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу,
			НСтр("ru = 'Ответ nsi_set_visa_decision не разобран как JSON-объект.'"));
		Возврат;
	КонецЕсли;

	Отказ = ОтказИнструмента(Ответ);
	Если НЕ ПустаяСтрока(Отказ.Код) Тогда
		ОтказЗаявки(Итог, Заявка, ЗаписьВБазу, Отказ.Сообщение);
		Возврат;
	КонецЕсли;

	Итог.Решение = МеткаРешения(КодРешения);
	Итог.Причина = Комментарий;
	ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Метка решения для таблицы результата и журнала регистрации.
Функция МеткаРешения(Знач КодРешения)

	Если КодРешения = "approve" Тогда
		Возврат НСтр("ru = 'Согласовано'");
	ИначеЕсли КодРешения = "return" Тогда
		Возврат НСтр("ru = 'Возвращено'");
	ИначеЕсли КодРешения = "reject" Тогда
		Возврат НСтр("ru = 'Отклонено'");
	ИначеЕсли КодРешения = "handover" Тогда
		Возврат НСтр("ru = 'Передано'");
	ИначеЕсли КодРешения = "restart" Тогда
		Возврат НСтр("ru = 'Повторный цикл'");
	Иначе
		Возврат КодРешения;
	КонецЕсли;

КонецФункции

// Метка результата nsi_actualize_request для таблицы результата и журнала.
Функция МеткаАктуализации(Знач Результат)

	Если Результат = "approved" Или Результат = "approved_stage1" Тогда
		Возврат НСтр("ru = 'Согласовано'");
	ИначеЕсли Результат = "handover" Тогда
		Возврат НСтр("ru = 'Передано'");
	ИначеЕсли Результат = "service_unavailable" Тогда
		Возврат МеткаОтложено();
	ИначеЕсли Результат = "not_actualization" Тогда
		Возврат НСтр("ru = 'Пропущено'");
	Иначе
		Возврат Результат;
	КонецЕсли;

КонецФункции

// Метка отложенного решения (файлы распознаются, шаг пакета не требует решения).
Функция МеткаОтложено()

	Возврат НСтр("ru = 'Отложено'");

КонецФункции

// Метка ошибки исполнения по заявке.
Функция МеткаОшибки()

	Возврат НСтр("ru = 'Ошибка'");

КонецФункции

// Тексты замечаний из ответа инструмента (remarks): элементы - объекты с
// полем "text" (сверка) либо строки (актуализация); пустые пропускаются.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗамечанияОтвета(Знач Ответ)

	Замечания = Новый Массив;
	Строки = Ответ.Получить("remarks");
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат Замечания;
	КонецЕсли;

	Для Каждого Замечание Из Строки Цикл
		Если ТипЗнч(Замечание) = Тип("Соответствие") Тогда
			Текст = СокрЛП(Строка(Замечание.Получить("text")));
		Иначе
			Текст = СокрЛП(Строка(Замечание));
		КонецЕсли;
		Если НЕ ПустаяСтрока(Текст) Тогда
			Замечания.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат Замечания;

КонецФункции

// Незакрытые пункты needs_review из ответа сверки (массив идентификаторов);
// обработка пункты не закрывает - любой пункт ведет к передаче (спека п. 3).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция НезакрытыеПунктыReview(Знач ОтветСверки)

	Идентификаторы = Новый Массив;
	Пункты = ОтветСверки.Получить("needs_review");
	Если ТипЗнч(Пункты) <> Тип("Массив") Тогда
		Возврат Идентификаторы;
	КонецЕсли;

	Для Каждого Пункт Из Пункты Цикл
		Если ТипЗнч(Пункт) = Тип("Соответствие") Тогда
			Идентификатор = СокрЛП(Строка(Пункт.Получить("id")));
		Иначе
			Идентификатор = СокрЛП(Строка(Пункт));
		КонецЕсли;
		Если НЕ ПустаяСтрока(Идентификатор) Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

// Замечания одной строкой (основание решения). Пусто и есть дефолт - дефолт.
Функция СоединитьЗамечания(Знач Замечания, Знач Дефолт)

	Если Замечания.Количество() = 0 Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат СтрСоединить(Замечания, "; ");

КонецФункции

// Отказ по заявке (ошибка инструмента пакета либо непонятный ответ): решение
// «Ошибка», причина - в строке результата и журнале; заявку оставляем.
Процедура ОтказЗаявки(Итог, Знач Заявка, Знач ЗаписьВБазу, Знач Причина)

	Итог.Решение = МеткаОшибки();
	Итог.Причина = Причина;
	ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Предупреждение);

КонецПроцедуры

// Код и сообщение отказа из ответа инструмента ({"error", "message"}).
//
// Возвращаемое значение:
//  Структура {Код, Сообщение}.
//
Функция ОтказИнструмента(Знач Ответ)

	Код = Строка(Ответ.Получить("error"));
	Сообщение = СтрШаблон(НСтр("ru = '%1: %2'"), Код, Строка(Ответ.Получить("message")));
	Возврат Новый Структура("Код, Сообщение", Код, Сообщение);

КонецФункции

// Вызов инструмента пакета (единственная точка - контракт пакета). Аргументы
// - Соответствие, сериализуется в однострочный JSON; Пробный добавляет
// "_dry_run".
//
// Возвращаемое значение:
//  Строка - JSON-ответ инструмента.
//
Функция ВызватьИнструментПакета(Знач Пакет, Знач ИмяИнструмента, Знач Аргументы, Знач Контекст,
	Знач Пробный)

	Если Пробный Тогда
		Аргументы.Вставить("_dry_run", Истина);
	КонецЕсли;
	СтрокаАргументов = СтрокаИзСоответствияJSON(Аргументы);
	Возврат Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента, СтрокаАргументов, Контекст);

КонецФункции

// Навссылка заявки (формат request инструментов пакета).
Функция НавигационнаяСсылкаЗаявки(Знач Заявка)

	Возврат ПолучитьНавигационнуюСсылку(Заявка);

КонецФункции

// Сериализация аргументов в однострочный JSON (для вызова инструмента пакета).
Функция СтрокаИзСоответствияJSON(Знач Аргументы)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Аргументы);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Разбор JSON-ответа в Соответствие; не объект или битый JSON - Неопределено.
Функция РазобратьJSON(Знач СтрокаОтвета)

	Результат = Неопределено;
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запись решения по заявке в журнал регистрации (спека п. 3.3: заявка,
// решение, причина). При «Показать без записи» ничего не пишет.
Процедура ЗаписатьРешениеВЖурнал(Знач Заявка, Знач Итог, Знач ЗаписьВБазу, Знач Уровень)

	Если НЕ ЗаписьВБазу Тогда
		Возврат;
	КонецЕсли;
	ТекстСобытия = СтрШаблон(НСтр("ru = 'Решение: %1; причина: %2'"), Итог.Решение, Итог.Причина);
	ЗаписьЖурналаРегистрации(СобытиеИсполнения(), Уровень,
		Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Заявка, ТекстСобытия);

КонецПроцедуры

// Итог такта в журнал регистрации (спека п. 3.3): найдено / согласовано /
// возвращено / отклонено / передано / отложено / ошибок.
Процедура ЗаписатьИтогТакта(Знач Результат)

	Части = Новый Массив;
	ТекстНайдено = СтрШаблон(НСтр("ru = 'Найдено: %1'"),
		Формат(Результат.Строки.Количество(), "ЧГ=0"));
	Части.Добавить(ТекстНайдено);
	Для Каждого Метка Из МеткиРешений() Цикл
		Число = ЧислоРешений(Результат.Строки, Метка);
		Если Число > 0 Тогда
			ТекстМетка = СтрШаблон(НСтр("ru = '%1: %2'"), НРег(Метка), Формат(Число, "ЧГ=0"));
			Части.Добавить(ТекстМетка);
		КонецЕсли;
	КонецЦикла;
	ТекстИтога = СтрСоединить(Части, "; ");
	ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Информация, , , ТекстИтога);

КонецПроцедуры

// Метки решений для итога такта.
Функция МеткиРешений()

	Метки = Новый Массив;
	Метки.Добавить(НСтр("ru = 'Согласовано'"));
	Метки.Добавить(НСтр("ru = 'Возвращено'"));
	Метки.Добавить(НСтр("ru = 'Отклонено'"));
	Метки.Добавить(НСтр("ru = 'Передано'"));
	Метки.Добавить(МеткаОтложено());
	Метки.Добавить(НСтр("ru = 'Пропущено'"));
	Метки.Добавить(НСтр("ru = 'Повторный цикл'"));
	Метки.Добавить(МеткаОшибки());
	Возврат Метки;

КонецФункции

// Число строк результата с решением Метка.
Функция ЧислоРешений(Знач Строки, Знач Метка)

	Число = 0;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Решение = Метка Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

// Пустой результат такта (структура с таблицей строк).
Функция НовыйРезультатТакта()

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Заявка");
	Строки.Колонки.Добавить("Этап");
	Строки.Колонки.Добавить("Вердикт");
	Строки.Колонки.Добавить("Решение");
	Строки.Колонки.Добавить("Причина");

	Результат = Новый Структура;
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Ошибка", "");
	Возврат Результат;

КонецФункции

// Пустая строка результата по заявке.
Функция НовыйСтрокаИтога(Знач Заявка)

	Итог = Новый Структура;
	Итог.Вставить("Заявка", Строка(Заявка));
	Итог.Вставить("Этап", "");
	Итог.Вставить("Вердикт", "");
	Итог.Вставить("Решение", "");
	Итог.Вставить("Причина", "");
	Возврат Итог;

КонецФункции

// Настройки по умолчанию (спека п. 2).
Функция НастройкиПоУмолчанию()

	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", Ложь);
	Настройки.Вставить("АгентНаименование", "");
	Настройки.Вставить("ЛимитЗаявок", 20);
	Возврат Настройки;

КонецФункции

