#Область ПрограммныйИнтерфейс

// Внешняя дополнительная обработка «Аварийное исполнение заявок НСИ»
// (задача agentrunner-252, спека v4.1).
//
// Когда агент НСИ AgentRunner не работает (отключено расширение, недоступна
// LLM, остановлен пул), заявки НСИ на контрагентов лежат на визах пользователя
// агента и процесс стоит. Обработка по расписанию БСП (РЗ «ЗапускДополнительных
// Обработок», команда "ar_ТактИсполнения") без LLM и без расширения ведет эти
// заявки детерминированно - самодостаточно, без пакета ar_ПакетНСИ и без
// модулей ar_*:
//  - очередь         - собственный запрос по бит_УстановленныеВизы (активная
//                      виза без решения, виза этапа 1 или 2; шаблон визы - в
//                      правах пользователя агента, бит_ПраваУстановкиВиз, как
//                      у очереди пакета, а не поле «Пользователь» записи);
//                      заявка «Контрагенты», проведена, не из внешней системы,
//                      без пометки «Требуется ручной разбор»; заявки
//                      автоактуализации на визах - с признаком сценария;
//  - этап 1          - обработка проверки данных ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты
//                      (БСП-подключение) и ЕГР (ликвидация): отказы (дубль,
//                      ликвидирован) - «Отклонено»; замечания «не пройдена» -
//                      возврат («Отклонено» с текстом возврата, письмо
//                      инициатору); ошибки проверки - «Оставить»; замечаний
//                      нет - согласование без проверки файлов;
//  - этап 2          - счет из доп. реквизитов модели: оба пусты - согласовать;
//                      банк/ключ неверен - возврат; иначе создание счета и
//                      согласование в одной транзакции; ошибка - «Оставить»;
//  - актуализация    - заявка автоактуализации на визах (проведенная): этап 2
//                      при согласованной визе 1 - «Согласовано» с комментарием
//                      визы 1; этап 1 без решения - «Оставить» (полный путь
//                      сценария - заполнение по ЕГР и запись модели - исполняет
//                      только агент НСИ);
//  - «Оставить»      - решение не ставится, в комментарий визы пишется
//                      «Требуется ручной разбор: <причина>» - виза исключается
//                      из очереди, пока сотрудник ее не решит.
// Решения ставятся механизмом визирования «БИТ»
// (sd_Оптимизация_ФоновоеВизированиеСервер.УстановитьРешениеПоВизе) в
// транзакции с исключительными блокировками виз и заявки и повторной
// проверкой визы под блокировкой. Каждый протокол решения - присоединенный
// файл «Протокол ручного исполнения <дата>» у заявки; журнал регистрации -
// событие «AgentRunner.Исполнение заявок НСИ».
//
// Обработка одна и та же при включенном и отключенном расширении AgentRunner:
// обращений к объектам и модулям ar_* в коде нет (ни прямых, ни через
// Выполнить()/Вычислить()).
//
// Настройки общие для всех пользователей (в том числе пользователя РЗ) -
// ХранилищеНастроек элемента справочника ДополнительныеОтчетыИОбработки самой
// обработки; запись и чтение - в привилегированном режиме. Визы этапов при
// доступном справочнике ar_ДополнительныеНастройки (расширение подключено)
// читаются из его настроек НСИГУИДВизыЭтап1 / НСИГУИДВизыЭтап2 - значения базы
// без правки обработки, как у пакета ar_ПакетНСИ; настройки этапа нет - поле
// GUID настроек обработки (форма показывает действующее значение каждого этапа:
// поле только для чтения, пока настройка справочника существует).
// Режим включается
// администратором в форме: включайте, только когда агент НСИ не работает -
// при работающем агенте обработка конкурирует с ним за заявки. Пока режим
// выключен, такт сразу выходит и ничего не пишет. Изменение режима - запись в
// журнал регистрации (пользователь, значение). Ошибка такта не роняет РЗ -
// перехват и запись в журнал регистрации (Ошибка).
//
// БезопасныйРежим = Ложь: обработка вызывает сервис ЕГРЮЛ/ЕГРИП (сеть) и
// пишет протоколы присоединенными файлами.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки».
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: исполнение заявок НСИ без LLM'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Аварийное исполнение заявок НСИ на контрагентов без LLM и
		| без расширения AgentRunner: согласование без проверки файлов, отказ, возврат инициатору,
		| этап 2 со счетом; спорное остается на визе с пометкой «Требуется ручной разбор». Включается
		| администратором в форме, только пока агент НСИ не работает. Запуск - по расписанию (команда
		| «Исполнение заявок НСИ без LLM») или кнопкой в форме.'");
	// Спека п. 1: обработка ходит в ЕГР и пишет файлы протоколов - в
	// безопасном режиме платформа запрещает сеть и внешние действия.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	// Такт по расписанию - расписание задает администратор в карточке обработки;
	// исполняет РЗ БСП «ЗапускДополнительныхОбработок» родительской конфигурации.
	КомандаТакта = ПараметрыРегистрации.Команды.Добавить();
	КомандаТакта.Представление        = НСтр("ru = 'AgentRunner Пакет инструментов: Исполнение заявок НСИ без LLM'");
	КомандаТакта.Идентификатор        = "ar_ТактИсполнения";
	КомандаТакта.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаТакта.ПоказыватьОповещение = Ложь;

	// Форма настроек и ручного такта.
	КомандаФормы = ПараметрыРегистрации.Команды.Добавить();
	КомандаФормы.Представление        = НСтр("ru = 'AgentRunner: исполнение заявок НСИ без LLM'");
	КомандаФормы.Идентификатор        = "ОткрытьФормуНастроек";
	КомандаФормы.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	КомандаФормы.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП «Дополнительные отчеты и обработки». Команда
// "ar_ТактИсполнения" - такт аварийного исполнения по расписанию; команда
// открытия формы исполняется БСП сама (основная форма обработки).
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП
//                               (ДополнительнаяОбработкаСсылка - элемент
//                               справочника этой обработки).
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ТактИсполнения" Тогда
		СсылкаОбработки = Неопределено;
		Если ТипЗнч(ПараметрыВыполненияКоманды) = Тип("Структура") Тогда
			ПараметрыВыполненияКоманды.Свойство("ДополнительнаяОбработкаСсылка", СсылкаОбработки);
		КонецЕсли;
		// Ошибки такта не роняют РЗ: ТактИсполнения перехватывает и пишет
		// в журнал регистрации (Ошибка).
		ТактИсполнения(Истина, СсылкаОбработки);
	КонецЕсли;

КонецПроцедуры

// Один такт аварийного исполнения (спека п. 3): очередь - по заявке на
// решение. Каждая заявка - в своей попытке: ошибка одной не останавливает такт.
//
// Параметры:
//  ЗаписьВБазу      - Булево - Истина: решения записываются (режим должен
//                     быть включен), журнал регистрации пишется; Ложь -
//                     «Показать без записи»: в базу ничего не пишется, писем нет.
//  СсылкаОбработки  - СправочникСсылка.ДополнительныеОтчетыИОбработки - элемент
//                     этой обработки (из параметров команды БСП); Неопределено -
//                     поиск по имени объекта.
//
// Возвращаемое значение:
//  Структура:
//   * Строки - ТаблицаЗначений - заявка / этап / проверки / решение / причина.
//   * Ошибка - Строка - текст ошибки такта (пусто - ошибок нет); при записи
//             в базу ошибка уже записана в журнал регистрации.
//
Функция ТактИсполнения(Знач ЗаписьВБазу, Знач СсылкаОбработки = Неопределено) Экспорт

	Результат = НовыйРезультатТакта();

	Попытка
		ВыполнитьТакт(Результат, ЗаписьВБазу, СсылкаОбработки);
	Исключение
		Результат.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЗаписьВБазу Тогда
			ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Настройки обработки из ХранилищеНастроек элемента справочника
// ДополнительныеОтчетыИОбработки. Чтение - в привилегированном режиме:
// настройки общие, их должен видеть и пользователь, под которым идет РЗ
// (спека п. 2).
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки,
//                    Неопределено - поиск элемента по имени объекта.
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию.
//
Функция НастройкиОбработки(Знач СсылкаОбработки = Неопределено) Экспорт

	Итог = НастройкиПоУмолчанию();
	Сохраненные = ХранилищеНастроекОбработки(СсылкаОбработки);
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Итог, Сохраненные);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Сохранение настроек обработки (форма) в ХранилищеНастроек элемента
// справочника ДополнительныеОтчетыИОбработки. Запись - в привилегированном
// режиме (спека п. 2). Изменение режима включен/выключен - запись в журнал
// регистрации (пользователь виден в журнале).
//
// Параметры:
//  Настройки       - Структура - см. НастройкиПоУмолчанию.
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки,
//                    Неопределено - поиск элемента по имени объекта.
//
Процедура СохранитьНастройки(Знач Настройки, Знач СсылкаОбработки = Неопределено) Экспорт

	Прежние = НастройкиОбработки(СсылкаОбработки);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЭлементСправочника = ЭлементОбработки(СсылкаОбработки);
		Если ЗначениеЗаполнено(ЭлементСправочника) Тогда
			ОбъектЭлемента = ЭлементСправочника.ПолучитьОбъект();
			ОбъектЭлемента.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
			ОбъектЭлемента.ОбменДанными.Загрузка = Истина;
			ОбъектЭлемента.Записать();
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСобытия = НСтр("ru = 'Настройки не сохранены: '") + ТекстОшибки;
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстСобытия);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Прежние.РежимВключен <> Настройки.РежимВключен Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Режим: %1 (было: %2)'"),
			РежимСтрокой(Настройки.РежимВключен), РежимСтрокой(Прежние.РежимВключен));
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Информация, , , ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Доступность справочника общих настроек ar_ДополнительныеНастройки (расширение
// AgentRunner подключено; обращение только по имени метаданных - см. шапку).
// Доступен - визы этапов читаются из его настроек НСИГУИДВизыЭтап1 /
// НСИГУИДВизыЭтап2 (значение базы, как у пакета ar_ПакетНСИ; настройки этапа
// нет - поле GUID настроек обработки), нет (аварийный режим без расширения) -
// всегда из настроек обработки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ДоступныОбщиеНастройки() Экспорт

	Возврат Метаданные.Справочники.Найти("ar_ДополнительныеНастройки") <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Такт

// Исполнение такта: настройки, визы этапов, очередь, решения.
Процедура ВыполнитьТакт(Результат, Знач ЗаписьВБазу, Знач СсылкаОбработки)

	Настройки = НастройкиОбработки(СсылкаОбработки);
	// Спека п. 3: режим выключен - сразу выход, ничего не пишет. «Показать без
	// записи» работает и при выключенном режиме - это просмотр, не запись.
	Если ЗаписьВБазу И НЕ Настройки.РежимВключен Тогда
		Возврат;
	КонецЕсли;

	ВизаЭтап1 = ВизаЭтапа(ГУИДВизыЭтапаДействующий(1, Настройки.ГУИДВизыЭтап1), 1, Результат, ЗаписьВБазу);
	ВизаЭтап2 = ВизаЭтапа(ГУИДВизыЭтапаДействующий(2, Настройки.ГУИДВизыЭтап2), 2, Результат, ЗаписьВБазу);
	Если Результат.Ошибка <> "" Тогда
		Возврат; // Несуществующая виза этапа - ошибка такта уже записана.
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВизаЭтап1) И НЕ ЗначениеЗаполнено(ВизаЭтап2) Тогда
		// Обе визы пустые - очередь по визам этапов не выберет ни одной заявки
		// (запрос очереди фильтрует по списку виз этапов): явный отказ с
		// указанием источников значений вместо молчаливого пустого результата.
		ОтказТакта(Результат, ЗаписьВБазу, НСтр("ru = 'Не заданы визы этапов: заполните настройки
			| НСИГУИДВизыЭтап1 и НСИГУИДВизыЭтап2 справочника дополнительных настроек AgentRunner
			| или поля GUID в форме обработки.'"));
		Возврат;
	КонецЕсли;

	Заявки = ОчередьЗаявок(Настройки, ВизаЭтап1, ВизаЭтап2);

	Для Каждого СтрокаОчереди Из Заявки Цикл
		Если Результат.Строки.Количество() >= ЛимитТакта(Настройки) Тогда
			Прервать;
		КонецЕсли;
		СтрокаИтога = Результат.Строки.Добавить();
		ИтогЗаявки = ОбработатьЗаявку(СтрокаОчереди, Настройки, ЗаписьВБазу);
		ЗаполнитьЗначенияСвойств(СтрокаИтога, ИтогЗаявки);
	КонецЦикла;

	Если ЗаписьВБазу Тогда
		ЗаписатьИтогТакта(Результат);
	КонецЕсли;

КонецПроцедуры

// Отказ такта до очереди: текст ошибки в результат и журнал регистрации.
Процедура ОтказТакта(Результат, Знач ЗаписьВБазу, Знач Причина)

	Результат.Ошибка = Причина;
	Если ЗаписьВБазу Тогда
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Ошибка, , , Причина);
	КонецЕсли;

КонецПроцедуры

// Ссылка визы этапа по действующему GUID (см. ГУИДВизыЭтапаДействующий; спека
// п. 2: строка GUID -> Справочники.бит_Визы.ПолучитьСсылку). Пустой GUID - этап
// не ведется (пустая ссылка); неверный формат или элемента нет в базе - ошибка
// такта (спека п. 2).
//
// Параметры:
//  ГуидСтрока   - Строка - действующий уникальный идентификатор визы этапа.
//  НомерЭтапа   - Число - 1 или 2 (для текста ошибки).
//  Результат    - Структура - результат такта (заполняется Ошибка).
//  ЗаписьВБазу  - Булево.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_Визы.
//
Функция ВизаЭтапа(Знач ГуидСтрока, Знач НомерЭтапа, Результат, Знач ЗаписьВБазу)

	Гуид = НРег(СокрЛП(ГуидСтрока));
	Если ПустаяСтрока(Гуид) Тогда
		Возврат Справочники.бит_Визы.ПустаяСсылка();
	КонецЕсли;

	Если НЕ СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Гуид) Тогда
		Причина = СтрШаблон(
			НСтр("ru = 'Виза этапа %1: значение «%2» в настройках - не GUID.'"),
			Формат(НомерЭтапа, "ЧГ=0"), Гуид);
		ОтказТакта(Результат, ЗаписьВБазу, Причина);
		Возврат Справочники.бит_Визы.ПустаяСсылка();
	КонецЕсли;

	Виза = Справочники.бит_Визы.ПолучитьСсылку(Новый УникальныйИдентификатор(Гуид));
	Если НЕ ОбщегоНазначения.СсылкаСуществует(Виза) Тогда
		Причина = СтрШаблон(
			НСтр("ru = 'Виза этапа %1 с GUID %2 не найдена в справочнике бит_Визы.'"),
			Формат(НомерЭтапа, "ЧГ=0"), Гуид);
		ОтказТакта(Результат, ЗаписьВБазу, Причина);
	КонецЕсли;

	Возврат Виза;

КонецФункции

// Очередь аварийного исполнения - собственный запрос по бит_УстановленныеВизы:
// активная виза без решения, виза этапа 1 или 2; заявка потока «Контрагенты»,
// проведена, не помечена на удаление, дата не раньше даты начала, не из
// исключенной внешней системы, без виз с пометкой «Требуется ручной разбор»
// (решение «Оставить»); у заявок автоактуализации вычисляется признак сценария.
// Порядок - по дате заявки. Лимит такта ограничивает выдачу и обход кандидатов
// (вызовы ВизыПользователя; см. ВыполнитьТакт).
//
// Принадлежность визы агенту - по шаблону визы: бит_ВизированиеСервер.
// ВизыПользователя(бит_ПраваУстановкиВиз), не по полю «Пользователь» записи
// визы: решение по визе этапа 1 перезаписывает поле «Пользователь» записи на
// пользователя агента, а следующая виза (этап 2) назначается механизмом
// визирования по правилам шаблона - в том числе другому пользователю маршрута
// (как у очереди пакета, СтрокиСВизойАгента). Заявки автоактуализации без виз
// (непроведенные) очередью не берутся: полный путь сценария - заполнение по
// ЕГР, запись модели, проведение - исполняет только агент НСИ.
//
// Параметры:
//  Настройки - Структура - настройки обработки.
//  ВизаЭтап1 - СправочникСсылка.бит_Визы - виза этапа 1 (пустая - этап не ведется).
//  ВизаЭтап2 - СправочникСсылка.бит_Визы - виза этапа 2 (пустая - этап не ведется).
//
// Возвращаемое значение:
//  Массив из Структура {Заявка, Этап, ИДВизы, Актуализация, ВизаЭтап1, ВизаЭтап2}.
//
Функция ОчередьЗаявок(Знач Настройки, Знач ВизаЭтап1, Знач ВизаЭтап2)

	ВизыЭтапов = Новый Массив;
	Если ЗначениеЗаполнено(ВизаЭтап1) Тогда
		ВизыЭтапов.Добавить(ВизаЭтап1);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВизаЭтап2) Тогда
		ВизыЭтапов.Добавить(ВизаЭтап2);
	КонецЕсли;

	СсылкиВИС = СсылкиИсключенныхВнешнихСистем();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
		|	Визы.Объект КАК Заявка,
		|	Визы.Виза КАК Виза,
		|	Визы.ИД КАК ИДВизы,
		|	ВЫБОР
		|		КОГДА Визы.Виза = &ВизаЭтап1
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Этап,
		|	ВЫБОР
		|		КОГДА Заявки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение)
		|			И ВЫРАЗИТЬ(Заявки.Комментарий КАК СТРОКА(500)) = &КомментарийПризнак
		|			И ВЫРАЗИТЬ(Заявки.сд_Аргументация КАК СТРОКА(500)) = &АргументацияПризнак
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Актуализация
		|ИЗ
		|	РегистрСведений.бит_УстановленныеВизы КАК Визы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ПО Визы.Объект = Заявки.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок
		|		ПО Заявки.ОписаниеОбъекта = ОписанияЗаявок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.sd_СоответствиеОбъектовВнешнихСистем КАК СоответствиеВИС
		|		ПО ВЫРАЗИТЬ(СоответствиеВИС.СсылкаБФ КАК Документ.бит_мдм_ЗаявкаНаИзменение) = Заявки.Ссылка
		|			И СоответствиеВИС.ВнешняяИнформационнаяСистема В (&ИсключенныеСистемы)
		|ГДЕ
		|	Визы.АктивнаяВиза
		|	И Визы.Решение = ЗНАЧЕНИЕ(Справочник.бит_ВидыРешенийСогласования.ПустаяСсылка)
		|	И Визы.Виза В (&ВизыЭтапов)
		|	И НЕ Визы.Комментарий ПОДОБНО ""Требуется ручной разбор%""
		|	И Заявки.Проведен
		|	И НЕ Заявки.ПометкаУдаления
		|	И Заявки.Дата >= &ДатаНачала
		|	И СоответствиеВИС.ВнешняяИнформационнаяСистема ЕСТЬ NULL
		|	И ОписанияЗаявок.Имя = &ИмяОбъекта
		|УПОРЯДОЧИТЬ ПО
		|	Заявки.Дата";

	Запрос.УстановитьПараметр("ВизаЭтап1", ВизаЭтап1);
	Запрос.УстановитьПараметр("ВизыЭтапов", ВизыЭтапов);
	Запрос.УстановитьПараметр("ДатаНачала", Настройки.ДатаНачала);
	Запрос.УстановитьПараметр("ИсключенныеСистемы", СсылкиВИС);
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяПотокаКонтрагентов());
	Запрос.УстановитьПараметр("КомментарийПризнак", ПризнакКомментарияАктуализации());
	Запрос.УстановитьПараметр("АргументацияПризнак", ПризнакАргументацииАктуализации());

	Результат = Новый Массив;
	СпискиВизПоЗаявкам = Новый Соответствие;
	Лимит = ЛимитТакта(Настройки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Количество() >= Лимит Тогда
			Прервать; // Лимит такта набран - кандидаты дальше не рассматриваются.
		КонецЕсли;
		СписокВиз = СпискиВизПоЗаявкам.Получить(Выборка.Заявка);
		Если СписокВиз = Неопределено Тогда
			// Запрос в цикле неизбежен: ВизыПользователя проверяет условия по
			// конкретной заявке (ВЫБРАТЬ РАЗРЕШЕННЫЕ внутри); обход ограничен
			// 200 кандидатами запроса очереди (как СтрокиСВизойАгента пакета).
			СписокВиз = бит_ВизированиеСервер.ВизыПользователя(
				Настройки.ПользовательАгента, Выборка.Заявка);
			СпискиВизПоЗаявкам.Вставить(Выборка.Заявка, СписокВиз);
		КонецЕсли;
		Если СписокВиз.НайтиПоЗначению(Выборка.Виза) = Неопределено Тогда
			Продолжить; // Шаблон визы не в правах пользователя агента.
		КонецЕсли;
		СтрокаОчереди = Новый Структура;
		СтрокаОчереди.Вставить("Заявка", Выборка.Заявка);
		СтрокаОчереди.Вставить("Этап", Выборка.Этап);
		СтрокаОчереди.Вставить("ИДВизы", Выборка.ИДВизы);
		СтрокаОчереди.Вставить("Актуализация", Выборка.Актуализация);
		СтрокаОчереди.Вставить("ВизаЭтап1", ВизаЭтап1);
		СтрокаОчереди.Вставить("ВизаЭтап2", ВизаЭтап2);
		Результат.Добавить(СтрокаОчереди);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Элемент справочника ДополнительныеОтчетыИОбработки этой обработки (для
// ХранилищаНастроек). Переданная ссылка проверяется на существование; иначе -
// поиск по имени объекта (запасной путь спеки п. 2).
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки,
//                    Неопределено - поиск по имени объекта.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - пустая ссылка, если не найден.
//
Функция ЭлементОбработки(Знач СсылкаОбработки)

	Если ЗначениеЗаполнено(СсылкаОбработки)
		И ОбщегоНазначения.СсылкаСуществует(СсылкаОбработки) Тогда
		Возврат СсылкаОбработки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъектаОбработки());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
		|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();

КонецФункции

// Значение ХранилищеНастроек элемента обработки (запись и чтение - привилегированно,
// спека п. 2). Элемент не найден - Неопределено.
//
// Параметры:
//  СсылкаОбработки - см. ЭлементОбработки.
//
// Возвращаемое значение:
//  Произвольное, Неопределено.
//
Функция ХранилищеНастроекОбработки(Знач СсылкаОбработки)

	Значение = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Элемент = ЭлементОбработки(СсылкаОбработки);
		Если ЗначениеЗаполнено(Элемент) Тогда
			Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, "ХранилищеНастроек");
			Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
				Значение = Значение.Получить();
			КонецЕсли;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область Заявка

// Обработка одной заявки такта. Ошибка одной заявки не останавливает такт -
// причина в строке результата и журнале регистрации.
//
// Параметры:
//  СтрокаОчереди - Структура - {Заявка, Этап, ИДВизы} из ОчередьЗаявок.
//  Настройки     - Структура - настройки обработки.
//  ЗаписьВБазу   - Булево.
//
// Возвращаемое значение:
//  Структура - заявка / этап / проверки / решение / причина.
//
Функция ОбработатьЗаявку(Знач СтрокаОчереди, Знач Настройки, Знач ЗаписьВБазу)

	Итог = НовыйСтрокаИтога(СтрокаОчереди.Заявка, СтрокаОчереди.Этап);

	Попытка
		Если СтрокаОчереди.Актуализация Тогда
			РешитьАктуализациюНаВизе(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу);
		ИначеЕсли СтрокаОчереди.Этап = 2 Тогда
			РешитьЭтапДва(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу);
		Иначе
			РешитьЭтапОдин(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу);
		КонецЕсли;
	Исключение
		Итог.Решение = МеткаОшибки();
		Итог.Причина = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьРешениеВЖурнал(СтрокаОчереди.Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Шапка заявки одним запросом (как ДанныеЗаявки пакета, ObjectModule.bsl:3189).
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура {Ссылка, Номер, Дата, ВидОперации, Предмет, Инициатор,
//  Ответственный, ХранилищеМодельОбъекта}; пустая заявка - поля пустые.
//
Функция ШапкаЗаявки(Знач Заявка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	Т.Дата КАК Дата,
		|	Т.ВидОперации КАК ВидОперации,
		|	Т.Предмет КАК Предмет,
		|	Т.сд_Инициатор КАК Инициатор,
		|	Т.Ответственный КАК Ответственный,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();
	Шапка = Новый Структура;
	Шапка.Вставить("Ссылка", Заявка);
	Шапка.Вставить("Номер", "");
	Шапка.Вставить("Дата", Дата(1, 1, 1));
	Шапка.Вставить("ВидОперации", Неопределено);
	Шапка.Вставить("Предмет", Неопределено);
	Шапка.Вставить("Инициатор", Неопределено);
	Шапка.Вставить("Ответственный", Неопределено);
	Шапка.Вставить("ХранилищеМодельОбъекта", Неопределено);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Шапка, Выборка);
	КонецЕсли;

	Возврат Шапка;

КонецФункции

// Есть ли у заявки присоединенные файлы, кроме протоколов (спека п. 3:
// «Без проверки файлов.» - файлы есть, «Без файлов.» - файлов нет). Протоколы
// пакета («Протокол проверки агентом%») и обработки («Протокол ручного
// исполнения%») файлами инициатора не считаются.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФайлыИнициатораЕСТЬ(Знач Заявка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Заявка);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Владелец
		|	И НЕ Файлы.ПометкаУдаления
		|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол проверки агентом%""
		|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол ручного исполнения%""";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Этап 1 (спека п. 3): обработка проверки данных и ЕГР; решения по порядку -
// сначала отказы, потом возвраты.
Процедура РешитьЭтапОдин(Знач СтрокаОчереди, Знач Настройки, Итог, Знач ЗаписьВБазу)

	Заявка = СтрокаОчереди.Заявка;
	Шапка = ШапкаЗаявки(Заявка);

	ПричинаНедоступности = "";
	Замечания = ЗамечанияПроверкиДанных(Заявка, ПричинаНедоступности);
	Если Замечания = Неопределено Тогда
		Итог.Проверки = ПричинаНедоступности;
		ПричинаОставить = СтрШаблон(НСтр("ru = 'обработка проверки данных недоступна: %1'"),
			ПричинаНедоступности);
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, ПричинаОставить);
		Возврат;
	КонецЕсли;

	ВводНового = (Шапка.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);

	// Отказы (спека п. 3, строки 2-3 таблицы): точный дубль, ликвидация по ЕГР.
	ОснованиеОтказа = "";
	Если ВводНового Тогда
		ОснованиеОтказа = ОснованиеОтказаВводаНового(Замечания, Шапка, Итог);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ОснованиеОтказа) Тогда
		ОтказатьЗаявку(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу, ОснованиеОтказа);
		Возврат;
	КонецЕсли;

	// Ошибка проверки - вина не инициатора, заявка остается (спека п. 3,
	// строка 5 таблицы).
	ОшибкиПроверки = ЗамечанияСтатуса(Замечания, СтатусОшибкиПроверки());
	Если ОшибкиПроверки.Количество() > 0 Тогда
		ЗамечаниеОшибки = ОшибкиПроверки[0];
		Причина = СтрШаблон(НСтр("ru = 'ошибка проверки %1: %2'"),
			ТекстЗамечания(ЗамечаниеОшибки, "name"), ТекстЗамечания(ЗамечаниеОшибки, "message"));
		Итог.Проверки = Причина;
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, Причина);
		Возврат;
	КонецЕсли;

	// Возвраты (спека п. 3, строка 6 таблицы): замечания «не пройдена».
	НеПройденные = ЗамечанияСтатуса(Замечания, СтатусНеПройдена());
	Если НеПройденные.Количество() > 0 Тогда
		Итог.Проверки = СтрШаблон(НСтр("ru = 'Обработка проверки данных: замечаний: %1.'"),
			Формат(НеПройденные.Количество(), "ЧГ=0"));
		ВернутьЗаявку(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
			НумерованныйСписок(ТекстыЗамечаний(НеПройденные)));
		Возврат;
	КонецЕсли;

	// Замечаний нет - согласование без проверки файлов (спека п. 3, строка 7).
	ПроверкиСогласования = НСтр("ru = 'Обработка проверки данных: замечаний нет.'");
	Если НЕ ПустаяСтрока(Итог.Проверки) Тогда
		ПроверкиСогласования = Итог.Проверки + " " + ПроверкиСогласования;
	КонецЕсли;
	Итог.Проверки = ПроверкиСогласования;
	Комментарий = ПрефиксКомментария() + " "
		+ ?(ФайлыИнициатораЕСТЬ(Заявка),
			НСтр("ru = 'Без проверки файлов.'"), НСтр("ru = 'Без файлов.'"));
	ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
		МеткаСогласовано(), Комментарий, Ложь);

КонецПроцедуры

// Основание отказа заявки «ввод нового» (спека п. 3, строки 2-3 таблицы):
// точный дубль существующего контрагента (замечание обработки проверки
// НетДубляИННКППНаименование, «не пройдена») либо ликвидированный контрагент
// по ЕГР. Итог.Проверки пополняется ходом ЕГР.
//
// Параметры:
//  Замечания - Массив   - замечания обработки проверки данных (Соответствия).
//  Шапка     - Структура - шапка заявки.
//  Итог      - Структура - строка результата (заполняется Проверки).
//
// Возвращаемое значение:
//  Строка - основание отказа; пусто - отказов нет.
//
Функция ОснованиеОтказаВводаНового(Знач Замечания, Знач Шапка, Итог)

	Дубль = ЗамечаниеПоКоду(Замечания, "НетДубляИННКППНаименование");
	Если Дубль <> Неопределено Тогда
		Карточка = ТекстЗамечания(Дубль, "value_in_base");
		Если ПустаяСтрока(Карточка) Тогда
			Карточка = ТекстЗамечания(Дубль, "ref_in_base");
		КонецЕсли;
		ОснованиеДубля = ?(ПустаяСтрока(Карточка), ТекстЗамечания(Дубль, "message"), Карточка);
		Возврат СтрШаблон(НСтр("ru = 'Точный дубль существующего контрагента: %1.'"), ОснованиеДубля);
	КонецЕсли;

	МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
	ИНН = НормализованноеЧислоСтроки(ЗначениеМоделиПоИмени(МодельСтало, "ИНН"));

	ПричинаЕГР = "";
	РеквизитыЕГР = ДанныеЕГРПОИНН(ИНН, ПричинаЕГР);
	Если РеквизитыЕГР = Неопределено Тогда
		// Спека п. 3, строка 4 таблицы: ЕГР недоступен - не замечание,
		// проверка пропускается, причина - в протокол.
		Итог.Проверки = СтрШаблон(НСтр("ru = 'ЕГР пропущен: %1'"), ПричинаЕГР);
		Возврат "";
	КонецЕсли;

	ДатаПрекращения = РеквизитыЕГР.ДатаПрекращенияДеятельности;
	Если ЗначениеЗаполнено(ДатаПрекращения) Тогда
		Итог.Проверки = НСтр("ru = 'ЕГР: деятельность прекращена.'");
		Возврат СтрШаблон(НСтр("ru = 'Контрагент ликвидирован %1.'"),
			Формат(ДатаПрекращения, "ДФ=dd.MM.yyyy"));
	КонецЕсли;

	Итог.Проверки = НСтр("ru = 'ЕГР: ликвидация не обнаружена.'");
	Возврат "";

КонецФункции

// Этап 2 (спека п. 3): счет из доп. реквизитов модели; согласование с
// созданием счета - в одной транзакции. Этап 2 решается в следующем такте
// после согласования этапа 1 (виза 2 станет активной).
Процедура РешитьЭтапДва(Знач СтрокаОчереди, Знач Настройки, Итог, Знач ЗаписьВБазу)

	Заявка = СтрокаОчереди.Заявка;
	Шапка = ШапкаЗаявки(Заявка);

	Контрагент = Шапка.Предмет;
	Если НЕ ЗначениеЗаполнено(Контрагент)
		Или НЕ ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
		Причина = НСтр("ru = 'контрагент заявки не создан или не существует'");
		Итог.Проверки = Причина;
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, Причина);
		Возврат;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
	Значения = ЗначенияДопРеквизитовМодели(МодельСтало);
	НомерСчета = СтрЗаменить(Строка(Значения.Получить("НомерОсновногоБанковскогоСчета")), " ", "");
	БИК = НормализованноеЧислоСтроки(Значения.Получить("БИКБанка"));

	Если ПустаяСтрока(НомерСчета) И ПустаяСтрока(БИК) Тогда
		// Спека п. 3: оба пусты - согласовать.
		Итог.Проверки = НСтр("ru = 'Банковского счета в заявке нет.'");
		ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
			МеткаСогласовано(), ПрефиксКомментария(), Ложь);
		Возврат;
	КонецЕсли;

	СчетЗаявки = СчетЗаявкиЭтапаДва(НомерСчета, БИК, Контрагент);
	Итог.Проверки = СтрШаблон(НСтр("ru = 'Счет %1, БИК %2.'"), НомерСчета, БИК);

	Если НЕ СчетЗаявки.БанкДействует Тогда
		ПричинаВозврата = СтрШаблон(НСтр("ru = 'Банк по БИК %1 не найден (или не действует).'"), БИК);
		ВернутьЗаявку(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу, ПричинаВозврата);
		Возврат;
	КонецЕсли;

	Если НЕ СчетЗаявки.КлючВерен Тогда
		ПричинаВозврата = СтрШаблон(НСтр("ru = 'Контрольный ключ счета %1 неверен для БИК %2.'"),
			НомерСчета, БИК);
		ВернутьЗаявку(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу, ПричинаВозврата);
		Возврат;
	КонецЕсли;

	// Счет создается в транзакции решения (как у пакета, agentrunner-88);
	// ошибка создания - решение не ставится, «Оставить» с причиной.
	Успешно = ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
		МеткаСогласовано(), ПрефиксКомментария(), СчетЗаявки);
	Если НЕ Успешно И Итог.Решение = МеткаОшибки() Тогда
		ПричинаОставить = СтрШаблон(НСтр("ru = 'счет контрагента не создан: %1'"), Итог.Причина);
		Итог.Решение = "";
		Итог.Причина = "";
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, ПричинаОставить);
	КонецЕсли;

КонецПроцедуры

// Заявка автоактуализации на визах агента (проведенная): непроведенные заявки
// сценария виз не имеют и очередью не берутся - полный путь (заполнение по ЕГР,
// запись модели, проведение) исполняет только агент НСИ. Здесь - продолжение
// прерванного исполнения (как АктуализацияПроведенной пакета): этап 2 при
// согласованной визе 1 - «Согласовано» с комментарием визы 1 (счет заявки
// сценарием не создается); этап 1 без решения - заявку провел не агент,
// актуализации не было - «Оставить» на ручной разбор.
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (см. ОчередьЗаявок).
//  Настройки     - Структура - настройки обработки.
//  Итог          - Структура - строка результата (заполняется).
//  ЗаписьВБазу   - Булево.
//
Процедура РешитьАктуализациюНаВизе(Знач СтрокаОчереди, Знач Настройки, Итог, Знач ЗаписьВБазу)

	Шапка = ШапкаЗаявки(СтрокаОчереди.Заявка);

	Если СтрокаОчереди.Этап <> 2 Тогда
		Причина = НСтр("ru = 'заявка автоактуализации проведена без актуализации - заполнение
			| по ЕГР и запись модели выполнит агент НСИ или сотрудник'");
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, Причина);
		Возврат;
	КонецЕсли;

	ВизаПервая = ДанныеВизыПервогоЭтапа(СтрокаОчереди);
	Если НЕ ВизаПервая.Согласована Тогда
		Причина = НСтр("ru = 'виза первого этапа не согласована'");
		ОставитьНаРучнойРазбор(СтрокаОчереди, Настройки, Итог, ЗаписьВБазу, Причина);
		Возврат;
	КонецЕсли;

	Комментарий = ВизаПервая.Комментарий;
	Если ПустаяСтрока(Комментарий) Тогда
		Комментарий = НСтр("ru = 'Актуализировано по данным ЕГРЮЛ/ЕГРИП'");
	КонецЕсли;

	Итог.Проверки = НСтр("ru = 'Заявка автоактуализации: продолжение после этапа 1.'");
	ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
		МеткаСогласовано(), ПрефиксКомментария() + " " + Комментарий, Ложь);

КонецПроцедуры

// Запись визы этапа 1 заявки (решение и комментарий) - для продолжения
// актуализации на этапе 2 (как ДанныеВизы1 и КомментарийВизы1 пакета, одним
// чтением набора виз).
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (Заявка, ВизаЭтап1).
//
// Возвращаемое значение:
//  Структура {Согласована, Комментарий} - визы этапа 1 нет - Согласована = Ложь.
//
Функция ДанныеВизыПервогоЭтапа(Знач СтрокаОчереди)

	Результат = Новый Структура;
	Результат.Вставить("Согласована", Ложь);
	Результат.Вставить("Комментарий", "");

	Если НЕ ЗначениеЗаполнено(СтрокаОчереди.ВизаЭтап1) Тогда
		Возврат Результат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СтрокаОчереди.Заявка);
	Отбор.Вставить("Виза", СтрокаОчереди.ВизаЭтап1);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ЗаписьВизы = НаборВизы[0];
	Результат.Согласована = ЗаписьВизы.Решение
		= Справочники.бит_ВидыРешенийСогласования.Согласовано;
	Результат.Комментарий = СокрЛП(Строка(ЗаписьВизы.Комментарий));

	Возврат Результат;

КонецФункции

// Замечания обработки проверки данных для заявки (спека п. 3). Подключение -
// БСП по имени объекта и публикации «Используется» (как у пакета, ObjectModule.bsl:3810);
// разбор - платформенным ЧтениеJSON. Недоступность обработки, ошибка вызова,
// непонятный ответ или checked = Ложь - Неопределено и причина (решение
// «Оставить», спека п. 3, строка 1 таблицы).
//
// Параметры:
//  Заявка              - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ПричинаНедоступности - Строка - причина недоступности (выходной).
//
// Возвращаемое значение:
//  Массив из Соответствия {code, name, status, message, value_in_request,
//  value_in_base, ref_in_base}; Неопределено - проверка недоступна.
//
Функция ЗамечанияПроверкиДанных(Знач Заявка, ПричинаНедоступности)

	ПричинаНедоступности = "";

	Обработка = ПодключитьОбработкуПроверкиДанных();
	Если Обработка = Неопределено Тогда
		ПричинаНедоступности = СтрШаблон(
			НСтр("ru = 'обработка «%1» не найдена среди опубликованных дополнительных обработок.'"),
			ИмяОбработкиПроверкиДанных());
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ТекстJSON = Обработка.РезультатПроверкиДляМодели(Заявка);
	Исключение
		ПричинаНедоступности = НСтр("ru = 'ошибка вызова: '")
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Ответ = РазобратьJSON(ТекстJSON);
	Если Ответ = Неопределено Тогда
		ПричинаНедоступности = НСтр("ru = 'ответ не разобран как JSON.'");
		Возврат Неопределено;
	КонецЕсли;

	Если Ответ.Получить("checked") <> Истина Тогда
		ПричинаНедоступности = НСтр("ru = 'обработка вернула checked = Ложь (заявка не проверена).'");
		Возврат Неопределено;
	КонецЕсли;

	Замечания = Новый Массив;
	СтрокиОтвета = Ответ.Получить("remarks");
	Если ТипЗнч(СтрокиОтвета) <> Тип("Массив") Тогда
		Возврат Замечания;
	КонецЕсли;
	Для Каждого СтрокаОтвета Из СтрокиОтвета Цикл
		Если ТипЗнч(СтрокаОтвета) = Тип("Соответствие") Тогда
			Замечания.Добавить(СтрокаОтвета);
		КонецЕсли;
	КонецЦикла;

	Возврат Замечания;

КонецФункции

// Подключенный объект обработки проверки данных - по имени объекта и
// публикации «Используется» (прецедент пакета, ObjectModule.bsl:3810-3827).
//
// Возвращаемое значение:
//  ВнешняяОбработка; Неопределено - не найдена или не подключена.
//
Функция ПодключитьОбработкуПроверкиДанных()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбработкиПроверкиДанных());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
		|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Выборка.Ссылка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Данные ЕГР по ИНН (спека п. 3, строка 3 таблицы) - единая точка
// КонтрагентыФормы.ДанныеЕдиныхГосРеестровПоИНН, как у пакета
// (ДанныеСервисаПоИНН, ObjectModule.bsl:4043): 10 знаков - юрлицо, 12 -
// предприниматель; реквизиты читаются из временного хранилища.
//
// Параметры:
//  ИНН                 - Строка - ИНН заявки.
//  ПричинаНедоступности - Строка - причина, по которой проверка пропущена
//                        (выходной); пусто - данные получены.
//
// Возвращаемое значение:
//  Структура - реквизиты сервиса (среди них ДатаПрекращенияДеятельности);
//  Неопределено - сервис недоступен или ИНН не 10/12 знаков.
//
Функция ДанныеЕГРПОИНН(Знач ИНН, ПричинаНедоступности)

	ПричинаНедоступности = "";

	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		ПричинаНедоступности = СтрШаблон(
			НСтр("ru = 'ИНН %1 не является 10- или 12-значным.'"), ИНН);
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ДанныеФормы = КонтрагентыФормы.ДанныеЕдиныхГосРеестровПоИНН(ИНН, СтрДлина(ИНН) = 10);
	Исключение
		ПричинаНедоступности = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ПустаяСтрока(Строка(ДанныеФормы.ОписаниеОшибки)) Тогда
		ПричинаНедоступности = Строка(ДанныеФормы.ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;

	АдресРеквизитов = Строка(ДанныеФормы.АдресРеквизитовКонтрагента);
	Реквизиты = ПолучитьИзВременногоХранилища(АдресРеквизитов);
	УдалитьИзВременногоХранилища(АдресРеквизитов);

	Если ТипЗнч(Реквизиты) <> Тип("Структура") Тогда
		ПричинаНедоступности = НСтр("ru = 'сервис вернул данные в неожиданном формате.'");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Реквизиты;

КонецФункции

// Решение «Отказать» (спека п. 3): виза «Отклонено», комментарий «Виза
// установлена обработкой. Отклонено без возможности исправления: <основание>»;
// письмо инициатору - по настройке.
Процедура ОтказатьЗаявку(Знач СтрокаОчереди, Знач Настройки, Знач Шапка, Итог,
	Знач ЗаписьВБазу, Знач Основание)

	Комментарий = СтрШаблон(НСтр("ru = '%1 Отклонено без возможности исправления: %2'"),
		ПрефиксКомментария(), Основание);
	ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
		МеткаОтклонено(), Комментарий, Ложь);

КонецПроцедуры

// Решение «Вернуть» (спека п. 3): виза «Отклонено» с текстом возврата
// («Возвращено на исправление: 1) … Исправьте и подайте новую заявку.»);
// письмо инициатору - по настройке. Исправление - новой заявкой штатной
// обработкой создания заявки (отклоненная заявка у инициатора - только просмотр).
Процедура ВернутьЗаявку(Знач СтрокаОчереди, Знач Настройки, Знач Шапка, Итог,
	Знач ЗаписьВБазу, Знач Основание)

	Комментарий = СтрШаблон(НСтр("ru = '%1 Возвращено на исправление: %2 Исправьте и подайте новую заявку.'"),
		ПрефиксКомментария(), Основание);
	ЗаписатьРешениеВизы(СтрокаОчереди, Настройки, Шапка, Итог, ЗаписьВБазу,
		МеткаВозвращено(), Комментарий, Ложь);

КонецПроцедуры

#КонецОбласти

#Область Решения

// Запись решения по визе (спека п. 3): в транзакции, первыми - исключительные
// блокировки бит_УстановленныеВизы по Объект и заявки по Ссылка; под
// блокировкой перепроверяется, что виза еще активна и без решения (иначе -
// пропуск: решил агент или человек). Решение ставится механизмом визирования
// «БИТ»; для этапа 2 со счетом счет создается в той же транзакции. После
// транзакции - протокол у заявки, журнал регистрации, письмо (при возврате/
// отказе - по настройке). При «Показать без записи» ничего не пишется.
//
// Параметры:
//  СтрокаОчереди - Структура - {Заявка, Этап, ИДВизы}.
//  Настройки     - Структура - настройки обработки.
//  Шапка         - Структура - шапка заявки (ШапкаЗаявки).
//  Итог          - Структура - строка результата (заполняется).
//  ЗаписьВБазу   - Булево.
//  МеткаРешения  - Строка  - «Согласовано»/«Возвращено»/«Отклонено»
//                  (МеткаСогласовано/МеткаВозвращено/МеткаОтклонено); решение
//                  визы - «Согласовано» для метки согласования, иначе «Отклонено».
//  Комментарий   - Строка  - комментарий визы (усекается до 500).
//  СчетЗаявки    - Структура, Булево - счет этапа 2 (СчетЗаявкиЭтапаДва) -
//                  создается в транзакции; Ложь - счета нет.
//
// Возвращаемое значение:
//  Булево - Истина, если решение записано (или записывать не требовалось).
//
Функция ЗаписатьРешениеВизы(Знач СтрокаОчереди, Знач Настройки, Знач Шапка, Итог,
	Знач ЗаписьВБазу, Знач МеткаРешения, Знач Комментарий, Знач СчетЗаявки)

	Согласовано = (МеткаРешения = МеткаСогласовано());

	Если НЕ ЗаписьВБазу Тогда
		Итог.Решение = МеткаРешения;
		Итог.Причина = УсечьКомментарий(Комментарий);
		Возврат Истина;
	КонецЕсли;

	Заявка = СтрокаОчереди.Заявка;
	Исход = Ложь;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДанныеРешения(Заявка);

		ПричинаПропуска = "";
		Если ПроверкаВизыПодБлокировкой(Заявка, СтрокаОчереди.ИДВизы, ПричинаПропуска) Тогда
			ОтменитьТранзакцию();
			Итог.Решение = МеткаПропущено();
			Итог.Причина = ПричинаПропуска;
			ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);
			Возврат Ложь;
		КонецЕсли;

		Если ТипЗнч(СчетЗаявки) = Тип("Структура") Тогда
			ТекстОшибки = "";
			Если НЕ СоздатьСчетЭтапаДва(СчетЗаявки, ТекстОшибки) Тогда
				ОтменитьТранзакцию();
				Итог.Решение = МеткаОшибки();
				Итог.Причина = ТекстОшибки;
				ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Ошибка);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;

		Исход = УстановитьРешениеМеханизмом(Заявка, СтрокаОчереди.ИДВизы,
			Согласовано, Комментарий, Настройки.ПользовательАгента, Итог);
		Если НЕ Исход Тогда
			ОтменитьТранзакцию();
			Итог.Решение = МеткаОшибки();
			ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Ошибка);
			Возврат Ложь;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
		Итог.Решение = МеткаОшибки();
		Итог.Причина = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Ошибка);
		Возврат Ложь;
	КонецПопытки;

	Итог.Решение = МеткаРешения;
	Итог.Причина = УсечьКомментарий(Комментарий);

	ЗаписатьПротоколРешения(Заявка, Настройки, Итог);
	ЗаписатьРешениеВЖурнал(Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);

	Если НЕ Согласовано И Настройки.ПисьмоИнициатору Тогда
		ОтправитьПисьмоРешения(Шапка, Итог.Решение, Итог.Причина);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Решение «Оставить» (спека п. 3): решение не ставится; в комментарий визы
// привилегированно пишется «Требуется ручной разбор: <причина>» (в той же
// транзакции и блокировке, как ЗаписатьКомментарийВизыПривилегированно пакета,
// ObjectModule.bsl:6441, без ar_*). Виза с этой пометкой из очереди
// исключается, пока сотрудник ее не решит. Сбой записи комментария - только
// журнал (заявка вернется следующим тактом).
Процедура ОставитьНаРучнойРазбор(Знач СтрокаОчереди, Знач Настройки, Итог,
	Знач ЗаписьВБазу, Знач Причина)

	Итог.Решение = МеткаОставлено();
	Итог.Причина = Причина;

	Если НЕ ЗаписьВБазу Тогда
		ЗаписатьРешениеВЖурнал(СтрокаОчереди.Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);
		Возврат;
	КонецЕсли;

	ТекстКомментария = УсечьКомментарий(
		СтрШаблон(НСтр("ru = 'Требуется ручной разбор: %1'"), Причина));

	Исход = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДанныеРешения(СтрокаОчереди.Заявка);

		ПричинаПропуска = "";
		Если ПроверкаВизыПодБлокировкой(СтрокаОчереди.Заявка, СтрокаОчереди.ИДВизы, ПричинаПропуска) Тогда
			ОтменитьТранзакцию();
			Итог.Решение = МеткаПропущено();
			Итог.Причина = ПричинаПропуска;
		Иначе
			Исход = ЗаписатьКомментарийВизыПривилегированно(
				СтрокаОчереди.Заявка, СтрокаОчереди.ИДВизы, ТекстКомментария);
			Если Исход Тогда
				ЗафиксироватьТранзакцию();
			Иначе
				ОтменитьТранзакцию();
			КонецЕсли;
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
	КонецПопытки;

	Если НЕ Исход Тогда
		// Спека п. 3: сбой записи комментария - только журнал, заявка
		// вернется следующим тактом.
		ТекстСобытия = СтрШаблон(
			НСтр("ru = 'Решение: %1; причина: %2 (комментарий визы не записан)'"),
			Итог.Решение, Итог.Причина);
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, СтрокаОчереди.Заявка, ТекстСобытия);
		Возврат;
	КонецЕсли;

	ЗаписатьПротоколРешения(СтрокаОчереди.Заявка, Настройки, Итог);
	ЗаписатьРешениеВЖурнал(СтрокаОчереди.Заявка, Итог, ЗаписьВБазу, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Исключительные управляемые блокировки записи решения (как у пакета,
// ЗаблокироватьДанныеРешения, ObjectModule.bsl:6009): визы заявки в
// РегистрСведений.бит_УстановленныеВизы (по полю Объект) и сама заявка в
// Документ.бит_мдм_ЗаявкаНаИзменение (по Ссылка). Вызывается внутри
// транзакции и до чтения данных.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
Процедура ЗаблокироватьДанныеРешения(Знач Заявка)

	Блокировка = Новый БлокировкаДанных;

	ЭлементВизы = Блокировка.Добавить("РегистрСведений.бит_УстановленныеВизы");
	ЭлементВизы.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементВизы.УстановитьЗначение("Объект", Заявка);

	ЭлементЗаявки = Блокировка.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
	ЭлементЗаявки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементЗаявки.УстановитьЗначение("Ссылка", Заявка);

	Блокировка.Заблокировать();

КонецПроцедуры

// Повторная проверка визы под блокировкой (как ОтказПоЗаписиВизы пакета,
// ObjectModule.bsl:5295): виза есть, активна и без решения. Иначе решение
// ставить нельзя - его уже поставил агент или человек (спека п. 3).
//
// Параметры:
//  Заявка        - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИДВизы        - Строка - идентификатор визы (бит_УстановленныеВизы.ИД).
//  ТекстПричины  - Строка - причина отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если решение по этой визе ставить нельзя.
//
Функция ПроверкаВизыПодБлокировкой(Знач Заявка, Знач ИДВизы, ТекстПричины)

	ТекстПричины = "";

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", Заявка);
	Отбор.Вставить("ИД", ИДВизы);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	Если НаборВизы.Количество() = 0 Тогда
		ТекстПричины = СтрШаблон(НСтр("ru = 'Виза с ИД %1 у заявки не найдена.'"), ИДВизы);
		Возврат Истина;
	КонецЕсли;

	ЗаписьВизы = НаборВизы[0];
	Если НЕ ЗаписьВизы.АктивнаяВиза Тогда
		ТекстПричины = НСтр("ru = 'Виза не активна - заявка ушла с этой точки визирования; пропуск.'");
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗаписьВизы.Решение) Тогда
		ТекстПричины = НСтр("ru = 'По визе уже есть решение - пропуск (решил агент или сотрудник).'");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Заполнение параметров решения и вызов механизма «БИТ» (копия
// УстановитьРешениеМеханизмом пакета, ObjectModule.bsl:6206, без ar_*).
// Транзакцию не ведет - ею управляет ЗаписатьРешениеВизы. Сообщения механизма
// визирования - в причину строки результата.
//
// Параметры:
//  Заявка        - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИДВизы        - Строка - идентификатор визы.
//  Согласовано   - Булево - Истина: «Согласовано», Ложь: «Отклонено».
//  Комментарий   - Строка - комментарий визы.
//  Пользователь  - СправочникСсылка.Пользователи - пользователь агента (от
//                  чьего имени решение).
//  Итог          - Структура - строка результата (заполняется Причина).
//
// Возвращаемое значение:
//  Булево - Истина, если механизм вернул успех.
//
Функция УстановитьРешениеМеханизмом(Знач Заявка, Знач ИДВизы, Знач Согласовано,
	Знач Комментарий, Знач Пользователь, Итог)

	// Очистка очереди сообщений: после вызова читаем только сообщения механизма.
	ПолучитьСообщенияПользователю(Истина);

	ПараметрыРешения = Обработки.бит_КонсольОперативногоВизирования.НовыеПараметрыПринятияРешения();
	ПараметрыРешения.ОбъектВизирования    = Заявка;
	ПараметрыРешения.ИДВизы               = ИДВизы;
	ПараметрыРешения.Решение              = СсылкаРешения(Согласовано);
	ПараметрыРешения.Комментарий          = УсечьКомментарий(Комментарий);
	ПараметрыРешения.ДатаУстановкиРешения = ТекущаяДатаСеанса();
	ПараметрыРешения.ТекущийПользователь  = Пользователь;
	// ПроводитьПослеУтверждения остается как заполнила НовыеПараметрыПринятияРешения
	// (функциональная опция бит_ПроводитьДокументыПослеУтверждения).

	Исход = Ложь;
	ТекстОшибки = "";
	Попытка
		Исход = sd_Оптимизация_ФоновоеВизированиеСервер.УстановитьРешениеПоВизе(ПараметрыРешения);
	Исключение
		Исход = Ложь;
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТекстСообщенийМеханизма = СообщенияМеханизмаСтрокой();
	Если НЕ ПустаяСтрока(ТекстСообщенийМеханизма) Тогда
		Итог.Причина = ТекстСообщенийМеханизма; // В причину отказа (спека п. 3).
	КонецЕсли;
	Если НЕ Исход И ПустаяСтрока(Итог.Причина) Тогда
		Итог.Причина = ?(ПустаяСтрока(ТекстОшибки),
			НСтр("ru = 'Механизм визирования не принял решение.'"), ТекстОшибки);
	КонецЕсли;
	Если НЕ Исход И НЕ ПустаяСтрока(ТекстОшибки) И Итог.Причина <> ТекстОшибки Тогда
		Итог.Причина = Итог.Причина + " " + ТекстОшибки;
	КонецЕсли;

	Возврат Исход;

КонецФункции

// Предопределенное решение по признаку согласования (как СсылкаРешенияПоКоду
// пакета, ObjectModule.bsl:6511): согласование - «Согласовано», отказ и
// возврат - «Отклонено».
//
// Параметры:
//  Согласовано - Булево.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_ВидыРешенийСогласования.
//
Функция СсылкаРешения(Знач Согласовано)

	Если Согласовано Тогда
		Возврат Справочники.бит_ВидыРешенийСогласования.Согласовано;
	КонецЕсли;
	Возврат Справочники.бит_ВидыРешенийСогласования.Отклонено;

КонецФункции

// Накопленные сообщения пользователю одной строкой (механизм визирования
// сообщает через СообщитьПользователю - как у пакета, ObjectModule.bsl:6522).
//
// Возвращаемое значение:
//  Строка.
//
Функция СообщенияМеханизмаСтрокой()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Строки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Сообщение.Текст)) Тогда
			Строки.Добавить(СокрЛП(Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, " ");

КонецФункции

// Запись комментария визы привилегированно (копия
// ЗаписатьКомментарийВизыПривилегированно пакета, ObjectModule.bsl:6441,
// без ar_*): в записи бит_УстановленныеВизы этой визы меняется только ресурс
// Комментарий. Вызывается внутри транзакции, под исключительной блокировкой;
// подъем привилегированного режима - только на чтение-запись набора визы.
//
// Параметры:
//  Заявка          - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИДВизы          - Строка - идентификатор визы.
//  ТекстКомментария - Строка - текст комментария (не длиннее 500).
//
// Возвращаемое значение:
//  Булево - Истина, если комментарий записан.
//
Функция ЗаписатьКомментарийВизыПривилегированно(Знач Заявка, Знач ИДВизы, Знач ТекстКомментария)

	Исход = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Отбор = Новый Структура;
		Отбор.Вставить("Объект", Заявка);
		Отбор.Вставить("ИД", ИДВизы);
		НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

		Если НаборВизы.Количество() > 0 Тогда
			НаборВизы[0].Комментарий = ТекстКомментария;
			НаборВизы.Записать(Истина);
			Исход = Истина;
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Исход;

КонецФункции

#КонецОбласти

#Область СчетЭтапаДва

// Счет заявки для этапа 2 (копия СчетЗаявкиЭтапаДва пакета,
// ObjectModule.bsl:14577, без ar_*): банк по БИК, ключ счета, есть ли уже
// такой счет у контрагента заявки.
//
// Параметры:
//  НомерСчета - Строка - номер счета из доп. реквизита модели (без пробелов).
//  БИК        - Строка - БИК банка из доп. реквизита модели (только цифры).
//  Контрагент - СправочникСсылка.Контрагенты.
//
// Возвращаемое значение:
//  Структура {НомерСчета, БИК, Контрагент, Банк, БанкДействует, КлючВерен,
//  СчетУКонтрагента}.
//
Функция СчетЗаявкиЭтапаДва(Знач НомерСчета, Знач БИК, Знач Контрагент)

	Результат = Новый Структура;
	Результат.Вставить("НомерСчета", НомерСчета);
	Результат.Вставить("БИК", БИК);
	Результат.Вставить("Контрагент", Контрагент);
	Результат.Вставить("Банк", Справочники.Банки.ПустаяСсылка());
	Результат.Вставить("БанкДействует", Ложь);
	Результат.Вставить("КлючВерен", Ложь);
	Результат.Вставить("СчетУКонтрагента", Ложь);

	Банк = Неопределено;
	Найден = Ложь;
	Действует = Ложь;
	Банк = БанкПоБик(БИК, Найден, Действует);
	Если Найден Тогда
		Результат.Банк = Банк;
		Результат.БанкДействует = Действует;
	КонецЕсли;

	Результат.КлючВерен = КлючСчетаКорректен(НомерСчета, БИК);

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Владелец
		|	И Счета.НомерСчета = &НомерСчета
		|	И НЕ Счета.ПометкаУдаления";
	Результат.СчетУКонтрагента = НЕ Запрос.Выполнить().Пустой();

	Возврат Результат;

КонецФункции

// Создание банковского счета контрагента при согласовании этапа 2 (копия
// СоздатьСчетЭтапаДва пакета, ObjectModule.bsl:6067, без ar_*). Вызывается в
// транзакции решения, под исключительной блокировкой: счет с этим номером у
// этого контрагента - используется (повторное согласование не задваивает),
// такой же счет у другого контрагента не мешает (agentrunner-213); банк
// перепроверяется под блокировкой; основной счет контрагента - если пуст.
//
// Параметры:
//  СчетЗаявки  - Структура - см. СчетЗаявкиЭтапаДва (нужен Контрагент).
//  ТекстОшибки - Строка    - текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если счет есть у контрагента (создан или существовал).
//
Функция СоздатьСчетЭтапаДва(Знач СчетЗаявки, ТекстОшибки)

	ТекстОшибки = "";
	Контрагент = СчетЗаявки.Контрагент;

	// Счет с этим номером у этого контрагента уже есть - используется.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерСчета", СчетЗаявки.НомерСчета);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Контрагент
		|	И Счета.НомерСчета = &НомерСчета
		|	И НЕ Счета.ПометкаУдаления";
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	// Банк перепроверяется под блокировкой (мог измениться).
	Банк = Неопределено;
	Найден = Ложь;
	Действует = Ложь;
	Банк = БанкПоБик(СчетЗаявки.БИК, Найден, Действует);
	Если НЕ Найден Или НЕ Действует Или НЕ КлючСчетаКорректен(СчетЗаявки.НомерСчета, СчетЗаявки.БИК) Тогда
		ТекстОшибки =
			НСтр("ru = 'Банк не найден, не действует или ключ счета неверен - счет не создан.'");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("НомерСчета", СчетЗаявки.НомерСчета);
		ДанныеЗаполнения.Вставить("Банк", Банк);
		ДанныеЗаполнения.Вставить("Владелец", Контрагент);

		СчетОбъект = Справочники.БанковскиеСчета.СоздатьЭлемент();
		СчетОбъект.Заполнить(ДанныеЗаполнения);
		СчетОбъект.Записать();
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	// Основной счет контрагента - если пуст. Контрагент пишется с
	// ЗаписьБезПроверок - иначе ПередЗаписью контрагента отказывает
	// пользователю без права редактирования НСИ (agentrunner-213, 2.4.1).
	// Контрагент открыт другим пользователем - основной счет не ставится
	// (как в типовой процедуре), решение по визе не срывается.
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контрагент);
		Блокировка.Заблокировать();

		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентЗаблокирован = Истина;
		Попытка
			КонтрагентОбъект.Заблокировать();
		Исключение
			КонтрагентЗаблокирован = Ложь;
			СобытиеБлокировки = НСтр("ru = 'Не удалось заблокировать объект.'",
				ОбщегоНазначения.КодОсновногоЯзыка());
			ТекстЖурнала = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(СобытиеБлокировки, УровеньЖурналаРегистрации.Предупреждение,
				, КонтрагентОбъект, ТекстЖурнала);
		КонецПопытки;

		Если КонтрагентЗаблокирован
			И НЕ ЗначениеЗаполнено(КонтрагентОбъект.ОсновнойБанковскийСчет) Тогда
			КонтрагентОбъект.ОсновнойБанковскийСчет = СчетОбъект.Ссылка;
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			КонтрагентОбъект.ДополнительныеСвойства.Вставить("ЗаписьБезПроверок", Истина);
			КонтрагентОбъект.ДополнительныеСвойства.Вставить("ТолькоЗапись", Истина);
			КонтрагентОбъект.Записать();
		КонецЕсли;
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Банк по БИК: найден и действует (не помечен на удаление и не отмечен как
// недействующий) - РаботаСБанкамиБП.НайтиБанк (копия БанкПоБик пакета,
// ObjectModule.bsl:11132).
//
// Параметры:
//  БИК       - Строка - БИК банка.
//  Найден    - Булево - банк найден в справочнике (выходной).
//  Действует - Булево - найден и действует (выходной).
//
// Возвращаемое значение:
//  СправочникСсылка.Банки - пустая ссылка, если не найден.
//
Функция БанкПоБик(Знач БИК, Найден = Ложь, Действует = Ложь)

	Найден = Ложь;
	Действует = Ложь;

	Если НЕ БИККорректен(БИК) Тогда
		Возврат Справочники.Банки.ПустаяСсылка();
	КонецЕсли;

	Банк = РаботаСБанкамиБП.НайтиБанк(БИК);
	Если НЕ ЗначениеЗаполнено(Банк) Тогда
		Возврат Справочники.Банки.ПустаяСсылка();
	КонецЕсли;

	Найден = Истина;
	РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, "ПометкаУдаления, РучноеИзменение");
	Действует = (НЕ РеквизитыБанка.ПометкаУдаления И РеквизитыБанка.РучноеИзменение <> 3);

	Возврат Банк;

КонецФункции

// БИК корректен: 9 цифр, код банка РФ (БанковскиеПравила.ЭтоБИКБанкаРФ;
// копия БИККорректен пакета, ObjectModule.bsl:11029).
//
// Возвращаемое значение:
//  Булево.
//
Функция БИККорректен(Знач БИК)

	Возврат СтрДлина(БИК) = 9 И БанковскиеПравила.ЭтоБИКБанкаРФ(БИК);

КонецФункции

// Контрольный ключ расчетного счета верен для БИК
// (БанковскиеПравила.ПроверитьКонтрольныйКлючВНомереБанковскогоСчета, письмо
// ЦБР 515; копия КлючСчетаКорректен пакета, ObjectModule.bsl:11042).
//
// Возвращаемое значение:
//  Булево.
//
Функция КлючСчетаКорректен(Знач НомерСчета, Знач БИК)

	Возврат БанковскиеПравила.ПроверитьКонтрольныйКлючВНомереБанковскогоСчета(НомерСчета, БИК);

КонецФункции

#КонецОбласти

#Область Модель

// Модель из хранилища заявки (копия МодельИзХранилища пакета,
// ObjectModule.bsl:8872): Структура или Соответствие; иначе Неопределено.
//
// Параметры:
//  Хранилище - ХранилищеЗначения - реквизит ХранилищеМодельОбъекта.
//
// Возвращаемое значение:
//  Структура, Соответствие, Неопределено.
//
Функция МодельИзХранилища(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Модель = Хранилище.Получить();
	Если ТипЗнч(Модель) = Тип("Структура") Или ТипЗнч(Модель) = Тип("Соответствие") Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение реквизита из модели «стало»: Реквизиты, затем СтандартныеРеквизиты
// (копия ЗначениеМоделиПоИмени пакета, ObjectModule.bsl:8824).
//
// Параметры:
//  МодельСтало   - Структура, Соответствие, Неопределено.
//  ИмяРеквизита  - Строка.
//
// Возвращаемое значение:
//  Произвольное, Неопределено - модель или ключ отсутствуют.
//
Функция ЗначениеМоделиПоИмени(Знач МодельСтало, Знач ИмяРеквизита)

	Если МодельСтало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ЗначениеИзКоллекцииМодели(ЗначениеИзКоллекцииМодели(МодельСтало, "Реквизиты"), ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Значение = ЗначениеИзКоллекцииМодели(
			ЗначениеИзКоллекцииМодели(МодельСтало, "СтандартныеРеквизиты"), ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Значение из коллекции модели (Структура - по свойству, Соответствие - по
// ключу); Неопределено - нет (копия ЗначениеИзКоллекцииМодели пакета,
// ObjectModule.bsl:8856).
//
// Параметры:
//  Коллекция - Структура, Соответствие, произвольное.
//  Ключ      - Строка.
//
// Возвращаемое значение:
//  Произвольное, Неопределено.
//
Функция ЗначениеИзКоллекцииМодели(Знач Коллекция, Знач Ключ)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Дополнительные реквизиты модели «стало» по программным именам свойств
// (реквизит Имя ПВХ ДополнительныеРеквизитыИСведения; значение - ТекстоваяСтрока
// либо представление значения; копия ЗначенияДопРеквизитовМодели пакета,
// ObjectModule.bsl:10525, прием обработки проверки).
//
// Параметры:
//  Модель - Структура, Соответствие, Неопределено - модель заявки «стало».
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> строка значения.
//
Функция ЗначенияДопРеквизитовМодели(Знач Модель)

	Значения = Новый Соответствие;
	Таблица = ТаблицаМоделиТЧ(Модель, "ДополнительныеРеквизиты");
	Если Таблица = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;

	Свойства = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство");
		Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения")
			И ЗначениеЗаполнено(Свойство) Тогда
			Свойства.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;

	Если Свойства.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;

	// Имена всех свойств одним вызовом БСП - не в цикле к базе (стандарт).
	ИменаСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Свойства, "Имя");
	КодыБанков = КодыБанковДопРеквизитовМодели(Таблица);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство");
		ИмяРеквизита = ИменаСвойств.Получить(Свойство);
		Если ТипЗнч(ИмяРеквизита) <> Тип("Строка") Или ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(ИмяРеквизита,
			ЗначениеСтрокиДопРеквизитаМодели(СтрокаТаблицы, КодыБанков));
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Таблица модели по имени табличной части; массив строк либо Неопределено
// (копия ТаблицаМоделиТЧ пакета, ObjectModule.bsl:10562).
//
// Параметры:
//  Модель     - Структура, Соответствие, Неопределено.
//  ИмяТаблицы - Строка.
//
// Возвращаемое значение:
//  Массив, Неопределено.
//
Функция ТаблицаМоделиТЧ(Знач Модель, Знач ИмяТаблицы)

	ГруппаТЧ = ЗначениеИзКоллекцииМодели(Модель, "ТабличныеЧасти");
	Если ГруппаТЧ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Таблица = ЗначениеИзКоллекцииМодели(ГруппаТЧ, ИмяТаблицы);
	Если ТипЗнч(Таблица) = Тип("Массив") Тогда
		Возврат Таблица;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение строки ТЧ ДополнительныеРеквизиты модели: ТекстоваяСтрока, если
// заполнена; банк (доп. реквизит БИКБанка типа Справочник.Банки) - кодом, то
// есть БИК; иначе представление значения (копия ЗначениеСтрокиДопРеквизитаМодели
// пакета, ObjectModule.bsl:10590).
//
// Параметры:
//  СтрокаТаблицы - Соответствие, Структура - строка ТЧ модели.
//  КодыБанков    - Соответствие, Неопределено - банк -> код
//                  (КодыБанковДопРеквизитовМодели); Неопределено - код банка
//                  читается из базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеСтрокиДопРеквизитаМодели(Знач СтрокаТаблицы, Знач КодыБанков = Неопределено)

	ТекстоваяСтрока = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "ТекстоваяСтрока");
	Если ТипЗнч(ТекстоваяСтрока) = Тип("Строка") И НЕ ПустаяСтрока(ТекстоваяСтрока) Тогда
		Возврат СокрЛП(ТекстоваяСтрока);
	КонецЕсли;

	Значение = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Значение");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Если КодыБанков = Неопределено Тогда
			КодБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Код");
		Иначе
			КодБанка = КодыБанков.Получить(Значение);
		КонецЕсли;
		Возврат СокрЛП(Строка(КодБанка));
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Коды (БИК) банков, указанных в значениях ТЧ ДополнительныеРеквизиты модели,
// одним вызовом БСП - не в цикле к базе (стандарт; копия
// КодыБанковДопРеквизитовМодели пакета, ObjectModule.bsl:10627).
//
// Параметры:
//  Таблица - Массив - строки ТЧ ДополнительныеРеквизиты модели.
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.Банки -> Строка (код).
//
Функция КодыБанковДопРеквизитовМодели(Знач Таблица)

	Банки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значение = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Значение");
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") И ЗначениеЗаполнено(Значение)
			И Банки.Найти(Значение) = Неопределено Тогда
			Банки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Если Банки.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Банки, "Код");

КонецФункции

// Только цифры строки: разделители и оформление отбрасываются (копия
// НормализованноеЧислоСтроки пакета, ObjectModule.bsl:17795).
//
// Параметры:
//  Строка - Произвольное.
//
// Возвращаемое значение:
//  Строка - только цифры.
//
Функция НормализованноеЧислоСтроки(Знач Строка)

	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Если ТипЗнч(Строка) = Тип("Число") Тогда
			Возврат Формат(Строка, "ЧН=0; ЧГ=0");
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;

КонецФункции

#КонецОбласти

#Область Протокол

// Протокол решения или «Оставить» (спека п. 3): присоединенный файл
// «Протокол ручного исполнения <дата>» у заявки (БСП РаботаСФайлами). Сбой
// записи - журнал регистрации (Предупреждение), решение не отменяется.
//
// Параметры:
//  Заявка     - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Настройки  - Структура - настройки обработки (ПользовательАгента - автор).
//  Итог       - Структура - строка результата (решение, проверки, причина).
//
Процедура ЗаписатьПротоколРешения(Знач Заявка, Знач Настройки, Знач Итог)

	Части = Новый Массив;
	СтрокаБлока = СтрШаблон(НСтр("ru = 'Заявка: %1 (этап %2)'"), Строка(Заявка), Итог.Этап);
	Части.Добавить(СтрокаБлока);
	СтрокаБлока = СтрШаблон(НСтр("ru = 'Решение: %1'"), Итог.Решение);
	Части.Добавить(СтрокаБлока);
	Если НЕ ПустаяСтрока(Итог.Проверки) Тогда
		СтрокаБлока = СтрШаблон(НСтр("ru = 'Проверки: %1'"), Итог.Проверки);
		Части.Добавить(СтрокаБлока);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Итог.Причина) Тогда
		СтрокаБлока = СтрШаблон(НСтр("ru = 'Причина: %1'"), Итог.Причина);
		Части.Добавить(СтрокаБлока);
	КонецЕсли;

	ТекстБлока = СтрСоединить(Части, Символы.ПС);
	ЗаписьФайла = ЗаписатьПротокол(Заявка, Настройки.ПользовательАгента, ТекстБлока);
	Если НЕ ЗаписьФайла.Успех Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Протокол не записан: %1'"), ЗаписьФайла.Ошибка);
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Заявка, ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Запись блока протокола у заявки (копия ДописатьФайлПротоколаПривилегированно
// пакета, ObjectModule.bsl:9710, без ar_*): существующий файл протокола за
// день дописывается блоком, новый - создается.
//
// Параметры:
//  Заявка             - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ПользовательАгента - СправочникСсылка.Пользователи - автор нового файла.
//  ТекстБлока         - Строка - блок протокола (без заголовка).
//
// Возвращаемое значение:
//  Структура {Успех - Булево, Ошибка - Строка}.
//
Функция ЗаписатьПротокол(Знач Заявка, Знач ПользовательАгента, Знач ТекстБлока)

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	ТекстБлокаСЗаголовком = ЗаголовокБлокаПротокола() + Символы.ПС + ТекстБлока;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если НЕ РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Заявка) Тогда
			Результат.Ошибка = НСтр("ru = 'К заявке нельзя присоединять файлы
				| (присоединенные файлы отключены для этого вида объектов).'");
		Иначе
			Дописан = Ложь;
			// Во внешней транзакции сбой дописывания испортил бы ее - только новый файл.
			Если НЕ ТранзакцияАктивна() Тогда
				ФайлПротокола = ФайлПротоколаЗаявки(Заявка, ИмяФайлаПротокола());
				Если ЗначениеЗаполнено(ФайлПротокола) Тогда
					Дописан = ДописатьБлокВФайлПротокола(ФайлПротокола, ТекстБлокаСЗаголовком);
				КонецЕсли;
			КонецЕсли;
			Если НЕ Дописан Тогда
				ДобавитьФайлПротокола(Заявка, ИмяФайлаПротокола(), ТекстБлокаСЗаголовком, ПользовательАгента);
			КонецЕсли;
			Результат.Успех = Истина;
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Новый текстовый файл протокола у заявки через БСП
// РаботаСФайлами.ПараметрыДобавленияФайла + ДобавитьФайл (копия
// ДобавитьФайлПротокола пакета, ObjectModule.bsl:9762): адрес текста
// передается третьим параметром - БСП сразу ставит статус «Извлечен». Вызывается
// в привилегированном режиме, ошибки - исключением.
//
// Параметры:
//  Заявка             - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ИмяФайла           - Строка - имя без расширения (расширение - txt).
//  ТекстФайла         - Строка - содержимое файла.
//  ПользовательАгента - СправочникСсылка.Пользователи - автор файла.
//
Процедура ДобавитьФайлПротокола(Знач Заявка, Знач ИмяФайла, Знач ТекстФайла,
	Знач ПользовательАгента)

	Адреса = АдресаТекстаПротоколаВХранилище(ТекстФайла);

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Заявка;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайла;
	ПараметрыФайла.РасширениеБезТочки = "txt";
	Если ЗначениеЗаполнено(ПользовательАгента) Тогда
		ПараметрыФайла.Автор = ПользовательАгента;
	КонецЕсли;

	Попытка
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адреса.Данные, Адреса.Текст);
	Исключение
		ОсвободитьАдресаТекстаПротокола(Адреса);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьАдресаТекстаПротокола(Адреса);

КонецПроцедуры

// Дописывает блок в конец существующего файла протокола (копия
// ДописатьБлокВФайлПротокола пакета, ObjectModule.bsl:9796). Сбой (файл занят,
// не читается) - запись в журнал регистрации, файл не меняется.
//
// Параметры:
//  ФайлПротокола - СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы.
//  ТекстБлока    - Строка - блок с заголовком.
//
// Возвращаемое значение:
//  Булево - Истина, если блок дописан.
//
Функция ДописатьБлокВФайлПротокола(Знач ФайлПротокола, Знач ТекстБлока)

	Попытка
		ДописатьБлокВФайлПротоколаВТранзакции(ФайлПротокола, ТекстБлока);
	Исключение
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			, ФайлПротокола, СтрШаблон(НСтр("ru = 'Протокол не дописан: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Транзакция дописывания (копия ДописатьБлокВФайлПротоколаВТранзакции пакета,
// ObjectModule.bsl:9821): исключительная блокировка файла, чтение текста,
// добавление блока, обновление файла через БСП РаботаСФайлами.ОбновитьФайл
// (данные и текст - статус «Извлечен»). Текст не прочитан - исключение
// (прежние блоки не затираются). Ошибки - исключением после отмены транзакции.
//
// Параметры:
//  ФайлПротокола - СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы.
//  ТекстБлока    - Строка - блок с заголовком.
//
Процедура ДописатьБлокВФайлПротоколаВТранзакции(Знач ФайлПротокола, Знач ТекстБлока)

	Адреса = Неопределено;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлПротокола);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		ТекстФайла = ТекстПротоколаФайла(ФайлПротокола);
		Если ПустаяСтрока(ТекстФайла) Тогда
			ВызватьИсключение НСтр("ru = 'Текст файла протокола не прочитан.'");
		КонецЕсли;

		Адреса = АдресаТекстаПротоколаВХранилище(ТекстФайла + Символы.ПС + Символы.ПС + ТекстБлока);
		ИнформацияОФайле = Новый Структура;
		ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", Адреса.Данные);
		ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", Адреса.Текст);
		РаботаСФайлами.ОбновитьФайл(ФайлПротокола, ИнформацияОФайле);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОсвободитьАдресаТекстаПротокола(Адреса);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьАдресаТекстаПротокола(Адреса);

КонецПроцедуры

// Текст файла протокола из БСП (копия ТекстПротоколаФайла пакета,
// ObjectModule.bsl:14852: РаботаСФайлами.ДвоичныеДанныеФайла). Нечитаемый
// файл - пустая строка.
//
// Параметры:
//  ФайлПротокола - СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстПротоколаФайла(Знач ФайлПротокола)

	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлПротокола, Ложь);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);

КонецФункции

// Последний (по дате создания) не помеченный на удаление файл протокола
// заявки с данным именем, без хранения версий (копия ФайлПротоколаЗаявки
// пакета, ObjectModule.bsl:9865). Запрос без РАЗРЕШЕННЫЕ - вызывается в
// привилегированном режиме.
//
// Параметры:
//  Заявка   - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ИмяФайла - Строка - имя без расширения.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы, Неопределено.
//
Функция ФайлПротоколаЗаявки(Знач Заявка, Знач ИмяФайла)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Заявка);
	Запрос.УстановитьПараметр("Имя", ИмяФайла);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Владелец
		|	И НЕ Файлы.ПометкаУдаления
		|	И НЕ Файлы.ХранитьВерсии
		|	И Файлы.Наименование = &Имя
		|	И Файлы.Расширение = ""txt""
		|УПОРЯДОЧИТЬ ПО
		|	Файлы.ДатаСоздания УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Текст протокола - двоичные данные UTF-8 без BOM во временном хранилище по
// двум адресам: данные файла и текст для БСП (копия
// АдресаТекстаПротоколаВХранилище пакета, ObjectModule.bsl:9902).
//
// Параметры:
//  ТекстФайла - Строка.
//
// Возвращаемое значение:
//  Структура {Данные, Текст - Строка} - адреса во временном хранилище.
//
Функция АдресаТекстаПротоколаВХранилище(Знач ТекстФайла)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстФайла, КодировкаТекста.UTF8, Ложь);
	ИдентификаторХранения = Новый УникальныйИдентификатор;

	Адреса = Новый Структура;
	Адреса.Вставить("Данные", ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения));
	Адреса.Вставить("Текст", ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения));
	Возврат Адреса;

КонецФункции

// Освобождает адреса временного хранилища текста протокола (значения, не
// являющиеся адресом, пропускаются; копия пакета, ObjectModule.bsl:9920).
//
// Параметры:
//  Адреса - Структура, Неопределено - см. АдресаТекстаПротоколаВХранилище.
//
Процедура ОсвободитьАдресаТекстаПротокола(Знач Адреса)

	Если Адреса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Адреса Цикл
		Если ЭтоАдресВременногоХранилища(КлючИЗначение.Значение) Тогда
			УдалитьИзВременногоХранилища(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Имя файла протоколов аварийного исполнения (как у пакета было в v2 и как
// его учитывают отборы пакета 2.5.19): суффикс - дата такта; блоки решений
// дописываются в один файл за день.
//
// Возвращаемое значение:
//  Строка - имя без расширения.
//
Функция ИмяФайлаПротокола()

	Возврат СтрШаблон(НСтр("ru = 'Протокол ручного исполнения %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));

КонецФункции

// Заголовок блока протокола: разделитель, дата и время записи блока (копия
// пакета, ObjectModule.bsl:9938).
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗаголовокБлокаПротокола()

	Возврат СтрШаблон("%1 %2 %1", "=====",
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

КонецФункции

#КонецОбласти

#Область Письмо

// Письмо инициатору при возврате и отказе (спека п. 4): адресат -
// сд_Инициатор заявки, при пустом - Ответственный; адрес - БСП
// УправлениеКонтактнойИнформацией; учетная запись - системная БСП; отправка -
// РаботаСПочтовымиСообщениями.ОтправитьПисьмо. Нет адресата, адреса или
// ошибка отправки - запись в журнал регистрации (Предупреждение); решение по
// визе не отменяется (вызывается после записи решения).
//
// Параметры:
//  Шапка      - Структура - шапка заявки (ШапкаЗаявки).
//  МеткаРешения - Строка - «Возвращено»/«Отклонено» (для темы и текста).
//  Комментарий - Строка - текст решения (комментарий визы).
//
Процедура ОтправитьПисьмоРешения(Знач Шапка, Знач МеткаРешения, Знач Комментарий)

	Адресат = Шапка.Инициатор;
	Если НЕ ЗначениеЗаполнено(Адресат) Тогда
		Адресат = Шапка.Ответственный;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Адресат) Тогда
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Шапка.Ссылка,
			НСтр("ru = 'Письмо не отправлено: у заявки не заполнены инициатор и ответственный.'"));
		Возврат;
	КонецЕсли;

	Адрес = АдресПользователя(Адресат);
	Если ПустаяСтрока(Адрес) Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru = 'Письмо не отправлено: у пользователя %1 нет адреса электронной почты.'"),
			Строка(Адресат));
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Шапка.Ссылка, ТекстСобытия);
		Возврат;
	КонецЕсли;

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Шапка.Ссылка,
			НСтр("ru = 'Письмо не отправлено: не настроена системная учетная запись электронной почты.'"));
		Возврат;
	КонецЕсли;

	СуффиксТемы = ?(МеткаРешения = МеткаОтклонено(),
		НСтр("ru = 'отклонена'"), НСтр("ru = 'возвращена на исправление'"));
	Тема = СтрШаблон(НСтр("ru = 'Заявка № %1 %2'"), СокрЛП(Шапка.Номер), СуффиксТемы);

	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить(Комментарий);
	СтрокаТекста = СтрШаблон(НСтр("ru = 'Заявка: %1 от %2 (%3).'"),
		Шапка.Номер, Формат(Шапка.Дата, "ДФ=dd.MM.yyyy"), Строка(Шапка.Предмет));
	ЧастиТекста.Добавить(СтрокаТекста);
	СтрокаТекста = СтрШаблон(НСтр("ru = 'Ссылка на заявку: %1'"),
		ПолучитьНавигационнуюСсылку(Шапка.Ссылка));
	ЧастиТекста.Добавить(СтрокаТекста);
	Если МеткаРешения = МеткаВозвращено() Тогда
		ЧастиТекста.Добавить(НСтр("ru = 'Подайте новую заявку с исправлениями.'"));
	КонецЕсли;
	ЧастиТекста.Добавить("");
	ЧастиТекста.Добавить(ПодвалПисьма());

	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Тема = Лев(СокрЛП(Тема), 250);
	Письмо.Тексты.Добавить(СтрСоединить(ЧастиТекста, Символы.ПС),
		ТипТекстаПочтовогоСообщения.ОбычныйТекст);
	Письмо.Получатели.Добавить(Адрес);

	Попытка
		// Отправка с явно заданной записью - в привилегированном режиме
		// (реквизиты записи под RLS; как в ar_Уведомления.ОтправитьПисьмоПоДиалогу).
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Письмо не отправлено: %1'"), ТекстОшибки);
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Шапка.Ссылка, ТекстСобытия);
	КонецПопытки;

КонецПроцедуры

// Подвал письма: «Письмо отправлено автоматически из базы <имя>.» - имя базы
// из строки соединения (File или Ref); не определено - без имени базы.
//
// Возвращаемое значение:
//  Строка - текст подвала.
//
Функция ПодвалПисьма()

	ИмяБазы = "";
	ПараметрыСоединения = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(
		СтрокаСоединенияИнформационнойБазы());
	Если ПараметрыСоединения.Свойство("File") Тогда
		ИмяБазы = ПараметрыСоединения.File;
	КонецЕсли;
	Если ПустаяСтрока(ИмяБазы) И ПараметрыСоединения.Свойство("Ref") Тогда
		ИмяБазы = ПараметрыСоединения.Ref;
	КонецЕсли;

	Если ПустаяСтрока(ИмяБазы) Тогда
		Возврат НСтр("ru = 'Письмо отправлено автоматически.'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Письмо отправлено автоматически из базы %1.'"), ИмяБазы);

КонецФункции

// Адрес электронной почты пользователя (БСП УправлениеКонтактнойИнформацией;
// как EmailПользователя ar_Уведомления: чтение - в привилегированном режиме).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Строка - адрес; пусто - адреса нет или ошибка чтения.
//
Функция АдресПользователя(Знач Пользователь)

	Адрес = "";
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Пользователь, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, Неопределено, Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Адрес почты не прочитан: %1'"), ТекстОшибки);
		ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Предупреждение,
			, Пользователь, ТекстСобытия);
		Возврат "";
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если НЕ ПустаяСтрока(Представление) Тогда
			Возврат Представление;
		КонецЕсли;
	КонецЦикла;

	Возврат Адрес;

КонецФункции

#КонецОбласти

#Область Журнал

// Запись решения по заявке в журнал регистрации (спека п. 6: заявка, этап,
// решение, причина). При «Показать без записи» ничего не пишет.
Процедура ЗаписатьРешениеВЖурнал(Знач Заявка, Знач Итог, Знач ЗаписьВБазу, Знач Уровень)

	Если НЕ ЗаписьВБазу Тогда
		Возврат;
	КонецЕсли;
	ТекстСобытия = СтрШаблон(НСтр("ru = 'Этап: %1; решение: %2; причина: %3'"),
		Итог.Этап, Итог.Решение, Итог.Причина);
	ЗаписьЖурналаРегистрации(СобытиеИсполнения(), Уровень,
		Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение, Заявка, ТекстСобытия);

КонецПроцедуры

// Итог такта в журнал регистрации (спека п. 6): найдено / согласовано /
// возвращено / отклонено / оставлено / ошибок.
Процедура ЗаписатьИтогТакта(Знач Результат)

	Части = Новый Массив;
	ТекстЧасти = СтрШаблон(НСтр("ru = 'Найдено: %1'"),
		Формат(Результат.Строки.Количество(), "ЧН=0; ЧГ=0"));
	Части.Добавить(ТекстЧасти);
	Для Каждого Метка Из МеткиРешений() Цикл
		Число = ЧислоРешений(Результат.Строки, Метка);
		Если Число > 0 Тогда
			ТекстЧасти = СтрШаблон(НСтр("ru = '%1: %2'"), НРег(Метка), Формат(Число, "ЧГ=0"));
			Части.Добавить(ТекстЧасти);
		КонецЕсли;
	КонецЦикла;
	ЗаписьЖурналаРегистрации(СобытиеИсполнения(), УровеньЖурналаРегистрации.Информация, , ,
		СтрСоединить(Части, "; "));

КонецПроцедуры

// Метки решений для таблицы результата, итога такта и журнала.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция МеткиРешений()

	Метки = Новый Массив;
	Метки.Добавить(МеткаСогласовано());
	Метки.Добавить(МеткаВозвращено());
	Метки.Добавить(МеткаОтклонено());
	Метки.Добавить(МеткаОставлено());
	Метки.Добавить(МеткаПропущено());
	Метки.Добавить(МеткаОшибки());
	Возврат Метки;

КонецФункции

// Метка решения «Согласовано».
Функция МеткаСогласовано()
	Возврат НСтр("ru = 'Согласовано'");
КонецФункции

// Метка решения «Возвращено» (виза «Отклонено» с текстом возврата).
Функция МеткаВозвращено()
	Возврат НСтр("ru = 'Возвращено'");
КонецФункции

// Метка решения «Отклонено».
Функция МеткаОтклонено()
	Возврат НСтр("ru = 'Отклонено'");
КонецФункции

// Метка решения «Оставлено» (пометка «Требуется ручной разбор»).
Функция МеткаОставлено()
	Возврат НСтр("ru = 'Оставлено'");
КонецФункции

// Метка результата «Пропущено» (виза уже решена агентом или человеком).
Функция МеткаПропущено()
	Возврат НСтр("ru = 'Пропущено'");
КонецФункции

// Метка результата «Ошибка».
Функция МеткаОшибки()
	Возврат НСтр("ru = 'Ошибка'");
КонецФункции

// Число строк результата с решением Метка.
//
// Параметры:
//  Строки - ТаблицаЗначений.
//  Метка  - Строка.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоРешений(Знач Строки, Знач Метка)

	Число = 0;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Если СтрокаТаблицы.Решение = Метка Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

#КонецОбласти

#Область ЗамечанияПроверки

// Статус замечания обработки проверки данных «не пройдена» (как возвращает
// обработка проверки, ObjectModule.bsl:1709).
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусНеПройдена()
	Возврат "не пройдена";
КонецФункции

// Статус замечания обработки проверки данных «ошибка проверки»
// (ObjectModule.bsl:1717).
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусОшибкиПроверки()
	Возврат "ошибка проверки";
КонецФункции

// Первое замечание с заданным кодом и статусом «не пройдена» (спека п. 3:
// дубль - замечание НетДубляИННКППНаименование со статусом «не пройдена»).
//
// Параметры:
//  Замечания - Массив из Соответствия.
//  Код       - Строка - код проверки (НетДубляИННКППНаименование).
//
// Возвращаемое значение:
//  Соответствие, Неопределено.
//
Функция ЗамечаниеПоКоду(Знач Замечания, Знач Код)

	Для Каждого Замечание Из Замечания Цикл
		Если ТекстЗамечания(Замечание, "code") = Код
			И ТекстЗамечания(Замечание, "status") = СтатусНеПройдена() Тогда
			Возврат Замечание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Замечания со статусом «не пройдена».
//
// Параметры:
//  Замечания - Массив из Соответствия.
//
// Возвращаемое значение:
//  Массив из Соответствия.
//
Функция ЗамечанияСтатуса(Знач Замечания, Знач Статус)

	Итог = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если ТекстЗамечания(Замечание, "status") = Статус Тогда
			Итог.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Текст поля замечания (значение из Соответствия строкой).
//
// Параметры:
//  Замечание - Соответствие - {code, name, status, message, value_in_base,...}.
//  Ключ      - Строка - имя поля ответа обработки проверки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗамечания(Знач Замечание, Знач Ключ)

	Значение = Замечание.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Тексты message замечаний.
//
// Параметры:
//  Замечания - Массив из Соответствия.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ТекстыЗамечаний(Знач Замечания)

	Тексты = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Текст = ТекстЗамечания(Замечание, "message");
		Если ПустаяСтрока(Текст) Тогда
			Текст = ТекстЗамечания(Замечание, "name");
		КонецЕсли;
		Если НЕ ПустаяСтрока(Текст) Тогда
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Пронумерованный список строк одной строкой («1) … 2) …»).
//
// Параметры:
//  Строки - Массив из Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция НумерованныйСписок(Знач Строки)

	Части = Новый Массив;
	Номер = 0;
	Для Каждого Строка Из Строки Цикл
		Номер = Номер + 1;
		ЧастьСписка = СтрШаблон(НСтр("ru = '%1) %2'"), Формат(Номер, "ЧГ=0"), Строка);
		Части.Добавить(ЧастьСписка);
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Разбор JSON в Соответствие; не объект или битый JSON - Неопределено.
//
// Параметры:
//  ТекстJSON - Строка.
//
// Возвращаемое значение:
//  Соответствие, Неопределено.
//
Функция РазобратьJSON(Знач ТекстJSON)

	Результат = Неопределено;
	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Или ПустаяСтрока(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

