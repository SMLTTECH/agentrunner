#Область ОбработчикиСобытийФормы

// Настройки обработки - в реквизиты формы.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Настройки = ОбъектОбработки.НастройкиОбработки();
	РежимВключен     = Настройки.РежимВключен;
	АгентНаименование = Настройки.АгентНаименование;
	ЛимитЗаявок      = Настройки.ЛимитЗаявок;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Изменение любой настройки - сохранение в хранилище общих настроек;
// переключение режима дополнительно пишется в журнал регистрации
// (СохранитьНастройки модуля объекта).
&НаКлиенте
Процедура РежимВключенПриИзменении(Элемент)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АгентНаименованиеПриИзменении(Элемент)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЛимитЗаявокПриИзменении(Элемент)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Такт с записью решений (спека п. 3).
&НаКлиенте
Процедура ВыполнитьТактСейчас(Команда)

	Если НЕ РежимВключен Тогда
		ТекстСообщения = НСтр("ru = 'Режим не включен - такт не выполняется. Включите режим
			|(осознанное действие администратора).'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ВыполнитьТактНаСервере(Истина);

КонецПроцедуры

// «Показать без записи» (спека п. 3): тот же такт с "_dry_run" у решений -
// таблица вердиктов и решений, в базу ничего не пишется.
&НаКлиенте
Процедура ПоказатьБезЗаписи(Команда)

	ВыполнитьТактНаСервере(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Такт исполнения и вывод результата в таблицу формы.
&НаСервере
Процедура ВыполнитьТактНаСервере(Знач ЗаписьВБазу)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ТактИсполнения(ЗаписьВБазу);

	Если НЕ ПустаяСтрока(Результат.Ошибка) Тогда
		ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка);
	КонецЕсли;
	ЗначениеВРеквизитФормы(Результат.Строки, "ТаблицаРезультата");

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", РежимВключен);
	Настройки.Вставить("АгентНаименование", СокрЛП(АгентНаименование));
	Настройки.Вставить("ЛимитЗаявок", ЛимитЗаявок);
	ОбъектОбработки.СохранитьНастройки(Настройки);

КонецПроцедуры

#КонецОбласти
