#Область ОбработчикиСобытийФормы

// Настройки обработки - в реквизиты формы (настройки общие, из
// ХранилищаНастроек элемента обработки).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Настройки = ОбъектОбработки.НастройкиОбработки();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Изменение любой настройки - сохранение в ХранилищеНастроек элемента
// обработки (СохранитьНастройки модуля объекта). Включение режима без
// пользователя агента - сообщение, режим не включается (спека п. 2).
&НаКлиенте
Процедура РежимВключенПриИзменении(Элемент)

	Если РежимВключен И НЕ ПользовательУказан() Тогда
		РежимВключен = Ложь;
		Возврат;
	КонецЕсли;
	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПользовательАгентаПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ГУИДВизыЭтап1ПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ГУИДВизыЭтап2ПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЛимитЗаявокПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПисьмоИнициаторуПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Такт с записью решений в базу (спека п. 6). Пустой пользователь агента -
// сообщение в форме, такт не идет (спека п. 2).
&НаКлиенте
Процедура ВыполнитьТактСейчас(Команда)

	Если НЕ ПользовательУказан() Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьТактНаСервере(Истина);

КонецПроцедуры

// Тот же такт без записи в базу (визы, комментарии, протоколы, счета, журнал
// решений) и без писем (спека п. 6).
&НаКлиенте
Процедура ПоказатьБезЗаписи(Команда)

	Если НЕ ПользовательУказан() Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьТактНаСервере(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка обязательного пользователя агента (спека п. 2): пустой -
// сообщение в форме.
//
// Возвращаемое значение:
//  Булево - Истина - настройки достаточны.
//
&НаСервереБезКонтекста
Функция ПользовательУказан()

	Если НЕ ЗначениеЗаполнено(ПользовательАгента) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Укажите пользователя агента в настройках обработки.'"));
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Настройки из реквизитов формы.
//
// Возвращаемое значение:
//  Структура - см. НастройкиПоУмолчанию модуля объекта.
//
&НаСервереБезКонтекста
Функция НастройкиИзФормы()

	Настройки = Новый Структура;
	Настройки.Вставить("РежимВключен", РежимВключен);
	Настройки.Вставить("ПользовательАгента", ПользовательАгента);
	Настройки.Вставить("ГУИДВизыЭтап1", СокрЛП(ГУИДВизыЭтап1));
	Настройки.Вставить("ГУИДВизыЭтап2", СокрЛП(ГУИДВизыЭтап2));
	Настройки.Вставить("ДатаНачала", ДатаНачала);
	Настройки.Вставить("ЛимитЗаявок", ЛимитЗаявок);
	Настройки.Вставить("ПисьмоИнициатору", ПисьмоИнициатору);
	Возврат Настройки;

КонецФункции

// Сохранение настроек из реквизитов формы (объект обработки пишет их в
// ХранилищеНастроек элемента привилегированно).
&НаСервере
Процедура СохранитьНастройкиНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.СохранитьНастройки(НастройкиИзФормы());

КонецПроцедуры

// Такт исполнения и вывод результата в таблицу формы.
&НаСервере
Процедура ВыполнитьТактНаСервере(Знач ЗаписьВБазу)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектОбработки.ТактИсполнения(ЗаписьВБазу);

	Если НЕ ПустаяСтрока(Результат.Ошибка) Тогда
		ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка);
	КонецЕсли;
	ЗначениеВРеквизитФормы(Результат.Строки, "ТаблицаРезультата");

КонецПроцедуры

#КонецОбласти
