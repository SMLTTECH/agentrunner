// Грань свежести опроса, сек (спека agentrunner-111 п.5): в параллельном
// режиме строки младше грани не опрашиваются (POST в полете либо задание
// только создано). Таймаут POST 60 с << грани - гонка «опрос против идущей
// отправки» (404 -> возврат -> повторная отправка) закрыта с запасом.
//
// Возвращаемое значение:
//  Число - возраст в секундах.
//
Функция ГраньСвежестиОпросаСекунд()
	Возврат 300;
КонецФункции

// Число воркеров отправки из настройки OCRВоркеровМаксимум (спека
// agentrunner-111 п.7): 0 - последовательный режим (дефолт), 1-4 -
// параллельный; значения вне диапазона - к границам. На файловой ИБ
// диспетчер трактовать как 0 - см. ВыполнитьТактПредварительногоРаспознавания.
//
// Возвращаемое значение:
//  Число - воркеров (0-4).
//
Функция ЧислоВоркеровОтправки()

	Возврат Мин(Макс(ЧислоНастройкиПакета("OCRВоркеровМаксимум", 0), 0), 4);

КонецФункции

// Размер партии отправки из настройки OCRРазмерПартии (спека
// agentrunner-111 п.7): queued-строк в одной итерации разбора очереди.
//
// Возвращаемое значение:
//  Число - строк в партии (не менее 1).
//
Функция РазмерПартииОтправки()

	Возврат Макс(ЧислоНастройкиПакета("OCRРазмерПартии", 10), 1);

КонецФункции

// Числовая настройка пакета (образец - ar_ПакетНСИ.ЧислоНастройки): значение
// настройки может храниться строкой, дефолт - при отсутствии/нечисловом.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (Код элемента справочника).
//  ЗначениеПоУмолчанию - Число  - значение при отсутствии настройки.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоНастройкиПакета(Знач Ключ, Знач ЗначениеПоУмолчанию)

	Значение = ar_Настройки.ЗначениеНастройки(Ключ, ЗначениеПоУмолчанию);

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, 1, 0);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Число = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(Значение));
		Возврат ?(Число = Неопределено, ЗначениеПоУмолчанию, Число);
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

КонецФункции

Функция ЛимитОпросаЗаТакт()
	// Опрашиваемых processing-строк за такт (спека п.Б.7).
	Возврат 50;
