#Область ПрограммныйИнтерфейс

// Пакет инструментов AgentRunner «Присоединённые файлы» (задача agentrunner-21).
//
// Два инструмента для работы с файлами, присоединёнными к документам и
// справочникам (БСП «Работа с файлами»):
//   * files_list      - список файлов владельца (УровеньРиска = Чтение);
//   * files_get_text  - текст файлов: из кэша ТекстХранилище, для doc -
//                       платформенным извлечением, для остальных - сервисом
//                       S.Docster; результат записывается в справочник файлов
//                       (УровеньРиска = Запись без подтверждения - решение
//                       человека 2026-10-01, спека agentrunner-21 п.А.11).
//
// Регистрация в БСП «Дополнительные отчёты и обработки». Вид =
// ДополнительнаяОбработка (глобальный, без Назначения). БезопасныйРежим = Ложь -
// пакету нужен выход в сеть (обращение к S.Docster); решение человека
// 2026-10-01 (Р1) - ядро при этом пишет предупреждение
// package_registered_unsafe_mode и событие аудита package_registered_unsafe.
//
// Команда с Идентификатор = "ar_ToolPack" - маркер принадлежности пакета
// AgentRunner (см. .docs/Контракт-пакета-tools.md §1.2). Значение
// регистрозависимое и фиксированное - по нему ядро отбирает кандидатов на
// регистрацию запросом к ТЧ Команды, без загрузки бинарника обработки.
//
// Манифест - схема 2: русские ключи (ВерсияСхемы, ПространствоИмён,
// Инструменты, СхемаАргументовJSON, УровеньРиска, ТребуетПодтверждения) и
// необязательный ключ Настройки - ядро создаёт недостающие настройки при
// регистрации (спека agentrunner-21 п.Б).
//
// Латиницей - только внешние протоколы: имена инструментов, ключи JSON
// (owner, count, files, ref, name, ...), поле ответа S.Docster page_content,
// заголовки HTTP. Имена процедур, переменных и тексты - по-русски.
//
// Исполнение: весь код - серверный (ВызовСерверногоМетода); привилегированный
// режим поднимается точечно (запись кэша текста) - доступ к владельцу файлов
// проверяется по правам пользователя сеанса.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчёты и
// обработки» (см. .docs/Контракт-пакета-tools.md §1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Пакет инструментов AgentRunner: присоединённые файлы'");

	// Решение человека 2026-10-01 (Р1, спека agentrunner-21 п.А.9): пакету
	// нужен выход в сеть для S.Docster - в безопасном режиме платформа
	// запрещает доступ к сети.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Пакет инструментов AgentRunner'");
	НоваяКоманда.Идентификатор        = "ar_ToolPack";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП "Дополнительные отчёты и обработки". Команда
// "ar_ToolPack" - маркерная: её интерактивный вызов не предусмотрен, она
// существует только для отбора кандидатов на регистрацию пакета ядром
// AgentRunner - поэтому обработчик только поясняет и ничего не выполняет.
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы.ВыполнитьКоманду", "files_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,'
				|' прикладного действия по этой команде не предусмотрено.'"));
	КонецЕсли;

КонецПроцедуры

// Манифест пакета инструментов - контракт AgentRunner, схема 2 (см.
// .docs/Контракт-пакета-tools.md §1.4). Вызывается ядром AgentRunner при
// регистрации/переподтверждении пакета. Не принимает аргументов.
//
// Возвращаемое значение:
//  Структура - манифест пакета:
//   * ВерсияСхемы      - Число   - версия схемы контракта (текущая - 2).
//   * ПространствоИмён - Строка  - префикс имён инструментов пакета ("files").
//   * Версия           - Строка  - SemVer версии пакета.
//   * Категории        - Массив структур - {Имя, Представление, ОписаниеДляLLM, Порядок}.
//   * Инструменты      - Массив структур - описания инструментов (§1.5 контракта).
//   * Настройки        - Массив структур - {Ключ, Наименование, Описание,
//                        ЗначениеПоУмолчанию} - ядро создаёт недостающие
//                        настройки при регистрации (спека agentrunner-21 п.Б).
//
Функция ar_ОписаниеИнструментов() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("ВерсияСхемы", 2);
	Манифест.Вставить("ПространствоИмён", "files");
	Манифест.Вставить("Версия", "1.0.0");

	Категория = Новый Структура;
	Категория.Вставить("Имя", "files");
	Категория.Вставить("Представление", НСтр("ru = 'Присоединённые файлы'"));
	Категория.Вставить("ОписаниеДляLLM",
		НСтр("ru = 'Файлы, присоединённые к документам и справочникам: список и текст (в том числе распознавание сканов)'"));
	Категория.Вставить("Порядок", 1);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаСписокФайлов());
	Инструменты.Добавить(ОписаниеИнструментаТекстФайлов());
	Манифест.Вставить("Инструменты", Инструменты);

	Манифест.Вставить("Настройки", ОписанияНастроекПакета());

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md §1.6). Вызывается ядром AgentRunner на каждый
// вызов инструмента из этого пакета. Диспетчеризация - по имени, без
// Выполнить()/Вычислить().
//
// Параметры:
//  ИмяTool       - Строка    - полное имя инструмента с пространством имён
//                  ("files_list", "files_get_text").
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащённый
//                  ядром системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = "files_list" Тогда
		Возврат ВыполнитьСписокФайлов(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "files_get_text" Тогда
		Возврат ВыполнитьТекстФайлов(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаИнструмента("unknown_tool");
	КонецЕсли;

КонецФункции

// Исполнитель подтверждённого действия (контракт PKG-09): вызывается ядром после
// того, как оператор разрешил вызов files_get_text. Нужен, хотя инструмент не
// требует подтверждения в манифесте: в ручном режиме автономии и в режиме
// «Авто-порог» ядро ставит в очередь подтверждения любое действие уровня
// «Запись» (матрица режим x уровень риска), а исполнить его после одобрения
// может только пакет. Результат инструмента (JSON ответа files_get_text)
// возвращается единственным сообщением - ядро передаёт его модели как итог.
//
// Параметры:
//  ИмяTool           - Строка - полное имя инструмента.
//  ApprovalId        - Строка - идентификатор записи очереди подтверждений.
//  ActionPayloadJSON - Строка - JSON действия; аргументы инструмента - в ключе arguments.
//
// Возвращаемое значение:
//  Структура - {Выполнено, DocumentRef, Сообщения}.
//
Функция ar_ИсполнитьПодтверждённыйИнструмент(Знач ИмяTool, Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	Если ИмяTool <> "files_get_text" Тогда
		Результат.Сообщения.Добавить("no_executor_for_action:" + ИмяTool);
		Возврат Результат;
	КонецЕсли;

	Действие = ar_JSON.ИзJSON(ActionPayloadJSON);
	Аргументы = ?(ТипЗнч(Действие) = Тип("Соответствие"), Действие.Получить("arguments"), Неопределено);
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	АргументыJSON = ?(ТипЗнч(Аргументы) = Тип("Строка"), Аргументы, ar_JSON.ВЗначениеJSON(Аргументы));

	ОтветJSON = ВыполнитьТекстФайлов(АргументыJSON, Неопределено);
	Результат.Сообщения.Добавить(ОтветJSON);
	Результат.Выполнено = Не СтрНачинаетсяС(ОтветJSON, "{""error""");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОписаниеИнструментов

// Описание инструмента files_list для манифеста пакета (УровеньРиска = Чтение,
// ТребуетПодтверждения = Ложь): список файлов владельца без записи в ИБ.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаСписокФайлов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "files_list");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает список файлов, присоединённых к документу или элементу справочника (владельцу).
			|Для каждого файла: имя, расширение, размер, даты, автор, описание, статус извлечения текста,
			|признаки шифрования, подписи и редактирования. Помеченные на удаление файлы не возвращаются.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Список присоединённых файлов владельца'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовСписокФайлов());
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// Описание инструмента files_get_text для манифеста пакета (УровеньРиска =
// Запись, ТребуетПодтверждения = Ложь с обоснованием - решение человека
// 2026-10-01, спека agentrunner-21 п.А.11: пишется только служебный кэш
// извлечённого текста).
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаТекстФайлов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "files_get_text");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает текст присоединённых файлов. Источник текста: кэш справочника файлов, платформенное
			|извлечение для файлов doc, сервис распознавания S.Docster для остальных (сканы, pdf, картинки и т.п.).
			|Извлечённый текст сохраняется в справочнике файлов, чтобы повторные вызовы возвращали его из кэша.
			|Не более 10 файлов за вызов.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Текст присоединённых файлов'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовТекстФайлов());
	Описание.Вставить("УровеньРиска", "Запись");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// Точный текст обоснования - из спеки agentrunner-21 п.А.11; проверяется
	// ядром при регистрации (Запись без подтверждения допустим только с ним).
	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'Записывается только кэш извлечённого текста в служебные реквизиты ТекстХранилище и
			|СтатусИзвлеченияТекста справочника файлов; данные документа-владельца не меняются.
			|Решение человека 2026-10-01, спека agentrunner-21'"));
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов files_list в OpenAI tool-format.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСписокФайлов()

	Свойства = Новый Структура;
	Свойства.Вставить("owner", СвойствоСхемы("string",
		НСтр("ru = 'Навигационная ссылка e1cib/data/... на документ или элемент справочника - владельца файлов.'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("owner");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("files_list",
		НСтр("ru = 'Список файлов, присоединённых к документу или элементу справочника.'"), Параметры);

КонецФункции

// JSON Schema аргументов files_get_text в OpenAI tool-format: files (массив
// ссылок на файлы) ИЛИ owner (все файлы владельца) - один из двух.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовТекстФайлов()

	СвойствоСтроки = Новый Структура;
	СвойствоСтроки.Вставить("type", "string");

	СвойствоФайлов = Новый Структура;
	СвойствоФайлов.Вставить("type", "array");
	СвойствоФайлов.Вставить("items", СвойствоСтроки);
	СвойствоФайлов.Вставить("description",
		НСтр("ru = 'Навигационные ссылки e1cib/data/... на присоединённые файлы. Не более 10 за вызов.'"));

	Свойства = Новый Структура;
	Свойства.Вставить("files", СвойствоФайлов);
	Свойства.Вставить("owner", СвойствоСхемы("string",
		НСтр("ru = 'Навигационная ссылка на владельца - обрабатываются все его присоединённые файлы (не более 10).'")));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФормат("files_get_text",
		НСтр("ru = 'Текст присоединённых файлов (из кэша, платформой для doc, распознаванием для остальных).'"),
		Параметры);

КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
//
// Параметры:
//  Тип      - Строка - тип JSON Schema свойства ("string", "array" и т. п.).
//  Описание - Строка - человекочитаемое описание свойства для LLM.
//
// Возвращаемое значение:
//  Структура - {type, description}.
//
Функция СвойствоСхемы(Знач Тип, Знач Описание)

	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
//
// Параметры:
//  Имя       - Строка    - полное имя инструмента (с пространством имён).
//  Описание  - Строка    - человекочитаемое описание инструмента для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, ...}).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)

	ОписаниеФункции = Новый Структура;
	ОписаниеФункции.Вставить("name", Имя);
	ОписаниеФункции.Вставить("description", Описание);
	ОписаниеФункции.Вставить("parameters", Параметры);

	Обёртка = Новый Структура;
	Обёртка.Вставить("type", "function");
	Обёртка.Вставить("function", ОписаниеФункции);
	Возврат ar_JSON.ВЗначениеJSON(Обёртка);

КонецФункции

// Настройки пакета (спека agentrunner-21 п.А.14): ядро создаёт недостающие
// при регистрации. Без значения по умолчанию создаются выключенными - пока
// администратор не заполнит (адрес сервиса даёт человек, Р10).
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписанияНастроекПакета()

	Настройки = Новый Массив;

	Настройки.Добавить(ОписаниеНастройки("SDocsterАдресСервиса",
		НСтр("ru = 'S.Docster: адрес сервиса'"),
		НСтр("ru = 'Полный адрес сервиса распознавания S.Docster одной строкой, например
			|http://сервер:8080/путь или https://сервер/путь. Пока не заполнено и не включено,
			|инструмент files_get_text возвращает ошибку ""сервис не настроен"", не обращаясь в сеть.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("SDocsterКлюч",
		НСтр("ru = 'S.Docster: API-ключ'"),
		НСтр("ru = 'Ключ доступа к сервису S.Docster; передаётся в заголовке Authorization: Bearer.
			|Если сервис ключа не требует - оставьте настройку выключенной.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("SDocsterТаймаут",
		НСтр("ru = 'S.Docster: таймаут, сек'"),
		НСтр("ru = 'Сколько секунд ждать ответа сервиса распознавания.'"),
		120));

	Настройки.Добавить(ОписаниеНастройки("ПредельныйРазмерФайлаРаспознавания",
		НСтр("ru = 'Предельный размер файла распознавания, байт'"),
		НСтр("ru = 'Файлы больше этого размера не распознаются - отказ без обращения к сервису.'"),
		20000000));

	Настройки.Добавить(ОписаниеНастройки("ПредельнаяДлинаТекстаФайла",
		НСтр("ru = 'Предельная длина текста файла, символов'"),
		НСтр("ru = 'Столько символов текста возвращается агенту; более длинный текст усекается
			|с признаком truncated, в справочнике файлов хранится полностью.'"),
		50000));

	Возврат Настройки;

КонецФункции

// Конструктор одного описания настройки пакета для ключа Настройки манифеста.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (Код элемента справочника).
//  Наименование        - Строка - наименование настройки для пользователя.
//  Описание            - Строка - описание настройки для пользователя.
//  ЗначениеПоУмолчанию - Строка/Число/Булево - значение по умолчанию;
//                        Неопределено - настройка создаётся выключенной,
//                        пока администратор её не заполнит и не включит.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	ОписаниеЭлемента = Новый Структура;
	ОписаниеЭлемента.Вставить("Ключ", Ключ);
	ОписаниеЭлемента.Вставить("Наименование", Наименование);
	ОписаниеЭлемента.Вставить("Описание", Описание);
	// Неопределено сериализуется ar_JSON как null: отсутствие значения
	// по умолчанию (спека п.Б.5) - ядро создаёт такую настройку выключенной.
	ОписаниеЭлемента.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Возврат ОписаниеЭлемента;

КонецФункции

#КонецОбласти

#Область ИнструментСписокФайлов

// Реализация инструмента files_list: список файлов владельца одним запросом
// (объединение по справочникам файлов), без ДанныеФайла в цикле. Ответ:
// {"owner","count","files":[{ref,name,extension,size,created,modified,author,
// description,text_status,has_text,encrypted,signed,being_edited}]}.
//
// Порядок проверки (спека п.А.10): ссылка разобрана и объект существует;
// к объекту присоединяются файлы; пользователь сеанса видит владельца
// (запрос РАЗРЕШЕННЫЕ - функции БСП списка файлов работают привилегированно
// и ограничения доступа не учитывают).
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"owner": "<навигационная ссылка>"}.
//  Контекст      - Структура - контекст запуска. Не используется (чтение).
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ВыполнитьСписокФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Владелец = ВладелецИзАргументов(Аргументы);
	Если Владелец = Неопределено Или Не ВладелецВиденПользователю(Владелец) Тогда
		Возврат ОшибкаИнструмента("owner_not_found_or_denied");
	КонецЕсли;

	Если Не РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Владелец) Тогда
		Возврат ОшибкаИнструмента("owner_files_not_supported");
	КонецЕсли;

	ФайлыОтвета = Новый Массив;
	СвойстваФайлов = СвойстваФайловВладельца(Владелец);
	Для Каждого Свойства Из СвойстваФайлов Цикл
		ФайлыОтвета.Добавить(ЭлементСпискаФайлов(Свойства.Значение));
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("owner", ЗначениеИзКоллекции(Аргументы, "owner", ""));
	Ответ.Вставить("count", ФайлыОтвета.Количество());
	Ответ.Вставить("files", ФайлыОтвета);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Элемент массива files ответа files_list по структуре свойств файла.
//
// Параметры:
//  Свойства - Структура - свойства файла (см. СвойстваФайловВладельца).
//
// Возвращаемое значение:
//  Структура - {ref, name, extension, size, created, modified, author,
//               description, text_status, has_text, encrypted, signed, being_edited}.
//
Функция ЭлементСпискаФайлов(Знач Свойства)

	Элемент = Новый Структура;
	Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Свойства.Ссылка));
	Элемент.Вставить("name", Свойства.Наименование);
	Элемент.Вставить("extension", Свойства.Расширение);
	Элемент.Вставить("size", Свойства.Размер);
	Элемент.Вставить("created", Свойства.ДатаСоздания);
	Элемент.Вставить("modified", Свойства.ДатаМодификации);
	Элемент.Вставить("author", Строка(Свойства.Автор));
	Элемент.Вставить("description", Свойства.Описание);
	Элемент.Вставить("text_status", Строка(Свойства.СтатусИзвлеченияТекста));
	Элемент.Вставить("has_text", Свойства.СтатусИзвлеченияТекста
		= Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен);
	Элемент.Вставить("encrypted", Свойства.Зашифрован);
	Элемент.Вставить("signed", Свойства.ПодписанЭП);
	Элемент.Вставить("being_edited", ЗначениеЗаполнено(Свойства.Редактирует));
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область ИнструментТекстФайлов

// Реализация инструмента files_get_text. DryRun проверяется первым делом:
// в пробном запуске сервис не вызывается и ничего не пишется - возвращается
// перечень файлов и что было бы сделано (спека п.А.11).
//
// Порядок по одному файлу (спека п.А.12): кэш -> отказы без сервиса
// (зашифрован, размер, расширение) -> двоичные данные -> платформа (doc) /
// S.Docster (остальные) -> пустой текст = ошибка -> запись кэша в справочник.
// Ошибка по одному файлу не мешает остальным: исключения наружу не выходят.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"files": [...]} либо {"owner": "..."}.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, ...).
//
// Возвращаемое значение:
//  Строка - JSON-observation
//  {"count","files_skipped","results":[{ref,name,source,text,text_length,truncated,saved,error}]}.
//
Функция ВыполнитьТекстФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Выборка = ВыбратьФайлыДляИзвлечения(Аргументы);
	Если Выборка.Отказ Тогда
		Возврат ОшибкаИнструмента(Выборка.КодОшибки);
	КонецЕсли;

	// DryRun - после разбора аргументов (нужен перечень файлов) и до первого
	// обращения к сервису или записи.
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("files_get_text",
			ПланИзвлеченияТекстов(Выборка));
	КонецЕсли;

	НастройкиИзвлечения = НастройкиИзвлеченияТекста();
	Результаты = Новый Массив;
	Для Каждого ФайлСсылка Из Выборка.Файлы Цикл
		Свойства = Выборка.Свойства.Получить(ФайлСсылка);
		Если Свойства = Неопределено Тогда
			Результаты.Добавить(ЭлементРезультатаОшибки(ФайлСсылка, "file_not_found_or_denied"));
		ИначеЕсли Не Выборка.ВидимыеВладельцы.Получить(Свойства.ВладелецФайла) = Истина Тогда
			Результаты.Добавить(ЭлементРезультатаОшибки(ФайлСсылка, "owner_not_found_or_denied"));
		Иначе
			Результаты.Добавить(ИзвлечьТекстФайла(ФайлСсылка, Свойства, НастройкиИзвлечения));
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("count", Результаты.Количество());
	Ответ.Вставить("files_skipped", Выборка.Пропущено);
	Ответ.Вставить("results", Результаты);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Выбирает и разрешает файлы для files_get_text: явный массив files ИЛИ все
// файлы владельца owner; не более 10 файлов за вызов (спека п.А.11), лишние -
// в Пропущено.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//
// Возвращаемое значение:
//  Структура:
//   * Отказ            - Булево - Истина при ошибке выбора (КодОшибки заполнен).
//   * КодОшибки        - Строка - код ошибки для ответа.
//   * Файлы            - Массив - ссылки на файлы (до 10).
//   * Свойства         - Соответствие - Ссылка -> структура свойств файла
//                        (файлы, не попавшие в выборку запроса, - не найдены
//                        или скрыты ограничением доступа).
//   * ВидимыеВладельцы - Соответствие - ссылка владельца -> Истина, если
//                        пользователь сеанса его видит (запрос РАЗРЕШЕННЫЕ).
//   * Пропущено        - Число - сколько файлов сверх предела не обрабатывалось.
//
Функция ВыбратьФайлыДляИзвлечения(Знач Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Файлы", Новый Массив);
	Результат.Вставить("Свойства", Новый Соответствие);
	Результат.Вставить("ВидимыеВладельцы", Новый Соответствие);
	Результат.Вставить("Пропущено", 0);

	СсылкиФайлов = СсылкиФайловИзАргументов(Аргументы);

	Если СсылкиФайлов <> Неопределено Тогда
		Результат.Файлы = ОграничитьФайлыПределом(СсылкиФайлов, Результат.Пропущено);
		Если Результат.Файлы.Количество() > 0 Тогда
			Результат.Свойства = СвойстваФайловПоСсылкам(Результат.Файлы);
			// Явный список файлов: доступ проверяется по владельцу каждого
			// файла (спека п.А.12) - одним объединённым запросом РАЗРЕШЕННЫЕ
			// по всем владельцам.
			Результат.ВидимыеВладельцы = ВидимыеВладельцыФайлов(Результат.Свойства);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Владелец = ВладелецИзАргументов(Аргументы);
	Если Владелец = Неопределено Или Не ВладелецВиденПользователю(Владелец) Тогда
		Результат.Отказ = Истина;
		Результат.КодОшибки = "owner_not_found_or_denied";
		Возврат Результат;
	КонецЕсли;

	Если Не РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Владелец) Тогда
		Результат.Отказ = Истина;
		Результат.КодОшибки = "owner_files_not_supported";
		Возврат Результат;
	КонецЕсли;

	Результат.Свойства = СвойстваФайловВладельца(Владелец);
	ВсеФайлыВладельца = Новый Массив;
	Для Каждого Элемент Из Результат.Свойства Цикл
		ВсеФайлыВладельца.Добавить(Элемент.Ключ);
	КонецЦикла;
	Результат.Файлы = ОграничитьФайлыПределом(ВсеФайлыВладельца, Результат.Пропущено);
	Результат.ВидимыеВладельцы.Вставить(Владелец, Истина);

	Возврат Результат;

КонецФункции

// Разбирает аргумент files в массив ссылок на файлы; элементы, не являющиеся
// строкой, и ссылки, по которым файл не удалось найти, отбрасываются - без
// элемента ответа и без учёта в files_skipped: ошибка в элементе ответа
// (спека п.А.12) даётся только файлам, попавшим в выборку.
//
// Возвращаемое значение:
//  Массив ссылок, либо Неопределено, если аргумента files нет.
//
Функция СсылкиФайловИзАргументов(Знач Аргументы)

	АргументФайлы = Аргументы.Получить("files");
	Если АргументФайлы = Неопределено Или ТипЗнч(АргументФайлы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого СтрокаСсылки Из АргументФайлы Цикл
		Если ТипЗнч(СтрокаСсылки) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
		Если ФайлСсылка <> Неопределено Тогда
			Ссылки.Добавить(ФайлСсылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// Оставляет первые ПределФайловЗаВызова() файлов; число лишних записывает в
// Пропущено (передан по ссылке).
Функция ОграничитьФайлыПределом(Знач СсылкиФайлов, Пропущено)

	Предел = ПределФайловЗаВызова();
	Пропущено = Макс(СсылкиФайлов.Количество() - Предел, 0);

	Ограниченные = Новый Массив;
	Для Индекс = 0 По Предел - 1 Цикл
		Если Индекс >= СсылкиФайлов.Количество() Тогда
			Прервать;
		КонецЕсли;
		Ограниченные.Добавить(СсылкиФайлов[Индекс]);
	КонецЦикла;

	Возврат Ограниченные;

КонецФункции

// Максимальное число файлов за один вызов files_get_text: каждый файл может
// занять до SDocsterТаймаут секунд, без предела запуск упрётся в контроль
// зависаний (решение человека 2026-10-01, спека п.А.11; обработка с учётом
// времени распознавания - задача agentrunner-cpa).
Функция ПределФайловЗаВызова()
	Возврат 10;
КонецФункции

// План пробного запуска files_get_text: по каждому файлу - что было бы сделано,
// без обращения к сервису и без записи.
//
// Параметры:
//  Выборка - Структура - результат ВыбратьФайлыДляИзвлечения.
//
// Возвращаемое значение:
//  Структура - {count, files_skipped, files:[{ref, name, action}]}.
//
Функция ПланИзвлеченияТекстов(Знач Выборка)

	НастройкиИзвлечения = НастройкиИзвлеченияТекста();
	ЭлементыПлана = Новый Массив;

	Для Каждого ФайлСсылка Из Выборка.Файлы Цикл

		Свойства = Выборка.Свойства.Получить(ФайлСсылка);
		ЭлементПлана = Новый Структура;
		ЭлементПлана.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлСсылка));
		ЭлементПлана.Вставить("name", ?(Свойства = Неопределено, "", Свойства.Наименование));

		Если Свойства = Неопределено Тогда
			Действие = НСтр("ru = 'ошибка: файл не найден или недоступен'");
		ИначеЕсли Не Выборка.ВидимыеВладельцы.Получить(Свойства.ВладелецФайла) = Истина Тогда
			Действие = НСтр("ru = 'ошибка: владелец файла недоступен'");
		Иначе
			Действие = ДействиеПоФайлу(Свойства, НастройкиИзвлечения);
		КонецЕсли;

		ЭлементПлана.Вставить("action", Действие);
		ЭлементыПлана.Добавить(ЭлементПлана);

	КонецЦикла;

	План = Новый Структура;
	План.Вставить("count", ЭлементыПлана.Количество());
	План.Вставить("files_skipped", Выборка.Пропущено);
	План.Вставить("files", ЭлементыПлана);
	Возврат План;

КонецФункции

// Краткое описание того, что будет сделано с файлом при реальном запуске
// (тот же порядок проверок, что в ИзвлечьТекстФайла, - только чтение свойств).
Функция ДействиеПоФайлу(Знач Свойства, Знач НастройкиИзвлечения)

	Если Свойства.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		Если Не ПустаяСтрока(ТекстИзХранилища(Свойства.ТекстХранилище)) Тогда
			Возврат НСтр("ru = 'вернуть текст из кэша'");
		КонецЕсли;
	КонецЕсли;

	Если Свойства.Зашифрован Тогда
		Возврат НСтр("ru = 'ошибка: файл зашифрован'");
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));
	Если Расширение <> "doc" И Не РасширениеПоддерживаетсяСервисом(Расширение) Тогда
		Возврат НСтр("ru = 'ошибка: расширение файла не поддерживается'");
	КонецЕсли;

	Если Свойства.Размер > НастройкиИзвлечения.ПределРазмера Тогда
		Возврат НСтр("ru = 'ошибка: размер файла превышает предел'");
	КонецЕсли;

	Если Расширение = "doc" Тогда
		Возврат НСтр("ru = 'извлечь текст платформой и записать в справочник'");
	КонецЕсли;

	Возврат НСтр("ru = 'распознать через S.Docster и записать в справочник'");

КонецФункции

// Извлечение текста одного файла по порядку спеки п.А.12. Исключения
// перехватываются - наружу выходит только error в элементе ответа.
//
// Параметры:
//  ФайлСсылка          - ЛюбаяСсылка - ссылка на присоединённый файл.
//  Свойства            - Структура   - свойства файла из выборки запроса.
//  НастройкиИзвлечения - Структура   - {ПределРазмера, ПределДлиныТекста, ТаймаутСДокстер}.
//
// Возвращаемое значение:
//  Структура - {ref, name, source, text, text_length, truncated, saved, error}.
//
Функция ИзвлечьТекстФайла(Знач ФайлСсылка, Знач Свойства, Знач НастройкиИзвлечения)

	Результат = НовыйЭлементРезультата(ФайлСсылка, Свойства.Наименование);

	// 1. Кэш: статус "Извлечен" и непустая строка в ТекстХранилище - ничего
	// не пишем (текст уже хранится в справочнике).
	Если Свойства.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		ТекстКэша = ТекстИзХранилища(Свойства.ТекстХранилище);
		Если Не ПустаяСтрока(ТекстКэша) Тогда
			Возврат ДополнитьРезультатТекстом(Результат, ТекстКэша, "кэш",
				НастройкиИзвлечения.ПределДлиныТекста, Истина, "");
		КонецЕсли;
	КонецЕсли;

	// 2. Отказы без обращения к сервису (зашифрован, размер, расширение).
	ТекстОтказа = ТекстОтказаБезОбращенияКСервису(Свойства, НастройкиИзвлечения);
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Возврат ДополнитьРезультатОшибкой(Результат, ТекстОтказа);
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));

	// 3. Двоичные данные файла.
	ДвоичныеДанные = Неопределено;
	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка, Ложь);
	Исключение
		ДвоичныеДанные = Неопределено;
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ДополнитьРезультатОшибкой(Результат,
			НСтр("ru = 'Данные файла не найдены'"));
	КонецЕсли;

	// 4-5. Извлечение: doc - платформой, остальные - S.Docster.
	Если Расширение = "doc" Тогда
		Текст = ИзвлечьТекстДокПлатформой(ДвоичныеДанные);
		Источник = "платформа";
	Иначе
		ТекстОшибкиСервиса = "";
		Текст = РаспознатьТекстSDocster(ДвоичныеДанные, Свойства.Наименование, Расширение,
			НастройкиИзвлечения.ТаймаутСДокстер, Свойства.Размер, ТекстОшибкиСервиса);
		Источник = "распознавание";
		Если Не ПустаяСтрока(ТекстОшибкиСервиса) Тогда
			// Статус файла не меняется (спека п.А.13).
			Возврат ДополнитьРезультатОшибкой(Результат, ТекстОшибкиСервиса);
		КонецЕсли;
	КонецЕсли;

	// 6. Пустой текст - ошибка, в справочник не писать.
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат ДополнитьРезультатОшибкой(Результат,
			НСтр("ru = 'Текст не извлечён'"));
	КонецЕсли;

	// 7. Запись кэша в справочник файлов; занятый файл - текст вернуть,
	// запись пропустить.
	Если ЗначениеЗаполнено(Свойства.Редактирует) Тогда
		Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
			НастройкиИзвлечения.ПределДлиныТекста, Ложь,
			НСтр("ru = 'Файл занят для редактирования, текст не сохранён'"));
	КонецЕсли;

	ТекстОшибкиЗаписи = "";
	Если ЗаписатьТекстФайла(ФайлСсылка, Текст, ТекстОшибкиЗаписи) Тогда
		Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
			НастройкиИзвлечения.ПределДлиныТекста, Истина, "");
	КонецЕсли;

	// Ошибка записи не теряет текст в ответе (спека п.А.12).
	Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
		НастройкиИзвлечения.ПределДлиныТекста, Ложь, ТекстОшибкиЗаписи);

КонецФункции

// Отказы шага 2 спеки п.А.12 без обращения к сервису распознавания: файл
// зашифрован; размер больше предела; расширение не поддерживается (doc не
// проверяется на поддержку сервисом - он идёт платформой).
//
// Параметры:
//  Свойства            - Структура - свойства файла.
//  НастройкиИзвлечения - Структура - {ПределРазмера, ПределДлиныТекста, ТаймаутСДокстер}.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" - отказов нет.
//
Функция ТекстОтказаБезОбращенияКСервису(Знач Свойства, Знач НастройкиИзвлечения)

	Если Свойства.Зашифрован Тогда
		Возврат НСтр("ru = 'Файл зашифрован, извлечение текста невозможно'");
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));
	Если Расширение <> "doc" И Не РасширениеПоддерживаетсяСервисом(Расширение) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Расширение ""%1"" не поддерживается'"), Расширение);
	КонецЕсли;

	Если Свойства.Размер > НастройкиИзвлечения.ПределРазмера Тогда
		Возврат СтрШаблон(НСтр("ru = 'Размер файла %1 байт превышает предел %2 байт'"),
			Формат(Свойства.Размер, "ЧГ=0"), Формат(НастройкиИзвлечения.ПределРазмера, "ЧГ=0"));
	КонецЕсли;

	Возврат "";

КонецФункции

// Извлечение текста из doc платформенным обработчиком через БСП: временный
// файл с расширением doc (ИзвлечениеТекста определяет формат по расширению),
// после - удаление временного файла в Попытка (спека п.А.12.4, фактура 6.9).
// Не РаботаСФайламиСлужебный.ИзвлечьТекст: она зависит от константы
// ИзвлекатьТекстыФайловНаСервере и при включённой константе ничего не извлекает.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла doc (расширение отобрано вызывающим кодом).
//
// Возвращаемое значение:
//  Строка - извлечённый текст либо "" (пустой текст обработает вызывающий код).
//
Функция ИзвлечьТекстДокПлатформой(Знач ДвоичныеДанные)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("doc");
	РезультатИзвлечения = Неопределено;
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		РезультатИзвлечения = РаботаСФайламиСлужебный.ИзвлечьТекстИзФайлаНаДиске(ИмяВременногоФайла);
	Исключение
		РезультатИзвлечения = Неопределено;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Неудачное удаление не ошибка: временный файл удалит платформа.
	КонецПопытки;

	Если РезультатИзвлечения = Неопределено
		Или РезультатИзвлечения.СтатусИзвлеченияТекста
			<> Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстИзХранилища(РезультатИзвлечения.ТекстХранилище);

КонецФункции

// Записывает извлечённый текст в кэш справочника файлов - повторение схемы
// РаботаСФайламиСлужебный.ЗаписатьРезультатИзвлеченияТекста (готовую строку ей
// передать нельзя): БлокировкаДанных по ссылке, транзакция,
// ЗаблокироватьДанныеДляРедактирования, ОбновлениеИнформационнойБазы.ЗаписатьДанные
// (режим загрузки: подписки, в том числе выгрузка в MinIO, не срабатывают).
// Запись - в привилегированном режиме: меняются только два служебных реквизита,
// право чтения проверено по владельцу (решение человека 2026-10-01, спека п.А.12.7).
//
// Параметры:
//  ФайлСсылка  - ЛюбаяСсылка - файл, в который пишется текст.
//  Текст       - Строка      - полный текст (без усечения).
//  ТекстОшибки - Строка      - очищенный текст ошибки при неудаче (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если текст записан.
//
Функция ЗаписатьТекстФайла(Знач ФайлСсылка, Знач Текст, ТекстОшибки)

	Записано = Ложь;
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(ФайлСсылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НачатьТранзакцию();
		Попытка
			БлокировкаДанных.Заблокировать();
			ЗаблокироватьДанныеДляРедактирования(ФайлСсылка);
			ОбъектФайла = ФайлСсылка.ПолучитьОбъект();
			ОбъектФайла.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен;
			ОбъектФайла.ТекстХранилище = Новый ХранилищеЗначения(Текст, Новый СжатиеДанных(9));
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ОбъектФайла);
			Записано = Истина;
			// ЗафиксироватьТранзакцию - последний оператор попытки: после него
			// откат уже невозможен.
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		// Блокировка не взята либо ошибка записи - текст в ответе сохраняется,
		// saved = false с причиной (спека п.А.12.7).
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Записано;

КонецФункции

// Читает настройки извлечения (кэш сеанса ar_Настройки; изменённое значение
// подхватывается с нового сеанса/запуска - спека п.А.14).
//
// Возвращаемое значение:
//  Структура {ПределРазмера, ПределДлиныТекста, ТаймаутСДокстер} - Числа.
//
Функция НастройкиИзвлеченияТекста()

	Настройки = Новый Структура;
	Настройки.Вставить("ПределРазмера",
		ar_Настройки.ЗначениеНастройки("ПредельныйРазмерФайлаРаспознавания", 20000000));
	Настройки.Вставить("ПределДлиныТекста",
		ar_Настройки.ЗначениеНастройки("ПредельнаяДлинаТекстаФайла", 50000));
	Настройки.Вставить("ТаймаутСДокстер",
		ar_Настройки.ЗначениеНастройки("SDocsterТаймаут", 120));
	Возврат Настройки;

КонецФункции

// Новый элемент массива results ответа files_get_text.
Функция НовыйЭлементРезультата(Знач ФайлСсылка, Знач Наименование)

	Элемент = Новый Структура;
	Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлСсылка));
	Элемент.Вставить("name", Наименование);
	Элемент.Вставить("source", "");
	Элемент.Вставить("text", "");
	Элемент.Вставить("text_length", 0);
	Элемент.Вставить("truncated", Ложь);
	Элемент.Вставить("saved", Ложь);
	Элемент.Вставить("error", "");
	Возврат Элемент;

КонецФункции

// Элемент results для файла, который не удалось даже найти/разрешить.
Функция ЭлементРезультатаОшибки(Знач ФайлСсылка, Знач КодОшибки)

	Элемент = НовыйЭлементРезультата(ФайлСсылка, "");
	Элемент.error = КодОшибки;
	Возврат Элемент;

КонецФункции

// Заполняет текстовую часть результата: усечение до предела с признаком
// truncated (в справочник пишется полный текст, поэтому усечение - только
// здесь, на границе ответа).
Функция ДополнитьРезультатТекстом(Знач Результат, Знач Текст, Знач Источник,
	Знач ПределДлиныТекста, Знач Сохранён, Знач ТекстОшибки)

	Результат.source = Источник;
	Результат.saved = Сохранён;
	Результат.error = ТекстОшибки;

	Если СтрДлина(Текст) > ПределДлиныТекста Тогда
		Результат.text = Лев(Текст, ПределДлиныТекста);
		Результат.truncated = Истина;
	Иначе
		Результат.text = Текст;
		Результат.truncated = Ложь;
	КонецЕсли;
	Результат.text_length = СтрДлина(Результат.text);

	Возврат Результат;

КонецФункции

// Заполняет результат ошибкой (текст отсутствует).
Функция ДополнитьРезультатОшибкой(Знач Результат, Знач ТекстОшибки)

	Результат.error = ТекстОшибки;
	Возврат Результат;

КонецФункции

// Достаёт строку из ХранилищеЗначения (формат БСП: в хранилище лежит строка).
Функция ТекстИзХранилища(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;

	Текст = Хранилище.Получить();
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Текст;

КонецФункции

#КонецОбласти

#Область ВладельцыИФайлы

// Разбирает аргумент owner (навигационная ссылка e1cib/...) в ссылку владельца.
//
// Возвращаемое значение:
//  ЛюбаяСсылка - владелец; Неопределено, если ссылка не разобрана.
//
Функция ВладелецИзАргументов(Знач Аргументы)

	Возврат ar_Утилиты.ОбъектИзНавигационнойСсылки(ЗначениеИзКоллекции(Аргументы, "owner", ""));

КонецФункции

// Видит ли пользователь сеанса владельца файлов (спека п.А.10): запрос
// РАЗРЕШЕННЫЕ - при ограничениях доступа на уровне записей объект, скрытый
// от пользователя, вернёт пустой результат. Несуществующий объект тоже.
Функция ВладелецВиденПользователю(Знач Владелец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Владелец);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	" + Владелец.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Свойства всех файлов владельца (кроме помеченных на удаление) ОДНИМ запросом
// (объединение по справочникам файлов владельца, спека п.А.10; без ДанныеФайла
// в цикле - там ПолучитьОбъект на каждый файл). Запрос без РАЗРЕШЕННЫЕ:
// невидимые пользователю файлы в список не попадают.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Ссылка, Наименование, Расширение, Размер,
//  ДатаСоздания, ДатаМодификации, Автор, Описание, СтатусИзвлеченияТекста,
//  ТекстХранилище, ПодписанЭП, Зашифрован, Редактирует, ВладелецФайла};
//  упорядочены по Наименование.
//
Функция СвойстваФайловВладельца(Знач Владелец)

	Секции = Новый Массив;
	ИменаСправочников = РаботаСФайламиСлужебный.ИменаСправочниковХраненияФайлов(Владелец, Истина);
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Секции.Добавить(ТекстСекцииСвойствФайла("Справочник." + ИмяСправочника.Ключ,
			"Ф.ВладелецФайла = &Владелец И НЕ Ф.ПометкаУдаления"));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.Текст = ТекстЗапросаСвойствФайлов(Секции);

	Возврат СвойстваИзВыборки(Запрос.Выполнить().Выбрать());

КонецФункции

// Свойства файлов по явному массиву ссылок одним запросом (группировка по
// таблицам: у файла и таблицы однозначное соответствие).
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> структура свойств (см. СвойстваФайловВладельца).
//
Функция СвойстваФайловПоСсылкам(Знач СсылкиФайлов)

	// Уникальные ссылки (агент мог передать одну ссылку дважды), группировка
	// по таблицам.
	ГруппыПоТаблицам = Новый Соответствие;
	Уникальные = Новый Соответствие;
	Для Каждого ФайлСсылка Из СсылкиФайлов Цикл
		Если Уникальные.Получить(ФайлСсылка) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(ФайлСсылка, Истина);

		ИмяТаблицы = ФайлСсылка.Метаданные().ПолноеИмя();
		Группа = ГруппыПоТаблицам.Получить(ИмяТаблицы);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ГруппыПоТаблицам.Вставить(ИмяТаблицы, Группа);
		КонецЕсли;
		Группа.Добавить(ФайлСсылка);
	КонецЦикла;

	Секции = Новый Массив;
	ИндексСекции = 0;
	Запрос = Новый Запрос;
	Для Каждого Группа Из ГруппыПоТаблицам Цикл
		ИмяПараметра = "Файлы" + Формат(ИндексСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра, Группа.Значение);
		Секции.Добавить(ТекстСекцииСвойствФайла(Группа.Ключ,
			"Ф.Ссылка В (&" + ИмяПараметра + ")"));
		ИндексСекции = ИндексСекции + 1;
	КонецЦикла;

	Запрос.Текст = ТекстЗапросаСвойствФайлов(Секции);

	Возврат СвойстваИзВыборки(Запрос.Выполнить().Выбрать());

КонецФункции

// Владельцы переданных файлов, видимые пользователю сеанса, одним запросом
// РАЗРЕШЕННЫЕ (доступ проверяется по владельцу файла - спека п.А.12).
//
// Параметры:
//  СвойстваФайлов - Соответствие - Ссылка -> структура свойств (владелец -
//                   во ВладелецФайла).
//
// Возвращаемое значение:
//  Соответствие - ссылка владельца -> Истина для видимых владельцев.
//
Функция ВидимыеВладельцыФайлов(Знач СвойстваФайлов)

	Видимые = Новый Соответствие;

	ВладельцыПоТаблицам = Новый Соответствие;
	Для Каждого Элемент Из СвойстваФайлов Цикл
		Владелец = Элемент.Значение.ВладелецФайла;
		Если Не ЗначениеЗаполнено(Владелец) Или Видимые.Получить(Владелец) = Истина Тогда
			Продолжить;
		КонецЕсли;
		ИмяТаблицы = Владелец.Метаданные().ПолноеИмя();
		Группа = ВладельцыПоТаблицам.Получить(ИмяТаблицы);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ВладельцыПоТаблицам.Вставить(ИмяТаблицы, Группа);
		КонецЕсли;
		Группа.Добавить(Владелец);
	КонецЦикла;

	Секции = Новый Массив;
	ИндексСекции = 0;
	Запрос = Новый Запрос;
	Для Каждого Группа Из ВладельцыПоТаблицам Цикл
		ИмяПараметра = "Владельцы" + Формат(ИндексСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра, Группа.Значение);
		Секции.Добавить(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Т.Ссылка КАК Ссылка
			|ИЗ
			|	" + Группа.Ключ + " КАК Т
			|ГДЕ
			|	Т.Ссылка В (&" + ИмяПараметра + ")");
		ИндексСекции = ИндексСекции + 1;
	КонецЦикла;

	Если Секции.Количество() = 0 Тогда
		Возврат Видимые;
	КонецЕсли;

	Запрос.Текст = ТекстЗапросаОбъединения(Секции);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Видимые.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

	Возврат Видимые;

КонецФункции

// Секция объединённого запроса свойств файлов: одинаковый состав полей для
// всех справочников файлов БСП (спека п.А.10, P3).
Функция ТекстСекцииСвойствФайла(Знач ИмяТаблицы, Знач УсловиеОтбора)

	Возврат "ВЫБРАТЬ
		|	Ф.Ссылка КАК Ссылка,
		|	Ф.Наименование КАК Наименование,
		|	Ф.Расширение КАК Расширение,
		|	Ф.Размер КАК Размер,
		|	Ф.ДатаСоздания КАК ДатаСоздания,
		|	Ф.ДатаМодификацииУниверсальная КАК ДатаМодификации,
		|	Ф.Автор КАК Автор,
		|	Ф.Описание КАК Описание,
		|	Ф.СтатусИзвлеченияТекста КАК СтатусИзвлеченияТекста,
		|	Ф.ТекстХранилище КАК ТекстХранилище,
		|	Ф.ПодписанЭП КАК ПодписанЭП,
		|	Ф.Зашифрован КАК Зашифрован,
		|	Ф.Редактирует КАК Редактирует,
		|	Ф.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	" + ИмяТаблицы + " КАК Ф
		|ГДЕ
		|	" + УсловиеОтбора;

КонецФункции

// Текст объединённого запроса свойств из секций + упорядочивание по имени файла.
//
// Параметры:
//  Секции - Массив из Строка - тексты секций объединения (непустой; пустому
//           множеству файлов соответствует пустой ответ, а не запрос).
//
// Возвращаемое значение:
//  Строка - полный текст запроса.
//
Функция ТекстЗапросаСвойствФайлов(Знач Секции)

	Возврат ТекстЗапросаОбъединения(Секции)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Наименование";

КонецФункции

// Соединяет секции запроса через ОБЪЕДИНИТЬ ВСЕ (запросы свойств и проверки
// владельцев собираются динамически по таблицам - P1 query_dynamic_text_building).
//
// Параметры:
//  Секции - Массив из Строка - тексты секций запроса (непустой).
//
// Возвращаемое значение:
//  Строка - текст запроса-объединения.
//
Функция ТекстЗапросаОбъединения(Знач Секции)

	Разделитель = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
	Возврат СтрСоединить(Секции, Разделитель);

КонецФункции

// Свойства файлов из выборки объединённого запроса -> Соответствие Ссылка ->
// Структура свойств.
Функция СвойстваИзВыборки(Знач Выборка)

	Свойства = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СтрокаСвойств = Новый Структура;
		СтрокаСвойств.Вставить("Ссылка", Выборка.Ссылка);
		СтрокаСвойств.Вставить("Наименование", Выборка.Наименование);
		СтрокаСвойств.Вставить("Расширение", Выборка.Расширение);
		СтрокаСвойств.Вставить("Размер", Выборка.Размер);
		СтрокаСвойств.Вставить("ДатаСоздания", Выборка.ДатаСоздания);
		СтрокаСвойств.Вставить("ДатаМодификации", Выборка.ДатаМодификации);
		СтрокаСвойств.Вставить("Автор", Выборка.Автор);
		СтрокаСвойств.Вставить("Описание", Выборка.Описание);
		СтрокаСвойств.Вставить("СтатусИзвлеченияТекста", Выборка.СтатусИзвлеченияТекста);
		СтрокаСвойств.Вставить("ТекстХранилище", Выборка.ТекстХранилище);
		СтрокаСвойств.Вставить("ПодписанЭП", Выборка.ПодписанЭП);
		СтрокаСвойств.Вставить("Зашифрован", Выборка.Зашифрован);
		СтрокаСвойств.Вставить("Редактирует", Выборка.Редактирует);
		СтрокаСвойств.Вставить("ВладелецФайла", Выборка.ВладелецФайла);
		Свойства.Вставить(Выборка.Ссылка, СтрокаСвойств);
	КонецЦикла;

	Возврат Свойства;

КонецФункции

#КонецОбласти

#Область СДокстер

// Распознавание файла сервисом S.Docster: POST multipart/form-data с полем
// file, ответ - JSON, текст в page_content (фактура 4.4). Свой HTTPСоединение:
// ar_HTTP.ВыполнитьPOST принимает тело только строкой и пропускает только
// адреса из списка разрешённых LLM-адресов (фактура, вывод 4).
//
// Недочёты образца llmp не повторяются (фактура 4.6): к page_content обращаемся
// только после успешного разбора ответа, поиск слова "error" в тексте документа
// не делаем, тело запроса пишется до Закрыть().
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Наименование   - Строка - имя файла (без расширения) для filename.
//  Расширение     - Строка - расширение файла (в нижнем регистре, без точки).
//  Таймаут        - Число  - секунды ожидания ответа (настройка SDocsterТаймаут).
//  Размер         - Число  - размер файла для записи в журнал.
//  ТекстОшибки    - Строка - очищенный текст ошибки (выходной, "" при успехе).
//
// Возвращаемое значение:
//  Строка - распознанный текст; "" при ошибке (статус файла не меняется).
//
Функция РаспознатьТекстSDocster(Знач ДвоичныеДанные, Знач Наименование, Знач Расширение,
	Знач Таймаут, Знач Размер, ТекстОшибки)

	ТекстОшибки = "";

	// Незаполненный или выключенный SDocsterАдрес - "сервис не настроен" без
	// обращения в сеть (спека п.А.13).
	АдресСервиса = СокрЛП(ar_Настройки.ЗначениеНастройки("SDocsterАдресСервиса", ""));
	Если ПустаяСтрока(АдресСервиса) Тогда
		ТекстОшибки = НСтр("ru = 'Сервис распознавания не настроен: заполните и включите настройку SDocsterАдресСервиса'");
		Возврат "";
	КонецЕсли;

	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса);
	Хост = СтруктураАдреса.Хост;
	Порт = СтруктураАдреса.Порт;
	АдресРесурса = СтруктураАдреса.ПутьНаСервере;
	Если ПустаяСтрока(Хост) Тогда
		ТекстОшибки = НСтр("ru = 'Настройка SDocsterАдресСервиса заполнена неверно: не найдено имя сервера'");
		Возврат "";
	КонецЕсли;
	Защищённое = НРег(СтруктураАдреса.Схема) = "https";
	КлючДоступа = СокрЛП(ar_Настройки.ЗначениеНастройки("SDocsterКлюч", ""));

	Граница = СтрЗаменить(ar_Утилиты.НовыйUUID(), "-", "");
	ТипСодержимого = ТипСодержимогоПоРасширению(Расширение);

	// Тело multipart-запроса собирается ЗаписьДанных в ПотокВПамяти, разделитель
	// строк ВК+ПС (образец llmp, фактура 4.4).
	ПотокВПамяти = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти, , , Символы.ВК + Символы.ПС, "");
	ЗаписьДанных.ЗаписатьСтроку("--" + Граница);
	ЗаписьДанных.ЗаписатьСтроку(
		"Content-Disposition: form-data; name=""file""; filename="""
		+ Наименование + "." + Расширение + """");
	ЗаписьДанных.ЗаписатьСтроку("Content-Type: " + ТипСодержимого);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Записать(ДвоичныеДанные);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.ЗаписатьСтроку("--" + Граница + "--");
	ЗаписьДанных.Закрыть();

	ТелоЗапроса = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();

	ЗащищённоеСоединение = Неопределено;
	Если Защищённое Тогда
		ЗащищённоеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	Соединение = Новый HTTPСоединение(Хост, ?(ЗначениеЗаполнено(Порт), Порт, Неопределено), , , ,
		Таймаут, ЗащищённоеСоединение);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Если Не ПустаяСтрока(КлючДоступа) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + КлючДоступа);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КодОтвета = 0;
	ТекстОтвета = "";
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		КодОтвета = Ответ.КодСостояния;
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		// Исключение соединения - ошибка с очищенным текстом, статус файла
		// не меняется (спека п.А.13).
		ЗаписатьЛогСДокстер(Наименование, Размер, 0, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера);
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

	ЗаписатьЛогСДокстер(Наименование, Размер, КодОтвета, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера);

	Если КодОтвета <> 200 Тогда
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(СтрШаблон(
			НСтр("ru = 'Сервис распознавания вернул код состояния %1'"), Формат(КодОтвета, "ЧГ=0")));
		Возврат "";
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(ТекстОтвета);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		ТекстОшибки = НСтр("ru = 'Сервис распознавания вернул не JSON-ответ'");
		Возврат "";
	КонецЕсли;

	ТекстСтраницы = Разобрано.Получить("page_content");
	Если ТипЗнч(ТекстСтраницы) <> Тип("Строка") Тогда
		ТекстОшибки = НСтр("ru = 'В ответе сервиса нет текста (page_content)'");
		Возврат "";
	КонецЕсли;

	// Пустой текст - ошибка "текст не извлечён" на шаге 6 спеки (здесь не
	// дублируется): возвращаем как есть, вызывающий код проверит.
	Возврат ТекстСтраницы;

КонецФункции

// Поддерживается ли расширение сервисом распознавания (спека п.А.12.5; doc
// обрабатывается платформой и сюда не попадает).
Функция РасширениеПоддерживаетсяСервисом(Знач Расширение)

	Возврат Расширение = "pdf"
		Или Расширение = "rtf"
		Или Расширение = "tif"
		Или Расширение = "tiff"
		Или Расширение = "jpg"
		Или Расширение = "jpeg"
		Или Расширение = "png"
		Или Расширение = "gif"
		Или Расширение = "bmp"
		Или Расширение = "xls"
		Или Расширение = "xlsx"
		Или Расширение = "docx"
		Или Расширение = "odt"
		Или Расширение = "ods"
		Или Расширение = "txt"
		Или Расширение = "xml"
		Или Расширение = "htm"
		Или Расширение = "html";

КонецФункции

// Тип содержимого multipart-части по расширению файла (фактура 4.4).
Функция ТипСодержимогоПоРасширению(Знач Расширение)

	Если Расширение = "txt" Тогда
		Возврат "text/plain";
	ИначеЕсли Расширение = "xml" Тогда
		Возврат "application/xml";
	ИначеЕсли Расширение = "htm" Или Расширение = "html" Тогда
		Возврат "text/html";
	ИначеЕсли Расширение = "pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = "rtf" Тогда
		Возврат "application/rtf";
	ИначеЕсли Расширение = "tif" Или Расширение = "tiff" Тогда
		Возврат "image/tiff";
	ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "xls" Тогда
		Возврат "application/vnd.ms-excel";
	ИначеЕсли Расширение = "odt" Тогда
		Возврат "application/vnd.oasis.opendocument.text";
	ИначеЕсли Расширение = "ods" Тогда
		Возврат "application/vnd.oasis.opendocument.spreadsheet";
	ИначеЕсли Расширение = "docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	Иначе
		Возврат "application/octet-stream";
	КонецЕсли;

КонецФункции

// Каждое обращение к S.Docster - запись в ar_СлужебныйЛог: файл, размер, код
// ответа, длительность (спека п.А.13).
Процедура ЗаписатьЛогСДокстер(Знач Наименование, Знач Размер, Знач КодОтвета, Знач ДлительностьМс)

	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "sdocster_request",
		СтрШаблон("%1 (%2 байт): код=%3, %4 мс", Наименование, Формат(Размер, "ЧГ=0"),
			Формат(КодОтвета, "ЧГ=0"), Формат(ДлительностьМс, "ЧГ=0")));

КонецПроцедуры

#КонецОбласти

#Область АргументыИОшибки

// Разбирает JSON-строку аргументов инструмента в Соответствие.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; Неопределено при пустом входе или
//  ошибке разбора JSON.
//
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ar_JSON.ИзJSON(АргументыJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает значение поля из Соответствия аргументов с дефолтом при отсутствии.
Функция ЗначениеИзКоллекции(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;

	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Формирует JSON-строку ошибки-observation.
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>"}.
//
Функция ОшибкаИнструмента(Знач КодОшибки)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

#КонецОбласти

#КонецОбласти
