#Область ПрограммныйИнтерфейс

// Пакет инструментов AgentRunner «Присоединённые файлы» (задача agentrunner-21,
// распознавание RAGU - задача agentrunner-73, запасной S.Docster в очереди и
// извлечение офисных форматов платформой - задача agentrunner-100).
//
// Два инструмента для работы с файлами, присоединёнными к документам и
// справочникам (БСП «Работа с файлами»):
//   * files_list      - список файлов владельца (УровеньРиска = Чтение);
//   * files_get_text  - текст файлов: из кэша ТекстХранилище, для офисных
//                       форматов (doc, xls, xlsx, docx) - платформенным
//                       извлечением, для остальных - сервисом RAGU, при его
//                       неудаче - запасным S.Docster (спека agentrunner-73
//                       п.2); результат записывается в справочник файлов.
//                       УровеньРиска = Чтение (дополнение человека
//                       2026-10-13): записывается только служебный кэш
//                       текста, данные владельца не меняются, поэтому в
//                       режимах «Ручной» и «Авто-порог» подтверждение не
//                       запрашивается.
//
// Регистрация в БСП «Дополнительные отчёты и обработки». Вид =
// ДополнительнаяОбработка (глобальный, без Назначения). БезопасныйРежим = Ложь -
// пакету нужен выход в сеть (обращение к сервисам распознавания RAGU и
// S.Docster); решение человека 2026-10-01 (Р1) - ядро при этом пишет
// предупреждение package_registered_unsafe_mode и событие аудита
// package_registered_unsafe.
//
// Команда с Идентификатор = "ar_ToolPack" - маркер принадлежности пакета
// AgentRunner (см. .docs/Контракт-пакета-tools.md §1.2). Значение
// регистрозависимое и фиксированное - по нему ядро отбирает кандидатов на
// регистрацию запросом к ТЧ Команды, без загрузки бинарника обработки.
//
// Манифест - схема 2: русские ключи (ВерсияСхемы, ПространствоИмён,
// Инструменты, СхемаАргументовJSON, УровеньРиска, ТребуетПодтверждения) и
// необязательный ключ Настройки - ядро создаёт недостающие настройки при
// регистрации (спека agentrunner-21 п.Б).
//
// Команда "ar_ПредварительноеРаспознавание" (agentrunner-74) запускается
// регламентным заданием БСП: заранее распознаёт файлы владельцев агентов
// в асинхронный RAGU и пишет текст в кэш справочника файлов (очередь -
// РегистрСведений.ar_ОчередьРаспознавания расширения, API - общий модуль
// ar_ОчередьРаспознавания).
//
// Латиницей - только внешние протоколы: имена инструментов, ключи JSON
// (owner, count, files, ref, name, ...), поле ответа S.Docster page_content,
// заголовки HTTP. Имена процедур, переменных и тексты - по-русски.
//
// Исполнение: весь код - серверный (ВызовСерверногоМетода); привилегированный
// режим поднимается точечно (запись кэша текста) - доступ к владельцу файлов
// проверяется по правам пользователя сеанса.

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчёты и
// обработки» (см. .docs/Контракт-пакета-tools.md §1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	// 1.5.3 - исполнитель подтверждённого действия files_get_text: отказ
	// инструмента - Выполнено = Ложь (agentrunner-419; ответ ar_JSON
	// начинается с переноса строки, проверка по началу строки не срабатывала).
	// 1.5.2 - соединение со статусами заявок только в секциях справочников,
	// где владельцем может быть заявка (ошибка «Несовместимые типы "ССЫЛКА"»);
	// представление маркерной команды - «Служебная: ... (не для расписания)»,
	// чтобы её не путали с командой-заданием; идентификаторы не изменены.
	// 1.5.1 - отсеивание закрытых заявок НСИ перенесено в запрос отбора:
	// соединение с бит_СтатусыОбъектов в секциях (исправление по итогам
	// verify agentrunner-220 - отсеивание отдельным запросом после отбора
	// не срабатывало в такте).
	// 1.5.0 - файлы закрытых заявок НСИ не ставятся в очередь распознавания
	// (agentrunner-220); версия регистрации = версия манифеста (ВерсияПакета,
	// как в ar_ПакетНСИ - решение человека, agentrunner-213).
	// 1.4.2 - представление команды-задания по шаблону «AgentRunner Пакет
	// инструментов: <задание>» (agentrunner-125); идентификатор команды не
	// изменен - расписания продолжают работать.
	// 1.4.1 - переименование экспорта разбора очереди отправки в
	// РазобратьОчередьОтправки (спека agentrunner-112).
	ПараметрыРегистрации.Версия = ВерсияПакета();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Пакет инструментов AgentRunner: присоединённые файлы'");

	// Решение человека 2026-10-01 (Р1, спека agentrunner-21 п.А.9): пакету
	// нужен выход в сеть для S.Docster - в безопасном режиме платформа
	// запрещает доступ к сети.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Служебная: маркер пакета AgentRunner (не для расписания)'");
	НоваяКоманда.Идентификатор        = "ar_ToolPack";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	// Предварительное распознавание (спека agentrunner-74 п.Б.3): команда
	// запускается регламентным заданием БСП (расписание задаёт администратор
	// в карточке обработки) и по такту ставит новые файлы владельцев агентов
	// в очередь ar_ОчередьРаспознавания, отправляет в RAGU и пишет текст в кэш.
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление        = НСтр("ru = 'AgentRunner Пакет инструментов: Предварительное распознавание файлов'");
	Команда.Идентификатор        = "ar_ПредварительноеРаспознавание";
	Команда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Версия пакета - одна для регистрации обработки (СведенияОВнешнейОбработке)
// и манифеста (ar_ОписаниеИнструментов), правило «версия регистрации =
// версия манифеста» (решение человека, agentrunner-213). История версий - в
// комментариях манифеста.
//
// Возвращаемое значение:
//  Строка - версия пакета.
//
Функция ВерсияПакета()

	Возврат "1.5.3";

КонецФункции

// Обработчик команд БСП "Дополнительные отчёты и обработки". Команда
// "ar_ToolPack" - маркерная: её интерактивный вызов не предусмотрен, она
// существует только для отбора кандидатов на регистрацию пакета ядром
// AgentRunner - поэтому обработчик только поясняет. Команда
// "ar_ПредварительноеРаспознавание" выполняет такт предварительного
// распознавания - запускается регламентным заданием БСП (спека
// agentrunner-74 п.Б.3).
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы.ВыполнитьКоманду", "files_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,'
				|' прикладного действия по этой команде не предусмотрено.'"));
	ИначеЕсли ИдентификаторКоманды = "ar_ПредварительноеРаспознавание" Тогда
		// Такт предварительного распознавания (спека agentrunner-74 п.Б.4-11).
		ВыполнитьТактПредварительногоРаспознавания();
	Иначе
		// Команда вызвана вне регламентного задания и маркера пакета.
		ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы.ВыполнитьКоманду", "files_command_unknown",
			ИдентификаторКоманды, "Предупреждение");
	КонецЕсли;

КонецПроцедуры

// Манифест пакета инструментов - контракт AgentRunner, схема 2 (см.
// .docs/Контракт-пакета-tools.md §1.4). Вызывается ядром AgentRunner при
// регистрации/переподтверждении пакета. Не принимает аргументов.
//
// Возвращаемое значение:
//  Структура - манифест пакета:
//   * ВерсияСхемы      - Число   - версия схемы контракта (текущая - 2).
//   * ПространствоИмён - Строка  - префикс имён инструментов пакета ("files").
//   * Версия           - Строка  - SemVer версии пакета.
//   * Категории        - Массив структур - {Имя, Представление, ОписаниеДляLLM, Порядок}.
//   * Инструменты      - Массив структур - описания инструментов (§1.5 контракта).
//   * Настройки        - Массив структур - {Ключ, Наименование, Описание,
//                        ЗначениеПоУмолчанию} - ядро создаёт недостающие
//                        настройки при регистрации (спека agentrunner-21 п.Б).
//
Функция ar_ОписаниеИнструментов() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("ВерсияСхемы", 2);
	Манифест.Вставить("ПространствоИмён", "files");
	// 1.5.3 - ar_ИсполнитьПодтверждённыйИнструмент: отказ files_get_text даёт
	//         Выполнено = Ложь (agentrunner-419).
	// 1.5.2 - соединение со статусами только в секциях справочников, где
	//         владельцем может быть заявка (ошибка «Несовместимые типы
	//         "ССЫЛКА"»); маркерная команда переименована в служебную.
	// 1.5.1 - отсеивание закрытых заявок НСИ перенесено в запрос отбора
	//         (исправление по итогам verify agentrunner-220).
	// 1.5.0 - файлы закрытых заявок НСИ (статус «Исполнена»/«Закрыт» в
	//         бит_СтатусыОбъектов) не ставятся в очередь распознавания
	//         (agentrunner-220).
	// 1.3.0 - S.Docster запасным в очереди, платформа для xls/xlsx/docx
	// (спека agentrunner-100).
	Манифест.Вставить("Версия", ВерсияПакета());

	Категория = Новый Структура;
	Категория.Вставить("Имя", "files");
	Категория.Вставить("Представление", НСтр("ru = 'Присоединённые файлы'"));
	Категория.Вставить("ОписаниеДляLLM",
		НСтр("ru = 'Файлы, присоединённые к документам и справочникам: список и текст (в том числе распознавание сканов)'"));
	Категория.Вставить("Порядок", 1);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаСписокФайлов());
	Инструменты.Добавить(ОписаниеИнструментаТекстФайлов());
	Манифест.Вставить("Инструменты", Инструменты);

	Манифест.Вставить("Настройки", ОписанияНастроекПакета());

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md §1.6). Вызывается ядром AgentRunner на каждый
// вызов инструмента из этого пакета. Диспетчеризация - по имени, без
// Выполнить()/Вычислить().
//
// Параметры:
//  ИмяTool       - Строка    - полное имя инструмента с пространством имён
//                  ("files_list", "files_get_text").
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащённый
//                  ядром системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = "files_list" Тогда
		Возврат ВыполнитьСписокФайлов(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "files_get_text" Тогда
		Возврат ВыполнитьТекстФайлов(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаИнструмента("unknown_tool");
	КонецЕсли;

КонецФункции

// Исполнитель подтверждённого действия (контракт PKG-09): вызывается ядром после
// того, как оператор разрешил вызов инструмента. Нужен, хотя files_get_text с
// agentrunner-100 имеет УровеньРиска = Чтение и новых подтверждений не создает:
// в очереди подтверждений могут оставаться записи прежней версии инструмента
// (уровень «Запись»), их исполняет только пакет. Результат инструмента
// (JSON ответа files_get_text) возвращается единственным сообщением - ядро
// передает его модели как итог.
//
// Параметры:
//  ИмяTool           - Строка - полное имя инструмента.
//  ApprovalId        - Строка - идентификатор записи очереди подтверждений.
//  ActionPayloadJSON - Строка - JSON действия; аргументы инструмента - в ключе arguments.
//
// Возвращаемое значение:
//  Структура - {Выполнено, DocumentRef, Сообщения}.
//
Функция ar_ИсполнитьПодтверждённыйИнструмент(Знач ИмяTool, Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	Если ИмяTool <> "files_get_text" Тогда
		Результат.Сообщения.Добавить("no_executor_for_action:" + ИмяTool);
		Возврат Результат;
	КонецЕсли;

	Действие = ar_JSON.ИзJSON(ActionPayloadJSON);
	Аргументы = ?(ТипЗнч(Действие) = Тип("Соответствие"), Действие.Получить("arguments"), Неопределено);
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	АргументыJSON = ?(ТипЗнч(Аргументы) = Тип("Строка"), Аргументы, ar_JSON.ВЗначениеJSON(Аргументы));

	ОтветJSON = ВыполнитьТекстФайлов(АргументыJSON, Неопределено);
	Результат.Сообщения.Добавить(ОтветJSON);
	Результат.Выполнено = Не ЭтоОтказИнструмента(ОтветJSON);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОписаниеИнструментов

// Описание инструмента files_list для манифеста пакета (УровеньРиска = Чтение,
// ТребуетПодтверждения = Ложь): список файлов владельца без записи в ИБ.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаСписокФайлов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "files_list");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает список файлов, присоединённых к документу или элементу справочника (владельцу).
			|Для каждого файла: имя, расширение, размер, даты, автор, описание, статус извлечения текста,
			|признаки шифрования, подписи и редактирования. Помеченные на удаление файлы не возвращаются.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Список присоединённых файлов владельца'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовСписокФайлов());
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// Описание инструмента files_get_text для манифеста пакета. УровеньРиска =
// Чтение (дополнение человека 2026-10-13, спека agentrunner-100 п.6): в
// справочник пишется только служебный кэш извлеченного текста, данные
// владельца не меняются - инструмент не должен требовать подтверждения в
// режимах «Ручной» и «Авто-порог» (ядро, ar_ПравилаДвижок
// .ПрименитьПорогРежима, ставит в очередь подтверждений действия уровня
// «Запись» независимо от ТребуетПодтверждения; для «Чтение» пропуск
// подтвержден кодом ядра). ОбоснованиеЗаписиБезПодтверждения убрано - ядро
// проверяет его только для «Записи».
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаТекстФайлов()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "files_get_text");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает текст присоединённых файлов. Источник текста: кэш справочника файлов,
			|платформенное извлечение для офисных форматов doc, xls, xlsx, docx (при пустом тексте -
			|далее сервисы), сервис распознавания RAGU для остальных (сканы, pdf, картинки и т.п.),
			|при его недоступности - запасной S.Docster. Извлечённый текст сохраняется в справочнике файлов,
			|чтобы повторные вызовы возвращали его из кэша. Для каждого файла поле service содержит имя
			|источника текста (platform, ragu, sdocster; пусто для кэша), а поле fallback_reason - краткую
			|причину перехода к следующему источнику, если он использовался. Не более 10 файлов за вызов.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Текст присоединённых файлов'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовТекстФайлов());
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// 1.2.0 - уровень риска «Чтение», платформа для xls/xlsx/docx (спека
	// agentrunner-100 п.6-п.7).
	Описание.Вставить("Версия", "1.2.0");
	Описание.Вставить("Категория", "files");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов files_list в OpenAI tool-format.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСписокФайлов()

	Свойства = Новый Структура;
	Свойства.Вставить("owner", СвойствоСхемы("string",
		НСтр("ru = 'Навигационная ссылка e1cib/data/... на документ или элемент справочника - владельца файлов.'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("owner");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("files_list",
		НСтр("ru = 'Список файлов, присоединённых к документу или элементу справочника.'"), Параметры);

КонецФункции

// JSON Schema аргументов files_get_text в OpenAI tool-format: files (массив
// ссылок на файлы) ИЛИ owner (все файлы владельца) - один из двух.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовТекстФайлов()

	СвойствоСтроки = Новый Структура;
	СвойствоСтроки.Вставить("type", "string");

	СвойствоФайлов = Новый Структура;
	СвойствоФайлов.Вставить("type", "array");
	СвойствоФайлов.Вставить("items", СвойствоСтроки);
	СвойствоФайлов.Вставить("description",
		НСтр("ru = 'Навигационные ссылки e1cib/data/... на присоединённые файлы. Не более 10 за вызов.'"));

	Свойства = Новый Структура;
	Свойства.Вставить("files", СвойствоФайлов);
	Свойства.Вставить("owner", СвойствоСхемы("string",
		НСтр("ru = 'Навигационная ссылка на владельца - обрабатываются все его присоединённые файлы (не более 10).'")));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФормат("files_get_text",
		НСтр("ru = 'Текст присоединённых файлов (из кэша, платформой для офисных форматов, распознаванием для остальных).'"),
		Параметры);

КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
//
// Параметры:
//  Тип      - Строка - тип JSON Schema свойства ("string", "array" и т. п.).
//  Описание - Строка - человекочитаемое описание свойства для LLM.
//
// Возвращаемое значение:
//  Структура - {type, description}.
//
Функция СвойствоСхемы(Знач Тип, Знач Описание)

	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
//
// Параметры:
//  Имя       - Строка    - полное имя инструмента (с пространством имён).
//  Описание  - Строка    - человекочитаемое описание инструмента для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, ...}).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)

	ОписаниеФункции = Новый Структура;
	ОписаниеФункции.Вставить("name", Имя);
	ОписаниеФункции.Вставить("description", Описание);
	ОписаниеФункции.Вставить("parameters", Параметры);

	Обёртка = Новый Структура;
	Обёртка.Вставить("type", "function");
	Обёртка.Вставить("function", ОписаниеФункции);
	Возврат ar_JSON.ВЗначениеJSON(Обёртка);

КонецФункции

// Настройки пакета (спека agentrunner-21 п.А.14): ядро создаёт недостающие
// при регистрации. Без значения по умолчанию создаются выключенными - пока
// администратор не заполнит (адрес сервиса даёт человек, Р10).
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписанияНастроекПакета()

	Настройки = Новый Массив;

	Настройки.Добавить(ОписаниеНастройки("SDocsterАдресСервиса",
		НСтр("ru = 'S.Docster: адрес сервиса'"),
		НСтр("ru = 'Полный адрес сервиса распознавания S.Docster одной строкой, например
			|http://сервер:8080/путь или https://сервер/путь. Пока не заполнено и не включено,
			|инструмент files_get_text возвращает ошибку ""сервис не настроен"", не обращаясь в сеть.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("SDocsterКлюч",
		НСтр("ru = 'S.Docster: API-ключ'"),
		НСтр("ru = 'Ключ доступа к сервису S.Docster; передаётся в заголовке Authorization: Bearer.
			|Если сервис ключа не требует - оставьте настройку выключенной.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("SDocsterТаймаут",
		НСтр("ru = 'S.Docster: таймаут, сек'"),
		НСтр("ru = 'Сколько секунд ждать ответа сервиса распознавания.'"),
		120));

	// Настройки RAGU (спека agentrunner-73 п.1): RAGU - основной сервис
	// распознавания в files_get_text, S.Docster - запасной.
	Настройки.Добавить(ОписаниеНастройки("RAGUАдресСервиса",
		НСтр("ru = 'RAGU: адрес сервиса'"),
		НСтр("ru = 'Базовый адрес сервиса распознавания RAGU одной строкой, например https://сервер.
			|Путь /api/v1/parse/text добавляется кодом. Пока не заполнено и не включено, RAGU не используется:
			|files_get_text распознаёт через S.Docster.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("RAGUТокен",
		НСтр("ru = 'RAGU: токен'"),
		НСтр("ru = 'Токен доступа к сервису RAGU (ragu_...); передаётся в заголовке Authorization: Bearer.
			|Пока не заполнено и не включено, RAGU не используется.'"),
		Неопределено));

	Настройки.Добавить(ОписаниеНастройки("RAGUОжидание",
		НСтр("ru = 'RAGU: ожидание ответа (wait), сек'"),
		НСтр("ru = 'Сколько секунд сервис RAGU может обрабатывать файл до ответа (параметр wait запроса),
			|от 0 до 300. Значение вне диапазона заменяется на 60.'"),
		60));

	Настройки.Добавить(ОписаниеНастройки("ПредельноеВремяВызоваТекстаФайлов",
		НСтр("ru = 'Предельное время вызова текста файлов, сек'"),
		НСтр("ru = 'Общий бюджет одного вызова files_get_text на все его файлы. Когда время исчерпано, оставшиеся
			|файлы возвращаются с ошибкой без обращения к сервисам распознавания - повторите вызов по этим файлам.'"),
		600));

	Настройки.Добавить(ОписаниеНастройки("ПредельныйРазмерФайлаРаспознавания",
		НСтр("ru = 'Предельный размер файла распознавания, байт'"),
		НСтр("ru = 'Файлы больше этого размера не распознаются - отказ без обращения к сервису.'"),
		20000000));

	Настройки.Добавить(ОписаниеНастройки("ПредельнаяДлинаТекстаФайла",
		НСтр("ru = 'Предельная длина текста файла, символов'"),
		НСтр("ru = 'Столько символов текста возвращается агенту; более длинный текст усекается
			|с признаком truncated, в справочнике файлов хранится полностью.'"),
		50000));

	// Настройки многопоточной отправки (спека agentrunner-111 п.7): отдельный
	// признак параллельного режима не заводится - 0 и есть последовательный
	// режим; на файловой ИБ значение трактуется как 0 (слот фонового задания
	// занят самим тактом).
	Настройки.Добавить(ОписаниеНастройки("OCRВоркеровМаксимум",
		НСтр("ru = 'OCR: максимум воркеров отправки'"),
		НСтр("ru = 'Сколько фоновых заданий-воркеров параллельно отправляют очередь распознавания
			|(0 - последовательный режим, отправка внутри такта; 1-4 - параллельный). На файловой
			|информационной базе воркеры недоступны, значение трактуется как 0.'"),
		0));

	Настройки.Добавить(ОписаниеНастройки("OCRРазмерПартии",
		НСтр("ru = 'OCR: размер партии воркера'"),
		НСтр("ru = 'Сколько queued-строк очереди распознавания берет воркер за одну итерацию
			|отправки (или такт в последовательном режиме).'"),
		10));

	Возврат Настройки;

КонецФункции

// Конструктор одного описания настройки пакета для ключа Настройки манифеста.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (Код элемента справочника).
//  Наименование        - Строка - наименование настройки для пользователя.
//  Описание            - Строка - описание настройки для пользователя.
//  ЗначениеПоУмолчанию - Строка/Число/Булево - значение по умолчанию;
//                        Неопределено - настройка создаётся выключенной,
//                        пока администратор её не заполнит и не включит.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	ОписаниеЭлемента = Новый Структура;
	ОписаниеЭлемента.Вставить("Ключ", Ключ);
	ОписаниеЭлемента.Вставить("Наименование", Наименование);
	ОписаниеЭлемента.Вставить("Описание", Описание);
	// Неопределено сериализуется ar_JSON как null: отсутствие значения
	// по умолчанию (спека п.Б.5) - ядро создаёт такую настройку выключенной.
	ОписаниеЭлемента.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Возврат ОписаниеЭлемента;

КонецФункции

#КонецОбласти

#Область ИнструментСписокФайлов

// Реализация инструмента files_list: список файлов владельца одним запросом
// (объединение по справочникам файлов), без ДанныеФайла в цикле. Ответ:
// {"owner","count","files":[{ref,name,extension,size,created,modified,author,
// description,text_status,has_text,encrypted,signed,being_edited}]}.
//
// Порядок проверки (спека п.А.10): ссылка разобрана и объект существует;
// к объекту присоединяются файлы; пользователь сеанса видит владельца
// (запрос РАЗРЕШЕННЫЕ - функции БСП списка файлов работают привилегированно
// и ограничения доступа не учитывают).
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"owner": "<навигационная ссылка>"}.
//  Контекст      - Структура - контекст запуска. Не используется (чтение).
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ВыполнитьСписокФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Владелец = ВладелецИзАргументов(Аргументы);
	Если Владелец = Неопределено Или Не ВладелецВиденПользователю(Владелец) Тогда
		Возврат ОшибкаИнструмента("owner_not_found_or_denied");
	КонецЕсли;

	Если Не РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Владелец) Тогда
		Возврат ОшибкаИнструмента("owner_files_not_supported");
	КонецЕсли;

	ФайлыОтвета = Новый Массив;
	СвойстваФайлов = СвойстваФайловВладельца(Владелец);
	Для Каждого Свойства Из СвойстваФайлов Цикл
		ФайлыОтвета.Добавить(ЭлементСпискаФайлов(Свойства.Значение));
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("owner", ЗначениеИзКоллекции(Аргументы, "owner", ""));
	Ответ.Вставить("count", ФайлыОтвета.Количество());
	Ответ.Вставить("files", ФайлыОтвета);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Элемент массива files ответа files_list по структуре свойств файла.
//
// Параметры:
//  Свойства - Структура - свойства файла (см. СвойстваФайловВладельца).
//
// Возвращаемое значение:
//  Структура - {ref, name, extension, size, created, modified, author,
//               description, text_status, has_text, encrypted, signed, being_edited}.
//
Функция ЭлементСпискаФайлов(Знач Свойства)

	Элемент = Новый Структура;
	Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Свойства.Ссылка));
	Элемент.Вставить("name", Свойства.Наименование);
	Элемент.Вставить("extension", Свойства.Расширение);
	Элемент.Вставить("size", Свойства.Размер);
	Элемент.Вставить("created", Свойства.ДатаСоздания);
	Элемент.Вставить("modified", Свойства.ДатаМодификации);
	Элемент.Вставить("author", Строка(Свойства.Автор));
	Элемент.Вставить("description", Свойства.Описание);
	Элемент.Вставить("text_status", Строка(Свойства.СтатусИзвлеченияТекста));
	Элемент.Вставить("has_text", Свойства.СтатусИзвлеченияТекста
		= Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен);
	Элемент.Вставить("encrypted", Свойства.Зашифрован);
	Элемент.Вставить("signed", Свойства.ПодписанЭП);
	Элемент.Вставить("being_edited", ЗначениеЗаполнено(Свойства.Редактирует));
	Возврат Элемент;

КонецФункции

#КонецОбласти

#Область ИнструментТекстФайлов

// Реализация инструмента files_get_text. DryRun проверяется первым делом:
// в пробном запуске сервис не вызывается и ничего не пишется - возвращается
// перечень файлов и что было бы сделано (спека п.А.11).
//
// Порядок по одному файлу (спека п.А.12): кэш -> отказы без сервиса
// (зашифрован, размер, расширение) -> двоичные данные -> платформа (doc) /
// RAGU -> при неудаче RAGU - запасной S.Docster (спека agentrunner-73 п.2) ->
// пустой текст = ошибка -> запись кэша в справочник. Ошибка по одному файлу
// не мешает остальным: исключения наружу не выходят.
//
// Бюджет вызова (спека agentrunner-73 п.5): перед каждым файлом проверяется
// прошедшее время вызова; бюджет исчерпан - оставшиеся файлы получают ошибку
// без обращения к сервисам.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"files": [...]} либо {"owner": "..."}.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, ...); из него
//                  берётся RunId для замера распознавания (спека agentrunner-73 п.6).
//
// Возвращаемое значение:
//  Строка - JSON-observation
//  {"count","files_skipped","results":[{ref,name,source,service,fallback_reason,
//   text,text_length,truncated,saved,error}]}.
//
Функция ВыполнитьТекстФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Выборка = ВыбратьФайлыДляИзвлечения(Аргументы);
	Если Выборка.Отказ Тогда
		Возврат ОшибкаИнструмента(Выборка.КодОшибки);
	КонецЕсли;

	// DryRun - после разбора аргументов (нужен перечень файлов) и до первого
	// обращения к сервису или записи.
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("files_get_text",
			ПланИзвлеченияТекстов(Выборка));
	КонецЕсли;

	НастройкиИзвлечения = НастройкиИзвлеченияТекста();
	RunIdВызова = RunIdИзКонтекста(Контекст);
	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результаты = Новый Массив;
	Для Каждого ФайлСсылка Из Выборка.Файлы Цикл
		Свойства = Выборка.Свойства.Получить(ФайлСсылка);
		Если Свойства = Неопределено Тогда
			Результаты.Добавить(ЭлементРезультатаОшибки(ФайлСсылка, "file_not_found_or_denied"));
		ИначеЕсли Не Выборка.ВидимыеВладельцы.Получить(Свойства.ВладелецФайла) = Истина Тогда
			Результаты.Добавить(ЭлементРезультатаОшибки(ФайлСсылка, "owner_not_found_or_denied"));
		ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова
			>= НастройкиИзвлечения.БюджетВызоваСек * 1000 Тогда
			// Бюджет исчерпан - оставшиеся файлы без обращения к сервисам
			// (спека agentrunner-73 п.5).
			ЭлементБюджета = ЭлементРезультатаОшибки(ФайлСсылка,
				НСтр("ru = 'Не обработан: исчерпано время вызова, повторите files_get_text по этим файлам'"));
			ЭлементБюджета.name = Свойства.Наименование;
			Результаты.Добавить(ЭлементБюджета);
		Иначе
			Результаты.Добавить(ИзвлечьТекстФайла(ФайлСсылка, Свойства, НастройкиИзвлечения, RunIdВызова));
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("count", Результаты.Количество());
	Ответ.Вставить("files_skipped", Выборка.Пропущено);
	Ответ.Вставить("results", Результаты);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Выбирает и разрешает файлы для files_get_text: явный массив files ИЛИ все
// файлы владельца owner; не более 10 файлов за вызов (спека п.А.11), лишние -
// в Пропущено.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//
// Возвращаемое значение:
//  Структура:
//   * Отказ            - Булево - Истина при ошибке выбора (КодОшибки заполнен).
//   * КодОшибки        - Строка - код ошибки для ответа.
//   * Файлы            - Массив - ссылки на файлы (до 10).
//   * Свойства         - Соответствие - Ссылка -> структура свойств файла
//                        (файлы, не попавшие в выборку запроса, - не найдены
//                        или скрыты ограничением доступа).
//   * ВидимыеВладельцы - Соответствие - ссылка владельца -> Истина, если
//                        пользователь сеанса его видит (запрос РАЗРЕШЕННЫЕ).
//   * Пропущено        - Число - сколько файлов сверх предела не обрабатывалось.
//
Функция ВыбратьФайлыДляИзвлечения(Знач Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Файлы", Новый Массив);
	Результат.Вставить("Свойства", Новый Соответствие);
	Результат.Вставить("ВидимыеВладельцы", Новый Соответствие);
	Результат.Вставить("Пропущено", 0);

	СсылкиФайлов = СсылкиФайловИзАргументов(Аргументы);

	Если СсылкиФайлов <> Неопределено Тогда
		Результат.Файлы = ОграничитьФайлыПределом(СсылкиФайлов, Результат.Пропущено);
		Если Результат.Файлы.Количество() > 0 Тогда
			Результат.Свойства = СвойстваФайловПоСсылкам(Результат.Файлы);
			// Явный список файлов: доступ проверяется по владельцу каждого
			// файла (спека п.А.12) - одним объединённым запросом РАЗРЕШЕННЫЕ
			// по всем владельцам.
			Результат.ВидимыеВладельцы = ВидимыеВладельцыФайлов(Результат.Свойства);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Владелец = ВладелецИзАргументов(Аргументы);
	Если Владелец = Неопределено Или Не ВладелецВиденПользователю(Владелец) Тогда
		Результат.Отказ = Истина;
		Результат.КодОшибки = "owner_not_found_or_denied";
		Возврат Результат;
	КонецЕсли;

	Если Не РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(Владелец) Тогда
		Результат.Отказ = Истина;
		Результат.КодОшибки = "owner_files_not_supported";
		Возврат Результат;
	КонецЕсли;

	Результат.Свойства = СвойстваФайловВладельца(Владелец);
	ВсеФайлыВладельца = Новый Массив;
	Для Каждого Элемент Из Результат.Свойства Цикл
		ВсеФайлыВладельца.Добавить(Элемент.Ключ);
	КонецЦикла;
	Результат.Файлы = ОграничитьФайлыПределом(ВсеФайлыВладельца, Результат.Пропущено);
	Результат.ВидимыеВладельцы.Вставить(Владелец, Истина);

	Возврат Результат;

КонецФункции

// Разбирает аргумент files в массив ссылок на файлы; элементы, не являющиеся
// строкой, и ссылки, по которым файл не удалось найти, отбрасываются - без
// элемента ответа и без учёта в files_skipped: ошибка в элементе ответа
// (спека п.А.12) даётся только файлам, попавшим в выборку.
//
// Возвращаемое значение:
//  Массив ссылок, либо Неопределено, если аргумента files нет.
//
Функция СсылкиФайловИзАргументов(Знач Аргументы)

	АргументФайлы = Аргументы.Получить("files");
	Если АргументФайлы = Неопределено Или ТипЗнч(АргументФайлы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого СтрокаСсылки Из АргументФайлы Цикл
		Если ТипЗнч(СтрокаСсылки) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
		Если ФайлСсылка <> Неопределено Тогда
			Ссылки.Добавить(ФайлСсылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// Оставляет первые ПределФайловЗаВызова() файлов; число лишних записывает в
// Пропущено (передан по ссылке).
Функция ОграничитьФайлыПределом(Знач СсылкиФайлов, Пропущено)

	Предел = ПределФайловЗаВызова();
	Пропущено = Макс(СсылкиФайлов.Количество() - Предел, 0);

	Ограниченные = Новый Массив;
	Для Индекс = 0 По Предел - 1 Цикл
		Если Индекс >= СсылкиФайлов.Количество() Тогда
			Прервать;
		КонецЕсли;
		Ограниченные.Добавить(СсылкиФайлов[Индекс]);
	КонецЦикла;

	Возврат Ограниченные;

КонецФункции

// Максимальное число файлов за один вызов files_get_text: каждый файл может
// занять до бюджета вызова, без предела запуск упрётся в контроль зависаний
// (решение человека 2026-10-01, спека п.А.11; общий бюджет одного вызова -
// настройка ПредельноеВремяВызоваТекстаФайлов, спека agentrunner-73 п.5).
Функция ПределФайловЗаВызова()
	Возврат 10;
КонецФункции

// План пробного запуска files_get_text: по каждому файлу - что было бы сделано,
// без обращения к сервису и без записи.
//
// Параметры:
//  Выборка - Структура - результат ВыбратьФайлыДляИзвлечения.
//
// Возвращаемое значение:
//  Структура - {count, files_skipped, files:[{ref, name, action}]}.
//
Функция ПланИзвлеченияТекстов(Знач Выборка)

	НастройкиИзвлечения = НастройкиИзвлеченияТекста();
	ЭлементыПлана = Новый Массив;

	Для Каждого ФайлСсылка Из Выборка.Файлы Цикл

		Свойства = Выборка.Свойства.Получить(ФайлСсылка);
		ЭлементПлана = Новый Структура;
		ЭлементПлана.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлСсылка));
		ЭлементПлана.Вставить("name", ?(Свойства = Неопределено, "", Свойства.Наименование));

		Если Свойства = Неопределено Тогда
			Действие = НСтр("ru = 'ошибка: файл не найден или недоступен'");
		ИначеЕсли Не Выборка.ВидимыеВладельцы.Получить(Свойства.ВладелецФайла) = Истина Тогда
			Действие = НСтр("ru = 'ошибка: владелец файла недоступен'");
		Иначе
			Действие = ДействиеПоФайлу(Свойства, НастройкиИзвлечения);
		КонецЕсли;

		ЭлементПлана.Вставить("action", Действие);
		ЭлементыПлана.Добавить(ЭлементПлана);

	КонецЦикла;

	План = Новый Структура;
	План.Вставить("count", ЭлементыПлана.Количество());
	План.Вставить("files_skipped", Выборка.Пропущено);
	План.Вставить("files", ЭлементыПлана);
	Возврат План;

КонецФункции

// Краткое описание того, что будет сделано с файлом при реальном запуске
// (тот же порядок проверок, что в ИзвлечьТекстФайла, - только чтение свойств).
Функция ДействиеПоФайлу(Знач Свойства, Знач НастройкиИзвлечения)

	Если Свойства.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		Если Не ПустаяСтрока(ТекстИзХранилища(Свойства.ТекстХранилище)) Тогда
			Возврат НСтр("ru = 'вернуть текст из кэша'");
		КонецЕсли;
	КонецЕсли;

	Если Свойства.Зашифрован Тогда
		Возврат НСтр("ru = 'ошибка: файл зашифрован'");
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));
	Если Не РасширениеПоддерживаетсяПлатформой(Расширение)
		И Не РасширениеПоддерживаетсяСервисом(Расширение) Тогда
		Возврат НСтр("ru = 'ошибка: расширение файла не поддерживается'");
	КонецЕсли;

	Если Свойства.Размер > НастройкиИзвлечения.ПределРазмера Тогда
		Возврат НСтр("ru = 'ошибка: размер файла превышает предел'");
	КонецЕсли;

	// Маршрут agentrunner-100: офисные форматы - сначала платформа; для тех
	// из них, что поддержаны сервисами (xls, xlsx, docx), при пустом тексте -
	// сервисы; doc - только платформа.
	Если РасширениеПоддерживаетсяПлатформой(Расширение) Тогда
		Если РасширениеПоддерживаетсяСервисом(Расширение) Тогда
			Возврат НСтр("ru = 'извлечь текст платформой, при пустом тексте - сервисами, и записать в справочник'");
		КонецЕсли;
		Возврат НСтр("ru = 'извлечь текст платформой и записать в справочник'");
	КонецЕсли;

	Возврат НСтр("ru = 'распознать через RAGU, при его недоступности через S.Docster, и записать в справочник'");

КонецФункции

// Текст файла вне кэша - маршрут agentrunner-100 п.2: офисные форматы
// (doc, xls, xlsx, docx) извлекаются платформой; при пустом тексте платформы
// расширения, поддержанные сервисами (xls, xlsx, docx), распознаются
// сервисами (RAGU первым, при его неудаче запасной S.Docster - спека
// agentrunner-73 п.2); doc сервисами не распознается - пустой текст
// платформы остается пустым результатом. Прочие расширения - сразу сервисами.
// service и fallback_reason результата заполняются здесь же.
//
// Параметры:
//  ДвоичныеДанные      - ДвоичныеДанные - содержимое файла.
//  Свойства            - Структура   - свойства файла (Наименование, Размер).
//  Расширение          - Строка      - расширение в нижнем регистре, без точки.
//  НастройкиИзвлечения - Структура   - {ТаймаутСДокстер, ОжиданиеRAGU, ...}.
//  RunId               - Строка      - идентификатор запуска для замера.
//  ФайлСсылка          - ЛюбаяСсылка - файл для привязки записей замера.
//  Результат           - Структура   - элемент ответа (service,
//                        fallback_reason - изменяются).
//
// Возвращаемое значение:
//  Структура - {Текст - Строка - текст вне кэша ("" при неудаче);
//               ТекстОшибки - Строка - ошибка сервисов либо "";
//               Источник - Строка - значение source ответа ("платформа"/
//               "распознавание", "" при неудаче)}.
//
Функция ТекстВнеКэша(Знач ДвоичныеДанные, Знач Свойства, Знач Расширение,
	Знач НастройкиИзвлечения, Знач RunId, Знач ФайлСсылка, Результат)

	Итог = Новый Структура("Текст, ТекстОшибки, Источник", "", "", "");

	Если РасширениеПоддерживаетсяПлатформой(Расширение) Тогда
		Итог.Текст = ИзвлечьТекстПлатформой(ДвоичныеДанные, Расширение);
		Результат.service = "platform";
		Итог.Источник = "платформа";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Итог.Текст)) И РасширениеПоддерживаетсяСервисом(Расширение) Тогда
		Если Итог.Источник <> "" Тогда
			// Платформа не дала текста - причина перехода к сервисам
			// (спека agentrunner-100 п.2).
			Результат.fallback_reason = НСтр("ru = 'платформа: пустой текст'");
		КонецЕсли;
		Распознавание = РаспознатьТекстСервисами(ДвоичныеДанные, Свойства, Расширение,
			НастройкиИзвлечения, RunId, ФайлСсылка);
		Если Не ПустаяСтрока(Распознавание.ТекстОшибки) Тогда
			// Оба сервиса не сработали (статус файла не меняется, спека п.А.13).
			Итог.ТекстОшибки = Распознавание.ТекстОшибки;
			Возврат Итог;
		КонецЕсли;
		Итог.Текст = Распознавание.Текст;
		Результат.service = Распознавание.Сервис;
		Если Не ПустаяСтрока(Распознавание.ПричинаОтказаRAGU) Тогда
			Если ПустаяСтрока(Результат.fallback_reason) Тогда
				// Сервисы без платформы (п.А.12): причина отказа RAGU - единственная
				// пара fallback_reason (спека agentrunner-73 п.4).
				Результат.fallback_reason = Распознавание.ПричинаОтказаRAGU;
			Иначе
				// После платформы - обе причины (спека agentrunner-100 п.2).
				Результат.fallback_reason = СтрШаблон(НСтр("ru = '%1; %2'"),
					Результат.fallback_reason, Распознавание.ПричинаОтказаRAGU);
			КонецЕсли;
		КонецЕсли;
		Итог.Источник = "распознавание";
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Извлечение текста одного файла по порядку спеки п.А.12 (маршрут офисных
// форматов - платформа первой, agentrunner-100 п.2; распознавание - RAGU
// первым, при его неудаче S.Docster - спека agentrunner-73 п.2).
// Исключения перехватываются - наружу выходит только error в элементе ответа.
//
// Параметры:
//  ФайлСсылка          - ЛюбаяСсылка - ссылка на присоединённый файл.
//  Свойства            - Структура   - свойства файла из выборки запроса.
//  НастройкиИзвлечения - Структура   - {ПределРазмера, ПределДлиныТекста,
//                        ТаймаутСДокстер, ОжиданиеRAGU, БюджетВызоваСек}.
//  RunId               - Строка      - идентификатор запуска для замера.
//
// Возвращаемое значение:
//  Структура - {ref, name, source, service, fallback_reason, text,
//  text_length, truncated, saved, error}.
//
Функция ИзвлечьТекстФайла(Знач ФайлСсылка, Знач Свойства, Знач НастройкиИзвлечения, Знач RunId)

	Результат = НовыйЭлементРезультата(ФайлСсылка, Свойства.Наименование);

	// 1. Кэш: статус "Извлечен" и непустая строка в ТекстХранилище - ничего
	// не пишем (текст уже хранится в справочнике).
	Если Свойства.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		ТекстКэша = ТекстИзХранилища(Свойства.ТекстХранилище);
		Если Не ПустаяСтрока(ТекстКэша) Тогда
			Возврат ДополнитьРезультатТекстом(Результат, ТекстКэша, "кэш",
				НастройкиИзвлечения.ПределДлиныТекста, Истина, "");
		КонецЕсли;
	КонецЕсли;

	// 2. Отказы без обращения к сервису (зашифрован, размер, расширение).
	ТекстОтказа = ТекстОтказаБезОбращенияКСервису(Свойства, НастройкиИзвлечения);
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Возврат ДополнитьРезультатОшибкой(Результат, ТекстОтказа);
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));

	// 3. Двоичные данные файла.
	ДвоичныеДанные = Неопределено;
	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка, Ложь);
	Исключение
		ДвоичныеДанные = Неопределено;
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ДополнитьРезультатОшибкой(Результат,
			НСтр("ru = 'Данные файла не найдены'"));
	КонецЕсли;

	// 4-5. Извлечение вне кэша (agentrunner-100): офисные форматы - сначала
	// платформой, при пустом тексте - сервисами; прочие - сразу сервисами.
	ИзвлечениеВнеКэша = ТекстВнеКэша(ДвоичныеДанные, Свойства, Расширение,
		НастройкиИзвлечения, RunId, ФайлСсылка, Результат);
	Если Не ПустаяСтрока(ИзвлечениеВнеКэша.ТекстОшибки) Тогда
		Возврат ДополнитьРезультатОшибкой(Результат, ИзвлечениеВнеКэша.ТекстОшибки);
	КонецЕсли;
	Текст = ИзвлечениеВнеКэша.Текст;
	Источник = ИзвлечениеВнеКэша.Источник;

	// 6. Пустой текст - ошибка, в справочник не писать (в том числе doc после
	// платформы без текста).
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат ДополнитьРезультатОшибкой(Результат,
			НСтр("ru = 'Текст не извлечён'"));
	КонецЕсли;

	// 7. Запись кэша в справочник файлов; занятый файл - текст вернуть,
	// запись пропустить.
	Если ЗначениеЗаполнено(Свойства.Редактирует) Тогда
		Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
			НастройкиИзвлечения.ПределДлиныТекста, Ложь,
			НСтр("ru = 'Файл занят для редактирования, текст не сохранён'"));
	КонецЕсли;

	ТекстОшибкиЗаписи = "";
	Если ЗаписатьТекстФайла(ФайлСсылка, Текст, ТекстОшибкиЗаписи) Тогда
		Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
			НастройкиИзвлечения.ПределДлиныТекста, Истина, "");
	КонецЕсли;

	// Ошибка записи не теряет текст в ответе (спека п.А.12).
	Возврат ДополнитьРезультатТекстом(Результат, Текст, Источник,
		НастройкиИзвлечения.ПределДлиныТекста, Ложь, ТекстОшибкиЗаписи);

КонецФункции

// Отказы шага 2 спеки п.А.12 без обращения к сервису распознавания: файл
// зашифрован; размер больше предела; расширение не поддерживается (поддержка
// - платформой ИЛИ сервисом, agentrunner-100; платформенные расширения
// сервисом не проверяются - они идут платформой).
//
// Параметры:
//  Свойства            - Структура - свойства файла.
//  НастройкиИзвлечения - Структура - {ПределРазмера, ПределДлиныТекста, ТаймаутСДокстер}.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" - отказов нет.
//
Функция ТекстОтказаБезОбращенияКСервису(Знач Свойства, Знач НастройкиИзвлечения)

	Если Свойства.Зашифрован Тогда
		Возврат НСтр("ru = 'Файл зашифрован, извлечение текста невозможно'");
	КонецЕсли;

	Расширение = НРег(СокрЛП(Свойства.Расширение));
	Если Не РасширениеПоддерживаетсяПлатформой(Расширение)
		И Не РасширениеПоддерживаетсяСервисом(Расширение) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Расширение ""%1"" не поддерживается'"), Расширение);
	КонецЕсли;

	Если Свойства.Размер > НастройкиИзвлечения.ПределРазмера Тогда
		Возврат СтрШаблон(НСтр("ru = 'Размер файла %1 байт превышает предел %2 байт'"),
			Формат(Свойства.Размер, "ЧГ=0"), Формат(НастройкиИзвлечения.ПределРазмера, "ЧГ=0"));
	КонецЕсли;

	Возврат "";

КонецФункции

// Извлечение текста платформенным обработчиком через БСП (agentrunner-100:
// расширение - параметр; раньше только doc): временный файл с расширением
// файла (ИзвлечениеТекста определяет формат по расширению; для docx/xlsx
// нужен установленный iFilter в ОС сервера), после - удаление временного
// файла в Попытка (спека п.А.12.4, фактура 6.9). Не
// РаботаСФайламиСлужебный.ИзвлечьТекст: она зависит от константы
// ИзвлекатьТекстыФайловНаСервере и при включённой константе ничего не извлекает.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла (расширение отобрано вызывающим кодом).
//  Расширение     - Строка          - расширение файла (нижний регистр, без точки);
//                   входит в РасширенияПлатформы().
//
// Возвращаемое значение:
//  Строка - извлеченный текст либо "" (пустой текст обработает вызывающий код;
//  ИзвлечьТекстИзФайлаНаДиске возвращает статус «Извлечен» и с пустой строкой -
//  проверяется непустота, а не только статус, спека agentrunner-100 п.4).
//
Функция ИзвлечьТекстПлатформой(Знач ДвоичныеДанные, Знач Расширение)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	РезультатИзвлечения = Неопределено;
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		РезультатИзвлечения = РаботаСФайламиСлужебный.ИзвлечьТекстИзФайлаНаДиске(ИмяВременногоФайла);
	Исключение
		РезультатИзвлечения = Неопределено;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Неудачное удаление не ошибка: временный файл удалит платформа.
	КонецПопытки;

	Если РезультатИзвлечения = Неопределено
		Или РезультатИзвлечения.СтатусИзвлеченияТекста
			<> Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстИзХранилища(РезультатИзвлечения.ТекстХранилище);

КонецФункции

// Записывает извлечённый текст в кэш справочника файлов - повторение схемы
// РаботаСФайламиСлужебный.ЗаписатьРезультатИзвлеченияТекста (готовую строку ей
// передать нельзя): БлокировкаДанных по ссылке, транзакция,
// ЗаблокироватьДанныеДляРедактирования, ОбновлениеИнформационнойБазы.ЗаписатьДанные
// (режим загрузки: подписки, в том числе выгрузка в MinIO, не срабатывают).
// Запись - в привилегированном режиме: меняются только два служебных реквизита,
// право чтения проверено по владельцу (решение человека 2026-10-01, спека п.А.12.7).
//
// Параметры:
//  ФайлСсылка  - ЛюбаяСсылка - файл, в который пишется текст.
//  Текст       - Строка      - полный текст (без усечения).
//  ТекстОшибки - Строка      - очищенный текст ошибки при неудаче (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если текст записан.
//
Функция ЗаписатьТекстФайла(Знач ФайлСсылка, Знач Текст, ТекстОшибки)

	Записано = Ложь;
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(ФайлСсылка.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НачатьТранзакцию();
		Попытка
			БлокировкаДанных.Заблокировать();
			ЗаблокироватьДанныеДляРедактирования(ФайлСсылка);
			ОбъектФайла = ФайлСсылка.ПолучитьОбъект();
			ОбъектФайла.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен;
			ОбъектФайла.ТекстХранилище = Новый ХранилищеЗначения(Текст, Новый СжатиеДанных(9));
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ОбъектФайла);
			Записано = Истина;
			// ЗафиксироватьТранзакцию - последний оператор попытки: после него
			// откат уже невозможен.
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		// Блокировка не взята либо ошибка записи - текст в ответе сохраняется,
		// saved = false с причиной (спека п.А.12.7).
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Записано;

КонецФункции

// Читает настройки извлечения (кэш сеанса ar_Настройки; изменённое значение
// подхватывается с нового сеанса/запуска - спека п.А.14; настройки RAGU и
// бюджет - спека agentrunner-73 п.1, п.5).
//
// Возвращаемое значение:
//  Структура {ПределРазмера, ПределДлиныТекста, ТаймаутСДокстер, ОжиданиеRAGU,
//  БюджетВызоваСек} - Числа.
//
Функция НастройкиИзвлеченияТекста()

	Настройки = Новый Структура;
	Настройки.Вставить("ПределРазмера",
		ar_Настройки.ЗначениеНастройки("ПредельныйРазмерФайлаРаспознавания", 20000000));
	Настройки.Вставить("ПределДлиныТекста",
		ar_Настройки.ЗначениеНастройки("ПредельнаяДлинаТекстаФайла", 50000));
	Настройки.Вставить("ТаймаутСДокстер",
		ar_Настройки.ЗначениеНастройки("SDocsterТаймаут", 120));
	Настройки.Вставить("ОжиданиеRAGU", ОжиданиеRAGU());
	Настройки.Вставить("БюджетВызоваСек", БюджетВызоваТекстаФайлов());
	Возврат Настройки;

КонецФункции

// Ожидание ответа RAGU - параметр wait запроса, сек (спека agentrunner-73
// п.1): настройка RAGUОжидание, допустимый диапазон 0..300; не число либо
// вне диапазона - 60.
//
// Возвращаемое значение:
//  Число - сек ожидания.
//
Функция ОжиданиеRAGU()

	Значение = ar_Настройки.ЗначениеНастройки("RAGUОжидание", 60);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 60;
	КонецЕсли;
	Ожидание = Окр(Значение, 0);
	Возврат ?(Ожидание >= 0 И Ожидание <= 300, Ожидание, 60);

КонецФункции

// Общий бюджет одного вызова files_get_text, сек (спека agentrunner-73 п.5):
// настройка ПредельноеВремяВызоваТекстаФайлов, по умолчанию 600; не число -
// 600, отрицательное - 0 (бюджет исчерпан).
//
// Возвращаемое значение:
//  Число - сек бюджета.
//
Функция БюджетВызоваТекстаФайлов()

	Значение = ar_Настройки.ЗначениеНастройки("ПредельноеВремяВызоваТекстаФайлов", 600);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 600;
	КонецЕсли;
	Возврат Макс(Окр(Значение, 0), 0);

КонецФункции

// Новый элемент массива results ответа files_get_text. service - источник
// текста (platform/ragu/sdocster; пусто для кэша), fallback_reason - причина
// перехода к следующему источнику (спека agentrunner-73 п.4, agentrunner-100 п.2).
Функция НовыйЭлементРезультата(Знач ФайлСсылка, Знач Наименование)

	Элемент = Новый Структура;
	Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлСсылка));
	Элемент.Вставить("name", Наименование);
	Элемент.Вставить("source", "");
	Элемент.Вставить("service", "");
	Элемент.Вставить("fallback_reason", "");
	Элемент.Вставить("text", "");
	Элемент.Вставить("text_length", 0);
	Элемент.Вставить("truncated", Ложь);
	Элемент.Вставить("saved", Ложь);
	Элемент.Вставить("error", "");
	Возврат Элемент;

КонецФункции

// Элемент results для файла, который не удалось даже найти/разрешить.
Функция ЭлементРезультатаОшибки(Знач ФайлСсылка, Знач КодОшибки)

	Элемент = НовыйЭлементРезультата(ФайлСсылка, "");
	Элемент.error = КодОшибки;
	Возврат Элемент;

КонецФункции

// Заполняет текстовую часть результата: усечение до предела с признаком
// truncated (в справочник пишется полный текст, поэтому усечение - только
// здесь, на границе ответа).
Функция ДополнитьРезультатТекстом(Знач Результат, Знач Текст, Знач Источник,
	Знач ПределДлиныТекста, Знач Сохранён, Знач ТекстОшибки)

	Результат.source = Источник;
	Результат.saved = Сохранён;
	Результат.error = ТекстОшибки;

	Если СтрДлина(Текст) > ПределДлиныТекста Тогда
		Результат.text = Лев(Текст, ПределДлиныТекста);
		Результат.truncated = Истина;
	Иначе
		Результат.text = Текст;
		Результат.truncated = Ложь;
	КонецЕсли;
	Результат.text_length = СтрДлина(Результат.text);

	Возврат Результат;

КонецФункции

// Заполняет результат ошибкой (текст отсутствует).
Функция ДополнитьРезультатОшибкой(Знач Результат, Знач ТекстОшибки)

	Результат.error = ТекстОшибки;
	Возврат Результат;

КонецФункции

// Достаёт строку из ХранилищеЗначения (формат БСП: в хранилище лежит строка).
Функция ТекстИзХранилища(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;

	Текст = Хранилище.Получить();
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Идентификатор запуска из контекста инструмента для замера распознавания
// (спека agentrunner-73 п.6): Контекст может быть Неопределено (исполнение
// подтверждённого действия) - тогда "".
//
// Параметры:
//  Контекст - Структура - контекст запуска (RunId, Sequence, ...).
//
// Возвращаемое значение:
//  Строка - RunId либо "".
//
Функция RunIdИзКонтекста(Знач Контекст)

	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	RunId = "";
	Контекст.Свойство("RunId", RunId);
	Возврат ?(ТипЗнч(RunId) = Тип("Строка"), RunId, "");

КонецФункции

#КонецОбласти

#Область ВладельцыИФайлы

// Разбирает аргумент owner (навигационная ссылка e1cib/...) в ссылку владельца.
//
// Возвращаемое значение:
//  ЛюбаяСсылка - владелец; Неопределено, если ссылка не разобрана.
//
Функция ВладелецИзАргументов(Знач Аргументы)

	Возврат ar_Утилиты.ОбъектИзНавигационнойСсылки(ЗначениеИзКоллекции(Аргументы, "owner", ""));

КонецФункции

// Видит ли пользователь сеанса владельца файлов (спека п.А.10): запрос
// РАЗРЕШЕННЫЕ - при ограничениях доступа на уровне записей объект, скрытый
// от пользователя, вернёт пустой результат. Несуществующий объект тоже.
Функция ВладелецВиденПользователю(Знач Владелец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Владелец);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	" + Владелец.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Свойства всех файлов владельца (кроме помеченных на удаление) ОДНИМ запросом
// (объединение по справочникам файлов владельца, спека п.А.10; без ДанныеФайла
// в цикле - там ПолучитьОбъект на каждый файл). Запрос без РАЗРЕШЕННЫЕ:
// невидимые пользователю файлы в список не попадают.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Ссылка, Наименование, Расширение, Размер,
//  ДатаСоздания, ДатаМодификации, Автор, Описание, СтатусИзвлеченияТекста,
//  ТекстХранилище, ПодписанЭП, Зашифрован, Редактирует, ВладелецФайла};
//  упорядочены по Наименование.
//
Функция СвойстваФайловВладельца(Знач Владелец)

	Секции = Новый Массив;
	ИменаСправочников = РаботаСФайламиСлужебный.ИменаСправочниковХраненияФайлов(Владелец, Истина);
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Секции.Добавить(ТекстСекцииСвойствФайла("Справочник." + ИмяСправочника.Ключ,
			"Ф.ВладелецФайла = &Владелец И НЕ Ф.ПометкаУдаления"));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.Текст = ТекстЗапросаСвойствФайлов(Секции);

	Возврат СвойстваИзВыборки(Запрос.Выполнить().Выбрать());

КонецФункции

// Свойства файлов по явному массиву ссылок одним запросом (группировка по
// таблицам: у файла и таблицы однозначное соответствие).
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> структура свойств (см. СвойстваФайловВладельца).
//
Функция СвойстваФайловПоСсылкам(Знач СсылкиФайлов)

	// Уникальные ссылки (агент мог передать одну ссылку дважды), группировка
	// по таблицам.
	ГруппыПоТаблицам = Новый Соответствие;
	Уникальные = Новый Соответствие;
	Для Каждого ФайлСсылка Из СсылкиФайлов Цикл
		Если Уникальные.Получить(ФайлСсылка) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(ФайлСсылка, Истина);

		ИмяТаблицы = ФайлСсылка.Метаданные().ПолноеИмя();
		Группа = ГруппыПоТаблицам.Получить(ИмяТаблицы);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ГруппыПоТаблицам.Вставить(ИмяТаблицы, Группа);
		КонецЕсли;
		Группа.Добавить(ФайлСсылка);
	КонецЦикла;

	Секции = Новый Массив;
	ИндексСекции = 0;
	Запрос = Новый Запрос;
	Для Каждого Группа Из ГруппыПоТаблицам Цикл
		ИмяПараметра = "Файлы" + Формат(ИндексСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра, Группа.Значение);
		Секции.Добавить(ТекстСекцииСвойствФайла(Группа.Ключ,
			"Ф.Ссылка В (&" + ИмяПараметра + ")"));
		ИндексСекции = ИндексСекции + 1;
	КонецЦикла;

	Запрос.Текст = ТекстЗапросаСвойствФайлов(Секции);

	Возврат СвойстваИзВыборки(Запрос.Выполнить().Выбрать());

КонецФункции

// Владельцы переданных файлов, видимые пользователю сеанса, одним запросом
// РАЗРЕШЕННЫЕ (доступ проверяется по владельцу файла - спека п.А.12).
//
// Параметры:
//  СвойстваФайлов - Соответствие - Ссылка -> структура свойств (владелец -
//                   во ВладелецФайла).
//
// Возвращаемое значение:
//  Соответствие - ссылка владельца -> Истина для видимых владельцев.
//
Функция ВидимыеВладельцыФайлов(Знач СвойстваФайлов)

	Видимые = Новый Соответствие;

	ВладельцыПоТаблицам = Новый Соответствие;
	Для Каждого Элемент Из СвойстваФайлов Цикл
		Владелец = Элемент.Значение.ВладелецФайла;
		Если Не ЗначениеЗаполнено(Владелец) Или Видимые.Получить(Владелец) = Истина Тогда
			Продолжить;
		КонецЕсли;
		ИмяТаблицы = Владелец.Метаданные().ПолноеИмя();
		Группа = ВладельцыПоТаблицам.Получить(ИмяТаблицы);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ВладельцыПоТаблицам.Вставить(ИмяТаблицы, Группа);
		КонецЕсли;
		Группа.Добавить(Владелец);
	КонецЦикла;

	Секции = Новый Массив;
	ИндексСекции = 0;
	Запрос = Новый Запрос;
	Для Каждого Группа Из ВладельцыПоТаблицам Цикл
		ИмяПараметра = "Владельцы" + Формат(ИндексСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра, Группа.Значение);
		Секции.Добавить(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Т.Ссылка КАК Ссылка
			|ИЗ
			|	" + Группа.Ключ + " КАК Т
			|ГДЕ
			|	Т.Ссылка В (&" + ИмяПараметра + ")");
		ИндексСекции = ИндексСекции + 1;
	КонецЦикла;

	Если Секции.Количество() = 0 Тогда
		Возврат Видимые;
	КонецЕсли;

	Запрос.Текст = ТекстЗапросаОбъединения(Секции);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Видимые.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

	Возврат Видимые;

КонецФункции

// Секция объединённого запроса свойств файлов: одинаковый состав полей для
// всех справочников файлов БСП (спека п.А.10, P3).
Функция ТекстСекцииСвойствФайла(Знач ИмяТаблицы, Знач УсловиеОтбора)

	Возврат "ВЫБРАТЬ
		|	Ф.Ссылка КАК Ссылка,
		|	Ф.Наименование КАК Наименование,
		|	Ф.Расширение КАК Расширение,
		|	Ф.Размер КАК Размер,
		|	Ф.ДатаСоздания КАК ДатаСоздания,
		|	Ф.ДатаМодификацииУниверсальная КАК ДатаМодификации,
		|	Ф.Автор КАК Автор,
		|	Ф.Описание КАК Описание,
		|	Ф.СтатусИзвлеченияТекста КАК СтатусИзвлеченияТекста,
		|	Ф.ТекстХранилище КАК ТекстХранилище,
		|	Ф.ПодписанЭП КАК ПодписанЭП,
		|	Ф.Зашифрован КАК Зашифрован,
		|	Ф.Редактирует КАК Редактирует,
		|	Ф.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	" + ИмяТаблицы + " КАК Ф
		|ГДЕ
		|	" + УсловиеОтбора;

КонецФункции

// Текст объединённого запроса свойств из секций + упорядочивание по имени файла.
//
// Параметры:
//  Секции - Массив из Строка - тексты секций объединения (непустой; пустому
//           множеству файлов соответствует пустой ответ, а не запрос).
//
// Возвращаемое значение:
//  Строка - полный текст запроса.
//
Функция ТекстЗапросаСвойствФайлов(Знач Секции)

	Возврат ТекстЗапросаОбъединения(Секции)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Наименование";

КонецФункции

// Соединяет секции запроса через ОБЪЕДИНИТЬ ВСЕ (запросы свойств и проверки
// владельцев собираются динамически по таблицам - P1 query_dynamic_text_building).
//
// Параметры:
//  Секции - Массив из Строка - тексты секций запроса (непустой).
//
// Возвращаемое значение:
//  Строка - текст запроса-объединения.
//
Функция ТекстЗапросаОбъединения(Знач Секции)

	Разделитель = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
	Возврат СтрСоединить(Секции, Разделитель);

КонецФункции

// Свойства файлов из выборки объединённого запроса -> Соответствие Ссылка ->
// Структура свойств.
Функция СвойстваИзВыборки(Знач Выборка)

	Свойства = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СтрокаСвойств = Новый Структура;
		СтрокаСвойств.Вставить("Ссылка", Выборка.Ссылка);
		СтрокаСвойств.Вставить("Наименование", Выборка.Наименование);
		СтрокаСвойств.Вставить("Расширение", Выборка.Расширение);
		СтрокаСвойств.Вставить("Размер", Выборка.Размер);
		СтрокаСвойств.Вставить("ДатаСоздания", Выборка.ДатаСоздания);
		СтрокаСвойств.Вставить("ДатаМодификации", Выборка.ДатаМодификации);
		СтрокаСвойств.Вставить("Автор", Выборка.Автор);
		СтрокаСвойств.Вставить("Описание", Выборка.Описание);
		СтрокаСвойств.Вставить("СтатусИзвлеченияТекста", Выборка.СтатусИзвлеченияТекста);
		СтрокаСвойств.Вставить("ТекстХранилище", Выборка.ТекстХранилище);
		СтрокаСвойств.Вставить("ПодписанЭП", Выборка.ПодписанЭП);
		СтрокаСвойств.Вставить("Зашифрован", Выборка.Зашифрован);
		СтрокаСвойств.Вставить("Редактирует", Выборка.Редактирует);
		СтрокаСвойств.Вставить("ВладелецФайла", Выборка.ВладелецФайла);
		Свойства.Вставить(Выборка.Ссылка, СтрокаСвойств);
	КонецЦикла;

	Возврат Свойства;

КонецФункции

#КонецОбласти

#Область РаспознаваниеТекста

// Распознавание текста файла двумя сервисами: RAGU первым, при его неудаче -
// запасной S.Docster (спека agentrunner-73 п.2). Кто сработал и почему
// перешли к запасному - в полях результата (service, fallback_reason ответа).
//
// Параметры:
//  ДвоичныеДанные      - ДвоичныеДанные - содержимое файла.
//  Свойства            - Структура   - свойства файла (Наименование, Размер).
//  Расширение          - Строка      - расширение в нижнем регистре, без точки.
//  НастройкиИзвлечения - Структура   - {ОжиданиеRAGU, ТаймаутСДокстер, ...}.
//  RunId               - Строка      - идентификатор запуска для замера.
//  ФайлСсылка          - ЛюбаяСсылка - файл для привязки записей замера.
//
// Возвращаемое значение:
//  Структура - {Текст - Строка - распознанный текст ("" при неудаче);
//               ТекстОшибки - Строка - ошибка файла (оба сервиса не сработали)
//               или "" при успехе;
//               Сервис - Строка - "ragu"/"sdocster" ("" при неудаче обоих);
//               ПричинаОтказаRAGU - Строка - причина неудачи RAGU для
//               fallback_reason ("" при успехе RAGU)}.
//
Функция РаспознатьТекстСервисами(Знач ДвоичныеДанные, Знач Свойства, Знач Расширение,
	Знач НастройкиИзвлечения, Знач RunId, Знач ФайлСсылка)

	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сервис", "");
	Результат.Вставить("ПричинаОтказаRAGU", "");

	ПричинаОтказаRAGU = "";
	ТекстRAGU = РаспознатьТекстRAGU(ДвоичныеДанные, Свойства.Наименование, Расширение,
		Свойства.Размер, НастройкиИзвлечения.ОжиданиеRAGU, RunId, ФайлСсылка, ПричинаОтказаRAGU);
	Если ПустаяСтрока(ПричинаОтказаRAGU) Тогда
		Результат.Текст = ТекстRAGU;
		Результат.Сервис = "ragu";
		Возврат Результат;
	КонецЕсли;

	// RAGU не сработал - запасной S.Docster (спека п.2).
	Результат.ПричинаОтказаRAGU = ПричинаОтказаRAGU;
	ТекстОшибкиСДокстер = "";
	Текст = РаспознатьТекстSDocster(ДвоичныеДанные, Свойства.Наименование, Расширение,
		НастройкиИзвлечения.ТаймаутСДокстер, Свойства.Размер, RunId, ФайлСсылка,
		ТекстОшибкиСДокстер);
	Если Не ПустаяСтрока(ТекстОшибкиСДокстер) Тогда
		// Оба сервиса не сработали: error из S.Docster + причина RAGU одной
		// строкой (спека agentrunner-73 п.4).
		Результат.ТекстОшибки = ТекстОшибкиСДокстер + "; " + ПричинаОтказаRAGU;
		Возврат Результат;
	КонецЕсли;

	Результат.Текст = Текст;
	Результат.Сервис = "sdocster";
	Возврат Результат;

КонецФункции

// Распознавание файла сервисом RAGU (спека agentrunner-73 п.2, п.3): POST
// <базовый адрес>/api/v1/parse/text?wait=<Ожидание>, авторизация Bearer, тело
// multipart/form-data с полем file. Ответ 200 - в теле текст (не JSON); 202 -
// сервис не успел, в теле id задания (асинхронный режим - задача
// agentrunner-74, здесь это неудача с переходом к запасному сервису, id - в
// замер); прочие коды - ошибка, текст из поля error тела ответа.
//
// Свой HTTPСоединение (таймаут Ожидание + 30 сек): ar_HTTP.ВыполнитьPOST
// принимает тело только строкой и пропускает только адреса из списка
// разрешённых LLM-адресов (фактура, вывод 4 задачи agentrunner-21).
//
// Каждое обращение - запись ocr_request в служебный лог (спека п.6); при
// неудаче (результат <> "ok") в запись добавляется fallback=sdocster - после
// RAGU вызывается запасной сервис. Токен в лог не попадает (тексты ошибок
// маскируются).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Наименование   - Строка - имя файла (без расширения) для filename.
//  Расширение     - Строка - расширение файла (в нижнем регистре, без точки).
//  Размер         - Число  - размер файла для замера, байт.
//  Ожидание       - Число  - параметр wait, сек (ОжиданиеRAGU).
//  RunId          - Строка - идентификатор запуска для замера.
//  ФайлСсылка     - ЛюбаяСсылка - файл для привязки записи замера.
//  ПричинаОтказа  - Строка (выходной) - очищенная краткая причина неудачи
//                 (fallback_reason и часть ошибки файла); "" при успехе.
//
// Возвращаемое значение:
//  Строка - распознанный текст; "" при неудаче (статус файла не меняется).
//
Функция РаспознатьТекстRAGU(Знач ДвоичныеДанные, Знач Наименование, Знач Расширение, Знач Размер,
	Знач Ожидание, Знач RunId, Знач ФайлСсылка, ПричинаОтказа)

	ПричинаОтказа = "";

	// Незаполненный или выключенный адрес/токен - неудача без обращения в
	// сеть, распознавание продолжается запасным сервисом (спека п.2).
	АдресСервиса = СокрЛП(ar_Настройки.ЗначениеНастройки("RAGUАдресСервиса", ""));
	Если ПустаяСтрока(АдресСервиса) Тогда
		ПричинаОтказа = НСтр("ru = 'RAGU не настроен: заполните и включите настройку RAGUАдресСервиса'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.Результат = "not_configured";
		Замер.ПереходНаЗапасной = Истина;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	Токен = СокрЛП(ar_Настройки.ЗначениеНастройки("RAGUТокен", ""));
	Если ПустаяСтрока(Токен) Тогда
		ПричинаОтказа = НСтр("ru = 'RAGU не настроен: заполните и включите настройку RAGUТокен'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.Результат = "not_configured";
		Замер.ПереходНаЗапасной = Истина;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса);
	Хост = СтруктураАдреса.Хост;
	Если ПустаяСтрока(Хост) Тогда
		ПричинаОтказа = НСтр("ru = 'RAGU: настройка RAGUАдресСервиса заполнена неверно: не найдено имя сервера'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.Результат = "error";
		Замер.ПереходНаЗапасной = Истина;
		Замер.ТекстОшибки = ПричинаОтказа;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;
	ТребуетсяЗащищенноеСоединение = НРег(СтруктураАдреса.Схема) = "https";

	// Путь /api/v1/parse/text добавляет код к базовому адресу (спека п.1).
	АдресРесурса = ПутьБазовогоАдреса(СтруктураАдреса.ПутьНаСервере)
		+ "api/v1/parse/text?wait=" + Формат(Ожидание, "ЧГ=0");

	Граница = СтрЗаменить(ar_Утилиты.НовыйUUID(), "-", "");
	ТелоЗапроса = ТелоСоставногоЗапросаФайла(ДвоичныеДанные, Наименование, Расширение, Граница);

	ЗащищенноеСоединение = Неопределено;
	Если ТребуетсяЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	Порт = СтруктураАдреса.Порт;
	Соединение = Новый HTTPСоединение(Хост, ?(ЗначениеЗаполнено(Порт), Порт, Неопределено), , , ,
		Ожидание + 30, ЗащищенноеСоединение);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КодОтвета = 0;
	ТекстОтвета = "";
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		КодОтвета = Ответ.КодСостояния;
		// Тело ответа 200 - текст, не JSON: кодировка явно UTF-8 (спека п.3).
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		ПричинаОтказа = ar_Утилиты.ОчиститьОшибкуДляLLM(
			НСтр("ru = 'RAGU: ошибка соединения: '")
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.КодОтвета = 0;
		Замер.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
		Замер.Ожидание = Ожидание;
		Замер.ТекстОшибки = ПричинаОтказа;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецПопытки;

	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;

	Если КодОтвета = 200 Тогда
		// Пустой текст - неудача RAGU: ответ 200 без текста (спека п.2).
		Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
			ПричинаОтказа = НСтр("ru = 'RAGU вернул пустой текст'");
			Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
			Замер.КодОтвета = КодОтвета;
			Замер.ДлительностьМс = ДлительностьМс;
			Замер.Ожидание = Ожидание;
			Замер.Результат = "empty";
			Замер.ПереходНаЗапасной = Истина;
			Замер.ТекстОшибки = ПричинаОтказа;
			ЗаписатьЗамерРаспознавания(Замер);
			Возврат "";
		КонецЕсли;
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.КодОтвета = КодОтвета;
		Замер.ДлительностьМс = ДлительностьМс;
		Замер.Ожидание = Ожидание;
		Замер.Результат = "ok";
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат ТекстОтвета;
	КонецЕсли;

	Если КодОтвета = 202 Тогда
		// Не успел: обрабатывать задание будет подсистема предварительного
		// распознавания (agentrunner-74), здесь - переход к запасному сервису.
		ИдЗадания = ИдЗаданияИзОтветаRAGU(ТекстОтвета);
		ПричинаОтказа = СтрШаблон(
			НСтр("ru = 'RAGU не успел обработать файл за %1 сек (код 202), задание: %2'"),
			Формат(Ожидание, "ЧГ=0"), ИдЗадания);
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
		Замер.КодОтвета = КодОтвета;
		Замер.ДлительностьМс = ДлительностьМс;
		Замер.Ожидание = Ожидание;
		Замер.ИдЗадания = ИдЗадания;
		Замер.ПереходНаЗапасной = Истина;
		Замер.ТекстОшибки = ПричинаОтказа;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	// Прочие коды - ошибка: текст из поля error тела (если есть) + код.
	ТекстОшибки = ОшибкаИзОтветаRAGU(ТекстОтвета);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ПричинаОтказа = СтрШаблон(НСтр("ru = 'RAGU вернул код состояния %1'"),
			Формат(КодОтвета, "ЧГ=0"));
	Иначе
		ПричинаОтказа = ar_Утилиты.ОчиститьОшибкуДляLLM(СтрШаблон(
			НСтр("ru = 'RAGU вернул код состояния %1: %2'"),
			Формат(КодОтвета, "ЧГ=0"), ТекстОшибки));
	КонецЕсли;
	Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "ragu", Наименование, Расширение, Размер);
	Замер.КодОтвета = КодОтвета;
	Замер.ДлительностьМс = ДлительностьМс;
	Замер.Ожидание = Ожидание;
	Замер.ПереходНаЗапасной = Истина;
	Замер.ТекстОшибки = ПричинаОтказа;
	ЗаписатьЗамерРаспознавания(Замер);
	Возврат "";

КонецФункции

// Путь базового адреса RAGU с завершающим слешем: базовый адрес может не
// включать путь (https://сервер) или включать префикс (https://сервер/префикс)
// - путь /api/v1/parse/text добавляет код (спека agentrunner-73 п.1).
//
// Параметры:
//  ПутьИзАдреса - Строка - ПутьНаСервере из СтруктураURI базового адреса.
//
// Возвращаемое значение:
//  Строка - путь, начинающийся и заканчивающийся слешем ("" -> "/").
//
Функция ПутьБазовогоАдреса(Знач ПутьИзАдреса)

	Путь = СокрЛП(ПутьИзАдреса);
	Если ПустаяСтрока(Путь) Тогда
		Возврат "/";
	КонецЕсли;
	// СтруктураURI возвращает ПутьНаСервере без ведущего слеша (приёмка 73).
	Если Не СтрНачинаетсяС(Путь, "/") Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Путь, "/") Тогда
		Путь = Путь + "/";
	КонецЕсли;
	Возврат Путь;

КонецФункции

// id задания из тела ответа 202 RAGU: JSON вида {"id": "...", ...}; "" -
// если ответ не разобрался (id в замер не попадает).
//
// Параметры:
//  ТекстОтвета - Строка - тело ответа RAGU.
//
// Возвращаемое значение:
//  Строка - id задания либо "".
//
Функция ИдЗаданияИзОтветаRAGU(Знач ТекстОтвета)

	Разобрано = ar_JSON.ИзJSON(ТекстОтвета);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	ИдЗадания = Разобрано.Получить("id");
	Возврат ?(ТипЗнч(ИдЗадания) = Тип("Строка"), ИдЗадания, "");

КонецФункции

// Текст ошибки из тела ответа RAGU: JSON вида {"status":"error",
// "error":"<текст>"} (спека agentrunner-73 п.2); "" - если тело не разобралось
// или поле error не строка.
//
// Параметры:
//  ТекстОтвета - Строка - тело ответа RAGU.
//
// Возвращаемое значение:
//  Строка - текст ошибки либо "".
//
Функция ОшибкаИзОтветаRAGU(Знач ТекстОтвета)

	Разобрано = ar_JSON.ИзJSON(ТекстОтвета);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	ТекстОшибки = Разобрано.Получить("error");
	Если ТипЗнч(ТекстОшибки) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ТекстОшибки)) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(ТекстОшибки);

КонецФункции

// Распознавание файла запасным сервисом S.Docster (спека agentrunner-73 п.2;
// основной сервис - RAGU, РаспознатьТекстRAGU): POST multipart/form-data с
// полем file, ответ - JSON, текст в page_content (фактура 4.4 задачи
// agentrunner-21).
//
// Каждое обращение - запись ocr_request в служебный лог с RunId запуска и
// объектом = файл (спека agentrunner-73 п.6; прежнее событие sdocster_request
// заменено на ocr_request с service=sdocster). Ключ и токен в лог не попадают.
//
// Параметры:
//  ДвоичныеДанные  - ДвоичныеДанные - содержимое файла.
//  Наименование    - Строка - имя файла (без расширения) для filename.
//  Расширение      - Строка - расширение файла (в нижнем регистре, без точки).
//  Таймаут         - Число  - секунды ожидания ответа (настройка SDocsterТаймаут).
//  Размер          - Число  - размер файла для замера, байт.
//  RunId           - Строка - идентификатор запуска для замера.
//  ФайлСсылка      - ЛюбаяСсылка - файл для привязки записи замера.
//  ТекстОшибки     - Строка - очищенный текст ошибки (выходной, "" при успехе).
//  ПричинаФолбэка  - Строка - причина перехода к S.Docster для замера
//                    (пара fallback, agentrunner-100; "" - синхронная цепочка,
//                    причина видна в замере RAGU).
//
// Возвращаемое значение:
//  Строка - распознанный текст; "" при ошибке (статус файла не меняется).
//
Функция РаспознатьТекстSDocster(Знач ДвоичныеДанные, Знач Наименование, Знач Расширение,
	Знач Таймаут, Знач Размер, Знач RunId, Знач ФайлСсылка, ТекстОшибки, Знач ПричинаФолбэка = "")

	ТекстОшибки = "";

	// Незаполненный или выключенный SDocsterАдрес - "сервис не настроен" без
	// обращения в сеть (спека п.А.13).
	АдресСервиса = СокрЛП(ar_Настройки.ЗначениеНастройки("SDocsterАдресСервиса", ""));
	Если ПустаяСтрока(АдресСервиса) Тогда
		ТекстОшибки = НСтр("ru = 'Сервис распознавания не настроен: заполните и включите настройку SDocsterАдресСервиса'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.Результат = "not_configured";
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса);
	Хост = СтруктураАдреса.Хост;
	Порт = СтруктураАдреса.Порт;
	АдресРесурса = СтруктураАдреса.ПутьНаСервере;
	Если ПустаяСтрока(Хост) Тогда
		ТекстОшибки = НСтр("ru = 'Настройка SDocsterАдресСервиса заполнена неверно: не найдено имя сервера'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.Результат = "error";
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		Замер.ТекстОшибки = ТекстОшибки;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;
	ТребуетсяЗащищенноеСоединение = НРег(СтруктураАдреса.Схема) = "https";
	КлючДоступа = СокрЛП(ar_Настройки.ЗначениеНастройки("SDocsterКлюч", ""));

	// Тело multipart-запроса - общая сборка для обоих сервисов распознавания
	// (спека agentrunner-73 п.3).
	Граница = СтрЗаменить(ar_Утилиты.НовыйUUID(), "-", "");
	ТелоЗапроса = ТелоСоставногоЗапросаФайла(ДвоичныеДанные, Наименование, Расширение, Граница);

	ЗащищенноеСоединение = Неопределено;
	Если ТребуетсяЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	Соединение = Новый HTTPСоединение(Хост, ?(ЗначениеЗаполнено(Порт), Порт, Неопределено), , , ,
		Таймаут, ЗащищенноеСоединение);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Если Не ПустаяСтрока(КлючДоступа) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + КлючДоступа);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КодОтвета = 0;
	ТекстОтвета = "";
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		КодОтвета = Ответ.КодСостояния;
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		// Исключение соединения - ошибка с очищенным текстом, статус файла
		// не меняется (спека п.А.13).
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		Замер.ТекстОшибки = ТекстОшибки;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецПопытки;

	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;

	Если КодОтвета <> 200 Тогда
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(СтрШаблон(
			НСтр("ru = 'Сервис распознавания вернул код состояния %1'"), Формат(КодОтвета, "ЧГ=0")));
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.КодОтвета = КодОтвета;
		Замер.ДлительностьМс = ДлительностьМс;
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		Замер.ТекстОшибки = ТекстОшибки;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(ТекстОтвета);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		ТекстОшибки = НСтр("ru = 'Сервис распознавания вернул не JSON-ответ'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.КодОтвета = КодОтвета;
		Замер.ДлительностьМс = ДлительностьМс;
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		Замер.ТекстОшибки = ТекстОшибки;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	ТекстСтраницы = Разобрано.Получить("page_content");
	Если ТипЗнч(ТекстСтраницы) <> Тип("Строка") Тогда
		ТекстОшибки = НСтр("ru = 'В ответе сервиса нет текста (page_content)'");
		Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
		Замер.КодОтвета = КодОтвета;
		Замер.ДлительностьМс = ДлительностьМс;
		Замер.ПричинаФолбэка = ПричинаФолбэка;
		Замер.ТекстОшибки = ТекстОшибки;
		ЗаписатьЗамерРаспознавания(Замер);
		Возврат "";
	КонецЕсли;

	// Пустой текст - ошибка "текст не извлечён" на шаге 6 спеки (здесь не
	// дублируется): возвращаем как есть, вызывающий код проверит.
	Замер = НовыйЗамерРаспознавания(RunId, ФайлСсылка, "sdocster", Наименование, Расширение, Размер);
	Замер.КодОтвета = КодОтвета;
	Замер.ДлительностьМс = ДлительностьМс;
	Замер.ПричинаФолбэка = ПричинаФолбэка;
	Замер.Результат = ?(ПустаяСтрока(СокрЛП(ТекстСтраницы)), "empty", "ok");
	ЗаписатьЗамерРаспознавания(Замер);
	Возврат ТекстСтраницы;

КонецФункции

// Собирает multipart/form-data тело запроса с одним полем file - общая для
// S.Docster и RAGU (спека agentrunner-73 п.3). Разделитель строк ВК+ПС
// (образец llmp, фактура 4.4 задачи agentrunner-21).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Наименование   - Строка - имя файла (без расширения) для filename.
//  Расширение     - Строка - расширение файла (в нижнем регистре, без точки).
//  Граница        - Строка - boundary без ведущих "--".
//
// Возвращаемое значение:
//  ДвоичныеДанные - собранное тело запроса.
//
Функция ТелоСоставногоЗапросаФайла(Знач ДвоичныеДанные, Знач Наименование, Знач Расширение, Знач Граница)

	ПотокВПамяти = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти, , , Символы.ВК + Символы.ПС, "");
	ЗаписьДанных.ЗаписатьСтроку("--" + Граница);
	ЗаписьДанных.ЗаписатьСтроку(
		"Content-Disposition: form-data; name=""file""; filename="""
		+ Наименование + "." + Расширение + """");
	ЗаписьДанных.ЗаписатьСтроку("Content-Type: " + ТипСодержимогоПоРасширению(Расширение));
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Записать(ДвоичныеДанные);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.ЗаписатьСтроку("--" + Граница + "--");
	ЗаписьДанных.Закрыть();

	Возврат ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// Поддерживается ли расширение сервисом распознавания (спека п.А.12.5;
// офисные форматы из РасширенияПлатформы сюда тоже попадают - они идут
// сначала платформой, при пустом тексте сервисами). Список - общий с отбором
// предварительного распознавания (РасширенияСервиса, спека agentrunner-74
// п.Б.5); регистр букв не важен - расширение приводится к нижнему регистру.
Функция РасширениеПоддерживаетсяСервисом(Знач Расширение)

	Возврат РасширенияСервиса().Найти(НРег(СокрЛП(Расширение))) <> Неопределено;

КонецФункции

// Поддерживается ли расширение платформенным извлечением (agentrunner-100
// п.2: doc, xls, xlsx, docx). Регистр букв не важен - расширение приводится
// к нижнему регистру.
Функция РасширениеПоддерживаетсяПлатформой(Знач Расширение)

	Возврат РасширенияПлатформы().Найти(НРег(СокрЛП(Расширение))) <> Неопределено;

КонецФункции

// Расширения офисных форматов, извлекаемые платформой (ИзвлечениеТекста через
// iFilter ОС сервера; agentrunner-100 п.2) - общий список для files_get_text
// (ИзвлечьТекстФайла, ДействиеПоФайлу) и такта очереди (ОтправитьОчередьRAGU).
// Для docx/xlsx нужен установленный iFilter (на стенде есть - факт задач
// 73/74); пустой текст платформы - нормальный случай, вызывающий код идет
// дальше (сервисы).
//
// Возвращаемое значение:
//  Массив из Строка - расширения в нижнем регистре, без точки.
//
Функция РасширенияПлатформы()

	Расширения = Новый Массив;
	Расширения.Добавить("doc");
	Расширения.Добавить("xls");
	Расширения.Добавить("xlsx");
	Расширения.Добавить("docx");
	Возврат Расширения;

КонецФункции

// Расширения файлов очереди предварительного распознавания - объединение
// РасширенияСервиса и РасширенияПлатформы (agentrunner-100 п.2): в отбор
// кандидатов попадают и офисные форматы, извлекаемые платформой.
//
// Возвращаемое значение:
//  Массив из Строка - расширения в нижнем регистре, без точки.
//
Функция РасширенияОчереди()

	Расширения = РасширенияСервиса();
	Для Каждого Расширение Из РасширенияПлатформы() Цикл
		Если Расширения.Найти(Расширение) = Неопределено Тогда
			Расширения.Добавить(Расширение);
		КонецЕсли;
	КонецЦикла;
	Возврат Расширения;

КонецФункции

// Расширения файлов, поддерживаемые сервисом распознавания - общий список
// для files_get_text (РасширениеПоддерживаетсяСервисом) и отбора
// предварительного распознавания (спека agentrunner-74 п.Б.5).
//
// Возвращаемое значение:
//  Массив из Строка - расширения в нижнем регистре, без точки.
//
Функция РасширенияСервиса()

	Расширения = Новый Массив;
	Расширения.Добавить("pdf");
	Расширения.Добавить("rtf");
	Расширения.Добавить("tif");
	Расширения.Добавить("tiff");
	Расширения.Добавить("jpg");
	Расширения.Добавить("jpeg");
	Расширения.Добавить("png");
	Расширения.Добавить("gif");
	Расширения.Добавить("bmp");
	Расширения.Добавить("xls");
	Расширения.Добавить("xlsx");
	Расширения.Добавить("docx");
	Расширения.Добавить("odt");
	Расширения.Добавить("ods");
	Расширения.Добавить("txt");
	Расширения.Добавить("xml");
	Расширения.Добавить("htm");
	Расширения.Добавить("html");
	Возврат Расширения;

КонецФункции

// Тип содержимого multipart-части по расширению файла (фактура 4.4).
Функция ТипСодержимогоПоРасширению(Знач Расширение)

	Если Расширение = "txt" Тогда
		Возврат "text/plain";
	ИначеЕсли Расширение = "xml" Тогда
		Возврат "application/xml";
	ИначеЕсли Расширение = "htm" Или Расширение = "html" Тогда
		Возврат "text/html";
	ИначеЕсли Расширение = "pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = "rtf" Тогда
		Возврат "application/rtf";
	ИначеЕсли Расширение = "tif" Или Расширение = "tiff" Тогда
		Возврат "image/tiff";
	ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "xls" Тогда
		Возврат "application/vnd.ms-excel";
	ИначеЕсли Расширение = "odt" Тогда
		Возврат "application/vnd.oasis.opendocument.text";
	ИначеЕсли Расширение = "ods" Тогда
		Возврат "application/vnd.oasis.opendocument.spreadsheet";
	ИначеЕсли Расширение = "docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	Иначе
		Возврат "application/octet-stream";
	КонецЕсли;

КонецФункции

// Новый замер обращения к сервису распознавания (спека agentrunner-73 п.6):
// обязательные поля заполняются здесь, остальные - вызывающим кодом.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска (из контекста инструмента).
//  ФайлСсылка - ЛюбаяСсылка - распознаваемый файл (Объект записи лога).
//  Сервис     - Строка - "ragu" или "sdocster".
//  Наименование - Строка - имя файла.
//  Расширение - Строка - расширение файла.
//  Размер     - Число - размер файла, байт.
//
// Возвращаемое значение:
//  Структура - {RunId, ФайлСсылка, Сервис, Наименование, Расширение, Размер,
//  КодОтвета (Число, 0), ДлительностьМс (Число, 0), Результат (Строка, "error"),
//  Ожидание (Число, 0), ИдЗадания (Строка, ""), ПереходНаЗапасной (Булево, Ложь),
//  ПричинаФолбэка (Строка, ""), ТекстОшибки (Строка, "")}.
//
Функция НовыйЗамерРаспознавания(Знач RunId, Знач ФайлСсылка, Знач Сервис, Знач Наименование, Знач Расширение,
	Знач Размер)

	Замер = Новый Структура;
	Замер.Вставить("RunId", RunId);
	Замер.Вставить("ФайлСсылка", ФайлСсылка);
	Замер.Вставить("Сервис", Сервис);
	Замер.Вставить("Наименование", Наименование);
	Замер.Вставить("Расширение", Расширение);
	Замер.Вставить("Размер", Размер);
	Замер.Вставить("КодОтвета", 0);
	Замер.Вставить("ДлительностьМс", 0);
	Замер.Вставить("Результат", "error");
	Замер.Вставить("Ожидание", 0);
	Замер.Вставить("ИдЗадания", "");
	Замер.Вставить("ПереходНаЗапасной", Ложь);
	Замер.Вставить("ПричинаФолбэка", "");
	Замер.Вставить("ТекстОшибки", "");
	Возврат Замер;

КонецФункции

// Запись замера обращения к сервису распознавания в служебный лог (спека
// agentrunner-73 п.6): событие ocr_request, объект - файл, RunId запуска;
// текст - пары ключ=значение через "; " (разбирается выгрузкой лога).
// Ошибка сервиса - уровень "Предупреждение", остальное - "Информация".
// Токен и ключ в лог не попадают: текст ошибки проходит МаскироватьСекреты.
//
// Параметры:
//  Замер - Структура - см. НовыйЗамерРаспознавания.
//
Процедура ЗаписатьЗамерРаспознавания(Знач Замер)

	Части = Новый Массив;
	Части.Добавить("service=" + Замер.Сервис);
	Части.Добавить("file=" + Замер.Наименование);
	Части.Добавить("ext=" + Замер.Расширение);
	// "ЧН=0" обязателен: Формат(0, "ЧГ=0") даёт пустую строку (code= при
	// ошибке соединения, подсказка brain 2026-10-12).
	Части.Добавить("size=" + Формат(Замер.Размер, "ЧН=0; ЧГ=0"));
	Части.Добавить("code=" + Формат(Замер.КодОтвета, "ЧН=0; ЧГ=0"));
	Части.Добавить("ms=" + Формат(Замер.ДлительностьМс, "ЧН=0; ЧГ=0"));
	// wait пишется у каждого обращения к RAGU, в т. ч. wait=0 (приёмка 73).
	Если Замер.Сервис = "ragu" И Замер.Результат <> "not_configured" Тогда
		Части.Добавить("wait=" + Формат(Замер.Ожидание, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Не ПустаяСтрока(Замер.ИдЗадания) Тогда
		Части.Добавить("job_id=" + Замер.ИдЗадания);
	КонецЕсли;
	Части.Добавить("result=" + Замер.Результат);
	Если Замер.ПереходНаЗапасной Тогда
		Части.Добавить("fallback=sdocster");
	КонецЕсли;
	Если Не ПустаяСтрока(Замер.ПричинаФолбэка) Тогда
		// agentrunner-100: причина отказа основного сервиса в замере
		// запасного (спека agentrunner-100 п.1).
		Части.Добавить("fallback=" + Замер.ПричинаФолбэка);
	КонецЕсли;
	Если Не ПустаяСтрока(Замер.ТекстОшибки) Тогда
		Части.Добавить("error=" + Замер.ТекстОшибки);
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_request",
		СтрСоединить(Части, "; "),
		?(Замер.Результат = "error" Или Замер.Результат = "empty", "Предупреждение", "Информация"),
		Замер.RunId, Замер.ФайлСсылка);

КонецПроцедуры

#КонецОбласти

#Область ПредварительноеРаспознавание

// Такт предварительного распознавания (спека agentrunner-74 п.Б.4-11;
// agentrunner-100: офисные форматы платформой до RAGU, S.Docster запасным
// на окончательных отказах RAGU): отбор свежих файлов владельцев агентов
// без непустого текста, постановка в очередь ar_ОчередьРаспознавания,
// извлечение платформой и отправка queued-строк в асинхронный RAGU, опрос
// processing-строк и запись готового текста в кэш справочника файлов,
// добор строк, ожидающих S.Docster, уборка закрытых строк. Выполняется
// командой "ar_ПредварительноеРаспознавание" по расписанию БСП.
//
// Включенность: заполнены и включены настройки RAGU - полный такт; RAGU не
// настроен, S.Docster настроен - платформа и S.Docster по queued-строкам
// (спека agentrunner-100 п.3); не настроено ничего - тихий выход без сети
// (спека agentrunner-74 п.Б.4).
//
// Счётчики такта (найдено/поставлено/отправлено/готово/ошибок/вызовов
// S.Docster) пишутся одной записью ocr_prefetch_tick в конце такта; при
// отказе авторизации RAGU (401) такт прерывается записью
// ocr_prefetch_unauthorized, строки не трогаются (спека п.Б.9). Токен в лог
// не попадает.
//
// Разбор очереди отправки (спека agentrunner-111 п.2): цикл партий
// queued-строк, каждая партия отправляется существующей логикой
// ОтправитьОчередьRAGU (CAS-захват, платформенное извлечение, POST, решения
// по отказам, построчные замеры - без изменений). Вызывают: такт в
// последовательном режиме (прямо) и мост ar_ОчередьРаспознаванияФон
// .ВыполнитьОтправку из воркера фонового задания. Настройки RAGU, соединение
// и лимиты - внутри: воркер стартует без параметров (токен не сериализуется
// в журнал заданий).
//
// Пересечение партий двух исполнителей допустимо: проигравший CAS пропускает
// строку без единого HTTP-вызова (Пропущено). Стоп-условия цикла: партия без
// единой успешной отправки (нет прогресса - защита от круга по сбойным
// строкам; пустая очередь - тот же случай), отправлено >= ЛимитОтправкиЗаТакт
// (потолок на исполнителя), 401 (Отменено: строка возвращена тихо, стоп).
//
// Возвращаемое значение:
//  Структура - счетчики отправки: Отправлено, Готово, Ошибок, SDocster,
//  Пропущено - Число; Отменено - Булево - RAGU отклонил токен (401).
//
Функция РазобратьОчередьОтправки() Экспорт

	Счётчики = Новый Структура("Отправлено, Готово, Ошибок, SDocster, Пропущено, Отменено",
		0, 0, 0, 0, 0, Ложь);

	АдресСервиса = СокрЛП(ar_Настройки.ЗначениеНастройки("RAGUАдресСервиса", ""));
	Токен = ТокенRAGU();
	Если ПустаяСтрока(АдресСервиса) Или ПустаяСтрока(Токен) Тогда
		// Настройка снята после старта воркера: делать нечего, следующий такт
		// пройдет штатно - не ошибка воркера.
		Возврат Счётчики;
	КонецЕсли;

	ТекстОшибки = "";
	Подключение = ПодключениеRAGU(АдресСервиса, ТекстОшибки);
	Если Подключение = Неопределено Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_send_error", ТекстОшибки, "Ошибка");
		Возврат Счётчики;
	КонецЕсли;

	Потолок = ЛимитОтправкиЗаТакт();
	РазмерПартии = РазмерПартииОтправки();
	Пока Счётчики.Отправлено < Потолок Цикл
		ОтправленоДо = Счётчики.Отправлено;
		Если Не ОтправитьОчередьRAGU(Подключение, Токен, Счётчики, РазмерПартии) Тогда
			// 401: токен отклонен; строка возвращена тихо, событие уже в логе.
			Счётчики.Отменено = Истина;
			Прервать;
		КонецЕсли;
		Если Счётчики.Отправлено = ОтправленоДо Тогда
			Прервать; // нет прогресса: очередь пуста либо строки ушли конкурентам
		КонецЕсли;
	КонецЦикла;

	Возврат Счётчики;

КонецФункции

// Достарт воркеров отправки до ВоркеровМаксимум (спека agentrunner-111
// п.3): при наличии queued-строк запускаются фоновые задания без параметров
// (паттерн ar_RuntimeЗапуск: метод общих модулей расширения строкой, ключ
// "ar_ocr_" + UUID - различимость в списке заданий). Отказ запуска (занятый
// слот, отказ кластера) - не ошибка такта: строки остаются в очереди,
// следующий такт повторит.
//
// Параметры:
//  ВоркеровМаксимум - Число - целевое число воркеров (настройка
//                     OCRВоркеровМаксимум, уже ограничена диапазоном 0-4).
//
// Возвращаемое значение:
//  Число - сколько воркеров достартовано этим тактом (факт в замер).
//
Функция ДостартоватьВоркеровОтправки(Знач ВоркеровМаксимум)

	// Без queued-строк воркерам нечего разбирать - не стартовать.
	Если ar_ОчередьРаспознавания.СтрокиПоСтатусу("queued", 1).Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Свободно = ВоркеровМаксимум - ar_ОчередьРаспознавания.АктивныеВоркеры();
	Достартовано = 0;
	Пока Достартовано < Свободно Цикл
		Попытка
			ФоновыеЗадания.Выполнить(ar_ОчередьРаспознавания.ИмяМетодаВоркера(),
				Новый Массив,
				"ar_ocr_" + Строка(Новый УникальныйИдентификатор),
				"OCR: отправка файлов");
			Достартовано = Достартовано + 1;
		Исключение
			ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_worker_start_failed",
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), "Отладка");
			Прервать;
		КонецПопытки;
	КонецЦикла;

	Возврат Достартовано;

КонецФункции

Процедура ВыполнитьТактПредварительногоРаспознавания()

	АдресСервиса = СокрЛП(ar_Настройки.ЗначениеНастройки("RAGUАдресСервиса", ""));
	Токен = ТокенRAGU();
	RAGUНастроен = Не ПустаяСтрока(АдресСервиса) И Не ПустаяСтрока(Токен);
	Если Не RAGUНастроен И Не СервисSDocsterНастроен() Тогда
		// Не настроено ничего: выход без сети и без записей в лог (спека п.Б.4).
		Возврат;
	КонецЕсли;

	Подключение = Неопределено;
	Если RAGUНастроен Тогда
		ТекстОшибки = "";
		Подключение = ПодключениеRAGU(АдресСервиса, ТекстОшибки);
		Если Подключение = Неопределено Тогда
			ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_prefetch_error",
				ТекстОшибки, "Ошибка");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	НачалоТакта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Счётчики = Новый Структура("Найдено, Поставлено, Отправлено, Готово, Ошибок, SDocster", 0, 0, 0, 0, 0, 0);

	Кандидаты = ОтобратьКандидатовРаспознавания();
	Счётчики.Найдено = Кандидаты.Количество();

	ПоставитьВОчередь(Кандидаты, Счётчики);

	// Многопоточная отправка (спека agentrunner-111 п.3): OCRВоркеровМаксимум
	// > 0 на клиент-серверной ИБ - воркеры фоновых заданий; на файловой ИБ
	// слот фонового задания занят самим тактом (Выполнить бросает исключение,
	// ar_RuntimeЗапуск.ФоновоеЗаданиеНужноВыполнитьСинхронно) - всегда инлайн.
	ВоркеровМаксимум = ЧислоВоркеровОтправки();
	ПараллельныйРежим = РежимОтправкиПараллельный(ВоркеровМаксимум);
	ЗаписатьЛогФайловаяИБ(ВоркеровМаксимум, ПараллельныйРежим);

	// Отправка инициализируется до ветвления: в ветви без RAGU (только
	// S.Docster) отправка не выполняется, в замер уходит нулевое Достартовано.
	Отправка = Новый Структура("Достартовано, Отменено", 0, Ложь);
	Если Подключение <> Неопределено Тогда
		Отправка = ОтправитьОчередьВРежимеТакта(Счётчики, ПараллельныйРежим, ВоркеровМаксимум);
		Если Отправка.Отменено Тогда
			Возврат; // 401: такт прерван, строка возвращена тихо
		КонецЕсли;
		// Параллельный режим - грань свежести: строки с POST в полете
		// (младше грани) не опрашиваются (спека agentrunner-111 п.5).
		ГраньСвежести = ?(ПараллельныйРежим, ГраньСвежестиОпросаСекунд(), 0);
		Если Не ДостроитьГотовыеТексты(Подключение, Токен, Счётчики, ГраньСвежести) Тогда
			Возврат; // 401: такт прерван
		КонецЕсли;
	Иначе
		// RAGU не настроен, S.Docster настроен (спека agentrunner-100 п.3):
		// queued-строки идут к платформе и S.Docster с причиной
		// «RAGU: не настроен» - такт не выходит молча.
		ОбработатьОчередьБезRAGU(Счётчики);
	КонецЕсли;

	// Строки прошлых тактов, не добравшиеся до S.Docster из-за лимита
	// (agentrunner-100 п.3), - в пределах оставшегося лимита.
	ДостроитьСтрокиСДокстер(Счётчики);

	// Очистка закрытых строк: срок хранения 7 суток (спека п.Б.10).
	СрокХраненияЗакрытыхДней = 7;
	ar_ОчередьРаспознавания.УдалитьЗакрытыеСтарше(СрокХраненияЗакрытыхДней);

	ЗаписатьЗамерТакта(Счётчики, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТакта,
		ПарыВоркеровЗамера(ПараллельныйРежим, Отправка.Достартовано));

КонецПроцедуры

// Отправка очереди в режиме такта (спека agentrunner-111 п.3): параллельный
// режим - достарт воркеров до ВоркеровМаксимум (0 свободных слотов - не
// ошибка, факт в замер); последовательный - инлайн разбор той же функцией,
// что у воркера, с пополнением счетчиков такта.
//
// Параметры:
//  Счётчики          - Структура - счетчики такта (в инлайн-режиме Отправлено,
//                      Готово, Ошибок, SDocster - изменяются).
//  ПараллельныйРежим - Булево  - воркеры фоновых заданий либо инлайн.
//  ВоркеровМаксимум  - Число   - целевое число воркеров (0-4).
//
// Возвращаемое значение:
//  Структура - {Достартовано - Число; Отменено - Булево - RAGU отклонил
//  токен (401), такт прервать}.
//
Функция ОтправитьОчередьВРежимеТакта(Счётчики, Знач ПараллельныйРежим, Знач ВоркеровМаксимум)

	Результат = Новый Структура("Достартовано, Отменено", 0, Ложь);

	Если ПараллельныйРежим Тогда
		Результат.Достартовано = ДостартоватьВоркеровОтправки(ВоркеровМаксимум);
		Возврат Результат;
	КонецЕсли;

	Отправка = РазобратьОчередьОтправки();
	Счётчики.Отправлено = Счётчики.Отправлено + Отправка.Отправлено;
	Счётчики.Готово = Счётчики.Готово + Отправка.Готово;
	Счётчики.Ошибок = Счётчики.Ошибок + Отправка.Ошибок;
	Счётчики.SDocster = Счётчики.SDocster + Отправка.SDocster;
	Результат.Отменено = Отправка.Отменено;

	Возврат Результат;

КонецФункции

// Пары workers/started для замера такта: только в параллельном режиме
// (спека agentrunner-111 п.3); Неопределено - пары не добавляются.
//
// Параметры:
//  ПараллельныйРежим - Булево - воркеры фоновых заданий.
//  Достартовано      - Число   - воркеры, достартованные этим тактом.
//
// Возвращаемое значение:
//  Структура - {Активные, Достартовано}; Неопределено - не параллельный режим.
//
Функция ПарыВоркеровЗамера(Знач ПараллельныйРежим, Знач Достартовано)

	Если НЕ ПараллельныйРежим Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Активные, Достартовано",
		ar_ОчередьРаспознавания.АктивныеВоркеры(), Достартовано);

КонецФункции

// Параллельный режим отправки (спека agentrunner-111 п.3): воркеры включены
// настройкой (>0) и база клиент-серверная.
//
// Параметры:
//  ВоркеровМаксимум - Число - настройка OCRВоркеровМаксимум (0-4).
//
// Возвращаемое значение:
//  Булево - Истина - отправку делают воркеры фоновых заданий.
//
Функция РежимОтправкиПараллельный(Знач ВоркеровМаксимум)

	Возврат ВоркеровМаксимум > 0
		И НЕ ОбщегоНазначения.ИнформационнаяБазаФайловая();

КонецФункции

// Наблюдаемость файловой ИБ (спека agentrunner-111 п.3): при включенных
// воркерах на файловой ИБ - одна запись на такт, отправка ушла в инлайн.
//
// Параметры:
//  ВоркеровМаксимум  - Число  - настройка OCRВоркеровМаксимум (0-4).
//  ПараллельныйРежим - Булево - фактический режим отправки.
//
Процедура ЗаписатьЛогФайловаяИБ(Знач ВоркеровМаксимум, Знач ПараллельныйРежим)

	Если ПараллельныйРежим Или ВоркеровМаксимум = 0 Тогда
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_dispatch_file_infobase",
		"Файловая ИБ: воркеры (" + Формат(ВоркеровМаксимум, "ЧН=0; ЧГ=0")
			+ ") не стартуют, отправка инлайн", "Информация");

КонецПроцедуры

// Отбор кандидатов в предварительное распознавание (спека agentrunner-74
// п.Б.5; agentrunner-100 п.4 - кандидат и файл со статусом «Извлечен», если
// текст в кэше пустой): файлы владельцев ar_ПрикладнойОбъект по правилам
// владельцев, без непустого текста, не помеченные на удаление, не
// зашифрованные, поддерживаемого расширения (платформа или сервис) и
// допустимого размера; файлы закрытых заявок НСИ отбраковываются соединением
// с РегистрСведений.бит_СтатусыОбъектов в каждой секции запроса
// (agentrunner-220, исправление по итогам verify: отсеивание отдельным
// запросом после отбора не срабатывало в такте - репро дважды, runs.md). Один запрос
// объединением по справочникам файлов всех типов владельцев, выполняется в
// привилегированном режиме: очередь общая для всех агентов, а регламентное
// задание БСП работает от имени пользователя задания. Непустоту
// ТекстХранилища в запросе не проверить (ХранилищеЗначения) - текст читается
// в выборке, кандидаты с непустым текстом отбрасываются в цикле.
//
// Возвращаемое значение:
//  Массив из Структура - {Ссылка, Наименование, Расширение (нижний регистр),
//  Размер, ДатаМодификации (ДатаМодификацииУниверсальная), ВладелецФайла}.
//
Функция ОтобратьКандидатовРаспознавания()

	Кандидаты = Новый Массив;

	Секции = Новый Массив;
	Запрос = Новый Запрос;
	ИндексСекции = 0;
	Для Каждого Правило Из ПравилаОтбораВладельцев() Цикл
		ИменаСправочников = РаботаСФайламиСлужебный.ИменаСправочниковХраненияФайлов(Правило.Тип, Истина);
		Для Каждого ИмяСправочника Из ИменаСправочников Цикл
			// Грань глубины - параметром секции: у правил владельцев глубина
			// может отличаться (точка расширения правил, спека п.Б.5).
			ИмяПараметра = "Грань" + Формат(ИндексСекции, "ЧН=0; ЧГ=0");
			// Сутки в секундах.
			СекундВСутках = 86400;
			Запрос.УстановитьПараметр(ИмяПараметра,
				НачалоДня(ТекущаяДатаСеанса()) - (Правило.ГлубинаДней - 1) * СекундВСутках);
			Секции.Добавить(ТекстСекцииКандидатов("Справочник." + ИмяСправочника.Ключ, ИмяПараметра));
			ИндексСекции = ИндексСекции + 1;
		КонецЦикла;
	КонецЦикла;

	Если Секции.Количество() = 0 Тогда
		Возврат Кандидаты;
	КонецЕсли;

	Запрос.УстановитьПараметр("Расширения", РасширенияОчереди());
	// Дефолт настройки - как в НастройкиИзвлеченияТекста (спека п.Б.5).
	ПределРазмераПоУмолчанию = 20000000;
	Запрос.УстановитьПараметр("ПределРазмера",
		ar_Настройки.ЗначениеНастройки("ПредельныйРазмерФайлаРаспознавания", ПределРазмераПоУмолчанию));
	Запрос.Текст = ТекстЗапросаОбъединения(Секции);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Пока Выборка.Следующий() Цикл
		// Кэш с непустым текстом - не кандидат (agentrunner-100 п.4).
		Если КэшСНепустымТекстом(Выборка.СтатусИзвлеченияТекста, Выборка.ТекстХранилище) Тогда
			Продолжить;
		КонецЕсли;
		Кандидат = Новый Структура;
		Кандидат.Вставить("Ссылка", Выборка.Ссылка);
		Кандидат.Вставить("Наименование", Выборка.Наименование);
		Кандидат.Вставить("Расширение", НРег(СокрЛП(Выборка.Расширение)));
		Кандидат.Вставить("Размер", Выборка.Размер);
		Кандидат.Вставить("ДатаМодификации", Выборка.ДатаМодификации);
		Кандидат.Вставить("ВладелецФайла", Выборка.ВладелецФайла);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// Правила отбора владельцев (спека agentrunner-74 п.Б.5): владельцы - все
// типы ar_ПрикладнойОбъект; правило владельца - глубина отбора по ДатаСоздания
// файла. Заявки НСИ выделены явной строкой - точка для будущих условий
// (например «только заявки на визе агента»); глубина пока общая - 3 дня
// (решение человека 2026-10-12).
//
// Возвращаемое значение:
//  Массив из Структура - {Тип - Тип владельца; ГлубинаДней - Число}.
//
Функция ПравилаОтбораВладельцев()

	ГлубинаПоУмолчанию = 3;

	Правила = Новый Массив;
	Для Каждого ТипВладельца Из Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъект.Тип.Типы() Цикл
		Глубина = ГлубинаПоУмолчанию;
		Если ТипВладельца = Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
			// Явная строка правила заявок НСИ: глубина 3 дня (спека п.Б.5).
			Глубина = 3;
		КонецЕсли;
		Правило = Новый Структура;
		Правило.Вставить("Тип", ТипВладельца);
		Правило.Вставить("ГлубинаДней", Глубина);
		Правила.Добавить(Правило);
	КонецЦикла;
	Возврат Правила;

КонецФункции

// Секция объединённого запроса кандидатов по одному справочнику файлов:
// условия файла - спека agentrunner-74 п.Б.5; статус извлечения не
// фильтруется (agentrunner-100 п.4 - «Извлечен» с пустым текстом тоже
// кандидат), статус и текст читаются в выборке и проверяются в коде цикла
// кандидатов. Файлы закрытых заявок НСИ отсекаются анти-соединением с
// РегистрСведений.бит_СтатусыОбъектов (agentrunner-220): соединение
// срабатывает только для владельцев-заявок (ССЫЛКА) с терминальным статусом
// («Исполнена» - ЗаявкаНаИзменение_Исполнена или общий «Закрыт», ВидСтатуса =
// Статус) - как в бит_ВизированиеСервер.ТекущийСтатус; заявка без записи
// статуса и все прочие владельцы мимо соединения - остаются кандидатами.
// Соединение добавляется только в секцию справочника, тип владельца которого
// содержит заявку (1.5.2): для прочих справочников ССЫЛКА на несовместимый
// тип - ошибка запроса «Несовместимые типы "ССЫЛКА"».
// Имя таблицы - только из
// РаботаСФайламиСлужебный.ИменаСправочниковХраненияФайлов (Метаданные
// .ПолноеИмя), значения - параметрами (P1 query_dynamic_text_building).
//
// Параметры:
//  ИмяТаблицы        - Строка - полное имя справочника файлов.
//  ИмяПараметраГрани - Строка - имя параметра грани глубины этого правила.
//
// Возвращаемое значение:
//  Строка - текст секции запроса.
//
Функция ТекстСекцииКандидатов(Знач ИмяТаблицы, Знач ИмяПараметраГрани)

	Если Не ВладелецФайловМожетБытьЗаявкой(ИмяТаблицы) Тогда
		Возврат "ВЫБРАТЬ
			|	Ф.Ссылка КАК Ссылка,
			|	Ф.Наименование КАК Наименование,
			|	Ф.Расширение КАК Расширение,
			|	Ф.Размер КАК Размер,
			|	Ф.ДатаМодификацииУниверсальная КАК ДатаМодификации,
			|	Ф.СтатусИзвлеченияТекста КАК СтатусИзвлеченияТекста,
			|	Ф.ТекстХранилище КАК ТекстХранилище,
			|	Ф.ВладелецФайла КАК ВладелецФайла
			|ИЗ
			|	" + ИмяТаблицы + " КАК Ф
			|ГДЕ
			|	НЕ Ф.ПометкаУдаления
			|	И НЕ Ф.Зашифрован
			|	И Ф.Расширение В (&Расширения)
			|	И Ф.Размер <= &ПределРазмера
			|	И Ф.ДатаСоздания >= &" + ИмяПараметраГрани;
	КонецЕсли;

	Возврат "ВЫБРАТЬ
		|	Ф.Ссылка КАК Ссылка,
		|	Ф.Наименование КАК Наименование,
		|	Ф.Расширение КАК Расширение,
		|	Ф.Размер КАК Размер,
		|	Ф.ДатаМодификацииУниверсальная КАК ДатаМодификации,
		|	Ф.СтатусИзвлеченияТекста КАК СтатусИзвлеченияТекста,
		|	Ф.ТекстХранилище КАК ТекстХранилище,
		|	Ф.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	" + ИмяТаблицы + " КАК Ф
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК Статусы
		|		ПО Ф.ВладелецФайла = Статусы.Объект
		|			И Ф.ВладелецФайла ССЫЛКА Документ.бит_мдм_ЗаявкаНаИзменение
		|			И Статусы.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.бит_ВидыСтатусовОбъектов.Статус)
		|			И Статусы.Статус В (ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена),
		|				ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.Закрыт))
		|ГДЕ
		|	НЕ Ф.ПометкаУдаления
		|	И НЕ Ф.Зашифрован
		|	И Ф.Расширение В (&Расширения)
		|	И Ф.Размер <= &ПределРазмера
		|	И Ф.ДатаСоздания >= &" + ИмяПараметраГрани + "
		|	И Статусы.Объект ЕСТЬ NULL";

КонецФункции

// Может ли владельцем файлов справочника быть заявка НСИ - тип реквизита
// ВладелецФайла содержит ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя справочника файлов.
//
// Возвращаемое значение:
//  Булево - Истина - в секции нужно отсечение закрытых заявок.
//
Функция ВладелецФайловМожетБытьЗаявкой(Знач ИмяТаблицы)

	МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	РеквизитВладельца = МетаданныеСправочника.Реквизиты.Найти("ВладелецФайла");
	Если РеквизитВладельца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РеквизитВладельца.Тип.СодержитТип(Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение"));

КонецФункции

// Кэш файла с непустым текстом (agentrunner-100 п.4): статус «Извлечен» с
// пустой строкой кэшем не считается - файл продолжает распознавание.
//
// Параметры:
//  СтатусИзвлеченияТекста - ПеречислениеСсылка.СтатусыИзвлеченияТекстаФайлов - статус кэша.
//  ТекстХранилище         - ХранилищеЗначения - кэш текста файла.
//
// Возвращаемое значение:
//  Булево - Истина - в кэше есть непустой текст.
//
Функция КэшСНепустымТекстом(Знач СтатусИзвлеченияТекста, Знач ТекстХранилище)

	Возврат СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен
		И Не ПустаяСтрока(ТекстИзХранилища(ТекстХранилище));

КонецФункции

// Постановка кандидатов в очередь (спека agentrunner-74 п.Б.5): в очередь
// (queued, ar_Попыток = 0) - файл без строки в очереди либо с изменившимся
// отпечатком (ДатаМодификации + Размер - файл перезагрузили), независимо от
// статуса строки; не более 20 новых строк за такт. Правило постановки -
// единая точка ar_ОчередьРаспознавания.ПоставитьФайл (agentrunner-111):
// живая строка с тем же отпечатком не трогается.
//
// Параметры:
//  Кандидаты - Массив из Структура - результат ОтобратьКандидатовРаспознавания.
//  Счётчики  - Структура - счётчики такта (Поставлено, Ошибок - изменяются).
//
Процедура ПоставитьВОчередь(Знач Кандидаты, Счётчики)

	КандидатыПоФайлам = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		НавигационнаяСсылка = ar_Утилиты.НавигационнаяСсылкаОбъекта(Кандидат.Ссылка);
		Если КандидатыПоФайлам.Получить(НавигационнаяСсылка) = Неопределено Тогда
			КандидатыПоФайлам.Вставить(НавигационнаяСсылка, Кандидат);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из КандидатыПоФайлам Цикл
		Если Счётчики.Поставлено >= ЛимитПостановкиЗаТакт() Тогда
			Прервать;
		КонецЕсли;
		Кандидат = Элемент.Значение;
		Данные = ar_ОчередьРаспознавания.НоваяСтрокаОчереди();
		Данные.Файл = Элемент.Ключ;
		Данные.Владелец = ar_Утилиты.НавигационнаяСсылкаОбъекта(Кандидат.ВладелецФайла);
		Данные.Расширение = Кандидат.Расширение;
		Данные.Размер = Кандидат.Размер;
		Данные.ДатаМодификации = Кандидат.ДатаМодификации;
		Данные.ПоставленоВ = ТекущаяДатаСеанса();
		Попытка
			Если ar_ОчередьРаспознавания.ПоставитьФайл(Данные) Тогда
				Счётчики.Поставлено = Счётчики.Поставлено + 1;
			КонецЕсли;
		Исключение
			// Сбой записи одной строки не останавливает такт: счётчик - в tick.
			Счётчики.Ошибок = Счётчики.Ошибок + 1;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Отправка queued-строк в асинхронный RAGU (спека agentrunner-74 п.Б.6):
// переход queued -> processing под блокировкой (защита от двойной отправки),
// затем POST /api/v1/parse/jobs. Отказ 400/413/415/422 - окончательный отказ
// RAGU (кэш добирает запасной S.Docster); соединение и прочие коды - повтор
// (queued, Попыток + 1, после 3 - тоже S.Docster); 401 - стоп отправки
// (спека п.Б.9). Офисные форматы (agentrunner-100 п.2): до отправки -
// извлечение платформой, при непустом тексте RAGU не вызывается; кэш с
// непустым текстом - skipped. Многопоточная отправка (agentrunner-111):
// строка, уведенная конкурентом (CAS проиграл), пропускается без
// HTTP-вызова и отмечается в Пропущено.
//
// Параметры:
//  Подключение  - Структура - {Соединение, ПутьБазы} (ПодключениеRAGU).
//  Токен        - Строка   - токен RAGU.
//  Счётчики     - Структура - счетчики (Отправлено, Ошибок - изменяются;
//                 Пропущено - при наличии).
//  ЛимитПартии  - Число   - queued-строк в партии; 0 - ЛимитОтправкиЗаТакт
//                 (разбор очереди задает размер партии настройкой
//                 OCRРазмерПартии, спека agentrunner-111 п.2).
//
// Возвращаемое значение:
//  Булево - Ложь, если RAGU отклонил токен и отправку прервать.
//
Функция ОтправитьОчередьRAGU(Знач Подключение, Знач Токен, Счётчики, Знач ЛимитПартии = 0)

	Если ЛимитПартии <= 0 Тогда
		ЛимитПартии = ЛимитОтправкиЗаТакт();
	КонецЕсли;
	СтрокиОчереди = ar_ОчередьРаспознавания.СтрокиПоСтатусу("queued", ЛимитПартии);
	Если СтрокиОчереди.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	СвойстваФайлов = СвойстваФайловПартии(СтрокиОчереди);

	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл

		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
		Свойства = СвойстваФайлов.Получить(ФайлСсылка);
		Если Свойства = Неопределено Тогда
			// Строка еще queued (CAS будет позже) - ожидаемый статус queued.
			ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Файл не найден в информационной базе'"),
				Счётчики, "queued");
			Продолжить;
		КонецЕсли;

		// Текст уже появился в кэше (распознали из files_get_text) - пропустить
		// без обращения к сервису (тот же порядок кэш-первым, что в файле);
		// «Извлечен» с пустым текстом кэшем не считается (agentrunner-100 п.4).
		Если КэшСНепустымТекстом(Свойства.СтатусИзвлеченияТекста, Свойства.ТекстХранилище) Тогда
			ЗакрытьСтрокуПропуском(СтрокаОчереди, Счётчики, "queued");
			Продолжить;
		КонецЕсли;

		// Блокирующий переход queued -> processing: не вышло - строку забрал
		// другой процесс, пропуск (спека п.Б.6).
		СтрокаОчереди.Статус = "processing";
		СтрокаОчереди.ОтправленоВ = ТекущаяДатаСеанса();
		Если Не ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, "queued") Тогда
			УчестьПропущеннуюСтроку(Счётчики);
			Продолжить;
		КонецЕсли;

		// Офисные форматы - сначала платформа (agentrunner-100 п.2); строка
		// закрыта платформой (done / отказ doc / сброс по отпечатку) - RAGU
		// не вызывается.
		Если РасширениеПоддерживаетсяПлатформой(НРег(СокрЛП(СтрокаОчереди.Расширение))) Тогда
			Если ИзвлечьСтрокуПлатформой(СтрокаОчереди, Свойства, ФайлСсылка, Счётчики) Тогда
				Продолжить;
			КонецЕсли;
			// Платформа не дала текста: xls/xlsx/docx идут дальше - в RAGU.
		КонецЕсли;

		Если Не ОтправитьСтрокуОчередиRAGU(Подключение, Токен, ФайлСсылка, СтрокаОчереди, Свойства, Счётчики) Тогда
			Возврат Ложь; // 401: такт прерван
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Отправка одной строки очереди в RAGU (спека agentrunner-74 п.Б.6): чтение
// двоичных данных файла, POST задания, замер и запись результата (id задания
// либо решение по отказу). Строка - в статусе processing: переход сделан
// вызывающим кодом под блокировкой.
//
// Параметры:
//  Подключение   - Структура - {Соединение, ПутьБазы}.
//  Токен         - Строка - токен RAGU.
//  ФайлСсылка    - ЛюбаяСсылка - файл строки очереди.
//  СтрокаОчереди - Структура - строка очереди (изменяется).
//  Свойства      - Структура - свойства файла (Наименование).
//  Счётчики      - Структура - счётчики такта (Отправлено, Ошибок - изменяются).
//
// Возвращаемое значение:
//  Булево - Ложь - RAGU отклонил токен (401): такт прервать.
//
Функция ОтправитьСтрокуОчередиRAGU(Знач Подключение, Знач Токен, Знач ФайлСсылка, СтрокаОчереди,
	Знач Свойства, Счётчики)

	ДвоичныеДанные = Неопределено;
	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка, Ложь);
	Исключение
		ДвоичныеДанные = Неопределено;
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		ВернутьСтрокуВОчередь(СтрокаОчереди, НСтр("ru = 'Данные файла не найдены'"), Счётчики, Свойства);
		Возврат Истина;
	КонецЕсли;

	Ответ = ОтправитьЗаданиеRAGU(Подключение, Токен, ДвоичныеДанные,
		Свойства.Наименование, СтрокаОчереди.Расширение);

	Если Ответ.КодОтвета = 401 Тогда
		ВернутьСтрокуВОчередьТихо(СтрокаОчереди);
		ЗаписатьЛогНеразрешённыйТокен();
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьЗамерЗаданияРаспознавания("submit", СтрокаОчереди, Свойства.Наименование,
		Ответ.КодОтвета, Ответ.ДлительностьМс, Ответ.ИдЗадания);

	Если ПустаяСтрока(Ответ.ТекстОшибки) Тогда
		СтрокаОчереди.ИдЗадания = Ответ.ИдЗадания;
		Попытка
			ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди);
			Счётчики.Отправлено = Счётчики.Отправлено + 1;
		Исключение
			// Строка останется processing без id - закроется по сроку 23 ч.
			Счётчики.Ошибок = Счётчики.Ошибок + 1;
		КонецПопытки;
	Иначе
		ОбработатьОтказОтправки(СтрокаОчереди, Ответ.КодОтвета, Ответ.ТекстОшибки, Свойства, Счётчики);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Решение по отказу отправки (спека agentrunner-74 п.Б.9; agentrunner-100
// п.3): 400/413/415/422 - окончательный отказ RAGU (формат файла, повторы
// бессмысленны) - кэш добирает запасной S.Docster; ошибки соединения и
// прочие коды (в том числе 503) - повтор (исчерпание попыток - тоже
// S.Docster, см. ВернутьСтрокуВОчередь).
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (в статусе processing).
//  КодОтвета     - Число    - код ответа RAGU; 0 - ошибка соединения.
//  ТекстОшибки   - Строка   - текст ошибки сервиса или соединения.
//  Свойства      - Структура - свойства файла (для запасного S.Docster).
//  Счётчики      - Структура - счетчики такта (Ошибок - изменяется).
//
Процедура ОбработатьОтказОтправки(СтрокаОчереди, Знач КодОтвета, Знач ТекстОшибки, Знач Свойства, Счётчики)

	Если КодОтвета = 400 Или КодОтвета = 413 Или КодОтвета = 415 Или КодОтвета = 422 Тогда
		ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, ТекстОшибки, Свойства, Счётчики);
	Иначе
		ВернутьСтрокуВОчередь(СтрокаОчереди, ТекстОшибки, Счётчики, Свойства);
	КонецЕсли;

КонецПроцедуры

// Отметить строку, ушедшую конкуренту (agentrunner-111): CAS проиграл -
// строка пропущена без единого HTTP-вызова. Счетчик Пропущено есть у
// разбора очереди (событие ocr_worker_done); у счетчиков такта его нет -
// пары tick не расширяются.
//
// Параметры:
//  Счётчики - Структура - счетчики отправки (Пропущено - при наличии,
//             изменяется).
//
Процедура УчестьПропущеннуюСтроку(Счётчики)

	Пропущено = 0;
	Если Счётчики.Свойство("Пропущено", Пропущено) Тогда
		Счётчики.Пропущено = Пропущено + 1;
	КонецЕсли;

КонецПроцедуры

// Опрос processing-строк в RAGU (спека agentrunner-74 п.Б.7, до 50 за такт):
// GET /api/v1/parse/jobs/<id>; completed - забрать текст (GET .../text) и
// записать в кэш; failed - отказ строки; строка с ar_ОтправленоВ старше
// 23 часов - failed (результат RAGU хранится 24 часа). Повторяемые ошибки
// (соединение, 503, 404) - возврат в очередь со счётчиком попыток; 401 -
// стоп такта, строки не трогаются (спека п.Б.9). Грань свежести
// (agentrunner-111 п.5): в параллельном режиме строки младше грани не
// отбираются (POST в полете - опрос дал бы 404 и повторную отправку).
//
// Параметры:
//  Подключение      - Структура - {Соединение, ПутьБазы} (ПодключениеRAGU).
//  Токен            - Строка   - токен RAGU.
//  Счётчики         - Структура - счетчики такта (Готово, Ошибок - изменяются).
//  ГраньСвежестиСек - Число    - грань свежести для СтрокиКОпросу; 0 -
//                     без фильтра (последовательный режим, как раньше).
//
// Возвращаемое значение:
//  Булево - Ложь, если RAGU отклонил токен и такт прерван.
//
Функция ДостроитьГотовыеТексты(Знач Подключение, Знач Токен, Счётчики, Знач ГраньСвежестиСек = 0)

	СтрокиОчереди = ar_ОчередьРаспознавания.СтрокиКОпросу(ЛимитОпросаЗаТакт(), ГраньСвежестиСек);
	Если СтрокиОчереди.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	СвойстваФайлов = СвойстваФайловПартии(СтрокиОчереди);
	ГотовыеТексты = Новый Соответствие; // строка очереди -> {Текст, КодОтвета, ДлительностьМс}

	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл

		// Строки, ожидающие запасного S.Docster (agentrunner-100 п.3), RAGU
		// не опрашиваются - их добирает ДостроитьСтрокиСДокстер.
		Если ПустаяСтрока(СтрокаОчереди.ИдЗадания)
			И СтрНачинаетсяС(СтрокаОчереди.ПоследняяОшибка, ПрефиксПричиныRAGU()) Тогда
			Продолжить;
		КонецЕсли;

		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
		Свойства = СвойстваФайлов.Получить(ФайлСсылка);
		Если Свойства = Неопределено Тогда
			ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Файл не найден в информационной базе'"), Счётчики);
			Продолжить;
		КонецЕсли;

		РезультатОпроса = ОпроситьСтрокуОчередиRAGU(Подключение, Токен, СтрокаОчереди, Свойства, Счётчики);
		Если РезультатОпроса.Стоп Тогда
			Возврат Ложь; // 401: такт прерван, строки не трогаются
		КонецЕсли;

		Если РезультатОпроса.ГотовТекст Тогда
			ДанныеТекста = Новый Структура("Текст, КодОтвета, ДлительностьМс",
				РезультатОпроса.Текст, РезультатОпроса.КодОтвета, РезультатОпроса.ДлительностьМс);
			ГотовыеТексты.Вставить(СтрокаОчереди, ДанныеТекста);
		КонецЕсли;

	КонецЦикла;

	Если ГотовыеТексты.Количество() > 0 Тогда
		ЗаписатьГотовыеТекстыВКэш(ГотовыеТексты, СвойстваФайлов, Счётчики);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Опрос одной processing-строки в RAGU (спека agentrunner-74 п.Б.7): GET
// статуса задания; при completed - GET текста. Строка с ar_ОтправленоВ старше
// 23 часов закрывается отказом (результат RAGU хранится 24 часа). Повторяемые
// ошибки (соединение, 503, 404) - возврат в очередь со счётчиком попыток;
// failed задания - отказ строки; 401 - стоп такта, строки не трогаются
// (спека п.Б.9).
//
// Параметры:
//  Подключение   - Структура - {Соединение, ПутьБазы}.
//  Токен         - Строка - токен RAGU.
//  СтрокаОчереди - Структура - строка очереди (может изменяться).
//  Свойства      - Структура - свойства файла (Наименование - для замера).
//  Счётчики      - Структура - счетчики такта (Ошибок - изменяется).
//
// Возвращаемое значение:
//  Структура - {Стоп - Булево - RAGU отклонил токен (401), такт прервать;
//  ГотовТекст - Булево; Текст - Строка; КодОтвета - Число; ДлительностьМс -
//  Число} - поля текста заполнены при ГотовТекст = Истина.
//
Функция ОпроситьСтрокуОчередиRAGU(Знач Подключение, Знач Токен, СтрокаОчереди, Знач Свойства, Счётчики)

	Результат = Новый Структура("Стоп, ГотовТекст, Текст, КодОтвета, ДлительностьМс",
		Ложь, Ложь, "", 0, 0);

	// Зависшее задание: результат RAGU хранится 24 часа, закрываем через
	// 23 часа с момента отправки (спека п.Б.7); это окончательный отказ
	// RAGU - кэш добирает запасной S.Docster (agentrunner-100 п.3).
	ЧасовИстечения = 23;
	СекундВЧасе = 3600;
	Если ТекущаяДатаСеанса() - СтрокаОчереди.ОтправленоВ >= ЧасовИстечения * СекундВЧасе Тогда
		ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди,
			НСтр("ru = 'Задание не завершилось за 23 часа, результат RAGU истекает'"), Свойства, Счётчики);
		Возврат Результат;
	КонецЕсли;

	Ответ = СтатусЗаданияRAGU(Подключение, Токен, СтрокаОчереди.ИдЗадания);
	Если Ответ.КодОтвета = 401 Тогда
		ЗаписатьЛогНеразрешённыйТокен();
		Результат.Стоп = Истина;
		Возврат Результат;
	КонецЕсли;
	ЗаписатьЗамерЗаданияРаспознавания("poll", СтрокаОчереди, Свойства.Наименование,
		Ответ.КодОтвета, Ответ.ДлительностьМс, "");

	Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
		ВернутьСтрокуВОчередь(СтрокаОчереди, Ответ.ТекстОшибки, Счётчики, Свойства);
		Возврат Результат;
	КонецЕсли;

	Если Ответ.СтатусЗадания = "failed" Тогда
		// Окончательный отказ RAGU - кэш добирает запасной S.Docster
		// (agentrunner-100 п.3).
		ТекстОтказа = Ответ.ТекстОшибкиЗадания;
		Если ПустаяСтрока(ТекстОтказа) Тогда
			ТекстОтказа = НСтр("ru = 'RAGU сообщил об отказе задания (status=failed)'");
		КонецЕсли;
		ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, ТекстОтказа, Свойства, Счётчики);
		Возврат Результат;
	КонецЕсли;

	Если Ответ.СтатусЗадания <> "completed" Тогда
		// processing (или неизвестный статус) - ждать следующего такта.
		Возврат Результат;
	КонецЕсли;

	ОтветТекста = ТекстЗаданияRAGU(Подключение, Токен, СтрокаОчереди.ИдЗадания);
	Если ОтветТекста.КодОтвета = 401 Тогда
		ЗаписатьЛогНеразрешённыйТокен();
		Результат.Стоп = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ОтветТекста.КодОтвета = 409 Тогда
		// Текст ещё не готов - строка остаётся в processing (спека п.Б.7).
		ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
			ОтветТекста.КодОтвета, ОтветТекста.ДлительностьМс, "");
		Возврат Результат;
	КонецЕсли;

	Если Не ПустаяСтрока(ОтветТекста.ТекстОшибки) Тогда
		ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
			ОтветТекста.КодОтвета, ОтветТекста.ДлительностьМс, "");
		ВернутьСтрокуВОчередь(СтрокаОчереди, ОтветТекста.ТекстОшибки, Счётчики, Свойства);
		Возврат Результат;
	КонецЕсли;

	Результат.ГотовТекст = Истина;
	Результат.Текст = ОтветТекста.Текст;
	Результат.КодОтвета = ОтветТекста.КодОтвета;
	Результат.ДлительностьМс = ОтветТекста.ДлительностьМс;
	Возврат Результат;

КонецФункции

// Запись готовых текстов в кэш справочника файлов (спека agentrunner-74
// п.Б.8): перед записью сверяется отпечаток файла (ДатаМодификации + Размер)
// с отпечатком строки - перезагруженный во время распознавания файл
// отбрасывает результат (строка снова queued, ar_Попыток = 0); файл уже
// с текстом (Извлечен) - skipped; занятый файл (Редактирует) остаётся в
// processing - запись на следующем такте; пустой текст - failed. Сама
// запись - общая функция пакета ЗаписатьТекстФайла (без копий, спека п.Б.8).
// Статус файла при отказах не меняется (решение человека 2026-10-12).
//
// Параметры:
//  ГотовыеТексты  - Соответствие - строка очереди -> {Текст, КодОтвета,
//                   ДлительностьМс}.
//  СвойстваФайлов - Соответствие - ссылка файла -> свойства (одним запросом).
//  Счётчики       - Структура   - счётчики такта (Готово, Ошибок - изменяются).
//
Процедура ЗаписатьГотовыеТекстыВКэш(Знач ГотовыеТексты, Знач СвойстваФайлов, Счётчики)

	Для Каждого Элемент Из ГотовыеТексты Цикл

		СтрокаОчереди = Элемент.Ключ;
		ДанныеТекста = Элемент.Значение;
		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
		Свойства = СвойстваФайлов.Получить(ФайлСсылка);

		// Свойства прочитаны одним запросом в ДостроитьГотовыеТексты; сюда
		// попадают только строки из той же партии - Свойства заполнено.
		Если Свойства.ДатаМодификации <> СтрокаОчереди.ДатаМодификации
			Или Свойства.Размер <> СтрокаОчереди.Размер Тогда
			ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
				ДанныеТекста.КодОтвета, ДанныеТекста.ДлительностьМс, "", "file_changed");
			СброситьСтрокуПоОтпечатку(СтрокаОчереди, Свойства, Счётчики);
			Продолжить;
		КонецЕсли;

		Если Свойства.СтатусИзвлеченияТекста = Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен
			И Не ПустаяСтрока(ТекстИзХранилища(Свойства.ТекстХранилище)) Тогда
			// Кэш с непустым текстом готов; «Извлечен» с пустым текстом кэшем
			// не считается - распознавание продолжается (agentrunner-100 п.4).
			ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
				ДанныеТекста.КодОтвета, ДанныеТекста.ДлительностьМс, "");
			ЗакрытьСтрокуПропуском(СтрокаОчереди, Счётчики);
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Свойства.Редактирует) Тогда
			// Файл занят: обращения к RAGU на этом шаге нет - замер не пишем,
			// строка остаётся в processing до следующего такта (спека п.Б.8).
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(ДанныеТекста.Текст)) Тогда
			// Окончательный отказ RAGU (пустой текст) - кэш добирает запасной
			// S.Docster (agentrunner-100 п.3).
			ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
				ДанныеТекста.КодОтвета, ДанныеТекста.ДлительностьМс, "");
			ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, НСтр("ru = 'Текст не извлечён'"), Свойства, Счётчики);
			Продолжить;
		КонецЕсли;

		ТекстОшибкиЗаписи = "";
		Если Не ЗаписатьТекстФайла(ФайлСсылка, ДанныеТекста.Текст, ТекстОшибкиЗаписи) Тогда
			ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
				ДанныеТекста.КодОтвета, ДанныеТекста.ДлительностьМс, "");
			// Ошибка записи - не отказ распознавания: запасной S.Docster не
			// вызывается (спека agentrunner-100 п.3).
			ЗакрытьСтрокуОтказом(СтрокаОчереди, ТекстОшибкиЗаписи, Счётчики);
			Продолжить;
		КонецЕсли;

		// done: итоговые пары замера - от ar_ОтправленоВ (спека п.Б.11);
		// в строке очереди видно, что текст дал RAGU (agentrunner-100 п.1).
		МиллисекундВСекунде = 1000;
		ЗаписатьЗамерЗаданияРаспознавания("text", СтрокаОчереди, Свойства.Наименование,
			ДанныеТекста.КодОтвета, ДанныеТекста.ДлительностьМс, "", "done",
			(ТекущаяДатаСеанса() - СтрокаОчереди.ОтправленоВ) * МиллисекундВСекунде, СтрокаОчереди.Попыток + 1);
		СтрокаОчереди.Сервис = "ragu";
		СтрокаОчереди.ПоследняяОшибка = "";
		ЗакрытьСтрокуГотово(СтрокаОчереди, Счётчики);

	КонецЦикла;

КонецПроцедуры

// Сброс строки по изменившемуся отпечатку (спека agentrunner-74 п.Б.8):
// результат распознавания отбрасывается, строка снова queued с отпечатком
// свежих свойств файла, ar_Попыток = 0 (файл пойдёт по очереди заново).
// Запись под проверкой статуса processing (CAS-каскад, agentrunner-111):
// конкурент не перетер чужой итог - строка, ушедшая из processing, не
// сбрасывается.
//
// Параметры:
//  СтрокаОчереди - Структура   - строка очереди (в статусе processing).
//  Свойства      - Структура   - свежие свойства файла.
//  Счётчики      - Структура   - счётчики такта (Ошибок - изменяется).
//
Процедура СброситьСтрокуПоОтпечатку(СтрокаОчереди, Знач Свойства, Счётчики)

	Данные = ar_ОчередьРаспознавания.НоваяСтрокаОчереди();
	Данные.Файл = СтрокаОчереди.Файл;
	Данные.Владелец = СтрокаОчереди.Владелец;
	Данные.Расширение = НРег(СокрЛП(Свойства.Расширение));
	Данные.Размер = Свойства.Размер;
	Данные.ДатаМодификации = Свойства.ДатаМодификации;
	Данные.ПоставленоВ = ТекущаяДатаСеанса();
	Попытка
		ar_ОчередьРаспознавания.ЗаписатьСтроку(Данные, "processing");
	Исключение
		Счётчики.Ошибок = Счётчики.Ошибок + 1;
	КонецПопытки;

КонецПроцедуры

// Закрытие строки отказом: статус failed, текст ошибки - в ar_ПоследняяОшибка
// (спека agentrunner-74 п.Б.9: статус файла не меняется - только отметка в
// очереди). Запись под проверкой статуса (CAS-каскад, agentrunner-111):
// по умолчанию processing (конкурент не перетер чужой итог); вызовы на
// queued-строках, еще не прошедших CAS-захват (файл не найден, кэш-пропуск),
// передают "queued".
//
// Параметры:
//  СтрокаОчереди    - Структура - строка очереди.
//  ТекстОшибки      - Строка    - текст ошибки (поле error RAGU либо код).
//  Счётчики         - Структура - счетчики такта (Ошибок - изменяется).
//  ОжидаемыйСтатус  - Строка    - ожидаемый текущий статус строки
//                     ("processing" - по умолчанию, "queued" - до CAS-захвата).
//
Процедура ЗакрытьСтрокуОтказом(СтрокаОчереди, Знач ТекстОшибки, Счётчики, Знач ОжидаемыйСтатус = "processing")

	СтрокаОчереди.Статус = "failed";
	СтрокаОчереди.ПоследняяОшибка = ТекстОшибки;
	Попытка
		ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, ОжидаемыйСтатус);
	Исключение
		Счётчики.Ошибок = Счётчики.Ошибок + 1;
	КонецПопытки;
	Счётчики.Ошибок = Счётчики.Ошибок + 1;

КонецПроцедуры

// Закрытие строки пропуском: текст уже есть в кэше файла (спека
// agentrunner-74 п.Б.8) - статус skipped, RAGU не вызывался. Запись под
// проверкой статуса (CAS-каскад, agentrunner-111) - как в ЗакрытьСтрокуОтказом.
//
// Параметры:
//  СтрокаОчереди   - Структура - строка очереди.
//  Счётчики        - Структура - счетчики такта (Ошибок - изменяется).
//  ОжидаемыйСтатус - Строка    - "processing" (по умолчанию) либо "queued".
//
Процедура ЗакрытьСтрокуПропуском(СтрокаОчереди, Счётчики, Знач ОжидаемыйСтатус = "processing")

	СтрокаОчереди.Статус = "skipped";
	СтрокаОчереди.ГотовоВ = ТекущаяДатаСеанса();
	Попытка
		ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, ОжидаемыйСтатус);
	Исключение
		Счётчики.Ошибок = Счётчики.Ошибок + 1;
	КонецПопытки;

КонецПроцедуры

// Закрытие строки готовностью: текст записан в кэш файла - статус done,
// ar_ГотовоВ (спека agentrunner-74 п.Б.7). Запись под проверкой статуса
// processing: строку не успел изменить другой процесс.
Процедура ЗакрытьСтрокуГотово(СтрокаОчереди, Счётчики)

	СтрокаОчереди.Статус = "done";
	СтрокаОчереди.ГотовоВ = ТекущаяДатаСеанса();
	Попытка
		Если ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, "processing") Тогда
			Счётчики.Готово = Счётчики.Готово + 1;
		КонецЕсли;
	Исключение
		Счётчики.Ошибок = Счётчики.Ошибок + 1;
	КонецПопытки;

КонецПроцедуры

// Повторяемая ошибка (спека agentrunner-74 п.Б.9): строка возвращается в
// queued, счетчик попыток увеличивается; после 3 попыток - отказ, причем
// для известного файла это окончательный отказ RAGU и кэш добирает запасной
// S.Docster (agentrunner-100 п.3; при Свойства = Неопределено - отказ без
// S.Docster, как в путях вне цепочки RAGU). Идентификатор задания
// сбрасывается: при переотправке RAGU выдаст новое задание. Запись под
// проверкой статуса processing (CAS-каскад, agentrunner-111): конкурент не
// перетер чужой итог (например, возврат в queued поверх уже закрытого done).
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (в статусе processing).
//  ТекстОшибки   - Строка    - текст ошибки (в ar_ПоследняяОшибка).
//  Счётчики      - Структура - счетчики такта (Ошибок - изменяется).
//  Свойства      - Структура, Неопределено - свойства файла; при заданных -
//                  исчерпание попыток ведет к запасному S.Docster.
//
Процедура ВернутьСтрокуВОчередь(СтрокаОчереди, Знач ТекстОшибки, Счётчики, Знач Свойства = Неопределено)

	СтрокаОчереди.Статус = "queued";
	СтрокаОчереди.ИдЗадания = "";
	СтрокаОчереди.ОтправленоВ = '00010101';
	СтрокаОчереди.Попыток = СтрокаОчереди.Попыток + 1;
	СтрокаОчереди.ПоследняяОшибка = ТекстОшибки;
	Если СтрокаОчереди.Попыток >= ПорогПопытокОчереди() Тогда
		Если Свойства <> Неопределено Тогда
			Счётчики.Ошибок = Счётчики.Ошибок + 1;
			ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, ТекстОшибки, Свойства, Счётчики);
			Возврат;
		КонецЕсли;
		СтрокаОчереди.Статус = "failed";
	КонецЕсли;
	Попытка
		ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, "processing");
	Исключение
		Счётчики.Ошибок = Счётчики.Ошибок + 1;
	КонецПопытки;
	Счётчики.Ошибок = Счётчики.Ошибок + 1;

КонецПроцедуры

// Откат строки при отказе авторизации RAGU (401, спека agentrunner-74
// п.Б.9): строка возвращается в исходный queued без изменений счётчиков -
// «строки очереди не изменены» по итогу такта.
Процедура ВернутьСтрокуВОчередьТихо(СтрокаОчереди)

	СтрокаОчереди.Статус = "queued";
	СтрокаОчереди.ОтправленоВ = '00010101';
	Попытка
		ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, "processing");
	Исключение
		// Откат не критичен (такт по 401 прерван); сбой - в лог отладкой.
		ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_prefetch_rollback",
			ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Отладка");
	КонецПопытки;

КонецПроцедуры

// Префикс причины отказа RAGU в ar_ПоследняяОшибка (спека agentrunner-100
// п.1): им помечаются строки, ожидающие запасного S.Docster, и строки,
// получившие текст от S.Docster; по префиксу и пустому заданию строки
// отбираются к запасному распознаванию (СтрокиОжиданияЗапасногоРаспознавания).
//
// Возвращаемое значение:
//  Строка - префикс причины (значение из внешнего контракта лога).
//
Функция ПрефиксПричиныRAGU()

	Возврат "RAGU: ";

КонецФункции

// Настроен ли запасной сервис S.Docster: заполнена и включена настройка
// адреса (ключ не обязателен - спека agentrunner-100 п.3).
//
// Возвращаемое значение:
//  Булево.
//
Функция СервисSDocsterНастроен()

	Возврат Не ПустаяСтрока(СокрЛП(ar_Настройки.ЗначениеНастройки("SDocsterАдресСервиса", "")));

КонецФункции

// Обработка queued-строк при ненастроенном RAGU (agentrunner-100 п.3: RAGU
// не настроен, S.Docster настроен - такт не выходит молча): платформа и
// S.Docster по queued-строкам в пределах лимитов такта, в строке остается
// причина «RAGU: не настроен». Обращений к RAGU нет.
//
// Параметры:
//  Счётчики - Структура - счетчики такта (Готово, Ошибок, SDocster - изменяются).
//
Процедура ОбработатьОчередьБезRAGU(Счётчики)

	СтрокиОчереди = ar_ОчередьРаспознавания.СтрокиПоСтатусу("queued", ЛимитОтправкиЗаТакт());
	Если СтрокиОчереди.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СвойстваФайлов = СвойстваФайловПартии(СтрокиОчереди);
	ПричинаОтказаRAGU = НСтр("ru = 'не настроен'");

	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл
		ОбработатьСтрокуОчередиБезRAGU(СтрокаОчереди, СвойстваФайлов, ПричинаОтказаRAGU, Счётчики);
	КонецЦикла;

КонецПроцедуры

// Одна queued-строка при ненастроенном RAGU: пропуск по кэшу, переход
// queued -> processing, платформа для офисных форматов, запасной S.Docster
// с причиной «RAGU: не настроен» либо отказ для формата вне списков.
//
// Параметры:
//  СтрокаОчереди     - Структура - строка очереди.
//  СвойстваФайлов    - Соответствие - свойства партии (одним запросом).
//  ПричинаОтказаRAGU - Строка - причина «не настроен» (без префикса).
//  Счётчики          - Структура - счетчики такта (изменяются).
//
Процедура ОбработатьСтрокуОчередиБезRAGU(СтрокаОчереди, Знач СвойстваФайлов, Знач ПричинаОтказаRAGU, Счётчики)

	ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
	Свойства = СвойстваФайлов.Получить(ФайлСсылка);
	Если Свойства = Неопределено Тогда
		// Строка еще queued (CAS будет позже) - ожидаемый статус queued.
		ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Файл не найден в информационной базе'"),
			Счётчики, "queued");
		Возврат;
	КонецЕсли;

	// Кэш с непустым текстом - skipped, как в ОтправитьОчередьRAGU
	// (agentrunner-100 п.4).
	Если КэшСНепустымТекстом(Свойства.СтатусИзвлеченияТекста, Свойства.ТекстХранилище) Тогда
		ЗакрытьСтрокуПропуском(СтрокаОчереди, Счётчики, "queued");
		Возврат;
	КонецЕсли;

	// Блокирующий переход queued -> processing (спека agentrunner-74 п.Б.6).
	СтрокаОчереди.Статус = "processing";
	СтрокаОчереди.ОтправленоВ = ТекущаяДатаСеанса();
	Если Не ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди, "queued") Тогда
		Возврат;
	КонецЕсли;

	// Офисные форматы - сначала платформа (agentrunner-100 п.2).
	Если РасширениеПоддерживаетсяПлатформой(НРег(СокрЛП(СтрокаОчереди.Расширение))) Тогда
		Если ИзвлечьСтрокуПлатформой(СтрокаОчереди, Свойства, ФайлСсылка, Счётчики) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если РасширениеПоддерживаетсяСервисом(НРег(СокрЛП(СтрокаОчереди.Расширение))) Тогда
		ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, ПричинаОтказаRAGU, Свойства, Счётчики);
	Иначе
		// Формат вне списков (защита от строк прошлых версий списка):
		// платформа была единственным источником.
		ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Платформа не извлекла текст'"), Счётчики);
	КонецЕсли;

КонецПроцедуры

// Извлечение текста строки очереди платформой (agentrunner-100 п.2): офисные
// форматы до отправки в RAGU. Непустой текст - сверка отпечатка, запись в
// кэш, done (ar_Сервис = "platform", RAGU не вызывается). Для doc платформа
// - единственный источник: пустой текст - отказ строки. xls/xlsx/docx при
// пустом тексте остаются для сервисов (возврат Ложь).
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (в статусе processing).
//  Свойства      - Структура - свойства файла (отпечаток, занятость).
//  ФайлСсылка    - ЛюбаяСсылка - файл строки очереди.
//  Счётчики      - Структура - счетчики такта (Ошибок - изменяется).
//
// Возвращаемое значение:
//  Булево - Истина - строка закрыта платформой либо сброшена по отпечатку;
//           Ложь - платформа не дала текста, расширение идет дальше (RAGU).
//
Функция ИзвлечьСтрокуПлатформой(СтрокаОчереди, Знач Свойства, Знач ФайлСсылка, Счётчики)

	ДвоичныеДанные = Неопределено;
	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка, Ложь);
	Исключение
		ДвоичныеДанные = Неопределено;
	КонецПопытки;

	Текст = "";
	Если ДвоичныеДанные <> Неопределено Тогда
		Текст = ИзвлечьТекстПлатформой(ДвоичныеДанные, СтрокаОчереди.Расширение);
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Если НРег(СокрЛП(СтрокаОчереди.Расширение)) = "doc" Тогда
			ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Платформа не извлекла текст'"), Счётчики);
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь; // xls/xlsx/docx - дальше RAGU, как сейчас (спека п.2)
	КонецЕсли;

	// Сверка отпечатка перед записью кэша (образец - ЗаписатьГотовыеТекстыВКэш):
	// перезагруженный во время работы файл отбрасывает результат.
	Если Свойства.ДатаМодификации <> СтрокаОчереди.ДатаМодификации
		Или Свойства.Размер <> СтрокаОчереди.Размер Тогда
		СброситьСтрокуПоОтпечатку(СтрокаОчереди, Свойства, Счётчики);
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Свойства.Редактирует) Тогда
		// Файл занят: извлечение платформы быстрое - повтор на следующем такте
		// (вне цепочки RAGU запасной сервис не вызывается).
		ВернутьСтрокуВОчередь(СтрокаОчереди, НСтр("ru = 'Файл занят для редактирования'"), Счётчики);
		Возврат Истина;
	КонецЕсли;

	ТекстОшибкиЗаписи = "";
	Если Не ЗаписатьТекстФайла(ФайлСсылка, Текст, ТекстОшибкиЗаписи) Тогда
		// Ошибка записи - не отказ извлечения: повтор на следующем такте.
		ВернутьСтрокуВОчередь(СтрокаОчереди, ТекстОшибкиЗаписи, Счётчики);
		Возврат Истина;
	КонецЕсли;

	// done: в строке видно, что текст дала платформа (спека agentrunner-100 п.1).
	СтрокаОчереди.Сервис = "platform";
	СтрокаОчереди.ПоследняяОшибка = "";
	ЗакрытьСтрокуГотово(СтрокаОчереди, Счётчики);
	Возврат Истина;

КонецФункции

// Закрытие строки после окончательного отказа RAGU (спека agentrunner-100
// п.3): кэш добирает запасной S.Docster - в пределах лимита вызовов такта;
// сверх лимита строка остается processing без задания с причиной отказа
// RAGU (ожидает S.Docster, добирается следующим тактом). Не вызывается на
// 401 RAGU (ошибка настройки) и пока задание RAGU живо (processing).
//
// Параметры:
//  СтрокаОчереди     - Структура - строка очереди.
//  ПричинаОтказаRAGU - Строка    - причина отказа RAGU (без префикса).
//  Свойства          - Структура - свойства файла (наименование, размер,
//                      отпечаток, занятость).
//  Счётчики          - Структура - счетчики такта (Ошибок, SDocster - изменяются).
//
Процедура ЗакрытьСтрокуОтказомRAGU(СтрокаОчереди, Знач ПричинаОтказаRAGU, Знач Свойства, Счётчики)

	ПричинаРагу = ПрефиксПричиныRAGU() + ПричинаОтказаRAGU;

	Если Не СервисSDocsterНастроен() Тогда
		// Запасного сервиса нет - окончательный отказ с обеими причинами
		// (спека agentrunner-100 п.5: единый вид причин с префиксами).
		ЗакрытьСтрокуОтказом(СтрокаОчереди,
			СтрШаблон(НСтр("ru = '%1; S.Docster: сервис не настроен'"), ПричинаРагу), Счётчики);
		Возврат;
	КонецЕсли;

	Если Счётчики.SDocster >= ЛимитSDocsterЗаТакт() Тогда
		// Лимит вызовов S.Docster исчерпан: строка остается processing без
		// задания, причина RAGU - в ar_ПоследняяОшибка; статус failed
		// ставится только после S.Docster (спека agentrunner-100 п.3).
		СтрокаОчереди.Статус = "processing";
		СтрокаОчереди.ИдЗадания = "";
		СтрокаОчереди.ОтправленоВ = '00010101';
		СтрокаОчереди.ПоследняяОшибка = ПричинаРагу;
		Попытка
			ar_ОчередьРаспознавания.ЗаписатьСтроку(СтрокаОчереди);
		Исключение
			Счётчики.Ошибок = Счётчики.Ошибок + 1;
		КонецПопытки;
		Возврат;
	КонецЕсли;

	РаспознатьСтрокуЗапаснымСервисом(СтрокаОчереди, ПричинаРагу, Свойства, Счётчики);

КонецПроцедуры

// Запасное распознавание строки сервисом S.Docster (спека agentrunner-100
// п.3): вызов РаспознатьТекстSDocster (настройки и замер - как в
// files_get_text, RunId пустой - такт вне запуска агента), затем сверка
// отпечатка (образец - ЗаписатьГотовыеТекстыВКэш) и запись кэша. Непустой
// текст - done (ar_Сервис = "sdocster", причина отказа RAGU остается в
// ar_ПоследняяОшибка); пустой текст или ошибка - failed с обеими причинами.
// Вызову предшествует проверка лимита (Счётчики.SDocster, спека п.3).
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди (в статусе processing).
//  ПричинаРагу   - Строка    - причина отказа RAGU с префиксом
//                  ПрефиксПричиныRAGU() (в ar_ПоследняяОшибка и замере).
//  Свойства      - Структура - свойства файла (наименование, размер,
//                  отпечаток, занятость).
//  Счётчики      - Структура - счетчики такта (Готово, Ошибок, SDocster - изменяются).
//
Процедура РаспознатьСтрокуЗапаснымСервисом(СтрокаОчереди, Знач ПричинаРагу, Знач Свойства, Счётчики)

	Счётчики.SDocster = Счётчики.SDocster + 1;

	ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
	ДвоичныеДанные = Неопределено;
	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка, Ложь);
	Исключение
		ДвоичныеДанные = Неопределено;
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		ЗакрытьСтрокуОтказом(СтрокаОчереди,
			СтрШаблон(НСтр("ru = '%1; S.Docster: данные файла не найдены'"), ПричинаРагу), Счётчики);
		Возврат;
	КонецЕсли;

	НастройкиИзвлечения = НастройкиИзвлеченияТекста();
	ТекстОшибкиСДокстер = "";
	Текст = РаспознатьТекстSDocster(ДвоичныеДанные, Свойства.Наименование, СтрокаОчереди.Расширение,
		НастройкиИзвлечения.ТаймаутСДокстер, Свойства.Размер, "", ФайлСсылка,
		ТекстОшибкиСДокстер, ПричинаРагу);

	Если Не ПустаяСтрока(ТекстОшибкиСДокстер) Или ПустаяСтрока(СокрЛП(Текст)) Тогда
		// Оба сервиса не дали текст - failed с обеими причинами (спека п.3).
		ПричинаСДокстер = ?(ПустаяСтрока(ТекстОшибкиСДокстер),
			НСтр("ru = 'Текст не извлечён'"), ТекстОшибкиСДокстер);
		ЗакрытьСтрокуОтказом(СтрокаОчереди,
			СтрШаблон(НСтр("ru = '%1; S.Docster: %2'"), ПричинаРагу, ПричинаСДокстер), Счётчики);
		Возврат;
	КонецЕсли;

	// Файл занят - возврат в queued, повтор на следующем такте (после порога
	// попыток - отказ, запасной сервис не вызывается).
	Если ЗначениеЗаполнено(Свойства.Редактирует) Тогда
		ВернутьСтрокуВОчередь(СтрокаОчереди, ПричинаРагу, Счётчики);
		Возврат;
	КонецЕсли;

	// Сверка отпечатка перед записью кэша: перезагруженный во время
	// распознавания файл отбрасывает результат (образец - ЗаписатьГотовыеТекстыВКэш).
	Если Свойства.ДатаМодификации <> СтрокаОчереди.ДатаМодификации
		Или Свойства.Размер <> СтрокаОчереди.Размер Тогда
		СброситьСтрокуПоОтпечатку(СтрокаОчереди, Свойства, Счётчики);
		Возврат;
	КонецЕсли;

	ТекстОшибкиЗаписи = "";
	Если Не ЗаписатьТекстФайла(ФайлСсылка, Текст, ТекстОшибкиЗаписи) Тогда
		// Ошибка записи - не отказ распознавания, но текст сохранился только
		// в ответе сервиса: строка закрывается отказом с обеими причинами.
		ЗакрытьСтрокуОтказом(СтрокаОчереди,
			СтрШаблон(НСтр("ru = '%1; S.Docster: %2'"), ПричинаРагу, ТекстОшибкиЗаписи), Счётчики);
		Возврат;
	КонецЕсли;

	// done: в строке видно, кто дал текст и почему отказал RAGU (спека п.1).
	СтрокаОчереди.Сервис = "sdocster";
	СтрокаОчереди.ПоследняяОшибка = ПричинаРагу;
	ЗакрытьСтрокуГотово(СтрокаОчереди, Счётчики);

КонецПроцедуры

// Добор строк, ожидающих запасного S.Docster (agentrunner-100 п.3): строки
// processing без задания RAGU с причиной отказа RAGU, не добравшиеся до
// S.Docster из-за лимита своих тактов. Свежие свойства партии читаются одним
// запросом; строки обрабатываются в пределах оставшегося лимита такта.
//
// Параметры:
//  Счётчики - Структура - счетчики такта (Готово, Ошибок, SDocster - изменяются).
//
Процедура ДостроитьСтрокиСДокстер(Счётчики)

	ОстатокЛимита = ЛимитSDocsterЗаТакт() - Счётчики.SDocster;
	Если ОстатокЛимита <= 0 Или Не СервисSDocsterНастроен() Тогда
		Возврат;
	КонецЕсли;

	СтрокиОчереди = ar_ОчередьРаспознавания.СтрокиОжиданияЗапасногоРаспознавания(ОстатокЛимита);
	Если СтрокиОчереди.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СвойстваФайлов = СвойстваФайловПартии(СтрокиОчереди);

	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл

		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
		Свойства = СвойстваФайлов.Получить(ФайлСсылка);
		Если Свойства = Неопределено Тогда
			ЗакрытьСтрокуОтказом(СтрокаОчереди, НСтр("ru = 'Файл не найден в информационной базе'"), Счётчики);
			Продолжить;
		КонецЕсли;

		// Кэш с непустым текстом уже появился - skipped (agentrunner-100 п.4).
		Если КэшСНепустымТекстом(Свойства.СтатусИзвлеченияТекста, Свойства.ТекстХранилище) Тогда
			ЗакрытьСтрокуПропуском(СтрокаОчереди, Счётчики);
			Продолжить;
		КонецЕсли;

		// Причина отказа RAGU уже с префиксом - читается из строки очереди.
		РаспознатьСтрокуЗапаснымСервисом(СтрокаОчереди, СтрокаОчереди.ПоследняяОшибка, Свойства, Счётчики);

	КонецЦикла;

КонецПроцедуры

// Свойства файлов партии строк очереди одним запросом (общая функция пакета
// СвойстваФайловПоСсылкам, без копий): имя файла - для замера, статус
// извлечения и занятость - для решения по записи, отпечаток - для сверки.
//
// Параметры:
//  СтрокиОчереди - Массив из Структура - строки очереди (Файл - навигационная
//                  ссылка).
//
// Возвращаемое значение:
//  Соответствие - ссылка файла -> структура свойств (см. СвойстваФайловПоСсылкам).
//
Функция СвойстваФайловПартии(Знач СтрокиОчереди)

	Свойства = Новый Соответствие;
	Ссылки = Новый Массив;
	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл
		ФайлСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл);
		Если ФайлСсылка <> Неопределено Тогда
			Ссылки.Добавить(ФайлСсылка);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Свойства;
	КонецЕсли;
	Возврат СвойстваФайловПоСсылкам(Ссылки);

КонецФункции

// Подключение к RAGU для асинхронных вызовов, таймаут соединения 60 с
// (спека agentrunner-74 п.Б.6). Своё HTTPСоединение - ar_HTTP.ВыполнитьPOST
// принимает тело только строкой и пропускает адреса только из списка
// разрешённых LLM-адресов (фактура 4 задачи agentrunner-21).
//
// Параметры:
//  АдресСервиса - Строка - базовый адрес RAGU (настройка RAGUАдресСервиса).
//  ТекстОшибки  - Строка - текст ошибки при неверном адресе (выходной).
//
// Возвращаемое значение:
//  Структура - {Соединение - HTTPСоединение; ПутьБазы - Строка - путь
//  базового адреса из СтруктураURI}; Неопределено - адрес заполнен неверно.
//
Функция ПодключениеRAGU(Знач АдресСервиса, ТекстОшибки)

	ТекстОшибки = "";
	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса);
	Если ПустаяСтрока(СтруктураАдреса.Хост) Тогда
		ТекстОшибки = НСтр("ru = 'RAGU: настройка RAGUАдресСервиса заполнена неверно: не найдено имя сервера'");
		Возврат Неопределено;
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если НРег(СтруктураАдреса.Схема) = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Подключение = Новый Структура;
	Подключение.Вставить("Соединение", Новый HTTPСоединение(СтруктураАдреса.Хост,
		?(ЗначениеЗаполнено(СтруктураАдреса.Порт), СтруктураАдреса.Порт, Неопределено), , , ,
		ТаймаутСоединенияRAGU(), ЗащищенноеСоединение));
	Подключение.Вставить("ПутьБазы", СтруктураАдреса.ПутьНаСервере);
	Возврат Подключение;

КонецФункции

// Обращение к RAGU - общая точка для submit/poll/text: авторизация Bearer,
// тело - при наличии, кодировка ответа UTF-8 (спека agentrunner-73 п.3).
// Ошибка соединения - ТекстОшибки с очищенным текстом, КодОтвета = 0.
//
// Параметры:
//  Подключение  - Структура - {Соединение, ПутьБазы}.
//  Токен        - Строка - токен RAGU.
//  Метод        - Строка - "GET" или "POST".
//  АдресРесурса - Строка - путь ресурса от базового адреса.
//  Заголовки    - Соответствие - заголовки запроса (Content-Type и т.п.).
//  ТелоЗапроса  - ДвоичныеДанные, Неопределено - тело POST-запроса.
//
// Возвращаемое значение:
//  Структура - {КодОтвета - Число (0 - ошибка соединения); Тело - Строка;
//  ТекстОшибки - Строка ("" при получении ответа); ДлительностьМс - Число}.
//
Функция ВызватьHTTPRAGU(Знач Подключение, Знач Токен, Знач Метод, Знач АдресРесурса,
	Знач Заголовки, Знач ТелоЗапроса)

	Результат = Новый Структура;
	Результат.Вставить("КодОтвета", 0);
	Результат.Вставить("Тело", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ДлительностьМс", 0);

	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	Если ТелоЗапроса <> Неопределено Тогда
		Запрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
	КонецЕсли;

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Ответ = Подключение.Соединение.ВызватьHTTPМетод(Метод, Запрос);
		Результат.КодОтвета = Ответ.КодСостояния;
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Результат.ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			НСтр("ru = 'RAGU: ошибка соединения: '")
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
	Возврат Результат;

КонецФункции

// POST /api/v1/parse/jobs - постановка файла в асинхронное распознавание
// (спека agentrunner-74 п.Б.6): multipart с полем file (общая сборка пакета
// ТелоСоставногоЗапросаФайла), ответ 200/201/202 - JSON {id, status, filename}
// (факт стенда 2026-10-13: живой сервис отвечает 202 Accepted); прочие коды -
// ошибка, текст из поля error тела.
//
// Параметры:
//  Подключение    - Структура - {Соединение, ПутьБазы}.
//  Токен          - Строка - токен RAGU.
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Наименование   - Строка - имя файла (без расширения) для filename.
//  Расширение     - Строка - расширение файла (нижний регистр, без точки).
//
// Возвращаемое значение:
//  Структура - {КодОтвета - Число; ИдЗадания - Строка; ТекстОшибки - Строка
//  ("" при успехе); ДлительностьМс - Число}.
//
Функция ОтправитьЗаданиеRAGU(Знач Подключение, Знач Токен, Знач ДвоичныеДанные,
	Знач Наименование, Знач Расширение)

	Граница = СтрЗаменить(ar_Утилиты.НовыйUUID(), "-", "");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Тело = ТелоСоставногоЗапросаФайла(ДвоичныеДанные, Наименование, Расширение, Граница);

	Ответ = ВызватьHTTPRAGU(Подключение, Токен, "POST",
		ПутьБазовогоАдреса(Подключение.ПутьБазы) + "api/v1/parse/jobs", Заголовки, Тело);

	Результат = Новый Структура("КодОтвета, ИдЗадания, ТекстОшибки, ДлительностьМс",
		Ответ.КодОтвета, "", Ответ.ТекстОшибки, Ответ.ДлительностьМс);
	Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
		Возврат Результат; // ошибка соединения
	КонецЕсли;

	Если Ответ.КодОтвета = 200 Или Ответ.КодОтвета = 201 Или Ответ.КодОтвета = 202 Тогда
		Результат.ИдЗадания = ИдЗаданияИзОтветаRAGU(Ответ.Тело);
		Если ПустаяСтрока(Результат.ИдЗадания) Тогда
			// Задание могло создаться, но опрашивать не по чему - повтор.
			Результат.ТекстОшибки = НСтр("ru = 'В ответе RAGU нет идентификатора задания'");
		КонецЕсли;
	Иначе
		Результат.ТекстОшибки = ТекстОшибкиОтветаRAGU(Ответ.КодОтвета, Ответ.Тело);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// GET /api/v1/parse/jobs/<id> - статус задания (спека agentrunner-74 п.Б.7):
// 200 - статус из поля status тела (processing/completed/failed); 404 -
// задание не найдено или истекло (повтор); прочие коды - ошибка.
//
// Параметры:
//  Подключение - Структура - {Соединение, ПутьБазы}.
//  Токен       - Строка - токен RAGU.
//  ИдЗадания   - Строка - идентификатор задания RAGU.
//
// Возвращаемое значение:
//  Структура - {КодОтвета - Число; СтатусЗадания - Строка; ТекстОшибки -
//  Строка ("" при 200); ТекстОшибкиЗадания - Строка (поле error при
//  status=failed); ДлительностьМс - Число}.
//
Функция СтатусЗаданияRAGU(Знач Подключение, Знач Токен, Знач ИдЗадания)

	Ответ = ВызватьHTTPRAGU(Подключение, Токен, "GET",
		ПутьБазовогоАдреса(Подключение.ПутьБазы) + "api/v1/parse/jobs/" + ИдЗадания,
		Новый Соответствие, Неопределено);

	Результат = Новый Структура(
		"КодОтвета, СтатусЗадания, ТекстОшибки, ТекстОшибкиЗадания, ДлительностьМс",
		Ответ.КодОтвета, "", "", "", Ответ.ДлительностьМс);
	Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Если Ответ.КодОтвета = 404 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Задание RAGU не найдено или результат истёк'");
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодОтвета <> 200 Тогда
		Результат.ТекстОшибки = ТекстОшибкиОтветаRAGU(Ответ.КодОтвета, Ответ.Тело);
		Возврат Результат;
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(Ответ.Тело);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'RAGU вернул не JSON-ответ'");
		Возврат Результат;
	КонецЕсли;

	СтатусЗадания = Разобрано.Получить("status");
	Если ТипЗнч(СтатусЗадания) <> Тип("Строка") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В ответе RAGU нет статуса задания (status)'");
		Возврат Результат;
	КонецЕсли;
	Результат.СтатусЗадания = СтатусЗадания;

	ТекстОшибкиЗадания = Разобрано.Получить("error");
	Если ТипЗнч(ТекстОшибкиЗадания) = Тип("Строка") Тогда
		Результат.ТекстОшибкиЗадания = ТекстОшибкиЗадания;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// GET /api/v1/parse/jobs/<id>/text - текст задания (спека agentrunner-74
// п.Б.7): 200 - текст в теле; 409 - текст ещё не готов; 404 - истёк (повтор);
// прочие коды - ошибка.
//
// Параметры:
//  Подключение - Структура - {Соединение, ПутьБазы}.
//  Токен       - Строка - токен RAGU.
//  ИдЗадания   - Строка - идентификатор задания RAGU.
//
// Возвращаемое значение:
//  Структура - {КодОтвета - Число; Текст - Строка; ТекстОшибки - Строка
//  ("" при 200 и 409); ДлительностьМс - Число}.
//
Функция ТекстЗаданияRAGU(Знач Подключение, Знач Токен, Знач ИдЗадания)

	Ответ = ВызватьHTTPRAGU(Подключение, Токен, "GET",
		ПутьБазовогоАдреса(Подключение.ПутьБазы) + "api/v1/parse/jobs/" + ИдЗадания + "/text",
		Новый Соответствие, Неопределено);

	Результат = Новый Структура("КодОтвета, Текст, ТекстОшибки, ДлительностьМс",
		Ответ.КодОтвета, "", "", Ответ.ДлительностьМс);
	Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Если Ответ.КодОтвета = 409 Тогда
		Возврат Результат; // не готов - не ошибка, ждать следующего такта
	КонецЕсли;
	Если Ответ.КодОтвета = 404 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Задание RAGU не найдено или результат истёк'");
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодОтвета <> 200 Тогда
		Результат.ТекстОшибки = ТекстОшибкиОтветаRAGU(Ответ.КодОтвета, Ответ.Тело);
		Возврат Результат;
	КонецЕсли;

	Результат.Текст = Ответ.Тело;
	Возврат Результат;

КонецФункции

// Текст ошибки ответа RAGU: поле error тела (если есть) либо сам код
// состояния; текст очищается для лога (токен в лог не попадает). Поле
// ar_ПоследняяОшибка очереди - то же значение (спека agentrunner-74 п.Б.9).
//
// Параметры:
//  КодОтвета - Число  - код состояния ответа.
//  Тело      - Строка - тело ответа.
//
// Возвращаемое значение:
//  Строка - текст ошибки.
//
Функция ТекстОшибкиОтветаRAGU(Знач КодОтвета, Знач Тело)

	ТекстСервиса = ОшибкаИзОтветаRAGU(Тело);
	Если ПустаяСтрока(ТекстСервиса) Тогда
		Возврат СтрШаблон(НСтр("ru = 'RAGU вернул код состояния %1'"),
			Формат(КодОтвета, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат ar_Утилиты.ОчиститьОшибкуДляLLM(СтрШаблон(
		НСтр("ru = 'RAGU вернул код состояния %1: %2'"),
		Формат(КодОтвета, "ЧН=0; ЧГ=0"), ТекстСервиса));

КонецФункции

// Запись замера обращения к RAGU в асинхронном режиме - событие ocr_job в
// формате ocr_request: пары «ключ=значение» через "; " (спека agentrunner-74
// п.Б.11). RunId пустой (такт вне запуска агента), объект - файл строки.
// Итоги при done: total_ms - от ar_ОтправленоВ, attempts - попытки строки,
// result - done; при сбросе по отпечатку - result=file_changed. Токен в лог
// не попадает (текст ошибок маскируется).
//
// Параметры:
//  Этап           - Строка - stage: submit / poll / text.
//  СтрокаОчереди  - Структура - строка очереди (Расширение, Размер, ИдЗадания).
//  Наименование   - Строка - имя файла (без расширения) для пары file.
//  КодОтвета      - Число - код ответа RAGU (0 - ошибка соединения).
//  ДлительностьМс - Число - длительность обращения, мс.
//  ИдЗадания      - Строка - id задания для пары job_id ("" - из строки).
//  Результат      - Строка - пара result (done, file_changed; "" - не писать).
//  ИтогоМс        - Число - total_ms при done; -1 - не писать.
//  Попыток        - Число - attempts при done; -1 - не писать.
//
Процедура ЗаписатьЗамерЗаданияРаспознавания(Знач Этап, Знач СтрокаОчереди, Знач Наименование,
	Знач КодОтвета, Знач ДлительностьМс, Знач ИдЗадания, Знач Результат = "",
	Знач ИтогоМс = -1, Знач Попыток = -1)

	ИдЗаписи = ?(ПустаяСтрока(ИдЗадания), СтрокаОчереди.ИдЗадания, ИдЗадания);

	Части = Новый Массив;
	Части.Добавить("service=ragu");
	Части.Добавить("mode=async");
	Части.Добавить("stage=" + Этап);
	Части.Добавить("file=" + Наименование);
	Части.Добавить("ext=" + СтрокаОчереди.Расширение);
	// "ЧН=0" обязателен: Формат(0, "ЧГ=0") возвращает пустую строку.
	Части.Добавить("size=" + Формат(СтрокаОчереди.Размер, "ЧН=0; ЧГ=0"));
	Если Не ПустаяСтрока(ИдЗаписи) Тогда
		Части.Добавить("job_id=" + ИдЗаписи);
	КонецЕсли;
	Части.Добавить("code=" + Формат(КодОтвета, "ЧН=0; ЧГ=0"));
	Части.Добавить("ms=" + Формат(ДлительностьМс, "ЧН=0; ЧГ=0"));
	Если ИтогоМс >= 0 Тогда
		Части.Добавить("total_ms=" + Формат(ИтогоМс, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Попыток >= 0 Тогда
		Части.Добавить("attempts=" + Формат(Попыток, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Не ПустаяСтрока(Результат) Тогда
		Части.Добавить("result=" + Результат);
	КонецЕсли;

	// Ошибка соединения (код 0) и коды ошибок HTTP - «Предупреждение»,
	// как в ЗаписатьЗамерРаспознавания (спека agentrunner-73 п.6).
	Уровень = ?(КодОтвета = 0 Или КодОтвета >= 400, "Предупреждение", "Информация");
	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_job",
		СтрСоединить(Части, "; "), Уровень, "",
		ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаОчереди.Файл));

КонецПроцедуры

// Итог такта - одна запись ocr_prefetch_tick (спека agentrunner-74 п.Б.11):
// найдено / поставлено / отправлено / готово / ошибок / вызовов S.Docster,
// длительность такта; в параллельном режиме (agentrunner-111 п.3) -
// дополнительно workers (активные воркеры) и started (достартованы тактом).
//
// Параметры:
//  Счётчики       - Структура - счётчики такта (ВыполнитьТактПредварительного
//                   Распознавания).
//  ДлительностьМс - Число - длительность такта, мс.
//  Воркеры        - Структура, Неопределено - {Активные, Достартовано} в
//                   параллельном режиме; Неопределено - пары не добавляются.
//
Процедура ЗаписатьЗамерТакта(Знач Счётчики, Знач ДлительностьМс, Знач Воркеры = Неопределено)

	Части = Новый Массив;
	Части.Добавить("found=" + Формат(Счётчики.Найдено, "ЧН=0; ЧГ=0"));
	Части.Добавить("enqueued=" + Формат(Счётчики.Поставлено, "ЧН=0; ЧГ=0"));
	Части.Добавить("submitted=" + Формат(Счётчики.Отправлено, "ЧН=0; ЧГ=0"));
	Части.Добавить("done=" + Формат(Счётчики.Готово, "ЧН=0; ЧГ=0"));
	Части.Добавить("errors=" + Формат(Счётчики.Ошибок, "ЧН=0; ЧГ=0"));
	Части.Добавить("sdocster=" + Формат(Счётчики.SDocster, "ЧН=0; ЧГ=0"));
	Если Воркеры <> Неопределено Тогда
		Части.Добавить("workers=" + Формат(Воркеры.Активные, "ЧН=0; ЧГ=0"));
		Части.Добавить("started=" + Формат(Воркеры.Достартовано, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Части.Добавить("ms=" + Формат(ДлительностьМс, "ЧН=0; ЧГ=0"));
	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_prefetch_tick",
		СтрСоединить(Части, "; "));

КонецПроцедуры

// Лог отказа авторизации RAGU (спека agentrunner-74 п.Б.9): код 401 -
// ошибка конфигурации (токен); такт прерывается, строки очереди не трогаются.
Процедура ЗаписатьЛогНеразрешённыйТокен()

	ar_СлужебныйЛог.Записать("ar_ПакетПрисоединённыеФайлы", "ocr_prefetch_unauthorized",
		НСтр("ru = 'RAGU отклонил токен (код 401): такт прерван, строки очереди не изменены'"),
		"Ошибка");

КонецПроцедуры

// Токен RAGU из настроек пакета (кэш сеанса ar_Настройки).
Функция ТокенRAGU()

	Возврат СокрЛП(ar_Настройки.ЗначениеНастройки("RAGUТокен", ""));

КонецФункции

// Лимиты и пороги такта - константы в коде пакета (спека agentrunner-74
// п.Б.5-п.Б.9); вынесены функциями для единой точки изменения и тестов.
Функция ЛимитПостановкиЗаТакт()
	// Новых строк очереди за такт (спека п.Б.5).
	Возврат 20;
