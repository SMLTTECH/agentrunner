////////////////////////////////////////////////////////////////////////////////
// Форма ИсправлениеЗаявки пакета ar_ПакетНСИ (agentrunner-89, спека п. 4-6).
//
// Открывается из любого диалога с заявкой НСИ («Перейти к предмету», с 2.4.3)
// с параметром Заявка: возврат на исправление доступен - режим правки, иначе
// только для чтения с причиной; документ заявки - командой «Документ заявки».
// Замечания последнего возврата, пояснение (сообщения инициатора в диалоге),
// вложения заявки; «Исправить реквизиты» открывает форму контрагента с
// моделью «стало» (повторно - с уже исправленной моделью), «Отправить на
// проверку» вызывает ОтправитьНаПроверку модуля объекта пакета. Правки
// реквизитов до отправки живут только в форме: в заявку они пишутся при
// отправке, в справочник - решением агента после проверки.
//
// Вся прикладная логика - в модуле объекта пакета; форма только собирает
// параметры и показывает результат (реквизиты - буфер серверных вызовов).
////////////////////////////////////////////////////////////////////////////////

#Область ПеременныеФормы

// Закрытие без вопроса о неотправленных исправлениях (после отправки или
// подтверждения пользователем).
&НаКлиенте
Перем ЗакрытиеПодтверждено;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрЗаявка = Неопределено;
	Параметры.Свойство("Заявка", ПараметрЗаявка);
	Если ТипЗнч(ПараметрЗаявка) <> Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		// Форма используется только из диалога ожидания пакета.
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заявка = ПараметрЗаявка;
	ЗаполнитьДанными();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено = Истина Или НЕ ЕстьНеотправленныеИсправления() Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Исправления заявки не отправлены на проверку.'");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ЗакрытиеБезОтправкиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Исправления не отправлены на проверку и будут потеряны.
			|Закрыть форму без отправки?'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеБезОтправкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗакрытиеПодтверждено = Истина;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИсправитьРеквизитыВыполнение(Команда)

	Если НЕ Доступно Тогда
		Возврат;
	КонецЕсли;

	Подготовка = ОткрытиеРеквизитовНаСервере();
	Если Подготовка.Отказ Тогда
		ПоказатьПредупреждение(, Подготовка.Сообщение);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ИсправлениеРеквизитовЗавершение", ЭтотОбъект);
	ОткрытьФорму(Подготовка.ИмяФормы, Подготовка.ПараметрыФормы, ЭтотОбъект,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ИсправлениеРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	МодельПослеРедактирования = МодельПослеРедактированияНаСервере();
	Если МодельПослеРедактирования <> Неопределено Тогда
		МодельНоваяХранилище = МодельВХранилищеНаСервере(МодельПослеРедактирования);
		МодельИзменена = Истина;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Реквизиты исправлены'"), ,
			НСтр("ru = 'Исправления попадут в заявку после «Отправить на проверку».'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыВыполнение(Команда)

	Если НЕ Доступно Тогда
		Возврат;
	КонецЕсли;

	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.МножественныйВыбор = Истина;
	ДиалогВыбора.Заголовок = НСтр("ru = 'Выберите файлы для прикрепления к заявке'");
	НачатьПомещениеФайлов(Новый ОписаниеОповещения("ПомещениеФайловЗавершение", ЭтотОбъект),
		ДиалогВыбора, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПомещениеФайловЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ошибки = Новый Массив;
	Для Каждого ПереданныйФайл Из ПомещенныеФайлы Цикл
		// В веб-клиенте у ПомещенныйФайл нет поля Размер - размер считает сервер
		// из двоичных данных во временном хранилище.
		Итог = ДобавлениеВложенияНаСервере(ПереданныйФайл.Хранение,
			ПереданныйФайл.Имя);
		Если НЕ Итог.Успех Тогда
			Ошибки.Добавить(Итог.Сообщение);
		КонецЕсли;
	КонецЦикла;

	ОбновитьВложенияНаСервере();

	Если Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВложенияПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НЕ Доступно Тогда
		Возврат;
	КонецЕсли;

	Файлы = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(Файлы) = Тип("СсылкаНаФайл") Тогда
		ОдинФайл = Новый Массив;
		ОдинФайл.Добавить(Файлы);
		Файлы = ОдинФайл;
	КонецЕсли;
	Если ТипЗнч(Файлы) <> Тип("Массив") Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НачатьПомещениеФайлов(Новый ОписаниеОповещения("ПомещениеФайловЗавершение", ЭтотОбъект),
		Файлы, Ложь, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлВыполнение(Команда)

	ТекущиеДанные = Элементы.Вложения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или НЕ Доступно Тогда
		Возврат;
	КонецЕсли;

	Итог = УдалениеВложенияНаСервере(ТекущиеДанные.Файл);
	Если Итог.Успех Тогда
		ОбновитьВложенияНаСервере();
	Иначе
		ПоказатьПредупреждение(, Итог.Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлЗаявкиВыполнение(Команда)

	ТекущиеДанные = Элементы.Вложения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или НЕ ЗначениеЗаполнено(ТекущиеДанные.Файл) Тогда
		Возврат;
	КонецЕсли;

	ДанныеФайла = ДанныеФайлаДляОткрытия(ТекущиеДанные.Файл, УникальныйИдентификатор);
	Если ДанныеФайла = Неопределено Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Файл недоступен для просмотра.'; en = 'The file is not available for viewing.'"));
		Возврат;
	КонецЕсли;
	РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);

КонецПроцедуры

// Данные присоединенного файла для РаботаСФайламиКлиент.ОткрытьФайл (штатное
// открытие БСП): ДанныеФайла - серверная функция РаботаСФайлами, с клиента не
// вызывается. Идентификатор формы - чтобы данные во временном хранилище жили,
// пока открыта форма.
//
// Параметры:
//  Файл               - ОпределяемыйТип.ПрисоединенныйФайл - файл заявки.
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы.
//
// Возвращаемое значение:
//  Структура - см. РаботаСФайлами.ДанныеФайла; Неопределено - файл недоступен.
//
&НаСервереБезКонтекста
Функция ДанныеФайлаДляОткрытия(Знач Файл, Знач ИдентификаторФормы)

	ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанныхФайла.ИдентификаторФормы = ИдентификаторФормы;
	ПараметрыДанныхФайла.ВызыватьИсключение = Ложь;
	Возврат РаботаСФайлами.ДанныеФайла(Файл, ПараметрыДанныхФайла);

КонецФункции

&НаКлиенте
Процедура ОтправитьНаПроверкуВыполнение(Команда)

	Если НЕ Доступно Тогда
		ПоказатьПредупреждение(, Причина);
		Возврат;
	КонецЕсли;

	Итог = ОтправкаНаПроверкуНаСервере();
	Если Итог.Успех Тогда
		ЗакрытиеПодтверждено = Истина;
		Закрыть();
	Иначе
		ПоказатьПредупреждение(, Итог.Сообщение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументЗаявкиВыполнение(Команда)

	ПоказатьЗначение(, Заявка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исправления внесены (реквизиты или пояснение), но не отправлены на проверку.
&НаКлиенте
Функция ЕстьНеотправленныеИсправления()

	Если НЕ Доступно Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МодельИзменена Или СокрЛП(Пояснение) <> СокрЛП(ПояснениеНачальное);

КонецФункции

// Один серверный вызов данных формы при открытии: доступность, шапка,
// замечания, пояснение, вложения, хеш модели. Недоступно - форма только
// для чтения и причина в поле «Статус исправления» (спека п. 5).
&НаСервере
Процедура ЗаполнитьДанными()

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	Данные = ОбъектПакета.ДанныеФормыИсправления(Заявка);

	Доступно    = Данные.Доступно;
	Причина     = ?(Данные.Доступно, НСтр("ru = 'Ожидает исправления'"), Данные.Причина);
	НомерЗаявки = Данные.Номер;
	ДатаЗаявки  = Данные.Дата;
	КонтрагентПредставление = Данные.Контрагент;
	ОперацияПредставление   = Данные.Операция;
	СрокИсправления = Данные.Срок;
	Замечания   = Данные.Замечания;
	Пояснение   = Данные.Пояснение;
	ПояснениеНачальное = Данные.Пояснение;
	ПодсказкаФайлы = Данные.ПодсказкаФайлы;
	ХешОткрытия = Данные.ХешМодели;
	// В веб-клиенте реквизит формы ValueStorage недоступен для записи - хранится
	// адрес временного хранилища (время жизни - форма). В ВХ кладется распакованная
	// модель (Данные.МодельХранилище.Получить()): ОткрытиеРеквизитовНаСервере передает
	// ее дальше как Структуру (контракт ПараметрыОткрытияРеквизитов).
	МодельХранилище = ?(Данные.МодельХранилище = Неопределено, "",
		ПоместитьВоВременноеХранилище(Данные.МодельХранилище.Получить(), УникальныйИдентификатор));
	ИнициаторЗаявки = Данные.Инициатор;
	ЗаполнитьВложения(Данные.Вложения);

	ТолькоПросмотр = НЕ Доступно;
	Если НЕ Доступно Тогда
		ОбщегоНазначения.СообщитьПользователю(Данные.Причина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВложения(ВложенияДанных)

	Вложения.Очистить();
	Для Каждого Вложение Из ВложенияДанных Цикл
		СтрокаВложений = Вложения.Добавить();
		СтрокаВложений.Файл     = Вложение.Файл;
		СтрокаВложений.Имя      = Вложение.Имя;
		СтрокаВложений.Размер   = Вложение.Размер;
		СтрокаВложений.Автор    = Вложение.Автор;
		СтрокаВложений.ДатаВложения = Вложение.Дата;
		СтрокаВложений.МожноУдалить = Вложение.МожноУдалить;
		СтрокаВложений.ПометкаУдаления = Вложение.ПометкаУдаления;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьВложенияНаСервере()

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	ЗаполнитьВложения(ОбъектПакета.ДанныеФормыИсправления(Заявка).Вложения);

КонецПроцедуры

// Параметры открытия формы контрагента - на сервере (модель из хранилища,
// буфер «БИТ», признак редактирования; см. ПараметрыОткрытияРеквизитов).
// Повторное открытие - с уже исправленной моделью (МодельНоваяХранилище):
// иначе форма контрагента показывала исходную модель заявки без правок.
&НаСервере
Функция ОткрытиеРеквизитовНаСервере()

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	Модель = Неопределено;
	Если МодельИзменена И НЕ ПустаяСтрока(МодельНоваяХранилище) Тогда
		Модель = ПолучитьИзВременногоХранилища(МодельНоваяХранилище);
	ИначеЕсли НЕ ПустаяСтрока(МодельХранилище) Тогда
		Модель = ПолучитьИзВременногоХранилища(МодельХранилище);
	Иначе
		Модель = Неопределено; // модели нет - отказ в ПараметрыОткрытияРеквизитов
	КонецЕсли;
	Возврат ОбъектПакета.ПараметрыОткрытияРеквизитов(Заявка, Модель);

КонецФункции

// Модель «стало» после закрытия формы контрагента (из буфера бит_МДМ).
// Адрес временного хранилища с моделью: в веб-клиенте реквизит формы
// ValueStorage недоступен для записи, хранится адрес (живёт, пока открыта форма).

// Параметры:
//  Модель - Структура - модель «стало» для правки реквизитов.

// Возвращаемое значение:
//  Строка - адрес временного хранилища.
&НаСервере
Функция МодельВХранилищеНаСервере(Знач Модель)

	Возврат ПоместитьВоВременноеХранилище(Модель, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция МодельПослеРедактированияНаСервере()

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектПакета.МодельИзБуфераПакета();

КонецФункции

&НаСервере
Функция ДобавлениеВложенияНаСервере(Знач АдресФайла, Знач ИмяФайла)

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	РазмерБайт = 0;
	Данные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		РазмерБайт = Данные.Размер();
	КонецЕсли;
	Возврат ОбъектПакета.ДобавитьВложение(Заявка, АдресФайла, ИмяФайла,
		РазмерБайт, ИнициаторЗаявки);

КонецФункции

&НаСервере
Функция УдалениеВложенияНаСервере(Знач Файл)

	ОбъектПакета = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектПакета.ПометитьВложениеКУдалению(Файл, Заявка, ИнициаторЗаявки);

КонецФункции

// Сборка параметров отправки и вызов экспортной процедуры модуля объекта
// пакета (спека п. 6). Изменения: модель, пояснение (отличается от открытого),
// файлы, добавленные после последнего возврата.
&НаСервере
Функция ОтправкаНаПроверкуНаСервере()

	ОбъектПакета = РеквизитФормыВЗначение("Объект");

	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Заявка", Заявка);
	ПараметрыОтправки.Вставить("МодельИзменена", МодельИзменена);
	Если МодельИзменена И НЕ ПустаяСтрока(МодельНоваяХранилище) Тогда
		ПараметрыОтправки.Вставить("Модель", ПолучитьИзВременногоХранилища(МодельНоваяХранилище));
	КонецЕсли;
	ПараметрыОтправки.Вставить("ПояснениеИзменено",
		СокрЛП(Пояснение) <> СокрЛП(ПояснениеНачальное));
	ПараметрыОтправки.Вставить("Пояснение", Пояснение);
	ПараметрыОтправки.Вставить("ХешОткрытия", ХешОткрытия);

	ФайлыПослеВозврата = Новый Массив;
	Для Каждого СтрокаВложений Из Вложения Цикл
		Если СтрокаВложений.МожноУдалить И НЕ СтрокаВложений.ПометкаУдаления Тогда
			ФайлыПослеВозврата.Добавить(СтрокаВложений.Файл);
		КонецЕсли;
	КонецЦикла;
	ПараметрыОтправки.Вставить("ДобавленныеФайлы", ФайлыПослеВозврата);

	Возврат ОбъектПакета.ОтправитьНаПроверку(ПараметрыОтправки);

КонецФункции

#КонецОбласти
