////////////////////////////////////////////////////////////////////////////////
// Форма ПроверкаОчереди пакета ar_ПакетНСИ.
//
// Ручная проверка метода очереди визирования: кнопка «Проверить nsi_pending_visas»
// получает объект обработки и вызывает его метод ar_ВыполнитьИнструмент с
// инструментом nsi_pending_visas - тем же, что выдаёт агенту заявки на визе.
// Агент задаётся наименованием справочника ar_Агенты (тип ссылки в сборке
// обработки не разрешается - справочник из расширения), ссылка берётся на сервере.
// Результат (JSON ответа инструмента) выводится в поле «Результат проверки».
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	Агенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		АгентНаименование = Выборка.Наименование;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьОчередьВизВыполнение(Команда)

	ПроверитьОчередьВизНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьОчередьВизНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Контекст = Новый Структура;
	Агент = Справочники.ar_Агенты.НайтиПоНаименованию(АгентНаименование, Истина);
	Если Агент.Пустая() Тогда
		РезультатПроверки = "Агент с наименованием """ + АгентНаименование + """ не найден в справочнике ar_Агенты.";
		Возврат;
	КонецЕсли;
	Контекст.Вставить("Агент", Агент);
	РезультатПроверки = ОбъектОбработки.ar_ВыполнитьИнструмент("nsi_pending_visas", "{}", Контекст);

КонецПроцедуры

#КонецОбласти
