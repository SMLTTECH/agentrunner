////////////////////////////////////////////////////////////////////////////////
// Форма «Инструменты» пакета ar_ПакетНСИ - основная форма обработки.
//
// Ручная проверка инструментов пакета по выбранной заявке НСИ без запуска
// агента и без ожидания очереди: пользователь выбирает заявку (форма выбора
// документа бит_мдм_ЗаявкаНаИзменение), агента (наименование справочника
// ar_Агенты - тип ссылки в сборке обработки не разрешается, ссылку берет
// сервер) и инструмент; форма строит шаблон аргументов, аргументы можно
// править перед вызовом, вызов идет через ar_ВыполнитьИнструмент - ту же
// единую точку входа, что и в автоматическом контуре; ответ инструмента
// (JSON) выводится в поле «Результат».
//
// Контекст ручного вызова собирается только с агентом: RunId и Предмет не
// передаются - вызов вне запуска, защиты run_already_decided и
// run_subject_mismatch не возникают, повторные проверки возможны. Флажок
// «Пробный вызов» добавляет в аргументы "_dry_run": true (тот же канал, что
// у ядра) - инструменты записи возвращают план без записи в базу. После
// успешного nsi_get_request форма запоминает model_hash в поле «Хеш модели»
// и обновляет его в аргументах с ключом model_hash.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Списки выбора, инструмент по умолчанию и стартовый шаблон аргументов.
	ЗаполнитьСписокИнструментов();
	ЗаполнитьСписокАгентов();
	СписокИнструментов = ИменаИнструментов();
	Инструмент = СписокИнструментов[0];
	ЗаполнитьАргументыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗаявкаНСИПриИзменении(Элемент)

	// Аргументы привязаны к заявке: model_hash другой заявки не подходит.
	ХешМодели = "";
	ЗаполнитьАргументыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ИнструментПриИзменении(Элемент)

	ЗаполнитьАргументыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьАргументыВыполнение(Команда)

	ЗаполнитьАргументыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаявокНаВизеВыполнение(Команда)

	ВызватьИнструмент("nsi_pending_visas");

КонецПроцедуры

&НаКлиенте
Процедура ЧтениеЗаявкиВыполнение(Команда)

	ВызватьИнструмент("nsi_get_request");

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаРеквизитовВыполнение(Команда)

	ВызватьИнструмент("nsi_check_requisites");

КонецПроцедуры

&НаКлиенте
Процедура ОфициальныеДанныеЕГРВыполнение(Команда)

	ВызватьИнструмент("nsi_official_data");

КонецПроцедуры

&НаКлиенте
Процедура СверкаЗаявкиВыполнение(Команда)

	ВызватьИнструмент("nsi_verify_request");

КонецПроцедуры

&НаКлиенте
Процедура СдачаДанныхФайловВыполнение(Команда)

	ВызватьИнструмент("nsi_submit_file_data");

КонецПроцедуры

&НаКлиенте
Процедура АктуализацияЗаявкиВыполнение(Команда)

	ВызватьИнструмент("nsi_actualize_request");

КонецПроцедуры

&НаКлиенте
Процедура РешениеПоВизеВыполнение(Команда)

	ВызватьИнструмент("nsi_set_visa_decision");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызов инструмента: клиентская проверка аргументов, затем один серверный
// вызов ar_ВыполнитьИнструмент.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента пакета ("nsi_pending_visas", ...).
//
&НаКлиенте
Процедура ВызватьИнструмент(Знач ИмяИнструмента)

	Если Не АргументыКорректны() Тогда
		Возврат;
	КонецЕсли;

	ВызватьИнструментНаСервере(ИмяИнструмента);

КонецПроцедуры

// Аргументы вызова заполнены и являются корректным JSON - иначе сообщение
// у поля «Аргументы вызова» и отказ вызова (форма не падает).
//
&НаКлиенте
Функция АргументыКорректны()

	Если Не ЗначениеЗаполнено(АргументыJSON) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не заполнены аргументы вызова (ожидается JSON-объект).'"), , "АргументыJSON");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(АргументыJSON);
		ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Чтение.Закрыть();
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Аргументы вызова не являются корректным JSON-объектом: %1.'"),
				КраткоеОписаниеОшибки(ИнформацияОбОшибке())), , "АргументыJSON");
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Серверный вызов инструмента: контекст с агентом (по наименованию), вставка
// "_dry_run" при пробном вызове, ответ - в поле «Результат».
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента пакета ("nsi_pending_visas", ...).
//
&НаСервере
Процедура ВызватьИнструментНаСервере(Знач ИмяИнструмента)

	// Контекст ручного вызова - только агент: пустое наименование означает
	// вызов без агента (инструменты чтения заявки работают, визовые вернут
	// свой отказ - это тоже диагностика).
	Контекст = Новый Структура;
	НаименованиеАгента = СокрЛП(АгентНаименование);
	Если ЗначениеЗаполнено(НаименованиеАгента) Тогда
		АгентСсылка = Справочники.ar_Агенты.НайтиПоНаименованию(НаименованиеАгента, Истина);
		Если АгентСсылка.Пустая() Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Агент с наименованием ""%1"" не найден в справочнике ar_Агенты.'"),
					НаименованиеАгента), , "АгентНаименование");
			Возврат;
		КонецЕсли;
		Контекст.Вставить("Агент", АгентСсылка);
	КонецЕсли;

	АргументыВызова = АргументыJSON;
	Если ПробныйВызов Тогда
		АргументыОбъект = РазобранныеАргументы();
		Если АргументыОбъект = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Аргументы вызова должны быть корректным JSON-объектом ({...}).'"), , "АргументыJSON");
			Возврат;
		КонецЕсли;
		АргументыОбъект.Вставить("_dry_run", Истина);
		АргументыВызова = ОбщегоНазначения.ЗначениеВJSON(АргументыОбъект);
	КонецЕсли;

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	РезультатJSON = ОбъектОбработки.ar_ВыполнитьИнструмент(ИмяИнструмента, АргументыВызова, Контекст);

	Если ИмяИнструмента = "nsi_get_request" Тогда
		ЗапомнитьХешМодели(РезультатJSON);
	КонецЕсли;

КонецПроцедуры

// Разобранные аргументы вызова - Соответствие (JSON-объект); невалидный JSON
// или значение не объекта - Неопределено.
//
&НаСервере
Функция РазобранныеАргументы()

	Результат = Неопределено;
	Попытка
		Результат = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Хеш модели из ответа nsi_get_request: в поле «Хеш модели» и в аргументы
// (ключ model_hash, если он там есть) - следующие вызовы verify/submit/decision
// получат актуальный хеш без ручной правки.
//
// Параметры:
//  ОтветJSON - Строка - ответ инструмента nsi_get_request.
//
&НаСервере
Процедура ЗапомнитьХешМодели(Знач ОтветJSON)

	Ответ = Неопределено;
	Попытка
		Ответ = ОбщегоНазначения.JSONВЗначение(ОтветJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ХешОтвета = Ответ.Получить("model_hash");
	Если ТипЗнч(ХешОтвета) <> Тип("Строка") Или Не ЗначениеЗаполнено(ХешОтвета) Тогда
		Возврат;
	КонецЕсли;
	ХешМодели = ХешОтвета;

	Аргументы = РазобранныеАргументы();
	Если Аргументы = Неопределено Или Аргументы.Получить("model_hash") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Аргументы.Вставить("model_hash", ХешОтвета);
	АргументыJSON = ОбщегоНазначения.ЗначениеВJSON(Аргументы);

КонецПроцедуры

// Шаблон аргументов инструмента: request - навигационная ссылка выбранной
// заявки (заявка не выбрана - пустая строка), model_hash - из последнего
// чтения заявки.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента пакета ("nsi_pending_visas", ...).
//
// Возвращаемое значение:
//  Строка - JSON-объект аргументов для вызова инструмента.
//
&НаСервере
Функция ШаблонАргументов(Знач ИмяИнструмента)

	НавСсылкаЗаявки = ?(ЗначениеЗаполнено(ЗаявкаНСИ), ПолучитьНавигационнуюСсылку(ЗаявкаНСИ), "");

	Аргументы = Новый Соответствие;
	Если ИмяИнструмента = "nsi_pending_visas" Тогда
		Аргументы.Вставить("object_kind", "Контрагенты");
		Аргументы.Вставить("limit", 10);
		Аргументы.Вставить("include_handed_over", Ложь);
	ИначеЕсли ИмяИнструмента = "nsi_get_request" Тогда
		// full - иначе повторное чтение вернет краткий "unchanged" вместо заявки.
		Аргументы.Вставить("request", НавСсылкаЗаявки);
		Аргументы.Вставить("full", Истина);
	ИначеЕсли ИмяИнструмента = "nsi_verify_request" Тогда
		Аргументы.Вставить("request", НавСсылкаЗаявки);
		Аргументы.Вставить("model_hash", ХешМодели);
	ИначеЕсли ИмяИнструмента = "nsi_submit_file_data" Тогда
		Аргументы.Вставить("request", НавСсылкаЗаявки);
		Аргументы.Вставить("model_hash", ХешМодели);
		Аргументы.Вставить("parts", Новый Массив);
	ИначеЕсли ИмяИнструмента = "nsi_set_visa_decision" Тогда
		Аргументы.Вставить("request", НавСсылкаЗаявки);
		Аргументы.Вставить("decision", "approve");
		Аргументы.Вставить("comment", "");
		Аргументы.Вставить("model_hash", ХешМодели);
	Иначе
		// nsi_check_requisites, nsi_official_data, nsi_actualize_request.
		Аргументы.Вставить("request", НавСсылкаЗаявки);
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеВJSON(Аргументы);

КонецФункции

// Заполнение поля «Аргументы вызова» шаблоном по выбранному инструменту
// и заявке (правки пользователя в поле при этом теряются).
//
&НаСервере
Процедура ЗаполнитьАргументыНаСервере()

	АргументыJSON = ШаблонАргументов(Инструмент);

КонецПроцедуры

// Имена восьми инструментов пакета - те же, что у кнопок формы.
//
&НаСервере
Функция ИменаИнструментов()

	Имена = Новый Массив;
	Имена.Добавить("nsi_pending_visas");
	Имена.Добавить("nsi_get_request");
	Имена.Добавить("nsi_check_requisites");
	Имена.Добавить("nsi_official_data");
	Имена.Добавить("nsi_verify_request");
	Имена.Добавить("nsi_submit_file_data");
	Имена.Добавить("nsi_actualize_request");
	Имена.Добавить("nsi_set_visa_decision");
	Возврат Имена;

КонецФункции

// Список выбора поля «Инструмент» - имена инструментов пакета.
//
&НаСервере
Процедура ЗаполнитьСписокИнструментов()

	Для Каждого Имя Из ИменаИнструментов() Цикл
		Элементы.Инструмент.СписокВыбора.Добавить(Имя);
	КонецЦикла;

КонецПроцедуры

// Список выбора поля «Агент» - наименования справочника ar_Агенты; по
// умолчанию первый по наименованию.
//
&НаСервере
Процедура ЗаполнитьСписокАгентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	НЕ Агенты.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.АгентНаименование.СписокВыбора.Добавить(Выборка.Наименование);
	КонецЦикла;
	Если Элементы.АгентНаименование.СписокВыбора.Количество() > 0 Тогда
		АгентНаименование = Элементы.АгентНаименование.СписокВыбора[0].Значение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
