Функция СхемаАргументовОфициальныеДанные()

	Свойства = Новый Структура;
	Свойства.Вставить("inn", СвойствоСхемы("string",
		НСтр("ru = 'ИНН: 10 цифр - юридическое лицо, 12 - индивидуальный предприниматель.'")));
	Свойства.Вставить("request", СвойствоСхемы("string",
		НСтр("ru = 'Заявка НСИ: навигационная ссылка, номер заявки или строка с номером -
			|ИНН берётся из модели заявки.'")));

