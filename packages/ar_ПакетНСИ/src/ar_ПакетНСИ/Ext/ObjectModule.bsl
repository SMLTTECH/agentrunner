//
// Возвращаемое значение:
//  Структура.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	ОписаниеЭлемента = Новый Структура;
