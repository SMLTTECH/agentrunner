		НСтр("ru = 'Истина - всегда полный ответ. Повторное чтение той же неизменной
			|заявки без full возвращает краткий ответ (unchanged = true).'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("request");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("nsi_get_request",
		НСтр("ru = 'Полная выкладка заявки НСИ: реквизиты, поля «было/стало», подчинённые объекты, визы, model_hash.'"),
		Параметры);

КонецФункции

