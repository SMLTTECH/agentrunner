#Область ПрограммныйИнтерфейс

// Пакет инструментов AgentRunner «НСИ: заявки на контрагентов» (задача agentrunner-30).
//
// Пять инструментов для агента проверки заявок НСИ на контрагента:
//   * nsi_pending_visas      - заявки, ждущие визу пользователя агента (Чтение);
//   * nsi_get_request        - заявка целиком: шапка, поля «было/стало», ПОО, визы,
//                              хеш модели (Чтение);
//   * nsi_check_requisites   - точные проверки реквизитов: ИНН, КПП, ОГРН, СНИЛС,
//                              БИК, счёт, e-mail, телефон, паспорт (Чтение);
//   * nsi_official_data      - сведения ЕГРЮЛ/ЕГРИП по ИНН через сервис 1С:Контрагент
//                              (Чтение);
//   * nsi_set_visa_decision  - решение по своей визе: approve / return / reject,
//                              а также handover - передача сотруднику НСИ
//                              (Запись без подтверждения - решение человека Р4,
//                              спека agentrunner-30 п. 16; защита approve - п. 17;
//                              handover и отсев отложенных - спека agentrunner-35).
//
// Метод очереди ar_ОбъектыКОбработке - источник заявок для диспетчера ядра
// (спека agentrunner-32 п. 7, задача agentrunner-34): заявки на визе агента.
//
// Регистрация в БСП «Дополнительные отчёты и обработки», команда-маркер
// "ar_ToolPack" (.docs/Контракт-пакета-tools.md §1.2). БезопасныйРежим = Ложь -
// nsi_official_data ходит в интернет-сервис 1С:Контрагент; ядро пишет
// предупреждение package_registered_unsafe_mode и событие аудита (§1.1).
//
// Манифест - схема 2 (русские ключи), пространство имён "nsi", настройки пакета:
// НСИРазрешённыеСценарииСогласования (строка), НСИАгентТолькоВозвращает (булево),
// НСИДатаНачалаОбработкиЗаявок (строка ДД.ММ.ГГГГ - отбор заявок по дате
// документа, agentrunner-41).
//
// Латиницей - только внешние протоколы: имена инструментов, ключи JSON ответов
// (request, items, model_hash, ...), значения decision, коды ошибок. Значения для
// модели и оператора (статусы проверок, сценарии, сообщения) - по-русски.
//
// Запись в базу - только через существующий механизм «БИТ»:
// sd_Оптимизация_ФоновоеВизированиеСервер.УстановитьРешениеПоВизе; без
// привилегированного режима - права действуют как у человека (спека п. 19).
// Решение по визе пишется в транзакции с исключительной блокировкой виз и
// заявки - два одновременных вызова дают одно решение (спека п. 19а).

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчёты и
// обработки» (см. .docs/Контракт-пакета-tools.md §1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Наименование =
		НСтр("ru = 'Пакет инструментов AgentRunner: НСИ - заявки на контрагентов'");

	// Спека agentrunner-30 п. 15: nsi_official_data вызывает РаботаСКонтрагентами
	// (внешний сервис 1С:Контрагент); в безопасном режиме платформа запрещает
	// доступ к сети. Факт регистрации небезопасного пакета ядро пишет в аудит.
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Пакет инструментов AgentRunner'");
	НоваяКоманда.Идентификатор        = "ar_ToolPack";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП «Дополнительные отчёты и обработки». Команда
// "ar_ToolPack" - маркерная: служит только для отбора кандидатов на регистрацию
// пакета ядром AgentRunner, прикладного действия не выполняет.
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ВыполнитьКоманду", "nsi_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,'
				|' прикладного действия по этой команде не предусмотрено.'"));
	КонецЕсли;

КонецПроцедуры

// Манифест пакета инструментов - контракт AgentRunner, схема 2 (см.
// .docs/Контракт-пакета-tools.md §1.4). Вызывается ядром при регистрации и
// переподтверждении пакета. Не принимает аргументов.
//
// Возвращаемое значение:
//  Структура - манифест пакета: {ВерсияСхемы, ПространствоИмён, Версия, Категории,
//  Инструменты, Настройки}.
//
Функция ar_ОписаниеИнструментов() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("ВерсияСхемы", 2);
	Манифест.Вставить("ПространствоИмён", "nsi");
	// 1.2.0 - handover в nsi_set_visa_decision, отсев отложенных в выдаче,
	// include_handed_over в nsi_pending_visas (спека agentrunner-35).
	// 1.3.0 - отбор заявок от даты начала (agentrunner-41).
	Манифест.Вставить("Версия", "1.3.0");

	Категория = Новый Структура;
	Категория.Вставить("Имя", "nsi");
	Категория.Вставить("Представление", НСтр("ru = 'НСИ: заявки на контрагентов'"));
	Категория.Вставить("ОписаниеДляLLM",
		НСтр("ru = 'Заявки НСИ на контрагентов: список заявок на визе агента, разбор заявки,
			|точные проверки реквизитов, сведения ЕГРЮЛ/ЕГРИП по ИНН, решение по визе'"));
	Категория.Вставить("Порядок", 1);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаСписокЗаявок());
	Инструменты.Добавить(ОписаниеИнструментаЧтениеЗаявки());
	Инструменты.Добавить(ОписаниеИнструментаПроверкаРеквизитов());
	Инструменты.Добавить(ОписаниеИнструментаОфициальныеДанные());
	Инструменты.Добавить(ОписаниеИнструментаРешениеПоВизе());
	Манифест.Вставить("Инструменты", Инструменты);

	Манифест.Вставить("Настройки", ОписанияНастроекПакета());

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md §1.6). Диспетчеризация по имени, без
// Выполнить()/Вычислить(). Исключения наружу не выходят: страховочная попытка
// вокруг диспетчеризации возвращает {"error":"tool_exception"} с очищенным
// текстом (ar_Утилиты.ОчиститьОшибкуДляLLM).
//
// Параметры:
//  ИмяИнструмента       - Строка    - полное имя инструмента ("nsi_pending_visas", ...).
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащённый ядром
//                  системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun, Агент).
//                  Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяИнструмента, Знач АргументыJSON, Знач Контекст) Экспорт

	Попытка
		Если ИмяИнструмента = "nsi_pending_visas" Тогда
			Возврат ВыполнитьСписокЗаявокНаВизе(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_get_request" Тогда
			Возврат ВыполнитьЧтениеЗаявки(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_check_requisites" Тогда
			Возврат ВыполнитьПроверкуРеквизитов(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_official_data" Тогда
			Возврат ВыполнитьЗапросОфициальныхДанных(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_set_visa_decision" Тогда
			Возврат ВыполнитьРешениеПоВизе(АргументыJSON, Контекст);
		Иначе
			Возврат ОшибкаИнструмента("unknown_tool",
				НСтр("ru = 'Инструмент не входит в пакет nsi. Доступны: nsi_pending_visas,
					|nsi_get_request, nsi_check_requisites, nsi_official_data, nsi_set_visa_decision.'"));
		КонецЕсли;
	Исключение
		Возврат ОшибкаИнструмента("tool_exception",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецФункции

// Источник очереди для диспетчера ядра AgentRunner - контракт пакета
// (спека agentrunner-32 п. 7): диспетчер вызывает метод раз в минуту для
// агентов с признаком очереди и стартует запуск по каждой возвращённой заявке.
// Отбор тот же, что у инструмента nsi_pending_visas (общая ЗаявкиНаВизеАгента);
// вид объекта фиксирован «Контрагенты» - значение по умолчанию инструмента.
// Заявки, переданные агентом сотруднику НСИ (handover, agentrunner-35) и не
// изменённые, пропускаются всегда - параметра включения нет (п. 6 спеки).
//
// Пользователь агента не заполнен - пустой массив: это конфигурация агента,
// а не сбой источника, ядро не должно писать queue_source_failed каждую минуту.
// Прочие ошибки - исключением наружу (перехвата нет): ядро логирует
// queue_source_failed и ограничивает частоту. Без записи в базу и
// ar_СлужебныйЛог - журнал очереди ведёт ядро.
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент с признаком очереди.
//  Лимит - Число - предельное число заявок; не число или меньше 1 - 1,
//          больше 200 - 200 (ядро передаёт не больше 200).
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявки, ждущие визу
//  пользователя агента, в порядке приоритета отбора (ДатаКрайняя - пустые
//  в конце, затем дата заявки); уникальные; результат может быть короче Лимит -
//  у агента может быть несколько виз на одной заявке, отложенные пропускаются.
//
Функция ar_ОбъектыКОбработке(Знач Агент, Знач Лимит) Экспорт

	ПользовательАгента = ПользовательАгентаИзКонтекста(Новый Структура("Агент", Агент));
	Если Не ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЛимитОтбора = ?(ТипЗнч(Лимит) = Тип("Число"), Окр(Лимит), 1);
	ЛимитОтбора = Макс(Мин(ЛимитОтбора, ПредельныйЛимитОчереди()), 1);

	ОтборСтрок = ЗаявкиНаВизеАгента(ПользовательАгента, "Контрагенты", ЛимитОтбора, Агент);
	Возврат ЗаявкиИзСтрок(ОтборСтрок.Строки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОписаниеИнструментов

// Описание инструмента nsi_pending_visas для манифеста пакета
// (УровеньРиска = Чтение): заявки, ждущие визу пользователя агента.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаСписокЗаявок()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "nsi_pending_visas");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает заявки НСИ на контрагентов, ждущие решения по визе, назначенной
			|пользователю агента. По каждой: заявка, вид операции, сценарий, инициатор, виза,
			|крайний срок. Визы отбираются без привязки к наименованию: подходит любая виза
			|пользователя агента. По умолчанию - заявки на контрагентов; пустая строка object_kind -
			|все заявки НСИ. Заявки, переданные агентом сотруднику НСИ (handover) и не изменённые
			|с тех пор, не возвращаются; include_handed_over = true включает их с полем
			|handed_over, число пропущенных - в handed_over_skipped. Возвращаются только заявки
			|с датой документа не раньше даты начала из настройки «НСИ: дата начала обработки
			|заявок агентом».'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Заявки на визе агента'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовСписокЗаявок());
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// 1.2.0 - отбор заявок от даты начала обработки (agentrunner-41).
	Описание.Вставить("Версия", "1.2.0");
	Описание.Вставить("Категория", "nsi");
	Возврат Описание;

КонецФункции

// Описание инструмента nsi_get_request для манифеста пакета (УровеньРиска =
// Чтение): полная выкладка заявки для анализа и проверки.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаЧтениеЗаявки()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "nsi_get_request");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает заявку НСИ целиком: реквизиты контрагента (шапка), поля модели
			|«было» и «стало» с признаком изменения, табличные части, подчинённые объекты
