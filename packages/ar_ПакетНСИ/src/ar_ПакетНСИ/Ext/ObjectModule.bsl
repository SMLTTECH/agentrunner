КонецФункции

// Описание инструмента nsi_official_data для манифеста пакета (УровеньРиска =
// Чтение): сведения ЕГРЮЛ/ЕГРИП по ИНН.
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаОфициальныеДанные()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "nsi_official_data");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает официальные сведения по ИНН из сервиса 1С:Контрагент: 10 цифр -
			|юридическое лицо (ЕГРЮЛ: наименования, КПП, ОГРН, адрес, руководитель, статус,
