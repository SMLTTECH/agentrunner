	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'Дозаполнение пустых реквизитов заявки проверенными значениями из вложений -
			|обязательный шаг автономного согласования; модель предлагает значения, пакет
			|проверяет каждое и пишет только пустые поля (решение человека, спека agentrunner-88
			|п. 4, Р19). Перезапись заполненного исключена; запись модели в проведённую заявку
			|визы не сбрасывает, _dry_run поддерживается'"));
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "nsi");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов nsi_verify_request.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСверкиЗаявки()

	Свойства = Новый Структура;
	Свойства.Вставить("request", СвойствоСхемы("string",
		НСтр("ru = 'Заявка НСИ: навигационная ссылка из nsi_pending_visas, номер заявки
			|или строка с номером.'")));
	Свойства.Вставить("model_hash", СвойствоСхемы("string",
		НСтр("ru = 'Хеш модели из nsi_get_request - защита от правки заявки после чтения.'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("request");
	Обязательные.Добавить("model_hash");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("nsi_verify_request",
		НСтр("ru = 'Детерминированная сверка заявки с вложениями: относимость файлов, число лиц,
			|ключевые реквизиты, «Монополист», обязательные документы, проверки обработки, ЕГР.'"), Параметры);

КонецФункции

// JSON Schema аргументов nsi_submit_file_data.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСдачиДанных()

	СвойствоЛиц = Новый Структура;
	СвойствоЛиц.Вставить("type", "object");
	СвойствоЛиц.Вставить("properties", СвойстваСхемыЛицаФайла());
	СвойствоЛиц.Вставить("required", ЭлементыМассиваСхемы("inn", "role"));

	СвойствоЗначений = Новый Структура;
	СвойствоЗначений.Вставить("type", "object");
	СвойствоЗначений.Вставить("properties", СвойстваСхемыЗначенияПоля());
	СвойствоЗначений.Вставить("required", ЭлементыМассиваСхемы("field", "value", "fragment"));

	ЭлементЧасти = Новый Структура;
	ЭлементЧасти.Вставить("type", "object");
	ЭлементЧасти.Вставить("properties",
		СвойстваСхемыЧасти(СвойствоЛиц, СвойствоЗначений));
	ЭлементЧасти.Вставить("required", ЭлементыМассиваСхемы("file", "part"));

	СвойствоЧастей = Новый Структура;
	СвойствоЧастей.Вставить("type", "array");
	СвойствоЧастей.Вставить("description",
		НСтр("ru = 'Сданные части: file - имя файла из ответа nsi_verify_request, part - номер
			|части, persons - лица, найденные в этой части, values - найденные значения реквизитов
			|с дословной цитатой. Одна часть сдаётся повторно - прежняя сдача заменяется.'"));
	СвойствоЧастей.Вставить("items", ЭлементЧасти);

	Свойства = Новый Структура;
	Свойства.Вставить("request", СвойствоСхемы("string",
		НСтр("ru = 'Заявка НСИ: навигационная ссылка, номер заявки или строка с номером.'")));
	Свойства.Вставить("model_hash", СвойствоСхемы("string",
		НСтр("ru = 'Хеш модели из nsi_get_request.'")));
	Свойства.Вставить("parts", СвойствоЧастей);

	Обязательные = Новый Массив;
	Обязательные.Добавить("request");
	Обязательные.Добавить("model_hash");
	Обязательные.Добавить("parts");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("nsi_submit_file_data",
		НСтр("ru = 'Сдача извлечённых из частей файла данных: лица и значения реквизитов с
			|дословными цитатами; пакет проверяет, сверяет и дозаполняет пустые поля заявки.'"), Параметры);

КонецФункции

// Свойства JSON Schema одного лица в части (nsi_submit_file_data).
//
// Возвращаемое значение:
//  Структура - {inn, role}.
//
Функция СвойстваСхемыЛицаФайла()

	СвойствоРоли = Новый Структура;
	СвойствоРоли.Вставить("type", "string");
	СвойствоРоли.Вставить("enum", ЭлементыМассиваСхемы("counterparty", "bank", "our_org", "other"));
	СвойствоРоли.Вставить("description",
		НСтр("ru = 'counterparty - контрагент заявки, bank - банк (только если рядом с ИНН есть
			|БИК), our_org - наша организация из заявки, other - другое лицо.'"));

	Свойства = Новый Структура;
	Свойства.Вставить("inn", СвойствоСхемы("string",
		НСтр("ru = 'ИНН лица, как он записан в тексте.'")));
	Свойства.Вставить("role", СвойствоРоли);
	Возврат Свойства;

КонецФункции

// Свойства JSON Schema одного значения поля (nsi_submit_file_data).
//
// Возвращаемое значение:
//  Структура - {field, value, fragment}.
//
Функция СвойстваСхемыЗначенияПоля()

	Свойства = Новый Структура;
	Свойства.Вставить("field", СвойствоСхемы("string",
		НСтр("ru = 'Имя реквизита из поля field ответа nsi_verify_request (например КПП).'")));
	Свойства.Вставить("value", СвойствоСхемы("string",
		НСтр("ru = 'Найденное значение: строкой; для ссылочного - наименование из текста,
			|для перечисления - значение из списка values.'")));
	Свойства.Вставить("fragment", СвойствоСхемы("string",
		НСтр("ru = 'Дословная цитата из текста части, в которой найдено значение.'")));
	Возврат Свойства;

КонецФункции

// Свойства JSON Schema одной сдаваемой части (nsi_submit_file_data).
//
// Параметры:
//  СвойствоЛиц     - Структура - схема элемента persons.
//  СвойствоЗначений - Структура - схема элемента values.
//
// Возвращаемое значение:
//  Структура - {file, part, persons, values}.
//
Функция СвойстваСхемыЧасти(Знач СвойствоЛиц, Знач СвойствоЗначений)

	СвойствоPersons = Новый Структура;
	СвойствоPersons.Вставить("type", "array");
	СвойствоPersons.Вставить("description",
		НСтр("ru = 'Лица, найденные в этой части; ничего не нашли - пустой массив.'"));
	СвойствоPersons.Вставить("items", СвойствоЛиц);

	СвойствоValues = Новый Структура;
	СвойствоValues.Вставить("type", "array");
	СвойствоValues.Вставить("description",
		НСтр("ru = 'Значения реквизитов, найденные в этой части; ничего не нашли - пустой
			|массив.'"));
	СвойствоValues.Вставить("items", СвойствоЗначений);

	Свойства = Новый Структура;
	Свойства.Вставить("file", СвойствоСхемы("string",
		НСтр("ru = 'Имя файла из ответа nsi_verify_request (поле name).'")));
	Свойства.Вставить("part", СвойствоСхемы("number",
		НСтр("ru = 'Номер части этого файла (из поля parts ответа).'")));
	Свойства.Вставить("persons", СвойствоPersons);
	Свойства.Вставить("values", СвойствоValues);
	Возврат Свойства;

КонецФункции

// Описание инструмента nsi_actualize_request для манифеста пакета
// («Запись без подтверждения»): автоактуализация заявки НСИ по данным
// ЕГРЮЛ/ЕГРИП - заполнение модели «стало», проведение, «Согласовано» по визам
// сценария (agentrunner-96).
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаАвтоактуализация()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "nsi_actualize_request");
	Описание.Вставить("Описание",
		НСтр("ru = 'Актуализирует заявку НСИ по данным ЕГРЮЛ/ЕГРИП (заявки автоактуализации,
			|которые создаёт регламентное задание при смене статуса контрагента в ФНС: модель
			|«было» равна «стало», виз нет; stage = actualize в nsi_pending_visas). Пакет сам:
			|проверяет применимость (обособленное подразделение, нерезидент, неверный ИНН,
			|смена вида ЮЛ/ИП - тогда передаёт заявку сотруднику НСИ), берёт данные ЕГР по
			|ИНН, заполняет модель «стало» как команда «Заполнить по ИНН» карточки контрагента
			|(на копии в памяти), записывает и проводит заявку, ставит «Согласовано» по визам
			|обоих этапов с комментарием «Актуализировано по данным ЕГРЮЛ/ЕГРИП: поле: было ->
			|стало» либо «Изменений по данным ЕГР нет». Проверки обработкой не выполняются -
			|данные берутся из ЕГР. result в ответе: approved - обе визы согласованы;
			|approved_stage1 - виза 2 ещё не у агента, заявка вернётся в очередь; handover -
			|передача сотруднику НСИ; service_unavailable - ЕГР недоступен, не повторяй вызов,
			|заявка вернётся в очередь сама; not_actualization - заявка не сценария.
			|Проведённая заявка сценария без решения по визе 1 актуализируется полностью
			|(модель «стало» записывается в заявку без перепроведения); с согласованной
			|визой 1 ставится виза 2. Успешный ответ содержит next = finish: заверши работу.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Актуализация заявки по ИНН/КПП'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовАвтоактуализации());
	Описание.Вставить("УровеньРиска", "Запись");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// Точный текст - из спеки agentrunner-30 п. 16; проверяется ядром при регистрации
	// (Запись без подтверждения допустим только с ним).
	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'Автоактуализация заявки НСИ по данным ЕГРЮЛ/ЕГРИП: заявки создаёт
			|регламентное задание «БИТ» без инициатора, подтверждение некому запрашивать
			|(решение человека, спека agentrunner-96). Значения - только из официального
			|сервиса ЕГР; отказы и повторы - как у команды «Заполнить по ИНН»; запись и
			|проведение - в одной транзакции с блокировкой заявки; решение по визе отменяется
			|штатно; _dry_run поддерживается'"));
	// 1.1.0 - проведенная заявка сценария без решения по визе 1 актуализируется
	//         полностью, при согласовании только визы 1 - approved_stage1
	//         (agentrunner-210).
	Описание.Вставить("Версия", "1.1.0");
	Описание.Вставить("Категория", "nsi");
	Возврат Описание;

КонецФункции

// JSON Schema аргументов nsi_actualize_request: только request.
//
