// Ссылка элемента справочника по GUID из области КонстантыGUID; пустой GUID -
// пустая ссылка.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника ("бит_Визы", "sd_ВнешниеИнформационныеСистемы").
//  Гуид           - Строка - уникальный идентификатор ("").
//
// Возвращаемое значение:
//  ЛюбаяСсылка.
//
Функция СсылкаПоГуиду(Знач ИмяСправочника, Знач Гуид)

	Если ПустаяСтрока(Гуид) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(Гуид));

