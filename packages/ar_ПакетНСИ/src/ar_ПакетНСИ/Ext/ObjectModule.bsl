// JSON Schema аргументов nsi_submit_file_data.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовСдачиДанных()

	СвойствоЛиц = Новый Структура;
	СвойствоЛиц.Вставить("type", "object");
	СвойствоЛиц.Вставить("properties", СвойстваСхемыЛицаФайла());
	СвойствоЛиц.Вставить("required", ЭлементыМассиваСхемы("inn", "role"));

	СвойствоЗначений = Новый Структура;
	СвойствоЗначений.Вставить("type", "object");
	СвойствоЗначений.Вставить("properties", СвойстваСхемыЗначенияПоля());
	СвойствоЗначений.Вставить("required", ЭлементыМассиваСхемы("field", "value", "fragment"));

	ЭлементЧасти = Новый Структура;
	ЭлементЧасти.Вставить("type", "object");
	ЭлементЧасти.Вставить("properties",
		СвойстваСхемыЧасти(СвойствоЛиц, СвойствоЗначений));
	ЭлементЧасти.Вставить("required", ЭлементыМассиваСхемы("file", "part"));

	СвойствоЧастей = Новый Структура;
	СвойствоЧастей.Вставить("type", "array");
	СвойствоЧастей.Вставить("description",
		НСтр("ru = 'Сданные части: file - имя файла из ответа nsi_verify_request, part - номер
			|части, persons - лица, найденные в этой части, values - найденные значения реквизитов
			|с дословной цитатой. Одна часть сдаётся повторно - прежняя сдача заменяется.'"));
	СвойствоЧастей.Вставить("items", ЭлементЧасти);

	Свойства = Новый Структура;
	Свойства.Вставить("request", СвойствоСхемы("string",
		НСтр("ru = 'Заявка НСИ: навигационная ссылка, номер заявки или строка с номером.'")));
	Свойства.Вставить("model_hash", СвойствоСхемы("string",
		НСтр("ru = 'Хеш модели из nsi_get_request.'")));
	Свойства.Вставить("parts", СвойствоЧастей);

	Обязательные = Новый Массив;
	Обязательные.Добавить("request");
	Обязательные.Добавить("model_hash");
	Обязательные.Добавить("parts");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("nsi_submit_file_data",
		НСтр("ru = 'Сдача извлечённых из частей файла данных: лица и значения реквизитов с
			|дословными цитатами; пакет проверяет, сверяет и дозаполняет пустые поля заявки.'"), Параметры);

КонецФункции

