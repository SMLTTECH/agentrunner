// Единая точка входа вызова инструментов пакета - контракт AgentRunner (см.
// .docs/Контракт-пакета-tools.md §1.6). Диспетчеризация по имени, без
// Выполнить()/Вычислить(). Исключения наружу не выходят: страховочная попытка
// вокруг диспетчеризации возвращает {"error":"tool_exception"} с очищенным
// текстом (ar_Утилиты.ОчиститьОшибкуДляLLM).
//
// Параметры:
//  ИмяИнструмента       - Строка    - полное имя инструмента ("nsi_pending_visas", ...).
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащенный ядром
//                  системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun, Агент).
//                  Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьИнструмент(Знач ИмяИнструмента, Знач АргументыJSON, Знач Контекст) Экспорт

	Попытка
		Если ИмяИнструмента = "nsi_pending_visas" Тогда
			Возврат ВыполнитьСписокЗаявокНаВизе(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_get_request" Тогда
			Возврат ВыполнитьЧтениеЗаявки(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_check_requisites" Тогда
			Возврат ВыполнитьПроверкуРеквизитов(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_official_data" Тогда
			Возврат ВыполнитьЗапросОфициальныхДанных(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_verify_request" Тогда
			Возврат ВыполнитьСверкуЗаявки(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_submit_file_data" Тогда
			Возврат ВыполнитьСдачуДанныхФайлов(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_actualize_request" Тогда
			Возврат ВыполнитьАктуализациюЗаявки(АргументыJSON, Контекст);
		ИначеЕсли ИмяИнструмента = "nsi_set_visa_decision" Тогда
			Возврат ВыполнитьРешениеПоВизе(АргументыJSON, Контекст);
		Иначе
			Возврат ОшибкаИнструмента("unknown_tool",
				НСтр("ru = 'Инструмент не входит в пакет nsi. Доступны: nsi_pending_visas,
					|nsi_get_request, nsi_check_requisites, nsi_official_data, nsi_verify_request,
					|nsi_submit_file_data, nsi_actualize_request, nsi_set_visa_decision.'"));
		КонецЕсли;
	Исключение
		// Полное представление с модулем и строкой - в служебный лог: наружу
		// уходит очищенный текст, локализовать сбой по нему нельзя
		// (agentrunner-108, verify итерация 4: «Найти» без места падения).
		ПодробноеПредставление = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ar_ВыполнитьИнструмент", "tool_exception",
			СтрШаблон("%1: %2", ИмяИнструмента, ПодробноеПредставление),
			"Ошибка", RunIdИзКонтекста(Контекст));
		Возврат ОшибкаИнструмента("tool_exception",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецФункции

// Источник очереди для диспетчера ядра AgentRunner - контракт пакета
// (спека agentrunner-32 п. 7): диспетчер вызывает метод раз в минуту для
// агентов с признаком очереди и стартует запуск по каждой возвращенной заявке.
// Отбор тот же, что у инструмента nsi_pending_visas (общая ЗаявкиНаВизеАгента);
// вид объекта фиксирован «Контрагенты» - значение по умолчанию инструмента.
// Заявки, переданные агентом сотруднику НСИ (handover, agentrunner-35) и не
// измененные, пропускаются всегда - параметра включения нет (п. 6 спеки).
// agentrunner-96: после заявок на визе в тот же лимит добавляются непроведенные
// заявки автоактуализации (ветка ЗаявкиАктуализации, спека п. 2): отдельный
// запрос, без действующей отметки отложения с ключом "actualize".
// agentrunner-118: обычные заявки с отметкой отложения при недоступном ЕГР
// (ключ "egr_unavailable") пропускаются до ОтложенВ + НСИПовторПриНедоступномЕГРЧасов;
// с 2.4.2 такие отметки не пишутся (сверка пропускается), действуют записанные ранее.
//
// Пользователь агента не заполнен - пустой массив: это конфигурация агента,
// а не сбой источника, ядро не должно писать queue_source_failed каждую минуту.
// Прочие ошибки - исключением наружу (перехвата нет): ядро логирует
// queue_source_failed и ограничивает частоту. Без записи в базу и
// ar_СлужебныйЛог - журнал очереди ведет ядро.
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент с признаком очереди.
//  Лимит - Число - предельное число заявок; не число или меньше 1 - 1,
//          больше 200 - 200 (ядро передает не больше 200).
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявки, ждущие визу
//  пользователя агента, в порядке приоритета отбора (ДатаКрайняя - пустые
//  в конце, затем дата заявки), затем заявки автоактуализации по дате
//  документа; уникальные; результат может быть короче Лимит.
//
Функция ar_ОбъектыКОбработке(Знач Агент, Знач Лимит) Экспорт

	ПользовательАгента = ПользовательАгентаИзКонтекста(Новый Структура("Агент", Агент));
	Если Не ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЛимитОтбора = ?(ТипЗнч(Лимит) = Тип("Число"), Окр(Лимит), 1);
	ЛимитОтбора = Макс(Мин(ЛимитОтбора, ПредельныйЛимитОчереди()), 1);

	ОтборСтрок = ЗаявкиНаВизеАгента(ПользовательАгента, "Контрагенты", ЛимитОтбора, Агент, , Истина);
	Заявки = ЗаявкиИзСтрок(ОтборСтрок.Строки);

	Если Заявки.Количество() < ЛимитОтбора Тогда
		Ветка = ЗаявкиАктуализации(Агент, ЛимитОтбора - Заявки.Количество());
		Для Каждого СсылкаЗаявки Из Ветка.Заявки Цикл
			Заявки.Добавить(СсылкаЗаявки);
		КонецЦикла;
	КонецЕсли;

	Возврат Заявки;

КонецФункции

// Точка переопределения открытия предмета диалога - необязательный метод
// контракта пакета (agentrunner-50, как ar_ОбъектыКОбработке): ядро
// ar_ДиалогиСервер.ПараметрыОткрытияПредмета вызывает его у зарегистрированных
// действующих пакетов в порядке namespace и первым непустым результатом
// открывает предмет; отсутствие метода - предмет пакетом не обслуживается.
// Заявка НСИ открывается формой ИсправлениеЗаявки пакета (с 2.4.3 - всегда),
// без правки ядра расширения (решение человека, спека agentrunner-50).
//
// Параметры:
//  Предмет - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет диалога.
//
// Возвращаемое значение:
//  Структура - {ИмяФормы - Строка - полное имя формы для ОткрытьФорму,
//               ПараметрыФормы - Структура - параметры открытия};
//  Неопределено - предмет не обслуживается пакетом.
//
Функция ar_ПараметрыОткрытияПредмета(Знач Предмет) Экспорт

	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		// 2.4.3 (решение человека): заявка НСИ из любого диалога открывается
		// формой исправления пакета - правка, если исправление доступно
		// (ИсправлениеДоступно), иначе только чтение с причиной; документ -
		// командой формы. Штатная форма документа - только если обработка
		// пакета не подключена.
		ИмяПодключения = ИмяПодключенияПакета();
		Если Не ПустаяСтрока(ИмяПодключения) Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Заявка", Предмет);

			Результат = Новый Структура;
			Результат.Вставить("ИмяФормы",
				"ВнешняяОбработка." + ИмяПодключения + ".Форма.ИсправлениеЗаявки");
			Результат.Вставить("ПараметрыФормы", ПараметрыФормы);
			Возврат Результат;
		КонецЕсли;

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", Предмет);

		Результат = Новый Структура;
		Результат.Вставить("ИмяФормы", "Документ.бит_мдм_ЗаявкаНаИзменение.ФормаОбъекта");
		Результат.Вставить("ПараметрыФормы", ПараметрыФормы);
		Возврат Результат;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Ответ пакета НСИ на сообщение человека в диалоге ожидания (agentrunner-89,
// спека п. 8, 8а) - необязательный метод контракта пакета, ядро вызывает его
// из ветки якоря "pkg:" без запуска агента. Открытое ожидание - подсказка
// инициатору (отправка через форму исправления); закрытое по сроку - сообщение
// инициатора возобновляет ожидание на новый полный срок (письмо и запись
// состояния выполняет СообщениеПакетаПоПредмету); закрытое после reject или
// после отправки на проверку - «Заявка закрыта...». Пустой ответ - в ленту
// ничего не дописывается.
//
// Параметры:
//  Предмет - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет диалога (заявка НСИ).
//  Якорь   - Строка - якорь диалога ("pkg:nsi:correction:<УИД заявки>").
//  Автор   - СправочникСсылка.Пользователи - автор сообщения.
//  Текст   - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Строка - ответ агента в ленту диалога; "" - ответ не нужен.
//
Функция ar_ОтветНаСообщениеПоПредмету(Знач Предмет, Знач Якорь, Знач Автор, Знач Текст) Экспорт

	Если ТипЗнч(Предмет) <> Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		Возврат "";
	КонецЕсли;

	Диалог = ar_ДиалогиСервер.ДиалогПоЯкорю(Якорь);
	Если Не ЗначениеЗаполнено(Диалог) Или Якорь <> ЯкорьОжидания(Предмет) Тогда
		Возврат "";
	КонецЕсли;

	Шапка = ar_ДиалогиСервер.ШапкаДиалога(Диалог);
	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Предмет, "сд_Инициатор, Ответственный");

	Если Не АдресатОжидания(Автор, РеквизитыЗаявки.сд_Инициатор, РеквизитыЗаявки.Ответственный) Тогда
		// Сообщение не адресата ожидания - подсказка не требуется.
		Возврат "";
	КонецЕсли;

	Если Шапка.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		Возврат ТекстПодсказкиОтправки();
	КонецЕсли;

	// Закрытое ожидание: возобновление - только после закрытия по сроку
	// (последний текст агента «Заявка закрыта: нет ответа...»), спека п. 8а.
	Если ВозобновлениеВозможно(Диалог, Предмет) Тогда
		ОжиданиеВозобновлено(Предмет);
		// Сообщение «Ожидание исправления возобновлено...» уже записано
		// ОжиданиеВозобновлено через СообщениеПакетаПоПредмету.
		Возврат "";
	КонецЕсли;

	Возврат ТекстОжиданиеЗакрыто();

КонецФункции

// Отправка исправленной заявки на проверку (agentrunner-89, спека п. 6) -
// экспортная процедура модуля объекта пакета, вызывается формой
// ИсправлениеЗаявки. Привилегированно (прав у инициатора нет); транзакция
// с исключительной блокировкой заявки и её виз; модель (если изменена),
// отмена проведения и проведение назначают визы заново (О11). Ошибка
// проведения откатывает всё - ожидание остаётся открытым. Успех: пояснение -
// сообщением инициатора в диалог, новые файлы - в ar_ОчередьРаспознавания,
// ожидание закрывается.
//
// Параметры:
//  Параметры - Структура:
//   * Заявка           - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//   * МодельИзменена   - Булево - инициатор менял реквизиты через форму контрагента.
//   * Модель           - Структура, Неопределено - модель «стало» после правки.
//   * ПояснениеИзменено - Булево - заполнено новое пояснение.
//   * Пояснение        - Строка - пояснение для проверки.
//   * ХешОткрытия      - Строка - model_hash при открытии формы.
//   * ДобавленныеФайлы - Массив из ОпределяемыйТип.ПрисоединенныйФайл - не
//                        передаётся: заполняется по данным базы.
//   * ФайлыУдалены     - Булево - инициатор пометил файлы на удаление в форме.
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, Сообщение: Строка - текст для пользователя}.
//
Функция ОтправитьНаПроверку(Знач Параметры) Экспорт

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	Заявка = Неопределено;
	Параметры.Свойство("Заявка", Заявка);
	Если ТипЗнч(Заявка) <> Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		Результат.Сообщение = НСтр("ru = 'Не указана заявка.'");
		Возврат Результат;
	КонецЕсли;

	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Параметры.Вставить("ДобавленныеФайлы", ДобавленныеФайлыОтправки(Заявка));
		Отказ = ОтказОтправкиНаПроверку(Параметры, Заявка, Результат);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Если Отказ Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Результат;
	КонецЕсли;

	Попытка
		НачатьТранзакцию();
		Попытка

			ЗаблокироватьДанныеРешения(Заявка);

			ПерепровестиЗаявку(Параметры, Заявка, Результат);
			Если Не Результат.Успех Тогда
				ОтменитьТранзакцию();
				УстановитьПривилегированныйРежим(Ложь);
				ЗаписатьЛогОтправки(Заявка, Результат.Сообщение);
				Возврат Результат;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
			Результат.Сообщение = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписатьЛогОтправки(Заявка, Результат.Сообщение);
			Возврат Результат;
		КонецПопытки;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	// Вне транзакции: пояснение, очередь распознавания, закрытие ожидания.
	// Их сбой отправку не отменяет - заявка уже перепроведена.
	ЗавершитьОтправкуНаПроверку(Параметры, Заявка, Результат);

	Возврат Результат;

КонецФункции

// Данные для формы ИсправлениеЗаявки (agentrunner-89, спека п. 5) - единый
// серверный вызов: доступность исправления и причина отказа, шапка заявки,
// замечания последнего возврата, пояснение (сообщения инициатора после
// возврата), срок, хеш модели и вложения. Вызывается формой пакета;
// доступность проверяется заново (после открытия ядра могли измениться).
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка исправления.
//
// Возвращаемое значение:
//  Структура:
//   * Доступно       - Булево - открывать форму в режиме правки.
//   * Причина        - Строка - «Исправление недоступно: ...» при отказе.
//   * Номер, Дата    - реквизиты заявки для шапки формы.
//   * Контрагент     - Строка - представление предмета заявки.
//   * Операция       - Строка - представление вида операции.
//   * Срок           - Дата - окончательный срок исправления.
//   * Замечания      - Строка - текст последнего «Возврат на исправление».
//   * Пояснение      - Строка - сообщения инициатора после последнего возврата.
//   * ПодсказкаФайлы - Строка - «какие документы нужны» из замечаний.
//   * ХешМодели      - Строка - model_hash на момент открытия формы.
//   * МодельХранилище - ХранилищеЗначения - модель «стало» (для правки реквизитов).
//   * Инициатор, Ответственный - СправочникСсылка.Пользователи.
//   * Вложения       - Массив из Структура {Файл, Имя, Размер, Автор, Дата,
//                      МожноУдалить, ДобавленПослеВозврата} - файлы заявки.
//
Функция ДанныеФормыИсправления(Знач Заявка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Доступно", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Номер", "");
	Результат.Вставить("Дата", Дата('00010101'));
	Результат.Вставить("Контрагент", "");
	Результат.Вставить("Операция", "");
	Результат.Вставить("Срок", Дата('00010101'));
	Результат.Вставить("Замечания", "");
	Результат.Вставить("Пояснение", "");
	Результат.Вставить("ПодсказкаФайлы", "");
	Результат.Вставить("ХешМодели", "");
	Результат.Вставить("МодельХранилище", Неопределено);
	Результат.Вставить("Инициатор", Справочники.Пользователи.ПустаяСсылка());
	Результат.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
	Результат.Вставить("Вложения", Новый Массив);

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Если ИсправлениеДоступно(Заявка) Тогда
			Результат.Доступно = Истина;
		ИначеЕсли НЕ ЗначениеЗаполнено(ДиалогОжидания(Заявка)) Тогда
			// С 2.4.3 форма открывается по любой заявке НСИ, не только возвращённой.
			Результат.Причина = НСтр("ru = 'Заявка не возвращалась на исправление - форма
				|открыта только для просмотра.'");
		Иначе
			Результат.Причина = НСтр("ru = 'Исправление недоступно: ожидание исправления
				|закрыто, истёкло или заявка возвращена другому пользователю.'");
		КонецЕсли;

		ДанныеТекущейЗаявки = ДанныеЗаявки(Заявка);
		Шапка = ДанныеТекущейЗаявки.Шапка;
		ЗаявкаНеНайдена = (Шапка = Неопределено);
		Если НЕ ЗаявкаНеНайдена Тогда
			Результат.Номер   = СокрЛП(Шапка.Номер);
			Результат.Дата    = Шапка.Дата;
			Результат.Контрагент = Шапка.ПредметПредставление;
			Результат.Операция   = Строка(Шапка.ВидОперации);
			Результат.Инициатор  = Шапка.Инициатор;
			Результат.Ответственный = Шапка.Ответственный;

			Диалог = ДиалогОжидания(Заявка);
			Если ЗначениеЗаполнено(Диалог) Тогда
				Результат.Срок = ОкончательныйСрокОжидания(Диалог);
				Результат.Замечания = ТекстПоследнегоВозврата(Диалог);
				Результат.Пояснение = ЗаписиИнициатораПослеВозврата(Заявка);
				Результат.ПодсказкаФайлы = ПодсказкаФайлов(Результат.Замечания);
			КонецЕсли;

			МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
			Если МодельСтало <> Неопределено Тогда
				Результат.МодельХранилище = Новый ХранилищеЗначения(МодельСтало);
				Результат.ХешМодели = ХешМоделейЗаявки(МодельСтало,
					ДанныеТекущейЗаявки.Подчиненные);
			КонецЕсли;

			Результат.Вложения = ФайлыЗаявкиДляФормы(Заявка);
		Иначе
			Результат.Доступно = Ложь;
			Результат.Причина = НСтр("ru = 'Исправление недоступно: заявка не найдена.'");
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Параметры открытия «Исправить реквизиты» (agentrunner-89, спека п. 5):
// Справочник.<объект обмена>.ФормаОбъекта с моделью «стало» и параметрами,
// как в обработке-образце и sd_КомандаРедактироватьВместо формы заявки
// (ЗначенияЗаполнения, буфер КодДоИзменения, признак редактирования).
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Модель - Структура - модель «стало» (из МодельХранилище формы).
//
// Возвращаемое значение:
//  Структура - {ИмяФормы, ПараметрыФормы, Отказ, Сообщение}.
//
Функция ПараметрыОткрытияРеквизитов(Знач Заявка, Знач Модель) Экспорт

	Результат = Новый Структура("ИмяФормы, ПараметрыФормы, Отказ, Сообщение",
		"", Неопределено, Ложь, "");

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Результат.Отказ = Истина;
		Результат.Сообщение = НСтр("ru = 'Модель заявки пуста - реквизиты исправить нельзя.'");
		Возврат Результат;
	КонецЕсли;

	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка,
		"ВидОперации, Предмет, ОписаниеОбъекта, ПодчиненныйСправочник, ВладелецПредмета");
	ИмяОбъекта = "";
	ОтправлятьКод = Ложь;
	КодДоИзменения = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыЗаявки.ОписаниеОбъекта) Тогда
		РеквизитыООО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			РеквизитыЗаявки.ОписаниеОбъекта, "Имя, ОтправлятьКод");
		ИмяОбъекта = СокрЛП(РеквизитыООО.Имя);
		ОтправлятьКод = РеквизитыООО.ОтправлятьКод;
		Если ОтправлятьКод Тогда
			КодДоИзменения = Модель.СтандартныеРеквизиты.Код;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Результат.Отказ = Истина;
		Результат.Сообщение = НСтр("ru = 'У заявки не заполнено описание объекта обмена.'");
		Возврат Результат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("бит_мдм_ЗаполнениеЗаявки", Истина);
	ЗначенияЗаполнения.Вставить("МодельОбъекта", Модель);
	ЗначенияЗаполнения.Вставить("ОтправлятьКод", ОтправлятьКод);
	Если РеквизитыЗаявки.ПодчиненныйСправочник Тогда
		ЗначенияЗаполнения.Вставить("Владелец", РеквизитыЗаявки.ВладелецПредмета);
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("бит_мдм_ЗаполнениеЗаявки", Истина);
	Если РеквизитыЗаявки.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		ПараметрыФормы.Вставить("sd_СсылкаИзменяемогоЭлемента", РеквизитыЗаявки.Предмет);
	КонецЕсли;
	ПараметрыФормы.Вставить("бит_мдм_ЗаявкаНаИзменение_ВидОперации", РеквизитыЗаявки.ВидОперации);
	ПараметрыЗаявкиНСИ = Новый Структура;
	ТекущаяВиза = Неопределено;
	Попытка
		ТекущаяВиза = Документы.бит_мдм_ЗаявкаНаИзменение.sd_ПолучитьТекущуюВизу(Заявка);
	Исключение
		// Активная виза - контекстный параметр формы контрагента; сбой чтения
		// не мешает правке реквизитов.
		ТекущаяВиза = Неопределено;
	КонецПопытки;
	ПараметрыЗаявкиНСИ.Вставить("ТекущаяВиза", ТекущаяВиза);
	ПараметрыЗаявкиНСИ.Вставить("ОписаниеОбъекта", РеквизитыЗаявки.ОписаниеОбъекта);
	ПараметрыФормы.Вставить("sd_ПараметрыЗаявкиНСИ", ПараметрыЗаявкиНСИ);

	// Буфер «БИТ»: форма контрагента вернёт модель «стало» через
	// бит_МДМ.ЗначениеИзБуфера("МодельДанных") (как в образце).
	бит_мдм.ПоместитьЗначениеВБуфер("КодДоИзменения", КодДоИзменения);
	ПараметрыСеанса.бит_мдм_ПризнакРедактирования = Истина;

	Результат.ИмяФормы = "Справочник." + ИмяОбъекта + ".ФормаОбъекта";
	Результат.ПараметрыФормы = ПараметрыФормы;

	Возврат Результат;

КонецФункции

// Модель «стало» после закрытия формы контрагента (agentrunner-89, спека п. 5):
// из буфера бит_МДМ, признак редактирования снимается (как ПолучитьИзБуфера
// образца). Модель не возвращена - правки не было.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «стало» либо Неопределено.
//
Функция МодельИзБуфераПакета() Экспорт

	бит_мдм.ЗначениеИзБуфера("КодДоИзменения");
	бит_мдм.ЗначениеИзБуфера("ИспользоватьКодДоИзменения");
	ПараметрыСеанса.бит_мдм_ПризнакРедактирования = Ложь;

	Модель = бит_МДМ.ЗначениеИзБуфера("МодельДанных");
	Возврат ?(ТипЗнч(Модель) = Тип("Структура"), Модель, Неопределено);

КонецФункции

// Присоединение файла к заявке от имени инициатора (agentrunner-89, спека п. 5,
// Р26): расширение и размер - по настройкам пакета, добавление
// РаботаСФайлами.ДобавитьФайл в Попытке - ошибка не роняет форму.
//
// Параметры:
//  Заявка     - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  АдресФайла - Строка - адрес двоичных данных во временном хранилище.
//  ИмяФайла   - Строка - имя файла с расширением.
//  РазмерБайт - Число  - размер файла (проверка НСИВложенияМаксМБ).
//  Пользователь - СправочникСсылка.Пользователи - автор файла (инициатор).
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, Сообщение: Строка, Файл - ссылка файла}.
//
Функция ДобавитьВложение(Знач Заявка, Знач АдресФайла, Знач ИмяФайла,
	Знач РазмерБайт, Знач Пользователь) Экспорт

	Результат = Новый Структура("Успех, Сообщение, Файл", Ложь, "", Неопределено);

	ИмяБезРасширения = ИмяФайла;
	Расширение = "";
	ЧастиИмени = СтрРазделить(ИмяФайла, ".", Ложь);
	Если ЧастиИмени.Количество() > 1 Тогда
		Расширение = НРег(СокрЛП(ЧастиИмени[ЧастиИмени.Количество() - 1]));
		ИмяБезРасширения = Лев(ИмяФайла,
			СтрДлина(ИмяФайла) - (СтрДлина(Расширение) + 1));
	КонецЕсли;

	ОтказТекста = ОтказВложения(Расширение, РазмерБайт);
	Если ЗначениеЗаполнено(ОтказТекста) Тогда
		Результат.Сообщение = ОтказТекста;
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов     = Заявка;
		ПараметрыФайла.ИмяБезРасширения   = ИмяБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = Расширение;
		ПараметрыФайла.Автор              = Пользователь;

		Результат.Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайла);
		Результат.Успех = ЗначениеЗаполнено(Результат.Файл);
		Если НЕ Результат.Успех Тогда
			Результат.Сообщение = НСтр("ru = 'Файл не добавлен.'");
		КонецЕсли;
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Не удалось присоединить файл: %1'"),
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ДобавитьВложение", "nsi_file_attach_failed",
			СтрШаблон("%1: файл %2: %3", Строка(Заявка), ИмяФайла, Результат.Сообщение),
			"Ошибка", "", Заявка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Пометка файла заявки на удаление (agentrunner-89, спека п. 5): удалять можно
// любые файлы этого инициатора, кроме протоколов проверки, - и приложенные до
// возврата (ошибочный документ из замечаний, agentrunner-283); файл остаётся -
// свидетельство в протоколе (решение спеки), проверка агентом его не видит.
//
// Параметры:
//  Файл     - ОпределяемыйТип.ПрисоединенныйФайл - файл заявки.
//  Заявка   - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Пользователь - СправочникСсылка.Пользователи - инициатор исправления.
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, Сообщение: Строка, ПриложенДоВозврата: Булево -
//              файл приложен до последнего возврата: пометка - изменение заявки}.
//
Функция ПометитьВложениеКУдалению(Знач Файл, Знач Заявка, Знач Пользователь) Экспорт

	Результат = Новый Структура("Успех, Сообщение, ПриложенДоВозврата", Ложь, "", Ложь);

	Доступность = ФайлДоступенКУдалению(Файл, Заявка, Пользователь);
	Если НЕ Доступность.Доступен Тогда
		Результат.Сообщение = НСтр("ru = 'Удалять можно только файлы, добавленные
			|вами, кроме протоколов проверки, пока заявка ожидает исправления.'");
		Возврат Результат;
	КонецЕсли;
	Результат.ПриложенДоВозврата = Доступность.ПриложенДоВозврата;

	Попытка
		ОбъектФайла = Файл.ПолучитьОбъект();
		Если ОбъектФайла = Неопределено Тогда
			Результат.Сообщение = НСтр("ru = 'Файл не найден.'");
			Возврат Результат;
		КонецЕсли;
		ОбъектФайла.ПометкаУдаления = Истина;
		ОбъектФайла.Записать();
		Результат.Успех = Истина;
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Не удалось пометить файл на удаление: %1'"),
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КонстантыGUID

// Константы пакета (agentrunner-88, решение человека: GUID и пределы - только
// здесь). GUID виз и внешних систем - данные базы, код не создаёт элементы:
// ссылка получается Справочники.<X>.ПолучитьСсылку(Новый УникальныйИдентификатор(
// <GUID>)). Пустой GUID виз - совместимость: все визы агента считаются этапом 1,
// approve этапа 2 недоступен (до передачи значений человеком).
//
// GUID виз этапов - настройки пакета НСИГУИДВизыЭтап1 / НСИГУИДВизыЭтап2
// (справочник ar_ДополнительныеНастройки, agentrunner-213): в каждой базе
// задаются свои значения без выпуска пакета; по умолчанию - GUID тестового
// контура.

// GUID визы этапа 1 «Анализ БА (согл)» (Справочник.бит_Визы) из настройки
// НСИГУИДВизыЭтап1. Элемента с этим GUID в базе нет - GUID считается
// незаполненным (ГУИДВизыЭтапа).
//
// Возвращаемое значение:
//  Строка - уникальный идентификатор.
//
Функция ГУИДВизыЭтап1()
	Возврат СтрокаНастройкиГуида("НСИГУИДВизыЭтап1", ГУИДВизыЭтап1ПоУмолчанию());
КонецФункции

// GUID визы этапа 2 «Анализ БА (утв)» (Справочник.бит_Визы) из настройки
// НСИГУИДВизыЭтап2. Элемента с этим GUID в базе нет - GUID считается
// незаполненным (ГУИДВизыЭтапа).
//
// Возвращаемое значение:
//  Строка - уникальный идентификатор.
//
Функция ГУИДВизыЭтап2()
	Возврат СтрокаНастройкиГуида("НСИГУИДВизыЭтап2", ГУИДВизыЭтап2ПоУмолчанию());
КонецФункции

// GUID визы этапа 1 тестового контура - значение настройки по умолчанию.
Функция ГУИДВизыЭтап1ПоУмолчанию()
	Возврат "e0e10b1c-c227-11f1-8013-005056b8494c";
КонецФункции

// GUID визы этапа 2 тестового контура - значение настройки по умолчанию.
Функция ГУИДВизыЭтап2ПоУмолчанию()
	Возврат "a3130a86-c228-11f1-8013-005056b8494c";
КонецФункции

// Значение настройки-GUID строкой: настройки нет - значение по умолчанию;
// пустая строка или не GUID в настройке - GUID не задан (совместимость: визы
// агента - этап 1), неверное значение - предупреждение в служебный лог.
//
// Параметры:
//  Ключ         - Строка - ключ настройки ar_ДополнительныеНастройки.
//  ПоУмолчанию  - Строка - GUID, если настройки нет.
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаНастройкиГуида(Знач Ключ, Знач ПоУмолчанию)

	Значение = ar_Настройки.ЗначениеНастройки(Ключ, ПоУмолчанию);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Гуид = СокрЛП(Строка(Значение));
	Если НЕ ПустаяСтрока(Гуид)
		И НЕ СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Гуид) Тогда
		Текст = СтрШаблон(НСтр("ru = 'Настройка %1 = «%2» - не GUID; считается незаполненной.'"),
			Ключ, Гуид);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_guid_invalid", Текст);
		Возврат "";
	КонецЕсли;
	Возврат Гуид;

КонецФункции

// Действующий GUID визы этапа: константа этапа, если элемент справочника
// бит_Визы с этим GUID есть в базе; иначе "" - обрабатывается как
// незаполненное значение (совместимость, п. 1 спеки), в служебный лог -
// предупреждение. Проверка - один раз на этап за время жизни объекта.
//
// Параметры:
//  Этап - Число - 1 или 2.
//
// Возвращаемое значение:
//  Строка - уникальный идентификатор в нижнем регистре или "".
//
Функция ГУИДВизыЭтапа(Знач Этап)

	Если КэшГуидовВизЭтапов = Неопределено Тогда
		КэшГуидовВизЭтапов = Новый Соответствие;
	КонецЕсли;
	Гуид = КэшГуидовВизЭтапов[Этап];
	Если Гуид <> Неопределено Тогда
		Возврат Гуид;
	КонецЕсли;

	Гуид = НРег(СокрЛП(?(Этап = 1, ГУИДВизыЭтап1(), ГУИДВизыЭтап2())));
	Если НЕ ПустаяСтрока(Гуид)
		И НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаПоГуиду("бит_Визы", Гуид)) Тогда
		Текст = СтрШаблон(НСтр("ru = 'Виза этапа %1 с GUID %2 не найдена в справочнике бит_Визы -
			|GUID считается незаполненным (КонстантыGUID).'"), Этап, Гуид);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_guid_not_found", Текст);
		Гуид = "";
	КонецЕсли;
	КэшГуидовВизЭтапов.Вставить(Этап, Гуид);
	Возврат Гуид;

КонецФункции

