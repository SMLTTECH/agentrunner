КонецФункции

// JSON Schema аргументов nsi_set_visa_decision в OpenAI tool-format.
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция СхемаАргументовРешениеПоВизе()

	СвойствоРешения = Новый Структура;
	СвойствоРешения.Вставить("type", "string");
	ДопустимыеРешения = ЭлементыМассиваСхемы("approve", "return", "reject", "handover");
	ДопустимыеРешения.Добавить("restart");
	СвойствоРешения.Вставить("enum", ДопустимыеРешения);
	СвойствоРешения.Вставить("description",
		НСтр("ru = 'approve - согласовано, return - вернуть инициатору на исправление,
			|reject - отклонено окончательно, handover - передать сотруднику НСИ
			|(решение по визе не ставится), restart - только на этапе 2 при next =
			|«restart: ...»: заявка изменена после визы 1, визы сбрасываются и заявка
			|проходит этапы 1 и 2 заново.'"));

	// agentrunner-48 (п. 2.1) -> agentrunner-88: протокол больше не обязателен -
	// протокол решения строит пакет из итога сверки; пункты агента по регламенту
	// передаются при желании для протокола.
	СвойствоПротокола = Новый Структура;
	СвойствоПротокола.Вставить("type", "array");
	СвойствоПротокола.Вставить("description",
		НСтр("ru = 'Необязательно: дополнительные пункты проверки агента по регламенту.
			|Каждый пункт: item - пункт регламента (например «2.2»), check - что проверялось,
			|result - один из «ок», «замечание», «блокирует», «не выполнена», «не применимо»,
			|request_value - значение в заявке, source_value - значение в источнике,
			|source - источник данных.'"));
	СвойствоПротокола.Вставить("items", ЭлементПротоколаСхемы());

	СвойствоReview = Новый Структура;
	СвойствоReview.Вставить("type", "array");
	СвойствоReview.Вставить("description",
		НСтр("ru = 'Ответы по каждому пункту needs_review из nsi_verify_request - обязательны
			|для approve: {id - идентификатор пункта, result - «ok» (замечаний нет) или
			|«remark» (есть замечание), text - пояснение для remark}.'"));
	СвойствоReviewЭлемент = Новый Структура;
	СвойствоReviewЭлемент.Вставить("type", "object");
	СвойствоReviewЭлемент.Вставить("properties",
		СвойстваСхемыПунктаReview());
	СвойствоReviewЭлемент.Вставить("required", ЭлементыМассиваСхемы("id", "result"));
	СвойствоReview.Вставить("items", СвойствоReviewЭлемент);

	Свойства = Новый Структура;
	Свойства.Вставить("request", СвойствоСхемы("string",
		НСтр("ru = 'Навигационная ссылка на заявку НСИ.'")));
	Свойства.Вставить("visa_id", СвойствоСхемы("string",
		НСтр("ru = 'Необязательно: ИД визы (поле visa_id из nsi_pending_visas или
			|nsi_get_request); без него берётся активная виза пользователя агента.'")));
	Свойства.Вставить("decision", СвойствоРешения);
	Свойства.Вставить("comment", СвойствоСхемы("string",
		НСтр("ru = 'Комментарий к решению; обязателен для return, reject и handover
			|(не длиннее 500); для restart не нужен.'")));
	Свойства.Вставить("model_hash", СвойствоСхемы("string",
		НСтр("ru = 'Хеш модели из nsi_get_request; обязателен для любого решения -
			|защищает от правки заявки после чтения.'")));
	Свойства.Вставить("protocol", СвойствоПротокола);
	Свойства.Вставить("review", СвойствоReview);

	Обязательные = Новый Массив;
	Обязательные.Добавить("request");
	Обязательные.Добавить("decision");
	Обязательные.Добавить("model_hash");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФормат("nsi_set_visa_decision",
		НСтр("ru = 'Решение по своей визе заявки НСИ: approve / return / reject / handover (с протоколом проверки).'"), Параметры);

КонецФункции

// Свойства JSON Schema одного пункта review (nsi_set_visa_decision).
//
// Возвращаемое значение:
//  Структура - {id, result, text}.
//
Функция СвойстваСхемыПунктаReview()

	СвойствоИтога = Новый Структура;
	СвойствоИтога.Вставить("type", "string");
	СвойствоИтога.Вставить("enum", ЭлементыМассиваСхемы("ok", "remark"));
	СвойствоИтога.Вставить("description",
		НСтр("ru = 'ok - замечаний по пункту нет, remark - есть замечание (заполни text).'"));

	Свойства = Новый Структура;
	Свойства.Вставить("id", СвойствоСхемы("string",
		НСтр("ru = 'Идентификатор пункта needs_review из ответа nsi_verify_request.'")));
	Свойства.Вставить("result", СвойствоИтога);
	Свойства.Вставить("text", СвойствоСхемы("string",
		НСтр("ru = 'Пояснение для result = remark: что не так и почему (с фрагментом из
			|данных сверки).'")));
	Возврат Свойства;

КонецФункции

// Элемент массива protocol в JSON Schema nsi_set_visa_decision (п. 2.1 спеки).
//
// Возвращаемое значение:
//  Структура - {type: object, properties, required}.
//
Функция ЭлементПротоколаСхемы()

	Свойства = Новый Структура;
	Свойства.Вставить("item", СвойствоСхемы("string",
		НСтр("ru = 'Номер пункта регламента, например «2.2».'")));
	Свойства.Вставить("check", СвойствоСхемы("string",
		НСтр("ru = 'Что проверялось (краткое описание проверки).'")));
	Свойства.Вставить("result", СвойствоСхемы("string",
		НСтр("ru = 'Итог проверки: «ок», «замечание», «блокирует», «не выполнена» или «не применимо».'")));
	Свойства.Вставить("request_value", СвойствоСхемы("string",
		НСтр("ru = 'Значение в заявке (пусто, если не применимо).'")));
	Свойства.Вставить("source_value", СвойствоСхемы("string",
		НСтр("ru = 'Значение в источнике (ЕГРЮЛ, контрагент базы и т. п.).'")));
	Свойства.Вставить("source", СвойствоСхемы("string",
		НСтр("ru = 'Источник данных проверки.'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("item");
	Обязательные.Добавить("check");
	Обязательные.Добавить("result");

	Элемент = Новый Структура;
	Элемент.Вставить("type", "object");
	Элемент.Вставить("properties", Свойства);
	Элемент.Вставить("required", Обязательные);
	Возврат Элемент;

КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
//
// Параметры:
//  Тип      - Строка - тип JSON Schema свойства ("string", "number" и т. п.).
//  Описание - Строка - человекочитаемое описание свойства для LLM.
//
// Возвращаемое значение:
//  Структура - {type, description}.
//
Функция СвойствоСхемы(Знач Тип, Знач Описание)

	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

// Массив строк для свойств enum/required JSON Schema: без пустых значений.
//
// Параметры:
//  Элемент1 - Строка - первое значение.
//  Элемент2 - Строка - второе значение.
//  Элемент3 - Строка - третье значение; может быть не задан.
//  Элемент4 - Строка - четвертое значение; может быть не задан.
//
// Возвращаемое значение:
//  Массив - непустые значения.
//
Функция ЭлементыМассиваСхемы(Знач Элемент1, Знач Элемент2,
	Знач Элемент3 = "", Знач Элемент4 = "")

	Элементы = Новый Массив;
	Элементы.Добавить(Элемент1);
	Элементы.Добавить(Элемент2);
	Если НЕ ПустаяСтрока(Элемент3) Тогда
		Элементы.Добавить(Элемент3);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Элемент4) Тогда
		Элементы.Добавить(Элемент4);
	КонецЕсли;
	Возврат Элементы;

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
//
// Параметры:
//  Имя       - Строка    - полное имя инструмента (с пространством имен).
//  Описание  - Строка    - человекочитаемое описание инструмента для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, ...}).
//
// Возвращаемое значение:
//  Строка - JSON вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)

	ОписаниеФункции = Новый Структура;
	ОписаниеФункции.Вставить("name", Имя);
	ОписаниеФункции.Вставить("description", Описание);
	ОписаниеФункции.Вставить("parameters", Параметры);

	Обертка = Новый Структура;
	Обертка.Вставить("type", "function");
	Обертка.Вставить("function", ОписаниеФункции);
	Возврат ar_JSON.ВЗначениеJSON(Обертка);

КонецФункции

// Настройки пакета (спека agentrunner-30 п. 21): ядро создает недостающие при
// регистрации; существующие значения не перезаписываются.
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Наименование, Описание, ЗначениеПоУмолчанию}.
//
Функция ОписанияНастроекПакета()

	Настройки = Новый Массив;

	Настройки.Добавить(ОписаниеНастройки("НСИИсполнятьЗаявкуИзменения",
		НСтр("ru = 'НСИ: исполнять заявку на изменение после согласования'"),
		НСтр("ru = 'Истина - после решения по визе этапа 2 заявку на изменение, еще не «Исполнена»,
			|исполняет пакет механизмом БИТ (ИсполнитьЗаявку): алгоритм визирования исполняет только
			|ввод нового. Ложь (по умолчанию) - исполнение остается за маршрутом (статус «Утвержден»)
			|или сотрудником НСИ.'"),
		Ложь));

	Настройки.Добавить(ОписаниеНастройки("НСИАгентТолькоВозвращает",
		НСтр("ru = 'НСИ: агент только возвращает (запрет approve)'"),
		НСтр("ru = 'Истина - approve запрещён целиком (отключатель без выпуска пакета),
			|Ложь - approve разрешён.'"),
		Ложь));

	Настройки.Добавить(ОписаниеНастройки("НСИГУИДВизыЭтап1",
		НСтр("ru = 'НСИ: GUID визы этапа 1 «Анализ БА (согл)»'"),
		НСтр("ru = 'Уникальный идентификатор элемента справочника «Визы» (бит_Визы)
			|первого этапа маршрута заявки. В каждой базе свой. Пусто или визы с таким
			|GUID нет - все визы агента считаются этапом 1, approve этапа 2 недоступен.'"),
		ГУИДВизыЭтап1ПоУмолчанию()));

	Настройки.Добавить(ОписаниеНастройки("НСИГУИДВизыЭтап2",
		НСтр("ru = 'НСИ: GUID визы этапа 2 «Анализ БА (утв)»'"),
		НСтр("ru = 'Уникальный идентификатор элемента справочника «Визы» (бит_Визы)
			|второго этапа маршрута заявки (на нем пакет создает банковский счет).
			|В каждой базе свой. Пусто или визы с таким GUID нет - этап 2 агенту
			|недоступен.'"),
		ГУИДВизыЭтап2ПоУмолчанию()));

	Настройки.Добавить(ОписаниеНастройки("НСИДатаНачалаОбработкиЗаявок",
		НСтр("ru = 'НСИ: дата начала обработки заявок агентом'"),
		НСтр("ru = 'Дата документа, начиная с которой агент берет заявки
			|в работу: более старые заявки не попадают ни в очередь агента, ни в выдачу
			|nsi_pending_visas. Значение вводится полем даты (без времени); строковые
			|значения прежних версий (ДД.ММ.ГГГГ или ГГГГММДД) понимаются.
			|Неразборчиво или пусто - 01.11.2026 и запись в служебный лог.'"),
		Дата(2026, 11, 1)));

	// agentrunner-48: источник текста регламента для блока regulation
	// nsi_get_request - навык справочника ar_Навыки по имени.
	Настройки.Добавить(ОписаниеНастройки("НСИНавыкРегламента",
		НСтр("ru = 'НСИ: навык с регламентом проверки'"),
		НСтр("ru = 'Имя навыка (справочник ar_Навыки), из которого nsi_get_request берет
			|разделы регламента по сценарию заявки (блок regulation). Навык не найден
			|или пуст - regulation.error = skill_not_found. По умолчанию -
			|«Регламент проверки контрагента НСИ».'"),
		"Регламент проверки контрагента НСИ"));

	// agentrunner-88: ключевые слова признака «Монополист» - подтверждение
	// признака файлом в nsi_verify_request (план 5.5).
	Настройки.Добавить(ОписаниеНастройки("НСИСловаМонополиста",
		НСтр("ru = 'НСИ: слова признака «Монополист»'"),
		НСтр("ru = 'Группы ключевых слов через «;», слова группы через «,». Заявка с признаком
			|«Монополист» принимается, только если среди её файлов есть документ, в тексте
			|которого найдены все слова хотя бы одной группы (реестр ФАС или решение тендерного
			|комитета). Файл с частью слов - на усмотрение агента (needs_review).'"),
		"реестр,ФАС;естественных монополий;доминирующее положение;тендерный комитет,решение;тендерный комитет,протокол"));
	// agentrunner-89: возврат заявки инициатору на исправление.
	Настройки.Добавить(ОписаниеНастройки("НСИСрокИсправленияЧасов",
		НСтр("ru = 'НСИ: срок исправления заявки, часов'"),
		НСтр("ru = 'Сколько часов заявка ждёт исправления после возврата инициатору
			|или возобновления ожидания. Истёкший срок закрывает ожидание командой
			|ar_СрокиИсправленияЗаявок. По умолчанию 120 (5 дней).'"),
		120));

	Настройки.Добавить(ОписаниеНастройки("НСИИнтервалНапоминанийЧасов",
		НСтр("ru = 'НСИ: интервал напоминаний об исправлении, часов'"),
		НСтр("ru = 'Как часто инициатору напоминается о ждущей исправления заявке.
			|По умолчанию 24 (раз в день).'"),
		24));

	Настройки.Добавить(ОписаниеНастройки("НСИЛимитВозвратов",
		НСтр("ru = 'НСИ: лимит возвратов заявки на исправление'"),
		НСтр("ru = 'Сколько раз одну заявку можно вернуть инициатору на исправление.
			|Возврат сверх лимита отклоняется с return_limit_reached. По умолчанию 3.'"),
		3));

	// agentrunner-213: заявка изменена после визы 1 - визы сбрасываются, заявка
	// проходит этапы заново; сверх лимита - передача сотруднику НСИ.
	Настройки.Добавить(ОписаниеНастройки("НСИЛимитПовторныхЦиклов",
		НСтр("ru = 'НСИ: лимит повторных циклов визирования заявки'"),
		НСтр("ru = 'Сколько раз агент может сбросить визы заявки, изменённой после визы
			|первого этапа, и начать визирование заново (решение restart). Сверх лимита
			|заявка передаётся сотруднику НСИ. По умолчанию 2.'"),
		2));

	Настройки.Добавить(ОписаниеНастройки("НСИВложенияРасширения",
		НСтр("ru = 'НСИ: допустимые расширения вложений заявки'"),
		НСтр("ru = 'Расширения через запятую, которые форма исправления разрешает
			|прикладывать к заявке. Пусто - без ограничения.'"),
		"pdf,jpg,jpeg,png,tif,tiff,doc,docx,xls,xlsx"));

	Настройки.Добавить(ОписаниеНастройки("НСИВложенияМаксМБ",
		НСтр("ru = 'НСИ: максимальный размер вложения, МБ'"),
		НСтр("ru = 'Предельный размер одного вложения формы исправления. По умолчанию 20.'"),
		20));

	// agentrunner-96: признаки заявок автоактуализации (сценария) и повторы ЕГР.
	// Сценарий включен всегда - настройки включения нет (решение человека).
	Настройки.Добавить(ОписаниеНастройки("НСИАктуализацияКомментарий",
		НСтр("ru = 'НСИ: комментарий заявок автоактуализации'"),
		НСтр("ru = 'Значение комментария, которым регламентное задание «БИТ» помечает заявки
			|автоактуализации по ИНН/КПП. Заявка считается заявкой автоактуализации только
			|при точном совпадении.'"),
		"Сформировано автоматически обработкой"));

	Настройки.Добавить(ОписаниеНастройки("НСИАктуализацияАргументация",
		НСтр("ru = 'НСИ: аргументация заявок автоактуализации'"),
		НСтр("ru = 'Значение реквизита «Аргументация (СД)» заявок автоактуализации по ИНН/КПП.
			|Заявка считается заявкой автоактуализации только при точном совпадении.'"),
		"Актуализация статуса по ИНН/КПП"));

	Настройки.Добавить(ОписаниеНастройки("НСИАктуализацияПовторЧасов",
		НСтр("ru = 'НСИ: повтор автоактуализации при недоступном ЕГР (часов)'"),
		НСтр("ru = 'Сколько часов заявку автоактуализации не выдавать агенту после неудачного
			|обращения к сервису ЕГРЮЛ/ЕГРИП.'"),
		6));

	Настройки.Добавить(ОписаниеНастройки("НСИАктуализацияПопытокЕГР",
		НСтр("ru = 'НСИ: попыток обращения к ЕГР при автоактуализации'"),
		НСтр("ru = 'После стольких неудачных обращений к сервису ЕГРЮЛ/ЕГРИП заявка
			|автоактуализации передаётся сотруднику НСИ.'"),
		3));

	// agentrunner-118: повтор обычной заявки при недоступном сервисе ЕГР.
	// Отдельная настройка (не НСИАктуализацияПовторЧасов): для обычных заявок
	// лимита попыток нет - заявка ждёт восстановления сервиса (решение человека).
	Настройки.Добавить(ОписаниеНастройки("НСИПовторПриНедоступномЕГРЧасов",
		НСтр("ru = 'НСИ: повтор при недоступном ЕГР (часов)'"),
		НСтр("ru = 'Сколько часов обычную заявку (не автоактуализацию) не выдавать агенту
			|после сверки при недоступном сервисе ЕГРЮЛ/ЕГРИП: агент завершает работу
			|без решения, заявка возвращается в очередь сама.'"),
		6));

	Возврат Настройки;

КонецФункции

// Конструктор одного описания настройки пакета для ключа Настройки манифеста.
//
// Параметры:
//  Ключ                - Строка - ключ настройки (Код элемента справочника).
//  Наименование        - Строка - наименование настройки для пользователя.
//  Описание            - Строка - описание настройки для пользователя.
//  ЗначениеПоУмолчанию - Строка/Число/Булево/Дата - значение по умолчанию.
//
// Возвращаемое значение:
//  Структура.
//
Функция ОписаниеНастройки(Знач Ключ, Знач Наименование, Знач Описание, Знач ЗначениеПоУмолчанию)

	ОписаниеЭлемента = Новый Структура;
	ОписаниеЭлемента.Вставить("Ключ", Ключ);
	ОписаниеЭлемента.Вставить("Наименование", Наименование);
	ОписаниеЭлемента.Вставить("Описание", Описание);
	ОписаниеЭлемента.Вставить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
	Возврат ОписаниеЭлемента;

КонецФункции

#КонецОбласти

#Область ИнструментСписокЗаявокНаВизе

// Реализация инструмента nsi_pending_visas: один запрос к регистру виз
// (АктивнаяВиза, решение пустое, объект - заявка НСИ), затем по каждой заявке
// кандидата - бит_ВизированиеСервер.ВизыПользователя (пользовательские условия
// виз зависят от объекта, пакетного варианта нет - спека п. 7) и отбор строк;
// заявки, переданные агентом сотруднику НСИ (handover) и не измененные,
// пропускаются (agentrunner-35), include_handed_over возвращает их с полем
// handed_over.
// agentrunner-96: в конец списка, в тот же лимит, добавляются непроведенные
// заявки автоактуализации (stage = "actualize", next = "nsi_actualize_request",
// спека п. 2); отложенные (handover/повтор ЕГР) - как handed_over.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"object_kind": "...", "limit": N,
//                  "include_handed_over": true|false}.
//  Контекст      - Структура - контекст запуска (нужен Агент).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"count","scanned","handed_over_skipped","items":[...],
//  "start_date","start_date_source"} (agentrunner-202) либо {"error", "message"}.
//
Функция ВыполнитьСписокЗаявокНаВизе(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);
	Если Не ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат ОшибкаИнструмента("agent_user_not_set",
			НСтр("ru = 'У агента не заполнен пользователь (реквизит ar_Пользователь справочника
				|ar_Агенты) - отобрать визы нечем.'"));
	КонецЕсли;

	// agentrunner-66 (спека А.5): решение в этом запуске поставлено - модель
	// должна завершить работу, очередь ей больше не нужна.
	Если РешениеВЗапуске(Контекст).Есть Тогда
		Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
	КонецЕсли;

	ИмяОбъекта = ИмяОбъектаИзАргументов(Аргументы);
	Лимит = ЛимитСпискаИзАргументов(Аргументы);
	// agentrunner-88: список показывает и заявки с распознающимися файлами
	// (files_recognizing = true) - очередь не отдаёт их, список сообщает.
	Пропускать = Ложь;
	ВключаяОтложенных = ЗначениеБулево(ЗначениеИзКоллекции(Аргументы, "include_handed_over", Ложь));

	ОтборСтрок = ЗаявкиНаВизеАгента(ПользовательАгента, ИмяОбъекта, Лимит,
		АгентИзКонтекста(Контекст), ВключаяОтложенных, Пропускать);

	УникальныеЗаявки = ЗаявкиИзСтрок(ОтборСтрок.Строки);
	ШапкиЗаявок = РеквизитыЗаявокШапки(УникальныеЗаявки);

	// agentrunner-88: визы неизвестного этапа заявке не даются (не в очередь и
	// не в список); факт - в служебный лог.
	Для Каждого СтрокаНеИзвестногоЭтапа Из ОтборСтрок.СтрокиНеИзвестногоЭтапа Цикл
		ЛогНеизвестногоЭтапа(СтрокаНеИзвестногоЭтапа);
	КонецЦикла;

	Элементы = Новый Массив;
	СценарииПоЗаявкам = Новый Соответствие;
	Для Каждого СтрокаКандидата Из ОтборСтрок.Строки Цикл
		Шапка = ШапкиЗаявок.Получить(СтрокаКандидата.Заявка);
		Если Шапка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Модель и сценарий считаются один раз на заявку (виз агента может быть
		// несколько, чтение хранилища - десериализация).
		Сценарий = СценарииПоЗаявкам.Получить(СтрокаКандидата.Заявка);
		Если Сценарий = Неопределено Тогда
			МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
			Сценарий = СценарийЗаявки(Шапка, МодельСтало);
			// agentrunner-96: проведенная заявка сценария (виза 2) - сценарий
			// actualize, обрабатывается nsi_actualize_request (спека п. 2).
			Если ЭтоЗаявкаАктуализации(Шапка) Тогда
				Сценарий = "actualize";
			КонецЕсли;
			СценарииПоЗаявкам.Вставить(СтрокаКандидата.Заявка, Сценарий);
		КонецЕсли;
		Элементы.Добавить(ЭлементСпискаЗаявок(СтрокаКандидата, Шапка, Сценарий));
	КонецЦикла;

	// agentrunner-96: непроведенные заявки автоактуализации - после заявок
	// на визе, в тот же лимит (спека п. 2).
	ПропущеноАктуализации = 0;
	ДополнитьСписокЗаявкамиАктуализации(Контекст, Лимит, ВключаяОтложенных, Элементы,
		ПропущеноАктуализации);

	// agentrunner-202: применённая дата начала и её источник - в ответе, чтобы
	// модель видела причину пустой очереди (инцидент 2c8c5f3b). Дата та же,
	// по которой отфильтрованы заявки (одна настройка, разбор детерминирован).
	РазборДаты = РазборДатыНачалаОбработкиЗаявок();

	Ответ = Новый Структура;
	Ответ.Вставить("count", Элементы.Количество());
	Ответ.Вставить("scanned", ОтборСтрок.ПросмотреноЗаявок);
	Ответ.Вставить("handed_over_skipped",
		ОтборСтрок.ПропущеноОтложенных + ПропущеноАктуализации);
	Ответ.Вставить("items", Элементы);
	Ответ.Вставить("start_date", Формат(НачалоДня(РазборДаты.Дата), "ДФ=yyyy-MM-dd"));
	Ответ.Вставить("start_date_source", РазборДаты.Источник);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Разбирает аргумент object_kind: имя объекта обмена заявок; по умолчанию
// «Контрагенты», пустая строка - все заявки НСИ (спека п. 6).
Функция ИмяОбъектаИзАргументов(Знач Аргументы)

	ИмяОбъекта = ЗначениеИзКоллекции(Аргументы, "object_kind", "Контрагенты");
	Если ТипЗнч(ИмяОбъекта) <> Тип("Строка") Тогда
		Возврат "Контрагенты";
	КонецЕсли;
	Возврат СокрЛП(ИмяОбъекта);

КонецФункции

// Разбирает аргумент limit: 1..50, по умолчанию 10 (спека п. 6).
Функция ЛимитСпискаИзАргументов(Знач Аргументы)

	Лимит = ЗначениеИзКоллекции(Аргументы, "limit", ЛимитСпискаПоУмолчанию());
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Возврат ЛимитСпискаПоУмолчанию();
	КонецЕсли;
	Возврат Макс(Мин(Окр(Лимит), ПредельныйЛимитСписка()), 1);

КонецФункции

// Лимит заявок по умолчанию (спека п. 6).
Функция ЛимитСпискаПоУмолчанию()
	Возврат 10;
КонецФункции

// Предельный лимит заявок за вызов (спека п. 6).
Функция ПредельныйЛимитСписка()
	Возврат 50;
КонецФункции

// Один запрос к регистру бит_УстановленныеВизы: активные визы без решения по
// заявкам НСИ (не помеченным на удаление) с датой документа не раньше даты
// начала обработки из настройки пакета НСИДатаНачалаОбработкиЗаявок
// (agentrunner-41) - условие в ГДЕ, до ПЕРВЫЕ 200: старые заявки не занимают
// места в лимите кандидатов; порядок - ДатаКрайняя (пустые в конце), затем
// дата заявки; не больше 200 кандидатов (спека п. 7).
// agentrunner-88 - два анти-соединения в тексте запроса:
//   * заявки исключённых внешних систем (Р23): ЛЕВОЕ СОЕДИНЕНИЕ с регистром
//     sd_СоответствиеОбъектовВнешнихСистем по ВЫРАЗИТЬ составного поля СсылкаБФ
//     и системе из констант пакета; условие ЕСТЬ NULL - соединяемых записей нет;
//     внутреннее соединение не подходит - оставило бы только связанные заявки,
//     подзапрос В (ВЫБРАТЬ) не используется;
//   * файлы, которые распознавание ещё обработает (п. 4 спеки): ЛЕВОЕ
//     СОЕДИНЕНИЕ со справочником файлов заявки (молодой неподготовленный файл);
//     для очереди (ПропускатьОжидающихРаспознавание) - ЕСТЬ NULL, заявка не
//     выдаётся; для списка - без ЕСТЬ NULL, наличие файла помечается полем
//     ФайлОжидаетРаспознавание (files_recognizing ответа).
// Файлы с текстом (Извлечен), неудачным распознаванием (ИзвлечьНеУдалось),
// зашифрованные, с неподдерживаемым расширением и старше
// МаксОжиданиеРаспознаванияЧасов заявку не держат. Один файл даёт одну строку
// кандидата, повторяющиеся строки (несколько файлов) снимаются по ключу визы.
//
// Параметры:
//  ИмяОбъекта - Строка  - отбор Заявки.ОписаниеОбъекта.Имя; "" - без отбора.
//  ДляОчереди - Булево  - заявки с распознающимися файлами не возвращаются
//               (метод очереди ar_ОбъектыКОбработке); Ложь - возвращаются с
//               признаком (nsi_pending_visas).
//
// Возвращаемое значение:
//  Массив из Структура {Заявка, Виза, ВизаПредставление, ИДВизы, ДатаКрайняя,
//  ФайлОжидаетРаспознавание}.
//
Функция СтрокиКандидатовНаВизе(Знач ИмяОбъекта, Знач ДляОчереди)

	// Отбор по имени объекта - явным соединением вместо разыменования через
	// точку (стандарт: соединение по ссылочному полю).
	СоединениеОписаний = "";
	УсловиеИмени = "";
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		СоединениеОписаний = Символы.ПС
			+ "		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок"
			+ Символы.ПС
			+ "		ПО Заявки.ОписаниеОбъекта = ОписанияЗаявок.Ссылка";
		УсловиеИмени = Символы.ПС + "	И ОписанияЗаявок.Имя = &ИмяОбъекта";
	КонецЕсли;

	УсловиеОжидания = ?(ДляОчереди, Символы.ПС + "	И ФайлНаРаспознавании.Ссылка ЕСТЬ NULL", "");
	УсловиеИсключения = Символы.ПС + "	И СоответствиеВИС.ВнешняяИнформационнаяСистема ЕСТЬ NULL";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
		|	Визы.Объект КАК Заявка,
		|	Визы.Виза КАК Виза,
		|	ПРЕДСТАВЛЕНИЕ(Визы.Виза) КАК ВизаПредставление,
		|	Визы.ИД КАК ИДВизы,
		|	Визы.ДатаКрайняя КАК ДатаКрайняя,
		|	Заявки.Дата КАК ДатаЗаявки,
		|	ВЫБОР
		|		КОГДА ФайлНаРаспознавании.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ФайлОжидаетРаспознавание
		|ИЗ
		|	РегистрСведений.бит_УстановленныеВизы КАК Визы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ПО Визы.Объект = Заявки.Ссылка"
		+ СоединениеОписаний
		+ "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.sd_СоответствиеОбъектовВнешнихСистем КАК СоответствиеВИС
		|		ПО ВЫРАЗИТЬ(СоответствиеВИС.СсылкаБФ КАК Документ.бит_мдм_ЗаявкаНаИзменение) = Заявки.Ссылка
		|			И СоответствиеВИС.ВнешняяИнформационнаяСистема В (&ИсключенныеСистемы)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК ФайлНаРаспознавании
		|		ПО ФайлНаРаспознавании.ВладелецФайла = Заявки.Ссылка
		|			И НЕ ФайлНаРаспознавании.ПометкаУдаления
		|			И ФайлНаРаспознавании.СтатусИзвлеченияТекста = ЗНАЧЕНИЕ(Перечисление.СтатусыИзвлеченияТекстаФайлов.НеИзвлечен)
		|			И НЕ ФайлНаРаспознавании.Зашифрован
		|			И ФайлНаРаспознавании.Расширение В (&РасширенияРаспознавания)
		|			И ФайлНаРаспознавании.ДатаСоздания > &ГраницаОжидания
		|ГДЕ
		|	Визы.АктивнаяВиза
		|	И Визы.Решение = ЗНАЧЕНИЕ(Справочник.бит_ВидыРешенийСогласования.ПустаяСсылка)
		|	И НЕ Заявки.ПометкаУдаления
		|	И Заявки.Дата >= &ДатаНачала"
		+ УсловиеИсключения
		+ УсловиеИмени
		+ УсловиеОжидания
		+ "
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА Визы.ДатаКрайняя = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 1
		|	ИНАЧЕ 0
		|	КОНЕЦ,
		|	Визы.ДатаКрайняя,
		|	Заявки.Дата";

	// Дата документа заявки - параметром (agentrunner-41); значение из настройки
	// пакета, неверное значение молча заменяется датой по умолчанию.
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОбработкиЗаявок());
	Запрос.УстановитьПараметр("ИсключенныеСистемы", СсылкиИсключенныхВнешнихСистем());
	Запрос.УстановитьПараметр("РасширенияРаспознавания", РасширенияРаспознавания());
	Запрос.УстановитьПараметр("ГраницаОжидания", ГраницаОжиданияРаспознавания());

	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	КонецЕсли;

	Строки = Новый Массив;
	ВыданныеКлючи = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Несколько распознающихся файлов дают одинаковые строки - снимаем
		// по ключу визы (Объект + ИД uniquely identifies запись регистра).
		КлючСтроки = Строка(Выборка.Заявка) + "|" + Строка(Выборка.ИДВизы);
		Если ВыданныеКлючи.Получить(КлючСтроки) = Истина Тогда
			Продолжить;
		КонецЕсли;
		ВыданныеКлючи.Вставить(КлючСтроки, Истина);
		СтрокаКандидата = Новый Структура;
		СтрокаКандидата.Вставить("Заявка", Выборка.Заявка);
		СтрокаКандидата.Вставить("Виза", Выборка.Виза);
		СтрокаКандидата.Вставить("ВизаПредставление", Выборка.ВизаПредставление);
		СтрокаКандидата.Вставить("ИДВизы", Выборка.ИДВизы);
		СтрокаКандидата.Вставить("ДатаКрайняя", ?(ЗначениеЗаполнено(Выборка.ДатаКрайняя),
			Выборка.ДатаКрайняя, Неопределено));
		СтрокаКандидата.Вставить("ДатаЗаявки", Выборка.ДатаЗаявки);
		СтрокаКандидата.Вставить("ФайлОжидаетРаспознавание", Выборка.ФайлОжидаетРаспознавание);
		Строки.Добавить(СтрокаКандидата);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Ссылки исключённых внешних систем по GUID из области КонстантыGUID: константы
// пакета в ссылках (Р23). Неизвестный GUID даёт пустую ссылку - в соединении
// пустая ссылка совпадений не даёт (ВнешняяИнформационнаяСистема заполнена).
// Плюс предопределённый элемент CRM: его ссылка в каждой базе своя, поэтому он
// берётся по имени предопределённого, а не по GUID.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.sd_ВнешниеИнформационныеСистемы - ссылки систем,
//  заявки которых агенту не выдаются.
//
Функция СсылкиИсключенныхВнешнихСистем()

	Ссылки = Новый Массив;
	Для Каждого Гуид Из ГУИДыИсключенныхВнешнихСистем() Цикл
		Ссылки.Добавить(СсылкаПоГуиду("sd_ВнешниеИнформационныеСистемы", Гуид));
	КонецЦикла;
	Ссылки.Добавить(Справочники.sd_ВнешниеИнформационныеСистемы.CRM);
	Возврат Ссылки;

КонецФункции

// Расширения файлов, которые распознавание ещё возьмёт в работу: тот же список,
// что у предварительного распознавания пакета ar_ПакетПрисоединённыеФайлы
// (РасширенияСервиса, спека agentrunner-74 п.Б.5; функция пакета не экспортная,
// список повторён здесь - при изменении списка править оба места).
//
// Возвращаемое значение:
//  Массив из Строка - расширения в нижнем регистре, без точки.
//
Функция РасширенияРаспознавания()

	Расширения = Новый Массив;
	Расширения.Добавить("pdf");
	Расширения.Добавить("rtf");
	Расширения.Добавить("tif");
	Расширения.Добавить("tiff");
	Расширения.Добавить("jpg");
	Расширения.Добавить("jpeg");
	Расширения.Добавить("png");
	Расширения.Добавить("gif");
	Расширения.Добавить("bmp");
	Расширения.Добавить("xls");
	Расширения.Добавить("xlsx");
	Расширения.Добавить("docx");
	Расширения.Добавить("odt");
	Расширения.Добавить("ods");
	Расширения.Добавить("txt");
	Расширения.Добавить("xml");
	Расширения.Добавить("htm");
	Расширения.Добавить("html");
	Возврат Расширения;

КонецФункции

// Граница ожидания распознавания: файлы, созданные раньше её, заявку не
// удерживают (п. 4 спеки) - текущая дата сеанса минус МаксОжиданиеРаспознаванияЧасов.
//
// Возвращаемое значение:
//  Дата.
//
Функция ГраницаОжиданияРаспознавания()

	// Секунды в часе.
	СекундВЧасе = 3600;
	Возврат ТекущаяДатаСеанса() - МаксОжиданиеРаспознаванияЧасов() * СекундВЧасе;

КонецФункции

// Заявка связана с исключённой внешней системой (Р23): в регистре
// sd_СоответствиеОбъектовВнешнихСистем есть запись СсылкаБФ = заявка и система
// из констант пакета. Тот же отбор, что анти-соединением в запросе кандидатов;
// защита всех инструментов: по исключённой заявке - отказ
// request_excluded_external_system, ничего не пишется.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаявкаИсключена(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.УстановитьПараметр("ИсключенныеСистемы", СсылкиИсключенныхВнешнихСистем());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Истина КАК ЕстьЗапись
		|ИЗ
		|	РегистрСведений.sd_СоответствиеОбъектовВнешнихСистем КАК Соответствие
		|ГДЕ
		|	ВЫРАЗИТЬ(Соответствие.СсылкаБФ КАК Документ.бит_мдм_ЗаявкаНаИзменение) = &Ссылка
		|	И Соответствие.ВнешняяИнформационнаяСистема В (&ИсключенныеСистемы)";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Оставляет строки кандидатов, чья виза входит в визы пользователя агента:
// бит_ВизированиеСервер.ВизыПользователя вызывается один раз на заявку
// (пользовательские условия виз зависят от объекта - спека п. 7); остановка,
// когда набран лимит. Без привязки к наименованию визы (решение Р10).
// Строки с действующей отметкой отложения (agentrunner-35: ключ отметки = ИД
// визы строки и текущий model_hash = отпечатку) пропускаются, не расходуя
// Лимит; при ВключаяОтложенных остаются и помечаются полями
// ОтложеноВ/ОтложеноПричина.
// agentrunner-88: строки с визой неизвестного этапа (не из констант GUID)
// пропускаются всегда - заявка не попадает ни в очередь, ни в список
// (visa_stage_unknown); они собираются в СтрокиНеИзвестногоЭтапа для
// служебного лога.
//
// Параметры:
//  СтрокиКандидатов   - Массив - результат СтрокиКандидатовНаВизе.
//  ПользовательАгента - СправочникСсылка.Пользователи - пользователь агента.
//  Лимит              - Число  - предельное число строк ответа.
//  Отложенные         - Соответствие - "Заявка -> Структура {Ключ, Отпечаток,
//                       ОтложенВ, Причина}" - отметки отложения (пустое - нет).
//  ХешиОтпечатков     - Соответствие - "Заявка -> Строка" - текущие model_hash.
//  ВключаяОтложенных  - Булево - отмеченные строки не пропускаются
//                       (include_handed_over).
//
// Возвращаемое значение:
//  Структура:
//   * Строки                - Массив - строки кандидатов с визой агента (не больше Лимит).
//   * ПросмотреноЗаявок     - Число  - заявок, для которых проверялись визы агента.
//   * ПропущеноОтложенных   - Число  - строк, пропущенных по отметке отложения.
//   * СтрокиНеИзвестногоЭтапа - Массив - строки с визой вне этапов констант GUID.
//
Функция СтрокиСВизойАгента(Знач СтрокиКандидатов, Знач ПользовательАгента, Знач Лимит,
	Знач Отложенные, Знач ХешиОтпечатков, Знач ВключаяОтложенных)

	ОтобранныеСтроки = Новый Массив;
	СтрокиНеИзвестногоЭтапа = Новый Массив;
	СпискиВизПоЗаявкам = Новый Соответствие;
	ПропущеноОтложенных = 0;

	Для Каждого СтрокаКандидата Из СтрокиКандидатов Цикл

		ОтметкаОтложения = ОтложеноОтметкаСтроки(СтрокаКандидата, Отложенные, ХешиОтпечатков);
		Если ОтметкаОтложения <> Неопределено Тогда
			СтрокаКандидата.Вставить("ОтложеноВ", ОтметкаОтложения.ОтложенВ);
			СтрокаКандидата.Вставить("ОтложеноПричина", ОтметкаОтложения.Причина);
			Если НЕ ВключаяОтложенных Тогда
				ПропущеноОтложенных = ПропущеноОтложенных + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// agentrunner-88: виза не из этапов маршрута - заявка агенту не даётся.
		Если ЭтапВизыПоСсылке(СтрокаКандидата.Виза) = 0 Тогда
			СтрокиНеИзвестногоЭтапа.Добавить(СтрокаКандидата);
			Продолжить;
		КонецЕсли;

		Если ОтобранныеСтроки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		СписокВиз = СпискиВизПоЗаявкам.Получить(СтрокаКандидата.Заявка);
		Если СписокВиз = Неопределено Тогда
			// ВЫБРАТЬ РАЗРЕШЕННЫЕ внутри ВизыПользователя; условия виз проверяются
			// по конкретному объекту - запрос в цикле здесь неизбежен и ограничен
			// 200 кандидатами и лимитом ответа (спека п. 7).
			СписокВиз = бит_ВизированиеСервер.ВизыПользователя(ПользовательАгента,
				СтрокаКандидата.Заявка);
			СпискиВизПоЗаявкам.Вставить(СтрокаКандидата.Заявка, СписокВиз);
		КонецЕсли;

		Если СписокВиз.НайтиПоЗначению(СтрокаКандидата.Виза) <> Неопределено Тогда
			ОтобранныеСтроки.Добавить(СтрокаКандидата);
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Строки", ОтобранныеСтроки);
	Результат.Вставить("ПросмотреноЗаявок", СпискиВизПоЗаявкам.Количество());
	Результат.Вставить("ПропущеноОтложенных", ПропущеноОтложенных);
	Результат.Вставить("СтрокиНеИзвестногоЭтапа", СтрокиНеИзвестногоЭтапа);
	Возврат Результат;

КонецФункции

// Этап визы по константам GUID (п. 3 спеки): 1 - виза этапа 1 («Анализ БА
// (согл)»), 2 - виза этапа 2 («Анализ БА (утв)»), 0 - иная виза
// (visa_stage_unknown). Пустые константы GUID или виз с такими GUID нет в
// базе - совместимость: все визы считаются этапом 1, approve этапа 2 недоступен.
//
// Параметры:
//  ВизаСсылка - СправочникСсылка.бит_Визы.
//
// Возвращаемое значение:
//  Число - 1, 2 или 0.
//
Функция ЭтапВизыПоСсылке(Знач ВизаСсылка)

	ГуидЭтапа1 = ГУИДВизыЭтапа(1);
	ГуидЭтапа2 = ГУИДВизыЭтапа(2);
	Если ПустаяСтрока(ГуидЭтапа1) И ПустаяСтрока(ГуидЭтапа2) Тогда
		Возврат 1; // Совместимость: GUID не заполнены или виз нет в базе.
	КонецЕсли;

	ГуидВизы = НРег(Строка(ВизаСсылка.УникальныйИдентификатор()));
	Если ГуидВизы = ГуидЭтапа1 Тогда
		Возврат 1;
	ИначеЕсли ГуидВизы = ГуидЭтапа2 Тогда
		Возврат 2;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Ссылка визы этапа из констант GUID (для сравнения записей виз и установки
// решений); пустые константы - пустая ссылка.
//
// Параметры:
//  Этап - Число - 1 или 2.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_Визы.
//
Функция СсылкаВизыЭтапа(Знач Этап)

	Если Этап = 1 Тогда
		Возврат СсылкаПоГуиду("бит_Визы", ГУИДВизыЭтапа(1));
	ИначеЕсли Этап = 2 Тогда
		Возврат СсылкаПоГуиду("бит_Визы", ГУИДВизыЭтапа(2));
	КонецЕсли;

	Возврат Справочники.бит_Визы.ПустаяСсылка();

КонецФункции

// Служебный лог визы вне этапов маршрута (visa_stage_unknown): заявка, виза,
// представление визы. Вызывается из списка заявок - очередь пропускает такие
// строки без записи, чтобы не писать в лог каждую минуту.
//
// Параметры:
//  СтрокаКандидата - Структура - строка из СтрокиКандидатовНаВизе.
//
Процедура ЛогНеизвестногоЭтапа(Знач СтрокаКандидата)

	Текст = СтрШаблон(НСтр("ru = '%1: активная виза %2 не входит в этапы маршрута
		|(КонстантыGUID) - заявка агенту не выдаётся.'"),
		Строка(СтрокаКандидата.Заявка), СтрокаКандидата.ВизаПредставление);
	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_stage_unknown", Текст);

КонецПроцедуры

// Действует ли отметка отложения для строки кандидата (п. 4 спеки
// agentrunner-35): отметка есть, отпечаток равен текущему model_hash заявки,
// ключ - ИД визы строки (handover, agentrunner-35) либо ключ недоступного ЕГР
// (agentrunner-118: действует до ОтложенВ + НСИПовторПриНедоступномЕГРЧасов -
// сервис восстановился, заявка выдаётся). Заявка изменена или визу
// переназначили - отметка устарела, строка остается в выдаче (перезапишется
// при следующем handover либо останется без действия - безвредно).
//
// Параметры:
//  СтрокаКандидата   - Структура - строка из СтрокиКандидатовНаВизе.
//  Отложенные        - Соответствие - отметки отложения по заявкам.
//  ХешиОтпечатков    - Соответствие - "Заявка -> Строка" текущих model_hash.
//
// Возвращаемое значение:
//  Структура {Ключ, Отпечаток, ОтложенВ, Причина} - действующая отметка;
//  Неопределено - отметки нет или она не действует для этой строки.
//
Функция ОтложеноОтметкаСтроки(Знач СтрокаКандидата, Знач Отложенные, Знач ХешиОтпечатков)

	Отметка = Отложенные.Получить(СтрокаКандидата.Заявка);
	Если Отметка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекущийХеш = ХешиОтпечатков.Получить(СтрокаКандидата.Заявка);
	Если ТекущийХеш <> Отметка.Отпечаток Тогда
		Возврат Неопределено;
	КонецЕсли;

	// agentrunner-118: отложение при недоступном ЕГР - только до ОтложенВ +
	// НСИПовторПриНедоступномЕГРЧасов (у обычной заявки лимита попыток нет).
	Если Отметка.Ключ = КлючОтложенияНедоступностиЕГР() Тогда
		СекундВЧасе = 3600;
		Возврат ?(ТекущаяДатаСеанса()
			< Отметка.ОтложенВ + ПовторПриНедоступномЕГРЧасов() * СекундВЧасе,
			Отметка, Неопределено);
	КонецЕсли;

	Если Отметка.Ключ <> СтрокаКандидата.ИДВизы Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Отметка;

КонецФункции

// Уникальные заявки из строк кандидатов, в порядке отбора (для одного пакетного
// запроса шапок).
//
// Возвращаемое значение:
//  Массив ссылок на заявки.
//
Функция ЗаявкиИзСтрок(Знач СтрокиКандидатов)

	Уникальные = Новый Соответствие;
	Заявки = Новый Массив;
	Для Каждого СтрокаКандидата Из СтрокиКандидатов Цикл
		Если Уникальные.Получить(СтрокаКандидата.Заявка) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(СтрокаКандидата.Заявка, Истина);
		Заявки.Добавить(СтрокаКандидата.Заявка);
	КонецЦикла;
	Возврат Заявки;

КонецФункции

// Шапки заявок одним пакетным запросом: служебные поля, инициатор, предмет и
// хранилища моделей (реквизитов контрагента в шапке нет - они в модели, см.
// mcp.md [P3] «Реквизиты шапки со стенда»). agentrunner-96: комментарий,
// аргументация, проведенность и имя объекта обмена - признаки заявки
// автоактуализации (ЭтоЗаявкаАктуализации).
//
// Параметры:
//  Заявки - Массив ссылок на заявки НСИ.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Номер, Дата, ВидОперации,
//  ИмяОбъекта, Предмет, ПредметПредставление, Инициатор, ИнициаторПредставление,
//  Ответственный, ОтветственныйПредставление, Проведен, ПометкаУдаления,
//  Комментарий, сд_Аргументация, ХранилищеМодельОбъекта, ХранилищеМодельОбъектаПред}.
//
Функция РеквизитыЗаявокШапки(Знач Заявки)

	Шапки = Новый Соответствие;
	Если Заявки.Количество() = 0 Тогда
		Возврат Шапки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявки", Заявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	Т.Дата КАК Дата,
		|	Т.ВидОперации КАК ВидОперации,
		|	ЕСТЬNULL(ОписанияЗаявок.Имя, """") КАК ИмяОбъекта,
		|	Т.Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(Т.Предмет) КАК ПредметПредставление,
		|	Т.сд_Инициатор КАК Инициатор,
		|	ПРЕДСТАВЛЕНИЕ(Т.сд_Инициатор) КАК ИнициаторПредставление,
		|	Т.Ответственный КАК Ответственный,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ответственный) КАК ОтветственныйПредставление,
		|	Т.Проведен КАК Проведен,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.Комментарий КАК Комментарий,
		|	Т.сд_Аргументация КАК сд_Аргументация,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	Т.ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок
		|		ПО Т.ОписаниеОбъекта = ОписанияЗаявок.Ссылка
		|ГДЕ
		|	Т.Ссылка В (&Заявки)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = Новый Структура;
		Шапка.Вставить("Ссылка", Выборка.Ссылка);
		Шапка.Вставить("Номер", Выборка.Номер);
		Шапка.Вставить("Дата", Выборка.Дата);
		Шапка.Вставить("ВидОперации", Выборка.ВидОперации);
		Шапка.Вставить("ИмяОбъекта", Выборка.ИмяОбъекта);
		Шапка.Вставить("Предмет", Выборка.Предмет);
		Шапка.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		Шапка.Вставить("Инициатор", Выборка.Инициатор);
		Шапка.Вставить("ИнициаторПредставление", Выборка.ИнициаторПредставление);
		Шапка.Вставить("Ответственный", Выборка.Ответственный);
		Шапка.Вставить("ОтветственныйПредставление", Выборка.ОтветственныйПредставление);
		Шапка.Вставить("Проведен", Выборка.Проведен);
		Шапка.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		Шапка.Вставить("Комментарий", Выборка.Комментарий);
		Шапка.Вставить("сд_Аргументация", Выборка.сд_Аргументация);
		Шапка.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		Шапка.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Шапки.Вставить(Выборка.Ссылка, Шапка);
	КонецЦикла;

	Возврат Шапки;

КонецФункции

// Элемент массива items ответа nsi_pending_visas (спека п. 8; agentrunner-35:
// для строки с действующей отметкой handover, если include_handed_over -
// добавляется поле handed_over {at, comment}). agentrunner-88: этап визы
// (stage), files_recognizing (файлы ещё распознаются) и next - следующий шаг.
//
// Параметры:
//  СтрокаКандидата - Структура - строка из СтрокиКандидатовНаВизе (после
//                    СтрокиСВизойАгента может содержать ОтложеноВ/ОтложеноПричина).
//  Шапка           - Структура - шапка заявки из РеквизитыЗаявокШапки.
//  Сценарий        - Строка    - сценарий заявки (п. 4 спеки).
//
// Возвращаемое значение:
//  Структура - {request, request_presentation, request_date, operation, scenario,
//  initiator, visa, visa_id, stage, files_recognizing, next, due_date[,
//  handed_over]}.
//
Функция ЭлементСпискаЗаявок(Знач СтрокаКандидата, Знач Шапка, Знач Сценарий)

	Элемент = Новый Структура;
	Элемент.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаКандидата.Заявка));
	Элемент.Вставить("request_presentation", Строка(СтрокаКандидата.Заявка));
	Элемент.Вставить("request_date", Шапка.Дата);
	Элемент.Вставить("operation", ОперацияСценария(Шапка));
	Элемент.Вставить("scenario", Сценарий);
	Элемент.Вставить("initiator", ИнициаторЗаявкиСтрокой(Шапка));
	Элемент.Вставить("visa", СтрокаКандидата.ВизаПредставление);
	Элемент.Вставить("visa_id", СтрокаКандидата.ИДВизы);
	Элемент.Вставить("stage", ЭтапВизыПоСсылке(СтрокаКандидата.Виза));
	Элемент.Вставить("files_recognizing", СтрокаКандидата.ФайлОжидаетРаспознавание);
	// Оба этапа начинают с чтения заявки (этап 2 - через nsi_get_request, п. 3).
	Элемент.Вставить("next", "nsi_get_request");
	Элемент.Вставить("due_date", СтрокаКандидата.ДатаКрайняя);

	ОтложеноВ = Неопределено;
	СтрокаКандидата.Свойство("ОтложеноВ", ОтложеноВ);
	Если ОтложеноВ <> Неопределено Тогда
		ОтложеноПричина = "";
		СтрокаКандидата.Свойство("ОтложеноПричина", ОтложеноПричина);
		Элемент.Вставить("handed_over",
			Новый Структура("at, comment", ОтложеноВ, ОтложеноПричина));
	КонецЕсли;

	Возврат Элемент;

КонецФункции

// Инициатор заявки в виде строки: сд_Инициатор, при пустом - Ответственный.
Функция ИнициаторЗаявкиСтрокой(Знач Шапка)

	Если ЗначениеЗаполнено(Шапка.Инициатор) Тогда
		Возврат Шапка.ИнициаторПредставление;
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка.Ответственный) Тогда
		Возврат Шапка.ОтветственныйПредставление;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ИнструментЧтениеЗаявки

// Реализация инструмента nsi_get_request (спека п. 9-10): пакетный запрос шапки
// и подчиненных объектов, разбор моделей «было/стало», визы документа, хеш
// моделей «стало».
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"request": "<навигационная ссылка>"}.
//  Контекст      - Структура - контекст запуска (не используется, чтение).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"request", "number", "request_date", "status",
//  "operation", "scenario", "counterparty", "header", "fields", "tables",
//  "subordinate", "visas", "model_hash"} либо {"error", "message"}.
//
Функция ВыполнитьЧтениеЗаявки(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			?(ПустаяСтрока(ОтборЗаявки.Сообщение), ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение));
	КонецЕсли;
	СсылкаЗаявки = ОтборЗаявки.Ссылка;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - отказ до чтения.
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, СсылкаЗаявки);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
	КонецЕсли;

	// agentrunner-66 (спека А.5): решение в этом запуске уже поставлено -
	// чтение другой заявки бессмысленно, модель должна завершить работу.
	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть И Решение.СсылкаЗаявки <> СсылкаЗаявки Тогда
		Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
	КонецЕсли;

	// agentrunner-88: исключённые внешние системы и этап активной визы агента
	// (visa_stage_unknown - заявка агенту не выдаётся).
	Если ЗаявкаИсключена(СсылкаЗаявки) Тогда
		Возврат ОшибкаИнструмента("request_excluded_external_system", ТекстЗаявкаИсключена(), Истина);
	КонецЕсли;

	ВизаАгента = АктивнаяВизаАгента(Контекст, СсылкаЗаявки);
	Если ВизаАгента.Найдена И ВизаАгента.Этап = 0 Тогда
		ЛогНеизвестногоЭтапаЗаявки(СсылкаЗаявки, ВизаАгента.Виза);
		Возврат ОшибкаИнструмента("visa_stage_unknown",
			НСтр("ru = 'Виза агента не входит в этапы маршрута (КонстантыGUID) - заявка
				|агенту не выдаётся.'"));
	КонецЕсли;

	ДанныеЗаявки = ДанныеЗаявки(СсылкаЗаявки);
	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		// Заявку могли удалить или скрыть правами между проверкой доступа и чтением.
		Возврат ОшибкаИнструмента("request_not_found", ТекстЗаявкаНеНайдена());
	КонецЕсли;

	// agentrunner-96: заявка автоактуализации - сценарий "actualize", шаг -
	// nsi_actualize_request; данные этапа 2 (счет, сверка) для сценария не нужны.
	ЭтоАктуализация = ЭтоЗаявкаАктуализации(ДанныеЗаявки.Шапка);

	// agentrunner-108 (запуск 9a271298): активной визы агента нет - заявка не на
	// точке визирования, работать нечего; ранний отказ без тяжёлых блоков ответа
	// (и без десериализации моделей ниже). Заявки автоактуализации (визы
	// регламентного задания) и full = true (диагностика, чтение для человека) -
	// как раньше.
	Если НЕ ВизаАгента.Найдена И НЕ ЭтоАктуализация
		И НЕ ЗначениеБулево(ЗначениеИзКоллекции(Аргументы, "full", Ложь)) Тогда
		Возврат ar_JSON.ВЗначениеJSON(ОтветБезАктивнойВизы(СсылкаЗаявки));
	КонецЕсли;
	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	МодельПред  = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъектаПред);
	ДляСоздания = (ДанныеЗаявки.Шапка.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);

	ВизыИСтатус = ВизыВОтвет(СсылкаЗаявки, ?(ВизаАгента.Найдена, ВизаАгента.ИД, ""));

	Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);
	Если ЭтоАктуализация Тогда
		Сценарий = "actualize";
	КонецЕсли;
	ХешТекущий = ХешМоделейЗаявки(МодельСтало, ДанныеЗаявки.Подчиненные);

	// agentrunner-66 (спека А.4): повторное чтение той же заявки в этом запуске
	// при неизменном model_hash - краткий ответ без fields/tables/subordinate/
	// regulation (20-27 КБ экономии контекста); full = true всегда даёт полный.
	КраткийОтвет = КраткоеПовторноеЧтение(Контекст, Аргументы, ДанныеЗаявки.Шапка,
		ВизыИСтатус, Сценарий, ХешТекущий);
	Если КраткийОтвет <> Неопределено Тогда
		Возврат КраткийОтвет;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
	// agentrunner-212: объект работы для ядра (контракт предмета запуска).
	Ответ.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
	Ответ.Вставить("request_presentation", Строка(СсылкаЗаявки));
	Ответ.Вставить("number", ДанныеЗаявки.Шапка.Номер);
	Ответ.Вставить("request_date", ДанныеЗаявки.Шапка.Дата);
	Ответ.Вставить("status", ЗначениеВСтрокуДляОтвета(ВизыИСтатус.Статус));
	Ответ.Вставить("operation", ОперацияСценария(ДанныеЗаявки.Шапка));
	Ответ.Вставить("scenario", Сценарий);
	// agentrunner-88: этап активной визы агента и следующий шаг (п. 3 спеки).
	Ответ.Вставить("stage", ?(ВизаАгента.Найдена, ВизаАгента.Этап, Неопределено));
	Ответ.Вставить("visa", ?(ВизаАгента.Найдена, Строка(ВизаАгента.Виза), Неопределено));
	Если НЕ ВизаАгента.Найдена И НЕ ЭтоАктуализация Тогда
		// agentrunner-108: явный признак в полном ответе (full = true - путь
		// диагностики); обычный поток сюда не доходит (ранний отказ выше).
		Ответ.Вставить("agent_visa_active", Ложь);
	КонецЕсли;
	Если ДанныеЭтапаДваНужны(ВизаАгента, ЭтоАктуализация) Тогда
		// Данные этапа 2 (п. 3 спеки): виза 1, контрагент, счёт заявки,
		// изменение модели после визы 1.
		ДанныеЭтапа2 = ДанныеЭтапаДва(Контекст, СсылкаЗаявки, ДанныеЗаявки, МодельСтало, ХешТекущий);
		Ответ.Вставить("visa1", ДанныеЭтапа2.Виза1);
		Ответ.Вставить("bank_account", ДанныеЭтапа2.СчетЗаявки);
		Ответ.Вставить("model_changed_since_visa1", ДанныеЭтапа2.МодельИзменена);
		// Существующий блок counterparty дополяняется данными контрагента этапа 1.
		Ответ.Вставить("counterparty", ДанныеЭтапа2.Контрагент);
		Ответ.Вставить("next", ДанныеЭтапа2.СледующийШаг);
	Иначе
		Ответ.Вставить("counterparty", КонтрагентЗаявки(ДанныеЗаявки.Шапка));
		Ответ.Вставить("next", СледующийШагЧтения(ЭтоАктуализация, ВизаАгента.Найдена));
	КонецЕсли;
	Ответ.Вставить("header", РазделЗаголовокЗаявки(СсылкаЗаявки, МодельСтало));
	Ответ.Вставить("fields", ПоляМодели(МодельСтало, МодельПред, ДляСоздания));
	Ответ.Вставить("tables", ТаблицыМодели(МодельСтало));
	Ответ.Вставить("subordinate", ПодчиненныеОбъектыВОтвет(ДанныеЗаявки.Подчиненные, ДляСоздания));
	Ответ.Вставить("visas", ВизыИСтатус.Визы);
	Ответ.Вставить("model_hash", ХешТекущий);
	// agentrunner-89 (спека п. 7, 8): счётчик и лимит возвратов, сообщения
	// инициатора в диалоге ожидания после последнего возврата.
	ЧислоВозвратов = ЧислоВозвратовЗаявки(СсылкаЗаявки);
	Ответ.Вставить("returns_count", ЧислоВозвратов);
	Ответ.Вставить("return_allowed", ЧислоВозвратов < ЛимитВозвратовЗаявки());
	Ответ.Вставить("initiator_note", ЗаписиИнициатораПослеВозврата(СсылкаЗаявки));
	// agentrunner-48: пункты регламента по сценарию (часть 4.1) - модель
	// получает только разделы своего сценария, не весь регламент.
	Ответ.Вставить("regulation", РегламентПоСценарию(Сценарий));
	Если МодельСтало = Неопределено Тогда
		Ответ.Вставить("warning", "model_empty");
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Ранний отказ чтения заявки (agentrunner-108, спека п. 2): активной визы
// агента нет - заявка не на точке визирования, проверку не начинать, отдать
// итоговый отчёт (запуск 9a271298: модель тратила 6 минут и 95 тыс. токенов,
// а узнавала об этом только в решении). Терминальный исход (контракт
// agentrunner-107); блоки fields/tables/subordinate/regulation не отдаются -
// экономия контекста.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//
// Возвращаемое значение:
//  Структура - ответ-observation {agent_visa_active, terminal, terminal_reason,
//  next, message}.
//
Функция ОтветБезАктивнойВизы(Знач СсылкаЗаявки)

	Номер = НомерЗаявкиСтрокой(СсылкаЗаявки);
	Ответ = Новый Структура;
	// agentrunner-212: ответ успешный (без error) - предмет сообщается ядру
	// как объект работы; захват снимется финальным статусом терминального исхода.
	Ответ.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
	Ответ.Вставить("agent_visa_active", Ложь);
	Ответ.Вставить("terminal", Истина);
	Ответ.Вставить("terminal_reason", "agent_visa_not_active");
	Ответ.Вставить("next", "finish");
	Ответ.Вставить("message", СтрШаблон(
		НСтр("ru = 'Заявка %1 не на точке визирования агента: проверку не выполнять,
			|дай итоговый отчёт.'"),
		Номер));
	Возврат Ответ;

КонецФункции

// Шапка и строки ТЧ sd_ПодчиненныеОбъектыОбмена заявки одним пакетным запросом
// (две связанные выборки за один вызов к базе). agentrunner-96: в шапку
// добавлены признаки заявки автоактуализации (Проведен, Комментарий,
// сд_Аргументация, ИмяОбъекта).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура:
//   * Шапка       - Структура - см. РеквизитыЗаявокШапки (один элемент).
//   * Подчиненные - Массив из Структура {ИмяОбъекта, Предмет,
//                   ПредметПредставление, ХранилищеМодельОбъекта,
//                   ХранилищеМодельОбъектаПред} - в порядке строк ТЧ.
//
Функция ДанныеЗаявки(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	Т.Дата КАК Дата,
		|	Т.ВидОперации КАК ВидОперации,
		|	ЕСТЬNULL(ОписанияЗаявок.Имя, """") КАК ИмяОбъекта,
		|	Т.Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(Т.Предмет) КАК ПредметПредставление,
		|	Т.сд_Инициатор КАК Инициатор,
		|	ПРЕДСТАВЛЕНИЕ(Т.сд_Инициатор) КАК ИнициаторПредставление,
		|	Т.Ответственный КАК Ответственный,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ответственный) КАК ОтветственныйПредставление,
		|	Т.Проведен КАК Проведен,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.Комментарий КАК Комментарий,
		|	Т.сд_Аргументация КАК сд_Аргументация,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	Т.ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок
		|		ПО Т.ОписаниеОбъекта = ОписанияЗаявок.Ссылка
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПОО.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ОписанияПОО.Имя, """") КАК ИмяОбъекта,
		|	ПОО.sd_Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(ПОО.sd_Предмет) КАК ПредметПредставление,
		|	ПОО.sd_ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	ПОО.sd_ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение.sd_ПодчиненныеОбъектыОбмена КАК ПОО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияПОО
		|		ПО ПОО.sd_ОписаниеОбъектаОбмена = ОписанияПОО.Ссылка
		|ГДЕ
		|	ПОО.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ПОО.НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	Шапки = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = Новый Структура;
		Шапка.Вставить("Ссылка", Выборка.Ссылка);
		Шапка.Вставить("Номер", Выборка.Номер);
		Шапка.Вставить("Дата", Выборка.Дата);
		Шапка.Вставить("ВидОперации", Выборка.ВидОперации);
		Шапка.Вставить("ИмяОбъекта", Выборка.ИмяОбъекта);
		Шапка.Вставить("Предмет", Выборка.Предмет);
		Шапка.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		Шапка.Вставить("Инициатор", Выборка.Инициатор);
		Шапка.Вставить("ИнициаторПредставление", Выборка.ИнициаторПредставление);
		Шапка.Вставить("Ответственный", Выборка.Ответственный);
		Шапка.Вставить("ОтветственныйПредставление", Выборка.ОтветственныйПредставление);
		Шапка.Вставить("Проведен", Выборка.Проведен);
		Шапка.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		Шапка.Вставить("Комментарий", Выборка.Комментарий);
		Шапка.Вставить("сд_Аргументация", Выборка.сд_Аргументация);
		Шапка.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		Шапка.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Шапки.Вставить(Выборка.Ссылка, Шапка);
	КонецЦикла;

	Подчиненные = Новый Массив;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПОО = Новый Структура;
		СтрокаПОО.Вставить("ИмяОбъекта", Выборка.ИмяОбъекта);
		СтрокаПОО.Вставить("Предмет", Выборка.Предмет);
		СтрокаПОО.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		СтрокаПОО.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		СтрокаПОО.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Подчиненные.Добавить(СтрокаПОО);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Шапка", Шапки.Получить(СсылкаЗаявки));
	Результат.Вставить("Подчиненные", Подчиненные);
	Возврат Результат;

КонецФункции

// Имена реквизитов контрагента для раздела header ответа (список п. 5 спеки).
// Читаются из шапки, если реквизит заявки существует в метаданных, иначе из
// модели «стало» (mcp.md [P3]).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ИменаШапкиКонтрагента()

	Имена = Новый Массив;
	Имена.Добавить("ИНН");
	Имена.Добавить("КПП");
	Имена.Добавить("РегистрационныйНомер");
	Имена.Добавить("Наименование");
	Имена.Добавить("НаименованиеПолное");
	Имена.Добавить("ЮридическоеФизическоеЛицо");
	Имена.Добавить("sd_Нерезидент");
	Имена.Добавить("sd_ИП");
	Имена.Добавить("ИндивидуальныйПредприниматель");
	Имена.Добавить("sd_ОП");
	Имена.Добавить("ОбособленноеПодразделение");
	Имена.Добавить("sd_ВГО");
	Имена.Добавить("ГосударственныйОрган");
	Имена.Добавить("sd_ГосударственныеОрганы");
	Имена.Добавить("ВидГосударственногоОргана");
	Имена.Добавить("КодГосударственногоОргана");
	Имена.Добавить("СтранаРегистрации");
	Имена.Добавить("ДатаРегистрации");
	Имена.Добавить("sd_Ликвидирован");
	Имена.Добавить("sd_ДатаЛиквидации");
	Имена.Добавить("sd_СерияНомерПаспорта");
	Имена.Добавить("sd_ДокументКодПодразделения");
	Имена.Добавить("sd_ДокументКемВыдан");
	Имена.Добавить("sd_ДокументДатаВыдачи");
	Имена.Добавить("sd_ДокументСерия");
	Имена.Добавить("sd_ДокументНомер");
	Имена.Добавить("КодПоОКПО");
	Возврат Имена;

КонецФункции

// Раздел header ответа nsi_get_request: реквизиты контрагента в представлениях.
// Правило спеки п. 5: реквизит есть в шапке заявки - значение из шапки, нет -
// из модели «стало» (на текущем стенде шапочных реквизитов нет - все из модели).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  МодельСтало  - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Структура - {<имя реквизита>: <представление или null>}.
//
Функция РазделЗаголовокЗаявки(Знач СсылкаЗаявки, Знач МодельСтало)

	Заголовок = Новый Структура;

	// Шапочные реквизиты (могут появиться в новых релизах «БИТ») читаются одним
	// вызовом БСП - не по одному через точку в цикле (стандарт, раздел 6).
	ШапочныеИмена = ШапочныеИменаЗаявки(ИменаШапкиКонтрагента());
	ШапочныеЗначения = ЗначенияШапочныхРеквизитов(СсылкаЗаявки, ШапочныеИмена);

	Для Каждого ИмяРеквизита Из ИменаШапкиКонтрагента() Цикл

		Значение = Неопределено;
		Если ШапочныеЗначения.Свойство(ИмяРеквизита) Тогда
			Значение = ШапочныеЗначения[ИмяРеквизита];
		Иначе
			Значение = ЗначениеМоделиПоИмени(МодельСтало, ИмяРеквизита);
		КонецЕсли;

		Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
			Заголовок.Вставить(ИмяРеквизита, ЗначениеВСтрокуДляОтвета(Значение));
		Иначе
			Заголовок.Вставить(ИмяРеквизита, Неопределено);
		КонецЕсли;

	КонецЦикла;
	Возврат Заголовок;

КонецФункции

// Имена из списка, существующие в метаданных шапки заявки (шапочные реквизиты,
// mcp.md [P3] «Реквизиты шапки со стенда»).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ШапочныеИменаЗаявки(Знач СписокИмен)

	МетаЗаявка = Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение;
	Существующие = Новый Массив;
	Для Каждого ИмяРеквизита Из СписокИмен Цикл
		Если МетаЗаявка.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Существующие.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Возврат Существующие;

КонецФункции

// Значения шапочных реквизитов заявки одним вызовом БСП (стандарт: не через
// точку); пустой список - пустая структура.
//
// Возвращаемое значение:
//  Структура - {<имя реквизита>: значение} (только существующие в шапке имена).
//
Функция ЗначенияШапочныхРеквизитов(Знач СсылкаЗаявки, Знач ИменаРеквизитов)

	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЗаявки,
		СтрСоединить(ИменаРеквизитов, ","));

КонецФункции

// Раздел counterparty ответа: предмет заявки (навигационная ссылка и
// представление), null, если не заполнен (спека п. 9).
Функция КонтрагентЗаявки(Знач Шапка)

	Если ЗначениеЗаполнено(Шапка.Предмет) Тогда
		Пара = Новый Структура;
		Пара.Вставить("presentation", Шапка.ПредметПредставление);
		Пара.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Предмет));
		Возврат Пара;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Раздел fields ответа: поля моделей «стало» и «было» - Реквизиты, затем
// СтандартныеРеквизиты; для создания before = null (спека п. 9).
//
// Параметры:
//  МодельСтало - Структура   - модель заявки «стало» (может быть Неопределено).
//  МодельПред  - Структура   - модель заявки «было».
//  ДляСоздания - Булево      - ВидОперации = ВводНового.
//
// Возвращаемое значение:
//  Массив из Структура {name, presentation, before, after, changed}.
//
Функция ПоляМодели(Знач МодельСтало, Знач МодельПред, Знач ДляСоздания)

	Поля = Новый Массив;
	ДополнитьПоляГруппой(Поля, МодельСтало, МодельПред, "Реквизиты", ДляСоздания);
	ДополнитьПоляГруппой(Поля, МодельСтало, МодельПред, "СтандартныеРеквизиты", ДляСоздания);
	Возврат Поля;

КонецФункции

// Дополняет массив полей одной группой модели (Реквизиты или СтандартныеРеквизиты).
//
// Параметры:
//  Поля        - Массив    - пополняемый массив полей.
//  МодельСтало - Структура - модель «стало».
//  МодельПред  - Структура - модель «было».
//  ИмяГруппы   - Строка    - имя группы модели.
//  ДляСоздания - Булево    - before принудительно null.
//
Функция ДополнитьПоляГруппой(Знач Поля, Знач МодельСтало, Знач МодельПред, Знач ИмяГруппы,
	Знач ДляСоздания)

	ГруппаСтало = ГруппаМодели(МодельСтало, ИмяГруппы);
	Если ГруппаСтало = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	ГруппаПред = ГруппаМодели(МодельПред, ИмяГруппы);
	Для Каждого КлючИЗначение Из ГруппаСтало Цикл

		ЗначениеПосле = НормализоватьЗначение(КлючИЗначение.Значение);
		ЗначениеДо = Неопределено;
		Если НЕ ДляСоздания И ГруппаПред <> Неопределено Тогда
			ЗначениеДо = ЗначениеИзКоллекцииМодели(ГруппаПред, КлючИЗначение.Ключ);
			ЗначениеДо = НормализоватьЗначение(ЗначениеДо);
		КонецЕсли;

		Поле = Новый Структура;
		Поле.Вставить("name", КлючИЗначение.Ключ);
		Поле.Вставить("presentation", ЗначениеВСтрокуДляОтвета(КлючИЗначение.Значение));
		Поле.Вставить("before", ЗначениеДо);
		Поле.Вставить("after", ЗначениеПосле);
		Поле.Вставить("changed", НЕ ЗначенияСовпадают(ЗначениеДо, ЗначениеПосле));
		Поля.Добавить(Поле);

	КонецЦикла;
	Возврат Поля;

КонецФункции

// Раздел tables ответа: табличные части модели «стало» - имя ТЧ -> массив строк
// с нормализованными значениями (спека п. 9).
//
// Возвращаемое значение:
//  Соответствие - имя ТЧ -> Массив строк.
//
Функция ТаблицыМодели(Знач МодельСтало)

	Таблицы = Новый Соответствие;
	ГруппаТЧ = ГруппаМодели(МодельСтало, "ТабличныеЧасти");
	Если ГруппаТЧ = Неопределено Тогда
		Возврат Таблицы;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ГруппаТЧ Цикл
		Строки = Новый Массив;
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого СтрокаТЧ Из КлючИЗначение.Значение Цикл
				Строки.Добавить(НормализоватьЗначение(СтрокаТЧ));
			КонецЦикла;
		КонецЕсли;
		Таблицы.Вставить(КлючИЗначение.Ключ, Строки);
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

// Раздел subordinate ответа: подчиненные объекты обмена (ТЧ
// sd_ПодчиненныеОбъектыОбмена) тем же способом, что и поля заявки; банковские
// счета - здесь (спека п. 9).
//
// Параметры:
//  ПодчиненныеСтроки - Массив - строки ТЧ из ДанныеЗаявки.
//  ДляСоздания       - Булево - before принудительно null.
//
// Возвращаемое значение:
//  Массив из Структура {object_kind, subject, fields, tables}.
//
Функция ПодчиненныеОбъектыВОтвет(Знач ПодчиненныеСтроки, Знач ДляСоздания)

	Объекты = Новый Массив;
	Для Каждого СтрокаПОО Из ПодчиненныеСтроки Цикл

		МодельПООСтало = МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъекта);
		МодельПООПред  = МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъектаПред);

		Элемент = Новый Структура;
		Элемент.Вставить("object_kind", СтрокаПОО.ИмяОбъекта);
		Если ЗначениеЗаполнено(СтрокаПОО.Предмет) Тогда
			Предмет = Новый Структура;
			Предмет.Вставить("presentation", СтрокаПОО.ПредметПредставление);
			Предмет.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаПОО.Предмет));
			Элемент.Вставить("subject", Предмет);
		Иначе
			Элемент.Вставить("subject", Неопределено);
		КонецЕсли;
		Элемент.Вставить("fields", ПоляМодели(МодельПООСтало, МодельПООПред, ДляСоздания));
		Элемент.Вставить("tables", ТаблицыМодели(МодельПООСтало));
		Объекты.Добавить(Элемент);

	КонецЦикла;
	Возврат Объекты;

КонецФункции

// Все визы заявки через бит_ВизированиеСервер.ПрочитатьНаборВиз + статус заявки
// из набора (ресурс Статус первой заполненной записи) - спека п. 9.
// agentrunner-108: виза агента помечается agent_visa (по ИД активной
// записи АктивнаяВизаАгента) - модель выбирает visa_id из списка и не берёт
// чужую либо неактивную визу.
//
// Параметры:
//  СсылкаЗаявки  - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//  ИДВизыАгента  - Строка - ИД активной визы агента (АктивнаяВизаАгента.ИД);
//                  пустая - визы агента нет, agent_visa = Ложь у всех.
//
// Возвращаемое значение:
//  Структура:
//   * Визы   - Массив из Структура {visa, visa_id, active, agent_visa,
//              decision, user, set_date, due_date, comment}.
//   * Статус - СправочникСсылка.бит_СтатусыОбъектов или Неопределено.
//
Функция ВизыВОтвет(Знач СсылкаЗаявки, Знач ИДВизыАгента = "")

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	Визы = Новый Массив;
	СтатусЗаявки = Неопределено;
	Для Каждого ЗаписьВизы Из НаборВизы Цикл

		Элемент = Новый Структура;
		Элемент.Вставить("visa", Строка(ЗаписьВизы.Виза));
		Элемент.Вставить("visa_id", ЗаписьВизы.ИД);
		Элемент.Вставить("active", ЗаписьВизы.АктивнаяВиза);
		Элемент.Вставить("agent_visa",
			(НЕ ПустаяСтрока(ИДВизыАгента) И ЗаписьВизы.ИД = ИДВизыАгента));
		Элемент.Вставить("decision",
			?(ЗначениеЗаполнено(ЗаписьВизы.Решение), Строка(ЗаписьВизы.Решение), Неопределено));
		Элемент.Вставить("user",
			?(ЗначениеЗаполнено(ЗаписьВизы.Пользователь), Строка(ЗаписьВизы.Пользователь), Неопределено));
		Элемент.Вставить("set_date",
			?(ЗначениеЗаполнено(ЗаписьВизы.ДатаУстановки), ЗаписьВизы.ДатаУстановки, Неопределено));
		Элемент.Вставить("due_date",
			?(ЗначениеЗаполнено(ЗаписьВизы.ДатаКрайняя), ЗаписьВизы.ДатаКрайняя, Неопределено));
		Элемент.Вставить("comment", ЗаписьВизы.Комментарий);
		Визы.Добавить(Элемент);

		Если СтатусЗаявки = Неопределено И ЗначениеЗаполнено(ЗаписьВизы.Статус) Тогда
			СтатусЗаявки = ЗаписьВизы.Статус;
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Визы", Визы);
	Результат.Вставить("Статус", СтатусЗаявки);
	Возврат Результат;

КонецФункции

// Модельный хеш заявки (спека п. 9): SHA-256 (hex) сериализации ar_JSON
// нормализованных моделей «стало» шапки и всех подчиненных объектов в порядке
// строк ТЧ. Визы и комментарии в хеш не входят - только проверяемые данные.
// Нормализация делает хеш детерминированным: ссылки -> {presentation, ref},
// несериализуемые значения -> строка «<не выводится>».
// agentrunner-96: МоделиПред = Истина - хеш по моделям «было» (шапки и ПОО) -
// признак неизменности заявки после создания (сценарий автоактуализации).
//
// Параметры:
//  МодельСтало       - Структура - модель шапки «стало» (может быть Неопределено).
//  ПодчиненныеСтроки - Массив    - строки ТЧ ПОО из ДанныеЗаявки.
//  МоделиПред        - Булево    - читать из ПОО модели «было»; по умолчанию Ложь.
//
// Возвращаемое значение:
//  Строка - 64 hex-символа; "" - сериализация не удалась (approve будет отклонен).
//
Функция ХешМоделейЗаявки(Знач МодельСтало, Знач ПодчиненныеСтроки, Знач МоделиПред = Ложь)

	Части = Новый Массив;
	Части.Добавить(НормализоватьЗначение(МодельСтало));
	Для Каждого СтрокаПОО Из ПодчиненныеСтроки Цикл
		ХранилищеМодели = ?(МоделиПред, СтрокаПОО.ХранилищеМодельОбъектаПред,
			СтрокаПОО.ХранилищеМодельОбъекта);
		Части.Добавить(НормализоватьЗначение(МодельИзХранилища(ХранилищеМодели)));
	КонецЦикла;

	JSONТекст = ar_JSON.ВЗначениеJSON(Части);
	Если ПустаяСтрока(JSONТекст) Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_model_hash_failed",
			НСтр("ru = 'Не удалось сериализовать модель заявки для model_hash.'"),
			"Ошибка");
		Возврат "";
	КонецЕсли;

	Возврат ХешСтрокиSHA256(JSONТекст);

КонецФункции

// Текущие модельные хеши нескольких заявок одним пакетным чтением (п. 4 спеки
// agentrunner-35): шапки и ПОО по массиву заявок - два запроса одного пакета,
// без запроса в цикле. Хеш каждой заявки считается тем же ХешМоделейЗаявки
// (шапка «стало» + модели ПОО в порядке строк ТЧ). Заявка без доступной шапки
// в результате отсутствует - отсев трактует отсутствие хеша как устаревшую
// отметку (строка остается в выдаче).
//
// Параметры:
//  Заявки - Массив - ссылки на заявки НСИ.
//
// Возвращаемое значение:
//  Соответствие - "Заявка -> Строка (64 hex-символа)".
//
Функция ХешиМоделейЗаявок(Знач Заявки)

	Результат = Новый Соответствие;

	Если Заявки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявки", Заявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Заявка,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка В (&Заявки)
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПОО.Ссылка КАК Заявка,
		|	ПОО.sd_ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение.sd_ПодчиненныеОбъектыОбмена КАК ПОО
		|ГДЕ
		|	ПОО.Ссылка В (&Заявки)
		|УПОРЯДОЧИТЬ ПО
		|	ПОО.Ссылка,
		|	ПОО.НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	// Строки ПОО группируются по заявке (выборка упорядочена по ссылке, строке).
	ПодчиненныеПоЗаявкам = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиПОО = ПодчиненныеПоЗаявкам.Получить(Выборка.Заявка);
		Если СтрокиПОО = Неопределено Тогда
			СтрокиПОО = Новый Массив;
			ПодчиненныеПоЗаявкам.Вставить(Выборка.Заявка, СтрокиПОО);
		КонецЕсли;
		СтрокаПОО = Новый Структура;
		СтрокаПОО.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		СтрокиПОО.Добавить(СтрокаПОО);
	КонецЦикла;

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		МодельСтало = МодельИзХранилища(Выборка.ХранилищеМодельОбъекта);
		Подчиненные = ПодчиненныеПоЗаявкам.Получить(Выборка.Заявка);
		Если Подчиненные = Неопределено Тогда
			Подчиненные = Новый Массив;
		КонецЕсли;
		Результат.Вставить(Выборка.Заявка, ХешМоделейЗаявки(МодельСтало, Подчиненные));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПроверкаДанныхОбработкой

// Реализация инструмента nsi_check_requisites: проверку данных заявки выполняет
// внешняя обработка «Проверка данных заявки на изменение НСИ (контрагенты)»,
// пакет её ответ не пересобирает (agentrunner-87).
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"request"}: навигационная ссылка,
//                  номер заявки или строка с номером.
//  Контекст      - Структура - контекст запуска (RunId - защита повторного решения).
//
// Возвращаемое значение:
//  Строка - JSON обработки (РезультатПроверкиДляМодели) как есть
//  либо {"error", "message"}: invalid_arguments, ошибки отбора заявки,
//  run_already_decided, check_processing_not_found, check_failed.
//
Функция ВыполнитьПроверкуРеквизитов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	СтрокаЗаявки = ЗначениеИзКоллекции(Аргументы, "request", "");
	Если ТипЗнч(СтрокаЗаявки) <> Тип("Строка") Или ПустаяСтрока(СтрокаЗаявки) Тогда
		Возврат ОшибкаИнструмента("invalid_arguments",
			НСтр("ru = 'Нужен аргумент request: навигационная ссылка на заявку НСИ,
				|номер заявки или строка с номером.'"));
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			?(ПустаяСтрока(ОтборЗаявки.Сообщение), ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение));
	КонецЕсли;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - отказ до проверки
	// обработкой (чтение данных заявки).
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
	КонецЕсли;

	// agentrunner-66 (спека А.5): решение в этом запуске поставлено - проверки
	// по другой заявке бессмысленны, завершить работу.
	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть И Решение.СсылкаЗаявки <> ОтборЗаявки.Ссылка Тогда
		Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
	КонецЕсли;

	// agentrunner-88: заявки исключённых внешних систем не проверяются.
	Если ЗаявкаИсключена(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("request_excluded_external_system", ТекстЗаявкаИсключена(), Истина);
	КонецЕсли;

	РезультатПроверки = РезультатПроверкиОбработкой(ОтборЗаявки.Ссылка);
	Если РезультатПроверки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(РезультатПроверки.КодОшибки, РезультатПроверки.Сообщение);
	КонецЕсли;

	// Ответ обработки возвращается как есть: request в нем уже заполнен;
	// agentrunner-212 - дополнительно subject (объект работы для ядра).
	Возврат ОтветСSubject(РезультатПроверки.ТекстJSON, ОтборЗаявки.Ссылка);

КонецФункции

// Имя объекта обработки проверки данных заявки в справочнике
// ДополнительныеОтчетыИОбработки (реквизит ИмяОбъекта) - единая точка
// (agentrunner-87).
//
// Возвращаемое значение:
//  Строка - имя объекта внешней обработки проверки данных.
//
Функция ИмяОбработкиПроверкиДанных()

	Возврат "ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты";

КонецФункции

// Вызывает РезультатПроверкиДляМодели обработки «Проверка данных заявки на
// изменение НСИ (контрагенты)» по заявке (agentrunner-87). Элемент обработки
// ищется в «Дополнительных отчётах и обработках» по имени объекта: не помечен
// на удаление, публикация «Используется»; внешний объект - штатным методом БСП
// (пример в шапке модуля обработки). Без привилегированного режима - права как
// у пользователя агента (спека agentrunner-30 п. 19). Исключение наружу не
// выходит: неудача подключения, вызова или разбора - код ошибки и очищенный
// текст (подробное представление - в ar_СлужебныйЛог).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка проверки.
//
// Возвращаемое значение:
//  Структура:
//   * КодОшибки - Строка - "" либо "check_processing_not_found" / "check_failed".
//   * Сообщение - Строка - текст ошибки для {"message"} ("" при успехе).
//   * ТекстJSON - Строка - JSON обработки как есть ("" при ошибке).
//   * Данные    - Соответствие, Неопределено - разобранный JSON (checked,
//                 all_checks_passed, summary, remarks, remarks_text) - для
//                 approve и протокола.
//
Функция РезультатПроверкиОбработкой(Знач СсылкаЗаявки)

	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ТекстJSON", "");
	Результат.Вставить("Данные", Неопределено);

	// Запрос - внутри Попытки: нет права чтения справочника у пользователя
	// агента - check_failed, а не tool_exception (спека agentrunner-87 п. 1).
	Попытка

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбработкиПроверкиДанных());
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
			|ГДЕ
			|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
			|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления
			|	И ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(
			|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)";

		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Результат.КодОшибки = "check_processing_not_found";
			Результат.Сообщение = ТекстОбработкаНеНайдена();
			Возврат Результат;
		КонецЕсли;

		Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Выборка.Ссылка);
		Если Обработка = Неопределено Тогда
			Результат.КодОшибки = "check_processing_not_found";
			Результат.Сообщение = ТекстОбработкаНеНайдена();
			Возврат Результат;
		КонецЕсли;

		ТекстJSON = Обработка.РезультатПроверкиДляМодели(СсылкаЗаявки);
		Данные = ar_JSON.ИзJSON(ТекстJSON);
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			// ar_JSON.ИзJSON не выбрасывает исключений - провал разбора здесь.
			ВызватьИсключение
				НСтр("ru = 'Ответ обработки не разобран как JSON-объект.'");
		КонецЕсли;
		Результат.ТекстJSON = ТекстJSON;
		Результат.Данные = Данные;
	Исключение
		Результат.КодОшибки = "check_failed";
		Результат.Сообщение = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстЛога = СтрШаблон("%1: %2", Строка(СсылкаЗаявки),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.РезультатПроверкиОбработкой", "nsi_check_failed",
			ТекстЛога, "Ошибка");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текст отказа check_processing_not_found: обработка проверки данных не
// подключена в «Дополнительных отчётах и обработках» (имя объекта, публикация).
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстОбработкаНеНайдена()

	Возврат СтрШаблон(
		НСтр("ru = 'Обработка «Проверка данных заявки на изменение НСИ (контрагенты)»
			|не подключена в «Дополнительных отчётах и обработках»: нужен элемент
			|с именем объекта %1, не помеченный на удаление, с публикацией «Используется».'"),
		ИмяОбработкиПроверкиДанных());

КонецФункции

// Строки замечаний проверки данных для сообщения отказа requisites_errors:
// "<code> <name>: <message>" (agentrunner-87).
//
// Параметры:
//  ДанныеПроверки - Соответствие - разобранный JSON обработки.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗамечанияПроверкиСтроками(Знач ДанныеПроверки)

	Строки = Новый Массив;
	Замечания = ДанныеПроверки.Получить("remarks");
	Если ТипЗнч(Замечания) <> Тип("Массив") Тогда
		Возврат Строки;
	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		Если ТипЗнч(Замечание) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("%1 %2: %3",
			Строка(Замечание.Получить("code")),
			Строка(Замечание.Получить("name")),
			Строка(Замечание.Получить("message"))));
	КонецЦикла;

	Возврат Строки;

КонецФункции

#КонецОбласти

#Область ИнструментОфициальныеДанные

// Реализация инструмента nsi_official_data (спека п. 15): ИНН из аргумента или
// модели заявки; 10 цифр - ЕГРЮЛ, 12 - ЕГРИП (РаботаСКонтрагентами); иное -
// отказ без обращения к сервису. Каждый вызов - запись в ar_СлужебныйЛог.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"inn": "..."} либо {"request": "..."}.
//  Контекст      - Структура - контекст запуска (не используется).
//
// Возвращаемое значение:
//  Строка - JSON-observation с данными ЕГРЮЛ/ЕГРИП либо {"error", "message"}.
//
Функция ВыполнитьЗапросОфициальныхДанных(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	// agentrunner-212 (спека п. 5): заявка передана - чужая заявка для запуска
	// даёт отказ до чтения модели заявки (ИНН), а её навссылка пойдёт в ответ
	// как subject. Без заявки (прямой ИНН) контракта предмета нет.
	СсылкаЗаявкиОтвета = Неопределено;
	СтрокаЗаявкиСубъекта = ЗначениеИзКоллекции(Аргументы, "request", "");
	Если ТипЗнч(СтрокаЗаявкиСубъекта) = Тип("Строка") И НЕ ПустаяСтрока(СтрокаЗаявкиСубъекта) Тогда
		ОтборЗаявкиСубъекта = ЗаявкаИзАргументов(Аргументы);
		Если ОтборЗаявкиСубъекта.КодОшибки = "" Тогда
			СсылкаЗаявкиОтвета = ОтборЗаявкиСубъекта.Ссылка;
			ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, СсылкаЗаявкиОтвета);
			Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
				Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ИНН = ИННИзАргументов(Аргументы);
	Если ПустаяСтрока(ИНН) Тогда
		Возврат ОшибкаИнструмента("invalid_inn",
			НСтр("ru = 'ИНН не передан и не найден в заявке.'"));
	КонецЕсли;

	// agentrunner-66 (спека А.5): решение в этом запуске поставлено - сверка
	// по другой заявке (или без заявки) бессмысленна, завершить работу.
	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть Тогда
		ТотЖеЗапрос = Ложь;
		СтрокаЗаявки = ЗначениеИзКоллекции(Аргументы, "request", "");
		Если ТипЗнч(СтрокаЗаявки) = Тип("Строка") И НЕ ПустаяСтрока(СтрокаЗаявки) Тогда
			ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
			ТотЖеЗапрос = (ОтборЗаявки.КодОшибки = ""
				И Решение.СсылкаЗаявки = ОтборЗаявки.Ссылка);
		КонецЕсли;
		Если НЕ ТотЖеЗапрос Тогда
			Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
		КонецЕсли;
	КонецЕсли;

	// agentrunner-66 (спека А.2): повторный вызов с тем же ИНН в этом запуске
	// сервис не дергает - возвращается тот же итог из ar_ДействияАгента.
	ОтветРанее = ОтветИзДействийЗапуска(Контекст, "nsi_official_data",
		КлючПовтораОфициальныхДанных(Аргументы));
	Если ОтветРанее <> Неопределено Тогда
		Возврат ОтветРанее;
	КонецЕсли;

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		РеквизитыСервиса = ДанныеСервисаПоИНН(ИНН);
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
		ОтветСервиса = ОтветОфициальныхДанных(ИНН, РеквизитыСервиса);
	Исключение
		// Любой сбой пути сервиса - недоступность (agentrunner-66, спека А.2:
		// наружу ответ без ключа error, result = not_performed - шаг плана
		// закрывается, модель не зацикливается); деталь сбоя - в журнал
		// регистрации.
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
		ТекстСбоя = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ar_ПакетНСИ.nsi_official_data'; en = 'ar_NSI.OfficialData'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("ИНН %1: %2", ИНН, ТекстСбоя));
		ОтветСервиса = ОтветНеВыполнено(ИНН);
	КонецПопытки;
	ЗаписатьЛогОфициальныхДанных(ИНН, ОтветСервиса, ДлительностьМс);
	Если СсылкаЗаявкиОтвета <> Неопределено Тогда
		// agentrunner-212: заявка участвовала - объект работы сообщается ядру.
		ОтветСервиса.Вставить("subject",
			ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявкиОтвета));
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(ОтветСервиса);

КонецФункции

// ИНН для запроса: аргумент inn, иначе модель заявки «стало» (реквизит ИНН).
Функция ИННИзАргументов(Знач Аргументы)

	ИНН = НормализованноеЧислоСтроки(ЗначениеИзКоллекции(Аргументы, "inn", ""));
	Если НЕ ПустаяСтрока(ИНН) Тогда
		Возврат ИНН;
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат "";
	КонецЕсли;

	ДанныеЗаявки = ДанныеЗаявки(ОтборЗаявки.Ссылка);
	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	Возврат НормализованноеЧислоСтроки(ЗначениеМоделиПоИмени(МодельСтало, "ИНН"));

КонецФункции

// Вызов сервиса 1С:Контрагент по длине ИНН: 10 - юрлицо, 12 - предприниматель,
// иное - отказ invalid_inn без обращения к сервису (спека п. 15). Исключения
// сервиса перехватываются - наружу {"error":"service_error"}.
//
// Возвращаемое значение:
//  Структура - результат РаботаСКонтрагентами (с ОписаниеОшибки) либо
//  Структура {ОписаниеОшибки} при отказе.
//
Функция ДанныеСервисаПоИНН(Знач ИНН)

	ПустойРезультат = Новый Структура;
	ПустойРезультат.Вставить("ОписаниеОшибки", "");

	// agentrunner-88 (п. 7 спеки): единая точка ЕГР -
	// КонтрагентыФормы.ДанныеЕдиныхГосРеестровПоИНН (та же, что команда
	// «Заполнить по ИНН» формы контрагента); её же использует nsi_verify_request.
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		ПустойРезультат.ОписаниеОшибки = "invalid_inn";
		Возврат ПустойРезультат;
	КонецЕсли;

	Попытка
		ДанныеФормы = КонтрагентыФормы.ДанныеЕдиныхГосРеестровПоИНН(ИНН, СтрДлина(ИНН) = 10);
	Исключение
		ПустойРезультат.ОписаниеОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ПустойРезультат;
	КонецПопытки;

	Если НЕ ПустаяСтрока(Строка(ДанныеФормы.ОписаниеОшибки)) Тогда
		ПустойРезультат.ОписаниеОшибки = Строка(ДанныеФормы.ОписаниеОшибки);
		Возврат ПустойРезультат;
	КонецЕсли;

	// Реквизиты контрагента - из временного хранилища формы; прочитано и
	// удалено (п. 7 спеки). Состав совпадает с результатом РаботаСКонтрагентами
	// (Наименование, НаименованиеПолное, КПП, РегистрационныйНомер, Статус,
	// ДатаПрекращенияДеятельности, Руководители, ...).
	АдресРеквизитов = Строка(ДанныеФормы.АдресРеквизитовКонтрагента);
	РеквизитыСервиса = ПолучитьИзВременногоХранилища(АдресРеквизитов);
	УдалитьИзВременногоХранилища(АдресРеквизитов);

	Если ТипЗнч(РеквизитыСервиса) <> Тип("Структура") Тогда
		ПустойРезультат.ОписаниеОшибки = "service_error";
		Возврат ПустойРезультат;
	КонецЕсли;

	Возврат РеквизитыСервиса;

КонецФункции

// Ответ инструмента по результату сервиса: маппинг структур
// НовыеРеквизитыЮридическогоЛица / НовыеРеквизитыПредпринимателя в JSON
// (спека п. 15); коды отказов: service_not_connected / not_found /
// service_error / invalid_inn.
//
// Параметры:
//  ИНН             - Строка    - запрошенный ИНН.
//  РеквизитыСервиса - Структура - результат ДанныеСервисаПоИНН.
//
// Возвращаемое значение:
//  Структура - ответ-observation (данные либо {error, message}).
//
Функция ОтветОфициальныхДанных(Знач ИНН, Знач РеквизитыСервиса)

	ОписаниеОшибки = Строка(РеквизитыСервиса.ОписаниеОшибки);

	Если ОписаниеОшибки = "invalid_inn" Тогда
		Возврат ОшибкаИнструмента("invalid_inn", СтрШаблон(
			НСтр("ru = 'ИНН %1 не является 10- или 12-значным.'"), ИНН));
	КонецЕсли;

	Если ПустаяСтрока(ОписаниеОшибки) Тогда
		Ответ = ДанныеОтветаОрганизации(РеквизитыСервиса, ИНН);
		Ответ.Вставить("inn", ИНН);
		Возврат Ответ;
	КонецЕсли;

	Если ОписаниеОшибки = "УслугаНеПодключена" Тогда
		Возврат ОшибкаИнструмента("service_not_connected",
			НСтр("ru = 'Сервис 1С:Контрагент не подключен в этой базе - официальные данные
				|недоступны.'"));
	КонецЕсли;

	Если СтрНайти(НРег(ОписаниеОшибки), "не удалось найти") > 0
		Или СтрНайти(НРег(ОписаниеОшибки), "не найден") > 0 Тогда
		Возврат ОшибкаИнструмента("not_found", СтрШаблон(
			НСтр("ru = 'По ИНН %1 в ЕГРЮЛ/ЕГРИП ничего не найдено.'"), ИНН));
	КонецЕсли;

	// agentrunner-66 (спека А.2): недоступность сервиса - результат, а не
	// ошибка: шаг плана закрывается успешным вызовом, approve все равно
	// запрещен текстом ответа.
	Возврат ОтветНеВыполнено(ИНН);

КонецФункции

// Ответ «сверка не выполнена» при недоступности сервиса ЕГРЮЛ/ЕГРИП
// (agentrunner-66, спека А.2): ответ без ключа error - ядро закрывает им шаг
// плана; повторять вызов не нужно (повтор в том же запуске вернет тот же итог
// из ar_ДействияАгента, спека А.2).
//
// Параметры:
//  ИНН - Строка - запрошенный ИНН.
//
// Возвращаемое значение:
//  Структура - {result: not_performed, reason: service_unavailable, inn,
//  message}.
//
Функция ОтветНеВыполнено(Знач ИНН)

	Ответ = Новый Структура;
	Ответ.Вставить("result", "not_performed");
	Ответ.Вставить("reason", "service_unavailable");
	Ответ.Вставить("inn", ИНН);
	// Сверка с ЕГР обязательна только для автоактуализации (своя ветка
	// nsi_actualize_request); в обычной заявке недоступный сервис - пропуск.
	Ответ.Вставить("message",
		НСтр("ru = 'Сервис ЕГРЮЛ/ЕГРИП недоступен. Сверка пропущена - не повторяй вызов;
			|в протоколе отметь «пропущена». Заявку из-за этого не возвращай и не передавай:
			|продолжай работу, решение принимай по остальным проверкам.'"));
	Возврат Ответ;

КонецФункции

// Ключ повтора вызова nsi_official_data (agentrunner-66, спека А.2): ИНН из
// аргументов, иначе request из аргументов. Считается одинаково для текущего
// вызова и для сохраненных аргументов ar_ДействияАгента - совпадение ключей
// означает «тот же вызов».
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы вызова.
//
// Возвращаемое значение:
//  Строка - нормализованный ИНН либо строка request; "" когда в аргументах
//  нет ни того, ни другого.
//
Функция КлючПовтораОфициальныхДанных(Знач Аргументы)

	Ключ = НормализованноеЧислоСтроки(ЗначениеИзКоллекции(Аргументы, "inn", ""));
	Если НЕ ПустаяСтрока(Ключ) Тогда
		Возврат Ключ;
	КонецЕсли;

	СтрокаЗаявки = ЗначениеИзКоллекции(Аргументы, "request", "");
	Возврат ?(ТипЗнч(СтрокаЗаявки) = Тип("Строка"), СокрЛП(СтрокаЗаявки), "");

КонецФункции

// Ответ прошлого успешного вызова инструмента в этом запуске (agentrunner-66,
// спека А.2): вызов с тем же ключом повтора уже выполнялся и не вернул ошибку -
// его сохраненный ответ возвращается как есть, сервис не вызывается. Ответы
// с ключом error не кэшируются: их повторы отсекает ядро (спека Б.3).
//
// Параметры:
//  Контекст        - Структура - контекст запуска.
//  ИмяИнструмента  - Строка    - имя инструмента пакета.
//  КлючПовтора     - Строка    - ключ текущего вызова (см.
//                    КлючПовтораОфициальныхДанных).
//
// Возвращаемое значение:
//  Строка - сохраненный JSON-ответ; Неопределено - вызов не повтор.
//
Функция ОтветИзДействийЗапуска(Знач Контекст, Знач ИмяИнструмента, Знач КлючПовтора)

	Если ПустаяСтрока(КлючПовтора) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(
		RunIdИзКонтекста(Контекст), ИмяИнструмента) Цикл

		АргументыДействия = JSONИзДействия(Действие.АргументыJSON);
		Если АргументыДействия = Неопределено
			Или КлючПовтораОфициальныхДанных(АргументыДействия) <> КлючПовтора Тогда
			Продолжить;
		КонецЕсли;

		ОтветДействия = JSONИзДействия(Действие.ОтветИнструмента);
		Если ОтветДействия <> Неопределено
			И ОтветДействия.Получить("error") = Неопределено Тогда
			Возврат Действие.ОтветИнструмента;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Данные ответа из структуры сервиса: поля различаются для ЮЛ (ЕГРЮЛ) и ИП
// (ЕГРИП); отсутствующие в сервисе значения - null (спека п. 15).
//
// Параметры:
//  РеквизитыСервиса - Структура - результат РаботаСКонтрагентами.
//  ИНН              - Строка    - запрошенный ИНН (для определения вида).
//
// Возвращаемое значение:
//  Структура - {kind, name_full, name_short, kpp, ogrn, registration_date,
//  address, head, status, terminated, termination_date}.
//
Функция ДанныеОтветаОрганизации(Знач РеквизитыСервиса, Знач ИНН)

	Ответ = Новый Структура;
	Если СтрДлина(ИНН) = 12 Тогда
		Ответ.Вставить("kind", "ИП");
		Ответ.Вставить("name_full", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));
		Ответ.Вставить("name_short", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));
		Ответ.Вставить("kpp", Неопределено);
		Ответ.Вставить("ogrn", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "РегистрационныйНомер", ""));
		Ответ.Вставить("registration_date", ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаРегистрации"));
		Ответ.Вставить("address", Неопределено);
		Ответ.Вставить("head", РуководительПредпринимателя(РеквизитыСервиса));
		Ответ.Вставить("status", ТекстСтатусаОрганизации(РеквизитыСервиса));
		Ответ.Вставить("terminated", Ложь);
		Ответ.Вставить("termination_date", Неопределено);
	Иначе
		Ответ.Вставить("kind", "ЮЛ");
		Ответ.Вставить("name_full", НаименованиеЮЛПолное(РеквизитыСервиса));
		Ответ.Вставить("name_short", НаименованиеЮЛСокращенное(РеквизитыСервиса));
		Ответ.Вставить("kpp", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "КПП", ""));
		Ответ.Вставить("ogrn", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "РегистрационныйНомер", ""));
		Ответ.Вставить("registration_date", ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаРегистрации"));
		Ответ.Вставить("address", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "ЮридическийАдрес", ""));
		Ответ.Вставить("head", РуководительЮЛ(РеквизитыСервиса));
		Ответ.Вставить("status", ТекстСтатусаОрганизации(РеквизитыСервиса));
		ДатаПрекращения = ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаПрекращенияДеятельности");
		Ответ.Вставить("terminated", ЗначениеЗаполнено(ДатаПрекращения));
		Ответ.Вставить("termination_date", ?(ЗначениеЗаполнено(ДатаПрекращения),
			ДатаПрекращения, Неопределено));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Полное наименование ЮЛ: ЕГРЮЛ-варианты, затем обычные, затем Наименование.
Функция НаименованиеЮЛПолное(Знач РеквизитыСервиса)

	Возврат ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолноеЕГРЮЛ",
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));

КонецФункции

// Сокращенное наименование ЮЛ: ЕГРЮЛ-варианты, затем обычные, затем Наименование.
Функция НаименованиеЮЛСокращенное(Знач РеквизитыСервиса)

	Возврат ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенноеЕГРЮЛ",
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));

КонецФункции

// Руководитель ЮЛ: первая строка таблицы Руководители сервиса - текущие данные
// ЕГРЮЛ (даты окончания нет, признак «действующий» сервисом не передаётся; БИТ
// в КонтрагентыФормы тоже берёт Руководители[0]); должность - колонка Должность.
//
// Параметры:
//  РеквизитыСервиса - Структура - результат ДанныеСервисаПоИНН.
//
// Возвращаемое значение:
//  Структура - {name (ФИО), position}; Неопределено - руководителя нет.
//
Функция РуководительЮЛ(Знач РеквизитыСервиса)

	Руководители = ЗначениеИзСтруктуры(РеквизитыСервиса, "Руководители");
	Если ТипЗнч(Руководители) <> Тип("ТаблицаЗначений")
		Или Руководители.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтрокаТаблицы = Руководители[0];
	Руководитель = Новый Структура;
	Руководитель.Вставить("name", ФИОСтрокой(СтрокаТаблицы.Фамилия,
		СтрокаТаблицы.Имя, СтрокаТаблицы.Отчество));
	Руководитель.Вставить("position", ЗначениеВСтрокуДляОтвета(СтрокаТаблицы.Должность));
	Возврат Руководитель;

КонецФункции

// Руководитель для ИП: ФИО из полей Фамилия/Имя/Отчество; должности нет.
Функция РуководительПредпринимателя(Знач РеквизитыСервиса)

	ФИО = ФИОСтрокой(ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Фамилия", ""),
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Имя", ""),
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Отчество", ""));
	Если ПустаяСтрока(ФИО) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Руководитель = Новый Структура;
	Руководитель.Вставить("name", ФИО);
	Руководитель.Вставить("position", Неопределено);
	Возврат Руководитель;

КонецФункции

// ФИО одной строкой из частей (пустые части пропускаются).
Функция ФИОСтрокой(Знач Фамилия, Знач Имя, Знач Отчество)

	Части = Новый Массив;
	Части.Добавить(СокрЛП(Фамилия));
	Части.Добавить(СокрЛП(Имя));
	Части.Добавить(СокрЛП(Отчество));

	ЗаполненныеЧасти = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если НЕ ПустаяСтрока(Часть) Тогда
			ЗаполненныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(ЗаполненныеЧасти, " ");

КонецФункции

// Текст статуса из структуры сервиса: Статус может быть Структурой {Код,
// Наименование} или строкой (см. РаботаСКонтрагентами).
Функция ТекстСтатусаОрганизации(Знач РеквизитыСервиса)

	Статус = ЗначениеИзСтруктуры(РеквизитыСервиса, "Статус");
	Если ТипЗнч(Статус) = Тип("Структура") Тогда
		Возврат ЗначениеИзСтруктурыСтрокой(Статус, "Наименование", "");
	ИначеЕсли ТипЗнч(Статус) = Тип("Строка") Тогда
		Возврат Статус;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Значение свойства структуры без исключений.
Функция ЗначениеИзСтруктуры(Знач Данные, Знач ИмяСвойства)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Неопределено;
	Данные.Свойство(ИмяСвойства, Значение);
	Возврат Значение;

КонецФункции

// Строковое свойство структуры с подстановкой при пустом значении.
Функция ЗначениеИзСтруктурыСтрокой(Знач Данные, Знач ИмяСвойства, Знач Подстановка)

	Значение = ЗначениеИзСтруктуры(Данные, ИмяСвойства);
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Значение) Тогда
		Возврат Подстановка;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Запись каждого вызова nsi_official_data в ar_СлужебныйЛог (спека п. 15):
// ИНН, исход, длительность.
Функция ЗаписатьЛогОфициальныхДанных(Знач ИНН, Знач ОтветСервиса, Знач ДлительностьМс)

	Исход = "ок";
	Если ОтветСервиса.Свойство("error") Тогда
		Исход = Строка(ОтветСервиса.error);
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_official_data", СтрШаблон(
		НСтр("ru = 'ИНН %1: %2, %3 мс'"), ИНН, Исход, Формат(ДлительностьМс, "ЧГ=0")));

	Возврат Исход;

КонецФункции

#КонецОбласти

#Область ФактыЗапуска

// RunId из контекста запуска (agentrunner-66, спека А.2/А.5): та же защита на
// Неопределено и прочие типы, что у АгентИзКонтекста.
//
// Параметры:
//  Контекст - Структура - контекст запуска (может быть Неопределено).
//
// Возвращаемое значение:
//  Строка - идентификатор запуска; "" если в контексте его нет.
//
Функция RunIdИзКонтекста(Знач Контекст)

	RunId = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("RunId", RunId);
	КонецЕсли;
	Возврат ?(ТипЗнч(RunId) = Тип("Строка"), RunId, "");

КонецФункции

// Ответы одного инструмента в этом запуске из ar_ДействияАгента, в порядке
// выполнения. Источник факта «вызов уже был в этом запуске» (agentrunner-66,
// спека А.2/А.5) - без новых объектов метаданных. Dry-run вызовы исключены
// отбором по имени: диспетчер записывает их как «<имя> (dry_run)». Запись
// действия выполняется после возврата tool (ar_ИнструментыДиспетчер), поэтому
// текущий вызов в выборку не попадает.
//
// Параметры:
//  RunId          - Строка - идентификатор запуска.
//  ИмяИнструмента - Строка - точное имя инструмента пакета.
//
// Возвращаемое значение:
//  Массив из Структура {АргументыJSON, ОтветИнструмента} - Строка.
//
Функция ДействияЗапускаПоИнструменту(Знач RunId, Знач ИмяИнструмента)

	Ответы = Новый Массив;
	Если ПустаяСтрока(RunId) Или ПустаяСтрока(ИмяИнструмента) Тогда
		Возврат Ответы;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", Лев(RunId, 36));
	Запрос.УстановитьПараметр("ИмяИнструмента", ИмяИнструмента);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.ar_АргументыJSON КАК АргументыJSON,
		|	Д.ar_ОтветИнструмента КАК ОтветИнструмента
		|ИЗ
		|	РегистрСведений.ar_ДействияАгента КАК Д
		|ГДЕ
		|	Д.ar_ИдентификаторЗапуска = &RunId
		|	И Д.ar_ИмяИнструмента = &ИмяИнструмента
		|УПОРЯДОЧИТЬ ПО
		|	Д.ar_Последовательность";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ответы.Добавить(Новый Структура("АргументыJSON, ОтветИнструмента",
			Выборка.АргументыJSON, Выборка.ОтветИнструмента));
	КонецЦикла;

	Возврат Ответы;

КонецФункции

// Разбирает сохраненный JSON действия (аргументы либо ответ) в Соответствие.
// Усеченный при записи ответ разбирается с ошибкой - Неопределено.
//
// Параметры:
//  СтрокаJSON - Строка - сохраненный JSON.
//
// Возвращаемое значение:
//  Соответствие, Неопределено.
//
Функция JSONИзДействия(Знач СтрокаJSON)

	Если ТипЗнч(СтрокаJSON) <> Тип("Строка") Или ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Разобранный = ar_JSON.ИзJSON(СтрокаJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Разобранный) = Тип("Соответствие"), Разобранный, Неопределено);

КонецФункции

// Является ли сохраненный ответ успешным результатом решения (без ключа error
// и с done = true); отказы решения (visa_* , run_already_decided) - ответы с
// error, повторные решения ими не считаются.
//
// Параметры:
//  ОтветИнструмента - Строка - сохраненный ответ tool.
//
// Возвращаемое значение:
//  Булево.
//
Функция УспешныйОтветРешения(Знач ОтветИнструмента)

	Ответ = JSONИзДействия(ОтветИнструмента);
	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Ответ.Получить("error") = Неопределено
		И ЗначениеБулево(Ответ.Получить("done"));

КонецФункции

// Поставлено ли решение по визе в этом запуске (agentrunner-66, спека А.5):
// успешный вызов nsi_set_visa_decision в ar_ДействияАгента этого запуска.
//
// Параметры:
//  Контекст - Структура - контекст запуска.
//
// Возвращаемое значение:
//  Структура {Есть - Булево, СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение,
//  Неопределено - заявка успешного решения, если восстановима по его аргументам}.
//
Функция РешениеВЗапуске(Знач Контекст)

	Результат = Новый Структура;
	Результат.Вставить("Есть", Ложь);
	Результат.Вставить("СсылкаЗаявки", Неопределено);

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(
		RunIdИзКонтекста(Контекст), "nsi_set_visa_decision") Цикл

		Если НЕ УспешныйОтветРешения(Действие.ОтветИнструмента) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Есть = Истина;
		АргументыРешения = JSONИзДействия(Действие.АргументыJSON);
		Если АргументыРешения <> Неопределено Тогда
			ОтборЗаявки = ЗаявкаИзАргументов(АргументыРешения);
			Если ОтборЗаявки.КодОшибки = "" Тогда
				Результат.СсылкаЗаявки = ОтборЗаявки.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Прервать;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Указание модели завершить работу после решения (agentrunner-66, спека А.5) -
// текст ошибки run_already_decided и дополнение ответов visa_already_decided /
// visa_not_active.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗавершиРаботу()

	Возврат НСтр("ru = 'В этом запуске решение уже поставлено. Заверши работу:
		|дай итоговый отчёт без вызова инструментов.'");

КонецФункции

// model_hash прошлого чтения заявки в этом запуске (agentrunner-66, спека
// А.4): первый ответ nsi_get_request этого запуска по той же заявке. Сравнение
// с текущим хешем отличает «повторное чтение неизменной заявки» (краткий
// ответ) от чтения измененной (полный).
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//
// Возвращаемое значение:
//  Строка - model_hash прошлого ответа; "" - заявку в этом запуске не читали.
//
Функция ХешПрошлогоЧтенияЗаявки(Знач Контекст, Знач СсылкаЗаявки)

	СсылкаСтрокой = ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки);

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(
		RunIdИзКонтекста(Контекст), "nsi_get_request") Цикл

		ОтветДействия = JSONИзДействия(Действие.ОтветИнструмента);
		Если ОтветДействия = Неопределено
			Или Строка(ОтветДействия.Получить("request")) <> СсылкаСтрокой Тогда
			Продолжить;
		КонецЕсли;

		Возврат Строка(ОтветДействия.Получить("model_hash"));

	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ИнструментРешениеПоВизе

// Реализация инструмента nsi_set_visa_decision (спека п. 16-20; handover -
// п. 3 спеки agentrunner-35): проверки п. 17 до записи (провал - {"error",
// "message"} и ничего не пишется), пробный запуск, запись штатным механизмом
// (для handover - комментарий визы привилегированно) в транзакции с
// исключительной блокировкой (п. 19а), перечитывание визы и статуса; после
// handover - отметка отложения ядра вне транзакции. Каждый вызов (и отказ) -
// запись в ar_СлужебныйЛог.
// agentrunner-48 (п. 2.2): при любом исходе вызова, кроме _dry_run, пакет
// присоединяет к заявке текстовый файл протокола (UTF-8) с решением,
// протоколом модели и повторным расчетом проверок на момент решения; сбой
// записи файла не отменяет и не откатывает решение - в ответ добавляется
// protocol_file (имя) или protocol_file_error (текст), сбой - в журнал.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {request, visa_id, decision, comment,
//                  model_hash, protocol}, обогащенный _dry_run.
//  Контекст      - Структура - контекст запуска (нужны Агент, RunId).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"done","decision","visa_id","request_status",
//  "comment_truncated"[,"result_ref"],"protocol_file"[,...]} либо {"error", "message"
//  [,"protocol_file"|"protocol_file_error"]}.
//
Функция ВыполнитьРешениеПоВизе(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	DryRun = ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON);

	Проверки = ПроверкиПередРешением(Аргументы, Контекст);
	Если Проверки.КодОшибки <> "" Тогда
		ЗаписатьЛогРешения(Проверки, "", Контекст);
		// Протокол пишется и при отказе записи решения (п. 2.2 спеки) - с кодом
		// отказа; при protocol_required раздел пунктов агента пуст с пометкой.
		// agentrunner-108: терминальные коды (визы, run_already_decided,
		// заявка исключена) - с признаком завершения (контракт agentrunner-107).
		Возврат ОтветРешенияСПротоколом(
			ОшибкаИнструмента(Проверки.КодОшибки, Проверки.Сообщение,
				ЭтоТерминальныйКодОтказа(Проверки.КодОшибки)),
			Проверки, Контекст, DryRun,
			"отказ: " + Проверки.КодОшибки);
	КонецЕсли;

	// Пробный запуск: все проверки выполнены, запись не производится (спека п. 18).
	Если DryRun Тогда
		План = Новый Структура;
		План.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(Проверки.СсылкаЗаявки));
		План.Вставить("visa_id", Проверки.ИДВизы);
		План.Вставить("decision", Проверки.КодРешения);
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_set_visa_decision", План);
	КонецЕсли;

	ТекстЗаписи = "";
	Если НЕ ЗаписатьРешениеМеханизмомВизирования(Проверки, ТекстЗаписи) Тогда
		Если ПустаяСтрока(Проверки.КодОшибки) Тогда
			// Отказ механизма или исключение записи; отказ повторной проверки
			// под блокировкой кладет свой код п. 17 прямо в Проверки (п. 19а.3).
			Если Проверки.КодРешения = "handover" Тогда
				Проверки.КодОшибки = "handover_failed";
			ИначеЕсли Проверки.КодРешения = "restart" Тогда
				Проверки.КодОшибки = "restart_failed";
			Иначе
				Проверки.КодОшибки = "decision_failed";
			КонецЕсли;
			Проверки.Сообщение = ТекстЗаписи;
		КонецЕсли;
		ЗаписатьЛогРешения(Проверки, "", Контекст);
		Возврат ОтветРешенияСПротоколом(
			ОшибкаИнструмента(Проверки.КодОшибки, Проверки.Сообщение,
				ЭтоТерминальныйКодОтказа(Проверки.КодОшибки)),
			Проверки, Контекст, Ложь,
			"отказ: " + Проверки.КодОшибки);
	КонецЕсли;

	// handover: комментарий визы записан; отметка отложения пишется после
	// фиксации транзакции, ее сбой не отменяет передачу (п. 3 спеки).
	Если Проверки.КодРешения = "handover" Тогда
		Возврат ОтветРешенияСПротоколом(ОтветПослеПередачи(Проверки, Контекст),
			Проверки, Контекст, Ложь, "записано");
	КонецЕсли;

	ЗаписатьЛогРешения(Проверки, "ок", Контекст);

	// agentrunner-213: restart - визы сброшены, этапы заново в следующем запуске.
	Если Проверки.КодРешения = "restart" Тогда
		Возврат ОтветРешенияСПротоколом(ОтветПослеПовторногоЦикла(Проверки),
			Проверки, Контекст, Ложь, "записано");
	КонецЕсли;

	// agentrunner-89: после return инициатору открывается ожидание исправления
	// (диалог + письмо); после reject открытое с прошлого возврата ожидание
	// закрывается. Вне транзакции решения: сбой сообщения решение не откатывает.
	// 2.5.0: после approve визы этапа 2 инициатору - «Заявка выполнена».
	Ответ = ОтветПослеРешения(Проверки);
	Если Проверки.КодРешения = "return" Тогда
		ОповеститьОВозвратеНаИсправление(Проверки, Контекст, Ответ);
	ИначеЕсли Проверки.КодРешения = "reject" Тогда
		ЗакрытьОжиданиеПриОтказе(Проверки, Контекст, Ответ);
	ИначеЕсли Проверки.КодРешения = "approve" Тогда
		ОповеститьОВыполненииЗаявки(Проверки, Контекст, Ответ);
	КонецЕсли;
	ДобавитьПродолжениеЭтапомДва(Проверки, Контекст, Ответ);

	Возврат ОтветРешенияСПротоколом(ar_JSON.ВЗначениеJSON(Ответ),
		Проверки, Контекст, Ложь, "записано");

КонецФункции

// Присоединяет к ответу решения файл протокола (п. 2.2 спеки): файл пишется
// при любом исходе, кроме DryRun и вызовов без заявки (некуда присоединять).
// Итог записи (записано / отказ: код) попадает в текст протокола; сбой записи
// файла не меняет сам ответ решения - только добавляет protocol_file_error.
//
// Параметры:
//  СтрокаОтвета - Строка    - JSON-ответ инструмента ({"error",...} или ответ
//                 после записи).
//  Проверки     - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//                 Комментарий, КодРешения, Протокол).
//  Контекст     - Структура - контекст запуска (RunId, Агент).
//  DryRun       - Булево    - пробный запуск (файл не пишется).
//  ИтогЗаписи   - Строка    - «записано» либо «отказ: <код>» для протокола.
//
// Возвращаемое значение:
//  Строка - JSON-ответ с protocol_file (имя файла) или protocol_file_error.
//
Функция ОтветРешенияСПротоколом(Знач СтрокаОтвета, Знач Проверки, Знач Контекст,
	Знач DryRun, Знач ИтогЗаписи)

	Если DryRun Или Не ЗначениеЗаполнено(Проверки.СсылкаЗаявки) Тогда
		Возврат СтрокаОтвета;
	КонецЕсли;

	ЗаписьФайла = ЗаписатьПротоколПроверки(Проверки, Контекст, ИтогЗаписи);

	Ответ = ar_JSON.ИзJSON(СтрокаОтвета);
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Возврат СтрокаОтвета; // Битый ответ протоколом не дополняем.
	КонецЕсли;

	Если ЗаписьФайла.Успех Тогда
		Ответ.Вставить("protocol_file", ЗаписьФайла.ИмяФайла);
	Иначе
		Ответ.Вставить("protocol_file_error", ЗаписьФайла.Ошибка);
	КонецЕсли;

	// agentrunner-212: в успешный ответ (без error) добавляется subject -
	// объект работы для ядра; отказы остаются как есть (subject не ставится).
	Если ПустаяСтрока(Строка(Ответ.Получить("error"))) Тогда
		Ответ.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(Проверки.СсылкаЗаявки));
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Все проверки п. 17 спеки до записи (плюс проверки handover - п. 3 спеки
// agentrunner-35). Заполненные поля результата нужны и записи, и DryRun-плану,
// и логу.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//  Контекст  - Структура    - контекст запуска (нужен Агент).
//
// Возвращаемое значение:
//  Структура:
//   * КодОшибки          - Строка - "" или код отказа (п. 17).
//   * Сообщение          - Строка - текст отказа (перечень ошибок requisites_errors).
//   * СсылкаЗаявки       - ДокументСсылка - заявка.
//   * ИДВизы             - Строка - ИД визы.
//   * КодРешения         - Строка - approve / return / reject / handover.
//   * Виза               - СправочникСсылка - виза найденной записи (п. 17.2).
//   * Комментарий        - Строка - комментарий, усеченный до 500 (п. 19).
//   * Сценарий           - Строка - сценарий заявки; заполняется для handover
//                  (входит в комментарий визы).
//   * ХешАгента          - Строка - model_hash из аргументов; повторная проверка
//                  под блокировкой записи (п. 19а.3).
//   * УсеченКомментарий  - Булево - комментарий длиннее 500.
//   * ПользовательАгента - СправочникСсылка.Пользователи.
//   * ПроверкаДанных     - Структура, Неопределено - результат
//                  РезультатПроверкиОбработкой; заполняется в
//                  ОтказСогласованияЗаявки (agentrunner-87).
//
Функция ПроверкиПередРешением(Знач Аргументы, Знач Контекст)

	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("СсылкаЗаявки", Неопределено);
	Результат.Вставить("ИДВизы", "");
	Результат.Вставить("КодРешения", НРег(СокрЛП(ЗначениеИзКоллекции(Аргументы, "decision", ""))));
	Результат.Вставить("Виза", Неопределено);
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Сценарий", "");
	Результат.Вставить("ХешАгента", "");
	Результат.Вставить("УсеченКомментарий", Ложь);
	Результат.Вставить("ПользовательАгента", ПользовательАгентаИзКонтекста(Контекст));
	// agentrunner-48: протокол проверки из аргументов (массив пунктов) - для
	// файла протокола; заполняется в ОтказАргументовРешения.
	Результат.Вставить("Протокол", Новый Массив);
	// agentrunner-87: результат проверки данных обработкой - заполняется в
	// ОтказСогласованияЗаявки (approve); протокол повторно обработку не вызывает.
	Результат.Вставить("ПроверкаДанных", Неопределено);
	// agentrunner-88: этап визы, повторная сверка, review, комментарий визы,
	// счёт заявки и контрагент для approve этапа 2.
	Результат.Вставить("Этап", 0);
	Результат.Вставить("Сверка", Неопределено);
	Результат.Вставить("КонтекстСверки", Неопределено);
	Результат.Вставить("Review", Новый Массив);
	Результат.Вставить("КомментарийВизы", "");
	Результат.Вставить("УсеченКомментарийВизы", Ложь);
	Результат.Вставить("СчетЗаявки", Неопределено);
	Результат.Вставить("КонтрагентСсылка", Неопределено);
	// 2.5.7: для result_ref - счет, созданный approve этапа 2 (СоздатьСчетЭтапаДва),
	// и предмет заявки до решения этапа 1 (ЗаписатьРешениеМеханизмомВизирования).
	Результат.Вставить("СозданныйСчет", Неопределено);
	Результат.Вставить("ПредметДоРешения", Неопределено);
	// agentrunner-266: заявка из аргументов - для лога решения и при отказе до
	// присвоения СсылкаЗаявки; RunId запуска, который держит заявку.
	Результат.Вставить("ЗаявкаЛога", Неопределено);
	Результат.Вставить("RunIdДержателя", "");

	// 17.0: корректность аргументов решения (decision, visa_id, comment, model_hash).
	Если ОтказАргументовРешения(Аргументы, Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Комментарий = КомментарийИзАргументов(Аргументы, Результат.УсеченКомментарий);

	// 17.0: пользователь агента.
	Если НЕ ЗначениеЗаполнено(Результат.ПользовательАгента) Тогда
		Результат.КодОшибки = "agent_user_not_set";
		Результат.Сообщение = НСтр("ru = 'У агента не заполнен пользователь (ar_Агенты.ar_Пользователь).'");
		Возврат Результат;
	КонецЕсли;

	// 17.1: заявка доступна, запись визы есть, виза активна и без решения.
	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Результат.КодОшибки = ОтборЗаявки.КодОшибки;
		Результат.Сообщение = ?(ПустаяСтрока(ОтборЗаявки.Сообщение),
			ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение);
		Возврат Результат;
	КонецЕсли;
	Результат.ЗаявкаЛога = ОтборЗаявки.Ссылка;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - решение не
	// пишется. Отказ ДО присвоения СсылкаЗаявки: пустая СсылкаЗаявки отменяет
	// и файл протокола (никаких побочных эффектов на чужой заявке).
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Результат.КодОшибки = "run_subject_mismatch";
		Результат.Сообщение = ТекстЧужойЗаявки;
		Возврат Результат;
	КонецЕсли;

	// agentrunner-266: заявку держит другой живой запуск агента - решение
	// легло бы поперёк его работы (форма «Инструменты» или чужой запуск).
	// Отказ тоже ДО присвоения СсылкаЗаявки - без файла протокола на заявке.
	Результат.RunIdДержателя = ЗапускДержащийЗаявку(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(Результат.RunIdДержателя) Тогда
		Результат.КодОшибки = "subject_held_by_other_run";
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Заявку сейчас ведёт другой запуск агента (%1) - решение по визе не записано.
				|Заверши работу без решения: заявка вернётся в очередь после того запуска.';
				|en = 'The request is being handled by another agent run (%1) - the visa decision
				|was not recorded. Finish without a decision: the request returns to the queue
				|after that run.'"),
			Результат.RunIdДержателя);
		Возврат Результат;
	КонецЕсли;

	Результат.СсылкаЗаявки = ОтборЗаявки.Ссылка;

	// agentrunner-66 (спека А.5): решение в этом запуске уже поставлено - по
	// другой заявке решение не принимается (по той же - штатные коды ниже).
	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть И Решение.СсылкаЗаявки <> Результат.СсылкаЗаявки Тогда
		Результат.КодОшибки = "run_already_decided";
		Результат.Сообщение = ТекстЗавершиРаботу();
		Возврат Результат;
	КонецЕсли;

	// agentrunner-88: заявки исключённых внешних систем не решаются.
	Если ЗаявкаИсключена(Результат.СсылкаЗаявки) Тогда
		Результат.КодОшибки = "request_excluded_external_system";
		Результат.Сообщение = ТекстЗаявкаИсключена();
		Возврат Результат;
	КонецЕсли;

	// agentrunner-96: заявки автоактуализации решает nsi_actualize_request
	// (обе визы сценария) - обычное решение по визе не применяется.
	Если ЭтоЗаявкаАктуализацииПоСсылке(Результат.СсылкаЗаявки) Тогда
		Результат.КодОшибки = "use_actualize_request";
		Результат.Сообщение = ТекстИспользуйАктуализацию();
		Возврат Результат;
	КонецЕсли;

	// agentrunner-88: без visa_id - активная виза пользователя агента.
	ВизаАгента = АктивнаяВизаАгента(Контекст, Результат.СсылкаЗаявки);
	Если ПустаяСтрока(Результат.ИДВизы) Тогда
		Если НЕ ВизаАгента.Найдена Или ЗначениеЗаполнено(ВизаАгента.Решение) Тогда
			Результат.КодОшибки = "visa_not_active";
			Результат.Сообщение =
				НСтр("ru = 'Нет активной визы агента без решения - указать визу некому.'");
			Возврат Результат;
		КонецЕсли;
		Результат.ИДВизы = ВизаАгента.ИД;
	КонецЕсли;

	Если ОтказПоЗаписиВизы(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// agentrunner-88: этап активной визы по константам GUID; иная виза -
	// заявка агенту не выдаётся (visa_stage_unknown).
	Результат.Этап = ЭтапВизыПоСсылке(Результат.Виза);
	Если Результат.Этап = 0 Тогда
		Результат.КодОшибки = "visa_stage_unknown";
		Результат.Сообщение =
			НСтр("ru = 'Виза агента не входит в этапы маршрута (КонстантыGUID) - заявка
				|агенту не выдаётся.'");
		Возврат Результат;
	КонецЕсли;

	// 17.2: виза назначена пользователю агента.
	СписокВизАгента = бит_ВизированиеСервер.ВизыПользователя(
		Результат.ПользовательАгента, Результат.СсылкаЗаявки);
	Если СписокВизАгента.НайтиПоЗначению(Результат.Виза) = Неопределено Тогда
		Результат.КодОшибки = "visa_not_assigned_to_agent";
		Результат.Сообщение = НСтр("ru = 'Виза не назначена пользователю агента.'");
		Возврат Результат;
	КонецЕсли;

	// agentrunner-118 (п. 4 спеки): единая защита решения - решение допустимо,
	// только если входит в allowed_decisions последнего ответа сверки запуска.
	// restart (agentrunner-213) сверку этапа 1 не использует - у него свои
	// условия (ОтказПовторногоЦикла).
	Если Результат.КодРешения <> "restart" И ОтказНедопустимогоРешения(Результат, Контекст) Тогда
		Возврат Результат;
	КонецЕсли;

	// agentrunner-89 (спека п. 7): возврат сверх НСИЛимитВозвратов не ставится -
	// агенту предлагается reject (до 2.5.6 - передача сотруднику НСИ handover).
	Если Результат.КодРешения = "return" Тогда
		ЧислоВозвратов = ЧислоВозвратовЗаявки(Результат.СсылкаЗаявки);
		Лимит = ЛимитВозвратовЗаявки();
		Если ЧислоВозвратов >= Лимит Тогда
			Результат.КодОшибки = "return_limit_reached";
			Результат.Сообщение = СтрШаблон(
				НСтр("ru = 'Лимит возвратов исчерпан (%1 из %2). Отклони заявку решением reject,
					|в комментарии укажи неисправленные замечания.'"),
				ЧислоВозвратов, Лимит);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// 17.3: дополнительные проверки решений (повторная сверка пакета).
	Если Результат.КодРешения = "approve" И ОтказСогласованияЗаявки(Результат, Контекст) Тогда
		Возврат Результат;
	КонецЕсли;

	// agentrunner-88: return - «Отклонено» с пометкой возврата; замечания
	// обязательны (замечания пакета + review агента).
	Если Результат.КодРешения = "return" И ОтказВозвратаЗаявки(Результат, Контекст) Тогда
		Возврат Результат;
	КонецЕсли;

	// agentrunner-88: reject - «Отклонено» окончательно с основанием; сверка
	// считается для протокола.
	Если Результат.КодРешения = "reject" И ОтказОтклоненияЗаявки(Результат, Контекст) Тогда
		Возврат Результат;
	КонецЕсли;

	// handover (п. 3 спеки agentrunner-35): проверки approve (сценарий,
	// отключатель, повтор проверки реквизитов) не применяются, но model_hash
	// сверяется с текущими данными; сценарий вычисляется для комментария визы.
	Если Результат.КодРешения = "handover" И ОтказПроверкиПередачи(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// agentrunner-213: restart - сброс виз и повторный цикл, только на этапе 2
	// заявки, изменённой после визы 1.
	Если Результат.КодРешения = "restart" И ОтказПовторногоЦикла(Результат, Контекст) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверки restart (agentrunner-213, решение человека): этап 2, model_hash
// против текущих данных, есть причина повторного цикла (заявка изменена после
// визы 1 или хеш визы 1 не найден) и нет причин передачи сотруднику (виза 1 не
// согласована, контрагент не создан, лимит повторных циклов исчерпан).
// Заполняет РезультатПроверок.Комментарий причинами повторного цикла.
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением
//                      (заполняются КодОшибки/Сообщение, Комментарий, Сценарий).
//  Контекст          - Структура - контекст запуска.
//
// Возвращаемое значение:
//  Булево - Истина, если повторный цикл начинать нельзя.
//
Функция ОтказПовторногоЦикла(Знач РезультатПроверок, Знач Контекст)

	Если РезультатПроверок.Этап <> 2 Тогда
		РезультатПроверок.КодОшибки = "restart_not_allowed";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'restart - только по визе второго этапа («Анализ БА (утв)»).'");
		Возврат Истина;
	КонецЕсли;

	ДанныеЗаявки = ДанныеЗаявки(РезультатПроверок.СсылкаЗаявки);
	Если ОтказПоХешуМодели(ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	РезультатПроверок.Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);
	ДанныеЭтапа2 = ДанныеЭтапаДва(Контекст, РезультатПроверок.СсылкаЗаявки, ДанныеЗаявки,
		МодельСтало, РезультатПроверок.ХешАгента);
	Если НЕ СтрНачинаетсяС(ДанныеЭтапа2.СледующийШаг, "restart:") Тогда
		РезультатПроверок.КодОшибки = "restart_not_allowed";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Повторный цикл не нужен или невозможен - решение по полю next
				|ответа nsi_get_request: %1.'"), ДанныеЭтапа2.СледующийШаг);
		Возврат Истина;
	КонецЕсли;

	РезультатПроверок.Комментарий = СокрЛП(Сред(ДанныеЭтапа2.СледующийШаг,
		СтрДлина("restart:") + 1));
	Возврат Ложь;

КонецФункции

// Проверки 17.0 - корректность аргументов решения: decision из набора
// approve/return/reject/handover, наличие visa_id, комментарий для return/
// reject/handover, model_hash для любого решения. Вынесена из
// ПроверкиПередРешением ради ее сложности; при отказе заполняет
// Результат.КодОшибки/Сообщение кодом отказа п. 17.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//  Результат - Структура    - результат ПроверкиПередРешением (КодРешения уже
//              прочитан; заполняются КодОшибки/Сообщение, ИДВизы, ХешАгента).
//
// Возвращаемое значение:
//  Булево - Истина, если аргументы некорректны и решение принимать нельзя.
//
Функция ОтказАргументовРешения(Знач Аргументы, Знач Результат)

	КодРешения = Результат.КодРешения;
	Если КодРешения <> "approve" И КодРешения <> "return" И КодРешения <> "reject"
		И КодРешения <> "handover" И КодРешения <> "restart" Тогда
		Результат.КодОшибки = "invalid_decision";
		Результат.Сообщение =
			НСтр("ru = 'decision должен быть approve, return, reject, handover или restart.'");
		Возврат Истина;
	КонецЕсли;

	// agentrunner-88: visa_id необязателен - без него берётся активная виза
	// пользователя агента (АктивнаяВизаАгента в ПроверкиПередРешением).
	ИДВизы = ЗначениеИзКоллекции(Аргументы, "visa_id", "");
	Если ТипЗнч(ИДВизы) = Тип("Строка") И НЕ ПустаяСтрока(ИДВизы) Тогда
		Результат.ИДВизы = СокрЛП(ИДВизы);
	КонецЕсли;

	КомментарийАргумента = ЗначениеИзКоллекции(Аргументы, "comment", "");
	Если ТипЗнч(КомментарийАргумента) <> Тип("Строка") Тогда
		КомментарийАргумента = Строка(КомментарийАргумента);
	КонецЕсли;
	// restart: причины повторного цикла пакет берет сам (комментарий не нужен).
	Если КодРешения <> "approve" И КодРешения <> "restart"
		И ПустаяСтрока(КомментарийАргумента) Тогда
		Результат.КодОшибки = "comment_required";
		Результат.Сообщение =
			НСтр("ru = 'Для return, reject и handover обязателен комментарий.'");
		Возврат Истина;
	КонецЕсли;

	Результат.ХешАгента = ЗначениеИзКоллекции(Аргументы, "model_hash", "");
	Если ТипЗнч(Результат.ХешАгента) <> Тип("Строка") Тогда
		Результат.ХешАгента = "";
	КонецЕсли;
	// agentrunner-213 (запуск e6df4518): хеш сверяют все решения; return без
	// model_hash получал ложный отказ request_changed при неизменной заявке.
	Если ПустаяСтрока(Результат.ХешАгента) Тогда
		Результат.КодОшибки = "model_hash_required";
		Результат.Сообщение =
			НСтр("ru = 'Для любого решения обязателен model_hash из nsi_get_request.'");
		Возврат Истина;
	КонецЕсли;

	// agentrunner-88: protocol больше не обязателен (протокол решения строит
	// пакет из повторной сверки); если передан - проверяются пункты.
	ПротоколАргумента = ЗначениеИзКоллекции(Аргументы, "protocol", Неопределено);
	Если ТипЗнч(ПротоколАргумента) = Тип("Массив") И ПротоколАргумента.Количество() > 0 Тогда
		НомерПункта = 0;
		Для Каждого ПунктПротокола Из ПротоколАргумента Цикл
			НомерПункта = НомерПункта + 1;
			Если Не ПунктПротоколаКорректен(ПунктПротокола) Тогда
				Результат.КодОшибки = "protocol_required";
				Результат.Сообщение = СтрШаблон(
					НСтр("ru = 'Элемент %1 протокола (protocol) некорректен: нужны непустые item,
						|check и result - один из «ок», «замечание», «блокирует», «не выполнена»,
						|«не применимо».'"),
					Строка(НомерПункта));
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Результат.Протокол = ПротоколАргумента;
	КонецЕсли;

	// agentrunner-88: ответы по пунктам needs_review - для approve проверяются
	// против пунктов сверки (ОтказСогласованияЗаявки).
	ReviewАргумента = ЗначениеИзКоллекции(Аргументы, "review", Неопределено);
	Если ReviewАргумента <> Неопределено Тогда
		Если ТипЗнч(ReviewАргумента) <> Тип("Массив") Тогда
			Результат.КодОшибки = "invalid_arguments";
			Результат.Сообщение =
				НСтр("ru = 'Аргумент review - массив пунктов {id, result: ok|remark, text}.'");
			Возврат Истина;
		КонецЕсли;
		НомерПункта = 0;
		Для Каждого ПунктReview Из ReviewАргумента Цикл
			НомерПункта = НомерПункта + 1;
			Если НЕ ПунктReviewКорректен(ПунктReview) Тогда
				Результат.КодОшибки = "invalid_arguments";
				Результат.Сообщение = СтрШаблон(
					НСтр("ru = 'Элемент %1 аргумента review некорректен: нужны id, result -
						|«ok» или «remark» - и text для remark.'"), Строка(НомерПункта));
				Возврат Истина;
			КонецЕсли;
			Результат.Review.Добавить(ПунктReview);
		КонецЦикла;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Корректность одного пункта review (agentrunner-88): Соответствие с непустым
// id и result из «ok»/«remark»; для remark - непустой text.
//
// Параметры:
//  ПунктReview - Произвольный - элемент массива review.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПунктReviewКорректен(Знач ПунктReview)

	Если ТипЗнч(ПунктReview) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Идентификатор = СокрЛП(Строка(ПунктReview.Получить("id")));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	Итог = НРег(СокрЛП(Строка(ПунктReview.Получить("result"))));
	Если Итог <> "ok" И Итог <> "remark" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Итог = "remark" И ПустаяСтрока(СокрЛП(Строка(ПунктReview.Получить("text")))) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Корректность одного пункта протокола (п. 2.1 спеки): Соответствие с
// непустыми строками item и check и result из словаря итогов (ок / замечание /
// блокирует / не выполнена / не применимо). request_value, source_value и
// source необязательны.
//
// Параметры:
//  ПунктПротокола - Произвольный - элемент массива protocol.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПунктПротоколаКорректен(Знач ПунктПротокола)

	Если ТипЗнч(ПунктПротокола) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Пункт = Строка(ПунктПротокола.Получить("item"));
	Если ПустаяСтрока(СокрЛП(Пункт)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Проверка = Строка(ПунктПротокола.Получить("check"));
	Если ПустаяСтрока(СокрЛП(Проверка)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Итог = НРег(СокрЛП(Строка(ПунктПротокола.Получить("result"))));
	Возврат Итог = "ок"
		Или Итог = "замечание"
		Или Итог = "блокирует"
		Или Итог = "не выполнена"
		Или Итог = "не применимо";

КонецФункции

// Проверки handover перед записью (п. 3 спеки agentrunner-35): model_hash
// против текущих данных заявки; заодно вычисляется сценарий заявки - он
// входит в текст комментария визы для сотрудника НСИ. Вынесена из
// ПроверкиПередРешением ради ее когнитивной сложности.
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением
//                      (нужна СсылкаЗаявки; заполняются КодОшибки/Сообщение,
//                      Сценарий).
//
// Возвращаемое значение:
//  Булево - Истина, если передачу сотруднику делать нельзя.
//
Функция ОтказПроверкиПередачи(Знач РезультатПроверок)

	ДанныеЗаявки = ДанныеЗаявки(РезультатПроверок.СсылкаЗаявки);
	Если ОтказПоХешуМодели(ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	РезультатПроверок.Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);
	Возврат Ложь;

КонецФункции

// Единая защита решения (agentrunner-118, п. 4 спеки): решение допустимо,
// только если входит в allowed_decisions последнего ответа сверки этого запуска
// по этой заявке (nsi_verify_request либо итог сверки nsi_submit_file_data -
// см. ПоследнийОтветСверкиЗапуска). Сверки в запуске не было (либо ответы не
// разобрались) - защита молчит, действуют точечные проверки п. 17. Отказ с
// кодом decision_not_allowed гасит попытки решить вне списка допустимых.
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужны
//                      СсылкаЗаявки, КодРешения; заполняются КодОшибки/Сообщение).
//  Контекст          - Структура - контекст запуска (нужен RunId).
//
// Возвращаемое значение:
//  Булево - Истина, если решение вне допустимых и отклоняется.
//
Функция ОтказНедопустимогоРешения(Знач РезультатПроверок, Знач Контекст)

	ОтветСверки = ПоследнийОтветСверкиЗапуска(RunIdИзКонтекста(Контекст),
		РезультатПроверок.СсылкаЗаявки);
	Если ОтветСверки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Допустимые = ОтветСверки.Получить("allowed_decisions");
	Если ТипЗнч(Допустимые) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	ДопустимыеСтроки = Новый Массив;
	Для Каждого ДопустимоеРешение Из Допустимые Цикл
		СтрокаРешения = Строка(ДопустимоеРешение);
		ДопустимыеСтроки.Добавить(СтрокаРешения);
		Если СтрокаРешения = РезультатПроверок.КодРешения Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	РезультатПроверок.КодОшибки = "decision_not_allowed";
	РезультатПроверок.Сообщение = СтрШаблон(
		НСтр("ru = 'Решение %1 не входит в допустимые решения последнего ответа
			|сверки (%2).'"),
		РезультатПроверок.КодРешения, СтрСоединить(ДопустимыеСтроки, ", "));

	Возврат Истина;

КонецФункции

// Запись визы заявки (п. 17.1 спеки): найдена, активна и без решения. При
// отказе заполняет КодОшибки/Сообщение (visa_not_found / visa_not_active /
// visa_already_decided) и возвращает Истина. Ссылка визы записи сохраняется в
// РезультатПроверок.Виза. Данные читаются заново при каждом вызове:
// используется и в предварительных проверках, и в повторной проверке под
// блокировкой записи (п. 19а.3).
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужны
//                      СсылкаЗаявки и ИДВизы; заполняются КодОшибки/Сообщение).
//
// Возвращаемое значение:
//  Булево - Истина, если решение по этой визе ставить нельзя.
//
Функция ОтказПоЗаписиВизы(Знач РезультатПроверок)

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", РезультатПроверок.СсылкаЗаявки);
	Отбор.Вставить("ИД", РезультатПроверок.ИДВизы);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		РезультатПроверок.КодОшибки = "visa_not_found";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Виза с ИД %1 у заявки не найдена.'"), РезультатПроверок.ИДВизы);
		Возврат Истина;
	КонецЕсли;

	ЗаписьВизы = НаборВизы[0];
	РезультатПроверок.Виза = ЗаписьВизы.Виза;
	Если НЕ ЗаписьВизы.АктивнаяВиза Тогда
		РезультатПроверок.КодОшибки = "visa_not_active";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Виза не активна (заявка ушла с этой точки визирования).
				|Заверши работу: дай итоговый отчёт без вызова инструментов.'");
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаписьВизы.Решение) Тогда
		РезультатПроверок.КодОшибки = "visa_already_decided";
		РезультатПроверок.Сообщение = НСтр("ru = 'По визе уже есть решение - повторное решение делается
			|штатной отменой в «БИТ». Заверши работу: дай итоговый отчёт без вызова инструментов.'");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверки approve (п. 5 спеки): отключатель, повторная сверка пакета без
// участия модели (тексты - из кэша, сданные данные - из действий запуска,
// ЕГР - из ответа сверки запуска). Этап 1: итог ready, все файлы сданы,
// каждый needs_review закрыт ok. Этап 2: виза 1 «Согласовано», контрагент
// создан, счёт без конфликтов (создание - в транзакции записи решения).
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужны
//                      СсылкаЗаявки, ХешАгента, Этап, Review; заполняются
//                      КодОшибки/Сообщение, Сверка, Сценарий, СчетЗаявки,
//                      КонтрагентСсылка, ПроверкаДанных).
//  Контекст          - Структура - контекст запуска (RunId).
//
// Возвращаемое значение:
//  Булево - Истина, если approve запрещён.
//
Функция ОтказСогласованияЗаявки(Знач РезультатПроверок, Знач Контекст)

	Если НастройкаИстинна(ar_Настройки.ЗначениеНастройки("НСИАгентТолькоВозвращает", Ложь)) Тогда
		РезультатПроверок.КодОшибки = "approve_disabled";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Approve запрещён настройкой пакета «НСИ: агент только возвращает».'");
		Возврат Истина;
	КонецЕсли;

	// Повторная сверка заявки без участия модели (п. 5 спеки).
	Сверка = ПовторнаяСверкаДляРешения(РезультатПроверок, Контекст);

	Если ОтказПоХешуМодели(РезультатПроверок.КонтекстСверки.ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	Если РезультатПроверок.Этап = 2 Тогда
		Возврат ОтказСогласованияЭтапаДва(РезультатПроверок, Сверка);
	КонецЕсли;

	// Этап 1: сценарий определен (вид и резидентность субъекта распознаны).
	Если НЕ СценарийОпределен(РезультатПроверок.Сценарий) Тогда
		РезультатПроверок.КодОшибки = "scenario_not_determined";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Сценарий заявки не определён (не распознан вид или резидентность субъекта) -
				|согласование невозможно, верни заявку инициатору (return).'");
		Возврат Истина;
	КонецЕсли;

	// Итог сверки должен быть ready (файлы_pending, расхождения, замечания -
	// отказ с перечнем причин).
	Если Сверка.Вердикт <> "ready" Тогда
		РезультатПроверок.КодОшибки = ?(Сверка.Вердикт = "files_not_submitted"
			Или Сверка.Вердикт = "files_pending", Сверка.Вердикт, "verify_not_ready");
		РезультатПроверок.Сообщение = СообщениеНеГотовоСверки(Сверка);
		Возврат Истина;
	КонецЕсли;

	// Все файлы сданы.
	Если ФайлыСлева(Сверка.СтатусыФайлов, РезультатПроверок.КонтекстСверки).Количество() > 0 Тогда
		РезультатПроверок.КодОшибки = "files_not_submitted";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Сданы не все части файлов: %1.'"),
			СтрСоединить(ФайлыСлева(Сверка.СтатусыФайлов, РезультатПроверок.КонтекстСверки), ", "));
		Возврат Истина;
	КонецЕсли;

	// Каждый needs_review закрыт агентом в review.
	НезакрытыеПункты = НезакрытыеПунктыReview(Сверка.ПунктыReview, РезультатПроверок.Review);
	Если НезакрытыеПункты.Количество() > 0 Тогда
		РезультатПроверок.КодОшибки = "review_incomplete";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Не все пункты needs_review закрыты в review (result = ok): %1.'"),
			СтрСоединить(НезакрытыеПункты, ", "));
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверки approve этапа 2 (п. 5 спеки): виза 1 «Согласовано», контрагент
// создан, заявка не менялась после визы 1, банк счёта найден и действует, ключ
// счёта верен. Такой же счёт у другого контрагента не мешает (agentrunner-213).
// Само создание счёта - в транзакции решения (ЗаписатьРешениеМеханизмомВизирования).
//
// Возвращаемое значение:
//  Булево - Истина, если approve этапа 2 запрещён.
//
Функция ОтказСогласованияЭтапаДва(Знач РезультатПроверок, Знач Сверка)

	КонтекстСверки = РезультатПроверок.КонтекстСверки;
	ДанныеЗаявки = КонтекстСверки.ДанныеЗаявки;
	Виза1 = ДанныеВизы1(РезультатПроверок.СсылкаЗаявки);
	Если Виза1 = Неопределено Или НЕ ЗначениеБулево(Виза1.approved) Тогда
		РезультатПроверок.КодОшибки = "visa1_not_approved";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Виза первого этапа не согласована - одобрение второго этапа
				|невозможно.'");
		Возврат Истина;
	КонецЕсли;

	Предмет = ДанныеЗаявки.Шапка.Предмет;
	Если НЕ ЗначениеЗаполнено(Предмет)
		Или НЕ ОбщегоНазначения.СсылкаСуществует(Предмет) Тогда
		РезультатПроверок.КодОшибки = "counterparty_not_created";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Контрагент не создан после визы 1 - передайте заявку сотруднику НСИ
				|(handover).'");
		Возврат Истина;
	КонецЕсли;
	РезультатПроверок.КонтрагентСсылка = Предмет;

	// agentrunner-213: заявку изменили после визы 1 (или хеш визы 1 не найден) -
	// approve запрещён, заявка проходит визы заново решением restart. Хеш агента
	// уже сверен с текущими данными (ОтказПоХешуМодели).
	ХешВизы1 = ХешИзПротоколаВизы1(РезультатПроверок.СсылкаЗаявки);
	Если ПустаяСтрока(ХешВизы1) Или ХешВизы1 <> РезультатПроверок.ХешАгента Тогда
		РезультатПроверок.КодОшибки = "model_changed_since_visa1";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Заявка изменена после визы первого этапа - одобрение второго этапа
				|невозможно. Сбрось визы решением restart: заявка пройдёт этапы заново.'");
		Возврат Истина;
	КонецЕсли;

	СчетЗаявки = СчетЗаявкиЭтапаДва(КонтекстСверки.МодельСтало, ДанныеЗаявки.Шапка);
	РезультатПроверок.СчетЗаявки = СчетЗаявки;

	Если СчетЗаявки.in_request Тогда
		Если СчетЗаявки.bank = Неопределено Тогда
			РезультатПроверок.КодОшибки = "bank_not_found";
			РезультатПроверок.Сообщение = СтрШаблон(
				НСтр("ru = 'Банк по БИК %1 не найден в справочнике - верните заявку
					|инициатору (return).'"), СчетЗаявки.bik);
			Возврат Истина;
		КонецЕсли;
		Если НЕ СчетЗаявки.bank_active Тогда
			РезультатПроверок.КодОшибки = "bank_inactive";
			РезультатПроверок.Сообщение = СтрШаблон(
				НСтр("ru = 'Банк по БИК %1 отмечен как не действующий - верните заявку
					|инициатору (return).'"), СчетЗаявки.bik);
			Возврат Истина;
		КонецЕсли;
		Если НЕ СчетЗаявки.key_valid Тогда
			РезультатПроверок.КодОшибки = "bank_account_invalid_key";
			РезультатПроверок.Сообщение = СтрШаблон(
				НСтр("ru = 'Контрольный ключ счёта %1 неверен - верните заявку инициатору
					|(return).'"), СчетЗаявки.number);
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Повторная сверка заявки для решения (п. 5 спеки): заново считает итог
// сверки без участия модели - тексты файлов из кэша, сданные моделью данные
// из действий запуска, ответ ЕГР из ответа сверки запуска. Заполняет в
// РезультатПроверок: Сверка, КонтекстСверки, Сценарий, ПроверкаДанных.
//
// Возвращаемое значение:
//  Структура - результат ВычислитьСверкуЗаявки.
//
Функция ПовторнаяСверкаДляРешения(Знач РезультатПроверок, Знач Контекст)

	КонтекстСверки = КонтекстСверки(РезультатПроверок.СсылкаЗаявки);
	ЗаполнитьСданныеЧастиИзДействийЗапуска(КонтекстСверки, RunIdИзКонтекста(Контекст));
	КонтекстСверки.ОфициальныеДанные = ОфициальныеИзДействияСверки(
		RunIdИзКонтекста(Контекст), РезультатПроверок.СсылкаЗаявки);

	Сверка = ВычислитьСверкуЗаявки(КонтекстСверки, Ложь);

	РезультатПроверок.КонтекстСверки = КонтекстСверки;
	РезультатПроверок.Сверка = Сверка;
	РезультатПроверок.Сценарий = КонтекстСверки.Сценарий;
	РезультатПроверок.ПроверкаДанных = Сверка.ОбработкаПроверки;

	Возврат Сверка;

КонецФункции

// Официальные данные ЕГР из последнего ответа nsi_verify_request этого
// запуска по заявке (п. 5: ЕГР - из кэша запуска); вызовов сверки не было -
// Неопределено (сверка запросит сервис сама).
//
// Возвращаемое значение:
//  Структура {result, remarks, kpp, ogrn, terminated,
//  termination_date} или Неопределено.
//
Функция ОфициальныеИзДействияСверки(Знач RunId, Знач СсылкаЗаявки)

	НавСсылкаЗаявки = ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки);
	Найденные = Неопределено;

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(RunId, "nsi_verify_request") Цикл
		Ответ = JSONИзДействия(Действие.ОтветИнструмента);
		Если Ответ = Неопределено
			Или Строка(Ответ.Получить("request")) <> НавСсылкаЗаявки Тогда
			Продолжить;
		КонецЕсли;
		Официальные = Ответ.Получить("official");
		Если ТипЗнч(Официальные) = Тип("Соответствие") Тогда
			Найденные = Официальные;
		КонецЕсли;
	КонецЦикла;

	Если Найденные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("result", Строка(Найденные.Получить("result")));
	Результат.Вставить("kpp", Строка(Найденные.Получить("kpp")));
	Результат.Вставить("ogrn", Строка(Найденные.Получить("ogrn")));
	Результат.Вставить("terminated", ЗначениеБулево(Найденные.Получить("terminated")));
	ДатаПрекращения = Найденные.Получить("termination_date");
	Результат.Вставить("termination_date",
		?(ТипЗнч(ДатаПрекращения) = Тип("Строка"), ДатаПрекращения, ""));
	Замечания = Новый Массив;
	ЗамечанияJSON = Найденные.Получить("remarks");
	Если ТипЗнч(ЗамечанияJSON) = Тип("Массив") Тогда
		Для Каждого Замечание Из ЗамечанияJSON Цикл
			Замечания.Добавить(Строка(Замечание));
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("remarks", Замечания);
	Возврат Результат;

КонецФункции

// Последний ответ сверки этого запуска по заявке (agentrunner-118, п. 4 спеки -
// источник allowed_decisions для защиты решения): ответы nsi_verify_request
// (заявка - в ответе) и nsi_submit_file_data (заявка - в аргументах вызова,
// итог сверки - в ответе при каждой сдаче). Один запрос по двум именам, в
// порядке выполнения; сверки в запуске не было либо ответы не разобрались -
// Неопределено. Образец отбора - ДействияЗапускаПоИнструменту и
// ОфициальныеИзДействияСверки.
//
// Параметры:
//  RunId        - Строка - идентификатор запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Соответствие - разобранный последний ответ со сверкой; Неопределено - нет.
//
Функция ПоследнийОтветСверкиЗапуска(Знач RunId, Знач СсылкаЗаявки)

	Найденный = Неопределено;
	Если ПустаяСтрока(RunId) Тогда
		Возврат Найденный;
	КонецЕсли;

	НавСсылкаЗаявки = ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки);
	// Номер - для отбора сдач, где модель передала request номером или
	// представлением, а не навигационной ссылкой (agentrunner-66, спека А.3).
	НомерЗаявки = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаЗаявки, "Номер")));

	ИменаИнструментов = Новый Массив;
	ИменаИнструментов.Добавить("nsi_verify_request");
	ИменаИнструментов.Добавить("nsi_submit_file_data");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", Лев(RunId, 36));
	Запрос.УстановитьПараметр("ИменаИнструментов", ИменаИнструментов);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.ar_ИмяИнструмента КАК ИмяИнструмента,
		|	Д.ar_АргументыJSON КАК АргументыJSON,
		|	Д.ar_ОтветИнструмента КАК ОтветИнструмента
		|ИЗ
		|	РегистрСведений.ar_ДействияАгента КАК Д
		|ГДЕ
		|	Д.ar_ИдентификаторЗапуска = &RunId
		|	И Д.ar_ИмяИнструмента В (&ИменаИнструментов)
		|УПОРЯДОЧИТЬ ПО
		|	Д.ar_Последовательность";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Ответ = JSONИзДействия(Выборка.ОтветИнструмента);
		Если Ответ = Неопределено
			Или ТипЗнч(Ответ.Получить("allowed_decisions")) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Если Выборка.ИмяИнструмента = "nsi_verify_request" Тогда
			ЭтоЗаявкаСверки = (Строка(Ответ.Получить("request")) = НавСсылкаЗаявки);
		Иначе
			Аргументы = JSONИзДействия(Выборка.АргументыJSON);
			СтрокаЗаявки = ?(Аргументы = Неопределено, "",
				СокрЛП(Строка(Аргументы.Получить("request"))));
			ЭтоЗаявкаСверки = (СтрокаЗаявки = НавСсылкаЗаявки
				Или (НЕ ПустаяСтрока(НомерЗаявки)
					И СтрНайти(СтрокаЗаявки, НомерЗаявки) > 0));
		КонецЕсли;

		Если ЭтоЗаявкаСверки Тогда
			Найденный = Ответ;
		КонецЕсли;

	КонецЦикла;

	Возврат Найденный;

КонецФункции

// Сообщение отказа verify_not_ready: вердикт сверки и первые замечания.
Функция СообщениеНеГотовоСверки(Знач Сверка)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Итог сверки: %1.'"), Сверка.Вердикт));
	НомерЗамечания = 0;
	Для Каждого Замечание Из Сверка.Замечания Цикл
		НомерЗамечания = НомерЗамечания + 1;
		Если НомерЗамечания > 5 Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить(Строка(Замечание.text));
	КонецЦикла;
	Возврат СтрСоединить(Строки, " ");

КонецФункции

// Пункты needs_review, не закрытые в review аргумента (result = ok).
//
// Возвращаемое значение:
//  Массив из Строка - идентификаторы незакрытых пунктов.
//
Функция НезакрытыеПунктыReview(Знач ПунктыReview, Знач ReviewАгента)

	Незакрытые = Новый Массив;
	Для Каждого Пункт Из ПунктыReview Цикл
		Закрыт = Ложь;
		Для Каждого ОтветАгента Из ReviewАгента Цикл
			Если Строка(ОтветАгента.Получить("id")) = Строка(Пункт.id)
				И НРег(СокрЛП(Строка(ОтветАгента.Получить("result")))) = "ok" Тогда
				Закрыт = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Закрыт Тогда
			Незакрытые.Добавить(Строка(Пункт.id));
		КонецЕсли;
	КонецЦикла;
	Возврат Незакрытые;

КонецФункции

// Проверки return (п. 5 спеки): повторная сверка даёт замечания; вместе с
// замечаниями агента (review, result = remark) они обязательны - иначе
// remarks_required. Комментарий визы: «Возвращено на исправление:» с
// нумерованными замечаниями, до 500 символов с признаком усечения.
//
// Возвращаемое значение:
//  Булево - Истина, если возврат делать нельзя.
//
Функция ОтказВозвратаЗаявки(Знач РезультатПроверок, Знач Контекст)

	Сверка = ПовторнаяСверкаДляРешения(РезультатПроверок, Контекст);

	Если ОтказПоХешуМодели(РезультатПроверок.КонтекстСверки.ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	Замечания = ЗамечанияВозвратаСтроками(Сверка, РезультатПроверок.Review);
	Если РезультатПроверок.Этап = 2 Тогда
		// Этап 2: ошибки счёта заявки - замечания возврата (agentrunner-213).
		КонтекстРешения = РезультатПроверок.КонтекстСверки;
		СчетЗаявки = СчетЗаявкиЭтапаДва(КонтекстРешения.МодельСтало, КонтекстРешения.ДанныеЗаявки.Шапка);
		Для Каждого Причина Из ПричиныВозвратаСчета(СчетЗаявки) Цикл
			Если Замечания.Найти(Причина) = Неопределено Тогда
				Замечания.Добавить(Причина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Замечания.Количество() = 0 Тогда
		РезультатПроверок.КодОшибки = "remarks_required";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Возврат без замечаний невозможен: опишите проблемы в review
				|(result = remark) - инициатор исправляет заявку по этим замечаниям.'");
		Возврат Истина;
	КонецЕсли;

	// Усечение - через локальную переменную: свойство структуры в параметр
	// без Знач передаётся копией и обратно не записывается.
	Усечение = Ложь;
	КомментарийВизы = КомментарийВизыВозврата(Замечания, Усечение);
	РезультатПроверок.КомментарийВизы = КомментарийВизы;
	РезультатПроверок.УсеченКомментарийВизы = Усечение;

	Возврат Ложь;

КонецФункции

// Замечания возврата строками: замечания сверки пакета + замечания ЕГР
// (ДобавитьЗамечанияЕГРВозврата) + замечания агента из review (result = remark);
// без дублей.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗамечанияВозвратаСтроками(Знач Сверка, Знач ReviewАгента)

	Замечания = Новый Массив;
	Для Каждого ЗамечаниеСверки Из Сверка.Замечания Цикл
		Если Замечания.Найти(Строка(ЗамечаниеСверки.text)) = Неопределено Тогда
			Замечания.Добавить(Строка(ЗамечаниеСверки.text));
		КонецЕсли;
	КонецЦикла;

	ДобавитьЗамечанияЕГРВозврата(Замечания, Сверка.Официальные);

	Для Каждого Пункт Из ReviewАгента Цикл
		Если НРег(СокрЛП(Строка(Пункт.Получить("result")))) = "remark" Тогда
			ТекстПункта = СокрЛП(Строка(Пункт.Получить("text")));
			Если НЕ ПустаяСтрока(ТекстПункта)
				И Замечания.Найти(ТекстПункта) = Неопределено Тогда
				Замечания.Добавить(ТекстПункта);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Замечания;

КонецФункции

// Замечания ЕГР в замечания возврата (agentrunner-213, запуск e6df4518):
// расхождение КПП/ОГРН или прекращение деятельности дают вердикт return, но не
// попадали в замечания - возврат отказывал remarks_required. Недоступность ЕГР
// (not_performed) замечанием возврата не считается.
//
// Параметры:
//  Замечания   - Массив из Строка - замечания возврата (дополняются без дублей).
//  Официальные - Структура, Неопределено - {result, remarks, kpp, ogrn, terminated,
//                termination_date}.
//
Процедура ДобавитьЗамечанияЕГРВозврата(Знач Замечания, Знач Официальные)

	Если Официальные = Неопределено
		ИЛИ НЕ (Официальные.result = "mismatch" ИЛИ Официальные.terminated) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЗамечаниеЕГР Из Официальные.remarks Цикл
		ТекстЕГР = СокрЛП(Строка(ЗамечаниеЕГР));
		Если НЕ ПустаяСтрока(ТекстЕГР) И Замечания.Найти(ТекстЕГР) = Неопределено Тогда
			Замечания.Добавить(ТекстЕГР);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Комментарий визы возврата: «Возвращено на исправление:» и нумерованные
// замечания, не больше 500 символов; усечение отмечается флагом (выходной
// параметр Усечен).
//
// Параметры:
//  Замечания - Массив из Строка.
//  Усечен    - Булево - признак усечения (выходной).
//
// Возвращаемое значение:
//  Строка - до 500 символов.
//
Функция КомментарийВизыВозврата(Знач Замечания, Усечен)

	Усечен = Ложь;
	Итог = НСтр("ru = 'Возвращено на исправление:'");
	НомерЗамечания = 0;

	Для Каждого Замечание Из Замечания Цикл
		НомерЗамечания = НомерЗамечания + 1;
		Кандидат = Итог + " " + Формат(НомерЗамечания, "ЧГ=0") + ". " + Замечание;
		Если СтрДлина(Кандидат) <= 500 Тогда
			Итог = Кандидат;
		Иначе
			Усечен = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Усечен Тогда
		Итог = Лев(Итог, 497) + "...";
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Проверки reject (п. 5 спеки): основание - комментарий агента (обязателен);
// повторная сверка - для протокола решения.
//
// Возвращаемое значение:
//  Булево - Истина, если отклонение делать нельзя.
//
Функция ОтказОтклоненияЗаявки(Знач РезультатПроверок, Знач Контекст)

	// Сверка считается для протокола решения (заполняет РезультатПроверок).
	ПовторнаяСверкаДляРешения(РезультатПроверок, Контекст);

	Если ОтказПоХешуМодели(РезультатПроверок.КонтекстСверки.ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	РезультатПроверок.КомментарийВизы = СтрШаблон(
		НСтр("ru = 'Отклонено без возможности исправления: %1'"),
		РезультатПроверок.Комментарий);
	Если СтрДлина(РезультатПроверок.КомментарийВизы) > 500 Тогда
		РезультатПроверок.КомментарийВизы = Лев(РезультатПроверок.КомментарийВизы, 497) + "...";
		РезультатПроверок.УсеченКомментарийВизы = Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Отказ по model_hash (п. 17.3 спеки): текущий хеш модели заявки «стало» и ПОО
// не совпал с хешем из аргументов агента. Заполняет request_changed (или
// request_not_found, если заявка не читается) и возвращает Истина.
//
// Параметры:
//  ДанныеЗаявки      - Структура - результат ДанныеЗаявки; читается вызывающим -
//                      в повторной проверке под блокировкой заново (п. 19а.3).
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужен ХешАгента).
//
// Возвращаемое значение:
//  Булево - Истина, если заявка изменилась после чтения агентом.
//
Функция ОтказПоХешуМодели(Знач ДанныеЗаявки, Знач РезультатПроверок)

	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		РезультатПроверок.КодОшибки = "request_not_found";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
		Возврат Истина;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	ТекущийХеш = ХешМоделейЗаявки(МодельСтало, ДанныеЗаявки.Подчиненные);
	Если ТекущийХеш = РезультатПроверок.ХешАгента Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатПроверок.КодОшибки = "request_changed";
	РезультатПроверок.Сообщение = НСтр("ru = 'Заявка изменена после чтения (model_hash не совпал)
		|- перечитайте заявку инструментом nsi_get_request.'");
	Возврат Истина;

КонецФункции

// Определен ли сценарий заявки (вид и резидентность субъекта распознаны -
// СценарийЗаявки). Агент согласует заявки любого определенного сценария
// (agentrunner-213: настройка разрешенных сценариев снята); с неопределенным
// сценарием проверки реквизитов неприменимы - заявка передается сотруднику.
Функция СценарийОпределен(Знач Сценарий)

	Возврат НЕ ПустаяСтрока(Сценарий) И Сценарий <> СценарийНеОпределен();

КонецФункции

// Значение сценария, когда вид или резидентность субъекта не распознаны.
Функция СценарийНеОпределен()

	Возврат "не определён";

КонецФункции

// Комментарий решения: строка, усеченная до 500 символов (п. 19 спеки); признак
// усечения возвращается в comment_truncated.
Функция КомментарийИзАргументов(Знач Аргументы, Усечен)

	Комментарий = ЗначениеИзКоллекции(Аргументы, "comment", "");
	Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда
		Комментарий = Строка(Комментарий);
	КонецЕсли;

	Усечен = СтрДлина(Комментарий) > 500;
	Возврат Лев(Комментарий, 500);

КонецФункции

// Запись решения штатным механизмом визирования «БИТ» (п. 19, 19а спеки):
// транзакция с исключительной управляемой блокировкой виз заявки и самой заявки,
// повтор проверок визы и model_hash под блокировкой, затем - для
// approve/return/reject НовыеПараметрыПринятияРешения + УстановитьРешениеПоВизе,
// для handover - комментарий визы привилегированно (п. 3 спеки agentrunner-35);
// без привилегированного режима - права пользователя сеанса запуска. Отказ
// повторной проверки - код отказа п. 17 в Проверки; отказ механизма и исключения
// (включая испорченную вложенным откатом транзакцию при фиксации) -
// decision_failed/handover_failed у вызывающего, текст в ТекстОшибки.
//
// Параметры:
//  Проверки     - Структура - результат ПроверкиПередРешением (при отказе
//                 повторной проверки заполняются КодОшибки/Сообщение).
//  ТекстОшибки  - Строка    - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если решение записано и транзакция зафиксирована.
//
Функция ЗаписатьРешениеМеханизмомВизирования(Знач Проверки, ТекстОшибки)

	ТекстОшибки = "";

	// Очистка очереди сообщений: после вызова читаем только сообщения механизма.
	ПолучитьСообщенияПользователю(Истина);

	Исход = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДанныеРешения(Проверки.СсылкаЗаявки);

		Если ПовторнаяПроверкаОтказала(Проверки) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		// 2.5.7: предмет заявки до решения этапа 1 - элемент, созданный в прошлом
		// цикле виз (до restart), не выдается за созданный этим решением.
		Если Проверки.КодРешения = "approve" И Проверки.Этап = 1 Тогда
			Проверки.ПредметДоРешения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Проверки.СсылкаЗаявки, "Предмет");
		КонецЕсли;

		// agentrunner-88: approve этапа 2 со счётом - счёт создаётся в той же
		// транзакции (перепроверка под блокировкой), ошибка - решение не записано.
		Если Проверки.КодРешения = "approve" И Проверки.Этап = 2
			И Проверки.СчетЗаявки <> Неопределено И Проверки.СчетЗаявки.in_request Тогда
			Если НЕ СоздатьСчетЭтапаДва(Проверки, ТекстОшибки) Тогда
				Если ПустаяСтрока(Проверки.КодОшибки) Тогда
					Проверки.КодОшибки = "bank_account_failed";
				КонецЕсли;
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;

		// handover вместо решения пишет комментарий визы (в той же транзакции,
		// под той же блокировкой 19а); restart - перепроведение заявки (визы
		// сбрасываются и назначаются заново); approve/return/reject - штатный механизм.
		Если Проверки.КодРешения = "handover" Тогда
			Исход = ЗаписатьКомментарийВизыПривилегированно(Проверки, ТекстОшибки);
		ИначеЕсли Проверки.КодРешения = "restart" Тогда
			Исход = СброситьВизыЗаявки(Проверки.СсылкаЗаявки, ТекстОшибки);
		Иначе
			Исход = УстановитьРешениеМеханизмом(Проверки, ТекстОшибки);
		КонецЕсли;
		Если НЕ Исход Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		// Транзакция могла быть испорчена вложенным откатом (например,
		// ИсполнитьЗаявку отменил свою транзакцию) - закрываем, только если активна.
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
		ТекстПричины = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстОшибки = ?(ПустаяСтрока(ТекстОшибки), ТекстПричины,
			ТекстОшибки + " " + ТекстПричины);
	КонецПопытки;

	Возврат Исход;

КонецФункции

// Исключительные управляемые блокировки записи решения (п. 19а.2 спеки):
// визы заявки в РегистрСведений.бит_УстановленныеВизы (по полю Объект) и сама
// заявка в Документ.бит_мдм_ЗаявкаНаИзменение (по Ссылка). Вызывается внутри
// транзакции и до чтения данных: разделяемую блокировку чтения поднять до
// исключительной нельзя.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка решения.
//
Процедура ЗаблокироватьДанныеРешения(Знач СсылкаЗаявки)

	Блокировка = Новый БлокировкаДанных;

	ЭлементВизы = Блокировка.Добавить("РегистрСведений.бит_УстановленныеВизы");
	ЭлементВизы.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементВизы.УстановитьЗначение("Объект", СсылкаЗаявки);

	ЭлементЗаявки = Блокировка.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
	ЭлементЗаявки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементЗаявки.УстановитьЗначение("Ссылка", СсылкаЗаявки);

	Блокировка.Заблокировать();

КонецПроцедуры

// Сброс виз заявки и повторный цикл визирования (решение restart,
// agentrunner-213): перепроведение заявки, как при «Отправить на проверку»
// (ПерепровестиЗаявку) - отмена проведения очищает визы механизмом «БИТ»,
// проведение назначает их заново; заявка снова попадает к агенту на этап 1.
// Модель заявки не меняется. Вызывается внутри транзакции решения.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ТекстОшибки  - Строка - текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если заявка перепроведена.
//
Функция СброситьВизыЗаявки(Знач СсылкаЗаявки, ТекстОшибки)

	Итог = Новый Структура("Успех, Сообщение", Ложь, "");
	ПерепровестиЗаявку(Новый Структура, СсылкаЗаявки, Итог);
	Если НЕ Итог.Успех Тогда
		ТекстОшибки = ?(ПустаяСтрока(Итог.Сообщение),
			НСтр("ru = 'Заявка не перепроведена - визы не сброшены.'"), Итог.Сообщение);
	КонецЕсли;

	Возврат Итог.Успех;

КонецФункции

// Создание банковского счёта контрагента при approve этапа 2 (п. 5 спеки,
// план 6) - в транзакции решения, под исключительной блокировкой: счёт этого
// контрагента - используется (повторное одобрение не задваивает), такой же счёт
// у другого контрагента не мешает (agentrunner-213), создание -
// как СоздатьБанковскиеСчета обработки-образца (СоздатьЭлемент + Заполнить:
// валюта и наименование заполняются ОбработкойЗаполнения - рубль),
// ОсновнойБанковскийСчет контрагента - если пуст.
//
// Параметры:
//  Проверки    - Структура - результат ПроверкиПередРешением (СчетЗаявки,
//                КонтрагентСсылка; при отказе заполняется КодОшибки).
//  ТекстОшибки - Строка    - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если счёт есть у контрагента (создан или существовал).
//
Функция СоздатьСчетЭтапаДва(Знач Проверки, ТекстОшибки)

	ТекстОшибки = "";
	СчетЗаявки = Проверки.СчетЗаявки;
	Контрагент = Проверки.КонтрагентСсылка;

	// Счёт с этим номером у этого контрагента уже есть - используется (повторное
	// одобрение не задваивает). Такой же счёт у другого контрагента не мешает
	// (agentrunner-213, решение человека).
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерСчета", СчетЗаявки.number);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Контрагент
		|	И Счета.НомерСчета = &НомерСчета
		|	И НЕ Счета.ПометкаУдаления";
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	// Банк перепроверяется под блокировкой (мог измениться).
	Банк = Неопределено;
	Найден = Ложь;
	Действует = Ложь;
	Банк = БанкПоБик(СчетЗаявки.bik, Найден, Действует);
	// Причина отказа - конкретная (agentrunner-278): общий текст «банк не найден,
	// не действует или ключ неверен» не говорил, что именно исправлять.
	Если НЕ Найден Тогда
		Проверки.КодОшибки = "bank_account_failed";
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 не найден в справочнике банков - счёт не создан.'"),
			СчетЗаявки.bik);
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Действует Тогда
		Проверки.КодОшибки = "bank_account_failed";
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 не действует - счёт не создан.'"), СчетЗаявки.bik);
		Возврат Ложь;
	КонецЕсли;
	Если НЕ КлючСчетаКорректен(СчетЗаявки.number, СчетЗаявки.bik) Тогда
		Проверки.КодОшибки = "bank_account_failed";
		ТекстОшибки = ТекстНеверногоКлючаСчета(СчетЗаявки.number, СчетЗаявки.bik)
			+ " " + НСтр("ru = 'Счёт не создан.'");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("НомерСчета", СчетЗаявки.number);
		ДанныеЗаполнения.Вставить("Банк", Банк);
		ДанныеЗаполнения.Вставить("Владелец", Контрагент);

		СчетОбъект = Справочники.БанковскиеСчета.СоздатьЭлемент();
		СчетОбъект.Заполнить(ДанныеЗаполнения);
		СчетОбъект.Записать();
		Проверки.СозданныйСчет = СчетОбъект.Ссылка;
	Исключение
		Проверки.КодОшибки = "bank_account_failed";
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	// Основной счёт контрагента - если пуст (план 6). Контрагент пишется сам, а не
	// через Справочники.БанковскиеСчета.УстановитьОсновнойБанковскийСчет: запись
	// без проверок (ЗаписьБезПроверок) - иначе ПередЗаписью контрагента отказывает
	// пользователю без права редактирования НСИ (agentrunner-213, 2.4.1).
	// Контрагент открыт другим пользователем - основной счёт не ставится (как в
	// типовой процедуре), решение по визе не срывается.
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контрагент);
		Блокировка.Заблокировать();

		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентЗаблокирован = Истина;
		Попытка
			КонтрагентОбъект.Заблокировать();
		Исключение
			КонтрагентЗаблокирован = Ложь;
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось заблокировать объект.'",
				ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Предупреждение,
				, КонтрагентОбъект, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если КонтрагентЗаблокирован
			И НЕ ЗначениеЗаполнено(КонтрагентОбъект.ОсновнойБанковскийСчет) Тогда
			КонтрагентОбъект.ОсновнойБанковскийСчет = СчетОбъект.Ссылка;
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			КонтрагентОбъект.ДополнительныеСвойства.Вставить("ЗаписьБезПроверок", Истина); 
			КонтрагентОбъект.ДополнительныеСвойства.Вставить("ТолькоЗапись", Истина); 			
			КонтрагентОбъект.Записать();
		КонецЕсли;
	Исключение
		Проверки.КодОшибки = "bank_account_failed";
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Повтор проверок под блокировкой (п. 19а.3 спеки): виза есть, активна и без
// решения; для approve, handover и restart - model_hash по текущим данным заявки
// (для handover - п. 3 спеки agentrunner-35). При отказе заполняет
// Проверки.КодОшибки/Сообщение кодом отказа п. 17 и возвращает Истина.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки, ИДВизы,
//             КодРешения, ХешАгента; заполняются КодОшибки/Сообщение).
//
// Возвращаемое значение:
//  Булево - Истина, если под блокировкой решение ставить нельзя.
//
Функция ПовторнаяПроверкаОтказала(Знач Проверки)

	Если ОтказПоЗаписиВизы(Проверки) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Проверки.КодРешения <> "approve" И Проверки.КодРешения <> "handover"
		И Проверки.КодРешения <> "restart" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Читаем заявку заново: под блокировкой это текущие данные.
	ДанныеЗаявки = ДанныеЗаявки(Проверки.СсылкаЗаявки);
	Возврат ОтказПоХешуМодели(ДанныеЗаявки, Проверки);

КонецФункции

// Заполнение параметров решения (п. 19 спеки) и вызов механизма «БИТ».
// Транзакцию не ведет - ею управляет ЗаписатьРешениеМеханизмомВизирования.
// При approve со счетом, не подтвержденным документами (СчетНеПодтвержденДокументами
// сверки, agentrunner-121), или с файлами других организаций к комментарию визы
// дописывается отметка сверки (ОтметкаСверкиДляВизы, 2.4.4).
// Сообщения механизма и текст исключения - в ТекстОшибки.
//
// Параметры:
//  Проверки     - Структура - результат ПроверкиПередРешением.
//  ТекстОшибки  - Строка    - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если механизм вернул успех.
//
Функция УстановитьРешениеМеханизмом(Знач Проверки, ТекстОшибки)

	ПараметрыРешения = Обработки.бит_КонсольОперативногоВизирования.НовыеПараметрыПринятияРешения();
	ПараметрыРешения.ОбъектВизирования     = Проверки.СсылкаЗаявки;
	ПараметрыРешения.ИДВизы                = Проверки.ИДВизы;
	ПараметрыРешения.Решение               = СсылкаРешенияПоКоду(Проверки.КодРешения);
	// agentrunner-88: для return/reject комментарий визы собирает пакет
	// («Возвращено на исправление: ...» / «Отклонено без возможности
	// исправления: ...»); для approve - комментарий агента, а при счете, не
	// подтвержденном документами, - он же с отметкой (agentrunner-121).
	// 2.4.4: отметка - по фактической причине (нет файлов, файлы других
	// организаций, счёта нет в файлах контрагента) - ОтметкаСверкиДляВизы.
	КомментарийВизы = Проверки.КомментарийВизы;
	Если Проверки.КодРешения = "approve" Тогда
		Отметка = ОтметкаСверкиДляВизы(Проверки);
		Если НЕ ПустаяСтрока(Отметка) Тогда
			КомментарийВизы = КомментарийВизыСОтметкойСчета(Проверки.Комментарий, Отметка);
		КонецЕсли;
	КонецЕсли;
	ПараметрыРешения.Комментарий           = ?(ПустаяСтрока(КомментарийВизы),
		Проверки.Комментарий, КомментарийВизы);
	ПараметрыРешения.ДатаУстановкиРешения  = ТекущаяДатаСеанса();
	ПараметрыРешения.ТекущийПользователь   = Проверки.ПользовательАгента;
	// ПроводитьПослеУтверждения остается как заполнила НовыеПараметрыПринятияРешения
	// (функциональная опция бит_ПроводитьДокументыПослеУтверждения, п. 19 спеки).

	Исход = Ложь;
	Попытка
		Исход = sd_Оптимизация_ФоновоеВизированиеСервер.УстановитьРешениеПоВизе(ПараметрыРешения);
	Исключение
		Исход = Ложь;
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстСообщенийМеханизма = СообщенияМеханизмаСтрокой();
	СообщенияПоследнегоРешения = ТекстСообщенийМеханизма;
	Если ПустаяСтрока(ТекстСообщенийМеханизма) Тогда
		Если НЕ Исход И ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = НСтр("ru = 'Механизм визирования не принял решение.'");
		КонецЕсли;
	Иначе
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", " ") + ТекстСообщенийМеханизма;
	КонецЕсли;

	Возврат Исход;

КонецФункции

// Счет заявки не подтвержден документами в сверке решения (agentrunner-121):
// страховка не нашла счет ни в одном относящемся файле при верном ключе.
// У Проверки актуализации (ПроверкиРешенияВизы) ключа «Сверка» нет - там
// сверка файлов не выполняется и отметка не нужна.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (Сверка может
//             отсутствовать).
//
// Возвращаемое значение:
//  Булево - Истина, если сверка решения пометила счет как не подтвержденный.
//
Функция СчетНеПодтвержденДокументами(Знач Проверки)

	Сверка = Неопределено;
	// Свойство - выходной параметр: ключа может не быть у сверки тестовой
	// заглушки; отсутствие читается как «признак не установлен».
	Проверки.Свойство("Сверка", Сверка);
	Если Сверка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Сверка, "СчетНеПодтвержденДокументами", Ложь);

КонецФункции

// Отметка сверки для комментария визы approve (2.4.4): почему счёт не
// подтверждён документами и какие файлы не учитывались.
//  - счёт не подтверждён: есть файл контрагента - «В файлах контрагента нет
//    расчётного счёта заявки.»; файлы есть, но ни один не контрагента -
//    «Среди приложенных файлов нет документа контрагента ...»; файлов нет -
//    «Нет файлов для проверки расчётного счёта.» (как до 2.4.4);
//  - по каждому файлу другой организации - «Файл «X» относится к другой
//    организации (ИНН …) ... - не учитывался.»
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (Сверка может
//             отсутствовать).
//
// Возвращаемое значение:
//  Строка - пустая, если отмечать нечего.
//
Функция ОтметкаСверкиДляВизы(Знач Проверки) Экспорт

	Сверка = Неопределено;
	Проверки.Свойство("Сверка", Сверка);
	Если Сверка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Состав = СоставФайловСверки(Сверка);

	Части = Новый Массив;
	Если СчетНеПодтвержденДокументами(Проверки) Тогда
		Если Состав.ЕстьФайлКонтрагента Тогда
			Части.Добавить(НСтр("ru = 'В файлах контрагента нет расчётного счёта заявки.'"));
		ИначеЕсли Сверка.СтатусыФайлов.Количество() > 0 Тогда
			Части.Добавить(НСтр("ru = 'Среди приложенных файлов нет документа контрагента для проверки
				|расчётного счёта.'"));
		Иначе
			Части.Добавить(НСтр("ru = 'Нет файлов для проверки расчётного счёта.'"));
		КонецЕсли;
	КонецЕсли;

	Для Каждого СтатусФайла Из Состав.ЧужиеФайлы Цикл
		ТекстЧасти = ТекстФайлаДругойОрганизации(Проверки.КонтекстСверки, СтатусФайла)
			+ " " + НСтр("ru = 'Не учитывался.'");
		Части.Добавить(ТекстЧасти);
	КонецЦикла;

	// 2.5.17: слишком большие, нечитаемые файлы и файлы без данных контрагента.
	НеУчтенныеФайлы = Неопределено;
	Если Сверка.Свойство("НеУчтенныеФайлы", НеУчтенныеФайлы) Тогда
		Для Каждого ТекстЧасти Из НеУчтенныеФайлы Цикл
			Части.Добавить(ТекстЧасти);
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Комментарий визы approve с отметкой сверки (agentrunner-121, с 2.4.4 - текст
// отметки из ОтметкаСверкиДляВизы): комментарий агента + отметка; без
// комментария агента - только отметка. Итог не длиннее 500 символов, как у
// других комментариев визы.
//
// Параметры:
//  КомментарийАгента - Строка - комментарий решения (уже усечен до 500).
//  Отметка           - Строка - отметка сверки.
//
// Возвращаемое значение:
//  Строка - до 500 символов.
//
Функция КомментарийВизыСОтметкойСчета(Знач КомментарийАгента, Знач Отметка)

	Итог = СокрЛП(КомментарийАгента);
	Если НЕ ПустаяСтрока(Итог) Тогда
		Итог = Итог + " ";
	КонецЕсли;
	Возврат Лев(Итог + Отметка, 500);

КонецФункции

// Запись комментария визы для handover (п. 3 спеки agentrunner-35) - вместо
// решения: в записи бит_УстановленныеВизы этой визы меняется только ресурс
// Комментарий («Проверено агентом НСИ ...»), решение, пользователь и дата
// установки не трогаются. Набор читается и пишется привилегированно (решение
// человека 2026-10-06: право записи визы пользователю агента не выдается),
// подъем - только на чтение-запись набора этой визы, сброс и в Исключение.
// Выполняется в транзакции решения (ЗаписатьРешениеМеханизмомВизирования),
// под исключительной блокировкой 19а; ошибка записи откатывает транзакцию,
// отметка ядра не пишется (handover_failed у вызывающего).
//
// Параметры:
//  Проверки    - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//                ИДВизы, Комментарий, Сценарий).
//  ТекстОшибки - Строка - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если комментарий записан.
//
Функция ЗаписатьКомментарийВизыПривилегированно(Знач Проверки, ТекстОшибки)

	Исход = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Отбор = Новый Структура;
		Отбор.Вставить("Объект", Проверки.СсылкаЗаявки);
		Отбор.Вставить("ИД", Проверки.ИДВизы);
		НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

		Если НаборВизы.Количество() > 0 Тогда
			НаборВизы[0].Комментарий = Лев(ТекстКомментарияПередачи(Проверки), 500);
			НаборВизы.Записать(Истина);
			Исход = Истина;
		Иначе
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Виза с ИД %1 у заявки не найдена.'"), Проверки.ИДВизы);
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);
	Возврат Исход;

КонецФункции

// Текст комментария визы для сотрудника НСИ (п. 3 спеки agentrunner-35,
// agentrunner-88 п. 5): «Передано сотруднику НСИ: сценарий заявки не определён.
// <comment агента>» при неопределенном сценарии, иначе «Передано сотруднику
// НСИ: <comment агента>». Запись
// усекается вызывающим до 500 (как п. 19).
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (Комментарий,
//             Сценарий).
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстКомментарияПередачи(Знач Проверки)

	Если Проверки.Сценарий = СценарийНеОпределен() Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Передано сотруднику НСИ: сценарий заявки не определён. %1'"),
			Проверки.Комментарий);
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Передано сотруднику НСИ: %1'"),
		Проверки.Комментарий);

КонецФункции

// Предопределенное решение согласования по коду инструмента (п. 19 спеки;
// agentrunner-88, Р14): approve -> Согласовано, return и reject -> Отклонено
// (возврат инициатору - «Отклонено» с пометкой возврата в комментарии визы;
// «На доработку» продвигает процесс дальше - проверено на стенде).
Функция СсылкаРешенияПоКоду(Знач КодРешения)
	Если КодРешения = "approve" Тогда
		Возврат Справочники.бит_ВидыРешенийСогласования.Согласовано;
	Иначе
		Возврат Справочники.бит_ВидыРешенийСогласования.Отклонено;
	КонецЕсли;

КонецФункции

// Накопленные сообщения пользователю одной строкой (механизм визирования
// сообщает через СообщитьПользователю - спека п. 19 требует их в message).
Функция СообщенияМеханизмаСтрокой()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Строки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Сообщение.Текст)) Тогда
			Строки.Добавить(СокрЛП(Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, " ");

КонецФункции

// Продолжение той же заявки этапом 2 в этом запуске (agentrunner-213, заявка
// 00-00086917: один запуск - одна заявка целиком). После approve визы 1
// механизм БИТ сразу активирует визу 2; если она назначена агенту, без
// решения, и контрагент заявки существует - ответ не терминальный, next =
// nsi_get_request (этап 2 этой же заявки). Иначе ответ прежний (next = finish):
// заявка вернется в очередь, когда виза 2 станет доступна.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (КодРешения, Виза, СсылкаЗаявки).
//  Контекст - Структура - контекст запуска.
//  Ответ    - Структура - ответ после решения (ОтветПослеРешения), дополняется.
//
Процедура ДобавитьПродолжениеЭтапомДва(Знач Проверки, Знач Контекст, Ответ)

	Если Проверки.КодРешения <> "approve" Или ЭтапВизыПоСсылке(Проверки.Виза) <> 1 Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ВизаЭтапаДваОжидаетАгента(Контекст, Проверки.СсылкаЗаявки) Тогда
		Возврат;
	КонецЕсли;
	Шапка = ДанныеЗаявки(Проверки.СсылкаЗаявки).Шапка;
	Если Шапка = Неопределено Или НЕ ЗначениеЗаполнено(Шапка.Предмет)
		Или НЕ ОбщегоНазначения.СсылкаСуществует(Шапка.Предмет) Тогда
		Возврат; // Контрагент еще не создан - этап 2 возьмет следующий запуск.
	КонецЕсли;

	Ответ.Удалить("terminal");
	Ответ.Удалить("terminal_reason");
	Ответ.Вставить("stage2_ready", Истина);
	Ответ.Вставить("next", "nsi_get_request");
	Ответ.Вставить("message",
		НСтр("ru = 'Виза первого этапа согласована, виза второго этапа этой же заявки уже у тебя.
			|Продолжи этап 2 в этом запуске: nsi_get_request по этой заявке (stage = 2), затем
			|решение по полю next ответа (approve, return, restart или handover). Отчёт - после
			|решения этапа 2.'"));

КонецПроцедуры

// Виза этапа 2 заявки активна, без решения и назначена пользователю агента.
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВизаЭтапаДваОжидаетАгента(Знач Контекст, Знач СсылкаЗаявки)

	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат Ложь;
	КонецЕсли;

	СписокВизАгента = бит_ВизированиеСервер.ВизыПользователя(ПользовательАгента, СсылкаЗаявки);
	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Для Каждого ЗаписьВизы Из НаборВизы Цикл
		Если ЗаписьВизы.АктивнаяВиза И НЕ ЗначениеЗаполнено(ЗаписьВизы.Решение)
			И ЭтапВизыПоСсылке(ЗаписьВизы.Виза) = 2
			И СписокВизАгента.НайтиПоЗначению(ЗаписьВизы.Виза) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Ответ после успешной записи (п. 20 спеки): перечитываются запись визы
// (решение) и статус заявки.
//
// Возвращаемое значение:
//  Структура - {done, decision, visa_id, request_status, comment_truncated
//  [, result_ref - ссылка на созданный объект, см. СсылкаСозданногоОбъекта]}.
//
Функция ОтветПослеРешения(Знач Проверки)

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", Проверки.СсылкаЗаявки);
	Отбор.Вставить("ИД", Проверки.ИДВизы);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	СтатусЗаявки = Неопределено;
	Если НаборВизы.Количество() > 0 Тогда
		Для Каждого ЗаписьВизы Из НаборВизы Цикл
			Если ЗначениеЗаполнено(ЗаписьВизы.Статус) Тогда
				СтатусЗаявки = Строка(ЗаписьВизы.Статус);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("done", Истина);
	Ответ.Вставить("decision", Проверки.КодРешения);
	Ответ.Вставить("visa_id", Проверки.ИДВизы);
	Ответ.Вставить("request_status", СтатусЗаявки);
	Ответ.Вставить("comment_truncated", Проверки.УсеченКомментарий);
	// 2.5.7: объект, созданный решением, - ядро пишет его в журнал действий
	// (ar_СсылкаНаРезультат), форма просмотра запуска показывает в «Созданные объекты 1С».
	СсылкаРезультата = СсылкаСозданногоОбъекта(Проверки);
	Если НЕ ПустаяСтрока(СсылкаРезультата) Тогда
		Ответ.Вставить("result_ref", СсылкаРезультата);
	КонецЕсли;
	// 2.5.9: после approve визы этапа 2 исполнение механизмом БИТ могло не пройти
	// (справочник не изменен, статус не «Исполнена»): агент сообщает об этом в отчёте.
	Исполнение = Неопределено;
	Если Проверки.КодРешения = "approve" И Проверки.Свойство("Этап") И Проверки.Этап = 2 Тогда
		Исполнение = ИсполнениеЗаявкиПослеРешения(Проверки.СсылкаЗаявки, "");
		Ответ.Вставить("executed", НЕ Исполнение.Сбой);
		Если Исполнение.Сбой Тогда
			Ответ.Вставить("request_status", Исполнение.Статус);
			Ответ.Вставить("execution_error", Исполнение.Ошибка);
		КонецЕсли;
	КонецЕсли;
	// agentrunner-66 (спека А.5): решение поставлено - модель завершает работу
	// (агент отвечает за одну заявку за запуск).
	Ответ.Вставить("next", "finish");
	// agentrunner-108: терминальный исход (контракт agentrunner-107) - решение
	// поставлено, незакрытые шаги плана закрываются ядром как skipped.
	Ответ.Вставить("terminal", Истина);
	Ответ.Вставить("terminal_reason", "decision_set");
	Если Исполнение <> Неопределено И Исполнение.Сбой Тогда
		Ответ.Вставить("message",
			НСтр("ru = 'Решение поставлено, но заявка не исполнена (execution_error). Заверши работу: в итоговом
				|отчёте сообщи, что заявку нужно выполнить вручную.'"));
	Иначе
		Ответ.Вставить("message",
			НСтр("ru = 'Решение поставлено. Заверши работу: дай итоговый отчёт без вызова
				|инструментов.'"));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Навигационная ссылка объекта, созданного решением approve (2.5.7): этап 1
// заявки на ввод нового - элемент справочника, созданный механизмом «БИТ» при
// исполнении заявки (Предмет, которого не было до решения - элемент прошлого
// цикла виз до restart не возвращается); этап 2 - банковский счет, созданный
// СоздатьСчетЭтапаДва (существовавший счет не считается созданным). Изменение
// существующего элемента объект не создает.
//
// Решение к этому моменту уже записано: сбой чтения не отменяет ответ - ссылка
// не возвращается, сбой пишется в служебный лог.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (КодРешения, Этап,
//             СсылкаЗаявки, СозданныйСчет, ПредметДоРешения).
//
// Возвращаемое значение:
//  Строка - навигационная ссылка или пустая строка.
//
Функция СсылкаСозданногоОбъекта(Знач Проверки)

	Если Проверки.КодРешения <> "approve" Тогда
		Возврат "";
	КонецЕсли;

	Если Проверки.Этап = 2 Тогда
		Если ЗначениеЗаполнено(Проверки.СозданныйСчет) Тогда
			Возврат ar_Утилиты.НавигационнаяСсылкаОбъекта(Проверки.СозданныйСчет);
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если Проверки.Этап <> 1 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Проверки.СсылкаЗаявки,
			"ВидОперации, Предмет");
		Элемент = РеквизитыЗаявки.Предмет;
		ВводНового = (РеквизитыЗаявки.ВидОперации
			= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);
		ПоявилсяПриРешении = ЗначениеЗаполнено(Элемент) И Элемент <> Проверки.ПредметДоРешения;
		Если ВводНового И ПоявилсяПриРешении И ОбщегоНазначения.СсылкаСуществует(Элемент) Тогда
			Возврат ar_Утилиты.НавигационнаяСсылкаОбъекта(Элемент);
		КонецЕсли;
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстЛога = СтрШаблон("%1: %2", Строка(Проверки.СсылкаЗаявки), ТекстОшибки);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "result_ref_failed", ТекстЛога,
			"Ошибка", "", Проверки.СсылкаЗаявки);
	КонецПопытки;

	Возврат "";

КонецФункции

// Ответ после сброса виз (restart, agentrunner-213): визы заявки назначены
// заново - прежней визы агента больше нет, статус - текущий статус заявки.
// Терминальный исход: этапы 1 и 2 заявка проходит в следующем запуске.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//             ИДВизы, Комментарий - причины повторного цикла).
//
// Возвращаемое значение:
//  Строка - JSON {done, decision, visa_id, request_status, reason, next,
//  terminal, terminal_reason, message}.
//
Функция ОтветПослеПовторногоЦикла(Знач Проверки)

	Ответ = Новый Структура;
	Ответ.Вставить("done", Истина);
	Ответ.Вставить("decision", "restart");
	Ответ.Вставить("visa_id", Проверки.ИДВизы);
	Ответ.Вставить("request_status",
		ЗначениеВСтрокуДляОтвета(бит_ВизированиеСервер.ТекущийСтатус(Проверки.СсылкаЗаявки)));
	Ответ.Вставить("reason", Проверки.Комментарий);
	Ответ.Вставить("next", "finish");
	Ответ.Вставить("terminal", Истина);
	Ответ.Вставить("terminal_reason", "decision_set");
	Ответ.Вставить("message",
		НСтр("ru = 'Визы заявки сброшены: заявка заново пройдёт этапы 1 и 2 в следующем
			|запуске. Заверши работу: дай итоговый отчёт без вызова инструментов.'"));
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Ответ и финализация handover (п. 3 спеки agentrunner-35): комментарий визы
// уже записан (транзакция зафиксирована), отметка отложения пишется ВНЕ
// транзакции «БИТ» - ее сбой не отменяет передачу: комментарий уже виден
// сотруднику НСИ, а заявка без отметки просто вернется в очередь (безвредно).
// Сбой отметки - лог deferral_not_saved и warning в ответе.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//             ИДВизы, Комментарий, ХешАгента, УсеченКомментарий).
//  Контекст - Структура - контекст запуска (нужны Агент, RunId).
//
// Возвращаемое значение:
//  Строка - JSON {"done","decision","visa_id","request_status","deferred",
//  "comment_truncated"[, "warning"]}.
//
Функция ОтветПослеПередачи(Знач Проверки, Знач Контекст)

	Агент = АгентИзКонтекста(Контекст);
	RunId = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("RunId", RunId);
	КонецЕсли;

	Отложено = Ложь;
	Попытка
		Отложено = ar_AuditЗащищённыйРежим.ОтложитьПредметПривилегированно(
			Агент, Проверки.СсылкаЗаявки, Проверки.ИДВизы, Проверки.ХешАгента,
			Проверки.Комментарий, RunId);
	Исключение
		Отложено = Ложь;
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "deferral_not_saved",
			СтрШаблон("%1: виза %2: %3",
				Строка(Проверки.СсылкаЗаявки), Проверки.ИДВизы,
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Предупреждение", RunId, Проверки.СсылкаЗаявки);
	КонецПопытки;

	ЗаписатьЛогРешения(Проверки, "ок", Контекст);

	Ответ = ОтветПослеРешения(Проверки);
	Ответ.Вставить("deferred", Отложено);
	Если НЕ Отложено Тогда
		Ответ.Вставить("warning", "deferral_not_saved");
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Лог каждого вызова (и отказа) nsi_set_visa_decision (п. 20 спеки): заявка,
// виза, решение, исход, код отказа. agentrunner-266: запись с RunId запуска
// (пусто - вызов вне запуска, форма «Инструменты») и ссылкой заявки - решение
// находится по запуску и по заявке; при отказе subject_held_by_other_run -
// RunId запуска, который держит заявку.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением.
//  Исход    - Строка - "ок" или "" (отказ - исход по коду отказа).
//  Контекст - Структура - контекст запуска (RunId).
//
// Возвращаемое значение:
//  Строка - исход решения.
//
Функция ЗаписатьЛогРешения(Знач Проверки, Знач Исход, Знач Контекст)

	СсылкаЗаявки = ?(ЗначениеЗаполнено(Проверки.СсылкаЗаявки),
		Проверки.СсылкаЗаявки, Проверки.ЗаявкаЛога);
	ПредставлениеЗаявки = ?(ЗначениеЗаполнено(СсылкаЗаявки), Строка(СсылкаЗаявки), "-");
	КодОтказа = ?(ПустаяСтрока(Проверки.КодОшибки), "-", Проверки.КодОшибки);
	ИсходРешения = ?(ПустаяСтрока(Исход), КодОтказа, Исход);

	ТекстЛога = СтрШаблон(
		НСтр("ru = '%1: виза %2, решение %3, исход %4 (%5)'"),
		ПредставлениеЗаявки, Проверки.ИДВизы, Проверки.КодРешения, ИсходРешения, КодОтказа);
	Если НЕ ПустаяСтрока(Проверки.RunIdДержателя) Тогда
		ТекстЛога = ТекстЛога + СтрШаблон(НСтр("ru = ', заявку держит запуск %1'"),
			Проверки.RunIdДержателя);
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_decision", ТекстЛога, "Информация",
		RunIdИзКонтекста(Контекст), ?(ЗначениеЗаполнено(СсылкаЗаявки), СсылкаЗаявки, Неопределено));

	Возврат ИсходРешения;

КонецФункции

#КонецОбласти

#Область ВозвратНаИсправление

// Оповещение инициатора о возврате на исправление (agentrunner-89, спека п. 3):
// после успешной записи решения return метод ядра СообщениеПакетаПоПредмету
// открывает (или переиспользует) диалог ожидания по якорю пакета, пишет
// «Возврат на исправление №N» с нумерованными замечаниями и подсказкой,
// ставит срок первого напоминания и отправляет письмо. Вне транзакции решения:
// сбой сообщения решение не откатывает, в ответ решения добавляется
// return_notify_failed.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//             Комментарий).
//  Контекст - Структура - контекст запуска (нужен Агент для нового диалога).
//  Ответ    - Структура - ответ решения (заполняется return_notify_failed).
//
Процедура ОповеститьОВозвратеНаИсправление(Знач Проверки, Знач Контекст, Знач Ответ)

	Заявка = Проверки.СсылкаЗаявки;
	Попытка

		Сейчас = ТекущаяДатаСеанса();
		// Срок первого напоминания (спека п. 9), окончательный срок считается
		// от момента сообщения «Возврат на исправление».
		ОтветитьДо = Сейчас + ЧислоНастройки("НСИИнтервалНапоминанийЧасов", 24) * 3600;
		// Номер возврата - число сообщений возврата в ленте плюс один
		// (спека agentrunner-89 п. 7): первое сообщение - "Возврат на исправление №1".
		Текст = ТекстВозвратаНаИсправление(ЧислоВозвратовЗаявки(Заявка) + 1,
			Проверки.Комментарий,
			Сейчас + ЧислоНастройки("НСИСрокИсправленияЧасов", 120) * 3600);

		ПараметрыСообщения = Новый Структура;
		ПараметрыСообщения.Вставить("Якорь", ЯкорьОжидания(Заявка));
		ПараметрыСообщения.Вставить("Агент", АгентИзКонтекста(Контекст));
		ПараметрыСообщения.Вставить("Предмет", Заявка);
		ПараметрыСообщения.Вставить("Заголовок", ЗаголовокДиалогаОжидания(Заявка));
		ПараметрыСообщения.Вставить("Текст", Текст);
		ПараметрыСообщения.Вставить("ИменаРеквизитовАдресата", ИменаРеквизитовАдресата());
		ПараметрыСообщения.Вставить("ОтветитьДо", ОтветитьДо);
		// 2.5.22: тема - только номер заявки, причины - в тексте письма.
		ПараметрыСообщения.Вставить("ТемаПисьма",
			СтрШаблон(НСтр("ru = 'Заявка № %1 возвращена на исправление'"),
				НомерЗаявкиСтрокой(Заявка)));
		ПараметрыСообщения.Вставить("ВидПисьма", "внимание");

		Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
		Если НЕ Итог.Успех Тогда
			Ответ.Вставить("return_notify_failed", "");
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "return_notify_failed",
				СтрШаблон("%1: %2", Строка(Заявка), Итог.Сообщение), "Ошибка", "", Заявка);
		КонецЕсли;

	Исключение
		Ответ.Вставить("return_notify_failed", "");
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "return_notify_failed",
			СтрШаблон("%1: %2", Строка(Заявка),
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Ошибка", "", Заявка);
	КонецПопытки;

КонецПроцедуры

// Закрытие открытого ожидания исправления при reject (agentrunner-89, спека
// п. 3): «Заявка отклонена без возможности исправления: <основание>». Сбой
// записи - только лог: решение уже записано.
//
Процедура ЗакрытьОжиданиеПриОтказе(Знач Проверки, Знач Контекст, Знач Ответ)

	Заявка = Проверки.СсылкаЗаявки;
	Попытка

		Диалог = ДиалогОжидания(Заявка);
		Если Не ЗначениеЗаполнено(Диалог)
			Или ar_ДиалогиСервер.ШапкаДиалога(Диалог).Состояние
				<> Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
			Возврат;
		КонецЕсли;

		ПараметрыСообщения = Новый Структура;
		ПараметрыСообщения.Вставить("Якорь", ЯкорьОжидания(Заявка));
		ПараметрыСообщения.Вставить("Агент", АгентИзКонтекста(Контекст));
		ПараметрыСообщения.Вставить("Предмет", Заявка);
		ПараметрыСообщения.Вставить("Текст", СтрШаблон(
			НСтр("ru = 'Заявка отклонена без возможности исправления: %1'"),
			Проверки.Комментарий));
		// ОтветитьДо не задаётся - состояние «Завершён».

		Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
		Если НЕ Итог.Успех Тогда
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "reject_close_failed",
				СтрШаблон("%1: %2", Строка(Заявка), Итог.Сообщение), "Предупреждение", "", Заявка);
		КонецЕсли;

	Исключение
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "reject_close_failed",
			СтрШаблон("%1: %2", Строка(Заявка),
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Предупреждение", "", Заявка);
	КонецПопытки;

КонецПроцедуры

// Оповещение инициатора о выполнении заявки (2.5.0): после approve визы этапа 2
// (поставлены обе визы маршрута) метод ядра СообщениеПакетаПоПредмету пишет в
// диалог заявки (якорь ожидания исправления - один диалог на заявку) «Заявка
// выполнена», закрывает ожидание и отправляет инициатору письмо (зелёная
// карточка). Заявка на ввод нового элемента - в тексте и в ссылках письма
// созданный элемент (реквизит Предмет заявки после исполнения), заявка на
// изменение - изменённый элемент. Автоактуализация (nsi_actualize_request)
// оповещение не шлёт: её заявки формирует регламентное задание, а не человек.
// Вне транзакции решения: сбой оповещения решение не откатывает - в ответ
// решения добавляется done_notify_failed, причина - в служебном логе.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (КодРешения, Этап,
//             СсылкаЗаявки).
//  Контекст - Структура - контекст запуска (нужен Агент для нового диалога).
//  Ответ    - Структура - ответ решения (заполняется done_notify_failed).
//
Процедура ОповеститьОВыполненииЗаявки(Знач Проверки, Знач Контекст, Знач Ответ)

	Если Проверки.КодРешения <> "approve" Или Проверки.Этап <> 2 Тогда
		Возврат;
	КонецЕсли;

	Заявка = Проверки.СсылкаЗаявки;
	Попытка

		РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, "ВидОперации, Предмет");
		Элемент = РеквизитыЗаявки.Предмет;
		ЭлементЕсть = ЗначениеЗаполнено(Элемент) И ОбщегоНазначения.СсылкаСуществует(Элемент);
		ВводНового = РеквизитыЗаявки.ВидОперации
			= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового;

		Номер = НомерЗаявкиСтрокой(Заявка);
		СсылкиПисьма = Новый Массив;
		Если ЭлементЕсть И ВводНового Тогда
			Текст = СтрШаблон(НСтр("ru = 'Создан новый элемент справочника: %1. Открыть его можно по ссылке.'"),
				Строка(Элемент));
			СсылкиПисьма.Добавить(Новый Структура("Представление, Ссылка",
				СтрШаблон(НСтр("ru = 'Новый элемент: %1'"), Строка(Элемент)), Элемент));
		ИначеЕсли ЭлементЕсть Тогда
			Текст = СтрШаблон(НСтр("ru = 'Изменения внесены в справочник: %1.'"), Строка(Элемент));
			СсылкиПисьма.Добавить(Новый Структура("Представление, Ссылка",
				СтрШаблон(НСтр("ru = 'Элемент: %1'"), Строка(Элемент)), Элемент));
		Иначе
			Текст = СтрШаблон(НСтр("ru = 'Заявка НСИ %1 выполнена.'"), Номер);
		КонецЕсли;

		ПараметрыСообщения = Новый Структура;
		ПараметрыСообщения.Вставить("Якорь", ЯкорьОжидания(Заявка));
		ПараметрыСообщения.Вставить("Агент", АгентИзКонтекста(Контекст));
		ПараметрыСообщения.Вставить("Предмет", Заявка);
		ПараметрыСообщения.Вставить("Заголовок", СтрШаблон(НСтр("ru = 'Заявка НСИ %1'"), Номер));
		ПараметрыСообщения.Вставить("Текст", Текст);
		ПараметрыСообщения.Вставить("ИменаРеквизитовАдресата", ИменаРеквизитовАдресата());
		// ОтветитьДо не задаётся - состояние «Завершён».
		ПараметрыСообщения.Вставить("ТемаПисьма",
			СтрШаблон(НСтр("ru = 'Заявка НСИ %1: выполнена'"), Номер));
		ПараметрыСообщения.Вставить("ВидПисьма", "успех");
		ПараметрыСообщения.Вставить("СсылкиПисьма", СсылкиПисьма);

		Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
		Если НЕ Итог.Успех Тогда
			Ответ.Вставить("done_notify_failed", "");
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "done_notify_failed",
				СтрШаблон("%1: %2", Строка(Заявка), Итог.Сообщение), "Ошибка", "", Заявка);
		КонецЕсли;

	Исключение
		Ответ.Вставить("done_notify_failed", "");
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "done_notify_failed",
			СтрШаблон("%1: %2", Строка(Заявка),
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Ошибка", "", Заявка);
	КонецПопытки;

КонецПроцедуры

// Текст сообщения «Возврат на исправление №N»: заголовок, нумерованные
// замечания из комментария визы (remarks сверки и review агента) и подсказка
// инициатору с окончательным сроком (agentrunner-89, спека п. 3).
//
Функция ТекстВозвратаНаИсправление(Знач Номер, Знач Комментарий, Знач Срок)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(
		НСтр("ru = 'Возврат на исправление №%1'"), Номер));
	// 2.5.0: причины - отдельным абзацем с подписью (в письме - пунктами списка).
	Строки.Добавить("");
	Строки.Добавить(НСтр("ru = 'Причины возврата:'"));
	Строки.Добавить(НумерованныеЗамечания(Комментарий));
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон(
		НСтр("ru = 'Откройте заявку кнопкой „Открыть“ в диалоге, исправьте реквизиты
			|или приложите документ и нажмите „Отправить на проверку“. Срок: %1.'"),
		Формат(Срок, "ДФ='dd.MM.yyyy HH:mm'")));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Нумерованный перечень строк комментария (замечания возврата): непустые
// строки комментария построчно, «N. текст».
Функция НумерованныеЗамечания(Знач Комментарий)

	Строки = Новый Массив;
	Подстроки = СтрРазделить(Комментарий, Символы.ПС, Ложь);
	Для Каждого Подстрока Из Подстроки Цикл
		Текст = СокрЛП(Подстрока);
		Если ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(СтрШаблон(НСтр("ru = '%1. %2'"), Строки.Количество() + 1, Текст));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Замечания не указаны.'");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Подсказка «какие документы нужны» (план 5.6): строки-замечания из текста
// возврата; строк с номерами нет - пустая строка.
Функция ПодсказкаФайлов(Знач Замечания)

	Строки = Новый Массив;
	Для Каждого Подстрока Из СтрРазделить(Замечания, Символы.ПС, Ложь) Цикл
		Текст = СокрЛП(Подстрока);
		Если СтрДлина(Текст) > 2 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(
			Лев(Текст, 1)) И Сред(Текст, 2, 1) = "." Тогда
			Строки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Якорь диалога ожидания заявки (спека п. 1): pkg:<namespace>:correction:<УИД>.
Функция ЯкорьОжидания(Знач Заявка)

	Возврат "pkg:nsi:correction:" + Строка(Заявка.УникальныйИдентификатор());

КонецФункции

// Диалог ожидания заявки; пустая ссылка, если ожидание не открывалось.
Функция ДиалогОжидания(Знач Заявка)

	Возврат ar_ДиалогиСервер.ДиалогПоЯкорю(ЯкорьОжидания(Заявка));

КонецФункции

// Имена реквизитов-кандидатов адресата ожидания по убыванию приоритета
// (спека п. 1): сд_Инициатор, запасной Ответственный.
Функция ИменаРеквизитовАдресата()

	Имена = Новый Массив;
	Имена.Добавить("сд_Инициатор");
	Имена.Добавить("Ответственный");
	Возврат Имена;

КонецФункции

// Пользователь - адресат ожидания: сд_Инициатор, при пустом - Ответственный
// (спека п. 4). Один пользователь в сравнении - тип ссылочный, сравнение
// по значению платформенно корректно.
Функция АдресатОжидания(Знач Пользователь, Знач Инициатор, Знач Ответственный)

	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Ожидаемый = ?(ЗначениеЗаполнено(Инициатор), Инициатор, Ответственный);
	Возврат ЗначениеЗаполнено(Ожидаемый) И Пользователь = Ожидаемый;

КонецФункции

// Условия открытия формы исправления (agentrunner-89, спека п. 4): диалог
// ожидания открыт («Ожидает ответа»), окончательный срок не истёк, текущий
// пользователь - инициатор заявки (запасной - ответственный за агента).
Функция ИсправлениеДоступно(Знач Заявка)

	Диалог = ДиалогОжидания(Заявка);
	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ar_ДиалогиСервер.ШапкаДиалога(Диалог).Состояние
		<> Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ОкончательныйСрокОжидания(Диалог) < ТекущаяДатаСеанса() Тогда
		Возврат Ложь;
	КонецЕсли;

	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка,
		"сд_Инициатор, Ответственный");
	Возврат АдресатОжидания(ПараметрыСеанса.ТекущийПользователь,
		РеквизитыЗаявки.сд_Инициатор, РеквизитыЗаявки.Ответственный);

КонецФункции

// Возобновление ожидания возможно (спека п. 8а): закрыто по сроку (последнее
// сообщение агента «Заявка закрыта: нет ответа...»; после reject и после
// отправки на проверку - другие тексты) и заявка не терминальна (Закрыт,
// ЗаявкаНаИзменение_Исполнена). Проверка инициатора - у вызывающего.
Функция ВозобновлениеВозможно(Знач Диалог, Знач Заявка)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Последнее сообщение агента (без отбора по образцу): после reject и
		// отправки на проверку в ленте остаются старые тексты закрытия по сроку.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Сообщения.ar_Текст КАК Текст
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|ГДЕ
			|	Сообщения.ar_Диалог = &Диалог
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|УПОРЯДОЧИТЬ ПО
			|	Сообщения.ar_Номер УБЫВ";
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗакрытоПоСроку = СтрНачинаетсяС(Выборка.Текст, ТекстПрефиксЗакрытияПоСроку());
		Иначе
			ЗакрытоПоСроку = Ложь; // сообщений агента нет
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если НЕ ЗакрытоПоСроку Тогда
		Возврат Ложь;
	КонецЕсли;

	// Сравнение со ссылками предопределенных статусов: Строка(Статус) - это
	// наименование («Исполнена»), а не имя предопределенного элемента.
	Статус = ВизыВОтвет(Заявка).Статус;
	Возврат Статус <> Справочники.бит_СтатусыОбъектов.Закрыт
		И Статус <> Справочники.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена;

КонецФункции

// Возобновление закрытого по сроку ожидания (спека п. 8а): сообщение агента
// «Ожидание исправления возобновлено...», новый полный срок исправления,
// срок первого напоминания и письмо. Номер возврата не растёт.
Процедура ОжиданиеВозобновлено(Знач Заявка)

	Сейчас = ТекущаяДатаСеанса();
	Срок = Сейчас + ЧислоНастройки("НСИСрокИсправленияЧасов", 120) * 3600;

	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("Якорь", ЯкорьОжидания(Заявка));
	ПараметрыСообщения.Вставить("Агент", АгентДиалогаОжидания(Заявка));
	ПараметрыСообщения.Вставить("Предмет", Заявка);
	ПараметрыСообщения.Вставить("Текст", СтрШаблон(
		НСтр("ru = 'Ожидание исправления возобновлено. Откройте заявку кнопкой
			|„Открыть“ в диалоге, исправьте и нажмите „Отправить на проверку“. Срок: %1.'"),
		Формат(Срок, "ДФ='dd.MM.yyyy HH:mm'")));
	ПараметрыСообщения.Вставить("ИменаРеквизитовАдресата", ИменаРеквизитовАдресата());
	// Срок первого напоминания, окончательный срок - в тексте сообщения.
	ПараметрыСообщения.Вставить("ОтветитьДо",
		Сейчас + ЧислоНастройки("НСИИнтервалНапоминанийЧасов", 24) * 3600);
	ПараметрыСообщения.Вставить("ТемаПисьма",
		СтрШаблон(НСтр("ru = 'Заявка НСИ %1: ожидание исправления возобновлено'"),
			НомерЗаявкиСтрокой(Заявка)));

	Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
	Если НЕ Итог.Успех Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_correction_resume_failed",
			СтрШаблон("%1: %2", Строка(Заявка), Итог.Сообщение), "Ошибка", "", Заявка);
	КонецЕсли;

КонецПроцедуры

// Агент диалога ожидания (для СообщениеПакетаПоПредмету): агент найденного
// диалога; диалога нет - пустая ссылка (диалог будет создан без агента).
Функция АгентДиалогаОжидания(Знач Заявка)

	Диалог = ДиалогОжидания(Заявка);
	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Справочники.ar_Агенты.ПустаяСсылка();
	КонецЕсли;

	Возврат ar_ДиалогиСервер.ШапкаДиалога(Диалог).Агент;

КонецФункции

// Подсказка инициатору в открытом ожидании (спека п. 8).
Функция ТекстПодсказкиОтправки()

	Возврат НСтр("ru = 'Чтобы заявка ушла на проверку, откройте её кнопкой
		|„Открыть“ в диалоге, нажмите „Отправить на проверку“. Ваше сообщение будет
		|добавлено в „Пояснение для проверки“.'");

КонецФункции

// Ответ на сообщение в закрытом ожидании (спека п. 8).
Функция ТекстОжиданиеЗакрыто()

	Возврат НСтр("ru = 'Заявка закрыта. Для изменения контрагента оформите новую заявку.'");

КонецФункции

// Префиксы сообщений агента в ленте ожидания - по ним считаются возвраты,
// срок ожидания и причина закрытия (переживают перепроведение, спека п. 7, 9).
Функция ТекстПрефиксВозврата()
	Возврат "Возврат на исправление №";
КонецФункции

Функция ТекстПрефиксВозобновления()
	Возврат "Ожидание исправления возобновлено";
КонецФункции

Функция ТекстПрефиксЗакрытияПоСроку()
	Возврат "Заявка закрыта: нет ответа";
КонецФункции

// Число возвратов заявки (спека п. 7): сообщений агента «Возврат на
// исправление №...» в ленте диалога ожидания. Визы перепроведение стирает -
// лента не стирается, счётчик по ней.
Функция ЧислоВозвратовЗаявки(Знач Заявка)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК ЧислоВозвратов
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Диалоги КАК Диалоги
			|		ПО Сообщения.ar_Диалог = Диалоги.Ссылка
			|ГДЕ
			|	Диалоги.ar_Якорь = &Якорь
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И Сообщения.ar_Текст ПОДОБНО &Образец";
		Запрос.УстановитьПараметр("Якорь", ЯкорьОжидания(Заявка));
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("Образец", ТекстПрефиксВозврата() + "%");

		Результат = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ЧислоВозвратов;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Момент последнего возврата заявки (2.5.17): последнее сообщение агента
// «Возврат на исправление №...» в ленте диалога ожидания, в универсальном
// времени (лента пишет время сеанса). Пустая дата - возвратов не было.
Функция МоментПоследнегоВозвратаЗаявки(Знач Заявка)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Сообщения.ar_Момент), ДАТАВРЕМЯ(1, 1, 1)) КАК Момент
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Диалоги КАК Диалоги
			|		ПО Сообщения.ar_Диалог = Диалоги.Ссылка
			|ГДЕ
			|	Диалоги.ar_Якорь = &Якорь
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И Сообщения.ar_Текст ПОДОБНО &Образец";
		Запрос.УстановитьПараметр("Якорь", ЯкорьОжидания(Заявка));
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("Образец", ТекстПрефиксВозврата() + "%");

		Момент = Дата(1, 1, 1);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Момент = Выборка.Момент;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если НЕ ЗначениеЗаполнено(Момент) Тогда
		Возврат Момент;
	КонецЕсли;
	Возврат УниверсальноеВремя(Момент, ЧасовойПоясСеанса());

КонецФункции

// Лимит возвратов заявки на исправление - настройка НСИЛимитВозвратов (спека
// agentrunner-89 п. 7).
Функция ЛимитВозвратовЗаявки()

	ЛимитПоУмолчанию = 3;
	Возврат ЧислоНастройки("НСИЛимитВозвратов", ЛимитПоУмолчанию);

КонецФункции

// Сообщения инициатора в ленте ожидания после последнего возврата
// (agentrunner-89, спека п. 8) - initiator_note для nsi_get_request и
// «Пояснение для проверки» формы. Пакет из двух запросов, без запросов в цикле.
Функция ЗаписиИнициатораПослеВозврата(Знач Заявка)

	Результат = "";
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// Два последовательных запроса: второй зависит от номера, найденного
		// первым (пакет не подходит - параметр второго запроса стал бы равен 0).
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Сообщения.ar_Номер), 0) КАК НомерВозврата
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Диалоги КАК Диалоги
			|		ПО Сообщения.ar_Диалог = Диалоги.Ссылка
			|ГДЕ
			|	Диалоги.ar_Якорь = &Якорь
			|	И Сообщения.ar_ВидСообщения = &ВидАгента
			|	И Сообщения.ar_Текст ПОДОБНО &Образец";
		Запрос.УстановитьПараметр("Якорь", ЯкорьОжидания(Заявка));
		Запрос.УстановитьПараметр("ВидАгента",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("Образец", ТекстПрефиксВозврата() + "%");

		НомерВозврата = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НомерВозврата = Выборка.НомерВозврата;
		КонецЕсли;

		Запрос.Текст =
			"ВЫБРАТЬ
			|	Сообщения.ar_Текст КАК Текст
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Диалоги КАК Диалоги
			|		ПО Сообщения.ar_Диалог = Диалоги.Ссылка
			|ГДЕ
			|	Диалоги.ar_Якорь = &Якорь
			|	И Сообщения.ar_ВидСообщения = &ВидПользователя
			|	И Сообщения.ar_Номер > &НомерВозврата
			|УПОРЯДОЧИТЬ ПО
			|	Сообщения.ar_Номер ВОЗР";
		Запрос.УстановитьПараметр("ВидПользователя",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеПользователя);
		Запрос.УстановитьПараметр("НомерВозврата", НомерВозврата);

		Строки = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ПустаяСтрока(СокрЛП(Выборка.Текст)) Тогда
				Строки.Добавить(СокрЛП(Выборка.Текст));
			КонецЕсли;
		КонецЦикла;
		Результат = СтрСоединить(Строки, Символы.ПС);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Момент последнего сообщения агента, задающего окончательный срок ожидания
// (спека п. 9): «Возврат на исправление №N» или «Ожидание исправления
// возобновлено». Пустая дата - сообщений нет (ожидание без срока не бывает).
Функция МоментОтсчётаСрока(Знач Диалог)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(Сообщения.ar_Момент) КАК Момент
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|ГДЕ
			|	Сообщения.ar_Диалог = &Диалог
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И (Сообщения.ar_Текст ПОДОБНО &ОбразецВозврата
			|		ИЛИ Сообщения.ar_Текст ПОДОБНО &ОбразецВозобновления)";
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("ОбразецВозврата", ТекстПрефиксВозврата() + "%");
		Запрос.УстановитьПараметр("ОбразецВозобновления", ТекстПрефиксВозобновления() + "%");

		Результат = Дата('00010101');
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Момент;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Окончательный срок исправления (спека п. 9): момент последнего возврата
// или возобновления плюс НСИСрокИсправленияЧасов. Пустая дата - отсчёта нет.
Функция ОкончательныйСрокОжидания(Знач Диалог)

	Момент = МоментОтсчётаСрока(Диалог);
	Если Не ЗначениеЗаполнено(Момент) Тогда
		Возврат Дата('00010101');
	КонецЕсли;

	Возврат Момент + ЧислоНастройки("НСИСрокИсправленияЧасов", 120) * 3600;

КонецФункции

// Текст последнего «Возврат на исправление» в ленте ожидания (для формы).
Функция ТекстПоследнегоВозврата(Знач Диалог)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Сообщения.ar_Текст КАК Текст
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|ГДЕ
			|	Сообщения.ar_Диалог = &Диалог
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И Сообщения.ar_Текст ПОДОБНО &Образец
			|УПОРЯДОЧИТЬ ПО
			|	Сообщения.ar_Номер УБЫВ";
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("Образец", ТекстПрефиксВозврата() + "%");

		Результат = "";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Текст;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Числовая настройка пакета (agentrunner-89): Число - как есть, Строка -
// разбор БСП, прочее или нуль при недопустимом - значение по умолчанию.
Функция ЧислоНастройки(Знач Ключ, Знач ЗначениеПоУмолчанию)

	Значение = ar_Настройки.ЗначениеНастройки(Ключ, ЗначениеПоУмолчанию);

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, 1, 0);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Число = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(Значение));
		Возврат ?(Число = Неопределено, ЗначениеПоУмолчанию, Число);
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

КонецФункции

// Такт команды ar_СрокиИсправленияЗаявок (agentrunner-89, спека п. 9): по
// диалогам ожидания с наступившим сроком следующего действия - напоминание
// (сообщение + письмо, срок следующего напоминания) либо закрытие
// просроченного ожидания. Без агента и без LLM; ошибка по одной заявке
// не останавливает остальные. Два запроса на такт, обработка - в цикле.
Процедура ОбработатьСрокиИсправления()

	Сейчас = ТекущаяДатаСеанса();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		// Данные напоминаний одним пакетом (запросы не в цикле): диалог, якорь,
		// агент, номер заявки (по ar_Предмет) и момент последнего возврата или
		// возобновления по каждому диалогу. Запрос с ПОМЕСТИТЬ возвращает в
		// ВыполнитьПакет счётчик вставленных строк, поэтому выборка диалогов -
		// отдельный (третий) запрос пакета из ВТ.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Диалоги.Ссылка КАК Диалог,
			|	Диалоги.ar_Якорь КАК Якорь,
			|	Диалоги.ar_Агент КАК Агент,
			|	ЕСТЬNULL(Заявки.Номер, """") КАК Номер
			|ПОМЕСТИТЬ ВТ_ДиалогиОжидания
			|ИЗ
			|	Справочник.ar_Диалоги КАК Диалоги
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
			|		ПО Диалоги.ar_Предмет = Заявки.Ссылка
			|ГДЕ
			|	Диалоги.ar_Якорь ПОДОБНО &Образец
			|	И Диалоги.ar_Состояние = &Состояние
			|	И Диалоги.ar_ОтветитьДо < &Сейчас
			|ИНДЕКСИРОВАТЬ ПО Диалог
			|;
			|ВЫБРАТЬ
			|	Ожидания.Диалог КАК Диалог,
			|	МАКСИМУМ(Сообщения.ar_Момент) КАК Момент
			|ИЗ
			|	ВТ_ДиалогиОжидания КАК Ожидания
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|		ПО Сообщения.ar_Диалог = Ожидания.Диалог
			|ГДЕ
			|	Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И (Сообщения.ar_Текст ПОДОБНО &ОбразецВозврата
			|		ИЛИ Сообщения.ar_Текст ПОДОБНО &ОбразецВозобновления)
			|СГРУППИРОВАТЬ ПО
			|	Ожидания.Диалог
			|;
			|ВЫБРАТЬ
			|	Ожидания.Диалог КАК Диалог,
			|	Ожидания.Якорь КАК Якорь,
			|	Ожидания.Агент КАК Агент,
			|	Ожидания.Номер КАК Номер
			|ИЗ
			|	ВТ_ДиалогиОжидания КАК Ожидания";
		Запрос.УстановитьПараметр("Образец", "pkg:nsi:correction:%");
		Запрос.УстановитьПараметр("Состояние",
			Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета);
		Запрос.УстановитьПараметр("Сейчас", Сейчас);
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("ОбразецВозврата", ТекстПрефиксВозврата() + "%");
		Запрос.УстановитьПараметр("ОбразецВозобновления", ТекстПрефиксВозобновления() + "%");

		Моменты = Новый Соответствие;
		Результаты = Запрос.ВыполнитьПакет();
		Выборка = Результаты[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Моменты.Вставить(Выборка.Диалог, Выборка.Момент);
		КонецЦикла;

		ВыборкаДиалогов = Результаты[2].Выбрать();
		Пока ВыборкаДиалогов.Следующий() Цикл
			Попытка
				ОбработатьСрокДиалога(ВыборкаДиалогов.Диалог, ВыборкаДиалогов.Якорь,
					ВыборкаДиалогов.Агент, СокрЛП(ВыборкаДиалогов.Номер),
					Моменты[ВыборкаДиалогов.Диалог], Сейчас);
			Исключение
				// Ошибка по одной заявке не останавливает остальные (спека п. 9).
				ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ОбработатьСрокиИсправления",
					"nsi_correction_deadline_failed",
					СтрШаблон("%1: %2", Строка(ВыборкаДиалогов.Диалог),
						ar_Утилиты.ОчиститьОшибкуДляLLM(
							ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
					"Ошибка", "", ВыборкаДиалогов.Диалог);
			КонецПопытки;
		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Напоминание либо закрытие одного диалога ожидания (спека п. 9):
// окончательный срок не наступил - напоминание и срок следующего действия
// (минимум из ближайшего напоминания и окончательного срока); наступил -
// закрытие (визу не трогает: заявка «Отклонено»).
//
// Параметры:
//  Диалог - СправочникСсылка.ar_Диалоги - диалог ожидания.
//  Якорь  - Строка - якорь диалога.
//  Агент  - СправочникСсылка.ar_Агенты - агент диалога.
//  Номер  - Строка - номер заявки (для темы письма).
//  Момент - Дата   - момент последнего возврата/возобновления.
//  Сейчас - Дата   - текущее время сеанса.
//
Процедура ОбработатьСрокДиалога(Знач Диалог, Знач Якорь, Знач Агент, Знач Номер,
	Знач Момент, Знач Сейчас)

	Если Не ЗначениеЗаполнено(Момент) Тогда
		// Отсчёт срока не найден: без него окончательный срок не определить -
		// состояние не трогаем, сбой фиксируется в служебном логе.
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ОбработатьСрокиИсправления",
			"nsi_correction_no_deadline_base",
			СтрШаблон("Диалог %1: сообщения отсчёта срока не найдены", Строка(Диалог)),
			"Предупреждение", "", Диалог);
		Возврат;
	КонецЕсли;

	СрокЧасов = ЧислоНастройки("НСИСрокИсправленияЧасов", 120);
	ИнтервалЧасов = ЧислоНастройки("НСИИнтервалНапоминанийЧасов", 24);
	ОкончательныйСрок = Момент + СрокЧасов * 3600;

	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("Якорь", Якорь);
	ПараметрыСообщения.Вставить("Агент", Агент);

	Если Сейчас >= ОкончательныйСрок Тогда
		ПараметрыСообщения.Вставить("Текст", НСтр("ru = 'Заявка закрыта: нет ответа
			|от пользователя. Если ответите в этом диалоге, исправление можно будет
			|возобновить; иначе для изменения контрагента оформите новую заявку.'"));
		ПараметрыСообщения.Вставить("ТемаПисьма", СтрШаблон(
			НСтр("ru = 'Заявка НСИ %1: ожидание исправления закрыто'"), Номер));
		ПараметрыСообщения.Вставить("ВидПисьма", "ошибка");
	Иначе
		ПараметрыСообщения.Вставить("Текст", СтрШаблон(
			НСтр("ru = 'Напоминание: заявка ждёт исправления до %1. Откройте её кнопкой
				|„Открыть“ в диалоге, исправьте реквизиты или приложите документ и нажмите
				|„Отправить на проверку“.'"),
			Формат(ОкончательныйСрок, "ДФ='dd.MM.yyyy HH:mm'")));
		ПараметрыСообщения.Вставить("ТемаПисьма", СтрШаблон(
			НСтр("ru = 'Заявка НСИ %1: напоминание об исправлении'"), Номер));
		ПараметрыСообщения.Вставить("ВидПисьма", "внимание");
		// Срок следующего действия: ближайшее напоминание или окончательный срок.
		ПараметрыСообщения.Вставить("ОтветитьДо",
			Мин(Сейчас + ИнтервалЧасов * 3600, ОкончательныйСрок));
	КонецЕсли;

	// Основание срока - в служебный лог: по нему видно, от какого сообщения
	// («Возврат»/«Возобновлено») считался окончательный срок (verify agentrunner-89, F4).
	ТекстОснования = СтрШаблон("Диалог %1: начало отсчета %2, окончательный срок %3",
		Строка(Диалог), Формат(Момент, "ДФ='dd.MM.yyyy HH:mm:ss'"),
		Формат(ОкончательныйСрок, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ОбработатьСрокиИсправления",
		"nsi_correction_deadline", ТекстОснования, "Информация", "", Диалог);

	Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
	Если НЕ Итог.Успех Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ОбработатьСрокиИсправления",
			"nsi_correction_reminder_failed",
			СтрШаблон("%1: %2", Строка(Диалог), Итог.Сообщение), "Ошибка", "", Диалог);
	КонецЕсли;

КонецПроцедуры

// Номер заявки для тем писем (чтение реквизита по ссылке).
Функция НомерЗаявкиСтрокой(Знач Заявка)

	Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заявка, "Номер"));

КонецФункции

// Заголовок нового диалога ожидания.
Функция ЗаголовокДиалогаОжидания(Знач Заявка)

	Возврат СтрШаблон(НСтр("ru = 'Исправление заявки НСИ %1'"), НомерЗаявкиСтрокой(Заявка));

КонецФункции

// Отказы «Отправить на проверку» до транзакции (agentrunner-89, спека п. 6.1,
// 6.2): адресат ожидания, открытое ожидание, не истёкший окончательный срок,
// неизменный model_hash (request_changed), наличие изменений. Заполняет
// Результат.Сообщение и возвращает Истина при отказе.
Функция ОтказОтправкиНаПроверку(Знач Параметры, Знач Заявка, Знач Результат)

	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка,
		"сд_Инициатор, Ответственный");
	Если НЕ АдресатОжидания(ПараметрыСеанса.ТекущийПользователь,
		РеквизитыЗаявки.сд_Инициатор, РеквизитыЗаявки.Ответственный) Тогда
		Результат.Сообщение = НСтр("ru = 'Исправление недоступно: заявка возвращена не вам.'");
		Возврат Истина;
	КонецЕсли;

	Диалог = ДиалогОжидания(Заявка);
	Если Не ЗначениеЗаполнено(Диалог)
		Или ar_ДиалогиСервер.ШапкаДиалога(Диалог).Состояние
			<> Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		Результат.Сообщение = НСтр("ru = 'Исправление недоступно: ожидание исправления не открыто.'");
		Возврат Истина;
	КонецЕсли;

	Если ОкончательныйСрокОжидания(Диалог) < ТекущаяДатаСеанса() Тогда
		Результат.Сообщение = НСтр("ru = 'Исправление недоступно: срок исправления истёк.'");
		Возврат Истина;
	КонецЕсли;

	ХешОткрытия = "";
	Параметры.Свойство("ХешОткрытия", ХешОткрытия);
	Если ХешМоделиЗаявкиСейчас(Заявка) <> ХешОткрытия Тогда
		Результат.Сообщение = НСтр("ru = 'Заявка изменилась, откройте её заново.'");
		ЗаписатьЛогОтправки(Заявка, "request_changed");
		Возврат Истина;
	КонецЕсли;

	МодельИзменена = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "МодельИзменена", Ложь);
	ПояснениеИзменено = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПояснениеИзменено", Ложь);
	ДобавленныеФайлы = Неопределено;
	Параметры.Свойство("ДобавленныеФайлы", ДобавленныеФайлы);
	ФайлыДобавлены = ТипЗнч(ДобавленныеФайлы) = Тип("Массив") И ДобавленныеФайлы.Количество() > 0;
	// Пометка ошибочного файла на удаление - тоже изменение: замечание бывает
	// «документ не требуется» (agentrunner-283).
	ФайлыУдалены = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ФайлыУдалены", Ложь) = Истина;

	// Сообщения инициатора в диалоге после возврата - тоже изменение: форма
	// подставляет их в пояснение как исходный текст (agentrunner-254).
	Если НЕ МодельИзменена И НЕ ПояснениеИзменено И НЕ ФайлыДобавлены И НЕ ФайлыУдалены
		И ПустаяСтрока(ЗаписиИнициатораПослеВозврата(Заявка)) Тогда
		Результат.Сообщение = НСтр("ru = 'Нет изменений.'");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// model_hash заявки по текущим данным - тот же расчёт, что у nsi_get_request.
Функция ХешМоделиЗаявкиСейчас(Знач Заявка)

	ДанныеТекущейЗаявки = ДанныеЗаявки(Заявка);
	Если ДанныеТекущейЗаявки.Шапка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ХешМоделейЗаявки(
		МодельИзХранилища(ДанныеТекущейЗаявки.Шапка.ХранилищеМодельОбъекта),
		ДанныеТекущейЗаявки.Подчиненные);

КонецФункции

// Запись модели (если изменена), отмена проведения и проведение в транзакции
// отправки (спека п. 6.3): флаги записи - как в образце (ОбменДанными.Загрузка
// и доп. свойства «без проверок», отмена и проведение - без Загрузки); визы
// назначаются заново (О11). Исключение уходит вызывающему - транзакцию
// откатывает ОтправитьНаПроверку.
Процедура ПерепровестиЗаявку(Знач Параметры, Знач Заявка, Знач Результат)

	ПолучитьСообщенияПользователю(Истина);

	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	Если ЗаявкаОбъект = Неопределено Тогда
		Результат.Сообщение = НСтр("ru = 'Заявка не найдена.'");
		Возврат;
	КонецЕсли;

	Модель = Неопределено;
	МодельИзменена = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "МодельИзменена", Ложь);
	Параметры.Свойство("Модель", Модель);
	Если МодельИзменена И ТипЗнч(Модель) = Тип("Структура") Тогда
		ЗаявкаОбъект.ЗаписатьМодельОбъекта(Модель);
	КонецЕсли;

	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить(
		"sd_ЗаписьБезПроверкиПравДоступаПользователяПоНастройке", Истина);
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("sd_ЗаменаСсылок_ЗаписьБезПроверок", Истина);
	ЗаявкаОбъект.Записать();

	ЗаявкаОбъект.ОбменДанными.Загрузка = Ложь;
	Если ЗаявкаОбъект.Проведен Тогда
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Результат.Успех = Истина;

КонецПроцедуры

// Действия после зафиксированной отправки (спека п. 6.5): пояснение -
// сообщением инициатора в диалог ожидания, добавленные файлы - в
// ar_ОчередьРаспознавания, ожидание закрывается. Сбои этих шагов отправку
// не отменяют - заявка уже перепроведена и уйдёт агенту.
Процедура ЗавершитьОтправкуНаПроверку(Знач Параметры, Знач Заявка, Знач Результат)

	// Очередь распознавания - до поиска диалога и в своей Попытке: постановка
	// файлов не зависит от ленты ожидания (verify agentrunner-89, F5: файл не
	// попал в очередь), сбой очереди не мешает закрыть ожидание.
	ПоставитьДобавленныеФайлыВОчередь(Параметры, Заявка);

	Попытка

		Диалог = ДиалогОжидания(Заявка);
		Если ЗначениеЗаполнено(Диалог) Тогда

			ПояснениеИзменено = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПояснениеИзменено", Ложь);
			Пояснение = "";
			Параметры.Свойство("Пояснение", Пояснение);
			Если ПояснениеИзменено Тогда
				Пояснение = НовоеВПоясненииОтправки(Пояснение, Заявка);
			КонецЕсли;
			Если ПояснениеИзменено И НЕ ПустаяСтрока(Пояснение) Тогда
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("ВидСообщения",
					Перечисления.ar_ВидыСообщенийДиалога.СообщениеПользователя);
				ПараметрыЗаписи.Вставить("Текст", ar_Утилиты.МаскироватьСекреты(Пояснение));
				ПараметрыЗаписи.Вставить("Автор", ПараметрыСеанса.ТекущийПользователь);
				ar_ДиалогиСервер.ЗаписатьСообщениеДиалога(Диалог, ПараметрыЗаписи);
			КонецЕсли;

			ПараметрыСообщения = Новый Структура;
			ПараметрыСообщения.Вставить("Якорь", ЯкорьОжидания(Заявка));
			ПараметрыСообщения.Вставить("Агент", ar_ДиалогиСервер.ШапкаДиалога(Диалог).Агент);
			ПараметрыСообщения.Вставить("Текст",
				НСтр("ru = 'Заявка отправлена на повторную проверку.'"));
			// ОтветитьДо не задаётся - ожидание закрывается.
			Итог = ar_ДиалогиСервер.СообщениеПакетаПоПредмету(ПараметрыСообщения);
			Если НЕ Итог.Успех Тогда
				ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_correction_close_failed",
					СтрШаблон("%1: %2", Строка(Заявка), Итог.Сообщение), "Ошибка", "", Заявка);
			КонецЕсли;

		КонецЕсли;

	Исключение
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_correction_close_failed",
			СтрШаблон("%1: %2", Строка(Заявка),
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Ошибка", "", Заявка);
	КонецПопытки;

КонецПроцедуры

// Новый текст пояснения для записи в ленту (agentrunner-254): форма открывается
// с сообщениями инициатора после возврата - они уже в ленте, повторно не пишутся.
// Пояснение начинается с них - пишется только дописанный хвост; правлено
// внутри - пишется целиком.
//
// Параметры:
//  Пояснение - Строка - пояснение из формы.
//  Заявка    - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка исправления.
//
// Возвращаемое значение:
//  Строка - текст для записи в ленту, пустая - писать нечего.
//
Функция НовоеВПоясненииОтправки(Знач Пояснение, Знач Заявка)

	Пояснение = СокрЛП(Пояснение);
	ЗаписиВЛенте = СокрЛП(ЗаписиИнициатораПослеВозврата(Заявка));
	Если ПустаяСтрока(ЗаписиВЛенте) Или НЕ СтрНачинаетсяС(Пояснение, ЗаписиВЛенте) Тогда
		Возврат Пояснение;
	КонецЕсли;

	Возврат СокрЛП(Сред(Пояснение, СтрДлина(ЗаписиВЛенте) + 1));

КонецФункции

// Постановка файлов, добавленных при исправлении, в очередь распознавания
// (спека п. 6.5) с записью итога в служебный лог: сколько файлов передано и
// сколько строк очереди записано - по логу видно, где потерялся файл.
//
// Параметры:
//  Параметры - Структура - параметры отправки (ДобавленныеФайлы).
//  Заявка    - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файлов.
//
Процедура ПоставитьДобавленныеФайлыВОчередь(Знач Параметры, Знач Заявка)

	ДобавленныеФайлы = Неопределено;
	Параметры.Свойство("ДобавленныеФайлы", ДобавленныеФайлы);
	Если ТипЗнч(ДобавленныеФайлы) <> Тип("Массив") Или ДобавленныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Поставлено = ФайлыПоставитьВОчередь(Заявка, ДобавленныеФайлы);
		ТекстЛога = СтрШаблон("%1: файлов %2, поставлено в очередь %3",
			Строка(Заявка), ДобавленныеФайлы.Количество(), Поставлено);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ЗавершитьОтправкуНаПроверку",
			"nsi_correction_files_queued", ТекстЛога, "Информация", "", Заявка);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстЛога = СтрШаблон("%1: %2", Строка(Заявка), ТекстОшибки);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ЗавершитьОтправкуНаПроверку",
			"nsi_correction_files_queue_failed", ТекстЛога, "Ошибка", "", Заявка);
	КонецПопытки;

КонецПроцедуры

// Постановка файлов заявки в очередь распознавания (спека п. 6.5): правило
// постановки - единая точка ar_ОчередьРаспознавания.ПоставитьФайл
// (agentrunner-111): живая строка (queued/processing) с тем же отпечатком
// не сбрасывается (раньше безусловная запись могла сбросить живую
// processing-строку - повторная отправка файла в RAGU); изменившийся
// отпечаток - штатная перезагрузка. Реквизиты файлов - одним чтением БСП,
// без запросов в цикле.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файлов.
//  Файлы  - Массив из СправочникСсылка - файлы заявки.
//
// Возвращаемое значение:
//  Число - сколько строк очереди записано (живая строка с тем же отпечатком
//          не перезаписывается и не считается).
//
Функция ФайлыПоставитьВОчередь(Знач Заявка, Знач Файлы)

	Поставлено = 0;
	РеквизитыФайлов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Файлы,
		"Расширение, Размер, ДатаМодификацииУниверсальная");
	НавигационнаяСсылкаЗаявки = ar_Утилиты.НавигационнаяСсылкаОбъекта(Заявка);

	Для Каждого Файл Из Файлы Цикл
		Попытка
			Реквизиты = РеквизитыФайлов[Файл];
			Если Реквизиты = Неопределено Тогда
				ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ФайлыПоставитьВОчередь",
					"nsi_file_queue_failed",
					СтрШаблон("%1: реквизиты файла не прочитаны", Строка(Файл)),
					"Предупреждение", "", Заявка);
				Продолжить;
			КонецЕсли;
			Данные = ar_ОчередьРаспознавания.НоваяСтрокаОчереди();
			Данные.Файл = ar_Утилиты.НавигационнаяСсылкаОбъекта(Файл);
			Данные.Владелец = НавигационнаяСсылкаЗаявки;
			Данные.Расширение = НРег(СокрЛП(Реквизиты.Расширение));
			Данные.Размер = Реквизиты.Размер;
			Данные.ДатаМодификации = Реквизиты.ДатаМодификацииУниверсальная;
			Данные.ПоставленоВ = ТекущаяДатаСеанса();
			Если ar_ОчередьРаспознавания.ПоставитьФайл(Данные) Тогда
				Поставлено = Поставлено + 1;
			КонецЕсли;
		Исключение
			// Сбой одной строки не отменяет остальные и отправку заявки.
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ФайлыПоставитьВОчередь",
				"nsi_file_queue_failed",
				СтрШаблон("%1: %2", Строка(Файл),
					ar_Утилиты.ОчиститьОшибкуДляLLM(
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
				"Предупреждение", "", Заявка);
		КонецПопытки;
	КонецЦикла;

	Возврат Поставлено;

КонецФункции

// Файлы, добавленные инициатором после последнего возврата, для отправки на
// проверку (спека п. 5, 6.5): только по данным базы (признак
// ДобавленПослеВозврата) - устаревший список формы не должен оставлять файл
// вне очереди распознавания (verify agentrunner-89, F5), а список формы
// отбирается по МожноУдалить, который с agentrunner-283 есть и у файлов,
// приложенных до возврата: они не распознаются повторно.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка исправления.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка - файлы.
//
Функция ДобавленныеФайлыОтправки(Знач Заявка)

	Файлы = Новый Массив;
	Для Каждого Вложение Из ФайлыЗаявкиДляФормы(Заявка) Цикл
		Если Вложение.ДобавленПослеВозврата Тогда
			Файлы.Добавить(Вложение.Файл);
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// Лог отказа отправки на проверку (спека п. 6.4).
Процедура ЗаписатьЛогОтправки(Знач Заявка, Знач Причина)

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_resubmit_failed",
		СтрШаблон("%1: %2", Строка(Заявка), Причина), "Предупреждение", "", Заявка);

КонецПроцедуры

// Отказ вложения по настройкам пакета (спека п. 5): расширение - НСИВложенияРасширения,
// размер - НСИВложенияМаксМБ. Пустая строка - вложение разрешено.
Функция ОтказВложения(Знач Расширение, Знач РазмерБайт)

	Допустимые = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(
		НастройкаСтрокой("НСИВложенияРасширения"), ",", Ложь) Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Элемент)) Тогда
			Допустимые.Добавить(НРег(СокрЛП(Элемент)));
		КонецЕсли;
	КонецЦикла;

	Если Допустимые.Количество() > 0 И Допустимые.Найти(НРег(СокрЛП(Расширение))) = Неопределено Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Расширение «%1» не поддерживается. Допустимо: %2.'"),
			Расширение, НастройкаСтрокой("НСИВложенияРасширения"));
	КонецЕсли;

	МаксМБ = ЧислоНастройки("НСИВложенияМаксМБ", 20);
	Если МаксМБ > 0 И РазмерБайт > МаксМБ * 1024 * 1024 Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Размер файла больше допустимого (%1 МБ).'"), МаксМБ);
	КонецЕсли;

	Возврат "";

КонецФункции

// Строковая настройка пакета (для списков расширений).
Функция НастройкаСтрокой(Знач Ключ)

	Значение = ar_Настройки.ЗначениеНастройки(Ключ, "");
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, Строка(Значение));

КонецФункции

// Файл можно пометить на удаление: исправление открыто (ожидание, срок,
// адресат - как у формы, agentrunner-284: защита не только формой), файл
// добавлен этим инициатором, не протокол проверки (спека п. 5, agentrunner-283).
//
// Возвращаемое значение:
//  Структура:
//   * Доступен           - Булево - файл можно пометить на удаление.
//   * ПриложенДоВозврата - Булево - файл приложен до последнего возврата: его
//                          пометка - изменение заявки для отправки на проверку.
//
Функция ФайлДоступенКУдалению(Знач Файл, Знач Заявка, Знач Пользователь)

	Результат = Новый Структура("Доступен, ПриложенДоВозврата", Ложь, Ложь);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если НЕ ИсправлениеДоступно(Заявка) Тогда
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Результат;
		КонецЕсли;
		МоментВозврата = МоментПоследнегоВозврата(Заявка);
		Если Не ЗначениеЗаполнено(МоментВозврата) Тогда
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Результат;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Файлы.ДатаСоздания КАК ДатаСоздания
			|ИЗ
			|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
			|ГДЕ
			|	Файлы.Ссылка = &Файл
			|	И Файлы.ВладелецФайла = &Заявка
			|	И Файлы.Автор = &Пользователь
			|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол проверки агентом%""
			|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол ручного исполнения%""
			|	И НЕ Файлы.ПометкаУдаления";
		Запрос.УстановитьПараметр("Файл", Файл);
		Запрос.УстановитьПараметр("Заявка", Заявка);
		Запрос.УстановитьПараметр("Пользователь", Пользователь);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Доступен = Истина;
			Результат.ПриложенДоВозврата = Выборка.ДатаСоздания <= МоментВозврата;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Момент последнего «Возврат на исправление» в ленте ожидания заявки.
Функция МоментПоследнегоВозврата(Знач Заявка)

	Диалог = ДиалогОжидания(Заявка);
	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Дата('00010101');
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Сообщения.ar_Момент КАК Момент
			|ИЗ
			|	РегистрСведений.ar_ЛентаДиалога КАК Сообщения
			|ГДЕ
			|	Сообщения.ar_Диалог = &Диалог
			|	И Сообщения.ar_ВидСообщения = &ВидСообщения
			|	И Сообщения.ar_Текст ПОДОБНО &Образец
			|УПОРЯДОЧИТЬ ПО
			|	Сообщения.ar_Номер УБЫВ";
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("ВидСообщения",
			Перечисления.ar_ВидыСообщенийДиалога.СообщениеАгента);
		Запрос.УстановитьПараметр("Образец", ТекстПрефиксВозврата() + "%");

		Результат = Дата('00010101');
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Момент;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Файлы заявки для формы исправления (спека п. 5): имя, размер, автор, дата;
// МожноУдалить - файл инициатора, не протокол, заявка возвращалась
// (agentrunner-283: и приложенный до возврата); ДобавленПослеВозврата - сверх
// того добавлен после последнего возврата (очередь распознавания). Один запрос.
Функция ФайлыЗаявкиДляФормы(Знач Заявка)

	Вложения = Новый Массив;

	РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, "сд_Инициатор");
	МоментВозврата = МоментПоследнегоВозврата(Заявка);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Файлы.Ссылка КАК Файл,
			|	Файлы.Наименование КАК Имя,
			|	Файлы.Размер КАК Размер,
			|	ПРЕДСТАВЛЕНИЕ(Файлы.Автор) КАК Автор,
			|	Файлы.ДатаСоздания КАК Дата,
			|	Файлы.ПометкаУдаления КАК ПометкаУдаления,
			|	Файлы.Автор КАК АвторСсылка,
			|	Файлы.ДатаСоздания КАК ДатаСоздания,
			|	ВЫБОР КОГДА Файлы.Наименование ПОДОБНО ""Протокол проверки агентом%""
			|		ИЛИ Файлы.Наименование ПОДОБНО ""Протокол ручного исполнения%""
			|		ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА КОНЕЦ КАК ЭтоНеПротокол
			|ИЗ
			|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
			|ГДЕ
			|	Файлы.ВладелецФайла = &Заявка
			|УПОРЯДОЧИТЬ ПО
			|	Файлы.ДатаСоздания ВОЗР";
		Запрос.УстановитьПараметр("Заявка", Заявка);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Вложение = Новый Структура;
			Вложение.Вставить("Файл", Выборка.Файл);
			Вложение.Вставить("Имя", Выборка.Имя);
			Вложение.Вставить("Размер", Выборка.Размер);
			Вложение.Вставить("Автор", Выборка.Автор);
			Вложение.Вставить("Дата", Выборка.Дата);
			Вложение.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
			// Протокол проверки (создаётся пакетом от имени инициатора после возврата)
			// не считается файлом инициатора: иначе отправка без изменений видела бы
			// «добавленный файл» и перепроводила заявку (verify agentrunner-89).
			МожноУдалить = Выборка.ЭтоНеПротокол
				И ЗначениеЗаполнено(МоментВозврата)
				И Выборка.АвторСсылка = РеквизитыЗаявки.сд_Инициатор
				И НЕ Выборка.ПометкаУдаления;
			Вложение.Вставить("МожноУдалить", МожноУдалить);
			Вложение.Вставить("ДобавленПослеВозврата",
				МожноУдалить
				И ЗначениеЗаполнено(Выборка.ДатаСоздания)
				И Выборка.ДатаСоздания > МоментВозврата);
			Вложения.Добавить(Вложение);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Вложения;

КонецФункции

// Имя подключенного к БСП экземпляра пакета (спека п. 4): элемент справочника
// ДополнительныеОтчетыИОбработки из реестра ar_ПакетыИнструменты по namespace
// "nsi", БСП ПодключитьВнешнююОбработку. "" - пакет не зарегистрирован
// (открывается штатная форма документа, сбой - в служебном логе).
Функция ИмяПодключенияПакета()

	СсылкаЭлемента = СсылкаЭлементаПакета();
	Если Не ЗначениеЗаполнено(СсылкаЭлемента) Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ИмяПодключенияПакета",
			"nsi_correction_form_no_registration",
			"Пакет не найден в реестре ar_ПакетыИнструменты - открывается штатная
				|форма документа", "Предупреждение");
		Возврат "";
	КонецЕсли;

	Попытка
		ИмяПодключения = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(СсылкаЭлемента);
	Исключение
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ИмяПодключенияПакета",
			"nsi_correction_form_connect_failed",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Предупреждение");
		Возврат "";
	КонецПопытки;

	Возврат ?(ИмяПодключения = Неопределено, "", ИмяПодключения);

КонецФункции

// Свой элемент справочника ДополнительныеОтчетыИОбработки по реестру пакетов
// (как ar_ИнструментыПлагинВызов.СсылкаНаОбработкуПоИдентификатору: UUID ->
// ПолучитьСсылку + проверка существования).
Функция СсылкаЭлементаПакета()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace = ""nsi""
		|	И Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		УникальныйИдентификатор = Новый УникальныйИдентификатор(
			СокрЛП(Выборка.ИдентификаторОбработки));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Ссылка = Справочники["ДополнительныеОтчетыИОбработки"].ПолучитьСсылку(УникальныйИдентификатор);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ЗаявкиИСценарии

// Заявка из аргументов (agentrunner-66, спека А.3): навигационная ссылка либо
// строка с номером заявки -> доступная заявка НСИ. Не заявка, не найдена или
// не видна пользователю - request_not_found (доступ - запрос РАЗРЕШЕННЫЕ,
// пусто - тот же код); номер найден у нескольких доступных заявок -
// request_ambiguous.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//
// Возвращаемое значение:
//  Структура {Ссылка, КодОшибки, Сообщение} - КодОшибки = "" при успехе,
//  Сообщение - текст отказа для {"message"} ("" при успехе).
//
Функция ЗаявкаИзАргументов(Знач Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("КодОшибки", "request_not_found");
	Результат.Вставить("Сообщение", "");

	СтрокаСсылки = ЗначениеИзКоллекции(Аргументы, "request", "");
	Если ТипЗнч(СтрокаСсылки) <> Тип("Строка") ИЛИ ПустаяСтрока(СтрокаСсылки) Тогда
		Результат.Сообщение = ТекстЗаявкаНеНайдена();
		Возврат Результат;
	КонецЕсли;

	СсылкаЗаявки = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
	Если СсылкаЗаявки = Неопределено
		Или ТипЗнч(СсылкаЗаявки) <> Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		// Навигационной ссылки в аргументе нет - модель часто передает номер
		// или представление предмета (agentrunner-66, спека А.3): ищем заявку
		// по номеру из строки.
		Возврат ЗаявкаПоНомеруИзСтроки(СтрокаСсылки, Результат);
	КонецЕсли;

	Если НЕ ЗаявкаДоступна(СсылкаЗаявки) Тогда
		Результат.Сообщение = ТекстЗаявкаНеНайдена();
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = СсылкаЗаявки;
	Результат.КодОшибки = "";
	Возврат Результат;

КонецФункции

// Заявка чужая для запуска (agentrunner-212, спека п. 5): Контекст.Предмет
// (предмет запуска, навссылка строкой - ядро кладёт в контекст из
// Состояние.ПредметЗапуска) заполнен и заявка инструмента другая - сообщение
// отказа run_subject_mismatch. Пустой/отсутствующий предмет (старое ядро,
// диалог без предмета) и неразбираемая навссылка - проверка не выполняется.
// Вызывается до чтения и до любой записи: ядро после вызова отменить
// побочный эффект уже не может.
//
// Параметры:
//  Контекст     - Структура, ФиксированнаяСтруктура - контекст запуска (Предмет).
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка инструмента.
//
// Возвращаемое значение:
//  Строка - "" - проверка пройдена либо не требуется; иначе текст отказа.
//
Функция ТекстЧужойЗаявкиДляЗапуска(Знач Контекст, Знач СсылкаЗаявки)

	СтрокаПредмета = "";
	Если ТипЗнч(Контекст) = Тип("Структура")
		Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("Предмет", СтрокаПредмета);
	КонецЕсли;
	Если ТипЗнч(СтрокаПредмета) <> Тип("Строка") Или ПустаяСтрока(СтрокаПредмета) Тогда
		Возврат "";
	КонецЕсли;

	ПредметЗапуска = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаПредмета);
	Если ПредметЗапуска = Неопределено Или ПредметЗапуска = СсылкаЗаявки Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Запуск ведёт заявку %1. Другую заявку в этом запуске брать нельзя -
			|заверши работу по заявке %1.';
			|en = 'This run is on request %1. Another request cannot be taken in this run -
			|finish the work on request %1.'"),
		Строка(ПредметЗапуска));

КонецФункции

// RunId живого запуска агента, который держит заявку захватом
// РегистрСведений.ar_ПредметыАгентов (agentrunner-266), кроме текущего запуска.
// Живой - как ar_ПредметыАгентов.ЗахватАктивен: статус запуска не финальный
// либо ОшибкаВыполнения в ожидании автоповтора; захват без записи ar_Запуски
// (сиротский) заявку не держит. Вызов вне запуска (RunId пуст, форма
// «Инструменты») - заявку держит любой живой захват.
//
// Параметры:
//  Контекст     - Структура, ФиксированнаяСтруктура - контекст запуска (RunId).
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка решения.
//
// Возвращаемое значение:
//  Строка - RunId запуска, который держит заявку; "" - заявку никто другой не держит.
//
Функция ЗапускДержащийЗаявку(Знач Контекст, Знач СсылкаЗаявки)

	ФинальныеСтатусы = Новый Массив;
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.Завершён);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.Отменён);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.Прерван);
	ФинальныеСтатусы.Добавить(Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние);

	// Захватов заявки - не больше числа агентов: живость запуска проверяется
	// в коде, без условия ИЛИ в запросе.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявка", СсылкаЗаявки);
	Запрос.УстановитьПараметр("RunId", Лев(RunIdИзКонтекста(Контекст), 36));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Захваты.ar_Запуск КАК RunId,
		|	Запуски.ar_Статус КАК Статус,
		|	Запуски.ar_ПовторитьПосле КАК ПовторитьПосле
		|ИЗ
		|	РегистрСведений.ar_ПредметыАгентов КАК Захваты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО Захваты.ar_Запуск = Запуски.ar_ИдентификаторЗапуска
		|ГДЕ
		|	Захваты.ar_Предмет = &Заявка
		|	И Захваты.ar_Запуск <> """"
		|	И Захваты.ar_Запуск <> &RunId";

	// Регистры захватов и запусков - служебные регистры ядра, в ролях
	// пользователей их нет: чтение под привилегиями (как ВозобновлениеВозможно).
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ОшибкаВыполнения = Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения;
	Пока Выборка.Следующий() Цикл
		ЖдетАвтоповтора = Выборка.Статус = ОшибкаВыполнения
			И ЗначениеЗаполнено(Выборка.ПовторитьПосле);
		Если ФинальныеСтатусы.Найти(Выборка.Статус) = Неопределено Или ЖдетАвтоповтора Тогда
			Возврат СокрЛП(Выборка.RunId);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Готовый JSON-ответ инструмента с ключом subject (agentrunner-212, спека п. 5):
// контракт ядра - top-level ключ "subject" (навссылка объекта работы) в
// успешном ответе инструмента по одной заявке; ядро разбирает его тем же
// разбором JSON, что terminal/paused. Ответы с ключом "error", DryRun-планы
// (dry_run - пробный вызов, записи не было) и не-объекты возвращаются как
// есть; ответ, уже несущий subject, не меняется. Пересериализация разобранного
// соответствия меняет порядок ключей - данные не меняются (используется для
// ответов, собираемых строкой: обработка проверки, актуализация).
//
// Параметры:
//  СтрокаОтвета - Строка - JSON-ответ инструмента.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка ответа.
//
// Возвращаемое значение:
//  Строка - JSON-ответ с subject.
//
Функция ОтветСSubject(Знач СтрокаОтвета, Знач СсылкаЗаявки)

	Если НЕ ЗначениеЗаполнено(СсылкаЗаявки) Или ПустаяСтрока(СтрокаОтвета) Тогда
		Возврат СтрокаОтвета;
	КонецЕсли;

	Разобранный = ar_JSON.ИзJSON(СтрокаОтвета);
	Если ТипЗнч(Разобранный) <> Тип("Соответствие") Тогда
		Возврат СтрокаОтвета;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Строка(Разобранный.Получить("error")))
		Или Разобранный.Получить("subject") <> Неопределено
		Или Разобранный.Получить("dry_run") <> Неопределено Тогда
		Возврат СтрокаОтвета;
	КонецЕсли;

	Разобранный.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
	Возврат ar_JSON.ВЗначениеJSON(Разобранный);

КонецФункции

// Заявка по номеру, извлеченному из строки аргумента (agentrunner-66, спека
// А.3): принимаются номер («00-00000008»), ссылочный путь с номером
// («Документ.бит_мдм_ЗаявкаНаИзменение/00-00000008») и представление
// («Заявка на изменение НСИ 00-00000008 от 21.09.2026»). Найдена ровно одна
// доступная заявка (запрос РАЗРЕШЕННЫЕ - скрытая правами неотличима от
// несуществующей) - читается; несколько - request_ambiguous со списком.
//
// Параметры:
//  СтрокаЗаявки - Строка    - значение аргумента request.
//  Результат    - Структура - результат ЗаявкаИзАргументов (заполняется).
//
// Возвращаемое значение:
//  Структура - тот же Результат.
//
Функция ЗаявкаПоНомеруИзСтроки(Знач СтрокаЗаявки, Знач Результат)

	Кандидаты = КандидатыНомераИДатаИзСтроки(СтрокаЗаявки);
	Если Кандидаты.Номера.Количество() = 0 Тогда
		Результат.Сообщение = ТекстЗаявкаНеНайдена();
		Возврат Результат;
	КонецЕсли;

	СтрокиЗаявок = ЗаявкиПоНомерам(Кандидаты.Номера);
	Если СтрокиЗаявок.Количество() > 1 И Кандидаты.Дата <> Дата(1, 1, 1) Тогда
		// Совпали заявки с одинаковым номером разных периодов - сужаем датой
		// из представления, если она была (спека А.3).
		СтрокиЗаявок = ЗаявкиПоНомерам(Кандидаты.Номера, Кандидаты.Дата);
	КонецЕсли;

	Если СтрокиЗаявок.Количество() = 1 Тогда
		Результат.Ссылка = СтрокиЗаявок[0].Ссылка;
		Результат.КодОшибки = "";
		Возврат Результат;
	КонецЕсли;

	Если СтрокиЗаявок.Количество() > 1 Тогда
		Результат.КодОшибки = "request_ambiguous";
		Результат.Сообщение = ТекстНеоднозначнойЗаявки(Кандидаты, СтрокиЗаявок);
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = ТекстЗаявкаНеНайдена();
	Возврат Результат;

КонецФункции

// Кандидаты номера и дата из строки аргумента request (agentrunner-66, спека
// А.3): токены по пробелам, слешам и разделителям; номер - «цифры-цифры»
// (00-00000008), дата - «дд.мм.гггг».
//
// Параметры:
//  СтрокаЗаявки - Строка - значение аргумента request.
//
// Возвращаемое значение:
//  Структура {Номера - Массив из Строка, Дата - Дата (пустая, если даты в
//  строке нет)}.
//
Функция КандидатыНомераИДатаИзСтроки(Знач СтрокаЗаявки)

	Результат = Новый Структура;
	Результат.Вставить("Номера", Новый Массив);
	Результат.Вставить("Дата", Дата(1, 1, 1));

	// Дата через локальную переменную: свойство структуры в параметр по ссылке
	// передаётся по значению - изменение внутри ЭтоДатаПредставления потерялось бы.
	ДатаКандидата = Дата(1, 1, 1);
	Токены = СтрРазделить(СтрокаЗаявки, " /\,;:()[]|", Ложь);
	Для Каждого Токен Из Токены Цикл
		Если ПустаяСтрока(Токен) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоНомерЗаявки(Токен) Тогда
			Результат.Номера.Добавить(Токен);
		КонецЕсли;
		Если ДатаКандидата = Дата(1, 1, 1) Тогда
			ЭтоДатаПредставления(Токен, ДатаКандидата);
		КонецЕсли;
	КонецЦикла;
	Результат.Дата = ДатаКандидата;

	Возврат Результат;

КонецФункции

// Токен - номер заявки: ровно одна пара «цифры-цифры», обе части непустые.
Функция ЭтоНомерЗаявки(Знач Токен)

	Если СтрДлина(Токен) < 4 Или СтрДлина(Токен) > 20 Тогда
		Возврат Ложь;
	КонецЕсли;

	Части = СтрРазделить(Токен, "-", Ложь);
	Возврат Части.Количество() = 2
		И ЭтоЦифры(Части[0]) И ЭтоЦифры(Части[1]);

КонецФункции

// Токен - дата представления «дд.мм.гггг»; при успехе записывает дату
// (параметр Дата изменяется на месте).
Функция ЭтоДатаПредставления(Знач Токен, Дата)

	Части = СтрРазделить(Токен, ".", Ложь);
	Если Части.Количество() <> 3
		Или СтрДлина(Части[0]) <> 2 Или СтрДлина(Части[1]) <> 2 Или СтрДлина(Части[2]) <> 4
		Или НЕ ЭтоЦифры(Части[0]) Или НЕ ЭтоЦифры(Части[1]) Или НЕ ЭтоЦифры(Части[2]) Тогда
		Возврат Ложь;
	КонецЕсли;

	День = Число(Части[0]);
	Месяц = Число(Части[1]);
	Год = Число(Части[2]);
	Если Год < 2000 Или Год > 2099 Или Месяц < 1 Или Месяц > 12
		Или День < 1 Или День > 31 Тогда
		Возврат Ложь;
	КонецЕсли;

	Дата = Дата(Год, Месяц, День);
	Возврат Истина;

КонецФункции

// Строка состоит только из цифр.
Функция ЭтоЦифры(Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Строка) Цикл
		КодСимв = КодСимвола(Строка, Позиция);
		Если КодСимв < КодСимвола("0") Или КодСимв > КодСимвола("9") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Доступные заявки (запрос РАЗРЕШЕННЫЕ) по списку номеров одним запросом;
// ДатаДня, если задана, сужает выборку своим днем (совпадение номеров разных
// периодов).
//
// Параметры:
//  Номера   - Массив из Строка - кандидаты номера.
//  ДатаДня  - Дата - дата из представления; пустая дата - без сужения.
//
// Возвращаемое значение:
//  Массив из Структура {Ссылка, Номер, Представление}.
//
Функция ЗаявкиПоНомерам(Знач Номера, Знач ДатаДня = Неопределено)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номера", Номера);

	// Без даты из представления - весь диапазон: один текст запроса, условие
	// по дате не меняется (широкие границы индекс по дате не ломают).
	// Верхняя граница - максимум запроса 1С (даты больше 3999 запрещены).
	Если ДатаДня = Неопределено Тогда
		Запрос.УстановитьПараметр("НачалоДня", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("КонецДня", Дата(3999, 12, 31));
	Иначе
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаДня));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДня));
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Номер В (&Номера)
		|	И Т.Дата МЕЖДУ &НачалоДня И &КонецДня";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Ссылка, Номер, Представление",
			Выборка.Ссылка, Выборка.Номер, Выборка.Представление));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст отказа request_not_found с подсказкой модели (agentrunner-66, спека
// А.3).
Функция ТекстЗаявкаНеНайдена()

	Возврат НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.
		|Возьми request из nsi_pending_visas.'");

КонецФункции

// Текст отказа request_ambiguous со списком найденных заявок {request,
// presentation} (agentrunner-66, спека А.3).
Функция ТекстНеоднозначнойЗаявки(Знач Кандидаты, Знач СтрокиЗаявок)

	Список = Новый Массив;
	Для Каждого СтрокаЗаявки Из СтрокиЗаявок Цикл
		Список.Добавить(СтрШаблон(НСтр("ru = 'request = %1, представление: %2'"),
			ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаЗаявки.Ссылка),
			СтрокаЗаявки.Представление));
	КонецЦикла;

	Возврат СтрШаблон(
		НСтр("ru = 'По номеру %1 найдено несколько доступных заявок - уточни выбор.
			|%2'"),
		СтрСоединить(Кандидаты.Номера, ", "), СтрСоединить(Список, Символы.ПС));

КонецФункции

// Видит ли пользователь сеанса заявку (спека п. 3): запрос РАЗРЕШЕННЫЕ -
// скрытая ограничением доступа заявка неотличима от несуществующей.
Функция ЗаявкаДоступна(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Сценарий заявки строкой «вид-резидентность-операция» (спека п. 4);
// «не определен», если вид или резидентность определить не удалось
// (approve для такого сценария запрещен).
//
// Параметры:
//  Шапка       - Структура - шапка заявки из РеквизитыЗаявокШапки.
//  МодельСтало - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Строка - например «ЮЛ-резидент-создание» или «не определен».
//
Функция СценарийЗаявки(Знач Шапка, Знач МодельСтало)

	Признаки = ПризнакиСубъектаСценария(Шапка.Ссылка, МодельСтало);
	Вид = ВидОбъектаСценария(ВидЛицаЗаявки(МодельСтало), Признаки);
	Резидентность = РезидентностьСценария(Признаки);
	Если ПустаяСтрока(Вид) Или ПустаяСтрока(Резидентность) Тогда
		Возврат СценарийНеОпределен();
	КонецЕсли;

	Возврат Вид + "-" + Резидентность + "-" + ОперацияСценария(Шапка);

КонецФункции

// Имена признаков контрагента, определяющих вид субъекта и резидентность
// сценария (спека п. 4).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ПризнакиСценария()

	Имена = Новый Массив;
	Имена.Добавить("sd_ОП");
	Имена.Добавить("ОбособленноеПодразделение");
	Имена.Добавить("ГосударственныйОрган");
	Имена.Добавить("sd_ГосударственныеОрганы");
	Имена.Добавить("sd_ИП");
	Имена.Добавить("ИндивидуальныйПредприниматель");
	Имена.Добавить("sd_Нерезидент");
	Возврат Имена;

КонецФункции

// Признаки субъекта по правилу спеки п. 5: существующие в шапке заявки читаются
// одним вызовом БСП, остальные - из модели «стало» (стандарт: не через точку
// по одному признаку).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка - заявка (для шапочных признаков).
//  МодельСтало  - Структура     - модель «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Соответствие - имя признака -> значение.
//
Функция ПризнакиСубъектаСценария(Знач СсылкаЗаявки, Знач МодельСтало)

	ИменаПризнаков = ПризнакиСценария();
	ШапочныеИмена = ШапочныеИменаЗаявки(ИменаПризнаков);
	ШапочныеЗначения = ЗначенияШапочныхРеквизитов(СсылкаЗаявки, ШапочныеИмена);

	Признаки = Новый Соответствие;
	Для Каждого ИмяПризнака Из ИменаПризнаков Цикл
		Если ШапочныеЗначения.Свойство(ИмяПризнака) Тогда
			Признаки.Вставить(ИмяПризнака, ШапочныеЗначения[ИмяПризнака]);
		Иначе
			Признаки.Вставить(ИмяПризнака, ЗначениеМоделиПоИмени(МодельСтало, ИмяПризнака));
		КонецЕсли;
	КонецЦикла;
	Возврат Признаки;

КонецФункции

// Вид субъекта сценария: ОП / Госорган по признакам, иначе по Юр/Физ и ИП
// (спека п. 4). Пустая строка - определить не удалось.
//
// Параметры:
//  ВидЛица  - ПеречислениеСсылка.ЮридическоеФизическоеЛицо, Неопределено - из ВидЛицаЗаявки.
//  Признаки - Соответствие - признаки субъекта (ПризнакиСубъектаСценария).
//
// Возвращаемое значение:
//  Строка - ОП, Госорган, ИП, ЮЛ, ФЛ или пустая строка.
//
Функция ВидОбъектаСценария(Знач ВидЛица, Знач Признаки)

	Если ЗначениеБулево(Признаки.Получить("sd_ОП"))
		Или ЗначениеБулево(Признаки.Получить("ОбособленноеПодразделение")) Тогда
		Возврат "ОП";
	КонецЕсли;

	Если ЗначениеБулево(Признаки.Получить("ГосударственныйОрган"))
		Или ЗначениеБулево(Признаки.Получить("sd_ГосударственныеОрганы")) Тогда
		Возврат "Госорган";
	КонецЕсли;

	Если ВидЛица = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		Если ЗначениеБулево(Признаки.Получить("sd_ИП"))
			Или ЗначениеБулево(Признаки.Получить("ИндивидуальныйПредприниматель")) Тогда
			Возврат "ИП";
		КонецЕсли;
		Возврат "ЮЛ";
	ИначеЕсли ВидЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат "ФЛ";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Вид лица заявки (2.5.21, 2.5.31): реквизит ЮридическоеФизическоеЛицо модели
// «стало» - то, что будет записано в контрагента. Один источник для сценария и
// сверки. Реквизит шапки заявки sd_ЮридическоеФизическоеЛицо не используется: он
// заполнен по умолчанию «Юридическое лицо» и не совпадает с моделью (заявка
// 00-00093878 - сценарий ЮЛ вместо ФЛ), а подстановка из него скрывала не
// заполненный в заявке вид лица.
//
// Параметры:
//  МодельСтало - Структура, Соответствие - модель «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ЮридическоеФизическоеЛицо, Неопределено - не заполнен.
//
Функция ВидЛицаЗаявки(Знач МодельСтало)

	ВидЛица = ЗначениеМоделиПоИмени(МодельСтало, "ЮридическоеФизическоеЛицо");
	Если ТипЗнч(ВидЛица) = Тип("ПеречислениеСсылка.ЮридическоеФизическоеЛицо")
		И ЗначениеЗаполнено(ВидЛица) Тогда
		Возврат ВидЛица;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Приводит значение признака контрагента (Булево из модели или шапки, Число,
// Строка) к Булево; Неопределено и незнакомое значение - Ложь.
Функция ЗначениеБулево(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Возврат Текст = "истина" Или Текст = "да" Или Текст = "1";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Резидентность сценария по признаку sd_Нерезидент; пустая строка - признак
// не определен ни в шапке, ни в модели.
Функция РезидентностьСценария(Знач Признаки)

	Значение = Признаки.Получить("sd_Нерезидент");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(ЗначениеБулево(Значение), "нерезидент", "резидент");

КонецФункции

// Операция сценария по ВидОперации шапки (спека п. 4): создание / изменение /
// прочее.
Функция ОперацияСценария(Знач Шапка)

	Если Шапка.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового Тогда
		Возврат "создание";
	ИначеЕсли Шапка.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		Возврат "изменение";
	Иначе
		Возврат "прочее";
	КонецЕсли;

КонецФункции

// Значение реквизита из модели «стало»: Реквизиты, затем СтандартныеРеквизиты.
Функция ЗначениеМоделиПоИмени(Знач МодельСтало, Знач ИмяРеквизита)

	Если МодельСтало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ЗначениеГруппыМодели(МодельСтало, "Реквизиты", ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеГруппыМодели(МодельСтало, "СтандартныеРеквизиты", ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Значение из группы модели (Структура или Соответствие); Неопределено - группа
// или ключ отсутствуют.
Функция ЗначениеГруппыМодели(Знач Модель, Знач ИмяГруппы, Знач ИмяРеквизита)

	Группа = ГруппаМодели(Модель, ИмяГруппы);
	Возврат ЗначениеИзКоллекцииМодели(Группа, ИмяРеквизита);

КонецФункции

// Группа модели по имени; модель может быть Структурой или Соответствием.
Функция ГруппаМодели(Знач Модель, Знач ИмяГруппы)

	Возврат ЗначениеИзКоллекцииМодели(Модель, ИмяГруппы);

КонецФункции

// Значение из коллекции группы (Структура - по свойству, Соответствие - по
// ключу); Неопределено - нет.
Функция ЗначениеИзКоллекцииМодели(Знач Коллекция, Знач Ключ)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Модель из хранилища значения: Структура или Соответствие; пустое хранилище -
// Неопределено (спека п. 10: fields пуст, warning model_empty).
Функция МодельИзХранилища(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Модель = Хранилище.Получить();
	Если ТипЗнч(Модель) = Тип("Структура") Или ТипЗнч(Модель) = Тип("Соответствие") Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Пользователь агента из контекста запуска (спека п. 3): Контекст.Агент ->
// реквизит ar_Пользователь; прием ar_ДиалогиСервер.ПользовательАгента. Пустая
// ссылка - агента нет или пользователь не заполнен.
//
// Параметры:
//  Контекст - Структура - контекст запуска (может быть Неопределено).
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи.
//
Функция ПользовательАгентаИзКонтекста(Знач Контекст)

	ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();

	Агент = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("Агент", Агент);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Агент) Или НЕ ОбщегоНазначения.СсылкаСуществует(Агент) Тогда
		Возврат ПустойПользователь;
	КонецЕсли;

	Пользователь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "ar_Пользователь");
	Возврат ?(ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи"),
		Пользователь, ПустойПользователь);

КонецФункции

// Агент из контекста запуска (для отсева отложенных, agentrunner-35): та же
// защита на Неопределено и прочие типы, что у ПользовательАгентаИзКонтекста.
//
// Параметры:
//  Контекст - Структура - контекст запуска (может быть Неопределено).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты, Неопределено - ссылка агента или Неопределено,
//  если в контексте ее нет.
//
Функция АгентИзКонтекста(Знач Контекст)

	Агент = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("Агент", Агент);
	КонецЕсли;
	Возврат Агент;

КонецФункции

// Краткий ответ повторного чтения неизменной заявки (agentrunner-66, спека
// А.4): без fields/tables/subordinate/regulation; Неопределено - заявка
// изменилась, читается впервые или запрошен full - нужен полный ответ.
//
// Параметры:
//  Контекст     - Структура - контекст запуска (RunId).
//  Аргументы    - Соответствие - аргументы вызова (full).
//  Шапка        - Структура - шапка заявки (ДанныеЗаявки.Шапка).
//  ВизыИСтатус  - Структура - визы и статус заявки (ВизыВОтвет).
//  Сценарий     - Строка - сценарий заявки (с "actualize" для сценария).
//  ХешТекущий   - Строка - текущий model_hash заявки.
//
// Возвращаемое значение:
//  Строка - JSON-краткий ответ; Неопределено - полный ответ.
//
Функция КраткоеПовторноеЧтение(Знач Контекст, Знач Аргументы, Знач Шапка,
	Знач ВизыИСтатус, Знач Сценарий, Знач ХешТекущий)

	Если ЗначениеБулево(ЗначениеИзКоллекции(Аргументы, "full", Ложь)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ХешПрошлогоЧтенияЗаявки(Контекст, Шапка.Ссылка) <> ХешТекущий Тогда
		Возврат Неопределено;
	КонецЕсли;
	// agentrunner-213: после решения в этом запуске (виза 1 согласована,
	// продолжение этапом 2) модель заявки та же, но этап, визы и next другие -
	// нужен полный ответ.
	Если РешениеВЗапуске(Контекст).Есть Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОтветКратко = Новый Структура;
	ОтветКратко.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Ссылка));
	// agentrunner-212: краткий ответ - тоже успешный ответ по одной заявке.
	ОтветКратко.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Ссылка));
	ОтветКратко.Вставить("number", Шапка.Номер);
	ОтветКратко.Вставить("status", ЗначениеВСтрокуДляОтвета(ВизыИСтатус.Статус));
	ОтветКратко.Вставить("scenario", Сценарий);
	ОтветКратко.Вставить("visas", ВизыИСтатус.Визы);
	ОтветКратко.Вставить("model_hash", ХешТекущий);
	ОтветКратко.Вставить("unchanged", Истина);
	ОтветКратко.Вставить("message",
		НСтр("ru = 'Данные заявки не менялись с прошлого чтения в этом запуске - используй
			|прочитанные ранее; полный ответ вернётся при full = true.'"));
	Возврат ar_JSON.ВЗначениеJSON(ОтветКратко);

КонецФункции

// Ключи соответствия массивом (для пакетной передачи в запрос).
//
// Параметры:
//  Соответствие - Соответствие - коллекция, чьи ключи собираются в массив.
//
// Возвращаемое значение:
//  Массив - ключи соответствия.
//
Функция КлючиСоответствия(Знач Соответствие)

	Результат = Новый Массив;
	Для Каждого КлючЗначение Из Соответствие Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Предельное число объектов очереди за вызов ar_ОбъектыКОбработке (спека
// agentrunner-34; ядро передает не больше 200).
//
// Возвращаемое значение:
//  Число - предельное число объектов очереди.
//
Функция ПредельныйЛимитОчереди()
	Возврат 200;
КонецФункции

// Общий отбор заявок, ждущих визу пользователя агента: кандидаты из регистра
// бит_УстановленныеВизы (СтрокиКандидатовНаВизе) + фильтр по визам агента
// (СтрокиСВизойАгента) + пропуск заявок, переданных агентом сотруднику НСИ
// (agentrunner-35, спека п. 4). Единственная точка отбора очереди:
// инструмент nsi_pending_visas и метод очереди ar_ОбъектыКОбработке обязаны
// видеть одну и ту же очередь - два текста запроса разошлись бы при правке
// (спека agentrunner-34, решение 1).
//
// Отметки отложения читаются ядром одним запросом (через фасад), текущие
// model_hash считаются одним пакетным чтением моделей и только для отмеченных
// заявок. Пропущенные строки не расходуют Лимит; отметка устарела (виза
// другая или хеш другой) - строка остается в выдаче.
//
// Параметры:
//  ПользовательАгента - СправочникСсылка.Пользователи - пользователь агента.
//  ИмяОбъекта         - Строка - имя объекта обмена для отбора; "" - все заявки НСИ.
//  Лимит              - Число  - предельное число строк отбора.
//  СсылкАгент         - СправочникСсылка.ar_Агенты - агент очереди (для отметок
//                       отложения); пустая ссылка - отсев не выполняется.
//  ВключаяОтложенных  - Булево - отмеченные строки не пропускаются
//                       (include_handed_over инструмента); по умолчанию Ложь.
//  ДляОчереди         - Булево - заявки с распознающимися файлами не возвращаются
//                       (метод очереди); Ложь - возвращаются с признаком; по
//                       умолчанию Ложь (agentrunner-88).
//
// Возвращаемое значение:
//  Структура:
//   * Строки              - Массив - строки кандидатов с визой агента (не больше Лимит).
//   * ПросмотреноЗаявок   - Число  - заявок, для которых проверялись визы агента.
//   * ПропущеноОтложенных - Число  - строк, пропущенных по отметке отложения.
//
Функция ЗаявкиНаВизеАгента(Знач ПользовательАгента, Знач ИмяОбъекта, Знач Лимит,
	Знач СсылкАгент, Знач ВключаяОтложенных = Ложь, Знач ДляОчереди = Ложь)

	СтрокиКандидатов = СтрокиКандидатовНаВизе(ИмяОбъекта, ДляОчереди);

	Отложенные = Новый Соответствие;
	ХешиОтпечатков = Новый Соответствие;
	ЗаявкиКандидатов = ЗаявкиИзСтрок(СтрокиКандидатов);
	Если ЗаявкиКандидатов.Количество() > 0 И ЗначениеЗаполнено(СсылкАгент) Тогда
		Отложенные = ar_AuditЗащищённыйРежим.ОтложенныеПредметыПривилегированно(
			СсылкАгент, ЗаявкиКандидатов);
		Если Отложенные.Количество() > 0 Тогда
			УдалитьОтметкиСНовымиФайлами(Отложенные);
		КонецЕсли;
		Если Отложенные.Количество() > 0 Тогда
			ХешиОтпечатков = ХешиМоделейЗаявок(КлючиСоответствия(Отложенные));
		КонецЕсли;
	КонецЕсли;

	Возврат СтрокиСВизойАгента(СтрокиКандидатов, ПользовательАгента, Лимит,
		Отложенные, ХешиОтпечатков, ВключаяОтложенных);

КонецФункции

// Убирает из отметок отложения заявки, к которым после передачи (ОтложенВ)
// приложен новый файл (agentrunner-213, заявка 00-00000041): модель заявки и
// model_hash файлов не содержат, а передача часто ждет именно вложения (файл
// банковских реквизитов) - без этого заявка оставалась вне очереди агента до
// изменения модели. Свои протоколы («Протокол проверки агентом ...»,
// «Протокол автоактуализации агентом ...», «Протокол ручного исполнения ...» -
// agentrunner-252) не учитываются - пишет их пакет и аварийная обработка.
// Один запрос на все отмеченные заявки.
//
// Параметры:
//  Отложенные - Соответствие - "Заявка -> Структура {Ключ, Отпечаток, ОтложенВ,
//               Причина}" - отметки отложения (изменяется: устаревшие удаляются).
//
Процедура УдалитьОтметкиСНовымиФайлами(Отложенные)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ВладелецФайла КАК Заявка,
		|	МАКСИМУМ(Файлы.ДатаСоздания) КАК ДатаФайла
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла В (&Заявки)
		|	И НЕ Файлы.ПометкаУдаления
		|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол проверки агентом%""
		|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол автоактуализации агентом%""
		|	И НЕ Файлы.Наименование ПОДОБНО ""Протокол ручного исполнения%""
		|
		|СГРУППИРОВАТЬ ПО
		|	Файлы.ВладелецФайла";
	Запрос.УстановитьПараметр("Заявки", КлючиСоответствия(Отложенные));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отметка = Отложенные.Получить(Выборка.Заявка);
		Если Отметка <> Неопределено И Выборка.ДатаФайла > Отметка.ОтложенВ Тогда
			Отложенные.Удалить(Выборка.Заявка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Настройка-булево из ar_Настройки в Булево (ядро может вернуть Строку).
Функция НастройкаИстинна(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Возврат Текст = "истина" Или Текст = "да" Или Текст = "1" Или Текст = "yes";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Дата начала обработки заявок агентом из настройки пакета
// НСИДатаНачалаОбработкиЗаявок (agentrunner-41). Обёртка над
// РазборДатыНачалаОбработкиЗаявок (agentrunner-202): разбор значения и его
// источник - там, здесь - только нормализация к началу дня.
//
// Возвращаемое значение:
//  Дата - начало дня, начиная с которого отбираются заявки (по дате документа).
//
Функция ДатаНачалаОбработкиЗаявок()

	Возврат НачалоДня(РазборДатыНачалаОбработкиЗаявок().Дата);

КонецФункции

// Разбирает значение настройки НСИДатаНачалаОбработкиЗаявок (agentrunner-41):
// тип Дата - как есть (настройка хранится датой, agentrunner-202); строка -
// разбор через ДатаИзСтрокиНачала (ДД.ММ.ГГГГ либо ГГГГММДД - совместимость
// со старыми строковыми записями). Дефолт - 01.11.2026.
// Неразборчивое значение не молчит (корень инцидента 2c8c5f3b): пустая дата у
// настроенного ключа, непустая неразборчивая строка и значения иных типов
// дают запись ar_СлужебныйЛог "nsi_start_date_invalid" («Предупреждение») с
// исходным значением; применённой датой остаётся дефолт (поведение очереди
// на старые заявки не расширяется). Отсутствие настройки (ключа нет /
// выключена) и пустая строка - дефолт без записи в журнал.
//
// Возвращаемое значение:
//  Структура:
//   * Дата     - Дата   - применяемая дата начала (без нормализации к началу дня).
//   * Источник - Строка - "setting" (значение настройки), "default" (настройки
//                нет или пусто) либо "invalid" (значение не распознано).
//
Функция РазборДатыНачалаОбработкиЗаявок()

	ИменаПолей = "Дата, Источник";
	Дефолт = Дата(2026, 11, 1);

	Значение = ar_Настройки.ЗначениеНастройки("НСИДатаНачалаОбработкиЗаявок", Неопределено);

	Если Значение = Неопределено Тогда
		// Ключа нет, настройка выключена либо это настройка-список.
		Возврат Новый Структура(ИменаПолей, Дефолт, "default");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		Возврат Новый Структура(ИменаПолей, Значение, "setting");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
		Если ПустаяСтрока(Текст) Тогда
			Возврат Новый Структура(ИменаПолей, Дефолт, "default");
		КонецЕсли;
		Результат = ДатаИзСтрокиНачала(Текст);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Новый Структура(ИменаПолей, Результат, "setting");
		КонецЕсли;
	КонецЕсли;

	// Значение есть, но даты из него не получилось.
	ТекстЖурнала = СтрШаблон(НСтр("ru = 'Настройка НСИДатаНачалаОбработкиЗаявок не содержит даты:
		|значение «%1» (тип %2), применена дата по умолчанию 01.11.2026.'"),
		Строка(Значение), Строка(ТипЗнч(Значение)));
	ar_СлужебныйЛог.Записать("ar_ПакетНСИ.РазборДатыНачалаОбработкиЗаявок",
		"nsi_start_date_invalid", ТекстЖурнала, "Предупреждение");

	Возврат Новый Структура(ИменаПолей, Дефолт, "invalid");

КонецФункции

// Дата из строкового значения настройки (совместимость со старыми строковыми
// записями, бывшее тело ДатаНачалаОбработкиЗаявок): «ДД.ММ.ГГГГ» через БСП
// СтроковыеФункцииКлиентСервер.СтрокаВДату; строка из ровно 8 цифр («ГГГГММДД»)
// - платформенным Дата(). Не разобралось - пустая дата.
//
// Параметры:
//  Текст - Строка - непустое строковое значение настройки.
//
// Возвращаемое значение:
//  Дата - разобранная дата либо пустая.
//
Функция ДатаИзСтрокиНачала(Знач Текст)

	Результат = СтроковыеФункцииКлиентСервер.СтрокаВДату(Текст);
	Если Не ЗначениеЗаполнено(Результат)
		И СтрДлина(Текст) = 8
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
		Попытка
			Результат = Дата(Текст);
		Исключение
			Результат = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПротоколПроверкиИРегламент

// agentrunner-48 (части 2-4): файл протокола к заявке, регламент по сценарию
// и механические проверки регламента.

// Файл протокола (п. 2.2 спеки): текст собирается из решения, протокола
// модели и повторного расчета проверок на момент решения, файл - текстовый
// UTF-8, привилегированная запись через БСП. Сбой записи не бросает
// исключений - результат с ошибкой, решение не трогается.
//
// Параметры:
//  Проверки   - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//               Комментарий, КодРешения, Протокол, ПользовательАгента).
//  Контекст   - Структура - контекст запуска (RunId, Агент).
//  ИтогЗаписи - Строка    - «записано» либо «отказ: <код>».
//
// Возвращаемое значение:
//  Структура {Успех - Булево, ИмяФайла - Строка, Ошибка - Строка}.
//
Функция ЗаписатьПротоколПроверки(Знач Проверки, Знач Контекст, Знач ИтогЗаписи)

	Результат = Новый Структура("Успех, ИмяФайла, Ошибка", Ложь, "", "");

	Попытка

		ТекстПротокола = ТекстПротоколаПроверки(Проверки, Контекст, ИтогЗаписи);
		// 2.5.1: решения по заявке - блоки одного файла протокола (дописываются);
		// записанный restart для лимита повторных циклов узнается по блоку
		// (ПовторныйЦиклРазрешен), а не по имени файла.
		ИмяФайла = ИмяФайлаПротоколаПроверки();

		ЗаписьФайла = ДописатьФайлПротоколаПривилегированно(
			Проверки.СсылкаЗаявки, ИмяФайла, ТекстПротокола, Проверки.ПользовательАгента);

		Если ЗаписьФайла.Успех Тогда
			Результат.Успех = Истина;
			Результат.ИмяФайла = ИмяФайла + ".txt";
		Иначе
			Результат.Ошибка = ЗаписьФайла.Ошибка;
		КонецЕсли;

	Исключение
		Результат.Ошибка = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Не Результат.Успех Тогда
		// Сбой записи файла не отменяет решение - только в журнал регистрации.
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "protocol_file_failed",
			СтрШаблон("%1: %2", Строка(Проверки.СсылкаЗаявки), Результат.Ошибка),
			"Предупреждение");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Текст протокола проверки (п. 2.2 спеки): заявка (номер, дата, представление),
// сценарий, дата и время, агент, RunId, решение, итог записи, комментарий визы,
// протокол модели (строка на проверку), затем раздел «Проверка данных заявки
// (обработка <имя>)» (agentrunner-87).
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстПротоколаПроверки(Знач Проверки, Знач Контекст, Знач ИтогЗаписи)

	ДанныеЗаявки = ДанныеЗаявки(Проверки.СсылкаЗаявки);
	Шапка = ДанныеЗаявки.Шапка;
	МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
	Сценарий = СценарийЗаявки(Шапка, МодельСтало);

	RunId = "";
	АгентПредставление = "-";
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("RunId", RunId);
		СсылкаАгент = Неопределено;
		Контекст.Свойство("Агент", СсылкаАгент);
		Если ЗначениеЗаполнено(СсылкаАгент) Тогда
			АгентПредставление = Строка(СсылкаАгент);
		КонецЕсли;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Протокол проверки агентом НСИ'"));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Заявка: %1 от %2 (%3)'"),
		Шапка.Номер, Формат(Шапка.Дата, "ДФ=dd.MM.yyyy"), Строка(Проверки.СсылкаЗаявки)));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Сценарий: %1'"), Сценарий));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Дата и время: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss")));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Агент: %1'"), АгентПредставление));
	Части.Добавить(СтрШаблон(НСтр("ru = 'RunId: %1'"), RunId));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Решение: %1'"), Проверки.КодРешения));
	// agentrunner-88: этап визы и model_hash решения - хеш сравнивается при
	// визе 2 с моделью на момент визы 1 (model_changed_since_visa1).
	Части.Добавить(СтрШаблон(НСтр("ru = 'Этап: %1'"),
		?(Проверки.Этап = 0, "-", Строка(Проверки.Этап))));
	Части.Добавить(СтрШаблон(НСтр("ru = 'model_hash: %1'"),
		?(ПустаяСтрока(Проверки.ХешАгента), "-", Проверки.ХешАгента)));
	// agentrunner-213: хеш модели после записи approve визы 1 - исполнение визы
	// механизмом «БИТ» может переписать модель; этап 2 сравнивает с ним.
	Если Проверки.КодРешения = "approve" И Проверки.Этап = 1 И ИтогЗаписи = "записано" Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'model_hash_after: %1'"),
			ХешМоделейЗаявки(МодельСтало, ДанныеЗаявки.Подчиненные)));
	КонецЕсли;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Итог записи: %1'"), ИтогЗаписи));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Комментарий визы: %1'"),
		?(ПустаяСтрока(Проверки.Комментарий), "-", Проверки.Комментарий)));

	// 2.5.5: пункты агента необязательны (agentrunner-88) - протокол решения
	// строит пакет (сверка и проверка данных ниже); protocol_required - пункты
	// переданы, но среди них есть некорректный.
	Части.Добавить("");
	Части.Добавить(НСтр("ru = 'Пункты проверки агента по регламенту (необязательно):'"));
	Если Проверки.Протокол.Количество() = 0 Тогда
		Части.Добавить("- " + ?(Проверки.КодОшибки = "protocol_required",
			НСтр("ru = 'пункты отклонены: есть некорректный пункт (отказ protocol_required)'"),
			НСтр("ru = 'агент дополнительных пунктов не передавал'")));
	Иначе
		Для Каждого ПунктПротокола Из Проверки.Протокол Цикл
			Части.Добавить(СтрокаПунктаПротокола(ПунктПротокола));
		КонецЦикла;
	КонецЕсли;

	// agentrunner-88: итог повторной сверки пакета (для handover сверка не
	// выполняется - раздел пропускается).
	Если Проверки.Сверка <> Неопределено Тогда
		Части.Добавить("");
		Части.Добавить(НСтр("ru = 'Сверка с вложениями (повторная, пакет):'"));
		ДополнитьПротоколСверкой(Части, Проверки, Контекст);
	КонецЕсли;

	Части.Добавить("");
	Части.Добавить(СтрШаблон(
		НСтр("ru = 'Проверка данных заявки (обработка %1):'"),
		ИмяОбработкиПроверкиДанных()));
	Части.Добавить(ТекстПроверкиДанныхПротокола(Проверки));

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Раздел «Сверка с вложениями» протокола (п. 5 спеки): вердикт, файлы,
// расхождения, «Монополист», замечания, дозаполнение (из действий запуска),
// ЕГР, review агента.
//
// Параметры:
//  Части    - Массив    - пополняемые строки протокола.
//  Проверки - Структура - результат ПроверкиПередРешением (Сверка, Review).
//  Контекст - Структура - контекст запуска (RunId - дозаполнение).
//
Процедура ДополнитьПротоколСверкой(Знач Части, Знач Проверки, Знач Контекст)

	Сверка = Проверки.Сверка;

	Части.Добавить(СтрШаблон(НСтр("ru = 'Итог сверки: %1'"), Сверка.Вердикт));

	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Части.Добавить(СтрШаблон(НСтр("ru = '- файл «%1»: %2, сдан: %3'"),
			СтатусФайла.ИмяФайла, СтатусФайла.Код,
			?(ФайлСданПолностью(СтатусФайла, Проверки.КонтекстСверки), "да", "нет")));
	КонецЦикла;

	Для Каждого Расхождение Из Сверка.Расхождения Цикл
		Части.Добавить(СтрШаблон(
			НСтр("ru = '- расхождение, %1: в заявке «%2», в файле «%3» (%4)'"),
			Расхождение.field, Расхождение.in_request, Расхождение.in_file,
			Расхождение.file));
	КонецЦикла;

	Части.Добавить(СтрШаблон(
		НСтр("ru = 'Монополист: требуется %1, подтверждён %2 (%3)'"),
		?(Сверка.Монополист.required, "да", "нет"),
		?(Сверка.Монополист.confirmed, "да", "нет"),
		?(ПустаяСтрока(Сверка.Монополист.file), "-", Сверка.Монополист.file)));

	Для Каждого Замечание Из Сверка.Замечания Цикл
		Части.Добавить(СтрШаблон(НСтр("ru = '- [%1] %2'"),
			Строка(Замечание.code), Строка(Замечание.text)));
	КонецЦикла;

	// Дозаполнение - из ответов nsi_submit_file_data этого запуска.
	ЗаполненныеПоля = ДозаполненныеПоляИзДействий(RunIdИзКонтекста(Контекст));
	Если ЗаполненныеПоля.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Дозаполнено автоматически:'"));
		Для Каждого Заполненное Из ЗаполненныеПоля Цикл
			Части.Добавить(СтрШаблон(НСтр("ru = '- %1 = %2 (%3; цитата: %4)'"),
				Заполненное.Получить("field"), Заполненное.Получить("value"),
				Заполненное.Получить("file"), Заполненное.Получить("fragment")));
		КонецЦикла;
	КонецЕсли;

	// Официальные данные ЕГР (п. 5 спеки).
	Если Сверка.Официальные <> Неопределено Тогда
		ТекстОфициальных = СтрШаблон(НСтр("ru = 'ЕГРЮЛ/ЕГРИП: %1'"),
			Строка(Сверка.Официальные.result));
		Если Сверка.Официальные.remarks.Количество() > 0 Тогда
			ТекстОфициальных = ТекстОфициальных + Символы.ПС + "  "
				+ СтрСоединить(Сверка.Официальные.remarks, Символы.ПС + "  ");
		КонецЕсли;
		Части.Добавить(ТекстОфициальных);
	КонецЕсли;

	// Пункты review агента (п. 5 спеки).
	Если Проверки.Review.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Review агента (needs_review):'"));
		Для Каждого Пункт Из Проверки.Review Цикл
			Части.Добавить(СтрШаблон(НСтр("ru = '- %1: %2 %3'"),
				Строка(Пункт.Получить("id")),
				Строка(Пункт.Получить("result")),
				Строка(Пункт.Получить("text"))));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Дозаполненные поля из ответов nsi_submit_file_data этого запуска
// (ключ filled; вызовы dry_run диспетчер записывает с суффиксом - не
// попадают).
//
// Возвращаемое значение:
//  Массив из Соответствие {field, value, file, fragment}.
//
Функция ДозаполненныеПоляИзДействий(Знач RunId)

	Заполненные = Новый Массив;

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(RunId, "nsi_submit_file_data") Цикл
		Ответ = JSONИзДействия(Действие.ОтветИнструмента);
		Если Ответ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		FilledJSON = Ответ.Получить("filled");
		Если ТипЗнч(FilledJSON) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ПолеJSON Из FilledJSON Цикл
			Если ТипЗнч(ПолеJSON) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Поле = Новый Соответствие;
			Поле.Вставить("field", Строка(ПолеJSON.Получить("field")));
			Поле.Вставить("value", Строка(ПолеJSON.Получить("value")));
			Поле.Вставить("file", Строка(ПолеJSON.Получить("file")));
			Поле.Вставить("fragment", Строка(ПолеJSON.Получить("fragment")));
			Заполненные.Добавить(Поле);
		КонецЦикла;
	КонецЦикла;

	Возврат Заполненные;

КонецФункции

// Строка одного пункта протокола модели: "<item>. <check> - <result>
// [значение в заявке / источник; источник]".
//
// Параметры:
//  ПунктПротокола - Соответствие - элемент массива protocol.
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаПунктаПротокола(Знач ПунктПротокола)

	Строка = СтрШаблон("%1. %2 - %3",
		Строка(ПунктПротокола.Получить("item")),
		Строка(ПунктПротокола.Получить("check")),
		Строка(ПунктПротокола.Получить("result")));

	ЗначениеВЗаявке = Строка(ПунктПротокола.Получить("request_value"));
	ЗначениеВИсточнике = Строка(ПунктПротокола.Получить("source_value"));
	Источник = Строка(ПунктПротокола.Получить("source"));

	Дополнение = "";
	Если Не ПустаяСтрока(ЗначениеВЗаявке) Тогда
		Дополнение = " (в заявке: " + ЗначениеВЗаявке + ")";
	КонецЕсли;
	Если Не ПустаяСтрока(ЗначениеВИсточнике) Тогда
		Дополнение = Дополнение + " (в источнике: " + ЗначениеВИсточнике + ")";
	КонецЕсли;
	Если Не ПустаяСтрока(Источник) Тогда
		Дополнение = Дополнение + " [" + Источник + "]";
	КонецЕсли;

	Возврат "- " + Строка + Дополнение;

КонецФункции

// Раздел «Проверка данных заявки» файла протокола (agentrunner-87): итог,
// сводка summary, замечания remarks и текст remarks_text из результата
// обработки. Результат берется из Проверки.ПроверкаДанных (approve проверял
// заявку при защите approve), иначе обработка вызывается здесь - один вызов
// на решение.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//             ПроверкаДанных).
//
// Возвращаемое значение:
//  Строка - раздел протокола (несколько строк).
//
Функция ТекстПроверкиДанныхПротокола(Знач Проверки)

	ПроверкаДанных = Проверки.ПроверкаДанных;
	Если ПроверкаДанных = Неопределено Тогда
		ПроверкаДанных = РезультатПроверкиОбработкой(Проверки.СсылкаЗаявки);
	КонецЕсли;

	Если ПроверкаДанных.КодОшибки <> "" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Итог: ошибка: %1 %2'"),
			ПроверкаДанных.КодОшибки, ПроверкаДанных.Сообщение);
	КонецЕсли;

	Данные = ПроверкаДанных.Данные;

	Строки = Новый Массив;
	Если ЗначениеБулево(Данные.Получить("checked")) Тогда
		Итог = ?(ЗначениеБулево(Данные.Получить("all_checks_passed")),
			НСтр("ru = 'все проверки пройдены'"),
			НСтр("ru = 'есть замечания'"));
	Иначе
		Итог = СтрШаблон(НСтр("ru = 'проверка не выполнялась: %1'"),
			Строка(Данные.Получить("reason")));
	КонецЕсли;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Итог: %1'"), Итог));

	Строки.Добавить(СтрокаСводкиПроверкиДанных(Данные));

	Для Каждого СтрокаЗамечания Из СтрокиЗамечанийПроверкиДанных(Данные) Цикл
		Строки.Добавить(СтрокаЗамечания);
	КонецЦикла;

	ТекстЗамечаний = Строка(Данные.Получить("remarks_text"));
	Если НЕ ПустаяСтрока(ТекстЗамечаний) Тогда
		Строки.Добавить("");
		Строки.Добавить(ТекстЗамечаний);
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строка сводки summary проверки данных для протокола: пройдено / не пройдено /
// ошибок / не применимо (agentrunner-87).
//
// Параметры:
//  Данные - Соответствие - разобранный JSON обработки.
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаСводкиПроверкиДанных(Знач Данные)

	Сводка = Данные.Получить("summary");
	Если ТипЗнч(Сводка) <> Тип("Соответствие") Тогда
		Возврат НСтр("ru = 'Сводка: обработка сводку не вернула.'");
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Сводка: пройдено %1, не пройдено %2, ошибок %3, не применимо %4'"),
		ЗначениеПроверкиСтрокой(Сводка.Получить("passed")),
		ЗначениеПроверкиСтрокой(Сводка.Получить("failed")),
		ЗначениеПроверкиСтрокой(Сводка.Получить("errors")),
		ЗначениеПроверкиСтрокой(Сводка.Получить("not_applicable")));

КонецФункции

// Строки замечаний проверки данных для протокола: "- <code> <name> [<status>]:
// <message> (в заявке: <value_in_request> / в базе: <value_in_base>)"
// (agentrunner-87).
//
// Параметры:
//  Данные - Соответствие - разобранный JSON обработки.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция СтрокиЗамечанийПроверкиДанных(Знач Данные)

	Строки = Новый Массив;
	Замечания = Данные.Получить("remarks");
	Если ТипЗнч(Замечания) <> Тип("Массив") Тогда
		Возврат Строки;
	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		Если ТипЗнч(Замечание) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(СтрШаблон(
			НСтр("ru = '- %1 %2 [%3]: %4 (в заявке: %5 / в базе: %6)'"),
			Строка(Замечание.Получить("code")),
			Строка(Замечание.Получить("name")),
			Строка(Замечание.Получить("status")),
			ЗначениеПроверкиСтрокой(Замечание.Получить("message")),
			ЗначениеПроверкиСтрокой(Замечание.Получить("value_in_request")),
			ЗначениеПроверкиСтрокой(Замечание.Получить("value_in_base"))));
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Значение из разобранного JSON строкой для протокола проверки данных;
// Неопределено (null) - прочерк (agentrunner-87).
//
// Параметры:
//  Значение - Произвольный - значение из разобранного JSON обработки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеПроверкиСтрокой(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Блок протокола в текстовый файл заявки (п. 2.2 спеки, 2.5.1): у заявки один
// файл протокола на имя - новый блок с заголовком «===== дата время =====»
// дописывается в конец файла; файла нет - создается (UTF-8 без BOM, владелец -
// заявка, автор - пользователь агента). Текст файла сразу передается БСП как
// извлеченный (статус «Извлечен»): протокол не ждет распознавания и не
// удерживает заявку в очереди агента. Запись привилегированная (по образцу
// ЗаписатьКомментарийВизыПривилегированно). Дописать не удалось (файл занят,
// не читается, внешняя транзакция) - блок пишется новым файлом с тем же именем.
//
// Параметры:
//  СсылкаЗаявки       - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ИмяФайла           - Строка    - имя без расширения (расширение - txt).
//  ТекстБлока         - Строка    - блок протокола (без заголовка).
//  ПользовательАгента - СправочникСсылка.Пользователи - автор нового файла.
//
// Возвращаемое значение:
//  Структура {Успех - Булево, Ошибка - Строка}.
//
Функция ДописатьФайлПротоколаПривилегированно(Знач СсылкаЗаявки, Знач ИмяФайла,
	Знач ТекстБлока, Знач ПользовательАгента)

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	ТекстБлокаСЗаголовком = ЗаголовокБлокаПротокола() + Символы.ПС + ТекстБлока;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Если НЕ РаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(СсылкаЗаявки) Тогда
			Результат.Ошибка = НСтр("ru = 'К заявке нельзя присоединять файлы
				|(присоединённые файлы отключены для этого вида объектов).'");
		Иначе
			Дописан = Ложь;
			// Во внешней транзакции сбой дописывания испортил бы ее - только новый файл.
			Если НЕ ТранзакцияАктивна() Тогда
				ФайлПротокола = ФайлПротоколаЗаявки(СсылкаЗаявки, ИмяФайла);
				Если ЗначениеЗаполнено(ФайлПротокола) Тогда
					Дописан = ДописатьБлокВФайлПротокола(ФайлПротокола, ТекстБлокаСЗаголовком);
				КонецЕсли;
			КонецЕсли;
			Если НЕ Дописан Тогда
				ДобавитьФайлПротокола(СсылкаЗаявки, ИмяФайла, ТекстБлокаСЗаголовком, ПользовательАгента);
			КонецЕсли;
			Результат.Успех = Истина;
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.Ошибка = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Новый текстовый файл протокола у заявки через БСП
// РаботаСФайлами.ПараметрыДобавленияФайла + ДобавитьФайл; адрес текста
// передается третьим параметром - БСП сразу ставит статус «Извлечен». Данные
// и текст - разные адреса временного хранилища (БСП может освободить адрес
// текста после чтения), оба освобождаются после записи. Вызывается в
// привилегированном режиме, ошибки - исключением.
//
// Параметры:
//  СсылкаЗаявки       - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ИмяФайла           - Строка - имя без расширения (расширение - txt).
//  ТекстФайла         - Строка - содержимое файла.
//  ПользовательАгента - СправочникСсылка.Пользователи - автор файла.
//
Процедура ДобавитьФайлПротокола(Знач СсылкаЗаявки, Знач ИмяФайла, Знач ТекстФайла,
	Знач ПользовательАгента)

	Адреса = АдресаТекстаПротоколаВХранилище(ТекстФайла);

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = СсылкаЗаявки;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайла;
	ПараметрыФайла.РасширениеБезТочки = РасширениеФайлаПротокола();
	Если ЗначениеЗаполнено(ПользовательАгента) Тогда
		ПараметрыФайла.Автор = ПользовательАгента;
	КонецЕсли;

	Попытка
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адреса.Данные, Адреса.Текст);
	Исключение
		ОсвободитьАдресаТекстаПротокола(Адреса);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьАдресаТекстаПротокола(Адреса);

КонецПроцедуры

// Дописывает блок в конец существующего файла протокола
// (ДописатьБлокВФайлПротоколаВТранзакции). Сбой (файл занят, не читается) -
// запись в служебный лог, файл не меняется.
//
// Параметры:
//  ФайлПротокола - СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы - файл протокола.
//  ТекстБлока    - Строка - блок с заголовком.
//
// Возвращаемое значение:
//  Булево - Истина, если блок дописан.
//
Функция ДописатьБлокВФайлПротокола(Знач ФайлПротокола, Знач ТекстБлока)

	Попытка
		ДописатьБлокВФайлПротоколаВТранзакции(ФайлПротокола, ТекстБлока);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстЛога = СтрШаблон("%1: %2", Строка(ФайлПротокола), ТекстОшибки);
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "protocol_append_failed", ТекстЛога, "Предупреждение");
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Транзакция дописывания: исключительная блокировка файла, чтение текста,
// добавление блока, обновление файла через БСП РаботаСФайлами.ОбновитьФайл
// (данные и текст - статус «Извлечен»). Текст не прочитан - исключение
// (прежние блоки не затираются). Ошибки - исключением после отмены транзакции.
//
// Параметры:
//  ФайлПротокола - СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы - файл протокола.
//  ТекстБлока    - Строка - блок с заголовком.
//
Процедура ДописатьБлокВФайлПротоколаВТранзакции(Знач ФайлПротокола, Знач ТекстБлока)

	Адреса = Неопределено;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлПротокола);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		ТекстФайла = ТекстПротоколаФайла(ФайлПротокола);
		Если ПустаяСтрока(ТекстФайла) Тогда
			ВызватьИсключение НСтр("ru = 'Текст файла протокола не прочитан.'");
		КонецЕсли;

		Адреса = АдресаТекстаПротоколаВХранилище(ТекстФайла + Символы.ПС + Символы.ПС + ТекстБлока);
		ИнформацияОФайле = Новый Структура;
		ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", Адреса.Данные);
		ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", Адреса.Текст);
		РаботаСФайлами.ОбновитьФайл(ФайлПротокола, ИнформацияОФайле);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОсвободитьАдресаТекстаПротокола(Адреса);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьАдресаТекстаПротокола(Адреса);

КонецПроцедуры

// Последний (по дате создания) не помеченный на удаление файл протокола
// заявки с данным именем, без хранения версий (ОбновитьФайл БСП - только для
// таких файлов). Запрос без РАЗРЕШЕННЫЕ - вызывается в привилегированном режиме.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//  ИмяФайла     - Строка - имя без расширения.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы, Неопределено - файл не найден.
//
Функция ФайлПротоколаЗаявки(Знач СсылкаЗаявки, Знач ИмяФайла)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", СсылкаЗаявки);
	Запрос.УстановитьПараметр("Имя", ИмяФайла);
	Запрос.УстановитьПараметр("Расширение", РасширениеФайлаПротокола());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Владелец
		|	И НЕ Файлы.ПометкаУдаления
		|	И НЕ Файлы.ХранитьВерсии
		|	И Файлы.Наименование = &Имя
		|	И Файлы.Расширение = &Расширение
		|УПОРЯДОЧИТЬ ПО
		|	Файлы.ДатаСоздания УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Текст протокола - двоичные данные UTF-8 без BOM во временном хранилище по
// двум адресам: данные файла и текст для БСП (статус «Извлечен»).
//
// Параметры:
//  ТекстФайла - Строка.
//
// Возвращаемое значение:
//  Структура {Данные, Текст - Строка} - адреса во временном хранилище.
//
Функция АдресаТекстаПротоколаВХранилище(Знач ТекстФайла)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстФайла, КодировкаТекста.UTF8, Ложь);
	ИдентификаторХранения = Новый УникальныйИдентификатор;

	Адреса = Новый Структура;
	Адреса.Вставить("Данные", ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения));
	Адреса.Вставить("Текст", ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения));
	Возврат Адреса;

КонецФункции

// Освобождает адреса временного хранилища текста протокола (значения, не
// являющиеся адресом, пропускаются).
//
// Параметры:
//  Адреса - Структура, Неопределено - см. АдресаТекстаПротоколаВХранилище.
//
Процедура ОсвободитьАдресаТекстаПротокола(Знач Адреса)

	Если Адреса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Адреса Цикл
		Если ЭтоАдресВременногоХранилища(КлючИЗначение.Значение) Тогда
			УдалитьИзВременногоХранилища(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заголовок блока протокола: разделитель, дата и время записи блока.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗаголовокБлокаПротокола()

	Возврат СтрШаблон("%1 %2 %1", РазделительБлоковПротокола(),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

КонецФункции

// Начало строки-заголовка блока в файле протокола (2.5.1).
Функция РазделительБлоковПротокола()

	Возврат "=====";

КонецФункции

// Расширение файлов протокола (без точки).
Функция РасширениеФайлаПротокола()

	Возврат "txt";

КонецФункции

// Имя файла протокола решений агента по заявке (2.5.1 - одно, без даты).
// Начинается с «Протокол проверки агентом» - так протоколы отличают от файлов
// инициатора (сверка, отметки отложения, ХешИзПротоколаВизы1).
Функция ИмяФайлаПротоколаПроверки()

	Возврат "Протокол проверки агентом";

КонецФункции

// Блок regulation ответа nsi_get_request (п. 4.1 спеки): разделы навыка
// регламента по сценарию заявки. Навык не найден или пуст -
// regulation.error = "skill_not_found", остальной ответ не меняется.
//
// Параметры:
//  Сценарий - Строка - сценарий заявки («вид-резидентность-операция»).
//
// Возвращаемое значение:
//  Структура - {scenario, skill, sections: [{section, title, text}]}
//  либо {scenario, skill, error: "skill_not_found"}.
//
Функция РегламентПоСценарию(Знач Сценарий)

	Регламент = Новый Структура;
	Регламент.Вставить("scenario", Сценарий);
	Регламент.Вставить("skill", ИмяНавыкаРегламента());

	Содержимое = СодержимоеНавыкаРегламента(Регламент.skill);
	Если ПустаяСтрока(Содержимое) Тогда
		Регламент.Вставить("error", "skill_not_found");
		Возврат Регламент;
	КонецЕсли;

	Регламент.Вставить("sections", РазделыНавыка(Содержимое, НомераРазделовСценария(Сценарий)));
	Возврат Регламент;

КонецФункции

// Имя навыка регламента из настройки пакета НСИНавыкРегламента
// (по умолчанию «Регламент проверки контрагента НСИ»).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяНавыкаРегламента()

	ИмяНавыка = ar_Настройки.ЗначениеНастройки("НСИНавыкРегламента",
		"Регламент проверки контрагента НСИ");
	Если ТипЗнч(ИмяНавыка) <> Тип("Строка") Тогда
		ИмяНавыка = Строка(ИмяНавыка);
	КонецЕсли;

	ИмяНавыка = СокрЛП(ИмяНавыка);
	Возврат ?(ПустаяСтрока(ИмяНавыка), "Регламент проверки контрагента НСИ", ИмяНавыка);

КонецФункции

// Содержимое навыка регламента (ar_Навыки) одним запросом: поиск по
// Наименованию (так навык подключает пресет) либо по ar_Имя.
//
// Параметры:
//  ИмяНавыка - Строка - имя из настройки НСИНавыкРегламента.
//
// Возвращаемое значение:
//  Строка - ar_Содержимое навыка; "" - не найден или пуст.
//
Функция СодержимоеНавыкаРегламента(Знач ИмяНавыка)

	// Поиск по Наименованию (так навык подключает пресет) либо по ar_Имя -
	// два запроса пакета без ИЛИ в ГДЕ (стандарт запросов).
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", ИмяНавыка);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Навыки.ar_Содержимое КАК Содержимое
		|ИЗ
		|	Справочник.ar_Навыки КАК Навыки
		|ГДЕ
		|	НЕ Навыки.ПометкаУдаления
		|	И Навыки.Наименование = &Имя
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Навыки.ar_Содержимое КАК Содержимое
		|ИЗ
		|	Справочник.ar_Навыки КАК Навыки
		|ГДЕ
		|	НЕ Навыки.ПометкаУдаления
		|	И Навыки.ar_Имя = &Имя";

	Результаты = Запрос.ВыполнитьПакет();
	Для Каждого Результат Из Результаты Цикл
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Строка(Выборка.Содержимое));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Разбор строки сценария «вид-резидентность(-операция)»: вид и резидентность;
// незаполненные части - пустые строки. Перенесена из области
// ИнструментПроверкаРеквизитов - нужна НомераРазделовСценария (agentrunner-87).
//
// Возвращаемое значение:
//  Структура {Вид, Резидентность}.
//
Функция РазобратьСценарий(Знач Сценарий)

	Разбор = Новый Структура;
	Разбор.Вставить("Вид", "");
	Разбор.Вставить("Резидентность", "");

	Части = СтрРазделить(Сценарий, "-", Истина);
	Если Части.Количество() > 0 Тогда
		Разбор.Вид = НРег(СокрЛП(Части[0]));
	КонецЕсли;
	Если Части.Количество() > 1 Тогда
		Разбор.Резидентность = НРег(СокрЛП(Части[1]));
	КонецЕсли;
	Возврат Разбор;

КонецФункции

// Номера разделов регламента для сценария (п. 4.1 спеки): всегда 0, 1, 11,
// 13, 14, 15, 16; резидент - еще 12; ЮЛ - 2, 3; ИП - 4; ФЛ - 5; нерезидент -
// 6-8; ОП - 9, 3; госорган - 10; сценарий не определен - только 0, 1.
//
// Параметры:
//  Сценарий - Строка - сценарий заявки.
//
// Возвращаемое значение:
//  Соответствие - номер раздела (Строка) -> Истина.
//
Функция НомераРазделовСценария(Знач Сценарий)

	Номера = Новый Соответствие;

	Номера.Вставить("0", Истина);
	Номера.Вставить("1", Истина);

	Разбор = РазобратьСценарий(Сценарий);
	Вид = НРег(Разбор.Вид);
	Резидентность = НРег(Разбор.Резидентность);

	Если ПустаяСтрока(Вид) Или ПустаяСтрока(Резидентность) Тогда
		Возврат Номера; // Сценарий не определён - только 0 и 1.
	КонецЕсли;

	Если Резидентность = "резидент" Тогда
		Номера.Вставить("12", Истина);
	Иначе
		Номера.Вставить("6", Истина);
		Номера.Вставить("7", Истина);
		Номера.Вставить("8", Истина);
	КонецЕсли;

	Если Вид = "юл" Тогда
		Номера.Вставить("2", Истина);
		Номера.Вставить("3", Истина);
	ИначеЕсли Вид = "ип" Тогда
		Номера.Вставить("4", Истина);
	ИначеЕсли Вид = "фл" Тогда
		Номера.Вставить("5", Истина);
	ИначеЕсли Вид = "оп" Тогда
		Номера.Вставить("9", Истина);
		Номера.Вставить("3", Истина);
	ИначеЕсли Вид = "госорган" Тогда
		Номера.Вставить("10", Истина);
	КонецЕсли;

	Номера.Вставить("11", Истина);
	Номера.Вставить("13", Истина);
	Номера.Вставить("14", Истина);
	Номера.Вставить("15", Истина);
	Номера.Вставить("16", Истина);

	Возврат Номера;

КонецФункции

// Разделы навыка регламента по нужным номерам: текст делится по заголовкам
// "## ", номер раздела - число в начале заголовка до первой точки; выдаются
// только разделы из НомераНужных, в числовом порядке номеров.
//
// Параметры:
//  Содержимое   - Строка - текст навыка (разделы по заголовкам "## ").
//  НомераНужных - Соответствие - номер раздела (Строка) -> Истина.
//
// Возвращаемое значение:
//  Массив из Структура {section - Строка, title - Строка, text - Строка}.
//
Функция РазделыНавыка(Знач Содержимое, Знач НомераНужных)

	Разделы = РазобратьРазделыНавыка(Содержимое);

	РазделыОтвета = Новый Массив;
	Для Каждого Номер Из НомераРазделовПоВозрастанию(НомераНужных) Цикл
		Раздел = Разделы.Получить(Номер);
		Если Раздел = Неопределено Тогда
			Продолжить; // Номера карты без раздела в навыке пропускаются.
		КонецЕсли;
		РазделыОтвета.Добавить(Новый Структура("section, title, text",
			Номер, Раздел.Заголовок, Раздел.Текст));
	КонецЦикла;

	Возврат РазделыОтвета;

КонецФункции

// Разбор всех разделов "## <номер>..." текста навыка: номер раздела - число
// в начале заголовка до первой точки; текст - строки до следующего заголовка.
//
// Параметры:
//  Содержимое - Строка - текст навыка.
//
// Возвращаемое значение:
//  Соответствие - номер раздела (Строка) -> Структура {Заголовок, Текст}.
//
Функция РазобратьРазделыНавыка(Знач Содержимое)

	Разделы = Новый Соответствие;

	ТекущийНомер = "";
	ТекущийЗаголовок = "";
	ТекущийТекст = "";

	СтрокиНавыка = СтрРазделить(Содержимое, Символы.ПС, Ложь);
	Для Каждого СтрокаНавыка Из СтрокиНавыка Цикл

		Обрезанная = СокрЛП(СтрокаНавыка);

		Если СтрНачинаетсяС(Обрезанная, "## ") Тогда

			Если Не ПустаяСтрока(ТекущийНомер) Тогда
				Разделы.Вставить(ТекущийНомер, Новый Структура("Заголовок, Текст",
					ТекущийЗаголовок, СокрЛП(ТекущийТекст)));
			КонецЕсли;

			ТекущийЗаголовок = СокрЛП(Сред(Обрезанная, 4));
			ТекущийНомер = НомерРазделаЗаголовка(ТекущийЗаголовок);
			ТекущийТекст = "";

		ИначеЕсли Не ПустаяСтрока(ТекущийНомер) Тогда
			ТекущийТекст = ТекущийТекст + ?(ПустаяСтрока(ТекущийТекст), "", Символы.ПС) + Обрезанная;
		Иначе
			// Текст до первого раздела (шапка навыка) не включается.
		КонецЕсли;

	КонецЦикла;

	Если Не ПустаяСтрока(ТекущийНомер) Тогда
		Разделы.Вставить(ТекущийНомер, Новый Структура("Заголовок, Текст",
			ТекущийЗаголовок, СокрЛП(ТекущийТекст)));
	КонецЕсли;

	Возврат Разделы;

КонецФункции

// Номера разделов из карты нужных, отсортированные по возрастанию числового
// значения (детерминированный порядок ответа).
//
// Параметры:
//  НомераНужных - Соответствие - номер раздела (Строка) -> Истина.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция НомераРазделовПоВозрастанию(Знач НомераНужных)

	НомераОтсортированные = Новый Массив;

	Для Каждого КлючЗначение Из НомераНужных Цикл
		НомерЧислом = СтроковоеЧисло(КлючЗначение.Ключ);
		Позиция = НомераОтсортированные.Количество();
		Для Индекс = 0 По НомераОтсортированные.Количество() - 1 Цикл
			Если НомерЧислом < СтроковоеЧисло(НомераОтсортированные[Индекс]) Тогда
				Позиция = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		НомераОтсортированные.Вставить(Позиция, КлючЗначение.Ключ);
	КонецЦикла;

	Возврат НомераОтсортированные;

КонецФункции

// Номер раздела из заголовка "## 2.2. Смена ИНН...": число до первой точки
// (или всего заголовка, если точки нет); не число - "".
//
// Параметры:
//  ЗаголовокРаздела - Строка - заголовок после "## ".
//
// Возвращаемое значение:
//  Строка - номер раздела либо "".
//
Функция НомерРазделаЗаголовка(Знач ЗаголовокРаздела)

	Часть = ЗаголовокРаздела;
	ПозицияТочки = СтрНайти(Часть, ".");
	Если ПозицияТочки > 0 Тогда
		Часть = Лев(Часть, ПозицияТочки - 1);
	КонецЕсли;

	Часть = СокрЛП(Часть);
	Если СтрДлина(Часть) = 0 Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Часть) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Часть;

КонецФункции

// Число из строки номера раздела (не число - большой отступ для сортировки).
Функция СтроковоеЧисло(Знач Строка)

	Значение = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(Строка));
	Если Значение = Неопределено Тогда
		Возврат 999999;
	КонецЕсли;
	Возврат Значение;

КонецФункции


#КонецОбласти

#Область МоделиИЗначения

// Нормализация значения для JSON-ответа и хеша (спека п. 10): примитивы - как
// есть; ссылки - Структура {presentation, ref}; коллекции - рекурсивно;
// несериализуемые (хранилища, двоичные данные) - строка «<не выводится>».
//
// Параметры:
//  Значение - Произвольный - значение из модели.
//
// Возвращаемое значение:
//  Произвольный - JSON-безопасное значение (Неопределено сериализуется как null).
//
Функция НормализоватьЗначение(Знач Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Копия.Вставить(КлючИЗначение.Ключ, НормализоватьЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда
		Копия = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Копия.Вставить(КлючИЗначение.Ключ, НормализоватьЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Копия = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Копия.Добавить(НормализоватьЗначение(Элемент));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Значение) Тогда
		Возврат ПараПредставлениеИСсылка(Значение);
	КонецЕсли;

	Возврат "<не выводится>";

КонецФункции

// Ссылка в JSON-виде: представление и навигационная ссылка (спека п. 9).
Функция ПараПредставлениеИСсылка(Знач Ссылка)

	Пара = Новый Структура;
	Пара.Вставить("presentation", Строка(Ссылка));
	Пара.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Ссылка));
	Возврат Пара;

КонецФункции

// Представление значения для ответа (поля header, presentation полей): строки
// и числа - как есть, ссылки и прочее - Строка(), Неопределено - null.
Функция ЗначениеВСтрокуДляОтвета(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Совпадают ли нормализованные значения (before/after полей): сравнение через
// ar_JSON - единый критерий для скаляров и пар {presentation, ref}.
Функция ЗначенияСовпадают(Знач Первое, Знач Второе)

	Если Первое = Неопределено И Второе = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Первое = Неопределено Или Второе = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Первое) = ar_JSON.ВЗначениеJSON(Второе);

КонецФункции

// SHA-256 строки в UTF-8 (hex) - прием ar_ИнструментыПакеты.ХешМанифеста:
// ПолучитьДвоичныеДанныеИзСтроки -> ХешированиеДанных -> ПолучитьHexСтроку.
Функция ХешСтрокиSHA256(Знач ИсходнаяСтрока)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, КодировкаТекста.UTF8, Ложь);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти


#Область СверкаФайловЗаявки

// Служебные данные сверки заявки с вложениями (agentrunner-88): заявка,
// модель «стало», ключевые реквизиты, файлы с текстами из кэша и сданные
// моделью части. Строится один раз на вызов инструмента; тяжёлые данные
// (файлы, наши организации, ЕГР) читаются лениво.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура - контекст сверки.
//
Функция КонтекстСверки(Знач СсылкаЗаявки)

	Контекст = Новый Структура;
	Контекст.Вставить("СсылкаЗаявки", СсылкаЗаявки);
	Контекст.Вставить("ДанныеЗаявки", ДанныеЗаявки(СсылкаЗаявки));
	Контекст.Вставить("МодельСтало", Неопределено);
	Контекст.Вставить("ДляСоздания", Ложь);
	Контекст.Вставить("ЭтоФизЛицо", Ложь);
	Контекст.Вставить("Сценарий", "");
	Контекст.Вставить("ХешТекущий", "");
	Контекст.Вставить("ИНН", "");
	Контекст.Вставить("КПП", "");
	Контекст.Вставить("ОГРН", "");
	Контекст.Вставить("НомерСчета", "");
	Контекст.Вставить("БИК", "");
	Контекст.Вставить("СчетВЗаявке", Ложь);
	Контекст.Вставить("Наименование", "");
	Контекст.Вставить("МаркерыФизЛица", Новый Массив);
	Контекст.Вставить("Файлы", Неопределено);
	Контекст.Вставить("ИннНашихОрганизаций", Неопределено);
	Контекст.Вставить("СчетаНашихОрганизаций", Неопределено);
	Контекст.Вставить("СданныеЧасти", Новый Соответствие);
	Контекст.Вставить("ОфициальныеДанные", Неопределено);

	Если Контекст.ДанныеЗаявки.Шапка <> Неопределено Тогда
		МодельСтало = МодельИзХранилища(Контекст.ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
		Контекст.МодельСтало = МодельСтало;
		Контекст.ДляСоздания = (Контекст.ДанныеЗаявки.Шапка.ВидОперации
			= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);
		Контекст.Сценарий = СценарийЗаявки(Контекст.ДанныеЗаявки.Шапка, МодельСтало);
		Контекст.ХешТекущий = ХешМоделейЗаявки(МодельСтало, Контекст.ДанныеЗаявки.Подчиненные);
		ЗаполнитьКлючевыеРеквизитыКонтекста(Контекст);
	КонецЕсли;

	Возврат Контекст;

КонецФункции

// Заполняет ключевые реквизиты контекста сверки из модели «стало»: ИНН, КПП,
// ОГРН (РегистрационныйНомер), банковские реквизиты из дополнительных
// реквизитов (НомерОсновногоБанковскогоСчета, БИКБанка), наименование и маркеры
// физлица (ФИО, паспорт) для относимости файлов.
//
// Параметры:
//  Контекст - Структура - контекст сверки (заполняется).
//
Процедура ЗаполнитьКлючевыеРеквизитыКонтекста(Знач Контекст)

	Модель = Контекст.МодельСтало;
	Контекст.ИНН = НормализованноеЧислоСтроки(ЗначениеМоделиПоИмени(Модель, "ИНН"));
	Контекст.КПП = ЗначениеМоделиСтрокой(Модель, "КПП");
	Контекст.ОГРН = ЗначениеМоделиСтрокой(Модель, "РегистрационныйНомер");

	ВидЛица = ВидЛицаЗаявки(Модель);
	Контекст.ЭтоФизЛицо = (ВидЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);

	ДопРеквизиты = ЗначенияДопРеквизитовМодели(Модель);
	Контекст.НомерСчета = СтрЗаменить(Строка(ДопРеквизиты.Получить("НомерОсновногоБанковскогоСчета")), " ", "");
	Контекст.БИК = НормализованноеЧислоСтроки(ДопРеквизиты.Получить("БИКБанка"));
	Контекст.СчетВЗаявке = (НЕ ПустаяСтрока(Контекст.НомерСчета) И НЕ ПустаяСтрока(Контекст.БИК));

	Контекст.Наименование = НормализованныйТекст(ЗначениеМоделиСтрокой(Модель, "Наименование"));
	Контекст.МаркерыФизЛица = МаркерыФизЛица(Модель);

КонецПроцедуры

// Значение реквизита модели строкой (пустая строка для отсутствующего).
Функция ЗначениеМоделиСтрокой(Знач Модель, Знач ИмяРеквизита)

	Значение = ЗначениеМоделиПоИмени(Модель, ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Дополнительные реквизиты модели «стало» по программным именам свойств
// (реквизит Имя ПВХ ДополнительныеРеквизитыИСведения; значение - ТекстоваяСтрока
// либо представление значения; приём обработки проверки).
//
// Параметры:
//  Модель - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> строка значения.
//
Функция ЗначенияДопРеквизитовМодели(Знач Модель)

	Значения = Новый Соответствие;
	Таблица = ТаблицаМоделиТЧ(Модель, "ДополнительныеРеквизиты");
	Если Таблица = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;

	Свойства = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство");
		Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения")
			И ЗначениеЗаполнено(Свойство) Тогда
			Свойства.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;

	Если Свойства.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;

	// Имена всех свойств одним вызовом БСП - не в цикле к базе (стандарт).
	ИменаСвойств = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Свойства, "Имя");
	КодыБанков = КодыБанковДопРеквизитовМодели(Таблица);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство");
		ИмяРеквизита = ИменаСвойств.Получить(Свойство);
		Если ТипЗнч(ИмяРеквизита) <> Тип("Строка") Или ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(ИмяРеквизита, ЗначениеСтрокиДопРеквизитаМодели(СтрокаТаблицы, КодыБанков));
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Таблица модели по имени табличной части; массив строк либо Неопределено.
Функция ТаблицаМоделиТЧ(Знач Модель, Знач ИмяТаблицы)

	ГруппаТЧ = ГруппаМодели(Модель, "ТабличныеЧасти");
	Если ГруппаТЧ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Таблица = ЗначениеИзКоллекцииМодели(ГруппаТЧ, ИмяТаблицы);
	Если ТипЗнч(Таблица) = Тип("Массив") Тогда
		Возврат Таблица;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение строки ТЧ ДополнительныеРеквизиты модели: ТекстоваяСтрока, если
// заполнена; банк (доп. реквизит БИКБанка типа Справочник.Банки) - кодом, то
// есть БИК; иначе представление значения.
//
// Параметры:
//  СтрокаТаблицы - Соответствие, Структура - строка ТЧ модели.
//  КодыБанков    - Соответствие, Неопределено - банк -> код
//                  (КодыБанковДопРеквизитовМодели); Неопределено - код банка
//                  читается из базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеСтрокиДопРеквизитаМодели(Знач СтрокаТаблицы, Знач КодыБанков = Неопределено)

	ТекстоваяСтрока = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "ТекстоваяСтрока");
	Если ТипЗнч(ТекстоваяСтрока) = Тип("Строка") И НЕ ПустаяСтрока(ТекстоваяСтрока) Тогда
		Возврат СокрЛП(ТекстоваяСтрока);
	КонецЕсли;

	Значение = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Значение");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Если КодыБанков = Неопределено Тогда
			КодБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Код");
		Иначе
			КодБанка = КодыБанков.Получить(Значение);
		КонецЕсли;
		Возврат СокрЛП(Строка(КодБанка));
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Коды (БИК) банков, указанных в значениях ТЧ ДополнительныеРеквизиты модели,
// одним вызовом БСП - не в цикле к базе (стандарт).
//
// Параметры:
//  Таблица - Массив - строки ТЧ ДополнительныеРеквизиты модели.
//
// Возвращаемое значение:
//  Соответствие - СправочникСсылка.Банки -> Строка (код).
//
Функция КодыБанковДопРеквизитовМодели(Знач Таблица)

	Банки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Значение = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Значение");
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Банки") И ЗначениеЗаполнено(Значение)
			И Банки.Найти(Значение) = Неопределено Тогда
			Банки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Если Банки.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Банки, "Код");

КонецФункции

// Маркеры физлица для относимости файлов (п. 4 спеки): ФИО из наименования и
// полного наименования (у справочника Контрагенты нет реквизитов Фамилия, Имя,
// Отчество - 2.5.20) через пробелы и слитно, серия и номер паспорта.
//
// Параметры:
//  Модель - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Массив из Строка - маркеры в нормализованном виде.
//
Функция МаркерыФизЛица(Знач Модель)

	Маркеры = Новый Массив;
	Если Модель = Неопределено Тогда
		Возврат Маркеры;
	КонецЕсли;

	ДобавитьМаркерФИО(Маркеры, ЗначениеМоделиСтрокой(Модель, "Наименование"));
	ДобавитьМаркерФИО(Маркеры, ЗначениеМоделиСтрокой(Модель, "НаименованиеПолное"));

	Паспорт = НормализованноеЧислоСтроки(ЗначениеМоделиСтрокой(Модель, "sd_СерияНомерПаспорта"));
	Если ПустаяСтрока(Паспорт) Тогда
		Серия = НормализованноеЧислоСтроки(ЗначениеМоделиСтрокой(Модель, "sd_ДокументСерия"));
		Номер = НормализованноеЧислоСтроки(ЗначениеМоделиСтрокой(Модель, "sd_ДокументНомер"));
		Паспорт = Серия + Номер;
	КонецЕсли;
	Если СтрДлина(Паспорт) >= 8 Тогда
		Маркеры.Добавить(Паспорт);
	КонецЕсли;

	Возврат Маркеры;

КонецФункции

// Добавляет маркеры ФИО (через пробелы и слитно) по наименованию физлица:
// не меньше двух слов, без повторов (2.5.20).
//
// Параметры:
//  Маркеры      - Массив из Строка - маркеры физлица (дополняется).
//  Наименование - Строка           - наименование или полное наименование.
//
Процедура ДобавитьМаркерФИО(Знач Маркеры, Знач Наименование)

	Слова = СтрРазделить(НормализованныйТекст(Наименование), " ", Ложь);
	Если Слова.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	ВариантыФИО = Новый Массив;
	ВариантыФИО.Добавить(СтрСоединить(Слова, " "));
	ВариантыФИО.Добавить(СтрСоединить(Слова, ""));
	Для Каждого Вариант Из ВариантыФИО Цикл
		Если Маркеры.Найти(Вариант) = Неопределено Тогда
			Маркеры.Добавить(Вариант);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Файлы заявки одним запросом (владелец - заявка, без помеченных на удаление),
// с текстом из кэша ТекстХранилище (полным, без усечения - п. 4 спеки). Запрос
// без РАЗРЕШЕННЫЕ: невидимые пользователю файлы не сверяются. Протоколы агента
// (txt «Протокол проверки агентом ...», «Протокол автоактуализации агентом ...»,
// «Протокол ручного исполнения ...»; 2.5.1, agentrunner-252) - не вложения
// инициатора: в сверку и в очередь распознавания не идут.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Массив из Структура {Ссылка, Имя, Расширение, Размер, Статус, Текст,
//  ДатаСоздания, Зашифрован, ПоддерживаетсяРасширение,
//  ДатаМодификацииУниверсальная} - упорядочены по имени.
//
Функция ФайлыЗаявкиДляСверки(Знач СсылкаЗаявки)

	Файлы = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ф.Ссылка КАК Ссылка,
		|	Ф.Наименование КАК Наименование,
		|	Ф.Расширение КАК Расширение,
		|	Ф.Размер КАК Размер,
		|	Ф.СтатусИзвлеченияТекста КАК СтатусИзвлеченияТекста,
		|	Ф.ТекстХранилище КАК ТекстХранилище,
		|	Ф.ДатаСоздания КАК ДатаСоздания,
		|	Ф.Зашифрован КАК Зашифрован,
		|	Ф.ДатаМодификацииУниверсальная КАК ДатаМодификацииУниверсальная
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Ф
		|ГДЕ
		|	Ф.ВладелецФайла = &Владелец
		|	И НЕ Ф.ПометкаУдаления
		|	И НЕ (Ф.Расширение = &РасширениеПротокола
		|			И Ф.Наименование ПОДОБНО ""Протокол проверки агентом%"")
		|	И НЕ (Ф.Расширение = &РасширениеПротокола
		|			И Ф.Наименование ПОДОБНО ""Протокол автоактуализации агентом%"")
		|	И НЕ (Ф.Расширение = &РасширениеПротокола
		|			И Ф.Наименование ПОДОБНО ""Протокол ручного исполнения%"")
		|УПОРЯДОЧИТЬ ПО
		|	Ф.Наименование";
	Запрос.УстановитьПараметр("РасширениеПротокола", РасширениеФайлаПротокола());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Файл = Новый Структура;
		Файл.Вставить("Ссылка", Выборка.Ссылка);
		Файл.Вставить("Имя", СокрЛП(Выборка.Наименование));
		Файл.Вставить("Расширение", НРег(СокрЛП(Выборка.Расширение)));
		Файл.Вставить("Размер", Выборка.Размер);
		Файл.Вставить("Статус", Выборка.СтатусИзвлеченияТекста);
		Файл.Вставить("Текст", ТекстИзХранилищаФайла(Выборка.ТекстХранилище));
		Файл.Вставить("ДатаСоздания", Выборка.ДатаСоздания);
		Файл.Вставить("ДатаМодификацииУниверсальная", Выборка.ДатаМодификацииУниверсальная);
		Файл.Вставить("Зашифрован", Выборка.Зашифрован);
		Файл.Вставить("ПоддерживаетсяРасширение",
			РасширенияРаспознавания().Найти(НРег(СокрЛП(Выборка.Расширение))) <> Неопределено);
		Файлы.Добавить(Файл);
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// Текст файла из кэша ТекстХранилище (Хранилище.Получить -> Строка; приём
// пакета файлов, ТекстИзХранилища).
//
// Возвращаемое значение:
//  Строка - полный текст; пустая строка - текста в кэше нет.
//
Функция ТекстИзХранилищаФайла(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;

	Текст = Хранилище.Получить();
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Ставит файл без текста в очередь распознавания (п. 4.2 спеки): правило
// постановки - единая точка ar_ОчередьРаспознавания.ПоставитьФайл
// (agentrunner-111): живая строка (queued/processing) с тем же отпечатком не
// трогается, атомарно внутри хелпера (раньше - «прочитал-потом-записал» вне
// блокировки). Отпечаток обязателен: пустая ДатаМодификации - хелпер
// отказывает записи (раньше строка писалась с пустым отпечатком и сбрасывалась
// первой же сверкой отпечатка - лишняя переотправка файла).
//
// Параметры:
//  Файл         - Структура - файл из ФайлыЗаявкиДляСверки.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец файла.
//
Процедура ПоставитьФайлВОчередьРаспознавания(Знач Файл, Знач СсылкаЗаявки)

	Данные = ar_ОчередьРаспознавания.НоваяСтрокаОчереди();
	Данные.Файл = ar_Утилиты.НавигационнаяСсылкаОбъекта(Файл.Ссылка);
	Данные.Владелец = ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки);
	Данные.Расширение = Файл.Расширение;
	Данные.Размер = Файл.Размер;
	Данные.ДатаМодификации = Файл.ДатаМодификацииУниверсальная;
	Данные.ПоставленоВ = ТекущаяДатаСеанса();

	Попытка
		ar_ОчередьРаспознавания.ПоставитьФайл(Данные);
	Исключение
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_recognition_queue_failed",
			СтрШаблон("%1: %2", Данные.Файл,
				ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(
					ИнформацияОбОшибке()))),
			"Предупреждение");
	КонецПопытки;

КонецПроцедуры

// Нормализованный текст для сравнения цитат и поиска значений: нижний регистр,
// "е" вместо "ё", кавычки-тире-неразрывные пробелы к одному виду, пробелы
// свёрнуты.
//
// Параметры:
//  Текст - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция НормализованныйТекст(Знач Текст) Экспорт

	Текст = НРег(Текст);
	Текст = СтрЗаменить(Текст, "ё", "е");
	Текст = СтрЗаменить(Текст, "«", """");
	Текст = СтрЗаменить(Текст, "»", """");
	Текст = СтрЗаменить(Текст, "—", "-");
	Текст = СтрЗаменить(Текст, "–", "-");
	Текст = СтрЗаменить(Текст, "−", "-");
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");

	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;

	Возврат СокрЛП(Текст);

КонецФункции

// Последовательности цифр текста: непрерывные цепочки цифр; если
// СлияниеПробелов, цепочки, разделённые одиночными пробелами или тире,
// склеиваются в один токен (номера счетов пишут группами разрядов).
//
// Параметры:
//  Текст           - Строка - нормализованный текст.
//  СлияниеПробелов - Булево - склеивать цифровые группы через пробел/тире.
//
// Возвращаемое значение:
//  Массив из Строка - последовательности цифр.
//
Функция ПоследовательностиЦифр(Знач Текст, Знач СлияниеПробелов) Экспорт

	Токены = Новый Массив;
	Текущий = "";
	ОжидаетсяПродолжение = Ложь;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Текущий = Текущий + Символ;
			ОжидаетсяПродолжение = СлияниеПробелов;
		ИначеЕсли ОжидаетсяПродолжение И (Символ = " " Или Символ = "-") Тогда
			// Разделитель внутри числа - ждём следующую цифру.
			Продолжить;
		Иначе
			ДобавитьТокенЦифр(Токены, Текущий);
			Текущий = "";
			ОжидаетсяПродолжение = Ложь;
		КонецЕсли;
	КонецЦикла;
	ДобавитьТокенЦифр(Токены, Текущий);

	Возврат Токены;

КонецФункции

// Добавляет накопленный токен цифр в массив.
Процедура ДобавитьТокенЦифр(Знач Токены, Знач Токен)

	Если НЕ ПустаяСтрока(Токен) Тогда
		Токены.Добавить(Токен);
	КонецЕсли;

КонецПроцедуры

// Корректные ИНН текста (последовательности из 10 или 12 цифр, прошедшие
// проверку) - основа подсчёта лиц (шаг 8 спеки).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ИннТекста(Знач ТекстНорм) Экспорт

	Инн = Новый Массив;
	Для Каждого Токен Из ПоследовательностиЦифр(ТекстНорм, Ложь) Цикл
		Если (СтрДлина(Токен) = 10 Или СтрДлина(Токен) = 12)
			И ИННКорректен(Токен) И Инн.Найти(Токен) = Неопределено Тогда
			Инн.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Инн;

КонецФункции

// Корректные БИК текста (9 цифр, БИК банка РФ).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция БикТекста(Знач ТекстНорм) Экспорт

	Бики = Новый Массив;
	Для Каждого Токен Из ПоследовательностиЦифр(ТекстНорм, Ложь) Цикл
		Если СтрДлина(Токен) = 9 И БИККорректен(Токен) И Бики.Найти(Токен) = Неопределено Тогда
			Бики.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Бики;

КонецФункции

// Корректные расчётные счета текста (страховка шага 9): последовательности из
// 20 цифр, чей контрольный ключ верен хотя бы с одним БИК - из текста или
// заявки. Без известного БИК счета не признаются корректными.
//
// Параметры:
//  ТекстНорм - Строка           - нормализованный текст файла.
//  ДопБики   - Массив из Строка - дополнительные БИК (заявки), могут отсутствовать.
//
// Возвращаемое значение:
//  Массив из Строка - счета без разделителей.
//
Функция СчетаТекста(Знач ТекстНорм, Знач ДопБики) Экспорт

	Бики = БикТекста(ТекстНорм);
	Для Каждого ДопБик Из ДопБики Цикл
		Если НЕ ПустаяСтрока(ДопБик) И Бики.Найти(ДопБик) = Неопределено Тогда
			Бики.Добавить(ДопБик);
		КонецЕсли;
	КонецЦикла;

	Счета = Новый Массив;
	Если Бики.Количество() = 0 Тогда
		Возврат Счета;
	КонецЕсли;

	Для Каждого Токен Из ПоследовательностиЦифр(ТекстНорм, Истина) Цикл
		Если СтрДлина(Токен) <> 20 Или Счета.Найти(Токен) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Бик Из Бики Цикл
			Если КлючСчетаКорректен(Токен, Бик) Тогда
				Счета.Добавить(Токен);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Счета;

КонецФункции

// ИНН корректен: длина 10 (юридическое лицо) или 12 (предприниматель) и
// контрольные числа (метод БСП
// РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям).
//
// Параметры:
//  ИНН - Строка - последовательность цифр.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИННКорректен(Знач ИНН)

	Если ТипЗнч(ИНН) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	ДлинаИнн = СтрДлина(ИНН);
	Если ДлинаИнн <> 10 И ДлинаИнн <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстОшибки = "";
	Возврат РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(
		ИНН, ДлинаИнн = 10, ТекстОшибки);

КонецФункции

// ОГРН/ОГРНИП корректен: длина 13 (ЮЛ) или 15 (ИП) и контрольное число (метод
// БСП РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям).
//
// Параметры:
//  ОГРН      - Строка - последовательность цифр.
//  ЭтоЮрЛицо - Булево - признак юридического лица; Неопределено - по длине.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОГРНКорректен(Знач ОГРН, Знач ЭтоЮрЛицо = Неопределено)

	Если ЭтоЮрЛицо = Неопределено Тогда
		ЭтоЮрЛицо = (СтрДлина(ОГРН) <> 15);
	КонецЕсли;

	ТекстОшибки = "";
	Возврат РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям(
		ОГРН, ЭтоЮрЛицо, ТекстОшибки);

КонецФункции

// КПП корректен по формату (метод БСП
// РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям).
//
// Возвращаемое значение:
//  Булево.
//
Функция КППКорректен(Знач КПП)

	ТекстОшибки = "";
	Возврат РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(КПП, ТекстОшибки);

КонецФункции

// БИК корректен: 9 цифр, код банка РФ (БанковскиеПравила.ЭтоБИКБанкаРФ).
//
// Возвращаемое значение:
//  Булево.
//
Функция БИККорректен(Знач БИК) Экспорт

	Возврат СтрДлина(БИК) = 9 И БанковскиеПравила.ЭтоБИКБанкаРФ(БИК);

КонецФункции

// Контрольный ключ расчётного счёта верен для БИК
// (БанковскиеПравила.ПроверитьКонтрольныйКлючВНомереБанковскогоСчета, письмо
// ЦБР 515).
//
// Возвращаемое значение:
//  Булево.
//
Функция КлючСчетаКорректен(Знач НомерСчета, Знач БИК) Экспорт

	Возврат БанковскиеПравила.ПроверитьКонтрольныйКлючВНомереБанковскогоСчета(НомерСчета, БИК);

КонецФункции

// ИНН наших организаций (Справочник.Организации) - для исключения их ИНН из
// подсчёта лиц (шаг 8 спеки); кэш в контексте сверки.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//
// Возвращаемое значение:
//  Соответствие - ИНН -> Истина.
//
Функция ИннНашихОрганизаций(Знач Контекст)

	Если Контекст.ИннНашихОрганизаций <> Неопределено Тогда
		Возврат Контекст.ИннНашихОрганизаций;
	КонецЕсли;

	Инн = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.ИНН КАК ИНН
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ИНН <> """"";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Инн.Вставить(НормализованноеЧислоСтроки(Выборка.ИНН), Истина);
	КонецЦикла;

	Контекст.ИннНашихОрганизаций = Инн;
	Возврат Инн;

КонецФункции

// Расчётные счета наших организаций (Справочник.БанковскиеСчета, владелец -
// Справочник.Организации) с БИК банка: в файле одного лица реквизиты нашей
// организации (платёжный документ в её пользу) не сверяются с заявкой
// (agentrunner-277); кэш в контексте сверки.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//
// Возвращаемое значение:
//  Соответствие - номер счёта (цифры) -> БИК банка (цифры, может быть пустым).
//
Функция СчетаНашихОрганизаций(Знач Контекст)

	Если Контекст.СчетаНашихОрганизаций <> Неопределено Тогда
		Возврат Контекст.СчетаНашихОрганизаций;
	КонецЕсли;

	Счета = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Счета.НомерСчета КАК НомерСчета,
		|	ЕСТЬNULL(Банки.Код, """") КАК БИК
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|		ПО Счета.Банк = Банки.Ссылка
		|ГДЕ
		|	Счета.Владелец ССЫЛКА Справочник.Организации
		|	И Счета.НомерСчета <> """"";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета.Вставить(НормализованноеЧислоСтроки(Выборка.НомерСчета),
			НормализованноеЧислоСтроки(Выборка.БИК));
	КонецЦикла;

	Контекст.СчетаНашихОрганизаций = Счета;
	Возврат Счета;

КонецФункции

// Счета и БИК наших организаций среди корректных счетов текста файла.
//
// Параметры:
//  Контекст    - Структура - контекст сверки.
//  СтатусФайла - Структура - статус файла (Счета).
//
// Возвращаемое значение:
//  Структура {Счета, Бики - Массив из Строка}.
//
Функция РеквизитыНашихОрганизацийФайла(Знач Контекст, Знач СтатусФайла)

	Результат = Новый Структура("Счета, Бики", Новый Массив, Новый Массив);
	Если СтатусФайла.Счета.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	СчетаНаших = СчетаНашихОрганизаций(Контекст);
	Для Каждого Счет Из СтатусФайла.Счета Цикл
		БикСчета = СчетаНаших.Получить(Счет);
		Если БикСчета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Счета.Добавить(Счет);
		Если НЕ ПустаяСтрока(БикСчета) И Результат.Бики.Найти(БикСчета) = Неопределено Тогда
			Результат.Бики.Добавить(БикСчета);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значения массива без исключённых (порядок сохраняется).
//
// Параметры:
//  Значения    - Массив из Строка.
//  Исключенные - Массив из Строка.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗначенияБезИсключенных(Знач Значения, Знач Исключенные)

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Исключенные.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключевое значение файла - счёт или БИК нашей организации (не сверяется).
//
// Параметры:
//  ИмяПоля        - Строка    - ключ ключевого поля сверки.
//  Значение       - Строка    - принятое значение файла.
//  РеквизитыНаших - Структура - результат РеквизитыНашихОрганизацийФайла.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоРеквизитНашейОрганизации(Знач ИмяПоля, Знач Значение, Знач РеквизитыНаших)

	Если ИмяПоля = "НомерОсновногоБанковскогоСчета" Тогда
		Возврат РеквизитыНаших.Счета.Найти(НормализованноеЧислоСтроки(Значение)) <> Неопределено;
	ИначеЕсли ИмяПоля = "БИКБанка" Тогда
		Возврат РеквизитыНаших.Бики.Найти(НормализованноеЧислоСтроки(Значение)) <> Неопределено;
	Иначе
		Возврат Ложь; // ИНН, КПП, ОГРН сверяются как прежде.
	КонецЕсли;

КонецФункции

// Относится ли файл к контрагенту заявки (шаг 5 спеки): в тексте есть ИНН
// заявки; для физлица - любой из ФИО, номера паспорта, ИНН, а также счёт заявки
// (2.5.20: цифры счёта в тексте с пробелами, тире и переносами строк); для
// заявки на создание без ИНН - наименование.
//
// Параметры:
//  Контекст  - Структура - контекст сверки.
//  ТекстНорм - Строка    - нормализованный текст файла.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФайлОтносится(Знач Контекст, Знач ТекстНорм) Экспорт

	Если ПустаяСтрока(ТекстНорм) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПустаяСтрока(Контекст.ИНН) И СтрНайти(ТекстНорм, Контекст.ИНН) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если Контекст.ЭтоФизЛицо Тогда
		// ФИО в документе бывает разорвано переносом строки.
		ТекстОднойСтрокой = ТекстБезПереносовСтрок(ТекстНорм);
		Для Каждого Маркер Из Контекст.МаркерыФизЛица Цикл
			Если СтрНайти(ТекстОднойСтрокой, Маркер) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат ТекстСодержитСчетЗаявки(Контекст, ТекстОднойСтрокой);
	КонецЕсли;

	Если Контекст.ДляСоздания И ПустаяСтрока(Контекст.ИНН)
		И НЕ ПустаяСтрока(Контекст.Наименование) Тогда
		Возврат СтрНайти(ТекстНорм, Контекст.Наименование) > 0;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Нормализованный текст, в котором переносы строк заменены пробелами и пробелы
// свёрнуты (2.5.20) - для поиска маркеров физлица.
//
// Параметры:
//  ТекстНорм - Строка - нормализованный текст файла.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстБезПереносовСтрок(Знач ТекстНорм)

	Текст = СтрЗаменить(ТекстНорм, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Есть ли в тексте счёт заявки (2.5.20): 20 цифр счёта среди цифр текста,
// записанных подряд или группами через пробелы и тире («40817 810 0 ...»).
//
// Параметры:
//  Контекст          - Структура - контекст сверки (НомерСчета).
//  ТекстОднойСтрокой - Строка    - текст файла без переносов строк.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТекстСодержитСчетЗаявки(Знач Контекст, Знач ТекстОднойСтрокой)

	НомерСчета = НормализованноеЧислоСтроки(Контекст.НомерСчета);
	Если СтрДлина(НомерСчета) <> 20 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Токен Из ПоследовательностиЦифр(ТекстОднойСтрокой, Истина) Цикл
		Если СтрНайти(Токен, НомерСчета) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Банк по БИК: найден и действует (не помечен на удаление и не отмечен как
// недействующий) - РаботаСБанкамиБП.НайтиБанк.
//
// Параметры:
//  БИК       - Строка - БИК банка.
//  Найден    - Булево - банк найден в справочнике (выходной).
//  Действует - Булево - найден и действует (выходной).
//
// Возвращаемое значение:
//  СправочникСсылка.Банки - пустая ссылка, если не найден.
//
Функция БанкПоБик(Знач БИК, Найден = Ложь, Действует = Ложь)

	Найден = Ложь;
	Действует = Ложь;

	Если НЕ БИККорректен(БИК) Тогда
		Возврат Справочники.Банки.ПустаяСсылка();
	КонецЕсли;

	Банк = РаботаСБанкамиБП.НайтиБанк(БИК);
	Если НЕ ЗначениеЗаполнено(Банк) Тогда
		Возврат Справочники.Банки.ПустаяСсылка();
	КонецЕсли;

	Найден = Истина;
	РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, "ПометкаУдаления, РучноеИзменение");
	Действует = (НЕ РеквизитыБанка.ПометкаУдаления И РеквизитыБанка.РучноеИзменение <> 3);
	Возврат Банк;

КонецФункции

// Служебные реквизиты, не входящие в fields для извлечения и дозаполнения
// (п. 4а.5 спеки): стандартные служебные и сервисные реквизиты контрагента.
//
// Возвращаемое значение:
//  Соответствие - имя реквизита -> Истина.
//
Функция НеСверяемыеРеквизиты()

	Имена = "Код, Ссылка, Предопределенный, ИмяПредопределенныхДанных,"
		+ " Родитель, ЭтоГруппа, Владелец, ПометкаУдаления,"
		+ " бит_мдм_ЗаполнениеЗаявки, бит_мдм_ПризнакРедактирования";

	Список = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Имя)) Тогда
			Список.Вставить(СокрЛП(Имя), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

КонецФункции

// Группы слов признака «Монополист» из настройки НСИСловаМонополиста: слова
// нормализованы; файл подтверждает признак, если в его тексте найдены все слова
// хотя бы одной группы (план 5.5).
//
// Возвращаемое значение:
//  Массив из Массив из Строка - группы слов.
//
Функция ГруппыСловМонополиста()

	Настройка = ar_Настройки.ЗначениеНастройки("НСИСловаМонополиста",
		"реестр,ФАС;естественных монополий;доминирующее положение;тендерный комитет,решение;тендерный комитет,протокол");
	Если ТипЗнч(Настройка) <> Тип("Строка") Тогда
		Настройка = Строка(Настройка);
	КонецЕсли;

	Группы = Новый Массив;
	Для Каждого ЧастьГруппы Из СтрРазделить(Настройка, ";", Ложь) Цикл
		Слова = Новый Массив;
		Для Каждого Слово Из СтрРазделить(ЧастьГруппы, ",", Ложь) Цикл
			НормализованноеСлово = НормализованныйТекст(Слово);
			Если НЕ ПустаяСтрока(НормализованноеСлово) Тогда
				Слова.Добавить(НормализованноеСлово);
			КонецЕсли;
		КонецЦикла;
		Если Слова.Количество() > 0 Тогда
			Группы.Добавить(Слова);
		КонецЕсли;
	КонецЦикла;
	Возврат Группы;

КонецФункции

// Подтверждает ли текст файла признак «Монополист»: 2 - все слова хотя бы
// одной группы (подтверждён), 1 - часть слов какой-то группы (неуверенный
// признак - needs_review), 0 - слов нет.
//
// Параметры:
//  ТекстНорм - Строка - нормализованный текст файла.
//
// Возвращаемое значение:
//  Число - 0, 1 или 2.
//
Функция ТекстПодтверждаетМонополиста(Знач ТекстНорм)

	ЧастьСлов = Ложь;
	Для Каждого Группа Из ГруппыСловМонополиста() Цикл
		НайденоВГруппе = 0;
		Для Каждого Слово Из Группа Цикл
			Если СтрНайти(ТекстНорм, Слово) > 0 Тогда
				НайденоВГруппе = НайденоВГруппе + 1;
			КонецЕсли;
		КонецЦикла;
		Если НайденоВГруппе = Группа.Количество() Тогда
			Возврат 2; // Полная группа - уверенное подтверждение.
		ИначеЕсли НайденоВГруппе > 0 Тогда
			ЧастьСлов = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ЧастьСлов, 1, 0);

КонецФункции

// Имя объекта метаданных ссылочного типа из коллекции «Справочники» или
// «Перечисления». Вид типа - по метаданным методами БСП (ЭтоСправочник,
// ЭтоПеречисление): Строка(Тип) возвращает представление типа (синоним),
// а не «СправочникСсылка.<Имя>».
//
// Параметры:
//  ТипЗначения - Тип - тип из ОписаниеТипов реквизита.
//  ИмяКоллекции - Строка - "Справочники" или "Перечисления".
//
// Возвращаемое значение:
//  Строка - имя объекта метаданных; "" - тип не из этой коллекции.
//
Функция ИмяОбъектаСсылочногоТипа(Знач ТипЗначения, Знач ИмяКоллекции)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ИмяКоллекции = "Справочники" Тогда
		ЭтоВидКоллекции = ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных);
	Иначе
		ЭтоВидКоллекции = ОбщегоНазначения.ЭтоПеречисление(ОбъектМетаданных);
	КонецЕсли;
	Возврат ?(ЭтоВидКоллекции, ОбъектМетаданных.Имя, "");

КонецФункции

// Классификация типа реквизита для fields и проверки значений (п. 4а.5 спеки):
// string/number/date - примитивы, catalog - ссылка на справочник, enum -
// перечисление; булевы, хранилища и прочие типы не поддерживаются ("").
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипов - тип реквизита из метаданных.
//
// Возвращаемое значение:
//  Строка - "string", "number", "date", "catalog", "enum" или "".
//
Функция ТипПоляДляИзвлечения(Знач ОписаниеТипа)

	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		Если ТипЗначения = Тип("Строка") Тогда
			Возврат "string";
		ИначеЕсли ТипЗначения = Тип("Число") Тогда
			Возврат "number";
		ИначеЕсли ТипЗначения = Тип("Дата") Тогда
			Возврат "date";
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		Если ИмяОбъектаСсылочногоТипа(ТипЗначения, "Перечисления") <> "" Тогда
			Возврат "enum";
		ИначеЕсли ИмяОбъектаСсылочногоТипа(ТипЗначения, "Справочники") <> "" Тогда
			Возврат "catalog";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Допустимые значения перечисления для fields (п. 4а.5): представления всех
// значений перечисления по имени типа из ОписаниеТипов.
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипов - тип реквизита, содержащий ПеречислениеСсылка.<X>.
//
// Возвращаемое значение:
//  Массив из Строка; пустой - тип перечисления не определён.
//
Функция ЗначенияПеречисленияПоля(Знач ОписаниеТипа)

	Значения = Новый Массив;
	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		ИмяПеречисления = ИмяОбъектаСсылочногоТипа(ТипЗначения, "Перечисления");
		Если ИмяПеречисления = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЗначениеПеречисления Из Перечисления[ИмяПеречисления] Цикл
			Представление = Строка(ЗначениеПеречисления);
			Если Значения.Найти(Представление) = Неопределено Тогда
				Значения.Добавить(Представление);
			КонецЕсли;
		КонецЦикла;
		Прервать;
	КонецЦикла;
	Возврат Значения;

КонецФункции

#КонецОбласти

#Область СверкаЗначенийФайлов

// Проверка значений, число лиц, сверка ключевых реквизитов, «Монополист»,
// обязательные документы и вердикт (agentrunner-88, п. 4 спеки).

// Ключевые реквизиты сверки (решение человека: только ИНН, КПП, ОГРН, счёт,
// БИК; остальные - только дозаполнение). Имя поля -> реквизит контекста.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> имя реквизита контекста сверки.
//
Функция КлючевыеПоляСверки()

	Поля = Новый Соответствие;
	Поля.Вставить("ИНН", "ИНН");
	Поля.Вставить("КПП", "КПП");
	Поля.Вставить("РегистрационныйНомер", "ОГРН");
	Поля.Вставить("НомерОсновногоБанковскогоСчета", "НомерСчета");
	Поля.Вставить("БИКБанка", "БИК");
	Возврат Поля;

КонецФункции

// Описание поля для извлечения и проверки: тип, синоним, для ссылочных -
// таблица справочника, для дополнительных - ссылка свойства ПВХ.
//
// Параметры:
//  ИмяПоля - Строка - программное имя реквизита ("ИНН", "НомерОсновногоБанковскогоСчета").
//
// Возвращаемое значение:
//  Структура {Тип - Строка, Синоним - Строка, ИмяТаблицы - Строка,
//  ОписаниеТипа - ОписаниеТипов, ДопРеквизит - ПВХ-ссылка, Неопределено} -
//  пустой Тип - поле неизвестно.
//
Функция ОписаниеПоляЗаявки(Знач ИмяПоля)

	Описание = Новый Структура;
	Описание.Вставить("Тип", "");
	Описание.Вставить("Синоним", "");
	Описание.Вставить("ИмяТаблицы", "");
	Описание.Вставить("ОписаниеТипа", Неопределено);
	Описание.Вставить("ДопРеквизит", Неопределено);

	МетаКонтрагенты = Метаданные.Справочники.Контрагенты;
	МетаРеквизит = МетаКонтрагенты.Реквизиты.Найти(ИмяПоля);
	Если МетаРеквизит <> Неопределено Тогда
		Описание.Тип = ТипПоляДляИзвлечения(МетаРеквизит.Тип);
		Если Описание.Тип = "" Тогда
			Возврат Описание;
		КонецЕсли;
		Описание.Синоним = СинонимМетаРеквизита(МетаРеквизит);
		Описание.ОписаниеТипа = МетаРеквизит.Тип;
		Описание.ИмяТаблицы = ИмяТаблицыСправочникаПоля(МетаРеквизит.Тип);
		Возврат Описание;
	КонецЕсли;

	// Стандартный реквизит: у коллекции СтандартныеРеквизиты нет метода Найти,
	// а у ее элементов - свойства Тип, поэтому реквизит ищется перебором,
	// а описание типов восстанавливается по платформенному имени.
	СтандартныйРеквизит = СтандартныйРеквизитПоИмени(МетаКонтрагенты, ИмяПоля);
	Если СтандартныйРеквизит <> Неопределено Тогда
		ОписаниеТипа = ОписаниеТипаСтандартногоРеквизита(ИмяПоля, МетаКонтрагенты.Имя);
		Если ОписаниеТипа <> Неопределено Тогда
			Описание.Тип = ТипПоляДляИзвлечения(ОписаниеТипа);
			Если Описание.Тип <> "" Тогда
				Описание.Синоним = СинонимСтандартногоРеквизита(СтандартныйРеквизит, ИмяПоля);
				Описание.ОписаниеТипа = ОписаниеТипа;
				Описание.ИмяТаблицы = ИмяТаблицыСправочникаПоля(ОписаниеТипа);
			КонецЕсли;
		КонецЕсли;
		Возврат Описание;
	КонецЕсли;

	// Дополнительный реквизит - свойство ПВХ по программному имени.
	Свойство = СвойствоПВХПоИмени(ИмяПоля);
	Если Свойство <> Неопределено Тогда
		Описание.Тип = ТипПоляДляИзвлечения(Свойство.ТипЗначения);
		Если Описание.Тип = "" Тогда
			Возврат Описание;
		КонецЕсли;
		Описание.Синоним = Свойство.Заголовок;
		Описание.ОписаниеТипа = Свойство.ТипЗначения;
		Описание.ИмяТаблицы = ИмяТаблицыСправочникаПоля(Свойство.ТипЗначения);
		Описание.ДопРеквизит = Свойство.Ссылка;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Синоним реквизита метаданных (для fields - синоним, иначе имя).
Функция СинонимМетаРеквизита(Знач МетаРеквизит)

	Синоним = МетаРеквизит.Синоним;
	Возврат ?(ПустаяСтрока(Синоним), МетаРеквизит.Имя, Синоним);

КонецФункции

// Стандартный реквизит справочника по программному имени: у коллекции
// СтандартныеРеквизиты нет метода Найти (в отличие от Реквизиты), поэтому
// поиск перебором (образец - ar_ИнструментыУниверсальный.РазметкаШапкиДокумента).
//
// Параметры:
//  МетаСправочника - ОбъектМетаданных - метаданные справочника.
//  ИмяПоля         - Строка - программное имя стандартного реквизита.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено.
//
Функция СтандартныйРеквизитПоИмени(Знач МетаСправочника, Знач ИмяПоля)

	Для Каждого СтандартныйРеквизит Из МетаСправочника.СтандартныеРеквизиты Цикл
		Если СтандартныйРеквизит.Имя = ИмяПоля Тогда
			Возврат СтандартныйРеквизит;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание типов стандартного реквизита по платформенному имени: у элементов
// СтандартныеРеквизиты свойство Тип недоступно (в коде проекта доступ
// охраняется Попыткой - ar_ИнструментыУниверсальный.ДобавитьСтрокуРеквизитаШапки).
// Набор имен стандартных реквизитов справочника платформенный, типы
// восстанавливаются по смыслу; для имени вне набора - Неопределено.
//
// Параметры:
//  ИмяПоля        - Строка - программное имя стандартного реквизита.
//  ИмяСправочника - Строка - имя справочника для ссылочных реквизитов.
//
// Возвращаемое значение:
//  ОписаниеТипов, Неопределено.
//
Функция ОписаниеТипаСтандартногоРеквизита(Знач ИмяПоля, Знач ИмяСправочника)

	Если ИмяПоля = "Ссылка" Или ИмяПоля = "Родитель" Или ИмяПоля = "Владелец" Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочника);
	ИначеЕсли ИмяПоля = "Наименование" Или ИмяПоля = "Код" Или ИмяПоля = "ИмяПредопределенныхДанных" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	ИначеЕсли ИмяПоля = "ПометкаУдаления" Или ИмяПоля = "Предопределенный" Или ИмяПоля = "ЭтоГруппа" Тогда
		Возврат Новый ОписаниеТипов("Булево");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Синоним стандартного реквизита: свойство Синоним есть не у всех объектов
// метаданных (в коде проекта доступ охраняется Попыткой -
// ar_ИнструментыУниверсальный.СинонимРеквизитаМД), при недоступности - имя.
//
// Параметры:
//  СтандартныйРеквизит - ОбъектМетаданных - стандартный реквизит.
//  ИмяПоля             - Строка - программное имя (запасной синоним).
//
// Возвращаемое значение:
//  Строка - синоним или имя.
//
Функция СинонимСтандартногоРеквизита(Знач СтандартныйРеквизит, Знач ИмяПоля)

	Попытка
		Синоним = СтандартныйРеквизит.Синоним;
	Исключение
		Синоним = "";
	КонецПопытки;
	Возврат ?(ПустаяСтрока(Синоним), ИмяПоля, Синоним);

КонецФункции

// Имя таблицы справочника для ссылочного поля; только когда тип содержит
// ровно один справочник (составные ссылочные поля не дозаполняются).
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипов - тип реквизита из метаданных.
//
// Возвращаемое значение:
//  Строка - имя справочника; "" - справочника нет или их несколько.
//
Функция ИмяТаблицыСправочникаПоля(Знач ОписаниеТипа)

	ИмяТаблицы = "";
	КоличествоСправочников = 0;
	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		ИмяСправочника = ИмяОбъектаСсылочногоТипа(ТипЗначения, "Справочники");
		Если ИмяСправочника <> "" Тогда
			КоличествоСправочников = КоличествоСправочников + 1;
			Если КоличествоСправочников > 1 Тогда
				Возврат "";
			КонецЕсли;
			ИмяТаблицы = ИмяСправочника;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(КоличествоСправочников = 1, ИмяТаблицы, "");

КонецФункции

// Свойство ПВХ ДополнительныеРеквизитыИСведения по программному имени.
//
// Параметры:
//  ИмяПоля - Строка - значение реквизита Имя ПВХ.
//
// Возвращаемое значение:
//  Структура {Ссылка, Заголовок, ТипЗначения} или Неопределено.
//
Функция СвойствоПВХПоИмени(Знач ИмяПоля)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", ИмяПоля);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Свойства.Ссылка КАК Ссылка,
		|	Свойства.Заголовок КАК Заголовок,
		|	Свойства.ТипЗначения КАК ТипЗначения
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ГДЕ
		|	Свойства.Имя = &Имя";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Свойство = Новый Структура;
	Свойство.Вставить("Ссылка", Выборка.Ссылка);
	Свойство.Вставить("Заголовок", Выборка.Заголовок);
	Свойство.Вставить("ТипЗначения", Выборка.ТипЗначения);
	Возврат Свойство;

КонецФункции

// Реквизиты заявки для извлечения данных (п. 4а.5 спеки): шапка «Контрагентов»
// и ДополнительныеРеквизиты; типы строка/число/дата/ссылка на справочник/
// перечисление; булевы и прочие - не входят; служебные исключены.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//
// Возвращаемое значение:
//  Массив из Структура {field, synonym, type, value, empty}; для catalog и enum
//  поле type - структура {ref: "catalog"} / {ref: "enum", values: [...]}.
//
Функция ПоляДляИзвлечения(Знач Контекст)

	Поля = Новый Массив;
	Если Контекст.МодельСтало = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	Исключения = НеСверяемыеРеквизиты();
	ИменаГрупп = Новый Массив;
	ИменаГрупп.Добавить("Реквизиты");
	ИменаГрупп.Добавить("СтандартныеРеквизиты");

	Для Каждого ИмяГруппы Из ИменаГрупп Цикл
		Группа = ГруппаМодели(Контекст.МодельСтало, ИмяГруппы);
		Если Группа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Группа Цикл
			Если Исключения.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Поле = ЭлементПоляДляИзвлечения(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			Если Поле <> Неопределено Тогда
				Поля.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ДополнитьПоляДопРеквизитами(Поля, Контекст);
	Возврат Поля;

КонецФункции

// Один элемент fields по имени и значению реквизита; поле не классифицируется -
// Неопределено.
//
// Параметры:
//  ИмяПоля  - Строка - программное имя реквизита.
//  Значение - Произвольный - значение из модели «стало».
//
// Возвращаемое значение:
//  Структура {field, synonym, type, value, empty} или Неопределено.
//
Функция ЭлементПоляДляИзвлечения(Знач ИмяПоля, Знач Значение)

	Описание = ОписаниеПоляЗаявки(ИмяПоля);
	Если Описание.Тип = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поле = Новый Структура;
	Поле.Вставить("field", ИмяПоля);
	Поле.Вставить("synonym", Описание.Синоним);
	Поле.Вставить("type", ТипПоляДляОтвета(Описание));
	Поле.Вставить("value", ЗначениеПоляДляОтвета(Описание, Значение));
	Поле.Вставить("empty", НЕ ЗначениеЗаполнено(Значение));
	Возврат Поле;

КонецФункции

// Дополняет fields дополнительными реквизитами модели (свойства ПВХ: Имя -
// field, Заголовок - synonym, ТипЗначения - type, значение строки ТЧ - value).
//
// Параметры:
//  Поля     - Массив    - пополняемый список полей.
//  Контекст - Структура - контекст сверки.
//
Процедура ДополнитьПоляДопРеквизитами(Знач Поля, Знач Контекст)

	Таблица = ТаблицаМоделиТЧ(Контекст.МодельСтало, "ДополнительныеРеквизиты");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Свойство = ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство");
		Если ТипЗнч(Свойство) <> Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения")
			Или НЕ ЗначениеЗаполнено(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		РеквизитыСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Свойство, "Имя, Заголовок, ТипЗначения");
		Если ПустаяСтрока(Строка(РеквизитыСвойства.Имя)) Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеТипа = РеквизитыСвойства.ТипЗначения;
		Если ТипПоляДляИзвлечения(ОписаниеТипа) = "" Тогда
			Продолжить;
		КонецЕсли;

		Значение = ЗначениеСтрокиДопРеквизитаМодели(СтрокаТаблицы);
		Поле = Новый Структура;
		Поле.Вставить("field", Строка(РеквизитыСвойства.Имя));
		Поле.Вставить("synonym",
			?(ПустаяСтрока(РеквизитыСвойства.Заголовок), Строка(РеквизитыСвойства.Имя),
				РеквизитыСвойства.Заголовок));
		Если Строка(РеквизитыСвойства.Имя) = "БИКБанка" Тогда
			// БИК сдаётся цифрами из текста, а не наименованием банка (как для
			// ссылочных полей): банк по БИК находит пакет (БикиВСправочнике).
			Поле.Вставить("type", "string");
		Иначе
			Поле.Вставить("type", ТипПоляДляОтветаПоТипуЗначения(ОписаниеТипа));
		КонецЕсли;
		Поле.Вставить("value", Значение);
		Поле.Вставить("empty", ПустаяСтрока(Значение));
		Поля.Добавить(Поле);
	КонецЦикла;

КонецПроцедуры

// type для ответа fields по описанию поля: строка примитива или структура
// {ref: "catalog"} / {ref: "enum", values: [...]}.
//
// Параметры:
//  ОписаниеПоля - Структура - результат ОписаниеПоляЗаявки.
//
// Возвращаемое значение:
//  Строка, Структура.
//
Функция ТипПоляДляОтвета(Знач ОписаниеПоля)

	Если ОписаниеПоля.Тип = "enum" Тогда
		ТипEnum = Новый Структура;
		ТипEnum.Вставить("ref", "enum");
		ТипEnum.Вставить("values", ЗначенияПеречисленияПоля(ОписаниеПоля.ОписаниеТипа));
		Возврат ТипEnum;
	ИначеЕсли ОписаниеПоля.Тип = "catalog" Тогда
		ТипCatalog = Новый Структура;
		ТипCatalog.Вставить("ref", "catalog");
		Возврат ТипCatalog;
	КонецЕсли;
	Возврат ОписаниеПоля.Тип;

КонецФункции

// type для ответа fields по описанию типов ПВХ (свойства дополнительного
// реквизита).
Функция ТипПоляДляОтветаПоТипуЗначения(Знач ОписаниеТипа)

	ВидПоля = ТипПоляДляИзвлечения(ОписаниеТипа);
	Если ВидПоля = "enum" Тогда
		ТипEnum = Новый Структура;
		ТипEnum.Вставить("ref", "enum");
		ТипEnum.Вставить("values", ЗначенияПеречисленияПоля(ОписаниеТипа));
		Возврат ТипEnum;
	ИначеЕсли ВидПоля = "catalog" Тогда
		ТипCatalog = Новый Структура;
		ТипCatalog.Вставить("ref", "catalog");
		Возврат ТипCatalog;
	КонецЕсли;
	Возврат ВидПоля;

КонецФункции

// Значение поля для ответа fields: строка/число/дата - как есть; ссылка -
// представлением (наименованием, п. 4а.5); перечисление - представлением.
Функция ЗначениеПоляДляОтвета(Знач ОписаниеПоля, Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ОписаниеПоля.Тип = "string" Или ОписаниеПоля.Тип = "number"
		Или ОписаниеПоля.Тип = "date" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Статус и данные одного файла сверки: текст, относимость, число лиц,
// последовательности ключевых чисел (страховка).
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Файл     - Структура - файл из ФайлыЗаявкиДляСверки.
//
// Возвращаемое значение:
//  Структура {Код - pending|unreadable|too_large|not_related|relevant_single|
//  relevant_multi, ОжидаетРаспознавание - Булево, ТекстНорм, Инн, Бики, Счета,
//  ДругиеЛица - Массив, НашЛицоВТексте - Булево, ДоВозврата - Булево}. У
//  not_related заполнены только Счета и ДругиеЛица (ИНН других организаций -
//  ЧужиеИннТекста). ДоВозврата заполняет ВычислитьСверкуЗаявки (2.5.17).
//
Функция СтатусФайлаСверки(Знач Контекст, Знач Файл) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", Файл.Имя);
	Результат.Вставить("Код", "unreadable");
	Результат.Вставить("ДоВозврата", Ложь);
	Результат.Вставить("ОжидаетРаспознавание", Ложь);
	Результат.Вставить("ТекстНорм", "");
	Результат.Вставить("Инн", Новый Массив);
	Результат.Вставить("Бики", Новый Массив);
	Результат.Вставить("Счета", Новый Массив);
	Результат.Вставить("ДругиеЛица", Новый Массив);
	Результат.Вставить("НашЛицоВТексте", Ложь);

	Если ПустаяСтрока(Файл.Текст) Тогда
		// Файл без текста: молодой поддерживаемый файл - ждёт распознавание
		// (п. 4.1), прочие - нечитаемые (п. 4.3).
		Молодой = (Файл.ДатаСоздания > ГраницаОжиданияРаспознавания());
		Если Файл.Статус = Перечисления.СтатусыИзвлеченияТекстаФайлов.НеИзвлечен
			И Молодой И НЕ Файл.Зашифрован И Файл.ПоддерживаетсяРасширение Тогда
			Результат.Код = "pending";
			Результат.ОжидаетРаспознавание = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(Файл.Текст) > ПределТекстаФайлаСимволов() Тогда
		Результат.Код = "too_large";
		Возврат Результат;
	КонецЕсли;

	ТекстНорм = НормализованныйТекст(Файл.Текст);
	Результат.ТекстНорм = ТекстНорм;

	ДопБики = Новый Массив;
	ДопБики.Добавить(Контекст.БИК);

	Если НЕ ФайлОтносится(Контекст, ТекстНорм) Тогда
		Результат.Код = "not_related";
		// 2.4.4: чужой файл - ИНН других организаций и счета текста (замечание
		// о файле другой организации и о счёте заявки в чужом файле).
		Результат.Счета = СчетаТекста(ТекстНорм, ДопБики);
		Результат.ДругиеЛица = ЧужиеИннТекста(Контекст, ТекстНорм);
		Возврат Результат;
	КонецЕсли;

	Результат.Инн = ИннТекста(ТекстНорм);
	Результат.Бики = БикТекста(ТекстНорм);
	Результат.Счета = СчетаТекста(ТекстНорм, ДопБики);

	ЧислоЛиц = ЛицаФайлаПоТексту(Контекст, Результат);
	Результат.НашЛицоВТексте = ЧислоЛиц.НашЛицо;
	Результат.ДругиеЛица = ЧислоЛиц.ДругиеЛица;
	Результат.Код = ?(ЧислоЛиц.ДругиеЛица.Количество() > 0, "relevant_multi", "relevant_single");

	Возврат Результат;

КонецФункции

// Число лиц в файле (шаг 8 спеки): корректные ИНН текста, кроме ИНН заявки,
// ИНН наших организаций и контрагента, о котором сказала модель; ИНН с ролью
// «банк» исключается только при корректном БИК рядом; ИНН без роли - другое
// лицо.
//
// Параметры:
//  Контекст    - Структура - контекст сверки (СданныеЧасти - роли от модели).
//  СтатусФайла - Структура - результат СтатусФайлаСверки (Инн, ТекстНорм).
//
// Возвращаемое значение:
//  Структура {НашЛицо - Булево, ДругиеЛица - Массив из Строка (ИНН)}.
//
Функция ЛицаФайлаПоТексту(Знач Контекст, Знач СтатусФайла)

	Результат = Новый Структура;
	Результат.Вставить("НашЛицо", Ложь);
	Результат.Вставить("ДругиеЛица", Новый Массив);

	НашиОрганизации = ИннНашихОрганизаций(Контекст);
	РолиПоИнн = РолиЛицИзСданныхЧастей(Контекст, СтатусФайла.ИмяФайла);
	ПозицииБиков = ПозицииБиковВТексте(СтатусФайла.ТекстНорм, СтатусФайла.Бики);

	Для Каждого Инн Из СтатусФайла.Инн Цикл

		Роль = РолиПоИнн.Получить(Инн);
		Если Роль = Неопределено Тогда
			Роль = "";
		КонецЕсли;

		Если Инн = Контекст.ИНН Тогда
			// ИНН заявки - сам контрагент.
			Результат.НашЛицо = Истина;
			Продолжить;
		КонецЕсли;

		Если НашиОрганизации.Получить(Инн) <> Неопределено Тогда
			Продолжить; // Наша организация - не лицо проверки.
		КонецЕсли;

		Если Роль = "counterparty" Тогда
			// Модель отнесла ИНН к нашему контрагенту (создание без ИНН заявки).
			Результат.НашЛицо = Истина;
			Продолжить;
		КонецЕсли;

		// Роль "our_org" число лиц не уменьшает (как банк - без БИК рядом):
		// ИНН наших организаций уже исключён выше по справочнику, чужой ИНН
		// с этой ролью - другое лицо.

		Если Роль = "bank" И БикРядомСИнн(СтатусФайла.ТекстНорм, Инн, ПозицииБиков) Тогда
			Продолжить; // Банк: ИНН рядом с его БИК.
		КонецЕсли;

		// Роль "other", роль банка без БИК рядом, чужая "our_org" или ИНН без роли.
		Если Результат.ДругиеЛица.Найти(Инн) = Неопределено Тогда
			Результат.ДругиеЛица.Добавить(Инн);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// ИНН других организаций в тексте файла, не относящегося к заявке (2.4.4):
// корректные ИНН текста, кроме ИНН наших организаций и ИНН банка (перед ИНН
// в пределах ОкноПодписиИННБанкаСимволов есть слово «банк» - «ИНН банка»).
// Ролей от модели у такого файла нет - части чужого файла не принимаются.
//
// Параметры:
//  Контекст  - Структура - контекст сверки.
//  ТекстНорм - Строка    - нормализованный текст файла.
//
// Возвращаемое значение:
//  Массив из Строка - ИНН других организаций в порядке появления в тексте.
//
Функция ЧужиеИннТекста(Знач Контекст, Знач ТекстНорм) Экспорт

	Чужие = Новый Массив;
	НашиОрганизации = ИннНашихОрганизаций(Контекст);
	Для Каждого Инн Из ИннТекста(ТекстНорм) Цикл
		Если Инн = Контекст.ИНН Или НашиОрганизации.Получить(Инн) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоИннБанкаПоПодписи(ТекстНорм, Инн) Тогда
			Продолжить;
		КонецЕсли;
		Чужие.Добавить(Инн);
	КонецЦикла;
	Возврат Чужие;

КонецФункции

// ИНН подписан как ИНН банка: в окне перед первым вхождением ИНН есть «банк».
Функция ЭтоИннБанкаПоПодписи(Знач ТекстНорм, Знач Инн)

	ПозицияИнн = СтрНайти(ТекстНорм, Инн);
	Если ПозицияИнн = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Начало = Макс(1, ПозицияИнн - ОкноПодписиИННБанкаСимволов());
	Подпись = Сред(ТекстНорм, Начало, ПозицияИнн - Начало);
	Возврат СтрНайти(Подпись, "банк") > 0;

КонецФункции

// Окно подписи перед ИНН банка («ИНН банка: », «ИНН Банка получателя »).
Функция ОкноПодписиИННБанкаСимволов()

	Возврат 25;

КонецФункции

// Роли лиц, сказанные моделью в сданных частях файла: ИНН -> роль (последняя
// сдача части заменяет прежнюю).
//
// Параметры:
//  Контекст - Структура - контекст сверки (СданныеЧасти).
//  ИмяФайла - Строка    - имя файла, части которого рассматриваются.
//
// Возвращаемое значение:
//  Соответствие - ИНН -> роль.
//
Функция РолиЛицИзСданныхЧастей(Знач Контекст, Знач ИмяФайла)

	Роли = Новый Соответствие;
	Для Каждого КлючИЗначение Из Контекст.СданныеЧасти Цикл
		Часть = КлючИЗначение.Значение;
		Если Часть.ИмяФайла <> ИмяФайла Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Лицо Из Часть.Лица Цикл
			Инн = НормализованноеЧислоСтроки(Строка(Лицо.Инн));
			Если НЕ ПустаяСтрока(Инн) Тогда
				Роли.Вставить(Инн, Строка(Лицо.Роль));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Роли;

КонецФункции

// Позиции первого вхождения каждого БИК в нормализованном тексте.
//
// Возвращаемое значение:
//  Соответствие - БИК -> позиция (0 - не найден).
//
Функция ПозицииБиковВТексте(Знач ТекстНорм, Знач Бики)

	Позиции = Новый Соответствие;
	Для Каждого Бик Из Бики Цикл
		Позиции.Вставить(Бик, СтрНайти(ТекстНорм, Бик));
	КонецЦикла;
	Возврат Позиции;

КонецФункции

// Есть ли корректный БИК в пределах РасстояниеБИКБанкаСимволов от ИНН
// (п. 4 шаг 8 спеки): без БИК рядом модель не может «сделать» лицо банком.
Функция БикРядомСИнн(Знач ТекстНорм, Знач Инн, Знач ПозицииБиков)

	ПозицияИнн = СтрНайти(ТекстНорм, Инн);
	Если ПозицияИнн = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ПозицияБика Из ПозицииБиков Цикл
		Если ПозицияБика.Значение > 0
			И МодульРазницы(ПозицияБика.Значение, ПозицияИнн) <= РасстояниеБИКБанкаСимволов() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Модуль разности чисел.
Функция МодульРазницы(Знач Первое, Знач Второе)

	Возврат Макс(Первое, Второе) - Мин(Первое, Второе);

КонецФункции

// Сданные части одного файла из контекста: массив структур частей.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  ИмяФайла - Строка - имя файла.
//
// Возвращаемое значение:
//  Массив из Структура {Номер, Лица, Значения} - в порядке номеров.
//
Функция СданныеЧастиФайла(Знач Контекст, Знач ИмяФайла)

	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Контекст.СданныеЧасти Цикл
		Если КлючИЗначение.Значение.ИмяФайла = ИмяФайла Тогда
			Части.Добавить(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции

// Проверка значений одной сдаваемой части (шаг 7 спеки): цитата дословно в
// тексте файла, значение в цитате (кроме перечислений), тип приводится,
// контрольные числа и справочники. Ссылочный поиск выполняется одним пакетным
// запросом на все ссылочные значения вызова - см. ПроверитьЗначенияЧасти.
//
// Параметры:
//  Контекст  - Структура - контекст сверки.
//  ТекстНорм - Строка    - нормализованный текст файла части.
//  Значения  - Массив    - {field, value, fragment} от модели.
//
// Возвращаемое значение:
//  Массив из Структура {Поле, Значение, Цитата, Принято, Приведенное, Причина,
//  Кандидаты - Массив}.
//
Функция ПроверитьЗначенияЧасти(Знач Контекст, Знач ТекстНорм, Знач Значения)

	Проверенные = Новый Массив;

	// Ссылочные значения вызова - один пакетный запрос (п. 4б спеки).
	ЗадачиПоиска = Новый Массив;
	Для Каждого ЗначениеМодели Из Значения Цикл
		Поле = Строка(ЗначениеМодели.Получить("field"));
		Описание = ОписаниеПоляЗаявки(Поле);
		Если Описание.Тип = "catalog" И Поле <> "БИКБанка" Тогда
			ЗадачаПоиска = Новый Структура;
			ЗадачаПоиска.Вставить("ИмяТаблицы", Описание.ИмяТаблицы);
			ЗадачаПоиска.Вставить("Значение", Строка(ЗначениеМодели.Получить("value")));
			ЗадачиПоиска.Добавить(ЗадачаПоиска);
		КонецЕсли;
	КонецЦикла;
	РезультатыПоиска = НайтиСсылкиПоНаименованиям(ЗадачиПоиска);

	// Шаг 7: БИК - справочник банков, счёт - ключ по БИК. БИК значений вызова
	// сверяются со справочником одним запросом; ключ счёта - по БИК заявки либо
	// БИК из той же сдачи.
	БикиПоля = БикиЗначенийЧасти(Значения);
	БикиВСправочнике = БикиВСправочнике(БикиПоля);

	Для Каждого ЗначениеМодели Из Значения Цикл

		Итог = Новый Структура;
		Итог.Вставить("Поле", Строка(ЗначениеМодели.Получить("field")));
		Итог.Вставить("Значение", Строка(ЗначениеМодели.Получить("value")));
		Итог.Вставить("Цитата", Строка(ЗначениеМодели.Получить("fragment")));
		Итог.Вставить("Принято", Ложь);
		Итог.Вставить("Приведенное", Неопределено);
		Итог.Вставить("Причина", "");
		Итог.Вставить("Кандидаты", Новый Массив);

		Причина = ОтказПроверкиЗначения(Контекст, ТекстНорм, ЗначениеМодели, РезультатыПоиска,
			БикиВСправочнике, БикиПоля, Итог);
		Итог.Причина = Причина;
		Итог.Принято = ПустаяСтрока(Причина);
		Проверенные.Добавить(Итог);

	КонецЦикла;

	Возврат Проверенные;

КонецФункции

// БИК значений части (поле БИКБанка, только цифры) без дублей - для проверки
// по справочнику банков и контрольного ключа счёта.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция БикиЗначенийЧасти(Знач Значения)

	Бики = Новый Массив;
	Для Каждого ЗначениеМодели Из Значения Цикл
		Если Строка(ЗначениеМодели.Получить("field")) <> "БИКБанка" Тогда
			Продолжить;
		КонецЕсли;
		Бик = НормализованноеЧислоСтроки(Строка(ЗначениеМодели.Получить("value")));
		Если НЕ ПустаяСтрока(Бик) И Бики.Найти(Бик) = Неопределено Тогда
			Бики.Добавить(Бик);
		КонецЕсли;
	КонецЦикла;
	Возврат Бики;

КонецФункции

// Какие из БИК есть в справочнике банков (Код банка = БИК, mcp.md [P3]):
// одна выборка на вызов проверки значений - не запрос в цикле.
//
// Параметры:
//  Бики - Массив из Строка - БИК из значений части.
//
// Возвращаемое значение:
//  Соответствие - БИК -> СправочникСсылка.Банки (только найденные; при
//  нескольких банках с одним БИК - не помеченный на удаление).
//
Функция БикиВСправочнике(Знач Бики)

	Найденные = Новый Соответствие;
	Если Бики.Количество() = 0 Тогда
		Возврат Найденные;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Бики", Бики);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Банки.Код КАК Код,
		|	Банки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	Банки.Код В (&Бики)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Банки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Найденные.Получить(Выборка.Код) = Неопределено Тогда
			Найденные.Вставить(Выборка.Код, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Причина отказа проверки одного значения (шаг 7 спеки); пустая строка -
// значение принято (Приведенное заполнено).
//
// Параметры:
//  Контекст          - Структура    - контекст сверки.
//  ТекстНорм         - Строка       - нормализованный текст файла.
//  ЗначениеМодели    - Соответствие - {field, value, fragment}.
//  РезультатыПоиска  - Соответствие - результат НайтиСсылкиПоНаименованиям.
//  БикиВСправочнике  - Соответствие - БИК значений вызова, найденные в банках.
//  БикиПоля          - Массив       - БИК значений вызова (БикиЗначенийЧасти).
//  Итог              - Структура    - заполняются Приведенное и Кандидаты.
//
// Возвращаемое значение:
//  Строка - причина отказа; "" - принято.
//
Функция ОтказПроверкиЗначения(Знач Контекст, Знач ТекстНорм, Знач ЗначениеМодели,
	Знач РезультатыПоиска, Знач БикиВСправочнике, Знач БикиПоля, Знач Итог)

	Поле = Строка(ЗначениеМодели.Получить("field"));
	Значение = Строка(ЗначениеМодели.Получить("value"));
	Цитата = Строка(ЗначениеМодели.Получить("fragment"));

	Если ПустаяСтрока(СокрЛП(Значение)) Тогда
		Возврат "значение пустое";
	КонецЕсли;

	Описание = ОписаниеПоляЗаявки(Поле);
	Если Описание.Тип = "" Тогда
		Возврат "поле не входит в проверяемые реквизиты заявки";
	КонецЕсли;

	ЦитатаНорм = НормализованныйТекст(Цитата);
	Если ПустаяСтрока(ЦитатаНорм) Тогда
		Возврат "нет дословной цитаты";
	КонецЕсли;
	Если Описание.Тип <> "enum" И СтрНайти(ТекстНорм, ЦитатаНорм) = 0 Тогда
		Возврат "цитата не найдена в тексте файла";
	КонецЕсли;

	ЗначениеНорм = НормализованныйТекст(Значение);

	// Специальные проверки ключевых реквизитов.
	ПричинаКлючевого = ОтказПроверкиКлючевогоПоля(Поле, Значение, Контекст,
		БикиВСправочнике, БикиПоля);
	Если НЕ ПустаяСтрока(ПричинаКлючевого) Тогда
		Возврат ПричинаКлючевого;
	КонецЕсли;

	Если Описание.Тип = "enum" Тогда
		Возврат ОтказПроверкиПеречисления(Описание, Значение, Итог);
	КонецЕсли;

	// БИКБанка типа Справочник.Банки: БИК в цитате, банк по БИК (проверен выше
	// по справочнику).
	Если Описание.Тип = "catalog" И Поле = "БИКБанка" Тогда
		Если СтрНайти(ЦитатаНорм, ЗначениеНорм) = 0 Тогда
			Возврат "значения нет в цитате";
		КонецЕсли;
		Итог.Приведенное = БикиВСправочнике.Получить(НормализованноеЧислоСтроки(Значение));
		Возврат "";
	КонецЕсли;

	Если Описание.Тип = "catalog" Тогда
		Возврат ОтказПроверкиСсылки(Описание, Значение, РезультатыПоиска, Итог);
	КонецЕсли;

	// string/number/date: значение должно быть в цитате.
	Если СтрНайти(ЦитатаНорм, ЗначениеНорм) = 0 Тогда
		Возврат "значения нет в цитате";
	КонецЕсли;

	Если Описание.Тип = "number" Тогда
		Число = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Значение);
		Если Число = Неопределено Тогда
			Возврат "значение не число";
		КонецЕсли;
		Итог.Приведенное = Число;
	ИначеЕсли Описание.Тип = "date" Тогда
		ДатаЗначения = СтроковыеФункцииКлиентСервер.СтрокаВДату(Значение);
		Если Не ЗначениеЗаполнено(ДатаЗначения) Тогда
			Возврат "значение не дата (ДД.ММ.ГГГГ)";
		КонецЕсли;
		Итог.Приведенное = ДатаЗначения;
	Иначе
		Итог.Приведенное = СокрЛП(Значение);
	КонецЕсли;

	Возврат "";

КонецФункции

// Специальные проверки ключевых реквизитов (шаг 7): ИНН/ОГРН - контрольные
// числа, КПП - формат, БИК - справочник банков (одна выборка на вызов,
// БикиВСправочнике), счёт - контрольный ключ по БИК (заявки либо из той же
// сдачи).
//
// Параметры:
//  Поле              - Строка       - имя поля.
//  Значение          - Строка       - значение от модели.
//  Контекст          - Структура    - контекст сверки (БИК заявки).
//  БикиВСправочнике  - Соответствие - БИК значений вызова в справочнике банков.
//  БикиПоля          - Массив       - БИК значений вызова.
//
// Возвращаемое значение:
//  Строка - причина отказа; "" - проверка пройдена (или поле не ключевое).
//
Функция ОтказПроверкиКлючевогоПоля(Знач Поле, Знач Значение, Знач Контекст,
	Знач БикиВСправочнике, Знач БикиПоля)

	Если Поле = "ИНН" Тогда
		Если НЕ ИННКорректен(НормализованноеЧислоСтроки(Значение)) Тогда
			Возврат "ИНН неверен (контрольное число или формат)";
		КонецЕсли;
	ИначеЕсли Поле = "РегистрационныйНомер" Тогда
		Если НЕ ОГРНКорректен(НормализованноеЧислоСтроки(Значение)) Тогда
			Возврат "ОГРН/ОГРНИП неверен (контрольное число или формат)";
		КонецЕсли;
	ИначеЕсли Поле = "КПП" Тогда
		Если НЕ КППКорректен(СокрЛП(Значение)) Тогда
			Возврат "КПП не соответствует формату";
		КонецЕсли;
	ИначеЕсли Поле = "БИКБанка" Тогда
		Бик = НормализованноеЧислоСтроки(Значение);
		Если НЕ БИККорректен(Бик) Тогда
			Возврат "БИК не соответствует формату (9 цифр банка РФ)";
		КонецЕсли;
		Если БикиВСправочнике.Получить(Бик) = Неопределено Тогда
			Возврат "БИК не найден в справочнике банков";
		КонецЕсли;
	ИначеЕсли Поле = "НомерОсновногоБанковскогоСчета" Тогда
		НомерСчета = НормализованноеЧислоСтроки(Значение);
		Если СтрДлина(НомерСчета) <> 20 Тогда
			Возврат "номер счёта должен состоять из 20 цифр";
		КонецЕсли;
		// Ключ счёта - по БИК заявки либо БИК из той же сдачи.
		КандидатыБик = БикиДляКлючаСчета(Контекст, БикиПоля);
		Если КандидатыБик.Количество() = 0 Тогда
			Возврат "нет БИК для проверки контрольного ключа счёта";
		КонецЕсли;
		КлючВерен = Ложь;
		Для Каждого Бик Из КандидатыБик Цикл
			Если КлючСчетаКорректен(НомерСчета, Бик) Тогда
				КлючВерен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ КлючВерен Тогда
			Возврат "контрольный ключ счёта не соответствует БИК";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// БИК для проверки контрольного ключа счёта: БИК заявки (сверяется с ним же -
// шаг 9), затем БИК из той же сдачи значения.
//
// Возвращаемое значение:
//  Массив из Строка - кандидаты БИК без дублей.
//
Функция БикиДляКлючаСчета(Знач Контекст, Знач БикиПоля)

	Кандидаты = Новый Массив;
	Если НЕ ПустаяСтрока(Контекст.БИК) Тогда
		Кандидаты.Добавить(Контекст.БИК);
	КонецЕсли;
	Для Каждого Бик Из БикиПоля Цикл
		Если Кандидаты.Найти(Бик) = Неопределено Тогда
			Кандидаты.Добавить(Бик);
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Проверка значения перечисления: значение из допустимых (цитата - как
// обоснование, само значение в цитате не требуется, п. 4 шаг 7); приведение -
// ссылка значения перечисления, в модель пишется типизированное значение.
Функция ОтказПроверкиПеречисления(Знач Описание, Знач Значение, Знач Итог)

	Для Каждого ТипЗначения Из Описание.ОписаниеТипа.Типы() Цикл
		ИмяПеречисления = ИмяОбъектаСсылочногоТипа(ТипЗначения, "Перечисления");
		Если ИмяПеречисления = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЗначениеПеречисления Из Перечисления[ИмяПеречисления] Цикл
			Если НормализованныйТекст(Строка(ЗначениеПеречисления)) = НормализованныйТекст(Значение) Тогда
				Итог.Приведенное = ЗначениеПеречисления;
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		Прервать;
	КонецЦикла;

	Возврат "значения нет в допустимых значениях перечисления";

КонецФункции

// Проверка ссылочного значения по результатам пакетного поиска по
// наименованию: ровно один - принят; ни одного - «не найдено»; несколько -
// «неоднозначно» + до 5 кандидатов (п. 4б спеки).
Функция ОтказПроверкиСсылки(Знач Описание, Знач Значение, Знач РезультатыПоиска, Знач Итог)

	КлючПоиска = КлючПоискаСсылки(Описание.ИмяТаблицы, Значение);
	Найденные = РезультатыПоиска.Получить(КлючПоиска);
	Если Найденные = Неопределено Или Найденные.Количество() = 0 Тогда
		Возврат СтрШаблон("не найдено в справочнике «%1»", Описание.ИмяТаблицы);
	КонецЕсли;

	Если Найденные.Количество() > 1 Тогда
		Кандидаты = Новый Массив;
		Индекс = 0;
		Для Каждого Найденный Из Найденные Цикл
			Индекс = Индекс + 1;
			Если Индекс > 5 Тогда
				Прервать;
			КонецЕсли;
			Кандидаты.Добавить(Найденный.Представление);
		КонецЦикла;
		Итог.Кандидаты = Кандидаты;
		Возврат "неоднозначно: в справочнике несколько подходящих элементов";
	КонецЕсли;

	Итог.Приведенное = Найденные[0].Ссылка;
	Возврат "";

КонецФункции

// Поиск ссылочных значений вызова по наименованию одним пакетным запросом
// (п. 4б спеки): наименование (регистр в запросе не различается) либо код,
// без помеченных на удаление; секция на каждое значение, один ВыполнитьПакет.
//
// Параметры:
//  ЗадачиПоиска - Массив из Структура {ИмяТаблицы, Значение}.
//
// Возвращаемое значение:
//  Соответствие - ключ (КлючПоискаСсылки) -> Массив из Структура {Ссылка,
//  Представление} (совпадения по наименованию и по коду).
//
Функция НайтиСсылкиПоНаименованиям(Знач ЗадачиПоиска)

	Результаты = Новый Соответствие;

	// Уникальные задачи - одно значение одного справочника ищется один раз.
	Уникальные = Новый Соответствие;
	Для Каждого Задача Из ЗадачиПоиска Цикл
		Если ПустаяСтрока(СокрЛП(Задача.Значение)) Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(КлючПоискаСсылки(Задача.ИмяТаблицы, Задача.Значение), Задача);
	КонецЦикла;
	Если Уникальные.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	Секции = Новый Массив;
	НомерСекции = 0;
	Запрос = Новый Запрос;
	Для Каждого КлючИЗадача Из Уникальные Цикл
		Задача = КлючИЗадача.Значение;
		ИмяПараметра = "Значение" + Формат(НомерСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра, СокрЛП(Задача.Значение));
		// Ключ поиска - параметром: он содержит значение модели, а нормализация
		// заменяет кавычки-ёлочки на прямые - литералом его вставлять нельзя.
		ИмяКлюча = "КлючПоиска" + Формат(НомерСекции, "ЧГ=0");
		Запрос.УстановитьПараметр(ИмяКлюча, КлючИЗадача.Ключ);
		// Поле Код есть у всех справочников-кандидатов дозаполнения; поиск по
		// коду только для числовых значений, чтобы не искать текст в коде.
		УсловиеКода = "";
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СокрЛП(Задача.Значение)) Тогда
			УсловиеКода = Символы.ПС + "			ИЛИ Т.Код = &" + ИмяПараметра;
		КонецЕсли;
		Секции.Добавить(
			"ВЫБРАТЬ
			|	&" + ИмяКлюча + " КАК КлючПоиска,
			|	Т.Ссылка КАК Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление
			|ИЗ
			|	Справочник." + Задача.ИмяТаблицы + " КАК Т
			|ГДЕ
			|	НЕ Т.ПометкаУдаления
			|	И (Т.Наименование = &" + ИмяПараметра
			+ УсловиеКода + ")");
		НомерСекции = НомерСекции + 1;
	КонецЦикла;

	Запрос.Текст = СтрСоединить(Секции, Символы.ПС + ";" + Символы.ПС);
	РезультатыПакета = Запрос.ВыполнитьПакет();

	Для Каждого РезультатПакета Из РезультатыПакета Цикл
		Выборка = РезультатПакета.Выбрать();
		Пока Выборка.Следующий() Цикл
			Найденные = Результаты.Получить(Выборка.КлючПоиска);
			Если Найденные = Неопределено Тогда
				Найденные = Новый Массив;
				Результаты.Вставить(Выборка.КлючПоиска, Найденные);
			КонецЕсли;
			Найденные.Добавить(Новый Структура("Ссылка, Представление",
				Выборка.Ссылка, Выборка.Представление));
		КонецЦикла;
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Ключ соответствия результатов поиска ссылки.
Функция КлючПоискаСсылки(Знач ИмяТаблицы, Знач Значение)

	Возврат ИмяТаблицы + "|" + НормализованныйТекст(Значение);

КонецФункции

// Приоритет вердикта сверки (п. 4а.7 спеки): files_pending > return >
// reject_candidate > handover > files_not_submitted > ready.
//
// Параметры:
//  Приоритеты - Соответствие - вердикт -> Истина (поднятые причины).
//
// Возвращаемое значение:
//  Строка - вердикт.
//
Функция ВердиктПоПриоритету(Знач Приоритеты)

	Порядок = Новый Массив;
	Порядок.Добавить("files_pending");
	Порядок.Добавить("return");
	Порядок.Добавить("reject_candidate");
	Порядок.Добавить("handover");
	Порядок.Добавить("files_not_submitted");

	Для Каждого Вердикт Из Порядок Цикл
		Если Приоритеты.Получить(Вердикт) <> Неопределено Тогда
			Возврат Вердикт;
		КонецЕсли;
	КонецЦикла;

	Возврат "ready";

КонецФункции

// Допустимые решения по вердикту (п. 4а.7 спеки).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеРешенияПоВердикту(Знач Вердикт)

	Решения = Новый Массив;
	Если Вердикт = "ready" Тогда
		Решения.Добавить("approve");
		Решения.Добавить("return");
		Решения.Добавить("handover");
	ИначеЕсли Вердикт = "return" Или Вердикт = "reject_candidate"
		Или Вердикт = "files_not_submitted" Тогда
		Решения.Добавить("return");
		Решения.Добавить("handover");
		Если Вердикт = "reject_candidate" Тогда
			Решения.Добавить("reject");
		КонецЕсли;
	Иначе
		// files_pending, handover.
		Решения.Добавить("handover");
		Решения.Добавить("return");
	КонецЕсли;

	Возврат Решения;

КонецФункции

#КонецОбласти

#Область ИнструментСверкаЗаявки

// Реализация инструмента nsi_verify_request (п. 4а спеки): детерминированная
// сверка заявки с вложениями. Защиты (п. 1): исключённая внешняя система,
// активная виза агента этапа 1 без решения, совпадение model_hash,
// run_already_decided. Тексты файлов - из кэша ТекстХранилище; файл без текста
// ставится в очередь распознавания, ответ files_pending (п. 4.2). Модель внутри
// пакета не вызывается; сданные моделью данные берутся из действий запуска.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {request, model_hash}.
//  Контекст      - Структура - контекст запуска (нужны RunId, Агент).
//
// Возвращаемое значение:
//  Строка - JSON-observation (verdict, allowed_decisions, model_hash, fields,
//  files, parts, files_left, mismatches, monopolist, requisites, official,
//  needs_review, remarks, next) либо {"error", "message"}.
//
Функция ВыполнитьСверкуЗаявки(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			?(ПустаяСтрока(ОтборЗаявки.Сообщение), ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение));
	КонецЕсли;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - отказ до чтения.
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
	КонецЕсли;

	Если ЗаявкаИсключена(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("request_excluded_external_system",
			ТекстЗаявкаИсключена(), Истина);
	КонецЕсли;

	// agentrunner-96: заявку автоактуализации сверит и проведет
	// nsi_actualize_request - обычная сверка с вложениями не применяется.
	Если ЭтоЗаявкаАктуализацииПоСсылке(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("use_actualize_request", ТекстИспользуйАктуализацию());
	КонецЕсли;

	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть И Решение.СсылкаЗаявки <> ОтборЗаявки.Ссылка Тогда
		Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
	КонецЕсли;

	ОтказЭтапа = ОтказПроверкиЭтапаСверки(Контекст, ОтборЗаявки.Ссылка, 1);
	Если ОтказЭтапа.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтказЭтапа.КодОшибки, ОтказЭтапа.Сообщение,
			ЭтоТерминальныйКодОтказа(ОтказЭтапа.КодОшибки));
	КонецЕсли;

	КонтекстСверки = КонтекстСверки(ОтборЗаявки.Ссылка);
	ОтказХеша = ХешАргументыСтруктура(Аргументы);
	Если ОтказПоХешуМодели(КонтекстСверки.ДанныеЗаявки, ОтказХеша) Тогда
		// Код и сообщение отказа (request_not_found либо request_changed) заполнила
		// ОтказПоХешуМодели - возвращаем их, а не предполагаемый request_changed.
		Возврат ОшибкаИнструмента(ОтказХеша.КодОшибки, ОтказХеша.Сообщение);
	КонецЕсли;

	ЗаполнитьСданныеЧастиИзДействийЗапуска(КонтекстСверки, RunIdИзКонтекста(Контекст));

	Сверка = ВычислитьСверкуЗаявки(КонтекстСверки, Истина);

	Если Сверка.Вердикт = "files_pending" Тогда
		НавссылкаЗаявки = ar_Утилиты.НавигационнаяСсылкаОбъекта(ОтборЗаявки.Ссылка);
		Ответ = Новый Структура;
		Ответ.Вставить("request", НавссылкаЗаявки);
		// agentrunner-212: объект работы для ядра (контракт предмета запуска).
		Ответ.Вставить("subject", НавссылкаЗаявки);
		Ответ.Вставить("verdict", "files_pending");
		Ответ.Вставить("allowed_decisions", Сверка.ДопустимыеРешения);
		Ответ.Вставить("files", Сверка.ФайлыОтвет);
		Ответ.Вставить("message",
			НСтр("ru = 'Файлы заявки ещё распознаются. Ничего не делай и заверши работу -
				|заявка вернётся в очередь агента после распознавания.'"));
		Ответ.Вставить("next", "finish");
		// agentrunner-108: терминальный исход (контракт agentrunner-107) - без
		// признака гейт итога отклонит отчёт из-за незакрытых шагов сверки
		// (запуск 9a271298). Раньше здесь читался Контекст.СсылкаЗаявки - ключа
		// в контексте запуска нет (mcp.md [P3]), ответ падал в tool_exception.
		Ответ.Вставить("terminal", Истина);
		Ответ.Вставить("terminal_reason", "files_pending");
		ЗаписатьЛогСверки(КонтекстСверки, Сверка);
		Возврат ar_JSON.ВЗначениеJSON(Ответ);
	КонецЕсли;

	Ответ = ПолныйОтветСверки(КонтекстСверки, Сверка);
	// agentrunner-212: объект работы для ядра (контракт предмета запуска).
	Ответ.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(ОтборЗаявки.Ссылка));

	// agentrunner-108: основание вопроса инициатору (вероятный дубль либо
	// несколько подходящих карточек) - готовые аргументы ask_user для прямой
	// подстановки; без основания initiator_question не отдаётся.
	Основание = КодОснованияВопросаИнициатору(Сверка);
	Если НЕ ПустаяСтрока(Основание) Тогда
		Ответ.Вставить("initiator_question",
			ВопросИнициаторуПоСверке(RunIdИзКонтекста(Контекст), КонтекстСверки, Основание, Сверка));
		Ответ.Вставить("message",
			НСтр("ru = 'Есть основание для вопроса инициатору заявки: вызови ask_user
				|с аргументами initiator_question.ask_user_args без изменений.'"));
	КонецЕсли;
	ЗаписатьЛогСверки(КонтекстСверки, Сверка);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Хеш агента в виде структуры для ОтказПоХешуМодели: нужны и ХешАгента, и ключи
// отказа КодОшибки/Сообщение - при несовпадении хеша ОтказПоХешуМодели пишет в
// них код и текст отказа (сама структура отдаётся с пустыми значениями).
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента; нужен model_hash.
//
// Возвращаемое значение:
//  Структура - ХешАгента ("" - в аргументах нет строкой), КодОшибки/Сообщение - "".
//
Функция ХешАргументыСтруктура(Знач Аргументы)

	Хеш = ЗначениеИзКоллекции(Аргументы, "model_hash", "");
	Если ТипЗнч(Хеш) <> Тип("Строка") Тогда
		Хеш = "";
	КонецЕсли;
	Возврат Новый Структура("ХешАгента, КодОшибки, Сообщение", Хеш, "", "");

КонецФункции

// Основание вопроса инициатору по итогам сверки (agentrunner-108, спека п. 3):
// вероятный дубль (verdict = reject_candidate: точный дубль при создании либо
// ликвидация контрагента) либо несколько подходящих карточек контрагента
// (отклонённое ссылочное значение с более чем одним кандидатом справочника
// «Контрагенты»). Прочие вердикты инициатору не адресуются - замечания идут
// в решение return.
//
// Параметры:
//  Сверка - Структура - результат ВычислитьСверкуЗаявки (Вердикт,
//           ПроверенныеЗначения).
//
// Возвращаемое значение:
//  Строка - код основания ("reject_candidate", "ambiguous_candidates");
//  "" - основания нет.
//
Функция КодОснованияВопросаИнициатору(Знач Сверка)

	// 2.5.6: лимит возвратов исчерпан - допустимо только reject, вопрос
	// инициатору не задается (см. ПрименитьЛимитВозвратовКСверке).
	Если Сверка.ЛимитВозвратовИсчерпан Тогда
		Возврат "";
	КонецЕсли;

	Если Сверка.Вердикт = "reject_candidate" Тогда
		Возврат "reject_candidate";
	КонецЕсли;

	Если НеоднозначныеКарточкиСверки(Сверка).Количество() > 0 Тогда
		Возврат "ambiguous_candidates";
	КонецЕсли;

	Возврат "";

КонецФункции

// Отклоненные значения сверки со ссылкой на справочник «Контрагенты» и более
// чем одним кандидатом (основание ambiguous_candidates).
//
// Параметры:
//  Сверка - Структура - результат сверки (ПроверенныеЗначения).
//
// Возвращаемое значение:
//  Массив из Структура - {Поле, Значение, Кандидаты - Массив из Строка}.
//
Функция НеоднозначныеКарточкиСверки(Знач Сверка)

	Результат = Новый Массив;
	Для Каждого ФайлСЧастями Из Сверка.ПроверенныеЗначения Цикл
		Для Каждого ЧастьСИтогами Из ФайлСЧастями.Значение Цикл
			Для Каждого Итог Из ЧастьСИтогами.Итоги Цикл
				Если НЕ Итог.Принято И Итог.Кандидаты.Количество() > 1
					И ОписаниеПоляЗаявки(Итог.Поле).ИмяТаблицы = "Контрагенты" Тогда
					Неоднозначное = Новый Структура("Поле, Значение, Кандидаты",
						Итог.Поле, Итог.Значение, Итог.Кандидаты);
					Результат.Добавить(Неоднозначное);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Состав основания reject_candidate (2.5.3): точный дубль при создании
// (замечание НетДубляИННКППНаименование обработки проверки) и/или ликвидация
// контрагента по ЕГР. Вердикт складывается из обеих причин, а вопрос
// инициатору должен назвать настоящую.
//
// Параметры:
//  Сверка - Структура - результат сверки (ОбработкаПроверки, Официальные).
//
// Возвращаемое значение:
//  Структура - {Дубль, Ликвидация - Булево, Карточка - см. КарточкаДубляСверки,
//  ДатаПрекращения - Строка}.
//
Функция СоставОснованияОтклонения(Знач Сверка)

	Состав = Новый Структура;
	Состав.Вставить("Дубль", Ложь);
	Состав.Вставить("Ликвидация", Ложь);
	Состав.Вставить("Карточка", КарточкаДубляСверки(Сверка));
	Состав.Вставить("ДатаПрекращения", "");

	Если Сверка.ОбработкаПроверки <> Неопределено
		И Сверка.ОбработкаПроверки.КодОшибки = "" Тогда
		Состав.Дубль = ЕстьЗамечаниеОбработки(Сверка.ОбработкаПроверки.Данные,
			"НетДубляИННКППНаименование");
	КонецЕсли;

	Если Сверка.Официальные <> Неопределено И Сверка.Официальные.terminated Тогда
		Состав.Ликвидация = Истина;
		Состав.ДатаПрекращения = ЗначениеИзСтруктурыСтрокой(Сверка.Официальные,
			"termination_date", "");
	КонецЕсли;

	Возврат Состав;

КонецФункции

// Код состава основания reject_candidate для initiator_question.basis.
//
// Параметры:
//  Состав - Структура - см. СоставОснованияОтклонения.
//
// Возвращаемое значение:
//  Строка - "duplicate", "terminated", "duplicate_terminated".
//
Функция КодСоставаОснования(Знач Состав)

	Если Состав.Дубль И Состав.Ликвидация Тогда
		Возврат "duplicate_terminated";
	ИначеЕсли Состав.Ликвидация Тогда
		Возврат "terminated";
	КонецЕсли;
	// Дубль; вердикт без известной причины - тоже как дубль без карточки.
	Возврат "duplicate";

КонецФункции

// initiator_question (agentrunner-108, спека п. 3): сформулированный пакетом
// вопрос инициатору заявки с данными и готовыми аргументами ask_user для
// прямой подстановки. Адресация по правилам ядра (НормализоватьПравилоАдресата):
// у запуска есть предмет (ar_Запуски.ar_Предмет - заявка) - реквизит предмета
// сд_Инициатор; предмета нет (чат manual_chat, заявка по номеру) - правило
// initiator (пользователь запуска, в чате - собеседник).
//
// Параметры:
//  RunId          - Строка          - идентификатор запуска (для предмета).
//  КонтекстСверки - Структура       - контекст сверки (СсылкаЗаявки, Наименование,
//                                     ИНН, КПП).
//  Основание      - Строка          - код основания (см. КодОснованияВопросаИнициатору).
//  Сверка         - Структура       - результат сверки (замечание дубля обработки
//                                     проверки - найденная карточка).
//
// Возвращаемое значение:
//  Структура - {required, reason, basis (для reject_candidate: duplicate,
//  terminated, duplicate_terminated), text, ask_user_args}.
//
Функция ВопросИнициаторуПоСверке(Знач RunId, Знач КонтекстСверки, Знач Основание, Знач Сверка)

	Номер = НомерЗаявкиСтрокой(КонтекстСверки.СсылкаЗаявки);
	Контрагент = ОписаниеКонтрагентаВопроса(КонтекстСверки);
	КодСостава = "";
	Если Основание = "reject_candidate" Тогда
		// 2.5.3: текст - по настоящей причине вердикта. Раньше любой
		// reject_candidate назывался дублем, и при ликвидации по ЕГР вопрос
		// говорил о «найденной карточке» без карточки и ссылки.
		Состав = СоставОснованияОтклонения(Сверка);
		КодСостава = КодСоставаОснования(Состав);
		Текст = ТекстВопросаОтклонения(Номер, Контрагент, Состав, КодСостава);
	Иначе
		Текст = СтрШаблон(
			НСтр("ru = 'По заявке НСИ %1 (%2) в справочнике найдено несколько
				|подходящих карточек контрагента. Подтверди, пожалуйста, какую карточку
				|использовать для заявки.'"),
			Номер, Контрагент);
		// 2.5.3: поля и кандидаты (до 5 на поле), чтобы выбирать было из чего.
		Для Каждого Неоднозначное Из НеоднозначныеКарточкиСверки(Сверка) Цикл
			Синоним = ОписаниеПоляЗаявки(Неоднозначное.Поле).Синоним;
			Текст = Текст + Символы.ПС + СтрШаблон(
				НСтр("ru = '%1 «%2» - подходят: %3'"),
				?(ПустаяСтрока(Синоним), Неоднозначное.Поле, Синоним),
				Неоднозначное.Значение, СтрСоединить(Неоднозначное.Кандидаты, "; "));
		КонецЦикла;
	КонецЕсли;

	Аргументы = Новый Структура;
	Аргументы.Вставить("question", Текст);
	Если ЕстьПредметЗапуска(RunId) Тогда
		Аргументы.Вставить("recipient", "subject_attribute");
		Аргументы.Вставить("recipient_attribute", "сд_Инициатор");
	Иначе
		Аргументы.Вставить("recipient", "initiator");
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("required", Истина);
	Ответ.Вставить("reason", Основание);
	Если НЕ ПустаяСтрока(КодСостава) Тогда
		Ответ.Вставить("basis", КодСостава);
	КонецЕсли;
	Ответ.Вставить("text", Текст);
	Ответ.Вставить("ask_user_args", Аргументы);
	Возврат Ответ;

КонецФункции

// Контрагент заявки для текста вопроса: наименование, ИНН и КПП (пустые -
// пропускаются).
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки (Наименование, ИНН, КПП).
//
// Возвращаемое значение:
//  Строка - «контрагент «...», ИНН ..., КПП ...».
//
Функция ОписаниеКонтрагентаВопроса(Знач КонтекстСверки)

	Части = Новый Массив;
	Если ПустаяСтрока(КонтекстСверки.Наименование) Тогда
		Части.Добавить(НСтр("ru = 'контрагент без наименования'"));
	Иначе
		Части.Добавить(СтрШаблон(НСтр("ru = 'контрагент «%1»'"), КонтекстСверки.Наименование));
	КонецЕсли;
	Если НЕ ПустаяСтрока(КонтекстСверки.ИНН) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'ИНН %1'"), КонтекстСверки.ИНН));
	КонецЕсли;
	Если НЕ ПустаяСтрока(КонтекстСверки.КПП) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'КПП %1'"), КонтекстСверки.КПП));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Текст вопроса инициатору по основанию reject_candidate (2.5.3): дубль с
// карточкой и ссылкой либо без них (старая обработка проверки), ликвидация по
// ЕГР с датой прекращения, дубль ликвидированного контрагента.
//
// Параметры:
//  Номер      - Строка    - номер заявки.
//  Контрагент - Строка    - см. ОписаниеКонтрагентаВопроса.
//  Состав     - Структура - см. СоставОснованияОтклонения.
//  КодСостава - Строка    - см. КодСоставаОснования.
//
// Возвращаемое значение:
//  Строка - текст вопроса.
//
Функция ТекстВопросаОтклонения(Знач Номер, Знач Контрагент, Знач Состав, Знач КодСостава)

	Прекращение = "";
	Если Состав.Ликвидация И НЕ ПустаяСтрока(Состав.ДатаПрекращения) Тогда
		Прекращение = СтрШаблон(НСтр("ru = ' (дата прекращения - %1)'"), Состав.ДатаПрекращения);
	КонецЕсли;

	Если КодСостава = "terminated" Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'По заявке НСИ %1 (%2): по данным ЕГРЮЛ/ЕГРИП деятельность
				|контрагента прекращена%3. Создавать карточку ликвидированного
				|контрагента нельзя. Подтверди, пожалуйста: отклонить заявку или ты
				|исправишь её (например, укажешь правопреемника)?'"),
			Номер, Контрагент, Прекращение);
	КонецЕсли;

	Если КодСостава = "duplicate_terminated" Тогда
		Текст = СтрШаблон(
			НСтр("ru = 'По заявке НСИ %1 (%2) в справочнике уже есть карточка с теми же
				|ИНН, КПП и наименованием, и по данным ЕГРЮЛ/ЕГРИП деятельность
				|контрагента прекращена%3. Подтверди, пожалуйста: отклонить заявку
				|или ты её исправишь?'"),
			Номер, Контрагент, Прекращение);
	Иначе
		Текст = СтрШаблон(
			НСтр("ru = 'По заявке НСИ %1 (%2) в справочнике уже есть карточка с теми же
				|ИНН, КПП и наименованием - похоже на дубль. Подтверди, пожалуйста:
				|создавать нового контрагента по заявке или отклонить её как дубль?'"),
			Номер, Контрагент);
	КонецЕсли;

	// Найденная карточка (с 2.4.3): представление и навигационная ссылка из
	// замечания дубля обработки проверки.
	Если Состав.Карточка <> Неопределено Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Существующая карточка: %1'"), Состав.Карточка.Представление);
		Если НЕ ПустаяСтрока(Состав.Карточка.Ссылка) Тогда
			Текст = Текст + Символы.ПС + СтрШаблон(
				НСтр("ru = 'Ссылка на карточку: %1'"), Состав.Карточка.Ссылка);
		КонецЕсли;
	Иначе
		Текст = Текст + Символы.ПС + НСтр("ru = 'Карточку обработка проверки не указала -
			|найти её можно в справочнике «Контрагенты» по ИНН и КПП.'");
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Есть ли у запуска предмет (agentrunner-108): ресурс ar_Запуски.ar_Предмет
// заполнен (в запуске по заявке из очереди - заявка; в чате manual_chat и при
// прямом вызове - пусто). Приём ядра - ШапкаЗапускаДляПравила
// (ar_ИнструментыВзаимодействие) - экспортирован не был.
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПредметЗапуска(Знач RunId)

	Если ПустаяСтрока(RunId) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", Лев(RunId, 36));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_Предмет КАК Предмет
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Выборка.Предмет);

КонецФункции

// Активная виза агента и её этап для заявки (п. 3 спеки): активная запись
// визы, назначенная пользователю агента, этап по константам GUID.
//
// Параметры:
//  Контекст        - Структура - контекст запуска (нужен Агент).
//  СсылкаЗаявки    - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура {ЗаписьВизы - Строка набора, Виза - СправочникСсылка, Этап - Число,
//  ИД - Строка, Решение - СправочникСсылка, Найдена - Булево}.
//
Функция АктивнаяВизаАгента(Знач Контекст, Знач СсылкаЗаявки)

	Результат = Новый Структура;
	Результат.Вставить("ЗаписьВизы", Неопределено);
	Результат.Вставить("Виза", Неопределено);
	Результат.Вставить("Этап", 0);
	Результат.Вставить("ИД", "");
	Результат.Вставить("Решение", Неопределено);
	Результат.Вставить("Найдена", Ложь);

	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат Результат;
	КонецЕсли;

	СписокВизАгента = бит_ВизированиеСервер.ВизыПользователя(ПользовательАгента, СсылкаЗаявки);
	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	Для Каждого ЗаписьВизы Из НаборВизы Цикл
		Если НЕ ЗаписьВизы.АктивнаяВиза
			Или СписокВизАгента.НайтиПоЗначению(ЗаписьВизы.Виза) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.ЗаписьВизы = ЗаписьВизы;
		Результат.Виза = ЗаписьВизы.Виза;
		Результат.Этап = ЭтапВизыПоСсылке(ЗаписьВизы.Виза);
		Результат.ИД = ЗаписьВизы.ИД;
		Результат.Решение = ЗаписьВизы.Решение;
		Результат.Найдена = Истина;
		Прервать;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отказ проверки этапа для сверок и решения (п. 4а.1): заявка должна быть на
// активной визе агента ожидаемого этапа без решения.
//
// Параметры:
//  Контекст       - Структура - контекст запуска.
//  СсылкаЗаявки   - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ОжидаемыйЭтап  - Число     - 1 или 2.
//
// Возвращаемое значение:
//  Структура {КодОшибки, Сообщение} - пустой код - проверка пройдена.
//
Функция ОтказПроверкиЭтапаСверки(Знач Контекст, Знач СсылкаЗаявки, Знач ОжидаемыйЭтап)

	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");

	ВизаАгента = АктивнаяВизаАгента(Контекст, СсылкаЗаявки);
	Если НЕ ВизаАгента.Найдена Или ЗначениеЗаполнено(ВизаАгента.Решение) Тогда
		Результат.КодОшибки = "visa_not_active";
		Результат.Сообщение =
			НСтр("ru = 'Нет активной визы агента без решения - заявка не в работе агента.
				|Возьми заявку из nsi_pending_visas.'");
		Возврат Результат;
	КонецЕсли;

	Если ВизаАгента.Этап = 0 Тогда
		Результат.КодОшибки = "visa_stage_unknown";
		Результат.Сообщение =
			НСтр("ru = 'Виза агента не входит в этапы маршрута (КонстантыGUID) - заявка
				|агенту не выдаётся.'");
		Возврат Результат;
	КонецЕсли;

	Если ВизаАгента.Этап <> ОжидаемыйЭтап Тогда
		Результат.КодОшибки = "wrong_stage";
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Заявка на визе этапа %1, а вызов предназначен для этапа %2.'"),
			ВизаАгента.Этап, ОжидаемыйЭтап);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Деление текста на части по ПределТекстаЧастиСимволов на границе строки
// (п. 4 шаг 6); короткий текст - одна часть.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЧастиТекста(Знач Текст)

	Части = Новый Массив;
	Предел = ПределТекстаЧастиСимволов();
	Остаток = Текст;

	Пока Истина Цикл
		Если СтрДлина(Остаток) <= Предел Тогда
			Части.Добавить(Остаток);
			Прервать;
		КонецЕсли;
		// Граница строки в пределах части; нет переноса - режем по пределу.
		Граница = СтрНайти(Лев(Остаток, Предел + 1), Символы.ПС, НаправлениеПоиска.СКонца);
		Если Граница <= 1 Тогда
			Граница = Предел + 1;
		КонецЕсли;
		Части.Добавить(Лев(Остаток, Граница - 1));
		Остаток = Сред(Остаток, Граница + 1);
	КонецЦикла;

	Возврат Части;

КонецФункции

// Следующая порция частей для модели (шаг 6): несданные части относящихся
// файлов, пока суммарная длина не превысит ПределТекстаОтветаСимволов.
//
// Параметры:
//  СтатусыФайлов - Массив - статусы файлов из ВычислитьСверкуЗаявки.
//  Контекст      - Структура - контекст сверки (СданныеЧасти).
//
// Возвращаемое значение:
//  Массив из Структура {file, part, text, untrusted_content}.
//
Функция СледующаяПорцияЧастей(Знач СтатусыФайлов, Знач Контекст)

	Порция = Новый Массив;
	Бюджет = ПределТекстаОтветаСимволов();

	Для Каждого СтатусФайла Из СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
			Продолжить;
		КонецЕсли;
		Для Номер = 1 По СтатусФайла.Части.Количество() Цикл
			Если Контекст.СданныеЧасти.Получить(КлючСданнойЧасти(СтатусФайла.ИмяФайла, Номер))
				<> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТекстЧасти = СтатусФайла.Части[Номер - 1];
			Если Порция.Количество() > 0 И СтрДлина(ТекстЧасти) > Бюджет Тогда
				Возврат Порция; // Бюджет ответа исчерпан - остальное в следующей порции.
			КонецЕсли;
			Элемент = Новый Структура;
			Элемент.Вставить("file", СтатусФайла.ИмяФайла);
			Элемент.Вставить("part", Номер);
			Элемент.Вставить("text", ТекстЧасти);
			// Защита от инструкций в тексте файлов (п. 4 спеки): текст - данные.
			Элемент.Вставить("untrusted_content", Истина);
			Порция.Добавить(Элемент);
			Бюджет = Бюджет - СтрДлина(ТекстЧасти);
		КонецЦикла;
	КонецЦикла;

	Возврат Порция;

КонецФункции

// Имена относящихся файлов, у которых сданы не все части (files_left).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ФайлыСлева(Знач СтатусыФайлов, Знач Контекст)

	Имена = Новый Массив;
	Для Каждого СтатусФайла Из СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
			Продолжить;
		КонецЕсли;
		Если ФайлСданПолностью(СтатусФайла, Контекст) = Ложь Тогда
			Имена.Добавить(СтатусФайла.ИмяФайла);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Все ли части файла сданы моделью.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФайлСданПолностью(Знач СтатусФайла, Знач Контекст)

	Для Номер = 1 По СтатусФайла.Части.Количество() Цикл
		Если Контекст.СданныеЧасти.Получить(КлючСданнойЧасти(СтатусФайла.ИмяФайла, Номер))
			= Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Ключ сданной части в СданныеЧасти: имя файла + номер части.
Функция КлючСданнойЧасти(Знач ИмяФайла, Знач НомерЧасти)

	Возврат ИмяФайла + "#" + Формат(НомерЧасти, "ЧГ=0");

КонецФункции

// Заполняет сданные части контекста из действий запуска nsi_submit_file_data
// (повторная сверка и решение - модель заново не спрашивается, п. 5 спеки);
// повторная сдача части заменяет прежнюю (порядок действий сохраняется).
// Вызов, завершившийся ошибкой ({"error": ...}, в том числе tool_exception),
// частей не сдал и пропускается; из успешного вызова не берутся части,
// отклонённые при приёме (submitted_parts с непустой причиной). Усечённый
// ответ не разбирается - части берутся из аргументов как есть.
//
// Параметры:
//  Контекст - Структура - контекст сверки (СданныеЧасти заполняется).
//  RunId    - Строка    - идентификатор запуска.
//
Процедура ЗаполнитьСданныеЧастиИзДействийЗапуска(Знач Контекст, Знач RunId)

	Для Каждого Действие Из ДействияЗапускаПоИнструменту(RunId, "nsi_submit_file_data") Цикл
		АргументыДействия = JSONИзДействия(Действие.АргументыJSON);
		Если АргументыДействия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОтветДействия = JSONИзДействия(Действие.ОтветИнструмента);
		Если ОтветДействия <> Неопределено И ОтветДействия.Получить("error") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДополнитьСданныеЧастиИзАргументов(Контекст, АргументыДействия.Получить("parts"),
			ОтклоненныеЧастиОтвета(ОтветДействия));
	КонецЦикла;

КонецПроцедуры

// Части, отклонённые при приёме, из ответа nsi_submit_file_data: элементы
// submitted_parts с непустой причиной (ИтогЧасти из ПринятьЧастиВызова).
//
// Параметры:
//  ОтветДействия - Соответствие, Неопределено - разобранный ответ вызова.
//
// Возвращаемое значение:
//  Соответствие - ключ сданной части (КлючСданнойЧасти) -> Истина.
//
Функция ОтклоненныеЧастиОтвета(Знач ОтветДействия)

	Отклоненные = Новый Соответствие;
	Если ОтветДействия = Неопределено Тогда
		Возврат Отклоненные;
	КонецЕсли;

	ИтогиЧастей = ОтветДействия.Получить("submitted_parts");
	Если ТипЗнч(ИтогиЧастей) <> Тип("Массив") Тогда
		Возврат Отклоненные;
	КонецЕсли;

	Для Каждого ИтогЧасти Из ИтогиЧастей Цикл
		Если ТипЗнч(ИтогЧасти) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Причина = ИтогЧасти.Получить("Причина");
		Если ТипЗнч(Причина) = Тип("Строка") И НЕ ПустаяСтрока(Причина) Тогда
			КлючЧасти = КлючСданнойЧасти(Строка(ИтогЧасти.Получить("file")),
				ЧислоИзJSON(ИтогЧасти.Получить("part")));
			Отклоненные.Вставить(КлючЧасти, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Отклоненные;

КонецФункции

// Дополняет сданные части контекста из аргументов вызова nsi_submit_file_data:
// parts - [{file, part, persons, values}].
//
// Параметры:
//  Контекст    - Структура       - контекст сверки (СданныеЧасти пополняется).
//  Части       - Массив, прочее  - массив частей из JSON.
//  Отклоненные - Соответствие    - ключи частей, отклонённых при приёме
//                                  (ОтклоненныеЧастиОтвета), - не добавляются.
//
Процедура ДополнитьСданныеЧастиИзАргументов(Знач Контекст, Знач Части, Знач Отклоненные)

	Если ТипЗнч(Части) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если ТипЗнч(Часть) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = Строка(Часть.Получить("file"));
		НомерЧасти = ЧислоИзJSON(Часть.Получить("part"));
		Если ПустаяСтрока(ИмяФайла) Или НомерЧасти <= 0
			Или Отклоненные.Получить(КлючСданнойЧасти(ИмяФайла, НомерЧасти)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СданнаяЧасть = Новый Структура;
		СданнаяЧасть.Вставить("ИмяФайла", ИмяФайла);
		СданнаяЧасть.Вставить("Номер", НомерЧасти);
		СданнаяЧасть.Вставить("Лица", ЛицаИзJSONЧасти(Часть.Получить("persons")));
		СданнаяЧасть.Вставить("Значения", ЗначенияИзJSONЧасти(Часть.Получить("values")));
		Контекст.СданныеЧасти.Вставить(КлючСданнойЧасти(ИмяФайла, НомерЧасти), СданнаяЧасть);
	КонецЦикла;

КонецПроцедуры

// Число из значения JSON (Строка, Число); не число - 0.
Функция ЧислоИзJSON(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Число = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(Значение));
		Возврат ?(Число = Неопределено, 0, Число);
	КонецЕсли;
	Возврат 0;

КонецФункции

// Лица части из JSON: массив {inn, role}.
//
// Возвращаемое значение:
//  Массив из Структура {Инн, Роль}.
//
Функция ЛицаИзJSONЧасти(Знач ЛицаJSON)

	Лица = Новый Массив;
	Если ТипЗнч(ЛицаJSON) <> Тип("Массив") Тогда
		Возврат Лица;
	КонецЕсли;

	Для Каждого ЛицоJSON Из ЛицаJSON Цикл
		Если ТипЗнч(ЛицоJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Лицо = Новый Структура;
		Лицо.Вставить("Инн", НормализованноеЧислоСтроки(Строка(ЛицоJSON.Получить("inn"))));
		Лицо.Вставить("Роль", Строка(ЛицоJSON.Получить("role")));
		Лица.Добавить(Лицо);
	КонецЦикла;
	Возврат Лица;

КонецФункции

// Значения части из JSON: массив {field, value, fragment}.
//
// Возвращаемое значение:
//  Массив из Структура {Поле, Значение, Цитата}.
//
Функция ЗначенияИзJSONЧасти(Знач ЗначенияJSON)

	Значения = Новый Массив;
	Если ТипЗнч(ЗначенияJSON) <> Тип("Массив") Тогда
		Возврат Значения;
	КонецЕсли;

	Для Каждого ЗначениеJSON Из ЗначенияJSON Цикл
		Если ТипЗнч(ЗначениеJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Значение = Новый Структура;
		Значение.Вставить("Поле", Строка(ЗначениеJSON.Получить("field")));
		Значение.Вставить("Значение", Строка(ЗначениеJSON.Получить("value")));
		Значение.Вставить("Цитата", Строка(ЗначениеJSON.Получить("fragment")));
		Значения.Добавить(Значение);
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Полный расчёт сверки заявки (шаги 2-9 и 11-12 п. 4 спеки): статусы файлов,
// проверка сданных значений, сверка ключевых реквизитов со страховкой,
// «Монополист», обязательные документы, проверки обработки, ЕГР, вердикт.
//
// Параметры:
//  Контекст            - Структура - контекст сверки (СданныеЧасти заполнены).
//  СтавитьВОчередьПендинг - Булево - файлы без текста ставить в очередь
//                        распознавания (nsi_verify_request); решение ставит Ложь.
//
// Возвращаемое значение:
//  Структура:
//   * СтатусыФайлов   - Массив - статусы файлов (См. СтатусФайлаСверки + Части).
//   * ФайлыОтвет      - Массив - {ref, name, status, parts, submitted}.
//   * Расхождения     - Массив - {field, in_request, in_file, file, fragment}.
//   * Замечания       - Массив - {code, text} - замечания возврата.
//   * ПунктыReview    - Массив - {id, field, fragment} - needs_review.
//   * Монополист      - Структура - {required, confirmed, partial, file}.
//   * ОбработкаПроверки - Структура - результат РезультатПроверкиОбработкой.
//   * Официальные     - Структура - {result, remarks, kpp, ogrn, terminated,
//                       termination_date}.
//   * Вердикт         - Строка.
//   * ДопустимыеРешения - Массив.
//   * СценарийОпределен - Булево.
//   * ЛимитВозвратовИсчерпан - Булево - замечания есть, лимит возвратов
//                       исчерпан: допустимо только reject.
//
Функция ВычислитьСверкуЗаявки(Знач Контекст, Знач СтавитьВОчередьПендинг)

	Сверка = НоваяСтруктураСверки();
	Если Контекст.ДанныеЗаявки.Шапка = Неопределено Тогда
		Сверка.Вердикт = "handover";
		Сверка.Замечания.Добавить(ЗамечаниеСверки("request_not_found",
			НСтр("ru = 'Заявка недоступна для проверки.'")));
		Сверка.ДопустимыеРешения = ДопустимыеРешенияПоВердикту("handover");
		Возврат Сверка;
	КонецЕсли;

	Контекст.Файлы = ФайлыЗаявкиДляСверки(Контекст.СсылкаЗаявки);
	МоментВозврата = МоментПоследнегоВозвратаЗаявки(Контекст.СсылкаЗаявки);

	Приоритеты = Новый Соответствие;

	// Файлы: статусы, части, порции.
	Для Каждого Файл Из Контекст.Файлы Цикл
		СтатусФайла = СтатусФайлаСверки(Контекст, Файл);
		СтатусФайла.ДоВозврата = ФайлПриложенДоВозврата(Файл, МоментВозврата);
		Если НЕ СтатусФайла.ДоВозврата Тогда
			Сверка.ЕстьНовыеФайлы = Истина;
		КонецЕсли;
		СтатусФайла.Вставить("Части",
			?(СтатусФайла.Код = "relevant_single" Или СтатусФайла.Код = "relevant_multi",
				ЧастиТекста(Файл.Текст), Новый Массив));
		Сверка.СтатусыФайлов.Добавить(СтатусФайла);
		Сверка.ФайлыОтвет.Добавить(ЭлементФайлаОтвета(СтатусФайла, Файл, Контекст));

		Если СтатусФайла.Код = "pending" Тогда
			Приоритеты.Вставить("files_pending", Истина);
			Если СтавитьВОчередьПендинг Тогда
				ПоставитьФайлВОчередьРаспознавания(Файл, Контекст.СсылкаЗаявки);
			КонецЕсли;
		ИначеЕсли СтатусФайла.Код = "unreadable" Тогда
			Сверка.НечитаемыеФайлы.Добавить(СтатусФайла.ИмяФайла);
		КонецЕсли;
	КонецЦикла;

	ЗамечанияПоФайламСверки(Контекст, Сверка, Приоритеты);

	ПроверитьСданныеЗначенияСверки(Контекст, Сверка);
	СверкаКлючевыхРеквизитов(Контекст, Сверка);
	ПроверитьМонополистаСверки(Контекст, Сверка);
	ПроверитьОбязательныеДокументы(Контекст, Сверка);
	ПроверитьЧужиеФайлы(Контекст, Сверка);

	// Проверки обработки (agentrunner-87) и ЕГР.
	Сверка.ОбработкаПроверки = РезультатПроверкиОбработкой(Контекст.СсылкаЗаявки);
	ОфициальныеДанныеЗаявки(Контекст, Сверка);

	ВердиктСверкиПоПричинам(Контекст, Сверка, Приоритеты);

	Возврат Сверка;

КонецФункции

// Пустая структура результата сверки.
//
// Возвращаемое значение:
//  Структура - см. ВычислитьСверкуЗаявки.
//
Функция НоваяСтруктураСверки()

	Сверка = Новый Структура;
	Сверка.Вставить("СтатусыФайлов", Новый Массив);
	Сверка.Вставить("ФайлыОтвет", Новый Массив);
	Сверка.Вставить("Расхождения", Новый Массив);
	Сверка.Вставить("Замечания", Новый Массив);
	Сверка.Вставить("ПунктыReview", Новый Массив);
	Сверка.Вставить("Монополист", Новый Структура("required, confirmed, partial, file",
		Ложь, Ложь, Ложь, ""));
	Сверка.Вставить("ОбработкаПроверки", Неопределено);
	Сверка.Вставить("Официальные", Неопределено);
	Сверка.Вставить("Вердикт", "ready");
	Сверка.Вставить("ДопустимыеРешения", Новый Массив);
	Сверка.Вставить("СценарийОпределен", Истина);
	Сверка.Вставить("НечитаемыеФайлы", Новый Массив);
	Сверка.Вставить("НезаполненОбязательныйДокумент", Ложь);
	Сверка.Вставить("СчетНеПодтвержденДокументами", Ложь);
	Сверка.Вставить("КонфликтыДозаполнения", Новый Массив);
	// 2.4.4: приложены только файлы других организаций или счёт заявки найден
	// в файле другой организации - возврат (ПроверитьЧужиеФайлы).
	Сверка.Вставить("ЧужиеФайлыБлокируют", Ложь);
	// 2.5.6: лимит возвратов исчерпан при замечаниях - допустимо только reject
	// (ПрименитьЛимитВозвратовКСверке).
	Сверка.Вставить("ЛимитВозвратовИсчерпан", Ложь);
	// 2.5.17: после возврата приложены или изменены файлы - файлы, приложенные
	// до возврата, заявку не блокируют (ЗамечанияПоФайламСверки).
	Сверка.Вставить("ЕстьНовыеФайлы", Ложь);
	// 2.5.17: тексты о файлах, не учтенных сверкой без блокировки (слишком
	// большой, нечитаемый, без данных контрагента) - ignored_files, виза approve.
	Сверка.Вставить("НеУчтенныеФайлы", Новый Массив);
	Возврат Сверка;

КонецФункции

// Элемент files ответа сверки: {ref, name, status, parts, submitted}.
//
// Параметры:
//  СтатусФайла - Структура - статус из СтатусФайлаСверки (с Части).
//  Файл        - Структура - файл из ФайлыЗаявкиДляСверки.
//  Контекст    - Структура - контекст сверки.
//
// Возвращаемое значение:
//  Структура.
//
Функция ЭлементФайлаОтвета(Знач СтатусФайла, Знач Файл, Знач Контекст)

	Элемент = Новый Структура;
	Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Файл.Ссылка));
	Элемент.Вставить("name", СтатусФайла.ИмяФайла);
	Элемент.Вставить("status", СтатусФайла.Код);
	Элемент.Вставить("parts", СтатусФайла.Части.Количество());
	Элемент.Вставить("submitted", ФайлСданПолностью(СтатусФайла, Контекст));
	// 2.4.4: ИНН других организаций в файле, не относящемся к заявке.
	Если СтатусФайла.Код = "not_related" Тогда
		Элемент.Вставить("other_inn", СтатусФайла.ДругиеЛица);
	КонецЕсли;
	// 2.5.17: файл приложен и не менялся до последнего возврата заявки.
	Если СтатусФайла.ДоВозврата Тогда
		Элемент.Вставить("before_return", Истина);
	КонецЕсли;
	Возврат Элемент;

КонецФункции

// Замечание сверки {code, text}.
Функция ЗамечаниеСверки(Знач Код, Знач Текст)

	Возврат Новый Структура("code, text", Код, Текст);

КонецФункции

// Замечания по файлам, которые не идут в сверку (2.5.17): слишком большой,
// нечитаемый, не относящийся к заявке без ИНН других организаций (файлы других
// организаций - ПроверитьЧужиеФайлы). Слишком большой файл и файл без данных
// контрагента дают возврат, только если файла контрагента нет. Файл,
// приложенный до последнего возврата, при новых файлах замечания не дает: по нему
// уже вернули, инициатор ответил новыми файлами. Не учтенные без замечания
// файлы - в Сверка.НеУчтенныеФайлы.
//
// Параметры:
//  Контекст   - Структура    - контекст сверки.
//  Сверка     - Структура    - результат сверки (СтатусыФайлов, Замечания,
//               НеУчтенныеФайлы).
//  Приоритеты - Соответствие - причины вердикта.
//
Процедура ЗамечанияПоФайламСверки(Знач Контекст, Знач Сверка, Знач Приоритеты)

	Состав = СоставФайловСверки(Сверка);

	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Рассматривается = ФайлРассматриваетсяСверкой(Сверка, СтатусФайла);
		ИмяФайла = СтатусФайла.ИмяФайла;

		Если СтатусФайла.Код = "too_large" Тогда
			Если Рассматривается И НЕ Состав.ЕстьФайлКонтрагента Тогда
				Приоритеты.Вставить("return", Истина);
				Сверка.Замечания.Добавить(ЗамечаниеСверки("file_too_large",
					СтрШаблон(НСтр("ru = 'Файл «%1» не может быть принят для проверки заявки -
						|приложите документ с реквизитами отдельным файлом.'"), ИмяФайла)));
			Иначе
				Сверка.НеУчтенныеФайлы.Добавить(СтрШаблон(НСтр("ru = 'Файл «%1» слишком большой для
					|проверки - не учитывался.'"), ИмяФайла));
			КонецЕсли;

		ИначеЕсли СтатусФайла.Код = "unreadable" Тогда
			Если Рассматривается Тогда
				Сверка.Замечания.Добавить(ЗамечаниеСверки("file_unreadable",
					СтрШаблон(НСтр("ru = 'Файл «%1» не читается - если он обязателен,
						|приложите читаемую копию.'"), ИмяФайла)));
			Иначе
				Сверка.НеУчтенныеФайлы.Добавить(СтрШаблон(НСтр("ru = 'Файл «%1» не читается -
					|не учитывался.'"), ИмяФайла));
			КонецЕсли;

		ИначеЕсли СтатусФайла.Код = "not_related" И СтатусФайла.ДругиеЛица.Количество() = 0 Тогда
			Если Рассматривается И НЕ Состав.ЕстьФайлКонтрагента Тогда
				Приоритеты.Вставить("return", Истина);
				Сверка.Замечания.Добавить(ЗамечаниеСверки("file_not_related",
					ТекстФайлаБезДанныхКонтрагента(Контекст, ИмяФайла)
					+ " " + НСтр("ru = 'Приложите документ контрагента заявки.'")));
			Иначе
				Сверка.НеУчтенныеФайлы.Добавить(ТекстФайлаБезДанныхКонтрагента(Контекст, ИмяФайла)
					+ " " + НСтр("ru = 'Не учитывался.'"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Рассматривается ли файл сверкой (2.5.17): файл, приложенный до последнего
// возврата, не рассматривается, если после возврата приложены или изменены
// другие файлы. Поля структуры читаются методом БСП: Свойство платформы пишет
// в параметр Неопределено, когда ключа нет, и значение по умолчанию теряется
// (структура без полей давала не Булево, а Неопределено - падение теста
// ОМ_ar_ПакетНСИ.ТолькоЧужойФайлВозврат). Сверка и статус без этих полей -
// файл рассматривается.
//
// Параметры:
//  Сверка      - Структура - результат сверки (ЕстьНовыеФайлы).
//  СтатусФайла - Структура - статус из СтатусФайлаСверки (ДоВозврата).
//
// Возвращаемое значение:
//  Булево - Истина, если файл рассматривается сверкой (нет новых файлов
//           или файл не относится ко времени до возврата).
//
Функция ФайлРассматриваетсяСверкой(Знач Сверка, Знач СтатусФайла)

	ЕстьНовыеФайлы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Сверка, "ЕстьНовыеФайлы", Ложь);
	ДоВозврата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтатусФайла, "ДоВозврата", Ложь);
	Возврат НЕ (ЕстьНовыеФайлы И ДоВозврата);

КонецФункции

// Приложен ли файл до последнего возврата заявки (2.5.17): дата изменения
// файла (универсальная; нет - дата создания) не позже момента возврата.
//
// Параметры:
//  Файл           - Структура - файл из ФайлыЗаявкиДляСверки.
//  МоментВозврата - Дата      - универсальное время возврата; пустая - возвратов
//                   не было.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФайлПриложенДоВозврата(Знач Файл, Знач МоментВозврата)

	Если НЕ ЗначениеЗаполнено(МоментВозврата) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДатаФайла = Файл.ДатаМодификацииУниверсальная;
	Если НЕ ЗначениеЗаполнено(ДатаФайла) И ЗначениеЗаполнено(Файл.ДатаСоздания) Тогда
		ДатаФайла = УниверсальноеВремя(Файл.ДатаСоздания, ЧасовойПоясСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаФайла) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДатаФайла <= МоментВозврата;

КонецФункции

// «В файле «X» не найден ИНН контрагента заявки (…).» - для замечания возврата
// и списка не учтенных файлов (2.5.17). Для физлица без ИНН - что именно
// искалось (2.5.21).
Функция ТекстФайлаБезДанныхКонтрагента(Знач Контекст, Знач ИмяФайла)

	Если НЕ ПустаяСтрока(Контекст.ИНН) Тогда
		Возврат СтрШаблон(НСтр("ru = 'В файле «%1» не найден ИНН контрагента заявки (%2).'"),
			ИмяФайла, Контекст.ИНН);
	ИначеЕсли Контекст.ЭтоФизЛицо Тогда
		Возврат СтрШаблон(НСтр("ru = 'В файле «%1» не найдены ФИО, номер паспорта или расчётный счёт
			|физического лица из заявки.'"), ИмяФайла);
	Иначе
		Возврат СтрШаблон(НСтр("ru = 'В файле «%1» не найдены данные контрагента заявки.'"), ИмяФайла);
	КонецЕсли;

КонецФункции

// Проверка сданных моделью значений по частям относящихся файлов (шаг 7):
// цитаты, типы, контрольные числа, справочники. Значения сданных частей
// проверяются заново - итог сверки детерминирован и не доверяет прошлой сдаче.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат сверки (ПроверенныеЗначения заполняется).
//
Процедура ПроверитьСданныеЗначенияСверки(Знач Контекст, Знач Сверка)

	// Проверка значений повторяется по каждой сверке - итог детерминирован
	// и не доверяет прошлой сдаче (общая функция с дозаполнением).
	Сверка.Вставить("ПроверенныеЗначения",
		ПроверенныеЗначенияПоФайлам(Контекст, Сверка.СтатусыФайлов));

КонецПроцедуры

// Значения части в виде для ПроверитьЗначенияЧасти: соответствия {field, value,
// fragment}, как значения из JSON модели (структура не годится - проверка
// читает значения методом Получить).
//
// Параметры:
//  ЗначенияЧасти - Массив из Структура {Поле, Значение, Цитата} - ЗначенияИзJSONЧасти.
//
// Возвращаемое значение:
//  Массив из Соответствие.
//
Функция ЗначенияЧастиДляПроверки(Знач ЗначенияЧасти)

	Значения = Новый Массив;
	Для Каждого ЗначениеЧасти Из ЗначенияЧасти Цикл
		ЗначениеДляПроверки = Новый Соответствие;
		ЗначениеДляПроверки.Вставить("field", ЗначениеЧасти.Поле);
		ЗначениеДляПроверки.Вставить("value", ЗначениеЧасти.Значение);
		ЗначениеДляПроверки.Вставить("fragment", ЗначениеЧасти.Цитата);
		Значения.Добавить(ЗначениеДляПроверки);
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Сверка ключевых реквизитов (шаг 9): ИНН, КПП, ОГРН, счёт, БИК. Для файлов с
// одним лицом сверяются принятые значения файла, страховка - корректные счета
// и БИК текста; для файлов с несколькими лицами - только значения частей, где
// модель сдала ИНН заявки (блок нашего контрагента), страховки нет.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат сверки (Расхождения, Замечания пополняются).
//
Процедура СверкаКлючевыхРеквизитов(Знач Контекст, Знач Сверка)

	КлючевыеПоля = КлючевыеПоляСверки();

	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Если СтатусФайла.Код = "relevant_single" Тогда
			СверкаФайлаОдногоЛица(Контекст, Сверка, СтатусФайла, КлючевыеПоля);
		ИначеЕсли СтатусФайла.Код = "relevant_multi" Тогда
			СверкаФайлаНесколькихЛиц(Контекст, Сверка, СтатусФайла, КлючевыеПоля);
		КонецЕсли;
	КонецЦикла;

	Если Сверка.Расхождения.Количество() > 0 Тогда
		Сверка.Замечания.Добавить(ЗамечаниеСверки("mismatch",
			НСтр("ru = 'Реквизиты заявки не совпадают с документом - исправьте заявку или
				|приложите корректный документ.'")));
	КонецЕсли;

КонецПроцедуры

// Расхождение ключевого значения с заявкой: числовые поля - по цифрам
// (разделители и ведущие нули не важны), текстовые - ещё и по тексту
// (единое правило для файлов с одним и несколькими лицами).
//
// Возвращаемое значение:
//  Булево - Истина - значение файла не совпадает со значением заявки.
//
Функция ЕстьРасхождениеКлюча(Знач ЗначениеФайла, Знач ЗначениеЗаявки, Знач ИмяПоля)

	Если НормализованноеЧислоСтроки(ЗначениеФайла) <> НормализованноеЧислоСтроки(ЗначениеЗаявки) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат НЕ ЭтоЧисловоеПоле(ИмяПоля)
		И НормализованныйТекст(ЗначениеФайла) <> НормализованныйТекст(ЗначениеЗаявки);

КонецФункции

// Сверка файла с одним лицом (шаг 9): принятые значения + страховка по счетам
// и БИК текста.
Процедура СверкаФайлаОдногоЛица(Знач Контекст, Знач Сверка, Знач СтатусФайла, Знач КлючевыеПоля)

	// Счета и БИК наших организаций в файле (получатель платежа в справке
	// об оплате) - не реквизиты контрагента, с заявкой не сверяются.
	РеквизитыНаших = РеквизитыНашихОрганизацийФайла(Контекст, СтатусФайла);

	Для Каждого КлючИПоле Из КлючевыеПоля Цикл
		ЗначениеЗаявки = СтрокаРеквизитаКонтекста(Контекст, КлючИПоле.Значение);
		Если ПустаяСтрока(ЗначениеЗаявки) Тогда
			Продолжить; // В заявке пусто - сверять не с чем (только дозаполнение).
		КонецЕсли;

		Для Каждого Принятое Из ПринятыеЗначенияФайла(Контекст, Сверка, СтатусФайла.ИмяФайла,
			КлючИПоле.Ключ) Цикл
			Если ЭтоРеквизитНашейОрганизации(КлючИПоле.Ключ, Принятое.Значение, РеквизитыНаших) Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьРасхождениеКлюча(Принятое.Значение, ЗначениеЗаявки, КлючИПоле.Ключ) Тогда
				Сверка.Расхождения.Добавить(НовоеРасхождение(КлючИПоле.Ключ, ЗначениеЗаявки,
					Принятое.Значение, СтатусФайла.ИмяФайла, Принятое.Цитата));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Страховка: корректные счета и БИК текста (модель могла их не сообщить),
	// кроме реквизитов наших организаций.
	СчетаЛица = ЗначенияБезИсключенных(СтатусФайла.Счета, РеквизитыНаших.Счета);
	БикиЛица = ЗначенияБезИсключенных(СтатусФайла.Бики, РеквизитыНаших.Бики);
	Если НЕ ПустаяСтрока(Контекст.НомерСчета) И СчетаЛица.Количество() > 0
		И СтатусФайла.Счета.Найти(Контекст.НомерСчета) = Неопределено Тогда
		Сверка.Расхождения.Добавить(НовоеРасхождение("НомерОсновногоБанковскогоСчета", Контекст.НомерСчета,
			СчетаЛица[0], СтатусФайла.ИмяФайла, ""));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Контекст.БИК) И БикиЛица.Количество() > 0
		И СтатусФайла.Бики.Найти(Контекст.БИК) = Неопределено Тогда
		Сверка.Расхождения.Добавить(НовоеРасхождение("БИКБанка", Контекст.БИК,
			БикиЛица[0], СтатусФайла.ИмяФайла, ""));
	КонецЕсли;

КонецПроцедуры

// Сверка файла с несколькими лицами: только значения частей, где модель сдала
// ИНН заявки (или контрагента) - блок нашего контрагента; страховки нет (в
// тексте чужие счета).
Процедура СверкаФайлаНесколькихЛиц(Знач Контекст, Знач Сверка, Знач СтатусФайла, Знач КлючевыеПоля)

	Для Каждого СданнаяЧасть Из СданныеЧастиФайла(Контекст, СтатусФайла.ИмяФайла) Цикл
		Если ЧастьНашегоЛица(Контекст, СданнаяЧасть) = Ложь Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючИПоле Из КлючевыеПоля Цикл
			ЗначениеЗаявки = СтрокаРеквизитаКонтекста(Контекст, КлючИПоле.Значение);
			Если ПустаяСтрока(ЗначениеЗаявки) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Принятое Из ПринятыеЗначенияЧасти(Контекст, Сверка, СтатусФайла.ИмяФайла,
				СданнаяЧасть.Номер, КлючИПоле.Ключ) Цикл
				Если ЕстьРасхождениеКлюча(Принятое.Значение, ЗначениеЗаявки, КлючИПоле.Ключ) Тогда
					Сверка.Расхождения.Добавить(НовоеРасхождение(КлючИПоле.Ключ, ЗначениеЗаявки,
						Принятое.Значение, СтатусФайла.ИмяФайла, Принятое.Цитата));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Сдана ли в части наш контрагент: ИНН заявки среди лиц части или роль
// counterparty (для создания без ИНН заявки).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЧастьНашегоЛица(Знач Контекст, Знач СданнаяЧасть)

	Для Каждого Лицо Из СданнаяЧасть.Лица Цикл
		Если Лицо.Инн = Контекст.ИНН И НЕ ПустаяСтрока(Контекст.ИНН) Тогда
			Возврат Истина;
		КонецЕсли;
		Если Лицо.Роль = "counterparty" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Реквизит контекста сверки строкой (значения ключевых полей заявки).
Функция СтрокаРеквизитаКонтекста(Знач Контекст, Знач ИмяРеквизита)

	Значение = Неопределено;
	Контекст.Свойство(ИмяРеквизита, Значение);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Числовое ли ключевое поле (сравнение без ведущих нулей и разделителей).
Функция ЭтоЧисловоеПоле(Знач ИмяПоля)

	Возврат ИмяПоля = "ИНН" Или ИмяПоля = "РегистрационныйНомер"
		Или ИмяПоля = "НомерОсновногоБанковскогоСчета" Или ИмяПоля = "БИКБанка";

КонецФункции

// Принятые значения одного поля по всем сданным частям файла.
//
// Возвращаемое значение:
//  Массив из Структура {Значение, Цитата}.
//
Функция ПринятыеЗначенияФайла(Знач Контекст, Знач Сверка, Знач ИмяФайла, Знач ИмяПоля)

	Принятые = Новый Массив;
	ПроверенныеЧасти = Сверка.ПроверенныеЗначения.Получить(ИмяФайла);
	Если ПроверенныеЧасти = Неопределено Тогда
		Возврат Принятые;
	КонецЕсли;

	Для Каждого ЧастьСИтогами Из ПроверенныеЧасти Цикл
		ДополнитьПринятыеИтогами(Принятые, ЧастьСИтогами.Итоги, ИмяПоля);
	КонецЦикла;
	Возврат Принятые;

КонецФункции

// Принятые значения одного поля одной части файла.
Функция ПринятыеЗначенияЧасти(Знач Контекст, Знач Сверка, Знач ИмяФайла, Знач НомерЧасти,
	Знач ИмяПоля)

	Принятые = Новый Массив;
	ПроверенныеЧасти = Сверка.ПроверенныеЗначения.Получить(ИмяФайла);
	Если ПроверенныеЧасти = Неопределено Тогда
		Возврат Принятые;
	КонецЕсли;

	Для Каждого ЧастьСИтогами Из ПроверенныеЧасти Цикл
		Если ЧастьСИтогами.Номер = НомерЧасти Тогда
			ДополнитьПринятыеИтогами(Принятые, ЧастьСИтогами.Итоги, ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Принятые;

КонецФункции

// Дополняет список принятых значениями одного поля из итогов проверки.
Процедура ДополнитьПринятыеИтогами(Знач Принятые, Знач Итоги, Знач ИмяПоля)

	Для Каждого Итог Из Итоги Цикл
		Если Итог.Поле = ИмяПоля И Итог.Принято Тогда
			ЗначениеСтрокой = Итог.Значение;
			Если ТипЗнч(Итог.Приведенное) = Тип("СправочникСсылка.Контрагенты")
				Или (ТипЗнч(Итог.Приведенное) = Тип("СправочникСсылка.Банки") И ИмяПоля <> "БИКБанка") Тогда
				ЗначениеСтрокой = Строка(Итог.Приведенное);
			КонецЕсли;
			// Уникальные значения - одинаковые значения разных частей не дубль.
			УжеЕсть = Ложь;
			Для Каждого Принятое Из Принятые Цикл
				Если НормализованныйТекст(Принятое.Значение) = НормализованныйТекст(ЗначениеСтрокой) Тогда
					УжеЕсть = Истина;
				КонецЕсли;
			КонецЦикла;
			Если НЕ УжеЕсть Тогда
				Принятые.Добавить(Новый Структура("Значение, Цитата",
					ЗначениеСтрокой, Итог.Цитата));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Элемент расхождения сверки {field, in_request, in_file, file, fragment}.
Функция НовоеРасхождение(Знач ИмяПоля, Знач ВЗаявке, Знач ВФайле, Знач ИмяФайла, Знач Цитата)

	Возврат Новый Структура("field, in_request, in_file, file, fragment",
		ИмяПоля, ВЗаявке, ВФайле, ИмяФайла, Цитата);

КонецФункции

// Признак «Монополист» и подтверждающий файл (шаг 11, план 5.5): признак в
// заявке - нужен файл, все слова одной группы в тексте; часть слов -
// needs_review; файла нет - замечание возврата.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат сверки (Монополист, Замечания, ПунктыReview).
//
Процедура ПроверитьМонополистаСверки(Знач Контекст, Знач Сверка)

	Признак = ЗначениеМоделиПоИмени(Контекст.МодельСтало, "sd_Монополист");
	Сверка.Монополист.required = ЗначениеБулево(Признак);
	Если НЕ Сверка.Монополист.required Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
			Продолжить;
		КонецЕсли;
		Подтверждение = ТекстПодтверждаетМонополиста(СтатусФайла.ТекстНорм);
		Если Подтверждение = 2 Тогда
			Сверка.Монополист.confirmed = Истина;
			Сверка.Монополист.file = СтатусФайла.ИмяФайла;
			Возврат;
		ИначеЕсли Подтверждение = 1 Тогда
			Сверка.Монополист.partial = Истина;
			Если ПустаяСтрока(Сверка.Монополист.file) Тогда
				Сверка.Монополист.file = СтатусФайла.ИмяФайла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Сверка.Монополист.partial Тогда
		// Неуверенный признак - решает агент (план 5.5).
		Сверка.ПунктыReview.Добавить(Новый Структура("id, field, fragment",
			"monopolist", "sd_Монополист", Сверка.Монополист.file));
	Иначе
		Сверка.Замечания.Добавить(ЗамечаниеСверки("monopolist_no_document",
			НСтр("ru = 'Заявка с признаком «Монополист»: приложите выписку из реестра ФАС или
				|решение тендерного комитета либо снимите признак «Монополист».'")));
	КонецЕсли;

КонецПроцедуры

// Обязательные документы по виду контрагента (план 5.6): ЮЛ/ИП со счетом -
// документ, где найдены счет и БИК заявки; ФЛ со счетом - любой документ с
// банковскими реквизитами. Ключ счета не проходит по БИК - замечание возврата
// с кодом этапа 2 (bank_account_invalid_key): данные заявки неверны, документ
// их не исправит. Ключ верен, а счет документами не подтвержден - согласование
// не блокируется: признак СчетНеПодтвержденДокументами для отметки в
// комментарии визы при approve.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат сверки (Замечания пополняются).
//
Процедура ПроверитьОбязательныеДокументы(Знач Контекст, Знач Сверка) Экспорт

	Если НЕ Контекст.СчетВЗаявке Тогда
		Возврат;
	КонецЕсли;

	// Счет с неверным ключом не признается ни извлечением из текста (СчетаТекста
	// берет только счета с верным ключом), ни сданными значениями (отклоняются
	// при сдаче) - «ключ неверен» всегда дает «не найдено», поэтому проверка
	// ранняя и одинакова для ЮЛ и ФЛ.
	Если НЕ КлючСчетаКорректен(Контекст.НомерСчета, Контекст.БИК) Тогда
		Сверка.НезаполненОбязательныйДокумент = Истина;
		Сверка.Замечания.Добавить(ЗамечаниеСверки("bank_account_invalid_key",
			ТекстНеверногоКлючаСчета(Контекст.НомерСчета, Контекст.БИК)));
		Возврат;
	КонецЕсли;

	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
			Продолжить;
		КонецЕсли;
		СчетНайден = (СтатусФайла.Счета.Найти(Контекст.НомерСчета) <> Неопределено
			Или ПринятоеЗначениеСредиФайлов(Контекст, Сверка, "НомерОсновногоБанковскогоСчета",
				Контекст.НомерСчета, СтатусФайла.ИмяФайла));
		БикНайден = (СтатусФайла.Бики.Найти(Контекст.БИК) <> Неопределено
			Или ПринятоеЗначениеСредиФайлов(Контекст, Сверка, "БИКБанка",
				Контекст.БИК, СтатусФайла.ИмяФайла));

		Если Контекст.ЭтоФизЛицо Тогда
			Если СчетНайден Тогда
				Возврат; // ФЛ: достаточно документа с реквизитами счёта.
			КонецЕсли;
		ИначеЕсли СчетНайден И БикНайден Тогда
			Возврат; // ЮЛ/ИП: счёт и БИК найдены в одном документе.
		КонецЕсли;
	КонецЦикла;

	// Документ подтверждает реквизиты, а не является барьером: замечание не
	// ставится, НезаполненОбязательныйДокумент не взводится (вердикт - ready).
	Сверка.СчетНеПодтвержденДокументами = Истина;

КонецПроцедуры

// Файлы других организаций (2.4.4): файл не относится к заявке, и в нём есть
// ИНН другой организации. Возврат, если счёт заявки найден в таком файле
// (счёт принадлежит другому лицу) или файлов контрагента нет, а чужие есть
// (пользователь приложил не тот файл). Чужие файлы рядом с файлом контрагента
// не блокируют - упоминаются в комментарии визы (ОтметкаСверкиДляВизы).
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат сверки (Замечания, ЧужиеФайлыБлокируют).
//
Процедура ПроверитьЧужиеФайлы(Знач Контекст, Знач Сверка) Экспорт

	Состав = СоставФайловСверки(Сверка);

	Для Каждого СтатусФайла Из Состав.ЧужиеФайлы Цикл
		Если Контекст.СчетВЗаявке И НЕ ПустаяСтрока(Контекст.НомерСчета)
			И СтатусФайла.Счета.Найти(Контекст.НомерСчета) <> Неопределено Тогда
			Сверка.ЧужиеФайлыБлокируют = Истина;
			ТекстЗамечания = СтрШаблон(НСтр("ru = 'Расчётный счёт заявки %1 указан в файле «%2» другой
				|организации (ИНН %3) - проверьте счёт в заявке.'"),
				Контекст.НомерСчета, СтатусФайла.ИмяФайла, СтрСоединить(СтатусФайла.ДругиеЛица, ", "));
			Сверка.Замечания.Добавить(ЗамечаниеСверки("bank_account_other_person", ТекстЗамечания));
		КонецЕсли;
	КонецЦикла;

	Если Состав.ЕстьФайлКонтрагента Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтатусФайла Из Состав.ЧужиеФайлы Цикл
		// 2.5.17: чужой файл до возврата при новых файлах не блокирует.
		Если НЕ ФайлРассматриваетсяСверкой(Сверка, СтатусФайла) Тогда
			Продолжить;
		КонецЕсли;
		Сверка.ЧужиеФайлыБлокируют = Истина;
		ТекстЗамечания = ТекстФайлаДругойОрганизации(Контекст, СтатусФайла)
			+ " " + НСтр("ru = 'Приложите документ контрагента заявки.'");
		Сверка.Замечания.Добавить(ЗамечаниеСверки("file_other_person", ТекстЗамечания));
	КонецЦикла;

КонецПроцедуры

// Состав файлов сверки (2.4.4): есть ли файл контрагента и файлы других
// организаций (не относятся к заявке, в тексте есть чужой ИНН).
//
// Параметры:
//  Сверка - Структура - результат сверки (СтатусыФайлов).
//
// Возвращаемое значение:
//  Структура {ЕстьФайлКонтрагента - Булево, ЧужиеФайлы - Массив из Структура
//  (статусы файлов)}.
//
Функция СоставФайловСверки(Знач Сверка)

	Состав = Новый Структура("ЕстьФайлКонтрагента, ЧужиеФайлы", Ложь, Новый Массив);
	Для Каждого СтатусФайла Из Сверка.СтатусыФайлов Цикл
		Если СтатусФайла.Код = "relevant_single" Или СтатусФайла.Код = "relevant_multi" Тогда
			Состав.ЕстьФайлКонтрагента = Истина;
		ИначеЕсли СтатусФайла.Код = "not_related" И СтатусФайла.ДругиеЛица.Количество() > 0 Тогда
			Состав.ЧужиеФайлы.Добавить(СтатусФайла);
		Иначе
			Продолжить; // Ожидает распознавания, не читается, без чужого ИНН.
		КонецЕсли;
	КонецЦикла;
	Возврат Состав;

КонецФункции

// «Файл «X» относится к другой организации (ИНН …), а не к контрагенту заявки
// (ИНН …).» - для замечания возврата и комментария визы.
Функция ТекстФайлаДругойОрганизации(Знач Контекст, Знач СтатусФайла)

	Если ПустаяСтрока(Контекст.ИНН) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Файл «%1» относится к другой организации (ИНН %2), а не к
			|контрагенту заявки.'"),
			СтатусФайла.ИмяФайла, СтрСоединить(СтатусФайла.ДругиеЛица, ", "));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Файл «%1» относится к другой организации (ИНН %2), а не к
		|контрагенту заявки (ИНН %3).'"),
		СтатусФайла.ИмяФайла, СтрСоединить(СтатусФайла.ДругиеЛица, ", "), Контекст.ИНН);

КонецФункции

// Принято ли значение поля именно в этом файле.
Функция ПринятоеЗначениеСредиФайлов(Знач Контекст, Знач Сверка, Знач ИмяПоля,
	Знач ЗначениеПоиска, Знач ИмяФайла)

	Для Каждого Принятое Из ПринятыеЗначенияФайла(Контекст, Сверка, ИмяФайла, ИмяПоля) Цикл
		Если НормализованноеЧислоСтроки(Принятое.Значение) = НормализованноеЧислоСтроки(ЗначениеПоиска) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Официальные данные ЕГР по заявке (п. 4а.4): сверка КПП и ОГРН с заявкой,
// статус ликвидации; кэш в контексте (для решения - из ответа сверки запуска).
//
// Параметры:
//  Контекст - Структура - контекст сверки (ОфициальныеДанные кэшируются).
//  Сверка   - Структура - результат сверки (Официальные, Замечания).
//
Процедура ОфициальныеДанныеЗаявки(Знач Контекст, Знач Сверка)

	Если Контекст.ОфициальныеДанные <> Неопределено Тогда
		Сверка.Официальные = Контекст.ОфициальныеДанные;
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("result", "not_performed");
	Результат.Вставить("remarks", Новый Массив);
	Результат.Вставить("kpp", "");
	Результат.Вставить("ogrn", "");
	Результат.Вставить("terminated", Ложь);
	// 2.5.3: дата прекращения деятельности (ДД.ММ.ГГГГ) - для вопроса инициатору.
	Результат.Вставить("termination_date", "");

	Если ПустаяСтрока(Контекст.ИНН) Тогда
		// ИНН в заявке нет (создание без ИНН) - сверять не с чем.
		Результат.result = "absent";
		Контекст.ОфициальныеДанные = Результат;
		Сверка.Официальные = Результат;
		Возврат;
	КонецЕсли;

	РеквизитыСервиса = ДанныеСервисаПоИНН(Контекст.ИНН);
	Если НЕ ПустаяСтрока(Строка(РеквизитыСервиса.ОписаниеОшибки)) Тогда
		Результат.remarks.Добавить(
			НСтр("ru = 'Сервис ЕГРЮЛ/ЕГРИП недоступен - сверка с официальными данными
				|пропущена.'"));
		Контекст.ОфициальныеДанные = Результат;
		Сверка.Официальные = Результат;
		Возврат;
	КонецЕсли;

	ДанныеОтвета = ДанныеОтветаОрганизации(РеквизитыСервиса, Контекст.ИНН);
	Результат.kpp = Строка(ДанныеОтвета.kpp);
	Результат.ogrn = Строка(ДанныеОтвета.ogrn);
	Результат.terminated = ЗначениеБулево(ДанныеОтвета.terminated);
	Если ТипЗнч(ДанныеОтвета.termination_date) = Тип("Дата") Тогда
		Результат.termination_date = Формат(ДанныеОтвета.termination_date, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Результат.result = "ok";

	Если НЕ ПустаяСтрока(Контекст.КПП) И НЕ ПустаяСтрока(Результат.kpp)
		И НормализованныйТекст(Результат.kpp) <> НормализованныйТекст(Контекст.КПП) Тогда
		Результат.result = "mismatch";
		Результат.remarks.Добавить(СтрШаблон(
			НСтр("ru = 'КПП заявки (%1) не совпадает с КПП по данным ЕГРЮЛ (%2).'"),
			Контекст.КПП, Результат.kpp));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Контекст.ОГРН) И НЕ ПустаяСтрока(Результат.ogrn)
		И НормализованныйТекст(Результат.ogrn) <> НормализованныйТекст(Контекст.ОГРН) Тогда
		Результат.result = "mismatch";
		Результат.remarks.Добавить(СтрШаблон(
			НСтр("ru = 'ОГРН заявки (%1) не совпадает с ОГРН по данным ЕГРЮЛ/ЕГРИП (%2).'"),
			Контекст.ОГРН, Результат.ogrn));
	КонецЕсли;
	Если Результат.terminated Тогда
		Результат.remarks.Добавить(
			НСтр("ru = 'По данным ЕГРЮЛ/ЕГРИП деятельность контрагента прекращена.'"));
	КонецЕсли;

	Контекст.ОфициальныеДанные = Результат;
	Сверка.Официальные = Результат;

КонецПроцедуры

// Лимит возвратов исчерпан - в сверке return недоступен (спека agentrunner-89
// п. 7), «return» убирается из допустимых решений. Вердикт «return» или
// «reject_candidate» (замечания инициатор так и не исправил) - отклонение:
// вердикт reject_candidate, единственное допустимое решение - reject (2.5.6:
// раньше - передача сотруднику handover).
//
// Параметры:
//  Сверка       - Структура - результат сверки (Вердикт, ДопустимыеРешения,
//                 Замечания, ЛимитВозвратовИсчерпан);
//  СсылкаЗаявки - ЛюбаяСсылка - заявка НСИ.
//
Процедура ПрименитьЛимитВозвратовКСверке(Знач Сверка, Знач СсылкаЗаявки)

	ЧислоВозвратов = ЧислоВозвратовЗаявки(СсылкаЗаявки);
	Лимит = ЛимитВозвратовЗаявки();
	Если ЧислоВозвратов < Лимит Тогда
		Возврат;
	КонецЕсли;

	Если Сверка.Вердикт = "return" Или Сверка.Вердикт = "reject_candidate" Тогда
		// Замечание попадает в протокол решения у заявки - текст без обращения
		// к агенту.
		ТекстЗамечания = СтрШаблон(
			НСтр("ru = 'Лимит возвратов на исправление исчерпан (%1 из %2), замечания
				|не исправлены - заявка отклоняется.'"),
			ЧислоВозвратов, Лимит);
		Сверка.Замечания.Добавить(ЗамечаниеСверки("return_limit_reached", ТекстЗамечания));
		Сверка.ЛимитВозвратовИсчерпан = Истина;
		Сверка.Вердикт = "reject_candidate";
		ДоступныеРешения = Новый Массив;
		ДоступныеРешения.Добавить("reject");
		Сверка.ДопустимыеРешения = ДоступныеРешения;
		Возврат;
	КонецЕсли;

	ДоступныеРешения = Новый Массив;
	Для Каждого Решение Из Сверка.ДопустимыеРешения Цикл
		Если Решение <> "return" Тогда
			ДоступныеРешения.Добавить(Решение);
		КонецЕсли;
	КонецЦикла;
	Сверка.ДопустимыеРешения = ДоступныеРешения;

КонецПроцедуры

// Вердикт сверки по поднятым причинам (п. 4а.7) и допустимые решения.
//
// Параметры:
//  Контекст   - Структура    - контекст сверки.
//  Сверка     - Структура    - результат сверки (Вердикт, ДопустимыеРешения).
//  Приоритеты - Соответствие - причины (files_pending/return/reject_candidate).
//
Процедура ВердиктСверкиПоПричинам(Знач Контекст, Знач Сверка, Знач Приоритеты)

	// Расхождения и невыполненные проверки обработки - возврат.
	Если Сверка.Расхождения.Количество() > 0 Тогда
		Приоритеты.Вставить("return", Истина);
	КонецЕсли;

	Если Сверка.ОбработкаПроверки <> Неопределено
		И Сверка.ОбработкаПроверки.КодОшибки = "" Тогда
		Данные = Сверка.ОбработкаПроверки.Данные;
		Если ЗначениеБулево(Данные.Получить("checked"))
			И НЕ ЗначениеБулево(Данные.Получить("all_checks_passed")) Тогда
			// Точный дубль при создании - кандидат на отклонение, прочие замечания -
			// возврат.
			Если Контекст.ДляСоздания И ЕстьЗамечаниеОбработки(Данные, "НетДубляИННКППНаименование") Тогда
				Приоритеты.Вставить("reject_candidate", Истина);
			Иначе
				Приоритеты.Вставить("return", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// «Монополист» без подтверждающего файла, нет обязательного документа -
	// возврат; нечитаемый обязательный документ - возврат.
	Если Сверка.Монополист.required И НЕ Сверка.Монополист.confirmed
		И НЕ Сверка.Монополист.partial Тогда
		Приоритеты.Вставить("return", Истина);
	КонецЕсли;
	Если Сверка.НезаполненОбязательныйДокумент Тогда
		Приоритеты.Вставить("return", Истина);
	КонецЕсли;
	// 2.4.4: только файлы других организаций или счёт заявки в чужом файле.
	Если Сверка.ЧужиеФайлыБлокируют Тогда
		Приоритеты.Вставить("return", Истина);
	КонецЕсли;

	// ЕГР: расхождение - возврат; ликвидация: создание - кандидат на отклонение,
	// изменение - возврат; недоступен - сверка пропущена, не блокирует ни вердикт,
	// ни approve (обязательна только при автоактуализации).
	Если Сверка.Официальные <> Неопределено Тогда
		Если Сверка.Официальные.result = "mismatch" Тогда
			Приоритеты.Вставить("return", Истина);
		ИначеЕсли Сверка.Официальные.terminated Тогда
			Если Контекст.ДляСоздания Тогда
				Приоритеты.Вставить("reject_candidate", Истина);
			Иначе
				Приоритеты.Вставить("return", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Неопределенный сценарий - возврат инициатору с замечанием (2.5.6: агент
	// заявки сотруднику не передает); режим «только возврат» - передача.
	Сверка.СценарийОпределен = СценарийОпределен(Контекст.Сценарий);
	Если НЕ Сверка.СценарийОпределен Тогда
		Сверка.Замечания.Добавить(ЗамечаниеСверки("scenario_not_determined",
			НСтр("ru = 'Не определён вид контрагента или резидентность: укажите в заявке
				|«Юридическое / физическое лицо» и признак «Нерезидент».'")));
		Приоритеты.Вставить("return", Истина);
	КонецЕсли;
	Если НастройкаИстинна(ar_Настройки.ЗначениеНастройки("НСИАгентТолькоВозвращает", Ложь)) Тогда
		Приоритеты.Вставить("handover", Истина);
	КонецЕсли;

	// Не все относящиеся файлы сданы.
	Если ФайлыСлева(Сверка.СтатусыФайлов, Контекст).Количество() > 0 Тогда
		Приоритеты.Вставить("files_not_submitted", Истина);
	КонецЕсли;

	Сверка.Вердикт = ВердиктПоПриоритету(Приоритеты);
	Сверка.ДопустимыеРешения = ДопустимыеРешенияПоВердикту(Сверка.Вердикт);

	// agentrunner-89 (спека п. 7): лимит возвратов исчерпан - return недоступен.
	ПрименитьЛимитВозвратовКСверке(Сверка, Контекст.СсылкаЗаявки);

КонецПроцедуры

// Найденная карточка-дубль из замечания НетДубляИННКППНаименование обработки
// проверки: value_in_base - представление с кодом, ref_in_base - навигационная
// ссылка (обработка проверки с 1.4.6; в старых версиях ссылки нет).
//
// Параметры:
//  Сверка - Структура - результат сверки (ОбработкаПроверки).
//
// Возвращаемое значение:
//  Структура - {Представление, Ссылка - Строка}; Неопределено - замечания нет.
//
Функция КарточкаДубляСверки(Знач Сверка)

	Если Сверка.ОбработкаПроверки = Неопределено
		Или Сверка.ОбработкаПроверки.КодОшибки <> "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Замечания = Сверка.ОбработкаПроверки.Данные.Получить("remarks");
	Если ТипЗнч(Замечания) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		Если ТипЗнч(Замечание) <> Тип("Соответствие")
			Или Строка(Замечание.Получить("code")) <> "НетДубляИННКППНаименование" Тогда
			Продолжить;
		КонецЕсли;
		Представление = Замечание.Получить("value_in_base");
		Ссылка = Замечание.Получить("ref_in_base");
		Если ТипЗнч(Представление) <> Тип("Строка") Или ПустаяСтрока(Представление) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Представление, Ссылка", Представление,
			?(ТипЗнч(Ссылка) = Тип("Строка"), Ссылка, ""));
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Есть ли среди замечаний обработки проверка с кодом (НетДубляИННКППНаименование).
Функция ЕстьЗамечаниеОбработки(Знач ДанныеПроверки, Знач КодЗамечания)

	Замечания = ДанныеПроверки.Получить("remarks");
	Если ТипЗнч(Замечания) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Замечание Из Замечания Цикл
		Если ТипЗнч(Замечание) = Тип("Соответствие")
			И Строка(Замечание.Получить("code")) = КодЗамечания Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Текст отказа request_excluded_external_system.
Функция ТекстЗаявкаИсключена()

	Возврат НСтр("ru = 'Заявка связана с исключённой внешней системой и не обрабатывается
		|агентом НСИ. Заверши работу без вызова инструментов по этой заявке.'");

КонецФункции

// Лог каждого вызова сверки (для замера на стенде и разбора инцидентов).
Процедура ЗаписатьЛогСверки(Знач Контекст, Знач Сверка)

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_verify_request", СтрШаблон(
		НСтр("ru = '%1: вердикт %2, файлов %3, расхождений %4, замечаний %5'"),
		Строка(Контекст.СсылкаЗаявки), Сверка.Вердикт,
		Формат(Сверка.СтатусыФайлов.Количество(), "ЧГ=0"),
		Формат(Сверка.Расхождения.Количество(), "ЧГ=0"),
		Формат(Сверка.Замечания.Количество(), "ЧГ=0")));

КонецПроцедуры

// Полный JSON-ответ сверки (п. 4а спеки): вердикт, решения, поля, файлы,
// первая порция частей, файлы слева, расхождения, монополист, проверки
// обработки, ЕГР, needs_review, замечания, next.
//
// Параметры:
//  Контекст - Структура - контекст сверки.
//  Сверка   - Структура - результат ВычислитьСверкуЗаявки.
//
// Возвращаемое значение:
//  Структура - ответ-observation.
//
Функция ПолныйОтветСверки(Знач Контекст, Знач Сверка)

	Ответ = Новый Структура;
	// request нужен ОфициальныеИзДействияСверки - отбор ответов сверки запуска
	// по заявке (ЕГР - из кэша запуска, п. 5 спеки).
	Ответ.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(Контекст.СсылкаЗаявки));
	Ответ.Вставить("verdict", Сверка.Вердикт);
	Ответ.Вставить("allowed_decisions", Сверка.ДопустимыеРешения);
	Ответ.Вставить("model_hash", Контекст.ХешТекущий);
	Ответ.Вставить("scenario", Контекст.Сценарий);
	Ответ.Вставить("fields", ПоляДляИзвлечения(Контекст));
	Ответ.Вставить("files", Сверка.ФайлыОтвет);
	Ответ.Вставить("parts", СледующаяПорцияЧастей(Сверка.СтатусыФайлов, Контекст));
	Ответ.Вставить("files_left", ФайлыСлева(Сверка.СтатусыФайлов, Контекст));
	Ответ.Вставить("mismatches", Сверка.Расхождения);
	Ответ.Вставить("monopolist", Сверка.Монополист);

	Ответ.Вставить("requisites", РеквизитыОтветСверки(Сверка));

	Если Сверка.Официальные <> Неопределено Тогда
		Ответ.Вставить("official", Сверка.Официальные);
	КонецЕсли;

	Ответ.Вставить("needs_review", Сверка.ПунктыReview);
	Ответ.Вставить("remarks", Сверка.Замечания);
	Если Сверка.НеУчтенныеФайлы.Количество() > 0 Тогда
		Ответ.Вставить("ignored_files", Сверка.НеУчтенныеФайлы);
	КонецЕсли;
	Ответ.Вставить("next", СледующийШагСверки(Сверка));

	Возврат Ответ;

КонецФункции

// Раздел requisites ответа сверки: итог проверки данных обработкой.
//
// Возвращаемое значение:
//  Структура {checked, all_checks_passed, summary, remarks, remarks_text}
//  либо {error, message} при ошибке вызова обработки.
//
Функция РеквизитыОтветСверки(Знач Сверка)

	Ответ = Новый Структура;
	Если Сверка.ОбработкаПроверки = Неопределено Тогда
		Ответ.Вставить("error", "check_processing_not_found");
		Возврат Ответ;
	КонецЕсли;

	Если Сверка.ОбработкаПроверки.КодОшибки <> "" Тогда
		Ответ.Вставить("error", Сверка.ОбработкаПроверки.КодОшибки);
		Ответ.Вставить("message", Сверка.ОбработкаПроверки.Сообщение);
		Возврат Ответ;
	КонецЕсли;

	Возврат Сверка.ОбработкаПроверки.Данные;

КонецФункции

// Подсказка модели - следующий шаг по вердикту сверки.
Функция СледующийШагСверки(Знач Сверка)

	Если Сверка.Вердикт = "files_not_submitted" Тогда
		Возврат "nsi_submit_file_data";
	ИначеЕсли Сверка.Вердикт = "ready" Тогда
		Возврат "nsi_set_visa_decision";
	ИначеЕсли Сверка.Вердикт = "handover" Или Сверка.Вердикт = "return"
		Или Сверка.Вердикт = "reject_candidate" Тогда
		Возврат "nsi_set_visa_decision";
	КонецЕсли;
	Возврат "finish";

КонецФункции

#КонецОбласти

#Область ИнструментЭтапДва

// Данные заявки на этапе 2 (п. 3 спеки): виза 1, контрагент, созданный/изменённый
// визой 1, счёт из заявки, признак изменения модели после визы 1 и следующий шаг
// («nsi_set_visa_decision approve», «return: <замечания>» при ошибках счёта
// заявки, «restart: <причина>» - заявка изменена после визы 1, либо
// «handover: <причина>»).
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ДанныеЗаявки - Структура - шапка и ПОО (из nsi_get_request).
//  МодельСтало  - Структура - модель заявки «стало».
//  ХешТекущий   - Строка    - текущий model_hash заявки.
//
// Возвращаемое значение:
//  Структура {Виза1, Контрагент, СчетЗаявки, МодельИзменена - Булево,
//  СледующийШаг - Строка}.
//
Функция ДанныеЭтапаДва(Знач Контекст, Знач СсылкаЗаявки, Знач ДанныеЗаявки,
	Знач МодельСтало, Знач ХешТекущий)

	Результат = Новый Структура;
	Результат.Вставить("Виза1", Неопределено);
	Результат.Вставить("Контрагент", КонтрагентЭтапаДва(ДанныеЗаявки.Шапка));
	Результат.Вставить("СчетЗаявки", СчетЗаявкиЭтапаДва(МодельСтало, ДанныеЗаявки.Шапка));
	Результат.Вставить("МодельИзменена", Ложь);
	Результат.Вставить("СледующийШаг", "nsi_set_visa_decision");

	Виза1 = ДанныеВизы1(СсылкаЗаявки);
	Результат.Виза1 = Виза1;

	ПричиныПередачи = ПричиныПередачиЭтапаДва(Контекст, СсылкаЗаявки, ДанныеЗаявки,
		МодельСтало, ХешТекущий, Виза1, Результат.СчетЗаявки);
	Результат.МодельИзменена = ПричиныПередачи.МодельИзменена;
	ПричиныВозврата = ПричиныВозвратаСчета(Результат.СчетЗаявки);
	Если ПричиныПередачи.Причины.Количество() > 0 Тогда
		Результат.СледующийШаг = "handover: " + СтрСоединить(ПричиныПередачи.Причины, "; ");
	ИначеЕсли ПричиныПередачи.ПричиныПовторногоЦикла.Количество() > 0 Тогда
		Результат.СледующийШаг = "restart: "
			+ СтрСоединить(ПричиныПередачи.ПричиныПовторногоЦикла, "; ");
	ИначеЕсли ПричиныВозврата.Количество() > 0 Тогда
		Результат.СледующийШаг = "return: " + СтрСоединить(ПричиныВозврата, " ");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Виза этапа 1 агента заявки: решение и дата (должно быть «Согласовано»).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура {decision, decision_date, approved - Булево} или Неопределено,
//  когда константа GUID этапа 1 пуста либо записи нет.
//
Функция ДанныеВизы1(Знач СсылкаЗаявки)

	ВизаЭтапа1 = СсылкаВизыЭтапа(1);
	Если НЕ ЗначениеЗаполнено(ВизаЭтапа1) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	Отбор.Вставить("Виза", ВизаЭтапа1);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗаписьВизы = НаборВизы[0];
	Виза1 = Новый Структура;
	Виза1.Вставить("decision",
		?(ЗначениеЗаполнено(ЗаписьВизы.Решение), Строка(ЗаписьВизы.Решение), Неопределено));
	Виза1.Вставить("decision_date",
		?(ЗначениеЗаполнено(ЗаписьВизы.ДатаУстановки), ЗаписьВизы.ДатаУстановки, Неопределено));
	Виза1.Вставить("approved", ЗаписьВизы.Решение
		= Справочники.бит_ВидыРешенийСогласования.Согласовано);
	Возврат Виза1;

КонецФункции

// Контрагент этапа 2 (п. 3): контрагент заявки (создан/изменён визой 1) с
// ИНН/КПП и признаком существования; не задан - exists = false.
//
// Параметры:
//  Шапка - Структура - шапка заявки (Предмет).
//
// Возвращаемое значение:
//  Структура {ref, presentation, exists, inn, kpp} (inn/kpp - null, если нет).
//
Функция КонтрагентЭтапаДва(Знач Шапка)

	Результат = Новый Структура;
	Результат.Вставить("ref", Неопределено);
	Результат.Вставить("presentation", Неопределено);
	Результат.Вставить("exists", Ложь);
	Результат.Вставить("inn", Неопределено);
	Результат.Вставить("kpp", Неопределено);

	Если НЕ ЗначениеЗаполнено(Шапка.Предмет) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ref = ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Предмет);
	Результат.presentation = Шапка.ПредметПредставление;

	Если НЕ ОбщегоНазначения.СсылкаСуществует(Шапка.Предмет) Тогда
		Возврат Результат; // exists = false: контрагент не создан.
	КонецЕсли;

	Результат.exists = Истина;
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шапка.Предмет, "ИНН, КПП");
	Результат.inn = ?(ПустаяСтрока(СокрЛП(Строка(РеквизитыКонтрагента.ИНН))),
		Неопределено, СокрЛП(Строка(РеквизитыКонтрагента.ИНН)));
	Результат.kpp = ?(ПустаяСтрока(СокрЛП(Строка(РеквизитыКонтрагента.КПП))),
		Неопределено, СокрЛП(Строка(РеквизитыКонтрагента.КПП)));

	Возврат Результат;

КонецФункции

// Счёт из заявки для этапа 2 (п. 3): доп. реквизиты модели НомерОсновногоБанковскогоСчета
// и БИКБанка; банк, ключ счёта, есть ли уже такой счёт у контрагента заявки.
//
// Параметры:
//  МодельСтало - Структура - модель заявки «стало».
//  Шапка       - Структура - шапка заявки (Предмет - владелец счёта).
//
// Возвращаемое значение:
//  Структура {in_request, number, bik, bank, bank_active, key_valid,
//  exists_at_counterparty}.
//
Функция СчетЗаявкиЭтапаДва(Знач МодельСтало, Знач Шапка)

	Результат = Новый Структура;
	Результат.Вставить("in_request", Ложь);
	Результат.Вставить("number", "");
	Результат.Вставить("bik", "");
	Результат.Вставить("bank", Неопределено);
	Результат.Вставить("bank_active", Ложь);
	Результат.Вставить("key_valid", Ложь);
	Результат.Вставить("exists_at_counterparty", Ложь);

	Значения = ЗначенияДопРеквизитовМодели(МодельСтало);
	НомерСчета = СтрЗаменить(Строка(Значения.Получить("НомерОсновногоБанковскогоСчета")), " ", "");
	БИК = НормализованноеЧислоСтроки(Значения.Получить("БИКБанка"));

	Результат.number = НомерСчета;
	Результат.bik = БИК;
	Результат.in_request = (НЕ ПустаяСтрока(НомерСчета) И НЕ ПустаяСтрока(БИК));
	Если НЕ Результат.in_request Тогда
		Возврат Результат; // Счёта в заявке нет - этап 2 сразу «Согласовано».
	КонецЕсли;

	Банк = Неопределено;
	Найден = Ложь;
	Действует = Ложь;
	Банк = БанкПоБик(БИК, Найден, Действует);
	Если Найден Тогда
		Результат.bank = Строка(Банк);
		Результат.bank_active = Действует;
	КонецЕсли;

	Результат.key_valid = КлючСчетаКорректен(НомерСчета, БИК);

	// Счёт с этим номером у контрагента заявки. Такой же счёт у другого
	// контрагента не мешает (agentrunner-213, решение человека): счёт создаётся
	// и у контрагента заявки.
	Если НЕ ЗначениеЗаполнено(Шапка.Предмет) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("Владелец", Шапка.Предмет);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Владелец
		|	И Счета.НомерСчета = &НомерСчета
		|	И НЕ Счета.ПометкаУдаления";
	Результат.exists_at_counterparty = НЕ Запрос.Выполнить().Пустой();

	Возврат Результат;

КонецФункции

// Причины передачи сотруднику НСИ и повторного цикла на этапе 2 (п. 3).
// Передача: виза 1 не «Согласовано», контрагент не создан, лимит повторных
// циклов исчерпан. Повторный цикл (agentrunner-213, решение человека): заявка
// изменена после визы 1 или хеш визы 1 не найден в протоколе - визы
// сбрасываются, заявка проходит этапы 1 и 2 заново (решение restart). Ошибки
// счёта заявки (банк не найден/не действует, ключ счёта неверен) - возврат
// инициатору: ПричиныВозвратаСчета.
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ДанныеЗаявки - Структура - шапка и ПОО.
//  МодельСтало  - Структура - модель «стало».
//  ХешТекущий   - Строка    - текущий model_hash.
//  ДанныеВизы1  - Структура - результат ДанныеВизы1 (может быть Неопределено).
//  СчетЗаявки   - Структура - результат СчетЗаявкиЭтапаДва.
//
// Возвращаемое значение:
//  Структура {Причины - Массив из Строка (передача), ПричиныПовторногоЦикла -
//  Массив из Строка, МодельИзменена - Булево}.
//
Функция ПричиныПередачиЭтапаДва(Знач Контекст, Знач СсылкаЗаявки, Знач ДанныеЗаявки,
	Знач МодельСтало, Знач ХешТекущий, Знач ДанныеВизы1, Знач СчетЗаявки)

	Результат = Новый Структура;
	Результат.Вставить("Причины", Новый Массив);
	Результат.Вставить("ПричиныПовторногоЦикла", Новый Массив);
	Результат.Вставить("МодельИзменена", Ложь);

	Если ДанныеВизы1 = Неопределено Или НЕ ЗначениеБулево(ДанныеВизы1.approved) Тогда
		Результат.Причины.Добавить("виза первого этапа не согласована");
	КонецЕсли;

	Предмет = ДанныеЗаявки.Шапка.Предмет;
	Если НЕ ЗначениеЗаполнено(Предмет)
		Или НЕ ОбщегоНазначения.СсылкаСуществует(Предмет) Тогда
		Результат.Причины.Добавить("контрагент не создан после визы 1");
	КонецЕсли;

	// Заявку не меняли между визами: model_hash из протокола визы 1.
	ХешВизы1 = ХешИзПротоколаВизы1(СсылкаЗаявки);
	Если ПустаяСтрока(ХешВизы1) Тогда
		// Протокол визы 1 без model_hash (старые данные) - подтвердить
		// неизменность нельзя, заявка проходит визы заново.
		Результат.МодельИзменена = Истина;
		Результат.ПричиныПовторногоЦикла.Добавить("хеш модели визы 1 не найден в протоколе");
	ИначеЕсли ХешВизы1 <> ХешТекущий Тогда
		Результат.МодельИзменена = Истина;
		Результат.ПричиныПовторногоЦикла.Добавить("заявка изменена после визы 1");
	Иначе
		Результат.МодельИзменена = Ложь; // Заявка не менялась после визы 1.
	КонецЕсли;

	Если Результат.ПричиныПовторногоЦикла.Количество() > 0
		И НЕ ПовторныйЦиклРазрешен(СсылкаЗаявки) Тогда
		Для Каждого Причина Из Результат.ПричиныПовторногоЦикла Цикл
			Результат.Причины.Добавить(Причина);
		КонецЦикла;
		Результат.Причины.Добавить(СтрШаблон(
			"лимит повторных циклов визирования исчерпан (%1)",
			ЧислоНастройки("НСИЛимитПовторныхЦиклов", 2)));
		Результат.ПричиныПовторногоЦикла.Очистить();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Повторный цикл визирования разрешён лимитом НСИЛимитПовторныхЦиклов
// (agentrunner-213): записанные решения restart считаются по блокам протоколов
// проверки («Решение: restart», «Итог записи: записано») - визы перепроведение
// стирает, протоколы остаются. Файлы до 2.5.1 («... (повторный цикл) <дата>»,
// один блок без заголовка) считаются так же.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПовторныйЦиклРазрешен(Знач СсылкаЗаявки)

	ЧислоЦиклов = 0;
	Для Каждого ТекстФайла Из ТекстыПротоколовПроверки(СсылкаЗаявки) Цикл
		Для Каждого Блок Из БлокиПротокола(ТекстФайла) Цикл
			Если Блок.Решение = "restart" И Блок.ИтогЗаписи = "записано" Тогда
				ЧислоЦиклов = ЧислоЦиклов + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ЧислоЦиклов < ЧислоНастройки("НСИЛимитПовторныхЦиклов", 2);

КонецФункции

// Причины возврата заявки инициатору на этапе 2 по счёту заявки
// (agentrunner-213): банк по БИК не найден или не действует, контрольный ключ
// счёта неверен - данные заявки неверны, их исправляет инициатор. Тексты -
// замечания возврата (комментарий визы и письмо). Такой же счёт у другого
// контрагента ошибкой не считается (решение человека).
//
// Параметры:
//  СчетЗаявки - Структура - результат СчетЗаявкиЭтапаДва.
//
// Возвращаемое значение:
//  Массив из Строка - пустой, если счёта в заявке нет или он без ошибок.
//
Функция ПричиныВозвратаСчета(Знач СчетЗаявки)

	Причины = Новый Массив;
	Если НЕ СчетЗаявки.in_request Тогда
		Возврат Причины;
	КонецЕсли;

	Если СчетЗаявки.bank = Неопределено Тогда
		ТекстПричины = СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 не найден в справочнике банков - проверьте БИК.'"),
			СчетЗаявки.bik);
		Причины.Добавить(ТекстПричины);
	КонецЕсли;

	Если СчетЗаявки.bank <> Неопределено И НЕ СчетЗаявки.bank_active Тогда
		ТекстПричины = СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 не действует - укажите действующий счёт.'"),
			СчетЗаявки.bik);
		Причины.Добавить(ТекстПричины);
	КонецЕсли;

	Если НЕ СчетЗаявки.key_valid Тогда
		Причины.Добавить(ТекстНеверногоКлючаСчета(СчетЗаявки.number, СчетЗаявки.bik));
	КонецЕсли;

	Возврат Причины;

КонецФункции

// Замечание возврата «неверный контрольный ключ счёта» (bank_account_invalid_key)
// - одно для сверки этапа 1 и причин возврата этапа 2: одинаковый текст не
// задваивается в комментарии визы. Документы здесь ни при чём - номер счёта не
// сходится с БИК (agentrunner-278, заявка 00-00093928: исправлен БИК).
//
// Параметры:
//  НомерСчета - Строка - номер счёта заявки.
//  БИК        - Строка - БИК банка заявки.
//
// Возвращаемое значение:
//  Строка - текст замечания.
//
Функция ТекстНеверногоКлючаСчета(Знач НомерСчета, Знач БИК)

	Возврат СтрШаблон(
		НСтр("ru = 'Номер расчётного счёта %1 не соответствует БИК банка %2 (не сходится
			|контрольный ключ) - проверьте номер счёта и БИК в заявке.'"),
		НомерСчета, БИК);

КонецФункции

// Хеш модели из протокола визы 1 (п. 3 спеки): протоколы агента у заявки
// («Протокол проверки агентом ...»), в блоке записанного approve этапа 1 -
// строка «model_hash: <hex>» (пишет протокол решения). Берется самый поздний
// такой блок (2.5.1: блоки дописываются в один файл - по порядку записи).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Строка - 64 hex-символа; "" - протокол с хешем не найден.
//
Функция ХешИзПротоколаВизы1(Знач СсылкаЗаявки)

	Хеш = "";
	Для Каждого ТекстФайла Из ТекстыПротоколовПроверки(СсылкаЗаявки) Цикл
		Для Каждого Блок Из БлокиПротокола(ТекстФайла) Цикл
			ХешБлока = ХешВизы1ИзБлокаПротокола(Блок);
			Если НЕ ПустаяСтрока(ХешБлока) Тогда
				Хеш = ХешБлока;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Хеш;

КонецФункции

// Тексты протоколов проверки заявки («Протокол проверки агентом ...»,
// «Протокол ручного исполнения ...» - agentrunner-252; не помеченные на
// удаление) по возрастанию даты создания (ТекстПротоколаФайла); нечитаемый
// файл пропускается.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ТекстыПротоколовПроверки(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Владелец
		|	И НЕ Файлы.ПометкаУдаления
		|	И (Файлы.Наименование ПОДОБНО ""Протокол проверки агентом%""
		|		ИЛИ Файлы.Наименование ПОДОБНО ""Протокол ручного исполнения%"")
		|УПОРЯДОЧИТЬ ПО
		|	Файлы.ДатаСоздания";

	Тексты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Данные файла - из хранилища БСП (не запрос): протоколов у заявки единицы.
		ТекстФайла = ТекстПротоколаФайла(Выборка.Ссылка);
		Если НЕ ПустаяСтрока(ТекстФайла) Тогда
			Тексты.Добавить(ТекстФайла);
		КонецЕсли;
	КонецЦикла;

	Возврат Тексты;

КонецФункции

// Текст присоединённого текстового файла (протокола): двоичные данные БСП
// (РаботаСФайлами.ДвоичныеДанныеФайла) в строку UTF-8; ошибка чтения - "".
//
// Параметры:
//  СсылкаФайла - СправочникСсылка - присоединённый файл.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстПротоколаФайла(Знач СсылкаФайла)

	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла, Ложь);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);

КонецФункции

// Хеш модели из блока протокола записанного approve этапа 1 («Этап: 1»,
// «Решение: approve», «Итог записи: записано» - блок отказа не в счет).
// Предпочтительно - «model_hash_after: <hex>» (модель после записи решения:
// исполнение визы 1 механизмом «БИТ» может переписать модель, agentrunner-213),
// иначе «model_hash: <hex>» (модель на момент решения).
//
// Параметры:
//  Блок - Структура - блок протокола (см. БлокиПротокола).
//
// Возвращаемое значение:
//  Строка - хеш; "" - не найден либо блок не записанного approve этапа 1.
//
Функция ХешВизы1ИзБлокаПротокола(Знач Блок)

	// Длина хеша SHA-256 в hex-символах.
	ДлинаХеша = 64;

	Если Блок.Этап <> "1" Или Блок.Решение <> "approve" Или Блок.ИтогЗаписи <> "записано" Тогда
		Возврат "";
	КонецЕсли;

	Если СтрДлина(Блок.ХешПослеЗаписи) = ДлинаХеша Тогда
		Возврат Блок.ХешПослеЗаписи;
	КонецЕсли;
	Возврат ?(СтрДлина(Блок.ХешРешения) = ДлинаХеша, Блок.ХешРешения, "");

КонецФункции

// Блоки текста протокола (2.5.1): блок начинается строкой-заголовком
// (ЭтоЗаголовокБлокаПротокола); текст без заголовков (файлы до 2.5.1) - один
// блок. Из блока берутся первые значения строк «Решение:», «Этап:», «Итог
// записи:», «model_hash:», «model_hash_after:» (протокол модели - строки «- ...»,
// с ними не путаются).
//
// Параметры:
//  ТекстПротокола - Строка - текст файла протокола.
//
// Возвращаемое значение:
//  Массив из Структура {Решение, Этап, ИтогЗаписи, ХешРешения, ХешПослеЗаписи - Строка}.
//
Функция БлокиПротокола(Знач ТекстПротокола)

	Блоки = Новый Массив;
	Блок = Неопределено;
	Ключи = КлючиБлокаПротокола();

	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстПротокола) Цикл
		СтрокаПротокола = СокрЛП(СтрПолучитьСтроку(ТекстПротокола, НомерСтроки));
		Если Блок = Неопределено Или ЭтоЗаголовокБлокаПротокола(СтрокаПротокола) Тогда
			Блок = НовыйБлокПротокола();
			Блоки.Добавить(Блок);
		КонецЕсли;
		ЗаполнитьПолеБлокаПротокола(Блок, СтрокаПротокола, Ключи);
	КонецЦикла;

	Возврат Блоки;

КонецФункции

// Строка - заголовок блока (см. ЗаголовокБлокаПротокола): разделитель в начале
// и в конце строки. Строка комментария визы или данных файла, лишь начинающаяся
// с «=====», блок не открывает.
//
// Параметры:
//  СтрокаПротокола - Строка - строка протокола без краевых пробелов.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЗаголовокБлокаПротокола(Знач СтрокаПротокола)

	Разделитель = РазделительБлоковПротокола();
	Возврат СтрНачинаетсяС(СтрокаПротокола, Разделитель + " ")
		И СтрЗаканчиваетсяНа(СтрокаПротокола, " " + Разделитель);

КонецФункции

// Пустой блок протокола (см. БлокиПротокола).
//
// Возвращаемое значение:
//  Структура {Решение, Этап, ИтогЗаписи, ХешРешения, ХешПослеЗаписи - Строка}.
//
Функция НовыйБлокПротокола()

	Блок = Новый Структура;
	Блок.Вставить("Решение", "");
	Блок.Вставить("Этап", "");
	Блок.Вставить("ИтогЗаписи", "");
	Блок.Вставить("ХешРешения", "");
	Блок.Вставить("ХешПослеЗаписи", "");
	Возврат Блок;

КонецФункции

// Ключи строк протокола и поля блока для них. model_hash_after стоит раньше
// model_hash - общее начало ключа.
//
// Возвращаемое значение:
//  Массив из Структура {Ключ, Поле - Строка}.
//
Функция КлючиБлокаПротокола()

	Ключи = Новый Массив;
	Ключи.Добавить(НовыйКлючБлокаПротокола("model_hash_after:", "ХешПослеЗаписи"));
	Ключи.Добавить(НовыйКлючБлокаПротокола("model_hash:", "ХешРешения"));
	Ключи.Добавить(НовыйКлючБлокаПротокола("Решение:", "Решение"));
	Ключи.Добавить(НовыйКлючБлокаПротокола("Этап:", "Этап"));
	Ключи.Добавить(НовыйКлючБлокаПротокола("Итог записи:", "ИтогЗаписи"));
	Возврат Ключи;

КонецФункции

// Описание ключа строки протокола (см. КлючиБлокаПротокола).
//
// Параметры:
//  Ключ - Строка - начало строки протокола (сравнивается без учета регистра).
//  Поле - Строка - поле блока.
//
// Возвращаемое значение:
//  Структура {Ключ, Поле - Строка}.
//
Функция НовыйКлючБлокаПротокола(Знач Ключ, Знач Поле)

	ОписаниеКлюча = Новый Структура;
	ОписаниеКлюча.Вставить("Ключ", Ключ);
	ОписаниеКлюча.Вставить("Поле", Поле);
	Возврат ОписаниеКлюча;

КонецФункции

// Заполняет поле блока протокола значением строки «<ключ>: <значение>», если
// поле еще пустое (берется первое вхождение: продолжения комментария визы
// значений не перебивают).
//
// Параметры:
//  Блок            - Структура - блок (см. НовыйБлокПротокола), изменяется.
//  СтрокаПротокола - Строка    - строка протокола без краевых пробелов.
//  Ключи           - Массив    - см. КлючиБлокаПротокола.
//
Процедура ЗаполнитьПолеБлокаПротокола(Блок, Знач СтрокаПротокола, Знач Ключи)

	Для Каждого ОписаниеКлюча Из Ключи Цикл
		Если СтрНачинаетсяС(НРег(СтрокаПротокола), НРег(ОписаниеКлюча.Ключ)) Тогда
			Если ПустаяСтрока(Блок[ОписаниеКлюча.Поле]) Тогда
				Блок[ОписаниеКлюча.Поле] = СокрЛП(Сред(СтрокаПротокола, СтрДлина(ОписаниеКлюча.Ключ) + 1));
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Служебный лог визы вне этапов маршрута по заявке (visa_stage_unknown при
// чтении заявки - nsi_get_request не привязан к очереди, пишет сам).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Виза         - СправочникСсылка.бит_Визы.
//
Процедура ЛогНеизвестногоЭтапаЗаявки(Знач СсылкаЗаявки, Знач Виза)

	Текст = СтрШаблон(НСтр("ru = '%1: активная виза %2 не входит в этапы маршрута
		|(КонстантыGUID) - заявка агенту не выдаётся.'"),
		Строка(СсылкаЗаявки), Строка(Виза));
	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_stage_unknown", Текст);

КонецПроцедуры

#КонецОбласти

#Область ИнструментСдачиДанныхФайлов

// Реализация инструмента nsi_submit_file_data (п. 4б спеки): модель сдаёт
// данные частей файлов - лица (ИНН, роль) и значения реквизитов с дословными
// цитатами; пакет проверяет каждое значение (шаг 7), пересчитывает лица
// (шаги 8-10), дозаполняет пустые реквизиты заявки принятыми значениями
// (запись модели в проведённую заявку, визы не сбрасываются - О4) и возвращает
// следующую порцию частей и полный итог сверки, когда сдано всё.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {request, model_hash, parts: [...]}.
//  Контекст      - Структура - контекст запуска (RunId, Агент, DryRun).
//
// Возвращаемое значение:
//  Строка - JSON-observation либо {"error", "message"}.
//
Функция ВыполнитьСдачуДанныхФайлов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	DryRun = ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON);

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			?(ПустаяСтрока(ОтборЗаявки.Сообщение), ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение));
	КонецЕсли;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - отказ до чтения
	// и до записи (дозаполнение реквизитов).
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
	КонецЕсли;

	Если ЗаявкаИсключена(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("request_excluded_external_system", ТекстЗаявкаИсключена(), Истина);
	КонецЕсли;

	// agentrunner-96: модель заявки автоактуализации пишет nsi_actualize_request -
	// сдача данных файлов к сценарию не применяется.
	Если ЭтоЗаявкаАктуализацииПоСсылке(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("use_actualize_request", ТекстИспользуйАктуализацию());
	КонецЕсли;

	Решение = РешениеВЗапуске(Контекст);
	Если Решение.Есть И Решение.СсылкаЗаявки <> ОтборЗаявки.Ссылка Тогда
		Возврат ОшибкаИнструмента("run_already_decided", ТекстЗавершиРаботу(), Истина);
	КонецЕсли;

	ОтказЭтапа = ОтказПроверкиЭтапаСверки(Контекст, ОтборЗаявки.Ссылка, 1);
	Если ОтказЭтапа.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтказЭтапа.КодОшибки, ОтказЭтапа.Сообщение,
			ЭтоТерминальныйКодОтказа(ОтказЭтапа.КодОшибки));
	КонецЕсли;

	КонтекстСверки = КонтекстСверки(ОтборЗаявки.Ссылка);
	ОтказХеша = ХешАргументыСтруктура(Аргументы);
	Если ОтказПоХешуМодели(КонтекстСверки.ДанныеЗаявки, ОтказХеша) Тогда
		// Код и сообщение отказа (request_not_found либо request_changed) заполнила
		// ОтказПоХешуМодели - возвращаем их, а не предполагаемый request_changed.
		Возврат ОшибкаИнструмента(ОтказХеша.КодОшибки, ОтказХеша.Сообщение);
	КонецЕсли;

	ЧастиАргумента = ЗначениеИзКоллекции(Аргументы, "parts", Неопределено);
	Если ТипЗнч(ЧастиАргумента) <> Тип("Массив") Или ЧастиАргумента.Количество() = 0 Тогда
		Возврат ОшибкаИнструмента("invalid_arguments",
			НСтр("ru = 'Нужен аргумент parts - массив сдаваемых частей {file, part, persons,
				|values}; часть без находок сдаётся с пустыми списками.'"));
	КонецЕсли;

	// Прежние сдачи запуска + тексты и статусы файлов.
	ЗаполнитьСданныеЧастиИзДействийЗапуска(КонтекстСверки, RunIdИзКонтекста(Контекст));
	СтатусыФайлов = СтатусыФайловСверки(КонтекстСверки);

	// Проверка частей текущего вызова и приём в сданные.
	РезультатыЧастей = ПринятьЧастиВызова(КонтекстСверки, СтатусыФайлов, ЧастиАргумента);

	// Дозаполнение пустых реквизитов принятыми значениями (шаг 10).
	План = ПланДозаполненияПоСтатусам(КонтекстСверки, СтатусыФайлов);

	Если DryRun Тогда
		ПланDryRun = Новый Структура;
		ПланDryRun.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(ОтборЗаявки.Ссылка));
		ПланDryRun.Вставить("parts_submitted", ЧастиАргумента.Количество());
		ПланDryRun.Вставить("fields_planned", План.Поля.Количество());
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_submit_file_data", ПланDryRun);
	КонецЕсли;

	ЗаписьДозаполнения = ЗаписатьДозаполнение(КонтекстСверки, План);

	// Полный итог сверки с учётом принятых частей.
	Сверка = ВычислитьСверкуЗаявки(КонтекстСверки, Ложь);
	Сверка.КонфликтыДозаполнения = План.Конфликты;

	Ответ = ОтветСдачиДанных(КонтекстСверки, Сверка, РезультатыЧастей, ЗаписьДозаполнения, План);
	// agentrunner-212: объект работы для ядра (контракт предмета запуска).
	Ответ.Вставить("subject", ar_Утилиты.НавигационнаяСсылкаОбъекта(ОтборЗаявки.Ссылка));

	ЗаписатьЛогСдачиДанных(КонтекстСверки, РезультатыЧастей, ЗаписьДозаполнения);

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Статусы файлов сверки с частями текста (для сдачи данных).
//
// Возвращаемое значение:
//  Массив - статусы из СтатусФайлаСверки с полем Части.
//
Функция СтатусыФайловСверки(Знач КонтекстСверки)

	Статусы = Новый Массив;
	КонтекстСверки.Файлы = ФайлыЗаявкиДляСверки(КонтекстСверки.СсылкаЗаявки);

	Для Каждого Файл Из КонтекстСверки.Файлы Цикл
		СтатусФайла = СтатусФайлаСверки(КонтекстСверки, Файл);
		СтатусФайла.Вставить("Части",
			?(СтатусФайла.Код = "relevant_single" Или СтатусФайла.Код = "relevant_multi",
				ЧастиТекста(Файл.Текст), Новый Массив));
		Статусы.Добавить(СтатусФайла);
	КонецЦикла;

	Возврат Статусы;

КонецФункции

// Приём частей вызова: поиск файла, проверка номера части, валидация лиц,
// проверка значений (шаг 7) и запись части в сданные (повторная сдача
// заменяет прежнюю).
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки (СданныеЧасти пополняется).
//  СтатусыФайлов  - Массив    - статусы файлов (СтатусыФайловСверки).
//  ЧастиАргумента - Массив    - parts из аргументов вызова.
//
// Возвращаемое значение:
//  Массив из Структура {file, part, Принято - Булево, Причина, accepted,
//  rejected} - итог проверки одной части.
//
Функция ПринятьЧастиВызова(Знач КонтекстСверки, Знач СтатусыФайлов, Знач ЧастиАргумента)

	Результаты = Новый Массив;

	Для Каждого ЧастьJSON Из ЧастиАргумента Цикл
		Если ТипЗнч(ЧастьJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ИмяФайла = Строка(ЧастьJSON.Получить("file"));
		НомерЧасти = ЧислоИзJSON(ЧастьJSON.Получить("part"));

		ИтогЧасти = Новый Структура;
		ИтогЧасти.Вставить("file", ИмяФайла);
		ИтогЧасти.Вставить("part", НомерЧасти);
		ИтогЧасти.Вставить("Принято", Ложь);
		ИтогЧасти.Вставить("Причина", "");
		ИтогЧасти.Вставить("accepted", Новый Массив);
		ИтогЧасти.Вставить("rejected", Новый Массив);

		Причина = ОтказПриемаЧасти(КонтекстСверки, СтатусыФайлов, ЧастьJSON, ИтогЧасти);
		Если НЕ ПустаяСтрока(Причина) Тогда
			ИтогЧасти.Причина = Причина;
			Результаты.Добавить(ИтогЧасти);
			Продолжить;
		КонецЕсли;

		Результаты.Добавить(ИтогЧасти);
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Проверка одной части вызова; при успехе часть записывается в сданные
// (замена прежней сдачи), а ИтогЧасти наполняется принятыми и отклонёнными
// значениями.
//
// Параметры:
//  КонтекстСверки - Структура    - контекст сверки.
//  СтатусыФайлов  - Массив       - статусы файлов.
//  ЧастьJSON      - Соответствие - {file, part, persons, values}.
//  ИтогЧасти      - Структура    - заполняется (accepted/rejected/Причина).
//
// Возвращаемое значение:
//  Строка - причина отказа части; "" - часть принята.
//
Функция ОтказПриемаЧасти(Знач КонтекстСверки, Знач СтатусыФайлов, Знач ЧастьJSON, Знач ИтогЧасти)

	ИмяФайла = ИтогЧасти.file;
	НомерЧасти = ИтогЧасти.part;

	СтатусФайла = СтатусФайлаПоИмени(СтатусыФайлов, ИмяФайла);
	Если СтатусФайла = Неопределено Тогда
		Возврат "файл не найден среди файлов заявки";
	КонецЕсли;

	Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
		Возврат "файл не относится к контрагенту заявки или не читается";
	КонецЕсли;

	Если НомерЧасти < 1 Или НомерЧасти > СтатусФайла.Части.Количество() Тогда
		Возврат СтрШаблон("части %1 у файла нет (файл делится на %2 частей)",
			Формат(НомерЧасти, "ЧГ=0"), Формат(СтатусФайла.Части.Количество(), "ЧГ=0"));
	КонецЕсли;

	Лица = ЛицаИзJSONЧасти(ЧастьJSON.Получить("persons"));
	Для Каждого Лицо Из Лица Цикл
		Если ПустаяСтрока(Лицо.Инн) Тогда
			Возврат "у лица не передан ИНН";
		КонецЕсли;
		Если РольЛицаНедопустима(Лицо.Роль) Тогда
			Возврат СтрШаблон(НСтр("ru = 'роль лица «%1» не входит в набор
				|counterparty, bank, our_org, other'"), Лицо.Роль);
		КонецЕсли;
	КонецЦикла;

	// Проверка значений части (шаг 7) - одним вызовом на все значения части
	// (ссылочный поиск - один пакетный запрос, БИК - одна выборка банков).
	ЗначенияJSON = ЗначенияИзJSONЧасти(ЧастьJSON.Получить("values"));
	Проверенные = ПроверитьЗначенияЧасти(КонтекстСверки, СтатусФайла.ТекстНорм,
		ЗначенияЧастиДляПроверки(ЗначенияJSON));
	Для Каждого ИтогЗначения Из Проверенные Цикл
		ДобавитьИтогЗначенияЧасти(ИтогЧасти, ИтогЗначения);
	КонецЦикла;

	// Часть записывается целиком (повторная сдача заменяет прежнюю) - проверка
	// сданных значений повторяется при каждой сверке, включая решение.
	СданнаяЧасть = Новый Структура;
	СданнаяЧасть.Вставить("ИмяФайла", ИмяФайла);
	СданнаяЧасть.Вставить("Номер", НомерЧасти);
	СданнаяЧасть.Вставить("Лица", Лица);
	СданнаяЧасть.Вставить("Значения", ЗначенияJSON);
	КонтекстСверки.СданныеЧасти.Вставить(КлючСданнойЧасти(ИмяФайла, НомерЧасти), СданнаяЧасть);

	Возврат "";

КонецФункции

// Роль лица вне набора counterparty/bank/our_org/other.
Функция РольЛицаНедопустима(Знач Роль)

	Возврат НЕ (Роль = "counterparty" Или Роль = "bank" Или Роль = "our_org" Или Роль = "other");

КонецФункции

// Статус файла по имени из списка статусов.
//
// Возвращаемое значение:
//  Структура статуса или Неопределено.
//
Функция СтатусФайлаПоИмени(Знач СтатусыФайлов, Знач ИмяФайла)

	Для Каждого СтатусФайла Из СтатусыФайлов Цикл
		Если СтатусФайла.ИмяФайла = ИмяФайла Тогда
			Возврат СтатусФайла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Добавляет итог проверки одного значения в accepted/rejected части.
Процедура ДобавитьИтогЗначенияЧасти(Знач ИтогЧасти, Знач ИтогЗначения)

	Если ИтогЗначения.Принято Тогда
		Принятое = Новый Структура;
		Принятое.Вставить("field", ИтогЗначения.Поле);
		Принятое.Вставить("value", ЗначениеИтогаСтрокой(ИтогЗначения));
		ИтогЧасти.accepted.Добавить(Принятое);
	Иначе
		Отклоненное = Новый Структура;
		Отклоненное.Вставить("field", ИтогЗначения.Поле);
		Отклоненное.Вставить("value", ИтогЗначения.Значение);
		Отклоненное.Вставить("reason", ИтогЗначения.Причина);
		Отклоненное.Вставить("candidates", ИтогЗначения.Кандидаты);
		ИтогЧасти.rejected.Добавить(Отклоненное);
	КонецЕсли;

КонецПроцедуры

// Принятое значение строкой для ответа (ссылка - представлением).
Функция ЗначениеИтогаСтрокой(Знач ИтогЗначения)

	Если ИтогЗначения.Приведенное = Неопределено Тогда
		Возврат ИтогЗначения.Значение;
	КонецЕсли;
	Возврат Строка(ИтогЗначения.Приведенное);

КонецФункции

// Проверенные значения по всем сданным частям относящихся файлов.
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки (СданныеЧасти).
//  СтатусыФайлов  - Массив    - статусы файлов.
//
// Возвращаемое значение:
//  Соответствие - имя файла -> Массив {Номер, Итоги}.
//
Функция ПроверенныеЗначенияПоФайлам(Знач КонтекстСверки, Знач СтатусыФайлов)

	ПроверенныеПоФайлам = Новый Соответствие;

	Для Каждого СтатусФайла Из СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" И СтатусФайла.Код <> "relevant_multi" Тогда
			Продолжить;
		КонецЕсли;

		ПроверенныеЧасти = Новый Массив;
		Для Каждого СданнаяЧасть Из СданныеЧастиФайла(КонтекстСверки, СтатусФайла.ИмяФайла) Цикл
			Проверенные = ПроверитьЗначенияЧасти(КонтекстСверки, СтатусФайла.ТекстНорм,
				ЗначенияЧастиДляПроверки(СданнаяЧасть.Значения));
			ПроверенныеЧасти.Добавить(Новый Структура("Номер, Итоги",
				СданнаяЧасть.Номер, Проверенные));
		КонецЦикла;
		ПроверенныеПоФайлам.Вставить(СтатусФайла.ИмяФайла, ПроверенныеЧасти);
	КонецЦикла;

	Возврат ПроверенныеПоФайлам;

КонецФункции

// План дозаполнения (шаг 10): только файлы «одно лицо», только пустые
// реквизиты заявки, только принятые значения; два файла с разными значениями
// одного поля - не заполняется (конфликт); банковский счёт не добавляется,
// если инициатор его не указал (оба доп. реквизита пусты).
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки.
//  СтатусыФайлов  - Массив    - статусы файлов.
//
// Возвращаемое значение:
//  Структура {Поля - Массив {Поле, Значение, Представление, Файл, Цитата,
//  Описание}, Конфликты - Массив из Строка}.
//
Функция ПланДозаполненияПоСтатусам(Знач КонтекстСверки, Знач СтатусыФайлов)

	План = Новый Структура;
	План.Вставить("Поля", Новый Массив);
	План.Вставить("Конфликты", Новый Массив);

	ПроверенныеПоФайлам = ПроверенныеЗначенияПоФайлам(КонтекстСверки, СтатусыФайлов);
	ЗначенияПоПолям = Новый Соответствие;

	Для Каждого СтатусФайла Из СтатусыФайлов Цикл
		Если СтатусФайла.Код <> "relevant_single" Тогда
			Продолжить; // Дозаполнение - только из файлов с одним лицом.
		КонецЕсли;

		ПроверенныеЧасти = ПроверенныеПоФайлам.Получить(СтатусФайла.ИмяФайла);
		Если ПроверенныеЧасти = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЧастьСИтогами Из ПроверенныеЧасти Цикл
			Для Каждого Итог Из ЧастьСИтогами.Итоги Цикл
				Если НЕ Итог.Принято Тогда
					Продолжить;
				КонецЕсли;
				СобратьЗначениеДозаполнения(КонтекстСверки, ЗначенияПоПолям, Итог,
					СтатусФайла.ИмяФайла, Итог.Цитата, План.Конфликты);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// Однозначные значения - в план записи.
	Для Каждого КлючИЗначение Из ЗначенияПоПолям Цикл
		НаборЗначений = КлючИЗначение.Значение;
		Если НаборЗначений.Варианты.Количество() <> 1 Тогда
			Продолжить; // Конфликт уже записан.
		КонецЕсли;
		Если ПолеЗаявкиПусто(КонтекстСверки, НаборЗначений.Описание) Тогда
			План.Поля.Добавить(Новый Структура("Поле, Значение, Представление, Файл, Цитата, Описание",
				НаборЗначений.Описание.ИмяПоля, НаборЗначений.Варианты[0].Значение,
				НаборЗначений.Варианты[0].Представление, НаборЗначений.Варианты[0].Файл,
				НаборЗначений.Варианты[0].Цитата, НаборЗначений.Описание));
		КонецЕсли;
	КонецЦикла;

	Возврат План;

КонецФункции

// Собирает принятое значение поля для дозаполнения: счётные поля - только при
// счёте в заявке, пустые - только пустые; разные значения одного поля -
// конфликт.
//
// Параметры:
//  КонтекстСверки  - Структура    - контекст сверки.
//  ЗначенияПоПолям - Соответствие - имя поля -> {Описание, Варианты}.
//  Итог            - Структура    - принятый итог проверки значения.
//  ИмяФайла        - Строка       - файл источника.
//  Цитата          - Строка       - цитата значения.
//  Конфликты       - Массив       - тексты конфликтов (пополняется).
//
Процедура СобратьЗначениеДозаполнения(Знач КонтекстСверки, Знач ЗначенияПоПолям,
	Знач Итог, Знач ИмяФайла, Знач Цитата, Знач Конфликты)

	Если Итог.Приведенное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Банковский счёт не добавляется, если инициатор его не указал.
	Если (Итог.Поле = "НомерОсновногоБанковскогоСчета" Или Итог.Поле = "БИКБанка")
		И НЕ КонтекстСверки.СчетВЗаявке Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписаниеПоляЗаявки(Итог.Поле);
	Если Описание.Тип = "" Тогда
		Возврат;
	КонецЕсли;

	Набор = ЗначенияПоПолям.Получить(Итог.Поле);
	Если Набор = Неопределено Тогда
		Набор = Новый Структура;
		Набор.Вставить("Описание", Новый Структура("ИмяПоля, Тип, ИмяТаблицы, ДопРеквизит, ОписаниеТипа",
			Итог.Поле, Описание.Тип, Описание.ИмяТаблицы, Описание.ДопРеквизит, Описание.ОписаниеТипа));
		Набор.Вставить("Варианты", Новый Массив);
		ЗначенияПоПолям.Вставить(Итог.Поле, Набор);
	КонецЕсли;

	Представление = Строка(Итог.Приведенное);
	// Банк сравнивается по БИК: у разных БИК одного банка наименование может совпадать.
	Если ТипЗнч(Итог.Приведенное) = Тип("СправочникСсылка.Банки") И Итог.Поле = "БИКБанка" Тогда
		Представление = НормализованноеЧислоСтроки(Итог.Значение);
	КонецЕсли;
	Для Каждого Вариант Из Набор.Варианты Цикл
		Если НормализованныйТекст(Вариант.Представление) <> НормализованныйТекст(Представление) Тогда
			ТекстКонфликта = СтрШаблон(
				НСтр("ru = 'Поле %1: файлы дают разные значения («%2» и «%3») - не заполнено.'"),
				Итог.Поле, Вариант.Представление, Представление);
			// Одна пара значений - один пункт протокола (без дублей).
			Если Конфликты.Найти(ТекстКонфликта) = Неопределено Тогда
				Конфликты.Добавить(ТекстКонфликта);
			КонецЕсли;
		КонецЕсли;
		// Однократные совпадающие варианты не дублируются.
		Если НормализованныйТекст(Вариант.Представление) = НормализованныйТекст(Представление) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Набор.Варианты.Добавить(Новый Структура("Значение, Представление, Файл, Цитата",
		Итог.Приведенное, Представление, ИмяФайла, Цитата));

КонецПроцедуры

// Пусто ли значение поля заявки (для дозаполнения): шапочные - значение модели,
// дополнительные - значение строки ТЧ.
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки.
//  ОписаниеПоля   - Структура - {ИмяПоля, ДопРеквизит}.
//
// Возвращаемое значение:
//  Булево - Истина - поле пустое (заполняется).
//
Функция ПолеЗаявкиПусто(Знач КонтекстСверки, Знач ОписаниеПоля)

	Если ОписаниеПоля.ДопРеквизит <> Неопределено Тогда
		ЗначенияДоп = ЗначенияДопРеквизитовМодели(КонтекстСверки.МодельСтало);
		Возврат ПустаяСтрока(Строка(ЗначенияДоп.Получить(ОписаниеПоля.ИмяПоля)));
	КонецЕсли;

	Значение = ЗначениеМоделиПоИмени(КонтекстСверки.МодельСтало, ОписаниеПоля.ИмяПоля);
	Возврат НЕ ЗначениеЗаполнено(Значение);

КонецФункции

// Запись дозаполнения модели заявки (О4, research): транзакция с исключительной
// блокировкой заявки, свежая модель объекта, ЗаписатьМодельОбъекта и запись
// без перепроведения (РежимЗаписиДокумента.Запись - визы сохраняются) с флагами
// обработки-образца, без ОбменДанными.Загрузка.
//
// Параметры:
//  КонтекстСверки - Структура - контекст сверки.
//  План           - Структура - план дозаполнения (ПланДозаполненияПоСтатусам).
//
// Возвращаемое значение:
//  Структура {Успех - Булево, Ошибка - Строка, НовыйХеш - Строка, Записано -
//  Число}.
//
Функция ЗаписатьДозаполнение(Знач КонтекстСверки, Знач План)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("НовыйХеш", КонтекстСверки.ХешТекущий);
	Результат.Вставить("Записано", 0);

	Если План.Поля.Количество() = 0 Тогда
		Возврат Результат; // Заполнять нечего.
	КонецЕсли;

	Исход = Ложь;
	Модель = Неопределено; // Свежая модель транзакции - из неё НовыйХеш.
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", КонтекстСверки.СсылкаЗаявки);
		Блокировка.Заблокировать();

		ОбъектЗаявки = КонтекстСверки.СсылкаЗаявки.ПолучитьОбъект();
		Если ОбъектЗаявки = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Заявка не найдена для дозаполнения.'");
		КонецЕсли;

		Модель = ОбъектЗаявки.ПолучитьМодельОбъекта();
		Если Модель = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Модель заявки пуста - дозаполнение невозможно.'");
		КонецЕсли;

		Для Каждого ПолеПлана Из План.Поля Цикл
			Если ЗаписатьПолеВМодель(Модель, ПолеПлана) Тогда
				Результат.Записано = Результат.Записано + 1;
			КонецЕсли;
		КонецЦикла;

		ОбъектЗаявки.ЗаписатьМодельОбъекта(Модель);
		// Флаги записи - как в обработке-образце (спека agentrunner-88 п. 4б).
		ОбъектЗаявки.ДополнительныеСвойства.Вставить(
			"sd_ЗаписьБезПроверкиПравДоступаПользователяПоНастройке", Истина);
		ОбъектЗаявки.ДополнительныеСвойства.Вставить("sd_ЗаменаСсылок_ЗаписьБезПроверок", Истина);
		ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);

		Исход = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
		Результат.Ошибка = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстЛога = СтрШаблон("%1: %2", Строка(КонтекстСверки.СсылкаЗаявки),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ.ЗаписатьДозаполнение", "nsi_fill_failed",
			ТекстЛога, "Ошибка");
	КонецПопытки;

	Результат.Успех = Исход;
	Если Исход И Модель <> Неопределено Тогда
		// Новый model_hash - иначе approve упрётся в request_changed (О4).
		Результат.НовыйХеш = ХешМоделейЗаявки(Модель,
			КонтекстСверки.ДанныеЗаявки.Подчиненные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Запись одного значения плана в модель: шапочные реквизиты - в группу модели,
// дополнительные - в строку ТЧ ДополнительныеРеквизиты (строка создаётся; для
// строковых свойств значение пишется в ТекстоваяСтрока - приём БСП).
//
// Параметры:
//  Модель    - Структура, Соответствие - модель заявки (изменяется).
//  ПолеПлана - Структура - элемент плана (Поле, Значение, Описание).
//
// Возвращаемое значение:
//  Булево - Истина - значение записано в модель.
//
Функция ЗаписатьПолеВМодель(Знач Модель, Знач ПолеПлана)

	Описание = ПолеПлана.Описание;

	Если Описание.ДопРеквизит <> Неопределено Тогда
		Возврат ЗаписатьДопРеквизитВМодель(Модель, Описание, ПолеПлана.Значение);
	КонецЕсли;

	Группа = ГруппаШапочногоПоля(Описание.ИмяПоля);
	Если ПустаяСтрока(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;

	ГруппаМоделиЗаявки = ГруппаМодели(Модель, Группа);
	Если ГруппаМоделиЗаявки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПрисвоитьЗначениеКоллекции(ГруппаМоделиЗаявки, Описание.ИмяПоля, ПолеПлана.Значение);
	Возврат Истина;

КонецФункции

// Группа модели для шапочного реквизита: "Реквизиты" или "СтандартныеРеквизиты".
Функция ГруппаШапочногоПоля(Знач ИмяПоля)

	МетаКонтрагенты = Метаданные.Справочники.Контрагенты;
	Если МетаКонтрагенты.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат "Реквизиты";
	КонецЕсли;
	// У СтандартныеРеквизиты нет метода Найти - поиск перебором.
	Если СтандартныйРеквизитПоИмени(МетаКонтрагенты, ИмяПоля) <> Неопределено Тогда
		Возврат "СтандартныеРеквизиты";
	КонецЕсли;
	Возврат "";

КонецФункции

// Запись дополнительного реквизита в модель: строка ТЧ ДополнительныеРеквизиты
// по свойству ПВХ; нет строки - создаётся; строковые свойства - в
// ТекстоваяСтрока, ссылочные/числовые/дата - в Значение.
//
// Параметры:
//  Модель        - Структура, Соответствие - модель заявки (изменяется).
//  Описание      - Структура - {ИмяПоля, ДопРеквизит, Тип, ОписаниеТипа}.
//  ЗначениеПоля  - Произвольный - приведённое значение (ссылка/строка/число/дата).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаписатьДопРеквизитВМодель(Знач Модель, Знач Описание, Знач ЗначениеПоля)

	Таблица = ТаблицаМоделиТЧ(Модель, "ДополнительныеРеквизиты");
	Если Таблица = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаСвойства = Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеИзКоллекцииМодели(СтрокаТаблицы, "Свойство") = Описание.ДопРеквизит Тогда
			СтрокаСвойства = СтрокаТаблицы;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрокаСвойства = Неопределено Тогда
		СтрокаСвойства = Новый Соответствие;
		СтрокаСвойства.Вставить("Свойство", Описание.ДопРеквизит);
		Таблица.Добавить(СтрокаСвойства);
	КонецЕсли;

	Если Описание.Тип = "string" Тогда
		ПрисвоитьЗначениеКоллекции(СтрокаСвойства, "ТекстоваяСтрока", Строка(ЗначениеПоля));
	Иначе
		ПрисвоитьЗначениеКоллекции(СтрокаСвойства, "Значение", ЗначениеПоля);
		ПрисвоитьЗначениеКоллекции(СтрокаСвойства, "ТекстоваяСтрока", "");
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Присваивание значения Структуре или Соответствию.
Процедура ПрисвоитьЗначениеКоллекции(Знач Коллекция, Знач Ключ, Знач Значение)

	Если ТипЗнч(Коллекция) = Тип("Структура") Или ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Коллекция.Вставить(Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

// Ответ инструмента nsi_submit_file_data: результаты частей, файлы, filled,
// новый model_hash, следующая порция, files_left и полный итог сверки.
//
// Параметры:
//  КонтекстСверки   - Структура - контекст сверки.
//  Сверка           - Структура - результат ВычислитьСверкуЗаявки.
//  РезультатыЧастей - Массив    - итоги ПринятьЧастиВызова.
//  ЗаписьДозаполнения - Структура - итог ЗаписатьДозаполнение.
//  План             - Структура - план дозаполнения (конфликты).
//
// Возвращаемое значение:
//  Структура - ответ-observation.
//
Функция ОтветСдачиДанных(Знач КонтекстСверки, Знач Сверка, Знач РезультатыЧастей,
	Знач ЗаписьДозаполнения, Знач План)

	Ответ = Новый Структура;
	Ответ.Вставить("submitted_parts", РезультатыЧастей);
	Ответ.Вставить("files", Сверка.ФайлыОтвет);
	Ответ.Вставить("files_left", ФайлыСлева(Сверка.СтатусыФайлов, КонтекстСверки));
	Ответ.Вставить("verdict", Сверка.Вердикт);
	Ответ.Вставить("allowed_decisions", Сверка.ДопустимыеРешения);
	Ответ.Вставить("next", СледующийШагСверки(Сверка));

	// Дозаполнено: поле - значение - файл - цитата (п. 5.4 плана).
	Filled = Новый Массив;
	Для Каждого ПолеПлана Из План.Поля Цикл
		Если ЗаписьДозаполнения.Успех Тогда
			Filled.Добавить(Новый Структура("field, value, file, fragment",
				ПолеПлана.Поле, ПолеПлана.Представление, ПолеПлана.Файл, ПолеПлана.Цитата));
		КонецЕсли;
	КонецЦикла;
	Ответ.Вставить("filled", Filled);
	Если План.Конфликты.Количество() > 0 Тогда
		Ответ.Вставить("fill_conflicts", План.Конфликты);
	КонецЕсли;
	Если НЕ ЗаписьДозаполнения.Успех Тогда
		Ответ.Вставить("fill_error", ЗаписьДозаполнения.Ошибка);
	КонецЕсли;

	// Новый model_hash после дозаполнения - иначе approve упрётся в request_changed.
	Ответ.Вставить("model_hash", ЗаписьДозаполнения.НовыйХеш);

	// Следующая порция частей - тем же ключом, что в nsi_verify_request.
	Ответ.Вставить("parts", СледующаяПорцияЧастей(Сверка.СтатусыФайлов, КонтекстСверки));

	// Полный итог сверки - когда сданы все части всех относящихся файлов.
	Если ФайлыСлева(Сверка.СтатусыФайлов, КонтекстСверки).Количество() = 0 Тогда
		Ответ.Вставить("mismatches", Сверка.Расхождения);
		Ответ.Вставить("monopolist", Сверка.Монополист);
		Ответ.Вставить("requisites", РеквизитыОтветСверки(Сверка));
		Если Сверка.Официальные <> Неопределено Тогда
			Ответ.Вставить("official", Сверка.Официальные);
		КонецЕсли;
		Ответ.Вставить("needs_review", Сверка.ПунктыReview);
		Ответ.Вставить("remarks", Сверка.Замечания);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Лог вызова сдачи данных: заявка, частей, принято значений, дозаполнено.
Процедура ЗаписатьЛогСдачиДанных(Знач КонтекстСверки, Знач РезультатыЧастей, Знач ЗаписьДозаполнения)

	ПринятоЗначений = 0;
	Для Каждого ИтогЧасти Из РезультатыЧастей Цикл
		ПринятоЗначений = ПринятоЗначений + ИтогЧасти.accepted.Количество();
	КонецЦикла;

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_submit_file_data", СтрШаблон(
		НСтр("ru = '%1: частей %2, принято значений %3, дозаполнено %4 (ошибка: %5)'"),
		Строка(КонтекстСверки.СсылкаЗаявки),
		Формат(РезультатыЧастей.Количество(), "ЧГ=0"),
		Формат(ПринятоЗначений, "ЧГ=0"),
		Формат(ЗаписьДозаполнения.Записано, "ЧГ=0"),
		?(ЗаписьДозаполнения.Успех, "-", ЗаписьДозаполнения.Ошибка)));

КонецПроцедуры

#КонецОбласти
#Область ИнструментАвтоактуализация

// Реализация инструмента nsi_actualize_request (спека agentrunner-96 п. 3):
// автоактуализация заявки НСИ по данным ЕГРЮЛ/ЕГРИП. Исключения наружу не
// выходят - ошибки попадают в ответ; запись и проведение - в транзакции с
// исключительной блокировкой заявки. Для not_actualization ничего не пишется;
// для передачи и недоступного ЕГР пишется только отметка отложения ядра
// (ключ "actualize").
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"request"}, обогащенный _dry_run.
//  Контекст      - Структура - контекст запуска (Агент, RunId).
//
// Возвращаемое значение:
//  Строка - JSON-observation {result, changes, liquidated, visas, remarks, next}
//  либо {"error", "message"}.
//
Функция ВыполнитьАктуализациюЗаявки(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	DryRun = ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON);

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			?(ПустаяСтрока(ОтборЗаявки.Сообщение), ТекстЗаявкаНеНайдена(), ОтборЗаявки.Сообщение));
	КонецЕсли;

	// agentrunner-212 (спека п. 5): чужая заявка для запуска - отказ до чтения
	// и до записи (актуализация пишет и проводит заявку).
	ТекстЧужойЗаявки = ТекстЧужойЗаявкиДляЗапуска(Контекст, ОтборЗаявки.Ссылка);
	Если НЕ ПустаяСтрока(ТекстЧужойЗаявки) Тогда
		Возврат ОшибкаИнструмента("run_subject_mismatch", ТекстЧужойЗаявки);
	КонецЕсли;

	// agentrunner-212: ответы по одной заявке (успех и не-ошибочные итоги вроде
	// not_actualization) дополняются subject - объект работы для ядра;
	// DryRun-планы ОтветСSubject не трогает. Отказ «не исключена» - ниже, как
	// и раньше.
	Если ЗаявкаИсключена(ОтборЗаявки.Ссылка) Тогда
		Возврат ОшибкаИнструмента("request_excluded_external_system", ТекстЗаявкаИсключена(), Истина);
	КонецЕсли;

	ДанныеПоЗаявке = ДанныеЗаявки(ОтборЗаявки.Ссылка);
	Если ДанныеПоЗаявке.Шапка = Неопределено Тогда
		Возврат ОшибкаИнструмента("request_not_found", ТекстЗаявкаНеНайдена());
	КонецЕсли;
	Шапка = ДанныеПоЗаявке.Шапка;

	Если НЕ ЭтоЗаявкаАктуализации(Шапка) Тогда
		Замечания = Новый Массив;
		Замечания.Добавить(
			НСтр("ru = 'Заявка не относится к сценарию автоактуализации по ИНН/КПП -
				|или её модель меняли после создания.'"));
		Возврат ОтветСSubject(
			ОтветАктуализации("not_actualization", Новый Массив, Ложь, Новый Массив, Замечания),
			ОтборЗаявки.Ссылка);
	КонецЕсли;

	Если Шапка.Проведен Тогда
		// Развилка по решению по визе 1, а не по факту проведения (спека
		// agentrunner-210): проведение агентом и виза 1 - одна транзакция
		// ЗаписатьАктуализацию, поэтому «проведена и виза 1 без решения»
		// означает, что заявку провел не наш первый вызов - актуализации не
		// было, выполняется полный путь.
		ВизаАгента = АктивнаяВизаАгента(Контекст, ОтборЗаявки.Ссылка);
		Если ВизаАгента.Найдена И НЕ ЗначениеЗаполнено(ВизаАгента.Решение)
			И ВизаАгента.Этап = 1 Тогда
			Возврат ОтветСSubject(
				АктуализацияПроведеннойПолная(Контекст, ОтборЗаявки.Ссылка, Шапка,
					ДанныеПоЗаявке, ВизаАгента, DryRun),
				ОтборЗаявки.Ссылка);
		КонецЕсли;
		Возврат ОтветСSubject(
			АктуализацияПроведенной(Контекст, ОтборЗаявки.Ссылка, DryRun),
			ОтборЗаявки.Ссылка);
	КонецЕсли;

	Возврат ОтветСSubject(
		АктуализацияНепроведенной(Контекст, ОтборЗаявки.Ссылка, Шапка,
			ДанныеПоЗаявке, DryRun),
		ОтборЗаявки.Ссылка);

КонецФункции

// Автоактуализация непроведенной заявки (спека п. 3, шаги 1-9): проверка
// неизменности модели, отказы как у команды «Заполнить по ИНН», данные ЕГР,
// заполнение копии контрагента в памяти (шаги 1-6 - общая часть с проведенной
// заявкой, ПодготовкаПолнойАктуализации), запись с проведением и решения по
// визам обоих этапов. Ошибки записи - передача сотруднику НСИ.
//
// Параметры:
//  Контекст        - Структура - контекст запуска (Агент, RunId).
//  СсылкаЗаявки    - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Шапка           - Структура - шапка заявки (ДанныеЗаявки.Шапка).
//  ДанныеПоЗаявке  - Структура - шапка и ПОО заявки.
//  DryRun          - Булево    - пробный запуск (запись не выполняется).
//
// Возвращаемое значение:
//  Строка - JSON-observation либо DryRun-план.
//
Функция АктуализацияНепроведенной(Знач Контекст, Знач СсылкаЗаявки, Знач Шапка,
	Знач ДанныеПоЗаявке, Знач DryRun)

	RunId = RunIdИзКонтекста(Контекст);
	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);

	// Шаги 1-6: неизменность модели, отказы, ЕГР, копия, изменения моделей.
	Подготовка = ПодготовкаПолнойАктуализации(Шапка, ДанныеПоЗаявке);
	Если Подготовка.Прерывание <> "" Тогда
		// Отказы - передача сотруднику НСИ отметкой отложения (заявка без виз).
		Возврат ОтветНаПрерываниеПодготовки(Контекст, СсылкаЗаявки, Подготовка, "");
	КонецЕсли;

	Если DryRun Тогда
		План = Новый Структура;
		План.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
		План.Вставить("posted", Ложь);
		План.Вставить("changes", Подготовка.Изменения.Количество());
		План.Вставить("liquidated", Подготовка.Ликвидация);
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_actualize_request", План);
	КонецЕсли;

	// Шаги 7-9: запись модели, проведение, «Согласовано» по визам.
	Комментарий = КомментарийАктуализации(Подготовка.Изменения);
	Запись = ЗаписатьАктуализацию(СсылкаЗаявки, Подготовка.МодельНово, Комментарий,
		ПользовательАгента, Истина, Истина);
	Если НЕ Запись.Успех Тогда
		Возврат ПередачаПослеСбояЗаписи(Контекст, СсылкаЗаявки, Подготовка.ХешТекущий, Запись.Ошибка);
	КонецЕсли;

	Если Запись.Визы.Количество() > 0 Тогда
		ЗаписатьПротоколАктуализации(СсылкаЗаявки, ПользовательАгента, RunId,
			Подготовка.Изменения, Подготовка.Ликвидация, Запись.Визы);
	КонецЕсли;
	ЗамечанияИсполнения = Новый Массив;
	Результат = РезультатАктуализацииПослеВиз(СсылкаЗаявки, Запись.ВизаДваПоставлена, RunId,
		ЗамечанияИсполнения, Подготовка.Изменения);
	ЗаписатьЛогАктуализации(СсылкаЗаявки, Результат, Запись.Визы);
	Возврат ОтветАктуализации(Результат, Подготовка.Изменения, Подготовка.Ликвидация,
		Запись.Визы, ЗамечанияИсполнения);

КонецФункции

// Продолжение актуализации проведенной заявки с решением по визе 1 (шаг 9
// спеки п. 3): «Согласовано» по визе 1 уже стоит - ставится виза 2; если виза
// 1 решена, а активная виза агента не второго этапа - повторяется решение
// доступных виз (идемпотентно). ЕГР и модель не трогаются - полная актуализация
// выполняется только пока виза 1 без решения (АктуализацияПроведеннойПолная).
//
// Параметры:
//  Контекст     - Структура - контекст запуска (Агент, RunId).
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  DryRun       - Булево    - пробный запуск (запись не выполняется).
//
// Возвращаемое значение:
//  Строка - JSON-observation либо DryRun-план.
//
Функция АктуализацияПроведенной(Знач Контекст, Знач СсылкаЗаявки, Знач DryRun)

	Если DryRun Тогда
		План = Новый Структура;
		План.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
		План.Вставить("posted", Истина);
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_actualize_request", План);
	КонецЕсли;

	ВизаАгента = АктивнаяВизаАгента(Контекст, СсылкаЗаявки);
	Если НЕ ВизаАгента.Найдена Или ЗначениеЗаполнено(ВизаАгента.Решение) Тогда
		// Автоматическая часть уже завершена: активной визы агента нет либо
		// решение по ней поставлено.
		Замечания = Новый Массив;
		Замечания.Добавить(
			НСтр("ru = 'Активной визы агента без решения у заявки нет - актуализация
				|выполнена ранее либо заявка у сотрудников.'"));
		Возврат ОтветАктуализации("approved_stage1", Новый Массив, Ложь, Новый Массив, Замечания);
	КонецЕсли;

	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);
	RunId = RunIdИзКонтекста(Контекст);

	Если ВизаАгента.Этап = 2 Тогда
		Виза1 = ДанныеВизы1(СсылкаЗаявки);
		Если Виза1 = Неопределено Или НЕ ЗначениеБулево(Виза1.approved) Тогда
			Возврат ПередачаПроведенной(Контекст, СсылкаЗаявки, ВизаАгента.ИД,
				НСтр("ru = 'виза первого этапа не согласована'"));
		КонецЕсли;
		Комментарий = КомментарийВизы1(СсылкаЗаявки);
		Если ПустаяСтрока(Комментарий) Тогда
			Комментарий = НСтр("ru = 'Актуализировано по данным ЕГРЮЛ/ЕГРИП'");
		КонецЕсли;
	Иначе
		// Виза этапа 1 уже с решением либо этап вне маршрута: комментарий
		// общий - перечень изменений остался в протоколе первого вызова.
		Комментарий = НСтр("ru = 'Актуализировано по данным ЕГРЮЛ/ЕГРИП'");
	КонецЕсли;

	// Виза 1 - Истина и на этапе 2: решенная запись отсекается предикатом
	// ВизаСценарияОтбирается, нерешенная (продолжение с этапа 1) - ставится.
	Запись = ЗаписатьАктуализацию(СсылкаЗаявки, Неопределено, Комментарий,
		ПользовательАгента, Истина, Истина);
	Если НЕ Запись.Успех Тогда
		Возврат ПередачаПроведенной(Контекст, СсылкаЗаявки, ВизаАгента.ИД, Запись.Ошибка);
	КонецЕсли;

	ЗаписатьПротоколАктуализации(СсылкаЗаявки, ПользовательАгента, RunId,
		Новый Массив, Ложь, Запись.Визы);
	// Результат - по визе этапа 2, как у непроведенной заявки (спека
	// agentrunner-210 п. 4); changes пуст: перечень - в комментарии визы 1 и в
	// протоколе.
	ЗамечанияИсполнения = Новый Массив;
	Результат = РезультатАктуализацииПослеВиз(СсылкаЗаявки, Запись.ВизаДваПоставлена, RunId,
		ЗамечанияИсполнения);
	ЗаписатьЛогАктуализации(СсылкаЗаявки, Результат, Запись.Визы);
	Возврат ОтветАктуализации(Результат, Новый Массив, Ложь, Запись.Визы, ЗамечанияИсполнения);

КонецФункции

// Полная актуализация проведенной заявки без решения по визе 1 (спека
// agentrunner-210 п. 1 решения): заявку провел не агент - актуализации не было,
// выполняется весь путь непроведенной заявки (шаги 1-6 - общая часть,
// ПодготовкаПолнойАктуализации), затем модель «стало» записывается в
// проведенную заявку без перепроведения (визы уже назначены) и визы
// согласуются. Отказы и сбой записи - передача сотруднику НСИ по активной визе
// (ПередачаПроведенной).
//
// Параметры:
//  Контекст       - Структура - контекст запуска (Агент, RunId).
//  СсылкаЗаявки   - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Шапка          - Структура - шапка заявки (ДанныеЗаявки.Шапка).
//  ДанныеПоЗаявке - Структура - шапка и ПОО заявки.
//  ВизаАгента     - Структура - активная виза агента (АктивнаяВизаАгента),
//                   этап 1 без решения.
//  DryRun         - Булево    - пробный запуск (запись не выполняется).
//
// Возвращаемое значение:
//  Строка - JSON-observation либо DryRun-план.
//
Функция АктуализацияПроведеннойПолная(Знач Контекст, Знач СсылкаЗаявки, Знач Шапка,
	Знач ДанныеПоЗаявке, Знач ВизаАгента, Знач DryRun)

	RunId = RunIdИзКонтекста(Контекст);
	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);

	// Шаги 1-6: общая часть с непроведенной заявкой; отказы - передача
	// сотруднику НСИ по активной визе этапа 1 (спека п. 3 решения).
	Подготовка = ПодготовкаПолнойАктуализации(Шапка, ДанныеПоЗаявке);
	Если Подготовка.Прерывание <> "" Тогда
		Возврат ОтветНаПрерываниеПодготовки(Контекст, СсылкаЗаявки, Подготовка, ВизаАгента.ИД);
	КонецЕсли;

	Если DryRun Тогда
		План = Новый Структура;
		План.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
		План.Вставить("posted", Истина);
		План.Вставить("changes", Подготовка.Изменения.Количество());
		План.Вставить("liquidated", Подготовка.Ликвидация);
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_actualize_request", План);
	КонецЕсли;

	// Шаги 7-9: модель «стало» - в проведенную заявку (запись с
	// ОбменДанными.Загрузка без перепроведения - визы сохраняются),
	// «Согласовано» по визам, протокол с изменениями.
	Комментарий = КомментарийАктуализации(Подготовка.Изменения);
	Запись = ЗаписатьАктуализацию(СсылкаЗаявки, Подготовка.МодельНово, Комментарий,
		ПользовательАгента, Истина, Истина, Ложь);
	Если НЕ Запись.Успех Тогда
		Возврат ПередачаПроведенной(Контекст, СсылкаЗаявки, ВизаАгента.ИД, Запись.Ошибка);
	КонецЕсли;

	Если Запись.Визы.Количество() > 0 Тогда
		ЗаписатьПротоколАктуализации(СсылкаЗаявки, ПользовательАгента, RunId,
			Подготовка.Изменения, Подготовка.Ликвидация, Запись.Визы);
	КонецЕсли;
	ЗамечанияИсполнения = Новый Массив;
	Результат = РезультатАктуализацииПослеВиз(СсылкаЗаявки, Запись.ВизаДваПоставлена, RunId,
		ЗамечанияИсполнения, Подготовка.Изменения);
	ЗаписатьЛогАктуализации(СсылкаЗаявки, Результат, Запись.Визы);
	Возврат ОтветАктуализации(Результат, Подготовка.Изменения, Подготовка.Ликвидация,
		Запись.Визы, ЗамечанияИсполнения);

КонецФункции

// Общая часть полной актуализации (шаги 1-6 спеки п. 3) для непроведенной
// заявки и проведенной без решения по визе 1 (agentrunner-210): неизменность
// модели, отказы как у команды «Заполнить по ИНН», данные ЕГР, копия
// контрагента в памяти (не записывается), новая модель «стало» и перечень
// изменений. Шаг 6 не выполняется: проверки обработкой не нужны (решение
// человека) - данные заполняются из ЕГР.
//
// Прерывание сообщает вызывающему об отказе: ветки различаются передачей
// сотруднику НСИ - ОтветНаПрерываниеПодготовки.
//
// Параметры:
//  Шапка          - Структура - шапка заявки (ДанныеЗаявки.Шапка).
//  ДанныеПоЗаявке - Структура - шапка и ПОО заявки.
//
// Возвращаемое значение:
//  Структура:
//   * Прерывание    - Строка - "" - подготовка выполнена; иначе -
//                   not_actualization / handover / service_unavailable.
//   * Сообщение     - Строка - замечание not_actualization либо текст ошибки
//                   сервиса ЕГР.
//   * ПричинаОтказа - Структура {Код, Представление} - причина handover.
//   * ХешТекущий    - Строка - model_hash заявки (отпечаток отметки).
//   * МодельПред    - Структура - модель «было».
//   * МодельНово    - Структура - модель «стало» по данным ЕГР.
//   * Изменения     - Массив из Структура {field, was, now}.
//   * Ликвидация    - Булево - признак ликвидации из ЕГР.
//
Функция ПодготовкаПолнойАктуализации(Знач Шапка, Знач ДанныеПоЗаявке)

	Результат = Новый Структура;
	Результат.Вставить("Прерывание", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ПричинаОтказа", Неопределено);
	Результат.Вставить("ХешТекущий", "");
	Результат.Вставить("МодельПред", Неопределено);
	Результат.Вставить("МодельНово", Неопределено);
	Результат.Вставить("Изменения", Новый Массив);
	Результат.Вставить("Ликвидация", Ложь);

	// Шаг 1: модель не менялась после создания - хеш «стало» равен хешу «было».
	МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
	МодельПред = МодельИзХранилища(Шапка.ХранилищеМодельОбъектаПред);
	ХешТекущий = ХешМоделейЗаявки(МодельСтало, ДанныеПоЗаявке.Подчиненные);
	ХешПред = ХешМоделейЗаявки(МодельПред, ДанныеПоЗаявке.Подчиненные, Истина);
	Если ХешПред <> ХешТекущий Тогда
		Результат.Прерывание = "not_actualization";
		Результат.Сообщение = НСтр("ru = 'Модель заявки менялась после создания - автоактуализация не
			|применяется.'");
		Возврат Результат;
	КонецЕсли;
	Результат.ХешТекущий = ХешТекущий;
	Результат.МодельПред = МодельПред;

	// Шаг 2: отказы как у команды «Заполнить по ИНН».
	РеквизитыКарточки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шапка.Предмет,
		"ОбособленноеПодразделение, sd_ОП, sd_Нерезидент, ИНН, ЮридическоеФизическоеЛицо");
	ОтказФормы = ПричинаОтказаФормы(РеквизитыКарточки);
	Если НЕ ПустаяСтрока(ОтказФормы.Код) Тогда
		Результат.Прерывание = "handover";
		Результат.ПричинаОтказа = ОтказФормы;
		Возврат Результат;
	КонецЕсли;

	// Шаг 3: данные ЕГР - единая точка с командой «Заполнить по ИНН» (функция 88).
	ИНН = НормализованноеЧислоСтроки(Строка(РеквизитыКарточки.ИНН));
	РеквизитыСервиса = ДанныеСервисаПоИНН(ИНН);
	Если НЕ ПустаяСтрока(Строка(РеквизитыСервиса.ОписаниеОшибки)) Тогда
		Результат.Прерывание = "service_unavailable";
		Результат.Сообщение = Строка(РеквизитыСервиса.ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;

	// Шаг 4: смена вида (ЕГР - ИП/ФЛ, карточка - ЮЛ, или наоборот) - вопрос
	// человеку, заполнение не выполняется.
	ЭтоЮрЛицоЕГР = (СтрДлина(ИНН) = 10);
	ЭтоЮрЛицоКарточки = (РеквизитыКарточки.ЮридическоеФизическоеЛицо
		= Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	Если ЭтоЮрЛицоЕГР <> ЭтоЮрЛицоКарточки Тогда
		ОтказФормы = Новый Структура;
		ОтказФормы.Вставить("Код", "kind_changed");
		ОтказФормы.Вставить("Представление",
			НСтр("ru = 'Вид контрагента (ЮЛ/ИП) по данным ЕГР не совпадает с карточкой -
				|требуется решение сотрудника НСИ.'"));
		Результат.Прерывание = "handover";
		Результат.ПричинаОтказа = ОтказФормы;
		Возврат Результат;
	КонецЕсли;

	// Шаг 5: копия контрагента в памяти (не записывается) и новая модель «стало».
	Копия = Шапка.Предмет.ПолучитьОбъект();
	Если Копия = Неопределено Тогда
		ОтказФормы = Новый Структура;
		ОтказФормы.Вставить("Код", "post_failed");
		ОтказФормы.Вставить("Представление",
			НСтр("ru = 'Контрагент заявки не найден в базе - заполнение невозможно.'"));
		Результат.Прерывание = "handover";
		Результат.ПричинаОтказа = ОтказФормы;
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьКопиюДаннымиЕГР(Копия, РеквизитыСервиса, ИНН);
	МодельНово = Справочники.бит_мдм_ОписанияОбъектовОбмена.ЭмулироватьРеальныйОбъект(
		Копия, Копия.Метаданные());
	Изменения = ИзмененияМоделей(МодельПред, МодельНово);
	ДатаПрекращения = ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаПрекращенияДеятельности");

	Результат.МодельНово = МодельНово;
	Результат.Изменения = Изменения;
	Результат.Ликвидация = ЗначениеЗаполнено(ДатаПрекращения);
	Возврат Результат;

КонецФункции

// Ответ на прерывание подготовки полной актуализации: not_actualization и
// service_unavailable - одинаково для обеих веток; handover - передача
// сотруднику НСИ: без ИД визы - отметка отложения (непроведенная заявка,
// ПередачаНепроведенной), с ИД - комментарий визы и отметка по ИД визы
// (проведенная, ПередачаПроведенной).
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  Подготовка   - Структура - результат ПодготовкаПолнойАктуализации с
//                 заполненным Прерывание.
//  ИДВизы       - Строка    - ИД активной визы агента проведенной заявки;
//                 "" - заявка непроведенная.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ОтветНаПрерываниеПодготовки(Знач Контекст, Знач СсылкаЗаявки, Знач Подготовка,
	Знач ИДВизы)

	Если Подготовка.Прерывание = "not_actualization" Тогда
		Замечания = Новый Массив;
		Замечания.Добавить(Подготовка.Сообщение);
		Возврат ОтветАктуализации("not_actualization", Новый Массив, Ложь, Новый Массив, Замечания);
	ИначеЕсли Подготовка.Прерывание = "service_unavailable" Тогда
		Возврат ПовторАктуализации(Контекст, СсылкаЗаявки, Подготовка.ХешТекущий,
			Подготовка.Сообщение);
	Иначе
		// handover - единственное оставшееся прерывание подготовки.
		Если ИДВизы = "" Тогда
			Возврат ПередачаНепроведенной(Контекст, СсылкаЗаявки, Подготовка.ХешТекущий,
				Подготовка.ПричинаОтказа);
		Иначе
			Возврат ПередачаПроведенной(Контекст, СсылкаЗаявки, ИДВизы,
				Подготовка.ПричинаОтказа.Представление);
		КонецЕсли;
	КонецЕсли;

КонецФункции

// Результат автоактуализации после решений по визам: approved_stage1 - виза
// этапа 2 не поставлена; approved - заявка исполнена (или исполнение еще не
// наступило); approved_not_executed - визы согласованы, но исполнение механизмом
// БИТ не прошло (2.5.8), причина добавляется в Замечания.
//
// Параметры:
//  СсылкаЗаявки      - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//  ВизаДваПоставлена - Булево - решение по визе этапа 2 поставлено.
//  RunId             - Строка - запуск агента (для служебного лога).
//  Замечания         - Массив из Строка - причины (пополняется).
//  Изменения         - Массив из Структура {field, was, now}, Неопределено - изменения
//                      автоактуализации: их поля сверяются с карточкой (2.5.11).
//
// Возвращаемое значение:
//  Строка - approved / approved_stage1 / approved_not_executed.
//
Функция РезультатАктуализацииПослеВиз(Знач СсылкаЗаявки, Знач ВизаДваПоставлена, Знач RunId, Замечания,
	Знач Изменения = Неопределено)

	Если НЕ ВизаДваПоставлена Тогда
		Возврат "approved_stage1";
	КонецЕсли;

	Поля = Новый Массив;
	Если Изменения <> Неопределено Тогда
		Для Каждого Изменение Из Изменения Цикл
			Поля.Добавить(Изменение.field);
		КонецЦикла;
	КонецЕсли;
	Исполнение = ИсполнениеЗаявкиПослеРешения(СсылкаЗаявки, RunId, Поля);
	Если НЕ Исполнение.Сбой Тогда
		Возврат "approved";
	КонецЕсли;

	Замечания.Добавить(Исполнение.Ошибка);
	Возврат "approved_not_executed";

КонецФункции

// Исполнение заявки после решения по последней визе (этап 2): механизм БИТ
// исполняет заявку (ИсполнитьЗаявку, в доработках sd_ИсполнитьЗаявку) и при
// ошибке записи справочника выходит без исключения - справочник не меняется, а
// пакет отвечал approved (сквозной тест agentrunner-226, s1: ликвидированный
// контрагент не записался). Статус заявки для проверки не годится: в базах без
// статусов он пуст и у исполненных заявок (2.5.9 давала ложный сбой). Поэтому
// (2.5.10) исполнение проверяется по справочнику: ввод нового - предмет заявки
// создан; изменение - только поля Поля (изменения автоактуализации из ЕГР,
// 2.5.11): в карточке они совпадают с моделью «стало». Сверять все реквизиты
// модели нельзя - БИТ применяет не все (бит_стр_Архив), 2.5.10 давала ложный
// сбой. Сбой пишется в служебный лог уровнем «Ошибка» со ссылкой на заявку.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//  RunId        - Строка - запуск агента (пусто - без привязки к запуску).
//  Поля         - Массив из Строка, Неопределено - реквизиты сверки изменения;
//                 пусто - изменение не сверяется.
//
// Возвращаемое значение:
//  Структура {Сбой - Булево, Статус - Строка, Ошибка - Строка}.
//
Функция ИсполнениеЗаявкиПослеРешения(Знач СсылкаЗаявки, Знач RunId, Знач Поля = Неопределено)

	Итог = Новый Структура("Сбой, Статус, Ошибка", Ложь, "", "");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЗаявки, "ВидОперации, Предмет");
	ПричинаИсполнения = "";
	Если Реквизиты.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		ПричинаИсполнения = ИсполнитьЗаявкуИзменения(СсылкаЗаявки);
	КонецЕсли;
	Причина = "";
	Если Реквизиты.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового Тогда
		Если НЕ ЗначениеЗаполнено(Реквизиты.Предмет) Тогда
			Причина = НСтр("ru = 'элемент справочника не создан'");
		КонецЕсли;
	ИначеЕсли Реквизиты.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение
		И ЗначениеЗаполнено(Реквизиты.Предмет) И Поля <> Неопределено И Поля.Количество() > 0 Тогда
		// Решение уже записано: сбой сверки не ломает ответ агенту - только запись в лог.
		Попытка
			Причина = НеПримененныеИзменения(СсылкаЗаявки, Реквизиты.Предмет, Поля);
		Исключение
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_execution_check_failed",
				СтрШаблон("%1: %2", СсылкаЗаявки, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
				"Предупреждение", RunId, СсылкаЗаявки);
		КонецПопытки;
	КонецЕсли;
	Если НЕ ПустаяСтрока(ПричинаИсполнения) Тогда
		Причина = СокрЛП(ПричинаИсполнения + " " + Причина);
	КонецЕсли;
	Если ПустаяСтрока(Причина) Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.Сбой = Истина;
	Итог.Статус = Причина;
	// Сообщения механизма: сохраненные при решении (2.5.12) и оставшиеся в очереди.
	СообщенияМеханизма = СокрЛП(?(ТипЗнч(СообщенияПоследнегоРешения) = Тип("Строка"), СообщенияПоследнегоРешения, "")
		+ " " + СообщенияМеханизмаСтрокой());
	ШаблонОшибки = НСтр("ru = 'Визы согласованы, но заявка не исполнена (%1): изменения в справочник
		|не внесены, заявку нужно выполнить вручную. %2'");
	Итог.Ошибка = СокрЛП(СтрШаблон(ШаблонОшибки, Причина, СообщенияМеханизма));
	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_execution_failed",
		СтрШаблон("%1: %2", СсылкаЗаявки, Итог.Ошибка), "Ошибка", RunId, СсылкаЗаявки);

	Возврат Итог;

КонецФункции

// Исполнение заявки на изменение механизмом БИТ после решения по визе этапа 2 (2.5.13):
// алгоритм визирования исполняет только ввод нового, изменение - только по статусу
// «Утвержден», который маршрут не ставит. Не исполняется: настройка
// НСИИсполнятьЗаявкуИзменения = Ложь или заявка уже «Исполнена» (исполнил маршрут).
// Сообщения механизма остаются в очереди - их добавляет ИсполнениеЗаявкиПослеРешения.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка на изменение.
//
// Возвращаемое значение:
//  Строка - причина сбоя исполнения ("" - исполнено или не требуется).
//
Функция ИсполнитьЗаявкуИзменения(Знач СсылкаЗаявки)

	Если НЕ НастройкаИстинна(ar_Настройки.ЗначениеНастройки("НСИИсполнятьЗаявкуИзменения", Ложь)) Тогда
		Возврат "";
	КонецЕсли;
	Если бит_ВизированиеСервер.ТекущийСтатус(СсылкаЗаявки)
		= Справочники.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ОбъектЗаявки = СсылкаЗаявки.ПолучитьОбъект();
		ОбъектЗаявки.ИсполнитьЗаявку();
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'исполнение механизмом БИТ: %1'"),
			ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат "";

КонецФункции

// Реквизиты шапки из Поля, которые в карточке предмета не совпадают с моделью
// «стало» заявки (2.5.11; поля без значения в модели не сверяются).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка изменения.
//  Предмет      - СправочникСсылка - изменяемый элемент.
//  Поля         - Массив из Строка - имена реквизитов сверки.
//
// Возвращаемое значение:
//  Строка - «в карточке не применены изменения: <поля>»; пусто - все применены.
//
Функция НеПримененныеИзменения(Знач СсылкаЗаявки, Знач Предмет, Знач Поля)

	ОбъектЗаявки = СсылкаЗаявки.ПолучитьОбъект();
	ГруппаНово = ГруппаМодели(ОбъектЗаявки.ПолучитьМодельОбъекта(), "Реквизиты");
	МодельКарточки = Справочники.бит_мдм_ОписанияОбъектовОбмена.ЭмулироватьРеальныйОбъект(
		Предмет, Предмет.Метаданные());
	ГруппаКарточки = ГруппаМодели(МодельКарточки, "Реквизиты");
	Если ГруппаНово = Неопределено Или ГруппаКарточки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	НеПрименены = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ЗначениеСтало = ЗначениеИзКоллекцииМодели(ГруппаНово, Поле);
		Если ЗначениеСтало = Неопределено Тогда
			Продолжить; // не реквизит шапки (табличная часть) - не сверяется
		КонецЕсли;
		ЗначениеКарточки = ЗначениеИзКоллекцииМодели(ГруппаКарточки, Поле);
		Если НЕ ЗначенияСовпадают(НормализоватьЗначение(ЗначениеКарточки),
			НормализоватьЗначение(ЗначениеСтало)) Тогда
			НеПрименены.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;

	Если НеПрименены.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'в карточке не применены изменения: %1'"), СтрСоединить(НеПрименены, ", "));

КонецФункции

// Ответ инструмента автоактуализации (спека п. 3).
//
// Параметры:
//  Результат  - Строка  - approved / approved_stage1 / handover /
//               service_unavailable / not_actualization.
//  Изменения  - Массив  - {field, was, now}.
//  Ликвидация - Булево  - признак ликвидации из ЕГР.
//  Визы       - Массив  - {visa, decision} - поставленные решения.
//  Замечания  - Массив  - тексты причин и ошибок.
//
// Возвращаемое значение:
//  Строка - JSON-observation с next = finish; для service_unavailable - с
//  терминальным признаком (agentrunner-108, контракт agentrunner-107).
//
Функция ОтветАктуализации(Знач Результат, Знач Изменения, Знач Ликвидация,
	Знач Визы, Знач Замечания)

	Ответ = Новый Структура;
	Ответ.Вставить("result", Результат);
	Ответ.Вставить("changes", Изменения);
	Ответ.Вставить("liquidated", Ликвидация);
	Ответ.Вставить("visas", Визы);
	Ответ.Вставить("remarks", Замечания);
	Ответ.Вставить("next", "finish");
	// agentrunner-108: ЕГР недоступен - «не повторяй вызов», модель завершает
	// отчётом, заявка вернётся в очередь сама (терминальный исход, контракт
	// agentrunner-107); прочие результаты (handover, not_actualization) - без
	// признака, они вне списка п. 1 спеки.
	Если Результат = "service_unavailable" Тогда
		Ответ.Вставить("terminal", Истина);
		Ответ.Вставить("terminal_reason", "service_unavailable");
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Причины отказа как у команды «Заполнить по ИНН» (спека п. 3, шаг 2):
// обособленное подразделение (ОбособленноеПодразделение или sd_ОП), нерезидент,
// ИНН пуст или неверен.
//
// Параметры:
//  РеквизитыКарточки - Структура - реквизиты контрагента (БСП).
//
// Возвращаемое значение:
//  Структура {Код - Строка ("" - отказов нет), Представление - Строка}.
//
Функция ПричинаОтказаФормы(Знач РеквизитыКарточки)

	Результат = Новый Структура;
	Результат.Вставить("Код", "");
	Результат.Вставить("Представление", "");

	Если ЗначениеБулево(РеквизитыКарточки.ОбособленноеПодразделение)
		Или ЗначениеБулево(РеквизитыКарточки.sd_ОП) Тогда
		Результат.Код = "separate_division";
		Результат.Представление =
			НСтр("ru = 'Контрагент - обособленное подразделение: актуализация по ИНН/КПП
				|не выполняется, требуется решение сотрудника НСИ.'");
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеБулево(РеквизитыКарточки.sd_Нерезидент) Тогда
		Результат.Код = "nonresident";
		Результат.Представление =
			НСтр("ru = 'Контрагент - нерезидент: данные ЕГРЮЛ/ЕГРИП не применимы,
				|требуется решение сотрудника НСИ.'");
		Возврат Результат;
	КонецЕсли;

	Если НЕ ИННКорректен(НормализованноеЧислоСтроки(Строка(РеквизитыКарточки.ИНН))) Тогда
		Результат.Код = "inn_invalid";
		Результат.Представление =
			НСтр("ru = 'ИНН контрагента пуст или неверен - актуализация по ИНН невозможна.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заполнение копии контрагента в памяти данными ЕГР (спека п. 3, шаг 5) - то
// же, что ЗаполнитьРеквизитыКонтрагента формы Справочник.Контрагенты.ФормаЭлемента
// (выгрузка «БИТ», стр. 3269) без формы; копия не записывается. Проверки
// обработкой не выполняются (решение человека): данные - из ЕГР.
//
// Параметры:
//  Копия            - СправочникОбъект.Контрагенты - копия Предмет.ПолучитьОбъект().
//  РеквизитыСервиса - Структура - данные сервиса ЕГР (ДанныеСервисаПоИНН).
//  ИНН              - Строка    - ИНН контрагента (10 - ЮЛ, 12 - ИП/ФЛ).
//
Процедура ЗаполнитьКопиюДаннымиЕГР(Знач Копия, Знач РеквизитыСервиса, Знач ИНН)

	ЭтоЮрЛицо = (СтрДлина(ИНН) = 10);

	// Наименование сравнивается с прежним полным до ЗаполнитьЗначенияСвойств:
	// собственное наименование карточки сохраняется (форма: автонайменование,
	// когда было пусто или совпадало с полным).
	ПрежнееНаименование = Копия.Наименование;
	ПрежнееПолное = Копия.НаименованиеПолное;

	ЗаполнитьЗначенияСвойств(Копия, РеквизитыСервиса);
	Сокращенное = ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенное", "");
	Копия.НаименованиеПолное = Сокращенное;
	Если ПустаяСтрока(ПрежнееНаименование) Или ПрежнееНаименование = ПрежнееПолное Тогда
		Копия.Наименование = Сокращенное;
	КонецЕсли;

	ИнтернетПоддержкаПользователейБП.ЗаполнитьИсториюНаименований(Копия, РеквизитыСервиса);

	Если ЭтоЮрЛицо Тогда
		Если НЕ ПустаяСтрока(Копия.КПП) Тогда
			ИнтернетПоддержкаПользователейБП.ЗаполнитьИсториюКПП(Копия, РеквизитыСервиса);
		КонецЕсли;
		ИнтернетПоддержкаПользователейБП.ЗаполнитьИсториюАдресов(Копия, РеквизитыСервиса);
		ДополнитьКонтактнуюИнформациюЕГР(Копия, РеквизитыСервиса);
	Иначе
		Копия.КПП = "";
		ЗаполнитьСвидетельствоИП(Копия, РеквизитыСервиса);
	КонецЕсли;

	// Префикс «ИП » - правило sd_ВыполнитьЗаполнениеРеквизитовПоИНН
	// (bitfin_addition_main, BFAO-4652).
	Если СтрДлина(ИНН) = 12
		И СтрНайти(Копия.Наименование, "ИП ") = 0
		И СтрНайти(Копия.НаименованиеПолное, "ИП ") <> 0 Тогда
		Копия.Наименование = "ИП " + Копия.Наименование;
	КонецЕсли;

	// Ликвидация (Р28): признак и дата - по ДатаПрекращенияДеятельности
	// (образец - ФормаОрганизации bitfin_addition_main, ACCA-3403).
	ДатаПрекращения = ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаПрекращенияДеятельности");
	Если ЗначениеЗаполнено(ДатаПрекращения) Тогда
		Копия.sd_Ликвидирован = Истина;
		Копия.sd_ДатаЛиквидации = ДатаПрекращения;
	Иначе
		Копия.sd_Ликвидирован = Ложь;
		Копия.sd_ДатаЛиквидации = Дата(1, 1, 1);
	КонецЕсли;

КонецПроцедуры

// Свидетельство ИП/ФЛ из данных ЕГР (форма: Серия + " " + Номер, дата выдачи).
Процедура ЗаполнитьСвидетельствоИП(Знач Копия, Знач РеквизитыСервиса)

	Свидетельство = ЗначениеИзСтруктуры(РеквизитыСервиса, "СвидетельствоОРегистрации");
	Если ТипЗнч(Свидетельство) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Копия.СвидетельствоСерияНомер = СокрЛП(
		ЗначениеИзСтруктурыСтрокой(Свидетельство, "Серия", "") + " "
		+ ЗначениеИзСтруктурыСтрокой(Свидетельство, "Номер", ""));
	Копия.СвидетельствоДатаВыдачи = ЗначениеИзСтруктуры(Свидетельство, "Дата");

КонецПроцедуры

// Контактная информация ЮЛ из данных ЕГР (спека п. 3, шаг 5): юридический,
// фактический и почтовый адрес - из ЮридическийАдрес, телефон - из Телефон
// (как в форме). Метод БСП с объектом в базу не пишет.
//
// Параметры:
//  Копия            - СправочникОбъект.Контрагенты - копия в памяти.
//  РеквизитыСервиса - Структура - данные сервиса ЕГР.
//
Процедура ДополнитьКонтактнуюИнформациюЕГР(Знач Копия, Знач РеквизитыСервиса)

	ДополнитьВидКонтактнойИнформацией(Копия, РеквизитыСервиса, "ЮридическийАдрес",
		Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	ДополнитьВидКонтактнойИнформацией(Копия, РеквизитыСервиса, "ЮридическийАдрес",
		Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
	ДополнитьВидКонтактнойИнформацией(Копия, РеквизитыСервиса, "ЮридическийАдрес",
		Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);
	ДополнитьВидКонтактнойИнформацией(Копия, РеквизитыСервиса, "Телефон",
		Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);

КонецПроцедуры

// Одна запись контактной информации по виду: структура сервиса
// {КонтактнаяИнформация, Представление}; пустой JSON - вид не заполняется.
Процедура ДополнитьВидКонтактнойИнформацией(Знач Копия, Знач РеквизитыСервиса,
	Знач ИмяСвойства, Знач ВидИнформации)

	СтруктураДанных = ЗначениеИзСтруктуры(РеквизитыСервиса, ИмяСвойства);
	Если ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ЗначениеJSON = ЗначениеИзСтруктурыСтрокой(СтруктураДанных, "КонтактнаяИнформация", "");
	Если ПустаяСтрока(ЗначениеJSON) Тогда
		Возврат;
	КонецЕсли;
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Копия, ЗначениеJSON,
		ВидИнформации, , Истина);

КонецПроцедуры

// Изменения моделей «было»/«стало» (спека п. 3, шаг 5): реквизиты шапки -
// записи {field, was, now}; табличная часть - одной записью «строк: N» при
// отличии содержимого.
//
// Возвращаемое значение:
//  Массив из Структура {field, was, now}.
//
Функция ИзмененияМоделей(Знач МодельПред, Знач МодельНово)

	Изменения = Новый Массив;

	Группы = Новый Массив;
	Группы.Добавить("Реквизиты");
	Группы.Добавить("СтандартныеРеквизиты");
	Для Каждого ИмяГруппы Из Группы Цикл
		ГруппаНов = ГруппаМодели(МодельНово, ИмяГруппы);
		Если ГруппаНов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ГруппаПред = ГруппаМодели(МодельПред, ИмяГруппы);
		Для Каждого КлючИЗначение Из ГруппаНов Цикл
			Было = ЗначениеИзКоллекцииМодели(ГруппаПред, КлючИЗначение.Ключ);
			Если НЕ ЗначенияСовпадают(НормализоватьЗначение(Было),
				НормализоватьЗначение(КлючИЗначение.Значение)) Тогда
				Изменения.Добавить(Новый Структура("field, was, now",
					КлючИЗначение.Ключ, ЗначениеИзмененияСтрокой(Было),
					ЗначениеИзмененияСтрокой(КлючИЗначение.Значение)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ТабличныеПред = ГруппаМодели(МодельПред, "ТабличныеЧасти");
	ТабличныеНов = ГруппаМодели(МодельНово, "ТабличныеЧасти");
	Если ТабличныеНов = Неопределено Тогда
		Возврат Изменения;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ТабличныеНов Цикл
		СтрокиНов = КлючИЗначение.Значение;
		СтрокиПред = Неопределено;
		Если ТабличныеПред <> Неопределено Тогда
			СтрокиПред = ЗначениеИзКоллекцииМодели(ТабличныеПред, КлючИЗначение.Ключ);
		КонецЕсли;
		Если НЕ ЗначенияСовпадают(НормализоватьЗначение(СтрокиПред),
			НормализоватьЗначение(СтрокиНов)) Тогда
			Изменения.Добавить(Новый Структура("field, was, now",
				КлючИЗначение.Ключ,
				СтрШаблон(НСтр("ru = 'строк: %1'"), Строка(ЧислоСтрокКоллекции(СтрокиПред))),
				СтрШаблон(НСтр("ru = 'строк: %1'"), Строка(ЧислоСтрокКоллекции(СтрокиНов)))));
		КонецЕсли;
	КонецЦикла;

	Возврат Изменения;

КонецФункции

// Число строк коллекции ТЧ (Массив); не массив - 0.
Функция ЧислоСтрокКоллекции(Знач Коллекция)

	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат Коллекция.Количество();
	КонецЕсли;
	Возврат 0;

КонецФункции

// Значение изменения строкой для changes и комментария визы.
Функция ЗначениеИзмененияСтрокой(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Комментарий решений по визам (спека п. 3, шаг 8): «Актуализировано по данным
// ЕГРЮЛ/ЕГРИП: <поле: было -> стало; …>», не больше 500 символов (усечение -
// многоточием, как п. 19 спеки agentrunner-30); без изменений - «Изменений по
// данным ЕГР нет» (Р29).
Функция КомментарийАктуализации(Знач Изменения)

	Если Изменения.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Изменений по данным ЕГР нет'");
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл
		Части.Добавить(СтрШаблон("%1: %2 -> %3",
			Изменение.field, Изменение.was, Изменение.now));
	КонецЦикла;

	Итог = НСтр("ru = 'Актуализировано по данным ЕГРЮЛ/ЕГРИП:'") + " "
		+ СтрСоединить(Части, "; ");
	Если СтрДлина(Итог) > 500 Тогда
		Итог = Лев(Итог, 497) + "...";
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Запись и проведение заявки + решения по визам (спека п. 3, шаги 7-9) в одной
// транзакции: исключительная блокировка заявки и виз, повторные проверки
// свежих данных, запись модели «стало» (если задана), запись с
// ОбменДанными.Загрузка и флагами образца, проведение (визы назначаются),
// «Согласовано» по активным визам агента. Ошибка - откат, текст - в результате.
//
// Параметры:
//  СсылкаЗаявки       - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  МодельНово         - Структура - модель «стало»; Неопределено - модель не
//                       пишется (продолжение проведенной заявки, шаг 9).
//  КомментарийВизы    - Строка    - комментарий решений по визам.
//  ПользовательАгента - СправочникСсылка.Пользователи.
//  ПоставитьВизу1     - Булево    - согласовывать визу этапа 1.
//  ПоставитьВизу2     - Булево    - согласовывать визу этапа 2.
//  ПроводитьЗаявку    - Булево    - проводить после записи модели
//                       (непроведенная заявка); Ложь - заявка уже проведена:
//                       модель пишется с ОбменДанными.Загрузка без
//                       перепроведения, визы сохраняются - подписки механизма
//                       визирования при Загрузке не выполняются (mcp.md [P3]).
//
// Возвращаемое значение:
//  Структура {Успех - Булево, Ошибка - Строка, Визы - Массив {visa, decision},
//  ВизаДваПоставлена - Булево}.
//
Функция ЗаписатьАктуализацию(Знач СсылкаЗаявки, Знач МодельНово, Знач КомментарийВизы,
	Знач ПользовательАгента, Знач ПоставитьВизу1, Знач ПоставитьВизу2,
	Знач ПроводитьЗаявку = Истина)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Визы", Новый Массив);
	Результат.Вставить("ВизаДваПоставлена", Ложь);

	// Очистка очереди сообщений: после записи читаем только сообщения механизмов.
	ПолучитьСообщенияПользователю(Истина);

	Исход = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДанныеРешения(СсылкаЗаявки);

		ТекстОтказа = "";
		Если ПовторнаяПроверкаАктуализации(СсылкаЗаявки, МодельНово <> Неопределено,
			ТекстОтказа, НЕ ПроводитьЗаявку) Тогда
			ОтменитьТранзакцию();
			Результат.Ошибка = ТекстОтказа;
			Возврат Результат;
		КонецЕсли;

		Если МодельНово <> Неопределено Тогда
			ОбъектЗаявки = СсылкаЗаявки.ПолучитьОбъект();
			ОбъектЗаявки.ЗаписатьМодельОбъекта(МодельНово);
			// Запись - с ОбменДанными.Загрузка и флагами образца (спека п. 3,
			// шаг 7), затем проведение без Загрузка - визы назначаются. Для
			// проведенной заявки проведение не повторяется: перепроведение
			// может переназначить маршрут виз.
			ОбъектЗаявки.ОбменДанными.Загрузка = Истина;
			ОбъектЗаявки.ДополнительныеСвойства.Вставить(
				"sd_ЗаписьБезПроверкиПравДоступаПользователяПоНастройке", Истина);
			ОбъектЗаявки.ДополнительныеСвойства.Вставить("sd_ЗаменаСсылок_ЗаписьБезПроверок", Истина);
			ОбъектЗаявки.Записать(РежимЗаписиДокумента.Запись);
			Если ПроводитьЗаявку Тогда
				ОбъектЗаявки.ОбменДанными.Загрузка = Ложь;
				ОбъектЗаявки.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		КонецЕсли;

		СогласоватьВизыАктуализации(СсылкаЗаявки, КомментарийВизы, ПользовательАгента,
			ПоставитьВизу1, ПоставитьВизу2, Результат.Визы, Результат.ВизаДваПоставлена);

		// agentrunner-213 (заявки 00-00000037..39): маршрут назначил визы вне этапов
		// констант GUID либо не пользователю агента - ни одного решения. Без отката
		// заявка оставалась проведенной без решений с ответом approved_stage1 и
		// visas = []; откат - заявка не тронута, вызывающий передает ее сотруднику.
		Если Результат.Визы.Количество() = 0 Тогда
			ВызватьИсключение ТекстВизБезРешенияАктуализации(СсылкаЗаявки);
		КонецЕсли;

		Исход = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		// Транзакция могла быть испорчена вложенным откатом (как в 88).
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
		// Решения по визам откатились вместе с транзакцией - не выдавать их.
		Результат.Визы = Новый Массив;
		Результат.ВизаДваПоставлена = Ложь;
		ТекстПричины = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстСообщений = СообщенияМеханизмаСтрокой();
		Результат.Ошибка = ТекстПричины
			+ ?(ПустаяСтрока(ТекстСообщений), "", " " + ТекстСообщений);
	КонецПопытки;

	Результат.Успех = Исход;
	Возврат Результат;

КонецФункции

// Повторные проверки под блокировкой (аналог п. 19а.3 спеки agentrunner-30):
// заявка доступна, признаки сценария; для записи модели - не проведена другим
// сеансом и модель не менялась после создания (для проведенной заявки -
// ДопускатьПроведенную: проведение допустимо, виза этапа 1 по-прежнему без
// решения, иначе заявка изменена другим сеансом - agentrunner-210). При отказе
// заполняет ТекстОтказа.
//
// Параметры:
//  СсылкаЗаявки         - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ПроверятьМодель      - Булево  - проверять непроведенность и неизменность
//                         модели (запись модели выполняется).
//  ТекстОтказа          - Строка  - текст отказа (выходной).
//  ДопускатьПроведенную - Булево  - заявка проведена: допустима, если модель
//                         не менялась после создания и виза этапа 1 без
//                         решения (полная актуализация проведенной заявки).
//
// Возвращаемое значение:
//  Булево - Истина, если запись актуализации нельзя выполнять.
//
Функция ПовторнаяПроверкаАктуализации(Знач СсылкаЗаявки, Знач ПроверятьМодель, ТекстОтказа,
	Знач ДопускатьПроведенную = Ложь)

	ТекстОтказа = "";

	СвежиеДанные = ДанныеЗаявки(СсылкаЗаявки);
	Если СвежиеДанные.Шапка = Неопределено Тогда
		ТекстОтказа = НСтр("ru = 'Заявка недоступна для актуализации.'");
		Возврат Истина;
	КонецЕсли;
	Шапка = СвежиеДанные.Шапка;

	Если НЕ ЭтоЗаявкаАктуализации(Шапка) Тогда
		ТекстОтказа = НСтр("ru = 'Заявка перестала быть заявкой автоактуализации.'");
		Возврат Истина;
	КонецЕсли;

	Если НЕ ПроверятьМодель И НЕ Шапка.Проведен Тогда
		ТекстОтказа = НСтр("ru = 'Заявка не проведена - продолжение актуализации невозможно.'");
		Возврат Истина;
	КонецЕсли;

	Если ПроверятьМодель Тогда
		Если Шапка.Проведен И НЕ ДопускатьПроведенную Тогда
			ТекстОтказа = НСтр("ru = 'Заявка проведена другим сеансом.'");
			Возврат Истина;
		КонецЕсли;
		МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
		ХешСтало = ХешМоделейЗаявки(МодельСтало, СвежиеДанные.Подчиненные);
		МодельПред = МодельИзХранилища(Шапка.ХранилищеМодельОбъектаПред);
		ХешПред = ХешМоделейЗаявки(МодельПред, СвежиеДанные.Подчиненные, Истина);
		Если ХешПред <> ХешСтало Тогда
			ТекстОтказа = НСтр("ru = 'Модель заявки изменилась во время актуализации.'");
			Возврат Истина;
		КонецЕсли;
		Если ДопускатьПроведенную И НЕ ВизаПервогоЭтапаБезРешения(СсылкаЗаявки) Тогда
			ТекстОтказа =
				НСтр("ru = 'Заявка изменена другим сеансом - виза первого этапа уже с решением.'");
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Виза этапа 1 по-прежнему без решения (повторная проверка проведенной заявки
// под блокировкой, agentrunner-210): запись визы активна и решение пусто.
// Записи нет (константа GUID пуста, маршрут изменен другим сеансом) - Ложь.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Булево - Истина - виза этапа 1 активна у заявки и решения по ней нет.
//
Функция ВизаПервогоЭтапаБезРешения(Знач СсылкаЗаявки)

	ВизаЭтапа1 = СсылкаВизыЭтапа(1);
	Если НЕ ЗначениеЗаполнено(ВизаЭтапа1) Тогда
		Возврат Ложь;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	Отбор.Вставить("Виза", ВизаЭтапа1);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НаборВизы[0].АктивнаяВиза И НЕ ЗначениеЗаполнено(НаборВизы[0].Решение);

КонецФункции

// «Согласовано» по визам сценария (спека п. 3, шаги 8-9): решение ставится,
// если запись визы активна, без решения и виза назначена пользователю агента;
// иначе виза остается сотруднику. Отказ решения - исключение (откатит
// транзакцию записи).
//
// Параметры:
//  СсылкаЗаявки       - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  КомментарийВизы    - Строка - комментарий решений.
//  ПользовательАгента - СправочникСсылка.Пользователи.
//  ПоставитьВизу1     - Булево - согласовывать визу этапа 1.
//  ПоставитьВизу2     - Булево - согласовывать визу этапа 2.
//  Визы               - Массив  - итоги {visa, decision} (пополняется).
//  ВизаДваПоставлена  - Булево  - признак решения по визе этапа 2 (выходной).
//
Процедура СогласоватьВизыАктуализации(Знач СсылкаЗаявки, Знач КомментарийВизы,
	Знач ПользовательАгента, Знач ПоставитьВизу1, Знач ПоставитьВизу2,
	Знач Визы, ВизаДваПоставлена)

	ВизаДваПоставлена = Ложь;

	СписокВизАгента = бит_ВизированиеСервер.ВизыПользователя(ПользовательАгента, СсылкаЗаявки);
	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);

	// agentrunner-213 (заявка 00-00086917): решение по визе 1 механизм БИТ
	// активирует визу 2 сразу, в той же транзакции (ДовыполнитьАлгоритмВизирования).
	// Набор перечитывается после каждого решения: по снимку до решения виза 2
	// неактивна - результат был approved_stage1 и второй запуск агента по заявке.
	// Перечитываний не больше числа виз заявки: решенная виза повторно не
	// отбирается (ВизаСценарияОтбирается, ПоставленныеВизы).
	ПоставленныеВизы = Новый Массив;
	ЕстьНовоеРешение = Истина;
	Пока ЕстьНовоеРешение Цикл
		ЕстьНовоеРешение = Ложь;
		НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
		Для Каждого ЗаписьВизы Из НаборВизы Цикл
			Если ПоставленныеВизы.Найти(ЗаписьВизы.ИД) <> Неопределено
				Или НЕ ВизаСценарияОтбирается(ЗаписьВизы, ПоставитьВизу1, ПоставитьВизу2,
					СписокВизАгента) Тогда
				Продолжить;
			КонецЕсли;
			СогласоватьВизуАктуализации(СсылкаЗаявки, ЗаписьВизы, КомментарийВизы,
				ПользовательАгента, Визы, ВизаДваПоставлена);
			ПоставленныеВизы.Добавить(ЗаписьВизы.ИД);
			ЕстьНовоеРешение = Истина;
			Прервать; // Набор перечитывается: решение могло активировать следующую визу.
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Текст отказа актуализации, когда ни одна виза маршрута не согласована
// (ЗаписатьАктуализацию): перечень виз заявки с этапом по константам GUID,
// активностью и решением - по нему видно, что маршрут назначил визы вне этапов
// (этап 0) или визы уже решены.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка актуализации.
//
// Возвращаемое значение:
//  Строка - текст ошибки для отката транзакции и передачи сотруднику НСИ.
//
Функция ТекстВизБезРешенияАктуализации(Знач СсылкаЗаявки)

	Отбор = Новый Структура("Объект", СсылкаЗаявки);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	Части = Новый Массив;
	ШаблонВизы = НСтр("ru = '%1 (этап %2, активна: %3, решение: %4)'");
	Для Каждого ЗаписьВизы Из НаборВизы Цикл
		Этап = ЭтапВизыПоСсылке(ЗаписьВизы.Виза);
		Активна = Формат(ЗаписьВизы.АктивнаяВиза, "БЛ=нет; БИ=да");
		Решение = ?(ЗначениеЗаполнено(ЗаписьВизы.Решение), Строка(ЗаписьВизы.Решение), "-");
		ОписаниеВизы = СтрШаблон(ШаблонВизы, Строка(ЗаписьВизы.Виза), Этап, Активна, Решение);
		Части.Добавить(ОписаниеВизы);
	КонецЦикла;

	ПереченьВиз = ?(Части.Количество() = 0, НСтр("ru = 'нет'"), СтрСоединить(Части, "; "));
	Возврат СтрШаблон(НСтр("ru = 'Ни одна виза маршрута не согласована агентом: визы вне этапов
		|маршрута (константы GUID, этап 0) или не назначены пользователю агента. Визы заявки: %1.'"),
		ПереченьВиз);

КонецФункции

// «Согласовано» по одной визе сценария (СогласоватьВизыАктуализации): решение
// механизмом визирования; отказ механизма - исключение (откатит транзакцию записи).
//
// Параметры:
//  СсылкаЗаявки       - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ЗаписьВизы         - РегистрСведенийЗапись.бит_УстановленныеВизы - отобранная виза.
//  КомментарийВизы    - Строка - комментарий решения.
//  ПользовательАгента - СправочникСсылка.Пользователи.
//  Визы               - Массив  - итоги {visa, decision} (пополняется).
//  ВизаДваПоставлена  - Булево  - признак решения по визе этапа 2 (выходной).
//
Процедура СогласоватьВизуАктуализации(Знач СсылкаЗаявки, Знач ЗаписьВизы, Знач КомментарийВизы,
	Знач ПользовательАгента, Знач Визы, ВизаДваПоставлена)

	ТекстОшибки = "";
	ПроверкиВизы = ПроверкиРешенияВизы(СсылкаЗаявки, ЗаписьВизы.ИД,
		КомментарийВизы, ПользовательАгента);
	Если НЕ УстановитьРешениеМеханизмом(ПроверкиВизы, ТекстОшибки) Тогда
		ВызватьИсключение
			?(ПустаяСтрока(ТекстОшибки),
				НСтр("ru = 'Механизм визирования не принял решение.'"), ТекстОшибки);
	КонецЕсли;

	РешениеВизы = Новый Структура("visa, decision", Строка(ЗаписьВизы.Виза), "approved");
	Визы.Добавить(РешениеВизы);
	ВизаДваПоставлена = (ЭтапВизыПоСсылке(ЗаписьВизы.Виза) = 2) Или ВизаДваПоставлена;

КонецПроцедуры

// Запись визы отбирается для согласования сценария (спека п. 3, шаги 8-9):
// этап входит в маршрут и запрошен вызывающим, виза активна, без решения и
// назначена пользователю агента (иначе виза остается сотруднику).
//
// Возвращаемое значение:
//  Булево.
//
Функция ВизаСценарияОтбирается(Знач ЗаписьВизы, Знач ПоставитьВизу1, Знач ПоставитьВизу2,
	Знач СписокВизАгента)

	Этап = ЭтапВизыПоСсылке(ЗаписьВизы.Виза);
	Если Этап = 0 Тогда
		Возврат Ложь; // Виза вне этапов маршрута - заявке не выдается.
	КонецЕсли;
	Если (Этап = 1 И НЕ ПоставитьВизу1) Или (Этап = 2 И НЕ ПоставитьВизу2) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если (НЕ ЗаписьВизы.АктивнаяВиза) Или ЗначениеЗаполнено(ЗаписьВизы.Решение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СписокВизАгента.НайтиПоЗначению(ЗаписьВизы.Виза) <> Неопределено;

КонецФункции

// Структура «Проверки» для УстановитьРешениеМеханизмом и
// ЗаписатьКомментарийВизыПривилегированно из набора решения по одной визе
// (поля те же, что у ПроверкиПередРешением; Сценарий пуст - текст передачи
// собирается без сценария).
//
// Возвращаемое значение:
//  Структура {СсылкаЗаявки, ИДВизы, КодРешения, Комментарий, КомментарийВизы,
//  Сценарий, ПользовательАгента}.
//
Функция ПроверкиРешенияВизы(Знач СсылкаЗаявки, Знач ИДВизы, Знач Комментарий,
	Знач ПользовательАгента)

	Проверки = Новый Структура;
	Проверки.Вставить("СсылкаЗаявки", СсылкаЗаявки);
	Проверки.Вставить("ИДВизы", ИДВизы);
	Проверки.Вставить("КодРешения", "approve");
	Проверки.Вставить("Комментарий", Комментарий);
	Проверки.Вставить("КомментарийВизы", "");
	Проверки.Вставить("Сценарий", "");
	Проверки.Вставить("ПользовательАгента", ПользовательАгента);
	Возврат Проверки;

КонецФункции

// Комментарий записи визы этапа 1 (для «того же комментария» на визе 2).
Функция КомментарийВизы1(Знач СсылкаЗаявки)

	ВизаЭтапа1 = СсылкаВизыЭтапа(1);
	Если НЕ ЗначениеЗаполнено(ВизаЭтапа1) Тогда
		Возврат "";
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	Отбор.Вставить("Виза", ВизаЭтапа1);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(НаборВизы[0].Комментарий));

КонецФункции

// Передача сотруднику НСИ непроведенной заявки (спека п. 4): у заявки виз нет,
// «передать» = отметка отложения ядра с ключом "actualize" и отпечатком-хешем
// модели; заявка не изменяется. Причина - в служебном логе и ответе.
//
// Параметры:
//  Контекст       - Структура - контекст запуска.
//  СсылкаЗаявки   - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ХешТекущий     - Строка    - model_hash заявки (отпечаток отметки).
//  ПричинаОтказа  - Структура - {Код, Представление}.
//
// Возвращаемое значение:
//  Строка - JSON-observation result = handover.
//
Функция ПередачаНепроведенной(Знач Контекст, Знач СсылкаЗаявки, Знач ХешТекущий,
	Знач ПричинаОтказа)

	Причина = "handover:" + ПричинаОтказа.Код;
	ОтметкаОтложенияЗаписать(Контекст, СсылкаЗаявки,
		КлючОтложенияАктуализации(), ХешТекущий, Причина);
	ЗаписатьЛогПередачиАктуализации(СсылкаЗаявки, ПричинаОтказа.Код,
		ПричинаОтказа.Представление);

	Замечания = Новый Массив;
	Замечания.Добавить(ПричинаОтказа.Представление);
	Возврат ОтветАктуализации("handover", Новый Массив, Ложь, Новый Массив, Замечания);

КонецФункции

// Передача после сбоя записи/проведения (спека п. 3, шаг 7): заявка не тронута
// (транзакция откатилась), отметка отложения - до изменения модели.
Функция ПередачаПослеСбояЗаписи(Знач Контекст, Знач СсылкаЗаявки, Знач ХешТекущий,
	Знач ТекстОшибки)

	ОтметкаОтложенияЗаписать(Контекст, СсылкаЗаявки,
		КлючОтложенияАктуализации(), ХешТекущий, "handover:post_failed");
	ЗаписатьЛогПередачиАктуализации(СсылкаЗаявки, "post_failed", ТекстОшибки);

	Замечания = Новый Массив;
	Замечания.Добавить(НСтр("ru = 'Заявка не проведена - запись не удалась:'"));
	Замечания.Добавить(ТекстОшибки);
	Возврат ОтветАктуализации("handover", Новый Массив, Ложь, Новый Массив, Замечания);

КонецФункции

// Передача сотруднику НСИ проведенной заявки (спека п. 4 - «обычным путем 88»):
// комментарий визы привилегированно, решение не ставится, отметка отложения по
// ИД визы и текущему model_hash - фильтр общей очереди 88.
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ИДВизы       - Строка    - ИД активной визы агента.
//  Причина      - Строка    - причина передачи (в комментарий визы и ответ).
//
// Возвращаемое значение:
//  Строка - JSON-observation result = handover.
//
Функция ПередачаПроведенной(Знач Контекст, Знач СсылкаЗаявки, Знач ИДВизы, Знач Причина)

	ТекстОшибки = "";
	ЗаписатьКомментарийВизыПривилегированно(
		ПроверкиРешенияВизы(СсылкаЗаявки, ИДВизы, Причина,
			ПользовательАгентаИзКонтекста(Контекст)),
		ТекстОшибки);

	Агент = АгентИзКонтекста(Контекст);
	Если ЗначениеЗаполнено(Агент) Тогда
		Попытка
			ar_AuditЗащищённыйРежим.ОтложитьПредметПривилегированно(Агент, СсылкаЗаявки,
				ИДВизы, ХешМоделиЗаявкиДляОтметки(СсылкаЗаявки), Причина,
				RunIdИзКонтекста(Контекст));
		Исключение
			ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "deferral_not_saved",
				СтрШаблон("%1: %2", Строка(СсылкаЗаявки),
					ar_Утилиты.ОчиститьОшибкуДляLLM(
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
				"Предупреждение");
		КонецПопытки;
	КонецЕсли;

	ЗаписатьЛогПередачиАктуализации(СсылкаЗаявки, "handover_visa", Причина);

	Замечания = Новый Массив;
	Замечания.Добавить(Причина);
	Возврат ОтветАктуализации("handover", Новый Массив, Ложь, Новый Массив, Замечания);

КонецФункции

// Повтор при недоступном сервисе ЕГР (спека п. 4): счетчик попыток хранится в
// отметке отложения («service_unavailable:<n>»); повтор не раньше
// НСИАктуализацияПовторЧасов (фильтр очереди), после
// НСИАктуализацияПопытокЕГР неудач - передача сотруднику НСИ.
//
// Параметры:
//  Контекст     - Структура - контекст запуска.
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  ХешТекущий   - Строка    - model_hash заявки (отпечаток отметки).
//  ТекстОшибки  - Строка    - текст ошибки сервиса (в лог и ответ).
//
// Возвращаемое значение:
//  Строка - JSON-observation result = service_unavailable либо handover.
//
Функция ПовторАктуализации(Знач Контекст, Знач СсылкаЗаявки, Знач ХешТекущий, Знач ТекстОшибки)

	ТекущаяОтметка = ОтметкаАктуализацииТекущая(Контекст, СсылкаЗаявки);
	Счетчик = 1;
	Если ТекущаяОтметка <> Неопределено Тогда
		Счетчик = ЧислоПопытокЕГРВОтметке(ТекущаяОтметка.Причина) + 1;
	КонецЕсли;

	Если Счетчик >= ПопыткиАктуализацииЕГР() Тогда
		ОтметкаОтложенияЗаписать(Контекст, СсылкаЗаявки, КлючОтложенияАктуализации(),
			ХешТекущий, "handover:egr_unavailable");
		ТекстПричины = СтрШаблон(
			НСтр("ru = 'Сервис ЕГРЮЛ/ЕГРИП недоступен после %1 попыток - заявка передана
				|сотруднику НСИ.'"),
			Строка(Счетчик));
		ЗаписатьЛогПередачиАктуализации(СсылкаЗаявки, "egr_unavailable",
			ТекстПричины + " " + ТекстОшибки);
		Замечания = Новый Массив;
		Замечания.Добавить(ТекстПричины);
		Возврат ОтветАктуализации("handover", Новый Массив, Ложь, Новый Массив, Замечания);
	КонецЕсли;

	Причина = СтрШаблон("service_unavailable:%1: %2", Строка(Счетчик),
		Лев(СокрЛП(ТекстОшибки), 300));
	ОтметкаОтложенияЗаписать(Контекст, СсылкаЗаявки,
		КлючОтложенияАктуализации(), ХешТекущий, Причина);
	ЗаписатьЛогПередачиАктуализации(СсылкаЗаявки, "service_unavailable", ТекстОшибки);

	Замечания = Новый Массив;
	Замечания.Добавить(НСтр("ru = 'Сервис ЕГРЮЛ/ЕГРИП недоступен - не повторяй вызов:
		|заявка вернётся в очередь сама.'"));
	Возврат ОтветАктуализации("service_unavailable", Новый Массив, Ложь, Новый Массив, Замечания);

КонецФункции

// Запись отметки отложения ядра по ключу и отпечатку (сценарий автоактуализации
// - спека п. 4); сбой - журнал deferral_not_saved, актуализация не отменяется.
//
// Возвращаемое значение:
//  Булево - Истина, если отметка записана.
//
Функция ОтметкаОтложенияЗаписать(Знач Контекст, Знач СсылкаЗаявки, Знач Ключ,
	Знач Отпечаток, Знач Причина)

	Агент = АгентИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат ar_AuditЗащищённыйРежим.ОтложитьПредметПривилегированно(Агент, СсылкаЗаявки,
			Ключ, Отпечаток, Причина, RunIdИзКонтекста(Контекст));
	Исключение
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "deferral_not_saved",
			СтрШаблон("%1: %2", Строка(СсылкаЗаявки),
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Предупреждение");
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Действующая отметка отложения заявки (ключ/отпечаток не проверяются -
// решает вызывающий).
//
// Возвращаемое значение:
//  Структура {Ключ, Отпечаток, ОтложенВ, Причина} или Неопределено.
//
Функция ОтметкаАктуализацииТекущая(Знач Контекст, Знач СсылкаЗаявки)

	Агент = АгентИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отложенные = ar_AuditЗащищённыйРежим.ОтложенныеПредметыПривилегированно(Агент,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаЗаявки));
	Возврат Отложенные.Получить(СсылкаЗаявки);

КонецФункции

// Блокирует ли отметка отложения выдачу заявки (спека п. 4): ключ
// автоактуализации и отпечаток равны текущему model_hash; для
// service_unavailable - только до ОтложенВ + НСИАктуализацияПовторЧасов,
// для handover:<код> - до изменения модели.
Функция ОтметкаБлокируетАктуализацию(Знач Отметка, Знач ХешМодели)

	Если Отметка.Ключ <> КлючОтложенияАктуализации() Или Отметка.Отпечаток <> ХешМодели Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(СокрЛП(Отметка.Причина)), "service_unavailable:") Тогда
		СекундВЧасе = 3600;
		Возврат ТекущаяДатаСеанса()
			< Отметка.ОтложенВ + ПовторАктуализацииЧасов() * СекундВЧасе;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Счетчик попыток ЕГР из причины отметки («service_unavailable:<n>: …»).
Функция ЧислоПопытокЕГРВОтметке(Знач Причина)

	Если НЕ СтрНачинаетсяС(НРег(СокрЛП(Причина)), "service_unavailable:") Тогда
		Возврат 0;
	КонецЕсли;

	Части = СтрРазделить(Причина, ":", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат 0;
	КонецЕсли;
	Число = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СокрЛП(Части[1]));
	Возврат ?(Число = Неопределено, 0, Число);

КонецФункции

// Ключ отметки отложения ядра для заявок автоактуализации (спека п. 4).
Функция КлючОтложенияАктуализации()
	Возврат "actualize";
КонецФункции

// Ключ отметки отложения ядра для обычных заявок при недоступном сервисе ЕГР
// (agentrunner-118, п. 2 спеки): не ключ актуализации и не ИД визы (handover) -
// фильтр очереди ОтложеноОтметкаСтроки знает его отдельно.
Функция КлючОтложенияНедоступностиЕГР()
	Возврат "egr_unavailable";
КонецФункции

// Текущий model_hash заявки для отпечатка отметки; заявка недоступна - "".
Функция ХешМоделиЗаявкиДляОтметки(Знач СсылкаЗаявки)

	Данные = ДанныеЗаявки(СсылкаЗаявки);
	Если Данные.Шапка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ХешМоделейЗаявки(
		МодельИзХранилища(Данные.Шапка.ХранилищеМодельОбъекта), Данные.Подчиненные);

КонецФункции

// Кандидаты ветки очереди автоактуализации (спека п. 2): один запрос -
// непроведенные заявки с признаками п. 1 (дата не раньше даты начала, не
// помечены на удаление, не исключены внешними системами - тем же анти-
// соединением 88), не больше 200 (как общий запрос очереди), по дате документа.
// «Предмет заполнен» проверяется в памяти (тип Предмет - все справочники,
// mcp.md [P3]).
//
// Возвращаемое значение:
//  Массив из Структура {Заявка, Предмет}.
//
Функция ЗаявкиАктуализацииКандидаты()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОбработкиЗаявок());
	Запрос.УстановитьПараметр("ИсключенныеСистемы", СсылкиИсключенныхВнешнихСистем());
	Запрос.УстановитьПараметр("ИмяОбъекта", "Контрагенты");
	Запрос.УстановитьПараметр("КомментарийПризнак", ТекстПризнакаКомментария());
	Запрос.УстановитьПараметр("АргументацияПризнак", ТекстПризнакаАргументации());
	// Комментарий и сд_Аргументация - строки неограниченной длины (mcp.md [P3]):
	// сравнение на равенство - только через ВЫРАЗИТЬ КАК СТРОКА.
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
		|	Заявки.Ссылка КАК Заявка,
		|	Заявки.Предмет КАК Предмет
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок
		|		ПО Заявки.ОписаниеОбъекта = ОписанияЗаявок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.sd_СоответствиеОбъектовВнешнихСистем КАК СоответствиеВИС
		|		ПО ВЫРАЗИТЬ(СоответствиеВИС.СсылкаБФ КАК Документ.бит_мдм_ЗаявкаНаИзменение) = Заявки.Ссылка
		|			И СоответствиеВИС.ВнешняяИнформационнаяСистема В (&ИсключенныеСистемы)
		|ГДЕ
		|	НЕ Заявки.Проведен
		|	И НЕ Заявки.ПометкаУдаления
		|	И Заявки.Дата >= &ДатаНачала
		|	И Заявки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение)
		|	И ВЫРАЗИТЬ(Заявки.Комментарий КАК СТРОКА(500)) = &КомментарийПризнак
		|	И ВЫРАЗИТЬ(Заявки.сд_Аргументация КАК СТРОКА(500)) = &АргументацияПризнак
		|	И ОписанияЗаявок.Имя = &ИмяОбъекта
		|	И СоответствиеВИС.ВнешняяИнформационнаяСистема ЕСТЬ NULL
		|УПОРЯДОЧИТЬ ПО
		|	Заявки.Дата";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Заявка, Предмет",
			Выборка.Заявка, Выборка.Предмет));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ветка очереди автоактуализации (спека п. 2): кандидаты без действующей
// отметки отложения ядра (ключ "actualize"). Отметки читаются одним запросом,
// model_hash - одним пакетным чтением только для отмеченных заявок (как в 88).
//
// Параметры:
//  Агент              - СправочникСсылка.ar_Агенты - агент очереди.
//  Лимит              - Число  - предельное число заявок.
//  ВключаяОтложенных  - Булево - отложенные не пропускаются (include_handed_over).
//
// Возвращаемое значение:
//  Структура:
//   * Заявки    - Массив ссылок на заявки (не больше Лимит).
//   * Пропущено - Число  - заявок, пропущенных по отметке (без включения).
//   * Отложенные - Соответствие - "Заявка -> {Ключ, Отпечаток, ОтложенВ,
//                 Причина}" - действующие отметки выданных заявок.
//
Функция ЗаявкиАктуализации(Знач Агент, Знач Лимит, Знач ВключаяОтложенных = Ложь)

	Результат = Новый Структура;
	Результат.Вставить("Заявки", Новый Массив);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Отложенные", Новый Соответствие);

	Кандидаты = ЗаявкиАктуализацииКандидаты();
	Если Кандидаты.Количество() = 0 Или НЕ ЗначениеЗаполнено(Агент) Тогда
		Возврат Результат;
	КонецЕсли;

	СсылкиКандидатов = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		СсылкиКандидатов.Добавить(Кандидат.Заявка);
	КонецЦикла;

	Отметки = ar_AuditЗащищённыйРежим.ОтложенныеПредметыПривилегированно(Агент, СсылкиКандидатов);
	ХешиОтпечатков = Новый Соответствие;
	Если Отметки.Количество() > 0 Тогда
		ХешиОтпечатков = ХешиМоделейЗаявок(КлючиСоответствия(Отметки));
	КонецЕсли;

	Для Каждого Кандидат Из Кандидаты Цикл

		Если Результат.Заявки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Кандидат.Предмет) Тогда
			Продолжить; // «Предмет заполнен» - признак сценария (п. 1 спеки).
		КонецЕсли;

		Отметка = Отметки.Получить(Кандидат.Заявка);
		Если Отметка <> Неопределено
			И ОтметкаБлокируетАктуализацию(Отметка, ХешиОтпечатков.Получить(Кандидат.Заявка)) Тогда
			Если НЕ ВключаяОтложенных Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Результат.Отложенные.Вставить(Кандидат.Заявка, Отметка);
		КонецЕсли;
		Результат.Заявки.Добавить(Кандидат.Заявка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Элементы nsi_pending_visas для заявок автоактуализации (спека п. 2):
// stage = "actualize", next = "nsi_actualize_request", виза не назначена.
//
// Параметры:
//  Контекст            - Структура - контекст запуска (Агент).
//  Лимит               - Число    - свободный остаток лимита списка.
//  ВключаяОтложенных   - Булево    - отложенные включаются с handed_over.
//  Элементы            - Массив   - элементы ответа (пополняется).
//  ПропущеноОтложенных - Число    - счетчик пропущенных отметок (выходной).
//
Процедура ДополнитьСписокЗаявкамиАктуализации(Знач Контекст, Знач Лимит,
	Знач ВключаяОтложенных, Знач Элементы, ПропущеноОтложенных)

	ПропущеноОтложенных = 0;

	Остаток = Лимит - Элементы.Количество();
	Если Остаток <= 0 Тогда
		Возврат;
	КонецЕсли;

	Ветка = ЗаявкиАктуализации(АгентИзКонтекста(Контекст), Остаток, ВключаяОтложенных);
	Если Ветка.Заявки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Шапки = РеквизитыЗаявокШапки(Ветка.Заявки);
	Для Каждого СсылкаЗаявки Из Ветка.Заявки Цикл
		Шапка = Шапки.Получить(СсылкаЗаявки);
		Если Шапка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элементы.Добавить(ЭлементСпискаАктуализации(Шапка,
			Ветка.Отложенные.Получить(СсылкаЗаявки)));
	КонецЦикла;
	ПропущеноОтложенных = Ветка.Пропущено;

КонецПроцедуры

// Элемент массива items ответа nsi_pending_visas для заявки автоактуализации
// (структура - как ЭлементСпискаЗаявок, визы нет).
Функция ЭлементСпискаАктуализации(Знач Шапка, Знач Отметка)

	Элемент = Новый Структура;
	Элемент.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Ссылка));
	Элемент.Вставить("request_presentation", Строка(Шапка.Ссылка));
	Элемент.Вставить("request_date", Шапка.Дата);
	Элемент.Вставить("operation", ОперацияСценария(Шапка));
	Элемент.Вставить("scenario", "actualize");
	Элемент.Вставить("initiator", ИнициаторЗаявкиСтрокой(Шапка));
	Элемент.Вставить("visa", Неопределено);
	Элемент.Вставить("visa_id", Неопределено);
	Элемент.Вставить("stage", "actualize");
	// Файлов у заявок сценария нет - распознавание не ожидается.
	Элемент.Вставить("files_recognizing", Ложь);
	Элемент.Вставить("next", "nsi_actualize_request");
	Элемент.Вставить("due_date", Неопределено);

	Если Отметка <> Неопределено Тогда
		Элемент.Вставить("handed_over",
			Новый Структура("at, comment", Отметка.ОтложенВ, Отметка.Причина));
	КонецЕсли;

	Возврат Элемент;

КонецФункции

// Заявка автоактуализации (п. 1 спеки): по контрагентам, ВидОперации =
// Изменение, предмет заполнен, комментарий и аргументация равны признакам из
// настроек пакета, не помечена на удаление. Исключение внешней системой
// проверяется в запросе очереди и в вызове инструмента (ЗаявкаИсключена).
Функция ЭтоЗаявкаАктуализации(Знач Шапка)

	Возврат НЕ Шапка.ПометкаУдаления
		И Шапка.ИмяОбъекта = "Контрагенты"
		И Шапка.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение
		И ЗначениеЗаполнено(Шапка.Предмет)
		И ПризнакСовпадает(Шапка.Комментарий, ТекстПризнакаКомментария())
		И ПризнакСовпадает(Шапка.сд_Аргументация, ТекстПризнакаАргументации());

КонецФункции

// Признак совпадает с настройкой (обе стороны без крайних пробелов).
Функция ПризнакСовпадает(Знач Значение, Знач Признак)

	Возврат СокрЛП(Строка(Значение)) = СокрЛП(Признак);

КонецФункции

// next ответа nsi_get_request вне этапа 2 (agentrunner-96): для заявки
// автоактуализации - nsi_actualize_request, при активной визе агента -
// nsi_verify_request, иначе не определен.
//
// Параметры:
//  ЭтоАктуализация - Булево - заявка сценария автоактуализации.
//  ЕстьВизаАгента  - Булево - активная виза агента найдена.
//
// Возвращаемое значение:
//  Строка, Неопределено.
//
Функция СледующийШагЧтения(Знач ЭтоАктуализация, Знач ЕстьВизаАгента)

	Если ЭтоАктуализация Тогда
		Возврат "nsi_actualize_request";
	КонецЕсли;
	Возврат ?(ЕстьВизаАгента, "nsi_verify_request", Неопределено);

КонецФункции

// Нужен ли в ответе nsi_get_request блок этапа 2 (п. 3 спеки agentrunner-88):
// активная виза агента - этап 2. Для заявок автоактуализации блок не собирается
// (agentrunner-96) - счёт и сверка этапа 2 сценарием не применяются.
//
// Возвращаемое значение:
//  Булево.
//
Функция ДанныеЭтапаДваНужны(Знач ВизаАгента, Знач ЭтоАктуализация)

	Возврат ВизаАгента.Найдена И ВизаАгента.Этап = 2 И НЕ ЭтоАктуализация;

КонецФункции

// Легкая проверка признаков заявки автоактуализации по ссылке (для защиты
// обычных инструментов, до тяжелой работы). Отличается от ЭтоЗаявкаАктуализации
// только проверкой предмета: тип Предмет - все справочники (mcp.md [P3]),
// заполненность в запросе не выражается; заявка без предмета не обрабатывается
// агентом вовсе (not_actualization в nsi_actualize_request).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЗаявкаАктуализацииПоСсылке(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.УстановитьПараметр("ИмяОбъекта", "Контрагенты");
	Запрос.УстановитьПараметр("КомментарийПризнак", ТекстПризнакаКомментария());
	Запрос.УстановитьПараметр("АргументацияПризнак", ТекстПризнакаАргументации());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Истина КАК ЕстьЗапись
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок
		|		ПО Заявки.ОписаниеОбъекта = ОписанияЗаявок.Ссылка
		|ГДЕ
		|	Заявки.Ссылка = &Ссылка
		|	И ОписанияЗаявок.Имя = &ИмяОбъекта
		|	И Заявки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение)
		|	И ВЫРАЗИТЬ(Заявки.Комментарий КАК СТРОКА(500)) = &КомментарийПризнак
		|	И ВЫРАЗИТЬ(Заявки.сд_Аргументация КАК СТРОКА(500)) = &АргументацияПризнак";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Текст отказа use_actualize_request для обычных инструментов.
Функция ТекстИспользуйАктуализацию()

	Возврат НСтр("ru = 'Заявка автоактуализации по ИНН/КПП: используй инструмент
		|nsi_actualize_request - обычные сверка и решение по визе к ней не применяются.'");

КонецФункции

// Файл протокола автоактуализации (спека п. 3, шаг 8 - «как в 88»): текстовый
// UTF-8 файл у заявки с изменениями и решениями по визам. Сбой записи не влияет
// на результат - журнал регистрации.
//
// Возвращаемое значение:
//  Булево - Истина, если файл записан.
//
Функция ЗаписатьПротоколАктуализации(Знач СсылкаЗаявки, Знач ПользовательАгента, Знач RunId,
	Знач Изменения, Знач Ликвидация, Знач Визы)

	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Протокол автоактуализации агентом НСИ'"));
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЗаявки, "Номер, Дата");
	Части.Добавить(СтрШаблон(НСтр("ru = 'Заявка: %1 от %2 (%3)'"),
		Реквизиты.Номер, Формат(Реквизиты.Дата, "ДФ=dd.MM.yyyy"), Строка(СсылкаЗаявки)));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Дата и время: %1'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss")));
	Части.Добавить(СтрШаблон(НСтр("ru = 'RunId: %1'"), RunId));
	Части.Добавить(НСтр("ru = 'Источник данных: ЕГРЮЛ/ЕГРИП (1С:Контрагент)'"));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Ликвидация: %1'"), ?(Ликвидация, "да", "нет")));

	Части.Добавить("");
	Части.Добавить(НСтр("ru = 'Изменения:'"));
	Если Изменения.Количество() = 0 Тогда
		Части.Добавить("- " + НСтр("ru = 'изменений по данным ЕГР нет'"));
	Иначе
		Для Каждого Изменение Из Изменения Цикл
			Части.Добавить(СтрШаблон(НСтр("ru = '- %1: %2 -> %3'"),
				Изменение.field, Изменение.was, Изменение.now));
		КонецЦикла;
	КонецЕсли;

	Части.Добавить("");
	Части.Добавить(НСтр("ru = 'Решения по визам:'"));
	Если Визы.Количество() = 0 Тогда
		Части.Добавить("- " + НСтр("ru = 'виз агента без решения нет'"));
	Иначе
		Для Каждого РешениеВизы Из Визы Цикл
			Части.Добавить(СтрШаблон(НСтр("ru = '- %1: Согласовано'"), РешениеВизы.visa));
		КонецЦикла;
	КонецЕсли;

	// Имя отличается от «Протокол проверки агентом …» - чтобы поиск хеша визы 1
	// (ХешИзПротоколаВизы1) не читал протоколы автоактуализации. 2.5.1: один файл
	// у заявки, запуски дописываются блоками.
	ИмяФайла = "Протокол автоактуализации агентом";
	ЗаписьФайла = ДописатьФайлПротоколаПривилегированно(СсылкаЗаявки, ИмяФайла,
		СтрСоединить(Части, Символы.ПС), ПользовательАгента);
	Если НЕ ЗаписьФайла.Успех Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "protocol_file_failed",
			СтрШаблон("%1: %2", Строка(СсылкаЗаявки), ЗаписьФайла.Ошибка), "Предупреждение");
	КонецЕсли;

	Возврат ЗаписьФайла.Успех;

КонецФункции

// Лог вызова nsi_actualize_request: заявка, результат, число согласованных виз.
Процедура ЗаписатьЛогАктуализации(Знач СсылкаЗаявки, Знач Результат, Знач Визы)

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_actualize_request", СтрШаблон(
		НСтр("ru = '%1: %2, виз согласовано %3'"),
		Строка(СсылкаЗаявки), Результат,
		Формат(Визы.Количество(), "ЧГ=0")));

КонецПроцедуры

// Лог передачи и повтора (спека п. 4): причина - в служебном логе
// nsi_actualize_handover, в комментарий заявки сценарий не пишет.
Процедура ЗаписатьЛогПередачиАктуализации(Знач СсылкаЗаявки, Знач Код, Знач ТекстПричины)

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_actualize_handover", СтрШаблон(
		НСтр("ru = '%1: %2 - %3'"), Строка(СсылкаЗаявки), Код, ТекстПричины));

КонецПроцедуры

// Признаки сценария из настроек пакета (п. 1 спеки).
Функция ТекстПризнакаКомментария()
	Возврат СтрокаНастройки("НСИАктуализацияКомментарий",
		"Сформировано автоматически обработкой");
КонецФункции

Функция ТекстПризнакаАргументации()
	Возврат СтрокаНастройки("НСИАктуализацияАргументация",
		"Актуализация статуса по ИНН/КПП");
КонецФункции

// Повтор обращения к ЕГР - не чаще, часов (п. 1 спеки, ответ человека 2).
Функция ПовторАктуализацииЧасов()
	Возврат ЧислоНастройки("НСИАктуализацияПовторЧасов", 6);
КонецФункции

// Повтор обычной заявки при недоступном ЕГР - часов (agentrunner-118, п. 2 спеки).
Функция ПовторПриНедоступномЕГРЧасов()
	Возврат ЧислоНастройки("НСИПовторПриНедоступномЕГРЧасов", 6);
КонецФункции

// Число попыток ЕГР до передачи (п. 1 спеки, ответ человека 2).
Функция ПопыткиАктуализацииЕГР()
	Возврат ЧислоНастройки("НСИАктуализацияПопытокЕГР", 3);
КонецФункции

// Значение настройки пакета строкой (ядро может вернуть не строку).
Функция СтрокаНастройки(Знач Ключ, Знач Дефолт)

	Значение = ar_Настройки.ЗначениеНастройки(Ключ, Дефолт);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Числовые настройки актуализации читает общая ЧислоНастройки области
// ВозвратНаИсправление (agentrunner-89) - своя копия удалена при слиянии.

#КонецОбласти
#Область АргументыИОшибки

// Разбирает JSON-строку аргументов инструмента в Соответствие.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; Неопределено при пустом входе или
//  ошибке разбора JSON.
//
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ar_JSON.ИзJSON(АргументыJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает значение поля из Соответствия аргументов с дефолтом при отсутствии.
Функция ЗначениеИзКоллекции(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;

	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Только цифры строки: разделители и оформление отбрасываются. Перенесена из
// области ИнструментПроверкаРеквизитов - нужна ИННИзАргументов и
// КлючПовтораОфициальныхДанных (agentrunner-87).
Функция НормализованноеЧислоСтроки(Знач Строка)

	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Если ТипЗнч(Строка) = Тип("Число") Тогда
			Возврат Формат(Строка, "ЧГ=0");
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;

КонецФункции

// Формирует JSON-строку ошибки-observation: {"error": <код>, "message": <текст>}
// (спека п. 2: исключения наружу не выходят). agentrunner-108: для отказов с
// директивой завершения работы (контракт agentrunner-107) - терминальный
// признак: незакрытые обязательные шаги плана ядро закрывает skipped, итог
// не превращается в «Завершён с ошибкой».
//
// Параметры:
//  КодОшибки   - Строка  - машиночитаемый код ошибки.
//  Сообщение   - Строка  - текст для модели и оператора (может быть пустым).
//  Терминальный - Булево - добавить terminal/terminal_reason/next = finish
//                (terminal_reason = КодОшибки); точечно для названных кодов.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОшибкаИнструмента(Знач КодОшибки, Знач Сообщение = "", Знач Терминальный = Ложь)

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("message", ?(Сообщение = Неопределено, "", Сообщение));
	Если Терминальный Тогда
		Объект.Вставить("terminal", Истина);
		Объект.Вставить("terminal_reason", КодОшибки);
		Объект.Вставить("next", "finish");
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

// Терминальный ли код отказа (agentrunner-108, контракт agentrunner-107):
// виза не найдена/не активна/уже решена, решение в запуске уже поставлено,
// заявка исключённой внешней системы, файлы ещё распознаются (files_pending -
// «заверши работу без решения, заявка вернётся в очередь», и в ответе сверки,
// и в отказе решения), заявку держит другой запуск (subject_held_by_other_run,
// agentrunner-266) - работать нечего, модель завершает. Прочие отказы
// (verify_not_ready, files_not_submitted, remarks_required и т.п.) - не
// терминальные: модель доделывает названное и повторяет вызов.
//
// Параметры:
//  КодОшибки - Строка - код отказа инструмента.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоТерминальныйКодОтказа(Знач КодОшибки)

	Возврат КодОшибки = "visa_not_found"
		Или КодОшибки = "visa_not_active"
		Или КодОшибки = "visa_already_decided"
		Или КодОшибки = "run_already_decided"
		Или КодОшибки = "request_excluded_external_system"
		Или КодОшибки = "files_pending"
		Или КодОшибки = "subject_held_by_other_run";

КонецФункции

#КонецОбласти

#КонецОбласти
