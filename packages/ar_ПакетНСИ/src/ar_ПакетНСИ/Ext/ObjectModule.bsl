// Свойства JSON Schema одной сдаваемой части (nsi_submit_file_data).
//
// Параметры:
//  СвойствоЛиц     - Структура - схема элемента persons.
//  СвойствоЗначений - Структура - схема элемента values.
//
// Возвращаемое значение:
//  Структура - {file, part, persons, values}.
//
Функция СвойстваСхемыЧасти(Знач СвойствоЛиц, Знач СвойствоЗначений)

	СвойствоPersons = Новый Структура;
	СвойствоPersons.Вставить("type", "array");
	СвойствоPersons.Вставить("description",
		НСтр("ru = 'Лица, найденные в этой части; ничего не нашли - пустой массив.'"));
	СвойствоPersons.Вставить("items", СвойствоЛиц);

	СвойствоValues = Новый Структура;
	СвойствоValues.Вставить("type", "array");
	СвойствоValues.Вставить("description",
		НСтр("ru = 'Значения реквизитов, найденные в этой части; ничего не нашли - пустой
			|массив.'"));
	СвойствоValues.Вставить("items", СвойствоЗначений);

	Свойства = Новый Структура;
	Свойства.Вставить("file", СвойствоСхемы("string",
		НСтр("ru = 'Имя файла из ответа nsi_verify_request (поле name).'")));
	Свойства.Вставить("part", СвойствоСхемы("number",
		НСтр("ru = 'Номер части этого файла (из поля parts ответа).'")));
	Свойства.Вставить("persons", СвойствоPersons);
	Свойства.Вставить("values", СвойствоValues);
	Возврат Свойства;

КонецФункции

// Описание инструмента nsi_set_visa_decision для манифеста пакета (УровеньРиска =
// Запись, ТребуетПодтверждения = Ложь с обоснованием - решение человека Р4,
// спека agentrunner-30 п. 16: агент проверки НСИ автономен; защита approve -
// внутри инструмента, п. 17 спеки).
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаРешениеПоВизе()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "nsi_set_visa_decision");
	Описание.Вставить("Описание",
		НСтр("ru = 'Ставит решение по визе, назначенной пользователю агента: approve
			|(согласовано), return (вернуть инициатору на исправление), reject (отклонено
			|окончательно) - или передаёт заявку сотруднику НСИ: handover. Решение выбирай
			|только из поля allowed_decisions ответа nsi_verify_request.
			|Перед записью пакет сам повторяет сверку заявки без участия модели: approve
			|требует итога ready, всех сданных файлов и закрытых пунктов review (аргумент
			|review - ответы по каждому needs_review: {id, result: ok|remark, text});
			|return требует хотя бы одного замечания и ставит «Отклонено» с пометкой
			|«Возвращено на исправление» и нумерованными замечаниями в комментарии визы;
			|approve по визе второго этапа («Анализ БА (утв)») дополнительно создаёт
			|банковский счёт у контрагента, если счёт указан в заявке. Для каждого вызова
			|(кроме _dry_run) пакет присоединяет к заявке файл протокола с решением,
			|этапом, итогом сверки и review - собственный protocol агента больше не
			|обязателен. Для handover решение не ставится, виза остаётся сотруднику,
			|заявка больше не выдаётся агенту, пока её не изменят. Комментарий обязателен
			|для return, reject и handover, model_hash - для approve и handover. Запись
			|штатным механизмом визирования «БИТ». Успешный ответ содержит next = finish:
			|заверши работу; вызовы по другим заявкам вернут run_already_decided.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Решение по визе заявки НСИ'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовРешениеПоВизе());
	Описание.Вставить("УровеньРиска", "Запись");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// Точный текст - из спеки agentrunner-30 п. 16; проверяется ядром при регистрации
	// (Запись без подтверждения допустим только с ним).
	Описание.Вставить("ОбоснованиеЗаписиБезПодтверждения",
		НСтр("ru = 'Решение по визе агента проверки НСИ; агент автономен (решение человека Р4,
			|план agent-proverka-zayavki-nsi-kontragent, спека agentrunner-30). Согласование
			|защищено повторной сверкой пакета без участия модели; решение по визе отменяется
			|штатно'"));
	// 1.2.0 - обязательный аргумент protocol и файл протокола к заявке
	// (agentrunner-48).
	// 1.3.0 - next = finish в успешном ответе, run_already_decided по другой
	//         заявке (agentrunner-66).
	// 3.0.0 - protocol больше не обязателен (протокол строит пакет из итога
	//         сверки), аргумент review по needs_review; этапы виз, return ->
	//         «Отклонено» с пометкой возврата, approve этапа 2 создаёт счёт
	//         (agentrunner-88).
	Описание.Вставить("Версия", "3.0.0");
	Описание.Вставить("Категория", "nsi");
	Возврат Описание;

КонецФункции

