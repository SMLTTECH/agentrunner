	Описание.Вставить("Имя", "nsi_pending_visas");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает заявки НСИ на контрагентов, ждущие решения по визе, назначенной
			|пользователю агента. По каждой: заявка, вид операции, сценарий, инициатор, виза,
			|этап (stage: 1 - согласование, 2 - утверждение), next - следующий шаг, крайний
			|срок, files_recognizing - true, когда файлы заявки ещё распознаются (в очереди
			|агента такая заявка появится после распознавания). Заявки, связанные с
			|исключёнными внешними системами, не возвращаются вовсе. Визы отбираются без
			|привязки к наименованию: подходит любая виза пользователя агента. По умолчанию -
			|заявки на контрагентов; пустая строка object_kind - все заявки НСИ. Заявки,
			|переданные агентом сотруднику НСИ (handover) и не изменённые с тех пор,
			|не возвращаются; include_handed_over = true включает их с полем handed_over,
			|число пропущенных - в handed_over_skipped. Возвращаются только заявки с датой
			|документа не раньше даты начала из настройки «НСИ: дата начала обработки заявок
			|агентом». Если решение по визе в этом запуске уже поставлено, вызов вернёт
			|run_already_decided - заверши работу.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Заявки на визе агента'"));
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовСписокЗаявок());
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	// 1.2.0 - отбор заявок от даты начала обработки (agentrunner-41).
	// 2.0.0 - этап визы (stage), next, files_recognizing, исключение заявок
	//         внешних систем (agentrunner-88).
	Описание.Вставить("Версия", "2.0.0");
	Описание.Вставить("Категория", "nsi");
	Возврат Описание;

КонецФункции

