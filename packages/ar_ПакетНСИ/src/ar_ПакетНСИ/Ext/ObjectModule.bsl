КонецФункции

#КонецОбласти

#Область ИнструментСписокЗаявокНаВизе

// Реализация инструмента nsi_pending_visas: один запрос к регистру виз
// (АктивнаяВиза, решение пустое, объект - заявка НСИ), затем по каждой заявке
// кандидата - бит_ВизированиеСервер.ВизыПользователя (пользовательские условия
// виз зависят от объекта, пакетного варианта нет - спека п. 7) и отбор строк;
// заявки, переданные агентом сотруднику НСИ (handover) и не изменённые,
// пропускаются (agentrunner-35), include_handed_over возвращает их с полем
// handed_over.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"object_kind": "...", "limit": N,
//                  "include_handed_over": true|false}.
//  Контекст      - Структура - контекст запуска (нужен Агент).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"count","scanned","handed_over_skipped","items":[...]}
//  либо {"error", "message"}.
//
Функция ВыполнитьСписокЗаявокНаВизе(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ПользовательАгента = ПользовательАгентаИзКонтекста(Контекст);
	Если Не ЗначениеЗаполнено(ПользовательАгента) Тогда
		Возврат ОшибкаИнструмента("agent_user_not_set",
			НСтр("ru = 'У агента не заполнен пользователь (реквизит ar_Пользователь справочника
				|ar_Агенты) - отобрать визы нечем.'"));
	КонецЕсли;

	ИмяОбъекта = ИмяОбъектаИзАргументов(Аргументы);
	Лимит = ЛимитСпискаИзАргументов(Аргументы);
	ВключаяОтложенных = ЗначениеБулево(ЗначениеИзКоллекции(Аргументы, "include_handed_over", Ложь));

	ОтборСтрок = ЗаявкиНаВизеАгента(ПользовательАгента, ИмяОбъекта, Лимит,
		АгентИзКонтекста(Контекст), ВключаяОтложенных);

	УникальныеЗаявки = ЗаявкиИзСтрок(ОтборСтрок.Строки);
	ШапкиЗаявок = РеквизитыЗаявокШапки(УникальныеЗаявки);

	Элементы = Новый Массив;
	СценарииПоЗаявкам = Новый Соответствие;
	Для Каждого СтрокаКандидата Из ОтборСтрок.Строки Цикл
		Шапка = ШапкиЗаявок.Получить(СтрокаКандидата.Заявка);
		Если Шапка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Модель и сценарий считаются один раз на заявку (виз агента может быть
		// несколько, чтение хранилища - десериализация).
		Сценарий = СценарииПоЗаявкам.Получить(СтрокаКандидата.Заявка);
		Если Сценарий = Неопределено Тогда
			МодельСтало = МодельИзХранилища(Шапка.ХранилищеМодельОбъекта);
			Сценарий = СценарийЗаявки(Шапка, МодельСтало);
			СценарииПоЗаявкам.Вставить(СтрокаКандидата.Заявка, Сценарий);
		КонецЕсли;
		Элементы.Добавить(ЭлементСпискаЗаявок(СтрокаКандидата, Шапка, Сценарий));
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("count", Элементы.Количество());
	Ответ.Вставить("scanned", ОтборСтрок.ПросмотреноЗаявок);
	Ответ.Вставить("handed_over_skipped", ОтборСтрок.ПропущеноОтложенных);
	Ответ.Вставить("items", Элементы);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Разбирает аргумент object_kind: имя объекта обмена заявок; по умолчанию
// «Контрагенты», пустая строка - все заявки НСИ (спека п. 6).
Функция ИмяОбъектаИзАргументов(Знач Аргументы)

	ИмяОбъекта = ЗначениеИзКоллекции(Аргументы, "object_kind", "Контрагенты");
	Если ТипЗнч(ИмяОбъекта) <> Тип("Строка") Тогда
		Возврат "Контрагенты";
	КонецЕсли;
	Возврат СокрЛП(ИмяОбъекта);

КонецФункции

// Разбирает аргумент limit: 1..50, по умолчанию 10 (спека п. 6).
Функция ЛимитСпискаИзАргументов(Знач Аргументы)

	Лимит = ЗначениеИзКоллекции(Аргументы, "limit", ЛимитСпискаПоУмолчанию());
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Возврат ЛимитСпискаПоУмолчанию();
	КонецЕсли;
	Возврат Макс(Мин(Окр(Лимит), ПредельныйЛимитСписка()), 1);

КонецФункции

// Лимит заявок по умолчанию (спека п. 6).
Функция ЛимитСпискаПоУмолчанию()
	Возврат 10;
КонецФункции

// Предельный лимит заявок за вызов (спека п. 6).
Функция ПредельныйЛимитСписка()
	Возврат 50;
КонецФункции

// Один запрос к регистру бит_УстановленныеВизы: активные визы без решения по
// заявкам НСИ (не помеченным на удаление) с датой документа не раньше даты
// начала обработки из настройки пакета НСИДатаНачалаОбработкиЗаявок
// (agentrunner-41) - условие в ГДЕ, до ПЕРВЫЕ 200: старые заявки не занимают
// места в лимите кандидатов; порядок - ДатаКрайняя (пустые в конце), затем
// дата заявки; не больше 200 кандидатов (спека п. 7).
//
// Параметры:
//  ИмяОбъекта - Строка - отбор Заявки.ОписаниеОбъекта.Имя; "" - без отбора.
//
// Возвращаемое значение:
//  Массив из Структура {Заявка, Виза, ВизаПредставление, ИДВизы, ДатаКрайняя}.
//
Функция СтрокиКандидатовНаВизе(Знач ИмяОбъекта)

	// Отбор по имени объекта - явным соединением вместо разыменования через
	// точку (стандарт: соединение по ссылочному полю).
	СоединениеОписаний = "";
	УсловиеИмени = "";
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		СоединениеОписаний = Символы.ПС
			+ "		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияЗаявок"
			+ Символы.ПС
			+ "		ПО Заявки.ОписаниеОбъекта = ОписанияЗаявок.Ссылка";
		УсловиеИмени = Символы.ПС + "	И ОписанияЗаявок.Имя = &ИмяОбъекта";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
		|	Визы.Объект КАК Заявка,
		|	Визы.Виза КАК Виза,
		|	ПРЕДСТАВЛЕНИЕ(Визы.Виза) КАК ВизаПредставление,
		|	Визы.ИД КАК ИДВизы,
		|	Визы.ДатаКрайняя КАК ДатаКрайняя,
		|	Заявки.Дата КАК ДатаЗаявки
		|ИЗ
		|	РегистрСведений.бит_УстановленныеВизы КАК Визы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ПО Визы.Объект = Заявки.Ссылка"
		+ СоединениеОписаний
		+ "
		|ГДЕ
		|	Визы.АктивнаяВиза
		|	И Визы.Решение = ЗНАЧЕНИЕ(Справочник.бит_ВидыРешенийСогласования.ПустаяСсылка)
		|	И НЕ Заявки.ПометкаУдаления
		|	И Заявки.Дата >= &ДатаНачала"
		+ УсловиеИмени
		+ "
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА Визы.ДатаКрайняя = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 1
		|	ИНАЧЕ 0
		|	КОНЕЦ,
		|	Визы.ДатаКрайняя,
		|	Заявки.Дата";

	// Дата документа заявки - параметром (agentrunner-41); значение из настройки
	// пакета, неверное значение молча заменяется датой по умолчанию.
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОбработкиЗаявок());

	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	КонецЕсли;

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаКандидата = Новый Структура;
		СтрокаКандидата.Вставить("Заявка", Выборка.Заявка);
		СтрокаКандидата.Вставить("Виза", Выборка.Виза);
		СтрокаКандидата.Вставить("ВизаПредставление", Выборка.ВизаПредставление);
		СтрокаКандидата.Вставить("ИДВизы", Выборка.ИДВизы);
		СтрокаКандидата.Вставить("ДатаКрайняя", ?(ЗначениеЗаполнено(Выборка.ДатаКрайняя),
			Выборка.ДатаКрайняя, Неопределено));
		СтрокаКандидата.Вставить("ДатаЗаявки", Выборка.ДатаЗаявки);
		Строки.Добавить(СтрокаКандидата);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Оставляет строки кандидатов, чья виза входит в визы пользователя агента:
// бит_ВизированиеСервер.ВизыПользователя вызывается один раз на заявку
// (пользовательские условия виз зависят от объекта - спека п. 7); остановка,
// когда набран лимит. Без привязки к наименованию визы (решение Р10).
// Строки с действующей отметкой отложения (agentrunner-35: ключ отметки = ИД
// визы строки и текущий model_hash = отпечатку) пропускаются, не расходуя
// Лимит; при ВключаяОтложенных остаются и помечаются полями
// ОтложеноВ/ОтложеноПричина.
//
// Параметры:
//  СтрокиКандидатов   - Массив - результат СтрокиКандидатовНаВизе.
//  ПользовательАгента - СправочникСсылка.Пользователи - пользователь агента.
//  Лимит              - Число  - предельное число строк ответа.
//  Отложенные         - Соответствие - "Заявка -> Структура {Ключ, Отпечаток,
//                       ОтложенВ, Причина}" - отметки отложения (пустое - нет).
//  ХешиОтпечатков     - Соответствие - "Заявка -> Строка" - текущие model_hash.
//  ВключаяОтложенных  - Булево - отмеченные строки не пропускаются
//                       (include_handed_over).
//
// Возвращаемое значение:
//  Структура:
//   * Строки              - Массив - строки кандидатов с визой агента (не больше Лимит).
//   * ПросмотреноЗаявок   - Число  - заявок, для которых проверялись визы агента.
//   * ПропущеноОтложенных - Число  - строк, пропущенных по отметке отложения.
//
Функция СтрокиСВизойАгента(Знач СтрокиКандидатов, Знач ПользовательАгента, Знач Лимит,
	Знач Отложенные, Знач ХешиОтпечатков, Знач ВключаяОтложенных)

	ОтобранныеСтроки = Новый Массив;
	СпискиВизПоЗаявкам = Новый Соответствие;
	ПропущеноОтложенных = 0;

	Для Каждого СтрокаКандидата Из СтрокиКандидатов Цикл

		ОтметкаОтложения = ОтложеноОтметкаСтроки(СтрокаКандидата, Отложенные, ХешиОтпечатков);
		Если ОтметкаОтложения <> Неопределено Тогда
			СтрокаКандидата.Вставить("ОтложеноВ", ОтметкаОтложения.ОтложенВ);
			СтрокаКандидата.Вставить("ОтложеноПричина", ОтметкаОтложения.Причина);
			Если НЕ ВключаяОтложенных Тогда
				ПропущеноОтложенных = ПропущеноОтложенных + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если ОтобранныеСтроки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		СписокВиз = СпискиВизПоЗаявкам.Получить(СтрокаКандидата.Заявка);
		Если СписокВиз = Неопределено Тогда
			// ВЫБРАТЬ РАЗРЕШЕННЫЕ внутри ВизыПользователя; условия виз проверяются
			// по конкретному объекту - запрос в цикле здесь неизбежен и ограничен
			// 200 кандидатами и лимитом ответа (спека п. 7).
			СписокВиз = бит_ВизированиеСервер.ВизыПользователя(ПользовательАгента,
				СтрокаКандидата.Заявка);
			СпискиВизПоЗаявкам.Вставить(СтрокаКандидата.Заявка, СписокВиз);
		КонецЕсли;

		Если СписокВиз.НайтиПоЗначению(СтрокаКандидата.Виза) <> Неопределено Тогда
			ОтобранныеСтроки.Добавить(СтрокаКандидата);
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Строки", ОтобранныеСтроки);
	Результат.Вставить("ПросмотреноЗаявок", СпискиВизПоЗаявкам.Количество());
	Результат.Вставить("ПропущеноОтложенных", ПропущеноОтложенных);
	Возврат Результат;

КонецФункции

// Действует ли отметка отложения для строки кандидата (п. 4 спеки
// agentrunner-35): отметка есть, её ключ равен ИД визы строки и текущий
// model_hash заявки равен отпечатку. Заявка изменена или визу переназначили -
// отметка устарела, строка остаётся в выдаче (перезапишется при следующем
// handover либо останется без действия - безвредно).
//
// Параметры:
//  СтрокаКандидата   - Структура - строка из СтрокиКандидатовНаВизе.
//  Отложенные        - Соответствие - отметки отложения по заявкам.
//  ХешиОтпечатков    - Соответствие - "Заявка -> Строка" текущих model_hash.
//
// Возвращаемое значение:
//  Структура {Ключ, Отпечаток, ОтложенВ, Причина} - действующая отметка;
//  Неопределено - отметки нет или она не действует для этой строки.
//
Функция ОтложеноОтметкаСтроки(Знач СтрокаКандидата, Знач Отложенные, Знач ХешиОтпечатков)

	Отметка = Отложенные.Получить(СтрокаКандидата.Заявка);
	Если Отметка = Неопределено ИЛИ Отметка.Ключ <> СтрокаКандидата.ИДВизы Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекущийХеш = ХешиОтпечатков.Получить(СтрокаКандидата.Заявка);
	Если ТекущийХеш <> Отметка.Отпечаток Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Отметка;

КонецФункции

// Уникальные заявки из строк кандидатов, в порядке отбора (для одного пакетного
// запроса шапок).
//
// Возвращаемое значение:
//  Массив ссылок на заявки.
//
Функция ЗаявкиИзСтрок(Знач СтрокиКандидатов)

	Уникальные = Новый Соответствие;
	Заявки = Новый Массив;
	Для Каждого СтрокаКандидата Из СтрокиКандидатов Цикл
		Если Уникальные.Получить(СтрокаКандидата.Заявка) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(СтрокаКандидата.Заявка, Истина);
		Заявки.Добавить(СтрокаКандидата.Заявка);
	КонецЦикла;
	Возврат Заявки;

КонецФункции

// Шапки заявок одним пакетным запросом: служебные поля, инициатор, предмет и
// хранилища моделей (реквизитов контрагента в шапке нет - они в модели, см.
// mcp.md [P3] «Реквизиты шапки со стенда»).
//
// Параметры:
//  Заявки - Массив ссылок на заявки НСИ.
//
// Возвращаемое значение:
//  Соответствие - Ссылка -> Структура {Номер, Дата, ВидОперации, ЮрФизЛицо,
//  ИмяОбъекта, Предмет, ПредметПредставление, Инициатор, ИнициаторПредставление,
//  Ответственный, ОтветственныйПредставление, ХранилищеМодельОбъекта,
//  ХранилищеМодельОбъектаПред}.
//
Функция РеквизитыЗаявокШапки(Знач Заявки)

	Шапки = Новый Соответствие;
	Если Заявки.Количество() = 0 Тогда
		Возврат Шапки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявки", Заявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	Т.Дата КАК Дата,
		|	Т.ВидОперации КАК ВидОперации,
		|	Т.sd_ЮридическоеФизическоеЛицо КАК ЮрФизЛицо,
		|	Т.Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(Т.Предмет) КАК ПредметПредставление,
		|	Т.сд_Инициатор КАК Инициатор,
		|	ПРЕДСТАВЛЕНИЕ(Т.сд_Инициатор) КАК ИнициаторПредставление,
		|	Т.Ответственный КАК Ответственный,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ответственный) КАК ОтветственныйПредставление,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	Т.ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка В (&Заявки)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = Новый Структура;
		Шапка.Вставить("Ссылка", Выборка.Ссылка);
		Шапка.Вставить("Номер", Выборка.Номер);
		Шапка.Вставить("Дата", Выборка.Дата);
		Шапка.Вставить("ВидОперации", Выборка.ВидОперации);
		Шапка.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
		Шапка.Вставить("Предмет", Выборка.Предмет);
		Шапка.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		Шапка.Вставить("Инициатор", Выборка.Инициатор);
		Шапка.Вставить("ИнициаторПредставление", Выборка.ИнициаторПредставление);
		Шапка.Вставить("Ответственный", Выборка.Ответственный);
		Шапка.Вставить("ОтветственныйПредставление", Выборка.ОтветственныйПредставление);
		Шапка.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		Шапка.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Шапки.Вставить(Выборка.Ссылка, Шапка);
	КонецЦикла;

	Возврат Шапки;

КонецФункции

// Элемент массива items ответа nsi_pending_visas (спека п. 8; agentrunner-35:
// для строки с действующей отметкой handover, если include_handed_over -
// добавляется поле handed_over {at, comment}).
//
// Параметры:
//  СтрокаКандидата - Структура - строка из СтрокиКандидатовНаВизе (после
//                    СтрокиСВизойАгента может содержать ОтложеноВ/ОтложеноПричина).
//  Шапка           - Структура - шапка заявки из РеквизитыЗаявокШапки.
//  Сценарий        - Строка    - сценарий заявки (п. 4 спеки).
//
// Возвращаемое значение:
//  Структура - {request, request_presentation, request_date, operation, scenario,
//  initiator, visa, visa_id, due_date[, handed_over]}.
//
Функция ЭлементСпискаЗаявок(Знач СтрокаКандидата, Знач Шапка, Знач Сценарий)

	Элемент = Новый Структура;
	Элемент.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаКандидата.Заявка));
	Элемент.Вставить("request_presentation", Строка(СтрокаКандидата.Заявка));
	Элемент.Вставить("request_date", Шапка.Дата);
	Элемент.Вставить("operation", ОперацияСценария(Шапка));
	Элемент.Вставить("scenario", Сценарий);
	Элемент.Вставить("initiator", ИнициаторЗаявкиСтрокой(Шапка));
	Элемент.Вставить("visa", СтрокаКандидата.ВизаПредставление);
	Элемент.Вставить("visa_id", СтрокаКандидата.ИДВизы);
	Элемент.Вставить("due_date", СтрокаКандидата.ДатаКрайняя);

	ОтложеноВ = Неопределено;
	СтрокаКандидата.Свойство("ОтложеноВ", ОтложеноВ);
	Если ОтложеноВ <> Неопределено Тогда
		ОтложеноПричина = "";
		СтрокаКандидата.Свойство("ОтложеноПричина", ОтложеноПричина);
		Элемент.Вставить("handed_over",
			Новый Структура("at, comment", ОтложеноВ, ОтложеноПричина));
	КонецЕсли;

	Возврат Элемент;

КонецФункции

// Инициатор заявки в виде строки: сд_Инициатор, при пустом - Ответственный.
Функция ИнициаторЗаявкиСтрокой(Знач Шапка)

	Если ЗначениеЗаполнено(Шапка.Инициатор) Тогда
		Возврат Шапка.ИнициаторПредставление;
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка.Ответственный) Тогда
		Возврат Шапка.ОтветственныйПредставление;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ИнструментЧтениеЗаявки

// Реализация инструмента nsi_get_request (спека п. 9-10): пакетный запрос шапки
// и подчинённых объектов, разбор моделей «было/стало», визы документа, хеш
// моделей «стало».
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"request": "<навигационная ссылка>"}.
//  Контекст      - Структура - контекст запуска (не используется, чтение).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"request", "number", "request_date", "status",
//  "operation", "scenario", "counterparty", "header", "fields", "tables",
//  "subordinate", "visas", "model_hash"} либо {"error", "message"}.
//
Функция ВыполнитьЧтениеЗаявки(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(ОтборЗаявки.КодОшибки,
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'"));
	КонецЕсли;
	СсылкаЗаявки = ОтборЗаявки.Ссылка;

	ДанныеЗаявки = ДанныеЗаявки(СсылкаЗаявки);
	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		// Заявку могли удалить или скрыть правами между проверкой доступа и чтением.
		Возврат ОшибкаИнструмента("request_not_found",
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'"));
	КонецЕсли;
	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	МодельПред  = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъектаПред);
	ДляСоздания = (ДанныеЗаявки.Шапка.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);

	ВизыИСтатус = ВизыВОтвет(СсылкаЗаявки);

	Ответ = Новый Структура;
	Ответ.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаЗаявки));
	Ответ.Вставить("request_presentation", Строка(СсылкаЗаявки));
	Ответ.Вставить("number", ДанныеЗаявки.Шапка.Номер);
	Ответ.Вставить("request_date", ДанныеЗаявки.Шапка.Дата);
	Ответ.Вставить("status", ЗначениеВСтрокуДляОтвета(ВизыИСтатус.Статус));
	Ответ.Вставить("operation", ОперацияСценария(ДанныеЗаявки.Шапка));
	Ответ.Вставить("scenario", СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало));
	Ответ.Вставить("counterparty", КонтрагентЗаявки(ДанныеЗаявки.Шапка));
	Ответ.Вставить("header", РазделЗаголовокЗаявки(СсылкаЗаявки, МодельСтало));
	Ответ.Вставить("fields", ПоляМодели(МодельСтало, МодельПред, ДляСоздания));
	Ответ.Вставить("tables", ТаблицыМодели(МодельСтало));
	Ответ.Вставить("subordinate", ПодчиненныеОбъектыВОтвет(ДанныеЗаявки.Подчиненные, ДляСоздания));
	Ответ.Вставить("visas", ВизыИСтатус.Визы);
	Ответ.Вставить("model_hash", ХешМоделейЗаявки(МодельСтало, ДанныеЗаявки.Подчиненные));
	Если МодельСтало = Неопределено Тогда
		Ответ.Вставить("warning", "model_empty");
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Шапка и строки ТЧ sd_ПодчиненныеОбъектыОбмена заявки одним пакетным запросом
// (две связанные выборки за один вызов к базе).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура:
//   * Шапка       - Структура - см. РеквизитыЗаявокШапки (один элемент).
//   * Подчиненные - Массив из Структура {ИмяОбъекта, Предмет,
//                   ПредметПредставление, ХранилищеМодельОбъекта,
//                   ХранилищеМодельОбъектаПред} - в порядке строк ТЧ.
//
Функция ДанныеЗаявки(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номер КАК Номер,
		|	Т.Дата КАК Дата,
		|	Т.ВидОперации КАК ВидОперации,
		|	Т.sd_ЮридическоеФизическоеЛицо КАК ЮрФизЛицо,
		|	Т.Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(Т.Предмет) КАК ПредметПредставление,
		|	Т.сд_Инициатор КАК Инициатор,
		|	ПРЕДСТАВЛЕНИЕ(Т.сд_Инициатор) КАК ИнициаторПредставление,
		|	Т.Ответственный КАК Ответственный,
		|	ПРЕДСТАВЛЕНИЕ(Т.Ответственный) КАК ОтветственныйПредставление,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	Т.ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПОО.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ОписанияПОО.Имя, "") КАК ИмяОбъекта,
		|	ПОО.sd_Предмет КАК Предмет,
		|	ПРЕДСТАВЛЕНИЕ(ПОО.sd_Предмет) КАК ПредметПредставление,
		|	ПОО.sd_ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта,
		|	ПОО.sd_ХранилищеМодельОбъектаПред КАК ХранилищеМодельОбъектаПред
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение.sd_ПодчиненныеОбъектыОбмена КАК ПОО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ОписанияОбъектовОбмена КАК ОписанияПОО
		|		ПО ПОО.sd_ОписаниеОбъектаОбмена = ОписанияПОО.Ссылка
		|ГДЕ
		|	ПОО.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ПОО.НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	Шапки = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Шапка = Новый Структура;
		Шапка.Вставить("Ссылка", Выборка.Ссылка);
		Шапка.Вставить("Номер", Выборка.Номер);
		Шапка.Вставить("Дата", Выборка.Дата);
		Шапка.Вставить("ВидОперации", Выборка.ВидОперации);
		Шапка.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
		Шапка.Вставить("Предмет", Выборка.Предмет);
		Шапка.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		Шапка.Вставить("Инициатор", Выборка.Инициатор);
		Шапка.Вставить("ИнициаторПредставление", Выборка.ИнициаторПредставление);
		Шапка.Вставить("Ответственный", Выборка.Ответственный);
		Шапка.Вставить("ОтветственныйПредставление", Выборка.ОтветственныйПредставление);
		Шапка.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		Шапка.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Шапки.Вставить(Выборка.Ссылка, Шапка);
	КонецЦикла;

	Подчиненные = Новый Массив;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПОО = Новый Структура;
		СтрокаПОО.Вставить("ИмяОбъекта", Выборка.ИмяОбъекта);
		СтрокаПОО.Вставить("Предмет", Выборка.Предмет);
		СтрокаПОО.Вставить("ПредметПредставление", Выборка.ПредметПредставление);
		СтрокаПОО.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		СтрокаПОО.Вставить("ХранилищеМодельОбъектаПред", Выборка.ХранилищеМодельОбъектаПред);
		Подчиненные.Добавить(СтрокаПОО);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Шапка", Шапки.Получить(СсылкаЗаявки));
	Результат.Вставить("Подчиненные", Подчиненные);
	Возврат Результат;

КонецФункции

// Имена реквизитов контрагента для раздела header ответа (список п. 5 спеки).
// Читаются из шапки, если реквизит заявки существует в метаданных, иначе из
// модели «стало» (mcp.md [P3]).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ИменаШапкиКонтрагента()

	Имена = Новый Массив;
	Имена.Добавить("ИНН");
	Имена.Добавить("КПП");
	Имена.Добавить("РегистрационныйНомер");
	Имена.Добавить("Наименование");
	Имена.Добавить("НаименованиеПолное");
	Имена.Добавить("ЮридическоеФизическоеЛицо");
	Имена.Добавить("sd_Нерезидент");
	Имена.Добавить("sd_ИП");
	Имена.Добавить("ИндивидуальныйПредприниматель");
	Имена.Добавить("sd_ОП");
	Имена.Добавить("ОбособленноеПодразделение");
	Имена.Добавить("sd_ВГО");
	Имена.Добавить("ГосударственныйОрган");
	Имена.Добавить("sd_ГосударственныеОрганы");
	Имена.Добавить("ВидГосударственногоОргана");
	Имена.Добавить("КодГосударственногоОргана");
	Имена.Добавить("СтранаРегистрации");
	Имена.Добавить("ДатаРегистрации");
	Имена.Добавить("sd_Ликвидирован");
	Имена.Добавить("sd_ДатаЛиквидации");
	Имена.Добавить("sd_СерияНомерПаспорта");
	Имена.Добавить("sd_ДокументКодПодразделения");
	Имена.Добавить("sd_ДокументКемВыдан");
	Имена.Добавить("sd_ДокументДатаВыдачи");
	Имена.Добавить("sd_ДокументСерия");
	Имена.Добавить("sd_ДокументНомер");
	Имена.Добавить("КодПоОКПО");
	Возврат Имена;

КонецФункции

// Раздел header ответа nsi_get_request: реквизиты контрагента в представлениях.
// Правило спеки п. 5: реквизит есть в шапке заявки - значение из шапки, нет -
// из модели «стало» (на текущем стенде шапочных реквизитов нет - всё из модели).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//  МодельСтало  - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Структура - {<имя реквизита>: <представление или null>}.
//
Функция РазделЗаголовокЗаявки(Знач СсылкаЗаявки, Знач МодельСтало)

	Заголовок = Новый Структура;

	// Шапочные реквизиты (могут появиться в новых релизах «БИТ») читаются одним
	// вызовом БСП - не по одному через точку в цикле (стандарт, раздел 6).
	ШапочныеИмена = ШапочныеИменаЗаявки(ИменаШапкиКонтрагента());
	ШапочныеЗначения = ЗначенияШапочныхРеквизитов(СсылкаЗаявки, ШапочныеИмена);

	Для Каждого ИмяРеквизита Из ИменаШапкиКонтрагента() Цикл

		Значение = Неопределено;
		Если ШапочныеЗначения.Свойство(ИмяРеквизита) Тогда
			Значение = ШапочныеЗначения[ИмяРеквизита];
		Иначе
			Значение = ЗначениеМоделиПоИмени(МодельСтало, ИмяРеквизита);
		КонецЕсли;

		Если Значение <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
			Заголовок.Вставить(ИмяРеквизита, ЗначениеВСтрокуДляОтвета(Значение));
		Иначе
			Заголовок.Вставить(ИмяРеквизита, Неопределено);
		КонецЕсли;

	КонецЦикла;
	Возврат Заголовок;

КонецФункции

// Имена из списка, существующие в метаданных шапки заявки (шапочные реквизиты,
// mcp.md [P3] «Реквизиты шапки со стенда»).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ШапочныеИменаЗаявки(Знач СписокИмен)

	МетаЗаявка = Метаданные.Документы.бит_мдм_ЗаявкаНаИзменение;
	Существующие = Новый Массив;
	Для Каждого ИмяРеквизита Из СписокИмен Цикл
		Если МетаЗаявка.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Существующие.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Возврат Существующие;

КонецФункции

// Значения шапочных реквизитов заявки одним вызовом БСП (стандарт: не через
// точку); пустой список - пустая структура.
//
// Возвращаемое значение:
//  Структура - {<имя реквизита>: значение} (только существующие в шапке имена).
//
Функция ЗначенияШапочныхРеквизитов(Знач СсылкаЗаявки, Знач ИменаРеквизитов)

	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЗаявки,
		СтрСоединить(ИменаРеквизитов, ","));

КонецФункции

// Раздел counterparty ответа: предмет заявки (навигационная ссылка и
// представление), null, если не заполнен (спека п. 9).
Функция КонтрагентЗаявки(Знач Шапка)

	Если ЗначениеЗаполнено(Шапка.Предмет) Тогда
		Пара = Новый Структура;
		Пара.Вставить("presentation", Шапка.ПредметПредставление);
		Пара.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Шапка.Предмет));
		Возврат Пара;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Раздел fields ответа: поля моделей «стало» и «было» - Реквизиты, затем
// СтандартныеРеквизиты; для создания before = null (спека п. 9).
//
// Параметры:
//  МодельСтало - Структура   - модель заявки «стало» (может быть Неопределено).
//  МодельПред  - Структура   - модель заявки «было».
//  ДляСоздания - Булево      - ВидОперации = ВводНового.
//
// Возвращаемое значение:
//  Массив из Структура {name, presentation, before, after, changed}.
//
Функция ПоляМодели(Знач МодельСтало, Знач МодельПред, Знач ДляСоздания)

	Поля = Новый Массив;
	ДополнитьПоляГруппой(Поля, МодельСтало, МодельПред, "Реквизиты", ДляСоздания);
	ДополнитьПоляГруппой(Поля, МодельСтало, МодельПред, "СтандартныеРеквизиты", ДляСоздания);
	Возврат Поля;

КонецФункции

// Дополняет массив полей одной группой модели (Реквизиты или СтандартныеРеквизиты).
//
// Параметры:
//  Поля        - Массив    - пополняемый массив полей.
//  МодельСтало - Структура - модель «стало».
//  МодельПред  - Структура - модель «было».
//  ИмяГруппы   - Строка    - имя группы модели.
//  ДляСоздания - Булево    - before принудительно null.
//
Функция ДополнитьПоляГруппой(Знач Поля, Знач МодельСтало, Знач МодельПред, Знач ИмяГруппы,
	Знач ДляСоздания)

	ГруппаСтало = ГруппаМодели(МодельСтало, ИмяГруппы);
	Если ГруппаСтало = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	ГруппаПред = ГруппаМодели(МодельПред, ИмяГруппы);
	Для Каждого КлючИЗначение Из ГруппаСтало Цикл

		ЗначениеПосле = НормализоватьЗначение(КлючИЗначение.Значение);
		ЗначениеДо = Неопределено;
		Если НЕ ДляСоздания И ГруппаПред <> Неопределено Тогда
			ЗначениеДо = ЗначениеИзКоллекцииМодели(ГруппаПред, КлючИЗначение.Ключ);
			ЗначениеДо = НормализоватьЗначение(ЗначениеДо);
		КонецЕсли;

		Поле = Новый Структура;
		Поле.Вставить("name", КлючИЗначение.Ключ);
		Поле.Вставить("presentation", ЗначениеВСтрокуДляОтвета(КлючИЗначение.Значение));
		Поле.Вставить("before", ЗначениеДо);
		Поле.Вставить("after", ЗначениеПосле);
		Поле.Вставить("changed", НЕ ЗначенияСовпадают(ЗначениеДо, ЗначениеПосле));
		Поля.Добавить(Поле);

	КонецЦикла;
	Возврат Поля;

КонецФункции

// Раздел tables ответа: табличные части модели «стало» - имя ТЧ -> массив строк
// с нормализованными значениями (спека п. 9).
//
// Возвращаемое значение:
//  Соответствие - имя ТЧ -> Массив строк.
//
Функция ТаблицыМодели(Знач МодельСтало)

	Таблицы = Новый Соответствие;
	ГруппаТЧ = ГруппаМодели(МодельСтало, "ТабличныеЧасти");
	Если ГруппаТЧ = Неопределено Тогда
		Возврат Таблицы;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ГруппаТЧ Цикл
		Строки = Новый Массив;
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого СтрокаТЧ Из КлючИЗначение.Значение Цикл
				Строки.Добавить(НормализоватьЗначение(СтрокаТЧ));
			КонецЦикла;
		КонецЕсли;
		Таблицы.Вставить(КлючИЗначение.Ключ, Строки);
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

// Раздел subordinate ответа: подчинённые объекты обмена (ТЧ
// sd_ПодчиненныеОбъектыОбмена) тем же способом, что и поля заявки; банковские
// счета - здесь (спека п. 9).
//
// Параметры:
//  ПодчиненныеСтроки - Массив - строки ТЧ из ДанныеЗаявки.
//  ДляСоздания       - Булево - before принудительно null.
//
// Возвращаемое значение:
//  Массив из Структура {object_kind, subject, fields, tables}.
//
Функция ПодчиненныеОбъектыВОтвет(Знач ПодчиненныеСтроки, Знач ДляСоздания)

	Объекты = Новый Массив;
	Для Каждого СтрокаПОО Из ПодчиненныеСтроки Цикл

		МодельПООСтало = МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъекта);
		МодельПООПред  = МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъектаПред);

		Элемент = Новый Структура;
		Элемент.Вставить("object_kind", СтрокаПОО.ИмяОбъекта);
		Если ЗначениеЗаполнено(СтрокаПОО.Предмет) Тогда
			Предмет = Новый Структура;
			Предмет.Вставить("presentation", СтрокаПОО.ПредметПредставление);
			Предмет.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаПОО.Предмет));
			Элемент.Вставить("subject", Предмет);
		Иначе
			Элемент.Вставить("subject", Неопределено);
		КонецЕсли;
		Элемент.Вставить("fields", ПоляМодели(МодельПООСтало, МодельПООПред, ДляСоздания));
		Элемент.Вставить("tables", ТаблицыМодели(МодельПООСтало));
		Объекты.Добавить(Элемент);

	КонецЦикла;
	Возврат Объекты;

КонецФункции

// Все визы заявки через бит_ВизированиеСервер.ПрочитатьНаборВиз + статус заявки
// из набора (ресурс Статус первой заполненной записи) - спека п. 9.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Структура:
//   * Визы   - Массив из Структура {visa, visa_id, active, decision, user,
//              set_date, due_date, comment}.
//   * Статус - СправочникСсылка.бит_СтатусыОбъектов или Неопределено.
//
Функция ВизыВОтвет(Знач СсылкаЗаявки)

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", СсылкаЗаявки);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	Визы = Новый Массив;
	СтатусЗаявки = Неопределено;
	Для Каждого ЗаписьВизы Из НаборВизы Цикл

		Элемент = Новый Структура;
		Элемент.Вставить("visa", Строка(ЗаписьВизы.Виза));
		Элемент.Вставить("visa_id", ЗаписьВизы.ИД);
		Элемент.Вставить("active", ЗаписьВизы.АктивнаяВиза);
		Элемент.Вставить("decision",
			?(ЗначениеЗаполнено(ЗаписьВизы.Решение), Строка(ЗаписьВизы.Решение), Неопределено));
		Элемент.Вставить("user",
			?(ЗначениеЗаполнено(ЗаписьВизы.Пользователь), Строка(ЗаписьВизы.Пользователь), Неопределено));
		Элемент.Вставить("set_date",
			?(ЗначениеЗаполнено(ЗаписьВизы.ДатаУстановки), ЗаписьВизы.ДатаУстановки, Неопределено));
		Элемент.Вставить("due_date",
			?(ЗначениеЗаполнено(ЗаписьВизы.ДатаКрайняя), ЗаписьВизы.ДатаКрайняя, Неопределено));
		Элемент.Вставить("comment", ЗаписьВизы.Комментарий);
		Визы.Добавить(Элемент);

		Если СтатусЗаявки = Неопределено И ЗначениеЗаполнено(ЗаписьВизы.Статус) Тогда
			СтатусЗаявки = ЗаписьВизы.Статус;
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Визы", Визы);
	Результат.Вставить("Статус", СтатусЗаявки);
	Возврат Результат;

КонецФункции

// Модельный хеш заявки (спека п. 9): SHA-256 (hex) сериализации ar_JSON
// нормализованных моделей «стало» шапки и всех подчинённых объектов в порядке
// строк ТЧ. Визы и комментарии в хеш не входят - только проверяемые данные.
// Нормализация делает хеш детерминированным: ссылки -> {presentation, ref},
// несериализуемые значения -> строка «<не выводится>».
//
// Параметры:
//  МодельСтало       - Структура - модель шапки «стало» (может быть Неопределено).
//  ПодчиненныеСтроки - Массив    - строки ТЧ ПОО из ДанныеЗаявки.
//
// Возвращаемое значение:
//  Строка - 64 hex-символа; "" - сериализация не удалась (approve будет отклонён).
//
Функция ХешМоделейЗаявки(Знач МодельСтало, Знач ПодчиненныеСтроки)

	Части = Новый Массив;
	Части.Добавить(НормализоватьЗначение(МодельСтало));
	Для Каждого СтрокаПОО Из ПодчиненныеСтроки Цикл
		Части.Добавить(НормализоватьЗначение(МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъекта)));
	КонецЦикла;

	JSONТекст = ar_JSON.ВЗначениеJSON(Части);
	Если ПустаяСтрока(JSONТекст) Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_model_hash_failed",
			НСтр("ru = 'Не удалось сериализовать модель заявки для model_hash.'"),
			"Ошибка");
		Возврат "";
	КонецЕсли;

	Возврат ХешСтрокиSHA256(JSONТекст);

КонецФункции

// Текущие модельные хеши нескольких заявок одним пакетным чтением (п. 4 спеки
// agentrunner-35): шапки и ПОО по массиву заявок - два запроса одного пакета,
// без запроса в цикле. Хеш каждой заявки считается тем же ХешМоделейЗаявки
// (шапка «стало» + модели ПОО в порядке строк ТЧ). Заявка без доступной шапки
// в результате отсутствует - отсев трактует отсутствие хеша как устаревшую
// отметку (строка остаётся в выдаче).
//
// Параметры:
//  Заявки - Массив - ссылки на заявки НСИ.
//
// Возвращаемое значение:
//  Соответствие - "Заявка -> Строка (64 hex-символа)".
//
Функция ХешиМоделейЗаявок(Знач Заявки)

	Результат = Новый Соответствие;

	Если Заявки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявки", Заявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Заявка,
		|	Т.ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка В (&Заявки)
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПОО.Ссылка КАК Заявка,
		|	ПОО.sd_ХранилищеМодельОбъекта КАК ХранилищеМодельОбъекта
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение.sd_ПодчиненныеОбъектыОбмена КАК ПОО
		|ГДЕ
		|	ПОО.Ссылка В (&Заявки)
		|УПОРЯДОЧИТЬ ПО
		|	ПОО.Ссылка,
		|	ПОО.НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	// Строки ПОО группируются по заявке (выборка упорядочена по ссылке, строке).
	ПодчиненныеПоЗаявкам = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиПОО = ПодчиненныеПоЗаявкам.Получить(Выборка.Заявка);
		Если СтрокиПОО = Неопределено Тогда
			СтрокиПОО = Новый Массив;
			ПодчиненныеПоЗаявкам.Вставить(Выборка.Заявка, СтрокиПОО);
		КонецЕсли;
		СтрокаПОО = Новый Структура;
		СтрокаПОО.Вставить("ХранилищеМодельОбъекта", Выборка.ХранилищеМодельОбъекта);
		СтрокиПОО.Добавить(СтрокаПОО);
	КонецЦикла;

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		МодельСтало = МодельИзХранилища(Выборка.ХранилищеМодельОбъекта);
		Подчиненные = ПодчиненныеПоЗаявкам.Получить(Выборка.Заявка);
		Если Подчиненные = Неопределено Тогда
			Подчиненные = Новый Массив;
		КонецЕсли;
		Результат.Вставить(Выборка.Заявка, ХешМоделейЗаявки(МодельСтало, Подчиненные));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнструментПроверкаРеквизитов

// Реализация инструмента nsi_check_requisites (спека п. 11-14): источник -
// заявка (модель «стало» + счета ПОО) или переданные значения; готовые функции
// БСП РегламентированныеДанныеКлиентСервер + собственные проверки e-mail,
// телефона и паспорта; банки - одним запросом на все БИК вызова.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"request"} либо {"values", "scenario"}.
//  Контекст      - Структура - контекст запуска (не используется, чтение).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"scenario","errors","warnings","results":[...]}
//  либо {"error", "message"}.
//
Функция ВыполнитьПроверкуРеквизитов(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Сборка = СборкаПолейДляПроверки(Аргументы);
	Если Сборка.КодОшибки <> "" Тогда
		Возврат ОшибкаИнструмента(Сборка.КодОшибки, Сборка.Сообщение);
	КонецЕсли;

	Банки = БанкиПоБИК(БИКиПолейПроверки(Сборка.Поля));
	Результаты = РезультатыПроверкиПолей(Сборка.Поля, Банки, Сборка.Сценарий);

	Ответ = Новый Структура;
	Ответ.Вставить("scenario", Сборка.Сценарий);
	Ответ.Вставить("errors", ЧислоСтатусов(Результаты, "ошибка"));
	Ответ.Вставить("warnings", ЧислоСтатусов(Результаты, "внимание"));
	Ответ.Вставить("results", Результаты);
	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Собирает поля для проверки по аргументам: заявка (спека п. 11) либо values.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//
// Возвращаемое значение:
//  Структура:
//   * КодОшибки - Строка    - "" или код отказа.
//   * Сообщение - Строка    - текст для {"message"}.
//   * Поля      - Массив    - элементы {Поле, Источник, Значение, БИКСчета}.
//   * Сценарий  - Строка    - сценарий проверки.
//
Функция СборкаПолейДляПроверки(Знач Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Поля", Новый Массив);
	Результат.Вставить("Сценарий", "");

	СтрокаСсылки = ЗначениеИзКоллекции(Аргументы, "request", "");
	Если ТипЗнч(СтрокаСсылки) = Тип("Строка") И НЕ ПустаяСтрока(СтрокаСсылки) Тогда

		ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
		Если ОтборЗаявки.КодОшибки <> "" Тогда
			Результат.КодОшибки = ОтборЗаявки.КодОшибки;
			Результат.Сообщение =
				НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
			Возврат Результат;
		КонецЕсли;

		ДанныеЗаявки = ДанныеЗаявки(ОтборЗаявки.Ссылка);
		Если ДанныеЗаявки.Шапка = Неопределено Тогда
			Результат.КодОшибки = "request_not_found";
			Результат.Сообщение =
				НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
			Возврат Результат;
		КонецЕсли;
		МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
		Результат.Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);
		ПоляИзЗаявкиДляПроверки(Результат.Поля, ДанныеЗаявки, МодельСтало);

	Иначе

		Значения = Аргументы.Получить("values");
		Если ТипЗнч(Значения) <> Тип("Соответствие") Тогда
			Результат.КодОшибки = "invalid_arguments";
			Результат.Сообщение =
				НСтр("ru = 'Нужен аргумент request (ссылка на заявку) или values (поля со значениями).'");
			Возврат Результат;
		КонецЕсли;

		Результат.Сценарий = СокрЛП(ЗначениеИзКоллекции(Аргументы, "scenario", "ЮЛ-резидент"));
		Если ПустаяСтрока(Результат.Сценарий) Тогда
			Результат.Сценарий = "ЮЛ-резидент";
		КонецЕсли;
		ПоляИзЗначенийДляПроверки(Результат.Поля, Значения);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Поля проверки из заявки: реквизиты контрагента модели «стало» (по ключам из
// п. 5 спеки), контакты из ТЧ КонтактнаяИнформация модели, счета из моделей
// ПОО (источник «ПОО <номер строки>», спека п. 11, 14).
//
// Параметры:
//  Поля        - Массив    - пополняемый массив полей проверки.
//  ДанныеЗаявки - Структура - результат ДанныеЗаявки.
//  МодельСтало - Структура - модель заявки «стало» (может быть Неопределено).
//
Процедура ПоляИзЗаявкиДляПроверки(Знач Поля, Знач ДанныеЗаявки, Знач МодельСтало)

	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "ИНН", "ИНН", Истина);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "КПП", "КПП", Истина);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "ОГРН", "РегистрационныйНомер", Истина);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "СНИЛС", "СНИЛС", Ложь);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "СНИЛС", "СтраховойНомерПФР", Ложь);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "Паспорт", "sd_СерияНомерПаспорта", Истина);
	ДобавитьПолеПроверкиИзМодели(Поля, МодельСтало, "заявка", "КодПодразделения",
		"sd_ДокументКодПодразделения", Ложь);
	ДобавитьКонтактыИзМодели(Поля, МодельСтало);
	ДобавитьСчетаИзПодчиненных(Поля, ДанныеЗаявки.Подчиненные);

КонецПроцедуры

// Добавляет поле проверки, если значение найдено в модели (или поле пустое, но
// обязательное для вывода - Обязательное).
//
// Параметры:
//  Поля         - Массив    - пополняемый массив.
//  МодельСтало  - Структура - модель «стало».
//  Источник     - Строка    - «заявка» / «ПОО <n>» / «values».
//  Поле         - Строка    - имя проверяемого поля.
//  ИмяВМодели   - Строка    - ключ в модели.
//  Обязательное - Булево    - выводить и при пустом значении (статус «пусто»).
//
Процедура ДобавитьПолеПроверкиИзМодели(Знач Поля, Знач МодельСтало, Знач Источник, Знач Поле,
	Знач ИмяВМодели, Знач Обязательное)

	Если МодельСтало = Неопределено Тогда
		Если Обязательное Тогда
			ДобавитьПолеПроверки(Поля, Поле, Источник, "");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Значение = ЗначениеМоделиПоИмени(МодельСтало, ИмяВМодели);
	Если Значение = Неопределено Тогда
		Если Обязательное Тогда
			ДобавитьПолеПроверки(Поля, Поле, Источник, "");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ДобавитьПолеПроверки(Поля, Поле, Источник, Значение);

КонецПроцедуры

// Добавляет одно поле проверки; значение приводится к строке.
//
// Параметры:
//  Поля     - Массив              - пополняемый массив.
//  Поле     - Строка              - имя проверяемого поля.
//  Источник - Строка              - «заявка» / «ПОО <n>» / «values».
//  Значение - Произвольный        - проверяемое значение.
//
// Возвращаемое значение:
//  Структура - добавленный элемент {Поле, Источник, Значение, БИКСчета}.
//
Функция ДобавитьПолеПроверки(Знач Поля, Знач Поле, Знач Источник, Знач Значение)

	Представление = ЗначениеВСтрокуДляОтвета(Значение);
	Элемент = Новый Структура;
	Элемент.Вставить("Поле", Поле);
	Элемент.Вставить("Источник", Источник);
	Элемент.Вставить("Значение", ?(Представление = Неопределено, "", СокрЛП(Представление)));
	Элемент.Вставить("БИКСчета", "");
	Поля.Добавить(Элемент);
	Возврат Элемент;

КонецФункции

// Контакты из ТЧ КонтактнаяИнформация модели «стало»: e-mail - строки с
// type_description = АдресЭлектроннойПочты (значение АдресЭП), телефон - с
// type_description = Телефон (значение НомерТелефона); латинское имя колонки
// type_description - протокол «БИТ» (mcp.md [P3]).
//
// Параметры:
//  Поля        - Массив    - пополняемый массив.
//  МодельСтало - Структура - модель «стало».
//
Процедура ДобавитьКонтактыИзМодели(Знач Поля, Знач МодельСтало)

	ГруппаТЧ = ГруппаМодели(МодельСтало, "ТабличныеЧасти");
	Если ГруппаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокиКИ = ЗначениеИзКоллекцииМодели(ГруппаТЧ, "КонтактнаяИнформация");
	Если ТипЗнч(СтрокиКИ) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из СтрокиКИ Цикл

		ТипКИ = ЗначениеСтрокиКоллекции(СтрокаТЧ, "type_description");
		Если ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			Адрес = ЗначениеСтрокиКоллекции(СтрокаТЧ, "АдресЭП");
			Если ПустаяСтрока(Адрес) Тогда
				Адрес = ЗначениеСтрокиКоллекции(СтрокаТЧ, "Значение");
			КонецЕсли;
			ДобавитьПолеПроверки(Поля, "ЭлектроннаяПочта", "заявка", Адрес);
		ИначеЕсли ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Номер = ЗначениеСтрокиКоллекции(СтрокаТЧ, "НомерТелефона");
			Если ПустаяСтрока(Номер) Тогда
				Номер = ЗначениеСтрокиКоллекции(СтрокаТЧ, "Значение");
			КонецЕсли;
			ДобавитьПолеПроверки(Поля, "Телефон", "заявка", Номер);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Расчётные счёта из моделей ПОО (банковские счета): НомерСчета и БИК банка
// (реквизит Банк модели ПОО, Код справочника Банки); ссылки банков читаются
// одним пакетным вызовом БСП, вне цикла.
//
// Параметры:
//  Поля              - Массив - пополняемый массив.
//  ПодчиненныеСтроки - Массив - строки ТЧ ПОО из ДанныеЗаявки.
//
Процедура ДобавитьСчетаИзПодчиненных(Знач Поля, Знач ПодчиненныеСтроки)

	НомерПОО = 0;
	БанкиСчетов = Новый Соответствие;
	ЭлементыСчетов = Новый Массив;

	Для Каждого СтрокаПОО Из ПодчиненныеСтроки Цикл

		НомерПОО = НомерПОО + 1;
		МодельПОО = МодельИзХранилища(СтрокаПОО.ХранилищеМодельОбъекта);
		Если МодельПОО = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НомерСчета = ЗначениеГруппыМодели(МодельПОО, "Реквизиты", "НомерСчета");
		БанкСсылка = ЗначениеГруппыМодели(МодельПОО, "Реквизиты", "Банк");
		Если Не ЗначениеЗаполнено(НомерСчета) Тогда
			Продолжить;
		КонецЕсли;

		Источник = СтрШаблон("ПОО %1", Формат(НомерПОО, "ЧГ=0"));
		ЭлементСчета = ДобавитьПолеПроверки(Поля, "РасчетныйСчет", Источник, НомерСчета);
		ЭлементСчета.Вставить("БанкСсылка", ?(ЗначениеЗаполнено(БанкСсылка), БанкСсылка, Неопределено));
		ЭлементыСчетов.Добавить(ЭлементСчета);
		Если ЗначениеЗаполнено(БанкСсылка) И БанкиСчетов.Получить(БанкСсылка) = Неопределено Тогда
			БанкиСчетов.Вставить(БанкСсылка, Истина);
		КонецЕсли;

	КонецЦикла;

	Если ЭлементыСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Коды банков (БИК) всех счетов - одним пакетным вызовом БСП, вне цикла.
	СсылкиБанков = Новый Массив;
	Для Каждого ЭлементБанка Из БанкиСчетов Цикл
		СсылкиБанков.Добавить(ЭлементБанка.Ключ);
	КонецЦикла;
	КодыБанков = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СсылкиБанков, "Код");

	Для Каждого ЭлементСчета Из ЭлементыСчетов Цикл
		Если ЭлементСчета.БанкСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КодБанка = КодыБанков.Получить(ЭлементСчета.БанкСсылка);
		ЭлементСчета.БИКСчета = ?(КодБанка = Неопределено, "", КодБанка);
	КонецЦикла;

КонецПроцедуры

// Поля проверки из аргумента values: ключи - имена полей (см. СхемуАргументов),
// значения - строки или массивы строк; источник «values» (спека п. 11).
//
// Параметры:
//  Поля    - Массив         - пополняемый массив.
//  Значения - Соответствие  - {имя поля: значение}.
//
Процедура ПоляИзЗначенийДляПроверки(Знач Поля, Знач Значения)

	Для Каждого КлючИЗначение Из Значения Цикл

		Поле = ИмяПоляПроверкиПоКлючу(НРег(СокрЛП(КлючИЗначение.Ключ)));
		Если ПустаяСтрока(Поле) Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого ЗначениеЭлемента Из КлючИЗначение.Значение Цикл
				ДобавитьПолеПроверки(Поля, Поле, "values", ЗначениеЭлемента);
			КонецЦикла;
		Иначе
			ДобавитьПолеПроверки(Поля, Поле, "values", КлючИЗначение.Значение);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Каноническое имя поля проверки по ключу из values (без учёта регистра);
// алиасы - альтернативные ключи модели заявки (mcp.md [P3]).
Функция ИмяПоляПроверкиПоКлючу(Знач Ключ)

	Имя = АлиасыПолейПроверки().Получить(Ключ);
	Возврат ?(Имя = Неопределено, "", Имя);

КонецФункции

// Алиасы имён полей проверки (ключ values -> каноническое имя, без учёта регистра).
//
// Возвращаемое значение:
//  Соответствие - ключ -> каноническое имя поля.
//
Функция АлиасыПолейПроверки()

	Алиасы = Новый Соответствие;
	Алиасы.Вставить("инн", "ИНН");
	Алиасы.Вставить("кпп", "КПП");
	Алиасы.Вставить("огрн", "ОГРН");
	Алиасы.Вставить("огрнип", "ОГРН");
	Алиасы.Вставить("регистрационныйномер", "ОГРН");
	Алиасы.Вставить("снилс", "СНИЛС");
	Алиасы.Вставить("страховойномерпфр", "СНИЛС");
	Алиасы.Вставить("бик", "БИК");
	Алиасы.Вставить("расчетныйсчет", "РасчетныйСчет");
	Алиасы.Вставить("расчётныйсчет", "РасчетныйСчет");
	Алиасы.Вставить("номерсчета", "РасчетныйСчет");
	Алиасы.Вставить("электроннаяпочта", "ЭлектроннаяПочта");
	Алиасы.Вставить("элпочта", "ЭлектроннаяПочта");
	Алиасы.Вставить("email", "ЭлектроннаяПочта");
	Алиасы.Вставить("телефон", "Телефон");
	Алиасы.Вставить("паспорт", "Паспорт");
	Алиасы.Вставить("серияномерпаспорта", "Паспорт");
	Алиасы.Вставить("кодподразделения", "КодПодразделения");
	Алиасы.Вставить("кодподразделенияпаспорта", "КодПодразделения");
	Возврат Алиасы;

КонецФункции

// БИК, участвующие в проверке: отдельные поля БИК и БИКСчета счётов - одним
// запросом к справочнику Банки (спека п. 12: не в цикле).
//
// Возвращаемое значение:
//  Массив строк БИК (уникальные, непустые).
//
Функция БИКиПолейПроверки(Знач Поля)

	Уникальные = Новый Соответствие;
	БИКи = Новый Массив;
	Для Каждого ЭлементПоля Из Поля Цикл
		БИКиДляПоля = Новый Массив;
		БИКиДляПоля.Добавить(?(ЭлементПоля.Поле = "БИК", ЭлементПоля.Значение, ""));
		БИКиДляПоля.Добавить(ЭлементПоля.БИКСчета);
		Для Каждого БИК Из БИКиДляПоля Цикл
			БИК = НормализованноеЧислоСтроки(БИК);
			Если НЕ ПустаяСтрока(БИК) И Уникальные.Получить(БИК) = Неопределено Тогда
				Уникальные.Вставить(БИК, Истина);
				БИКи.Добавить(БИК);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат БИКи;

КонецФункции

// Банки по списку БИК одним запросом: найден ли банк и не «не действующий» ли
// он (РучноеИзменение = 3, спека п. 12, mcp.md [P3]).
//
// Параметры:
//  БИКи - Массив строк.
//
// Возвращаемое значение:
//  Соответствие - БИК -> Структура {Найден, Действующий}.
//
Функция БанкиПоБИК(Знач БИКи)

	Сведения = Новый Соответствие;
	Если БИКи.Количество() = 0 Тогда
		Возврат Сведения;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БИКи", БИКи);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Банки.Код КАК Код,
		|	Банки.РучноеИзменение КАК РучноеИзменение
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	Банки.Код В (&БИКи)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияБанка = Новый Структура;
		СведенияБанка.Вставить("Найден", Истина);
		СведенияБанка.Вставить("Действующий", Выборка.РучноеИзменение <> 3);
		Сведения.Вставить(Выборка.Код, СведенияБанка);
	КонецЦикла;

	Возврат Сведения;

КонецФункции

// Прогоняет все поля проверки: по каждому - статус «ок» / «ошибка» /
// «внимание» / «не применимо» / «пусто» и сообщение (спека п. 13-14).
//
// Параметры:
//  Поля    - Массив       - поля проверки (см. ДобавитьПолеПроверки).
//  Банки   - Соответствие - результат БанкиПоБИК.
//  Сценарий - Строка      - сценарий проверки.
//
// Возвращаемое значение:
//  Массив из Структура {field, source, value, status, message}.
//
Функция РезультатыПроверкиПолей(Знач Поля, Знач Банки, Знач Сценарий)

	Разбор = РазобратьСценарий(Сценарий);
	Параметры = Новый Структура;
	Параметры.Вставить("ЭтоЮЛ", ЭтоЮридическоеЛицо(Разбор.Вид));
	Параметры.Вставить("Нерезидент", (Разбор.Резидентность = "нерезидент"));
	Параметры.Вставить("Банки", Банки);
	Параметры.Вставить("Вид", Разбор.Вид);

	Результаты = Новый Массив;
	Для Каждого ЭлементПоля Из Поля Цикл
		Проверка = ПроверкаПоля(ЭлементПоля, Параметры);
		Результаты.Добавить(ЭлементРезультата(ЭлементПоля, Проверка));
	КонецЦикла;
	Возврат Результаты;

КонецФункции

// Разбор строки сценария «вид-резидентность(-операция)»: вид и резидентность;
// незаполненные части - пустые строки.
//
// Возвращаемое значение:
//  Структура {Вид, Резидентность}.
//
Функция РазобратьСценарий(Знач Сценарий)

	Разбор = Новый Структура;
	Разбор.Вставить("Вид", "");
	Разбор.Вставить("Резидентность", "");

	Части = СтрРазделить(Сценарий, "-", Истина);
	Если Части.Количество() > 0 Тогда
		Разбор.Вид = НРег(СокрЛП(Части[0]));
	КонецЕсли;
	Если Части.Количество() > 1 Тогда
		Разбор.Резидентность = НРег(СокрЛП(Части[1]));
	КонецЕсли;
	Возврат Разбор;

КонецФункции

// Проверяемый субъект - юридическое лицо (10-значные ИНН/ОГРН, КПП обязателен):
// ЮЛ, ОП и госорган; ИП и физлицо - 12-значные ИНН без КПП.
Функция ЭтоЮридическоеЛицо(Знач Вид)

	Возврат Вид = "юл" Или Вид = "оп" Или Вид = "госорган" Или ПустаяСтрока(Вид);

КонецФункции

// Проверка одного поля (спека п. 12-13): диспетчер по имени поля.
//
// Параметры:
//  ЭлементПоля - Структура  - {Поле, Источник, Значение, БИКСчета}.
//  Параметры   - Структура  - {ЭтоЮЛ, Нерезидент, Банки}.
//
// Возвращаемое значение:
//  Структура {Статус, Сообщение}.
//
Функция ПроверкаПоля(Знач ЭлементПоля, Знач Параметры)

	Поле = ЭлементПоля.Поле;
	Значение = ЭлементПоля.Значение;

	Если Поле = "ЭлектроннаяПочта" Тогда
		Возврат ПроверкаЭлектроннойПочты(Значение);
	КонецЕсли;

	// Остальные проверки - российские; нерезиденту не применяются (спека п. 13).
	Если Параметры.Нерезидент Тогда
		Возврат НовыйСтатусПроверки("не применимо",
			НСтр("ru = 'Российская проверка для нерезидента не применяется.'"));
	КонецЕсли;

	Если Поле = "ИНН" Тогда
		Возврат ПроверкаИНН(Значение, Параметры.ЭтоЮЛ);
	ИначеЕсли Поле = "КПП" Тогда
		Возврат ПроверкаКПП(Значение, Параметры.ЭтоЮЛ);
	ИначеЕсли Поле = "ОГРН" Тогда
		Возврат ПроверкаОГРН(Значение, Параметры.ЭтоЮЛ);
	ИначеЕсли Поле = "СНИЛС" Тогда
		Возврат ПроверкаСНИЛС(Значение);
	ИначеЕсли Поле = "БИК" Тогда
		Возврат ПроверкаБИК(Значение, Параметры.Банки);
	ИначеЕсли Поле = "РасчетныйСчет" Тогда
		Возврат ПроверкаРасчетногоСчета(Значение, ЭлементПоля.БИКСчета, Параметры);
	ИначеЕсли Поле = "Телефон" Тогда
		Возврат ПроверкаТелефона(Значение);
	ИначеЕсли Поле = "Паспорт" Тогда
		Возврат ПроверкаПаспорта(Значение);
	ИначеЕсли Поле = "КодПодразделения" Тогда
		Возврат ПроверкаКодаПодразделения(Значение);
	Иначе
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

КонецФункции

// Элемент массива results ответа (спека п. 14).
//
// Параметры:
//  ЭлементПоля - Структура - {Поле, Источник, Значение, БИКСчета}.
//  Проверка    - Структура - {Статус, Сообщение}.
//
// Возвращаемое значение:
//  Структура - {field, source, value, status, message}.
//
Функция ЭлементРезультата(Знач ЭлементПоля, Знач Проверка)

	Результат = Новый Структура;
	Результат.Вставить("field", ЭлементПоля.Поле);
	Результат.Вставить("source", ЭлементПоля.Источник);
	Результат.Вставить("value", ?(ПустаяСтрока(ЭлементПоля.Значение), Неопределено, ЭлементПоля.Значение));
	Результат.Вставить("status", Проверка.Статус);
	Результат.Вставить("message",
		?(ПустаяСтрока(Проверка.Сообщение), Неопределено, Проверка.Сообщение));
	Возврат Результат;

КонецФункции

// Число результатов с заданным статусом (для errors/warnings ответа).
Функция ЧислоСтатусов(Знач Результаты, Знач Статус)

	Количество = 0;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.status = Статус Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Новый статус проверки: {Статус, Сообщение}.
Функция НовыйСтатусПроверки(Знач Статус, Знач Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;

КонецФункции

// Проверка ИНН: контрольное число и длина по виду субъекта
// (РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям).
Функция ПроверкаИНН(Знач Значение, Знач ЭтоЮЛ)

	Если ПустаяСтрока(Значение) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	ТекстСообщения = "";
	Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(
		НормализованноеЧислоСтроки(Значение), ЭтоЮЛ, ТекстСообщения) Тогда
		Возврат НовыйСтатусПроверки("ошибка", ТекстСообщения);
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка КПП: состав и длина (БСП); для ИП/ФЛ КПП должен быть пуст; 5-6
// знаки «50» - внимание «крупнейший налогоплательщик» (спека п. 12).
Функция ПроверкаКПП(Знач Значение, Знач ЭтоЮЛ)

	Если ПустаяСтрока(Значение) Тогда
		Если ЭтоЮЛ Тогда
			Возврат НовыйСтатусПроверки("пусто", "");
		КонецЕсли;
		Возврат НовыйСтатусПроверки("ок",
			НСтр("ru = 'У ИП и физлица КПП отсутствует - корректно.'"));
	КонецЕсли;

	Если НЕ ЭтоЮЛ Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'У ИП и физлица КПП быть не должно.'"));
	КонецЕсли;

	ТекстСообщения = "";
	Если НЕ РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(Значение, ТекстСообщения) Тогда
		Возврат НовыйСтатусПроверки("ошибка", ТекстСообщения);
	КонецЕсли;

	Если Сред(Значение, 5, 2) = "50" Тогда
		Возврат НовыйСтатусПроверки("внимание",
			НСтр("ru = 'КПП крупнейшего налогоплательщика (5-6 знаки 50) - уточните, требуется
				|ли такой КПП в учёте.'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка ОГРН/ОГРНИП: длина и контрольное число
// (РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям).
Функция ПроверкаОГРН(Знач Значение, Знач ЭтоЮЛ)

	Если ПустаяСтрока(Значение) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	ТекстСообщения = "";
	Если НЕ РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям(
		НормализованноеЧислоСтроки(Значение), ЭтоЮЛ, ТекстСообщения) Тогда
		Возврат НовыйСтатусПроверки("ошибка", ТекстСообщения);
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка СНИЛС: контрольное число
// (РегламентированныеДанныеКлиентСервер.СтраховойНомерПФРСоответствуетТребованиям);
// вход функции - шаблон «999-999-999 99», нормализация из 11 цифр.
Функция ПроверкаСНИЛС(Знач Значение)

	Цифры = НормализованноеЧислоСтроки(Значение);
	Если ПустаяСтрока(Цифры) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Если СтрДлина(Цифры) <> 11 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'СНИЛС должен состоять из 11 цифр.'"));
	КонецЕсли;

	Шаблонный = Лев(Цифры, 3) + "-" + Сред(Цифры, 4, 3) + "-" + Сред(Цифры, 7, 3)
		+ " " + Сред(Цифры, 10, 2);

	ТекстСообщения = "";
	Если НЕ РегламентированныеДанныеКлиентСервер.СтраховойНомерПФРСоответствуетТребованиям(
		Шаблонный, ТекстСообщения) Тогда
		Возврат НовыйСтатусПроверки("ошибка", ТекстСообщения);
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка БИК: 9 цифр, банк есть в справочнике Банки и не «не действующий»
// (РучноеИзменение = 3); сведения банков подготовлены БанкиПоБИК (спека п. 12).
Функция ПроверкаБИК(Знач Значение, Знач Банки)

	БИК = НормализованноеЧислоСтроки(Значение);
	Если ПустаяСтрока(БИК) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Если СтрДлина(БИК) <> 9 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'БИК должен состоять из 9 цифр.'"));
	КонецЕсли;

	СведенияБанка = Банки.Получить(БИК);
	Если СведенияБанка = Неопределено Тогда
		Возврат НовыйСтатусПроверки("ошибка", СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 не найден в справочнике банков.'"), БИК));
	КонецЕсли;

	Если НЕ СведенияБанка.Действующий Тогда
		Возврат НовыйСтатусПроверки("ошибка", СтрШаблон(
			НСтр("ru = 'Банк с БИК %1 помечен как не действующий.'"), БИК));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка расчётного счёта (спека п. 12): 20 цифр; контрольный ключ по БИК
// (РегламентированныеДанныеКлиентСервер.КонтрольныйКлючЛицевогоСчетаСоответствуетТребованиям);
// 40802 - только ИП, 40817 - только физлицо; 03... - казначейский счёт
// (внимание).
//
// Параметры:
//  Значение  - Строка   - номер счёта.
//  БИКСчета  - Строка   - БИК банка счёта (из ПОО), может быть пустым.
//  Параметры - Структура - {ЭтоЮЛ, Нерезидент, Банки, Вид}.
//
// Возвращаемое значение:
//  Структура {Статус, Сообщение}.
//
Функция ПроверкаРасчетногоСчета(Знач Значение, Знач БИКСчета, Знач Параметры)

	ВидСубъекта = НРег(Параметры.Вид);

	ЦифрыСчета = НормализованноеЧислоСтроки(Значение);
	Если ПустаяСтрока(ЦифрыСчета) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Если СтрДлина(ЦифрыСчета) <> 20 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Номер расчётного счёта должен состоять из 20 цифр.'"));
	КонецЕсли;

	Если СтрНачинаетсяС(ЦифрыСчета, "03") Тогда
		Возврат НовыйСтатусПроверки("внимание",
			НСтр("ru = 'Казначейский счёт (начинается с 03): для оплаты нужны реквизиты УФК
				|(номер лицевого счёта, наименование органа казначейства).'"));
	КонецЕсли;

	Если СтрНачинаетсяС(ЦифрыСчета, "40802") И ВидСубъекта <> "ип" Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Счёт 40802... открывается индивидуальному предпринимателю, а не этому
				|виду субъекта.'"));
	КонецЕсли;

	Если СтрНачинаетсяС(ЦифрыСчета, "40817") И ВидСубъекта <> "фл" Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Счёт 40817... открывается физическому лицу, а не этому виду субъекта.'"));
	КонецЕсли;

	БИК = НормализованноеЧислоСтроки(БИКСчета);
	Если ПустаяСтрока(БИК) Тогда
		Возврат НовыйСтатусПроверки("ок",
			НСтр("ru = 'Контрольный ключ счёта не проверен: нет БИК банка.'"));
	КонецЕсли;

	Если НЕ РегламентированныеДанныеКлиентСервер.КонтрольныйКлючЛицевогоСчетаСоответствуетТребованиям(
		ЦифрыСчета, БИК) Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Не сходится контрольный ключ счёта (проверка по БИК банка).'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка e-mail (спека п. 12): один «@», без пробелов и непечатных символов,
// в домене есть точка. Единственная проверка, применяемая и к нерезиденту.
Функция ПроверкаЭлектроннойПочты(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Адрес = СокрЛП(Значение);
	ПозицияСобаки = СтрНайти(Адрес, "@");
	Если ПозицияСобаки = 0 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'В адресе нет символа «@».'"));
	КонецЕсли;
	Если СтрНайти(Сред(Адрес, ПозицияСобаки + 1), "@") > 0 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'В адресе больше одного символа «@».'"));
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Адрес) Цикл
		Символ = Сред(Адрес, Индекс, 1);
		Если Символ = " " Или КодСимвола(Символ) < 32 Тогда
			Возврат НовыйСтатусПроверки("ошибка",
				НСтр("ru = 'В адресе есть пробел или непечатный символ.'"));
		КонецЕсли;
	КонецЦикла;

	Домен = Сред(Адрес, ПозицияСобаки + 1);
	ПозицияТочки = СтрНайти(Домен, ".");
	Если ПозицияТочки < 2 Или ПозицияТочки = СтрДлина(Домен) Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'В домене адреса нет точки (или точка первая/последняя).'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка телефона (спека п. 12): после удаления пробелов, скобок и дефисов -
// «+7» и 10 цифр; ведущая «8» заменяется на «+7».
Функция ПроверкаТелефона(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Цифры = НормализованноеЧислоСтроки(Значение);
	Если СтрДлина(Цифры) = 11 И СтрНачинаетсяС(Цифры, "8") Тогда
		Цифры = "7" + Сред(Цифры, 2);
	КонецЕсли;

	Если СтрДлина(Цифры) <> 11 Или Не СтрНачинаетсяС(Цифры, "7") Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Телефон должен быть в формате +7 и 10 цифр (допускается ведущая 8).'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка паспорта РФ (спека п. 12): серия 4 цифры, номер 6 цифр
// (серия и номер - поле «Паспорт», допустимы любые разделители).
Функция ПроверкаПаспорта(Знач Значение)

	Цифры = НормализованноеЧислоСтроки(Значение);
	Если ПустаяСтрока(Цифры) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Если СтрДлина(Цифры) <> 10 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Серия и номер паспорта РФ должны состоять из 10 цифр (серия 4, номер 6).'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Проверка кода подразделения паспорта (спека п. 12): 6 цифр (формат NNN-NNN).
Функция ПроверкаКодаПодразделения(Знач Значение)

	Цифры = НормализованноеЧислоСтроки(Значение);
	Если ПустаяСтрока(Цифры) Тогда
		Возврат НовыйСтатусПроверки("пусто", "");
	КонецЕсли;

	Если СтрДлина(Цифры) <> 6 Тогда
		Возврат НовыйСтатусПроверки("ошибка",
			НСтр("ru = 'Код подразделения паспорта должен состоять из 6 цифр (формат NNN-NNN).'"));
	КонецЕсли;
	Возврат НовыйСтатусПроверки("ок", "");

КонецФункции

// Только цифры строки: разделители и оформление отбрасываются.
Функция НормализованноеЧислоСтроки(Знач Строка)

	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Если ТипЗнч(Строка) = Тип("Число") Тогда
			Возврат Формат(Строка, "ЧГ=0");
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;

КонецФункции

#КонецОбласти

#Область ИнструментОфициальныеДанные

// Реализация инструмента nsi_official_data (спека п. 15): ИНН из аргумента или
// модели заявки; 10 цифр - ЕГРЮЛ, 12 - ЕГРИП (РаботаСКонтрагентами); иное -
// отказ без обращения к сервису. Каждый вызов - запись в ar_СлужебныйЛог.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"inn": "..."} либо {"request": "..."}.
//  Контекст      - Структура - контекст запуска (не используется).
//
// Возвращаемое значение:
//  Строка - JSON-observation с данными ЕГРЮЛ/ЕГРИП либо {"error", "message"}.
//
Функция ВыполнитьЗапросОфициальныхДанных(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	ИНН = ИННИзАргументов(Аргументы);
	Если ПустаяСтрока(ИНН) Тогда
		Возврат ОшибкаИнструмента("invalid_inn",
			НСтр("ru = 'ИНН не передан и не найден в заявке.'"));
	КонецЕсли;

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РеквизитыСервиса = ДанныеСервисаПоИНН(ИНН);
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;

	ОтветСервиса = ОтветОфициальныхДанных(ИНН, РеквизитыСервиса);
	ЗаписатьЛогОфициальныхДанных(ИНН, ОтветСервиса, ДлительностьМс);
	Возврат ar_JSON.ВЗначениеJSON(ОтветСервиса);

КонецФункции

// ИНН для запроса: аргумент inn, иначе модель заявки «стало» (реквизит ИНН).
Функция ИННИзАргументов(Знач Аргументы)

	ИНН = НормализованноеЧислоСтроки(ЗначениеИзКоллекции(Аргументы, "inn", ""));
	Если НЕ ПустаяСтрока(ИНН) Тогда
		Возврат ИНН;
	КонецЕсли;

	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Возврат "";
	КонецЕсли;

	ДанныеЗаявки = ДанныеЗаявки(ОтборЗаявки.Ссылка);
	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	Возврат НормализованноеЧислоСтроки(ЗначениеМоделиПоИмени(МодельСтало, "ИНН"));

КонецФункции

// Вызов сервиса 1С:Контрагент по длине ИНН: 10 - юрлицо, 12 - предприниматель,
// иное - отказ invalid_inn без обращения к сервису (спека п. 15). Исключения
// сервиса перехватываются - наружу {"error":"service_error"}.
//
// Возвращаемое значение:
//  Структура - результат РаботаСКонтрагентами (с ОписаниеОшибки) либо
//  Структура {ОписаниеОшибки} при отказе.
//
Функция ДанныеСервисаПоИНН(Знач ИНН)

	ПустойРезультат = Новый Структура;
	ПустойРезультат.Вставить("ОписаниеОшибки", "");

	Если СтрДлина(ИНН) = 10 Тогда
		Попытка
			Возврат РаботаСКонтрагентами.РеквизитыЮридическогоЛицаПоИНН(ИНН);
		Исключение
			ПустойРезультат.ОписаниеОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ПустойРезультат;
		КонецПопытки;
	ИначеЕсли СтрДлина(ИНН) = 12 Тогда
		Попытка
			Возврат РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(ИНН);
		Исключение
			ПустойРезультат.ОписаниеОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ПустойРезультат;
		КонецПопытки;
	Иначе
		ПустойРезультат.ОписаниеОшибки = "invalid_inn";
	КонецЕсли;

	Возврат ПустойРезультат;

КонецФункции

// Ответ инструмента по результату сервиса: маппинг структур
// НовыеРеквизитыЮридическогоЛица / НовыеРеквизитыПредпринимателя в JSON
// (спека п. 15); коды отказов: service_not_connected / not_found /
// service_error / invalid_inn.
//
// Параметры:
//  ИНН             - Строка    - запрошенный ИНН.
//  РеквизитыСервиса - Структура - результат ДанныеСервисаПоИНН.
//
// Возвращаемое значение:
//  Структура - ответ-observation (данные либо {error, message}).
//
Функция ОтветОфициальныхДанных(Знач ИНН, Знач РеквизитыСервиса)

	ОписаниеОшибки = Строка(РеквизитыСервиса.ОписаниеОшибки);

	Если ОписаниеОшибки = "invalid_inn" Тогда
		Возврат ОшибкаИнструмента("invalid_inn", СтрШаблон(
			НСтр("ru = 'ИНН %1 не является 10- или 12-значным.'"), ИНН));
	КонецЕсли;

	Если ПустаяСтрока(ОписаниеОшибки) Тогда
		Ответ = ДанныеОтветаОрганизации(РеквизитыСервиса, ИНН);
		Ответ.Вставить("inn", ИНН);
		Возврат Ответ;
	КонецЕсли;

	Если ОписаниеОшибки = "УслугаНеПодключена" Тогда
		Возврат ОшибкаИнструмента("service_not_connected",
			НСтр("ru = 'Сервис 1С:Контрагент не подключен в этой базе - официальные данные
				|недоступны.'"));
	КонецЕсли;

	Если СтрНайти(НРег(ОписаниеОшибки), "не удалось найти") > 0
		Или СтрНайти(НРег(ОписаниеОшибки), "не найден") > 0 Тогда
		Возврат ОшибкаИнструмента("not_found", СтрШаблон(
			НСтр("ru = 'По ИНН %1 в ЕГРЮЛ/ЕГРИП ничего не найдено.'"), ИНН));
	КонецЕсли;

	Возврат ОшибкаИнструмента("service_error", ОписаниеОшибки);

КонецФункции

// Данные ответа из структуры сервиса: поля различаются для ЮЛ (ЕГРЮЛ) и ИП
// (ЕГРИП); отсутствующие в сервисе значения - null (спека п. 15).
//
// Параметры:
//  РеквизитыСервиса - Структура - результат РаботаСКонтрагентами.
//  ИНН              - Строка    - запрошенный ИНН (для определения вида).
//
// Возвращаемое значение:
//  Структура - {kind, name_full, name_short, kpp, ogrn, registration_date,
//  address, head, status, terminated, termination_date}.
//
Функция ДанныеОтветаОрганизации(Знач РеквизитыСервиса, Знач ИНН)

	Ответ = Новый Структура;
	Если СтрДлина(ИНН) = 12 Тогда
		Ответ.Вставить("kind", "ИП");
		Ответ.Вставить("name_full", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));
		Ответ.Вставить("name_short", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));
		Ответ.Вставить("kpp", Неопределено);
		Ответ.Вставить("ogrn", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "РегистрационныйНомер", ""));
		Ответ.Вставить("registration_date", ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаРегистрации"));
		Ответ.Вставить("address", Неопределено);
		Ответ.Вставить("head", РуководительПредпринимателя(РеквизитыСервиса));
		Ответ.Вставить("status", ТекстСтатусаОрганизации(РеквизитыСервиса));
		Ответ.Вставить("terminated", Ложь);
		Ответ.Вставить("termination_date", Неопределено);
	Иначе
		Ответ.Вставить("kind", "ЮЛ");
		Ответ.Вставить("name_full", НаименованиеЮЛПолное(РеквизитыСервиса));
		Ответ.Вставить("name_short", НаименованиеЮЛСокращенное(РеквизитыСервиса));
		Ответ.Вставить("kpp", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "КПП", ""));
		Ответ.Вставить("ogrn", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "РегистрационныйНомер", ""));
		Ответ.Вставить("registration_date", ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаРегистрации"));
		Ответ.Вставить("address", ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "ЮридическийАдрес", ""));
		Ответ.Вставить("head", РуководительЮЛ(РеквизитыСервиса));
		Ответ.Вставить("status", ТекстСтатусаОрганизации(РеквизитыСервиса));
		ДатаПрекращения = ЗначениеИзСтруктуры(РеквизитыСервиса, "ДатаПрекращенияДеятельности");
		Ответ.Вставить("terminated", ЗначениеЗаполнено(ДатаПрекращения));
		Ответ.Вставить("termination_date", ?(ЗначениеЗаполнено(ДатаПрекращения),
			ДатаПрекращения, Неопределено));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Полное наименование ЮЛ: ЕГРЮЛ-варианты, затем обычные, затем Наименование.
Функция НаименованиеЮЛПолное(Знач РеквизитыСервиса)

	Возврат ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолноеЕГРЮЛ",
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеПолное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));

КонецФункции

// Сокращённое наименование ЮЛ: ЕГРЮЛ-варианты, затем обычные, затем Наименование.
Функция НаименованиеЮЛСокращенное(Знач РеквизитыСервиса)

	Возврат ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенноеЕГРЮЛ",
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "НаименованиеСокращенное",
			ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Наименование", "")));

КонецФункции

// Руководитель ЮЛ: первый действующий (ДатаОкончания пустая) из таблицы
// Руководители сервиса: {name (ФИО), position (должность)}; null при отсутствии.
Функция РуководительЮЛ(Знач РеквизитыСервиса)

	Руководители = ЗначениеИзСтруктуры(РеквизитыСервиса, "Руководители");
	Если ТипЗнч(Руководители) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Руководители Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли;
		Руководитель = Новый Структура;
		Руководитель.Вставить("name", ФИОСтрокой(СтрокаТаблицы.Фамилия,
			СтрокаТаблицы.Имя, СтрокаТаблицы.Отчество));
		Руководитель.Вставить("position", ЗначениеВСтрокуДляОтвета(СтрокаТаблицы.НаименованиеДолжности));
		Возврат Руководитель;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Руководитель для ИП: ФИО из полей Фамилия/Имя/Отчество; должности нет.
Функция РуководительПредпринимателя(Знач РеквизитыСервиса)

	ФИО = ФИОСтрокой(ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Фамилия", ""),
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Имя", ""),
		ЗначениеИзСтруктурыСтрокой(РеквизитыСервиса, "Отчество", ""));
	Если ПустаяСтрока(ФИО) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Руководитель = Новый Структура;
	Руководитель.Вставить("name", ФИО);
	Руководитель.Вставить("position", Неопределено);
	Возврат Руководитель;

КонецФункции

// ФИО одной строкой из частей (пустые части пропускаются).
Функция ФИОСтрокой(Знач Фамилия, Знач Имя, Знач Отчество)

	Части = Новый Массив;
	Части.Добавить(СокрЛП(Фамилия));
	Части.Добавить(СокрЛП(Имя));
	Части.Добавить(СокрЛП(Отчество));

	ЗаполненныеЧасти = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если НЕ ПустаяСтрока(Часть) Тогда
			ЗаполненныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(ЗаполненныеЧасти, " ");

КонецФункции

// Текст статуса из структуры сервиса: Статус может быть Структурой {Код,
// Наименование} или строкой (см. РаботаСКонтрагентами).
Функция ТекстСтатусаОрганизации(Знач РеквизитыСервиса)

	Статус = ЗначениеИзСтруктуры(РеквизитыСервиса, "Статус");
	Если ТипЗнч(Статус) = Тип("Структура") Тогда
		Возврат ЗначениеИзСтруктурыСтрокой(Статус, "Наименование", "");
	ИначеЕсли ТипЗнч(Статус) = Тип("Строка") Тогда
		Возврат Статус;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Значение свойства структуры без исключений.
Функция ЗначениеИзСтруктуры(Знач Данные, Знач ИмяСвойства)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Неопределено;
	Данные.Свойство(ИмяСвойства, Значение);
	Возврат Значение;

КонецФункции

// Строковое свойство структуры с подстановкой при пустом значении.
Функция ЗначениеИзСтруктурыСтрокой(Знач Данные, Знач ИмяСвойства, Знач Подстановка)

	Значение = ЗначениеИзСтруктуры(Данные, ИмяСвойства);
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Значение) Тогда
		Возврат Подстановка;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Запись каждого вызова nsi_official_data в ar_СлужебныйЛог (спека п. 15):
// ИНН, исход, длительность.
Функция ЗаписатьЛогОфициальныхДанных(Знач ИНН, Знач ОтветСервиса, Знач ДлительностьМс)

	Исход = "ок";
	Если ОтветСервиса.Свойство("error") Тогда
		Исход = Строка(ОтветСервиса.error);
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_official_data", СтрШаблон(
		НСтр("ru = 'ИНН %1: %2, %3 мс'"), ИНН, Исход, Формат(ДлительностьМс, "ЧГ=0")));

	Возврат Исход;

КонецФункции

#КонецОбласти

#Область ИнструментРешениеПоВизе

// Реализация инструмента nsi_set_visa_decision (спека п. 16-20; handover -
// п. 3 спеки agentrunner-35): проверки п. 17 до записи (провал - {"error",
// "message"} и ничего не пишется), пробный запуск, запись штатным механизмом
// (для handover - комментарий визы привилегированно) в транзакции с
// исключительной блокировкой (п. 19а), перечитывание визы и статуса; после
// handover - отметка отложения ядра вне транзакции. Каждый вызов (и отказ) -
// запись в ar_СлужебныйЛог.
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {request, visa_id, decision, comment,
//                  model_hash}, обогащённый _dry_run.
//  Контекст      - Структура - контекст запуска (нужны Агент, RunId).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"done","decision","visa_id","request_status",
//  "comment_truncated"} (+ "deferred" и возможно "warning" для handover)
//  либо {"error", "message"}.
//
Функция ВыполнитьРешениеПоВизе(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаИнструмента("invalid_json_arguments");
	КонецЕсли;

	Проверки = ПроверкиПередРешением(Аргументы, Контекст);
	Если Проверки.КодОшибки <> "" Тогда
		ЗаписатьЛогРешения(Проверки, "");
		Возврат ОшибкаИнструмента(Проверки.КодОшибки, Проверки.Сообщение);
	КонецЕсли;

	// Пробный запуск: все проверки выполнены, запись не производится (спека п. 18).
	Если ar_ИнструментыДиспетчер.ИзвлечьDryRun(АргументыJSON) Тогда
		План = Новый Структура;
		План.Вставить("request", ar_Утилиты.НавигационнаяСсылкаОбъекта(Проверки.СсылкаЗаявки));
		План.Вставить("visa_id", Проверки.ИДВизы);
		План.Вставить("decision", Проверки.КодРешения);
		Возврат ar_ИнструментыДиспетчер.СформироватьDryRunJSON("nsi_set_visa_decision", План);
	КонецЕсли;

	ТекстЗаписи = "";
	Если НЕ ЗаписатьРешениеМеханизмомВизирования(Проверки, ТекстЗаписи) Тогда
		Если ПустаяСтрока(Проверки.КодОшибки) Тогда
			// Отказ механизма или исключение записи; отказ повторной проверки
			// под блокировкой кладет свой код п. 17 прямо в Проверки (п. 19а.3).
			Если Проверки.КодРешения = "handover" Тогда
				Проверки.КодОшибки = "handover_failed";
			Иначе
				Проверки.КодОшибки = "decision_failed";
			КонецЕсли;
			Проверки.Сообщение = ТекстЗаписи;
		КонецЕсли;
		ЗаписатьЛогРешения(Проверки, "");
		Возврат ОшибкаИнструмента(Проверки.КодОшибки, Проверки.Сообщение);
	КонецЕсли;

	// handover: комментарий визы записан; отметка отложения пишется после
	// фиксации транзакции, её сбой не отменяет передачу (п. 3 спеки).
	Если Проверки.КодРешения = "handover" Тогда
		Возврат ОтветПослеПередачи(Проверки, Контекст);
	КонецЕсли;

	ЗаписатьЛогРешения(Проверки, "ок");
	Возврат ar_JSON.ВЗначениеJSON(ОтветПослеРешения(Проверки));

КонецФункции

// Все проверки п. 17 спеки до записи (плюс проверки handover - п. 3 спеки
// agentrunner-35). Заполненные поля результата нужны и записи, и DryRun-плану,
// и логу.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//  Контекст  - Структура    - контекст запуска (нужен Агент).
//
// Возвращаемое значение:
//  Структура:
//   * КодОшибки          - Строка - "" или код отказа (п. 17).
//   * Сообщение          - Строка - текст отказа (перечень ошибок requisites_errors).
//   * СсылкаЗаявки       - ДокументСсылка - заявка.
//   * ИДВизы             - Строка - ИД визы.
//   * КодРешения         - Строка - approve / return / reject / handover.
//   * Виза               - СправочникСсылка - виза найденной записи (п. 17.2).
//   * Комментарий        - Строка - комментарий, усечённый до 500 (п. 19).
//   * Сценарий           - Строка - сценарий заявки; заполняется для handover
//                  (входит в комментарий визы).
//   * ХешАгента          - Строка - model_hash из аргументов; повторная проверка
//                  под блокировкой записи (п. 19а.3).
//   * УсеченКомментарий  - Булево - комментарий длиннее 500.
//   * ПользовательАгента - СправочникСсылка.Пользователи.
//
Функция ПроверкиПередРешением(Знач Аргументы, Знач Контекст)

	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("СсылкаЗаявки", Неопределено);
	Результат.Вставить("ИДВизы", "");
	Результат.Вставить("КодРешения", НРег(СокрЛП(ЗначениеИзКоллекции(Аргументы, "decision", ""))));
	Результат.Вставить("Виза", Неопределено);
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Сценарий", "");
	Результат.Вставить("ХешАгента", "");
	Результат.Вставить("УсеченКомментарий", Ложь);
	Результат.Вставить("ПользовательАгента", ПользовательАгентаИзКонтекста(Контекст));

	// 17.0: корректность аргументов решения (decision, visa_id, comment, model_hash).
	Если ОтказАргументовРешения(Аргументы, Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Комментарий = КомментарийИзАргументов(Аргументы, Результат.УсеченКомментарий);

	// 17.0: пользователь агента.
	Если НЕ ЗначениеЗаполнено(Результат.ПользовательАгента) Тогда
		Результат.КодОшибки = "agent_user_not_set";
		Результат.Сообщение = НСтр("ru = 'У агента не заполнен пользователь (ar_Агенты.ar_Пользователь).'");
		Возврат Результат;
	КонецЕсли;

	// 17.1: заявка доступна, запись визы есть, виза активна и без решения.
	ОтборЗаявки = ЗаявкаИзАргументов(Аргументы);
	Если ОтборЗаявки.КодОшибки <> "" Тогда
		Результат.КодОшибки = ОтборЗаявки.КодОшибки;
		Результат.Сообщение =
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
		Возврат Результат;
	КонецЕсли;
	Результат.СсылкаЗаявки = ОтборЗаявки.Ссылка;

	Если ОтказПоЗаписиВизы(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// 17.2: виза назначена пользователю агента.
	СписокВизАгента = бит_ВизированиеСервер.ВизыПользователя(
		Результат.ПользовательАгента, Результат.СсылкаЗаявки);
	Если СписокВизАгента.НайтиПоЗначению(Результат.Виза) = Неопределено Тогда
		Результат.КодОшибки = "visa_not_assigned_to_agent";
		Результат.Сообщение = НСтр("ru = 'Виза не назначена пользователю агента.'");
		Возврат Результат;
	КонецЕсли;

	// 17.3: дополнительные проверки approve (заполняют КодОшибки/Сообщение).
	Если Результат.КодРешения = "approve" И ОтказСогласованияЗаявки(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// handover (п. 3 спеки agentrunner-35): проверки approve (сценарий,
	// отключатель, повтор проверки реквизитов) не применяются, но model_hash
	// сверяется с текущими данными; сценарий вычисляется для комментария визы.
	Если Результат.КодРешения = "handover" И ОтказПроверкиПередачи(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверки 17.0 - корректность аргументов решения: decision из набора
// approve/return/reject/handover, наличие visa_id, комментарий для return/
// reject/handover, model_hash для approve/handover. Вынесена из
// ПроверкиПередРешением ради её сложности; при отказе заполняет
// Результат.КодОшибки/Сообщение кодом отказа п. 17.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//  Результат - Структура    - результат ПроверкиПередРешением (КодРешения уже
//              прочитан; заполняются КодОшибки/Сообщение, ИДВизы, ХешАгента).
//
// Возвращаемое значение:
//  Булево - Истина, если аргументы некорректны и решение принимать нельзя.
//
Функция ОтказАргументовРешения(Знач Аргументы, Знач Результат)

	КодРешения = Результат.КодРешения;
	Если КодРешения <> "approve" И КодРешения <> "return" И КодРешения <> "reject"
		И КодРешения <> "handover" Тогда
		Результат.КодОшибки = "invalid_decision";
		Результат.Сообщение =
			НСтр("ru = 'decision должен быть approve, return, reject или handover.'");
		Возврат Истина;
	КонецЕсли;

	ИДВизы = ЗначениеИзКоллекции(Аргументы, "visa_id", "");
	Если ТипЗнч(ИДВизы) <> Тип("Строка") ИЛИ ПустаяСтрока(ИДВизы) Тогда
		Результат.КодОшибки = "visa_not_found";
		Результат.Сообщение = НСтр("ru = 'Не передан идентификатор визы (visa_id).'");
		Возврат Истина;
	КонецЕсли;
	Результат.ИДВизы = СокрЛП(ИДВизы);

	КомментарийАргумента = ЗначениеИзКоллекции(Аргументы, "comment", "");
	Если ТипЗнч(КомментарийАргумента) <> Тип("Строка") Тогда
		КомментарийАргумента = Строка(КомментарийАргумента);
	КонецЕсли;
	Если КодРешения <> "approve" И ПустаяСтрока(КомментарийАргумента) Тогда
		Результат.КодОшибки = "comment_required";
		Результат.Сообщение =
			НСтр("ru = 'Для return, reject и handover обязателен комментарий.'");
		Возврат Истина;
	КонецЕсли;

	Результат.ХешАгента = ЗначениеИзКоллекции(Аргументы, "model_hash", "");
	Если ТипЗнч(Результат.ХешАгента) <> Тип("Строка") Тогда
		Результат.ХешАгента = "";
	КонецЕсли;
	Если (КодРешения = "approve" ИЛИ КодРешения = "handover")
		И ПустаяСтрока(Результат.ХешАгента) Тогда
		Результат.КодОшибки = "model_hash_required";
		Результат.Сообщение =
			НСтр("ru = 'Для approve и handover обязателен model_hash из nsi_get_request.'");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверки handover перед записью (п. 3 спеки agentrunner-35): model_hash
// против текущих данных заявки; заодно вычисляется сценарий заявки - он
// входит в текст комментария визы для сотрудника НСИ. Вынесена из
// ПроверкиПередРешением ради её когнитивной сложности.
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением
//                      (нужна СсылкаЗаявки; заполняются КодОшибки/Сообщение,
//                      Сценарий).
//
// Возвращаемое значение:
//  Булево - Истина, если передачу сотруднику делать нельзя.
//
Функция ОтказПроверкиПередачи(Знач РезультатПроверок)

	ДанныеЗаявки = ДанныеЗаявки(РезультатПроверок.СсылкаЗаявки);
	Если ОтказПоХешуМодели(ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	РезультатПроверок.Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);
	Возврат Ложь;

КонецФункции

// Запись визы заявки (п. 17.1 спеки): найдена, активна и без решения. При
// отказе заполняет КодОшибки/Сообщение (visa_not_found / visa_not_active /
// visa_already_decided) и возвращает Истина. Ссылка визы записи сохраняется в
// РезультатПроверок.Виза. Данные читаются заново при каждом вызове:
// используется и в предварительных проверках, и в повторной проверке под
// блокировкой записи (п. 19а.3).
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужны
//                      СсылкаЗаявки и ИДВизы; заполняются КодОшибки/Сообщение).
//
// Возвращаемое значение:
//  Булево - Истина, если решение по этой визе ставить нельзя.
//
Функция ОтказПоЗаписиВизы(Знач РезультатПроверок)

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", РезультатПроверок.СсылкаЗаявки);
	Отбор.Вставить("ИД", РезультатПроверок.ИДВизы);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);
	Если НаборВизы.Количество() = 0 Тогда
		РезультатПроверок.КодОшибки = "visa_not_found";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Виза с ИД %1 у заявки не найдена.'"), РезультатПроверок.ИДВизы);
		Возврат Истина;
	КонецЕсли;

	ЗаписьВизы = НаборВизы[0];
	РезультатПроверок.Виза = ЗаписьВизы.Виза;
	Если НЕ ЗаписьВизы.АктивнаяВиза Тогда
		РезультатПроверок.КодОшибки = "visa_not_active";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Виза не активна (заявка ушла с этой точки визирования).'");
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаписьВизы.Решение) Тогда
		РезультатПроверок.КодОшибки = "visa_already_decided";
		РезультатПроверок.Сообщение = НСтр("ru = 'По визе уже есть решение - повторное решение делается
			|штатной отменой в «БИТ».'");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверки approve (п. 17.3 спеки): настройка-отключатель, разрешённый сценарий,
// совпадение model_hash, повтор проверок реквизитов без ошибок. При отказе
// заполняет КодОшибки/Сообщение структуры проверок и возвращает Истина.
//
// Параметры:
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужны
//                      СсылкаЗаявки и ХешАгента; заполняются КодОшибки/Сообщение).
//
// Возвращаемое значение:
//  Булево - Истина, если approve по этой заявке запрещён.
//
Функция ОтказСогласованияЗаявки(Знач РезультатПроверок)

	Если НастройкаИстинна(ar_Настройки.ЗначениеНастройки("НСИАгентТолькоВозвращает", Ложь)) Тогда
		РезультатПроверок.КодОшибки = "approve_disabled";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Approve запрещён настройкой пакета «НСИ: агент только возвращает».'");
		Возврат Истина;
	КонецЕсли;

	ДанныеЗаявки = ДанныеЗаявки(РезультатПроверок.СсылкаЗаявки);
	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		РезультатПроверок.КодОшибки = "request_not_found";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
		Возврат Истина;
	КонецЕсли;
	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	Сценарий = СценарийЗаявки(ДанныеЗаявки.Шапка, МодельСтало);

	Если НЕ СценарийРазрешен(Сценарий) Тогда
		РезультатПроверок.КодОшибки = "scenario_not_allowed:" + Сценарий;
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Сценарий %1 не входит в настройку «НСИ: разрешённые сценарии согласования».'"),
			Сценарий);
		Возврат Истина;
	КонецЕсли;

	Если ОтказПоХешуМодели(ДанныеЗаявки, РезультатПроверок) Тогда
		Возврат Истина;
	КонецЕсли;

	ОшибкиРеквизитов = ОшибкиПовторнойПроверки(ДанныеЗаявки, МодельСтало, Сценарий);
	Если ОшибкиРеквизитов.Количество() > 0 Тогда
		РезультатПроверок.КодОшибки = "requisites_errors";
		РезультатПроверок.Сообщение = СтрШаблон(
			НСтр("ru = 'Проверка реквизитов нашла ошибки: %1'"),
			СтрСоединить(ОшибкиРеквизитов, "; "));
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Отказ по model_hash (п. 17.3 спеки): текущий хеш модели заявки «стало» и ПОО
// не совпал с хешем из аргументов агента. Заполняет request_changed (или
// request_not_found, если заявка не читается) и возвращает Истина.
//
// Параметры:
//  ДанныеЗаявки      - Структура - результат ДанныеЗаявки; читается вызывающим -
//                      в повторной проверке под блокировкой заново (п. 19а.3).
//  РезультатПроверок - Структура - результат ПроверкиПередРешением (нужен ХешАгента).
//
// Возвращаемое значение:
//  Булево - Истина, если заявка изменилась после чтения агентом.
//
Функция ОтказПоХешуМодели(Знач ДанныеЗаявки, Знач РезультатПроверок)

	Если ДанныеЗаявки.Шапка = Неопределено Тогда
		РезультатПроверок.КодОшибки = "request_not_found";
		РезультатПроверок.Сообщение =
			НСтр("ru = 'Заявка не найдена, не является заявкой НСИ или недоступна пользователю.'");
		Возврат Истина;
	КонецЕсли;

	МодельСтало = МодельИзХранилища(ДанныеЗаявки.Шапка.ХранилищеМодельОбъекта);
	ТекущийХеш = ХешМоделейЗаявки(МодельСтало, ДанныеЗаявки.Подчиненные);
	Если ТекущийХеш = РезультатПроверок.ХешАгента Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатПроверок.КодОшибки = "request_changed";
	РезультатПроверок.Сообщение = НСтр("ru = 'Заявка изменена после чтения (model_hash не совпал)
		|- перечитайте заявку инструментом nsi_get_request.'");
	Возврат Истина;

КонецФункции

// Разрешённые сценарии approve из настройки пакета
// НСИРазрешённыеСценарииСогласования (строка через запятую, п. 21 спеки).
//
// Возвращаемое значение:
//  Массив строк (обрезанные элементы).
//
Функция РазрешенныеСценарии()

	Настройка = ar_Настройки.ЗначениеНастройки("НСИРазрешённыеСценарииСогласования",
		"ЮЛ-резидент-создание");
	Если ТипЗнч(Настройка) <> Тип("Строка") Тогда
		Настройка = Строка(Настройка);
	КонецЕсли;

	Сценарии = Новый Массив;
	Части = СтрРазделить(Настройка, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Часть)) Тогда
			Сценарии.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;
	Возврат Сценарии;

КонецФункции

// Входит ли сценарий заявки в настройку разрешённых сценариев (точное сравнение).
Функция СценарийРазрешен(Знач Сценарий)

	Для Каждого Разрешенный Из РазрешенныеСценарии() Цикл
		Если Разрешенный = Сценарий Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Повтор проверок реквизитов по заявке перед approve (п. 17.3): перечень
// сообщений полей со статусом «ошибка».
//
// Возвращаемое значение:
//  Массив строк "<поле>: <сообщение>".
//
Функция ОшибкиПовторнойПроверки(Знач ДанныеЗаявки, Знач МодельСтало, Знач Сценарий)

	Поля = Новый Массив;
	ПоляИзЗаявкиДляПроверки(Поля, ДанныеЗаявки, МодельСтало);

	Банки = БанкиПоБИК(БИКиПолейПроверки(Поля));
	Результаты = РезультатыПроверкиПолей(Поля, Банки, Сценарий);

	Ошибки = Новый Массив;
	Для Каждого Результат Из Результаты Цикл
		Если Результат.status = "ошибка" Тогда
			Ошибки.Добавить(СтрШаблон("%1: %2", Результат.field, Результат.message));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Комментарий решения: строка, усечённая до 500 символов (п. 19 спеки); признак
// усечения возвращается в comment_truncated.
Функция КомментарийИзАргументов(Знач Аргументы, Усечен)

	Комментарий = ЗначениеИзКоллекции(Аргументы, "comment", "");
	Если ТипЗнч(Комментарий) <> Тип("Строка") Тогда
		Комментарий = Строка(Комментарий);
	КонецЕсли;

	Усечен = СтрДлина(Комментарий) > 500;
	Возврат Лев(Комментарий, 500);

КонецФункции

// Запись решения штатным механизмом визирования «БИТ» (п. 19, 19а спеки):
// транзакция с исключительной управляемой блокировкой виз заявки и самой заявки,
// повтор проверок визы и model_hash под блокировкой, затем - для
// approve/return/reject НовыеПараметрыПринятияРешения + УстановитьРешениеПоВизе,
// для handover - комментарий визы привилегированно (п. 3 спеки agentrunner-35);
// без привилегированного режима - права пользователя сеанса запуска. Отказ
// повторной проверки - код отказа п. 17 в Проверки; отказ механизма и исключения
// (включая испорченную вложенным откатом транзакцию при фиксации) -
// decision_failed/handover_failed у вызывающего, текст в ТекстОшибки.
//
// Параметры:
//  Проверки     - Структура - результат ПроверкиПередРешением (при отказе
//                 повторной проверки заполняются КодОшибки/Сообщение).
//  ТекстОшибки  - Строка    - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если решение записано и транзакция зафиксирована.
//
Функция ЗаписатьРешениеМеханизмомВизирования(Знач Проверки, ТекстОшибки)

	ТекстОшибки = "";

	// Очистка очереди сообщений: после вызова читаем только сообщения механизма.
	ПолучитьСообщенияПользователю(Истина);

	Исход = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДанныеРешения(Проверки.СсылкаЗаявки);

		Если ПовторнаяПроверкаОтказала(Проверки) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		// handover вместо решения пишет комментарий визы (в той же транзакции,
		// под той же блокировкой 19а); approve/return/reject - штатный механизм.
		Если Проверки.КодРешения = "handover" Тогда
			Исход = ЗаписатьКомментарийВизыПривилегированно(Проверки, ТекстОшибки);
		Иначе
			Исход = УстановитьРешениеМеханизмом(Проверки, ТекстОшибки);
		КонецЕсли;
		Если НЕ Исход Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		// Транзакция могла быть испорчена вложенным откатом (например,
		// ИсполнитьЗаявку отменил свою транзакцию) - закрываем, только если активна.
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Исход = Ложь;
		ТекстПричины = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстОшибки = ?(ПустаяСтрока(ТекстОшибки), ТекстПричины,
			ТекстОшибки + " " + ТекстПричины);
	КонецПопытки;

	Возврат Исход;

КонецФункции

// Исключительные управляемые блокировки записи решения (п. 19а.2 спеки):
// визы заявки в РегистрСведений.бит_УстановленныеВизы (по полю Объект) и сама
// заявка в Документ.бит_мдм_ЗаявкаНаИзменение (по Ссылка). Вызывается внутри
// транзакции и до чтения данных: разделяемую блокировку чтения поднять до
// исключительной нельзя.
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка решения.
//
Процедура ЗаблокироватьДанныеРешения(Знач СсылкаЗаявки)

	Блокировка = Новый БлокировкаДанных;

	ЭлементВизы = Блокировка.Добавить("РегистрСведений.бит_УстановленныеВизы");
	ЭлементВизы.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементВизы.УстановитьЗначение("Объект", СсылкаЗаявки);

	ЭлементЗаявки = Блокировка.Добавить("Документ.бит_мдм_ЗаявкаНаИзменение");
	ЭлементЗаявки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементЗаявки.УстановитьЗначение("Ссылка", СсылкаЗаявки);

	Блокировка.Заблокировать();

КонецПроцедуры

// Повтор проверок под блокировкой (п. 19а.3 спеки): виза есть, активна и без
// решения; для approve и handover - model_hash по текущим данным заявки (для
// handover - п. 3 спеки agentrunner-35). При отказе заполняет
// Проверки.КодОшибки/Сообщение кодом отказа п. 17 и возвращает Истина.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки, ИДВизы,
//             КодРешения, ХешАгента; заполняются КодОшибки/Сообщение).
//
// Возвращаемое значение:
//  Булево - Истина, если под блокировкой решение ставить нельзя.
//
Функция ПовторнаяПроверкаОтказала(Знач Проверки)

	Если ОтказПоЗаписиВизы(Проверки) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Проверки.КодРешения <> "approve" И Проверки.КодРешения <> "handover" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Читаем заявку заново: под блокировкой это текущие данные.
	ДанныеЗаявки = ДанныеЗаявки(Проверки.СсылкаЗаявки);
	Возврат ОтказПоХешуМодели(ДанныеЗаявки, Проверки);

КонецФункции

// Заполнение параметров решения (п. 19 спеки) и вызов механизма «БИТ».
// Транзакцию не ведет - ею управляет ЗаписатьРешениеМеханизмомВизирования.
// Сообщения механизма и текст исключения - в ТекстОшибки.
//
// Параметры:
//  Проверки     - Структура - результат ПроверкиПередРешением.
//  ТекстОшибки  - Строка    - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если механизм вернул успех.
//
Функция УстановитьРешениеМеханизмом(Знач Проверки, ТекстОшибки)

	ПараметрыРешения = Обработки.бит_КонсольОперативногоВизирования.НовыеПараметрыПринятияРешения();
	ПараметрыРешения.ОбъектВизирования     = Проверки.СсылкаЗаявки;
	ПараметрыРешения.ИДВизы                = Проверки.ИДВизы;
	ПараметрыРешения.Решение               = СсылкаРешенияПоКоду(Проверки.КодРешения);
	ПараметрыРешения.Комментарий           = Проверки.Комментарий;
	ПараметрыРешения.ДатаУстановкиРешения  = ТекущаяДатаСеанса();
	ПараметрыРешения.ТекущийПользователь   = Проверки.ПользовательАгента;
	// ПроводитьПослеУтверждения остаётся как заполнила НовыеПараметрыПринятияРешения
	// (функциональная опция бит_ПроводитьДокументыПослеУтверждения, п. 19 спеки).

	Исход = Ложь;
	Попытка
		Исход = sd_Оптимизация_ФоновоеВизированиеСервер.УстановитьРешениеПоВизе(ПараметрыРешения);
	Исключение
		Исход = Ложь;
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстСообщенийМеханизма = СообщенияМеханизмаСтрокой();
	Если ПустаяСтрока(ТекстСообщенийМеханизма) Тогда
		Если НЕ Исход И ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = НСтр("ru = 'Механизм визирования не принял решение.'");
		КонецЕсли;
	Иначе
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", " ") + ТекстСообщенийМеханизма;
	КонецЕсли;

	Возврат Исход;

КонецФункции

// Запись комментария визы для handover (п. 3 спеки agentrunner-35) - вместо
// решения: в записи бит_УстановленныеВизы этой визы меняется только ресурс
// Комментарий («Проверено агентом НСИ ...»), решение, пользователь и дата
// установки не трогаются. Набор читается и пишется привилегированно (решение
// человека 2026-10-06: право записи визы пользователю агента не выдаётся),
// подъём - только на чтение-запись набора этой визы, сброс и в Исключение.
// Выполняется в транзакции решения (ЗаписатьРешениеМеханизмомВизирования),
// под исключительной блокировкой 19а; ошибка записи откатывает транзакцию,
// отметка ядра не пишется (handover_failed у вызывающего).
//
// Параметры:
//  Проверки    - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//                ИДВизы, Комментарий, Сценарий).
//  ТекстОшибки - Строка - очищенный текст отказа (выходной).
//
// Возвращаемое значение:
//  Булево - Истина, если комментарий записан.
//
Функция ЗаписатьКомментарийВизыПривилегированно(Знач Проверки, ТекстОшибки)

	Исход = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Отбор = Новый Структура;
		Отбор.Вставить("Объект", Проверки.СсылкаЗаявки);
		Отбор.Вставить("ИД", Проверки.ИДВизы);
		НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

		Если НаборВизы.Количество() > 0 Тогда
			НаборВизы[0].Комментарий = Лев(ТекстКомментарияПередачи(Проверки), 500);
			НаборВизы.Записать(Истина);
			Исход = Истина;
		Иначе
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Виза с ИД %1 у заявки не найдена.'"), Проверки.ИДВизы);
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);
	Возврат Исход;

КонецФункции

// Текст комментария визы для сотрудника НСИ (п. 3 спеки agentrunner-35):
// «Проверено агентом НСИ ДД.ММ.ГГГГ ЧЧ:ММ: блокирующих замечаний нет;
// сценарий <сценарий> согласует сотрудник НСИ. <comment агента>». Запись
// усекается вызывающим до 500 (как п. 19).
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (Комментарий,
//             Сценарий).
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстКомментарияПередачи(Знач Проверки)

	Возврат СтрШаблон(
		НСтр("ru = 'Проверено агентом НСИ %1: блокирующих замечаний нет; сценарий %2 согласует
			|сотрудник НСИ. %3'"),
		Формат(ТекущаяДатаСеанса(), "ДФ=дд.ММ.гггг ЧЧ:мм"),
		Проверки.Сценарий,
		Проверки.Комментарий);

КонецФункции

// Предопределённое решение согласования по коду инструмента (п. 19 спеки):
// approve -> Согласовано, return -> sd_НаДоработку, reject -> Отклонено.
Функция СсылкаРешенияПоКоду(Знач КодРешения)
	Если КодРешения = "approve" Тогда
		Возврат Справочники.бит_ВидыРешенийСогласования.Согласовано;
	ИначеЕсли КодРешения = "return" Тогда
		Возврат Справочники.бит_ВидыРешенийСогласования.sd_НаДоработку;
	Иначе
		Возврат Справочники.бит_ВидыРешенийСогласования.Отклонено;
	КонецЕсли;

КонецФункции

// Накопленные сообщения пользователю одной строкой (механизм визирования
// сообщает через СообщитьПользователю - спека п. 19 требует их в message).
Функция СообщенияМеханизмаСтрокой()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Строки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Сообщение.Текст)) Тогда
			Строки.Добавить(СокрЛП(Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, " ");

КонецФункции

// Ответ после успешной записи (п. 20 спеки): перечитываются запись визы
// (решение) и статус заявки.
//
// Возвращаемое значение:
//  Структура - {done, decision, visa_id, request_status, comment_truncated}.
//
Функция ОтветПослеРешения(Знач Проверки)

	Отбор = Новый Структура;
	Отбор.Вставить("Объект", Проверки.СсылкаЗаявки);
	Отбор.Вставить("ИД", Проверки.ИДВизы);
	НаборВизы = бит_ВизированиеСервер.ПрочитатьНаборВиз(Отбор);

	СтатусЗаявки = Неопределено;
	Если НаборВизы.Количество() > 0 Тогда
		Для Каждого ЗаписьВизы Из НаборВизы Цикл
			Если ЗначениеЗаполнено(ЗаписьВизы.Статус) Тогда
				СтатусЗаявки = Строка(ЗаписьВизы.Статус);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("done", Истина);
	Ответ.Вставить("decision", Проверки.КодРешения);
	Ответ.Вставить("visa_id", Проверки.ИДВизы);
	Ответ.Вставить("request_status", СтатусЗаявки);
	Ответ.Вставить("comment_truncated", Проверки.УсеченКомментарий);
	Возврат Ответ;

КонецФункции

// Ответ и финализация handover (п. 3 спеки agentrunner-35): комментарий визы
// уже записан (транзакция зафиксирована), отметка отложения пишется ВНЕ
// транзакции «БИТ» - её сбой не отменяет передачу: комментарий уже виден
// сотруднику НСИ, а заявка без отметки просто вернётся в очередь (безвредно).
// Сбой отметки - лог deferral_not_saved и warning в ответе.
//
// Параметры:
//  Проверки - Структура - результат ПроверкиПередРешением (СсылкаЗаявки,
//             ИДВизы, Комментарий, ХешАгента, УсеченКомментарий).
//  Контекст - Структура - контекст запуска (нужны Агент, RunId).
//
// Возвращаемое значение:
//  Строка - JSON {"done","decision","visa_id","request_status","deferred",
//  "comment_truncated"[, "warning"]}.
//
Функция ОтветПослеПередачи(Знач Проверки, Знач Контекст)

	Агент = АгентИзКонтекста(Контекст);
	RunId = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("RunId", RunId);
	КонецЕсли;

	Отложено = Ложь;
	Попытка
		Отложено = ar_AuditЗащищённыйРежим.ОтложитьПредметПривилегированно(
			Агент, Проверки.СсылкаЗаявки, Проверки.ИДВизы, Проверки.ХешАгента,
			Проверки.Комментарий, RunId);
	Исключение
		Отложено = Ложь;
		ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "deferral_not_saved",
			СтрШаблон("%1: виза %2: %3",
				Строка(Проверки.СсылкаЗаявки), Проверки.ИДВизы,
				ar_Утилиты.ОчиститьОшибкуДляLLM(
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))),
			"Предупреждение", RunId, Проверки.СсылкаЗаявки);
	КонецПопытки;

	ЗаписатьЛогРешения(Проверки, "ок");

	Ответ = ОтветПослеРешения(Проверки);
	Ответ.Вставить("deferred", Отложено);
	Если НЕ Отложено Тогда
		Ответ.Вставить("warning", "deferral_not_saved");
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Лог каждого вызова (и отказа) nsi_set_visa_decision (п. 20 спеки): заявка,
// виза, решение, исход, код отказа.
Функция ЗаписатьЛогРешения(Знач Проверки, Знач Исход)

	СсылкаЗаявки = Проверки.СсылкаЗаявки;
	ПредставлениеЗаявки = ?(ЗначениеЗаполнено(СсылкаЗаявки), Строка(СсылкаЗаявки), "-");
	КодОтказа = ?(ПустаяСтрока(Проверки.КодОшибки), "-", Проверки.КодОшибки);
	ИсходРешения = ?(ПустаяСтрока(Исход), КодОтказа, Исход);

	ar_СлужебныйЛог.Записать("ar_ПакетНСИ", "nsi_visa_decision", СтрШаблон(
		НСтр("ru = '%1: виза %2, решение %3, исход %4 (%5)'"),
		ПредставлениеЗаявки, Проверки.ИДВизы, Проверки.КодРешения, ИсходРешения, КодОтказа));

	Возврат ИсходРешения;

КонецФункции

#КонецОбласти

#Область ЗаявкиИСценарии

// Заявка из аргументов: навигационная ссылка -> доступная заявка НСИ.
// Не заявка, не найдена или не видна пользователю - request_not_found (спека
// п. 3; доступ - запрос ВЫБРАТЬ РАЗРЕШЕННЫЕ, пусто - тот же код).
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы инструмента.
//
// Возвращаемое значение:
//  Структура {Ссылка, КодОшибки} - КодОшибки = "" при успехе.
//
Функция ЗаявкаИзАргументов(Знач Аргументы)

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("КодОшибки", "request_not_found");

	СтрокаСсылки = ЗначениеИзКоллекции(Аргументы, "request", "");
	Если ТипЗнч(СтрокаСсылки) <> Тип("Строка") ИЛИ ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат Результат;
	КонецЕсли;

	СсылкаЗаявки = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
	Если СсылкаЗаявки = Неопределено
		Или ТипЗнч(СсылкаЗаявки) <> Тип("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение") Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗаявкаДоступна(СсылкаЗаявки) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = СсылкаЗаявки;
	Результат.КодОшибки = "";
	Возврат Результат;

КонецФункции

// Видит ли пользователь сеанса заявку (спека п. 3): запрос РАЗРЕШЕННЫЕ -
// скрытая ограничением доступа заявка неотличима от несуществующей.
Функция ЗаявкаДоступна(Знач СсылкаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗаявки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Сценарий заявки строкой «вид-резидентность-операция» (спека п. 4);
// «не определён», если вид или резидентность определить не удалось
// (approve для такого сценария запрещён).
//
// Параметры:
//  Шапка       - Структура - шапка заявки из РеквизитыЗаявокШапки.
//  МодельСтало - Структура - модель заявки «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Строка - например «ЮЛ-резидент-создание» или «не определён».
//
Функция СценарийЗаявки(Знач Шапка, Знач МодельСтало)

	Признаки = ПризнакиСубъектаСценария(Шапка.Ссылка, МодельСтало);
	Вид = ВидОбъектаСценария(Шапка, Признаки);
	Резидентность = РезидентностьСценария(Признаки);
	Если ПустаяСтрока(Вид) Или ПустаяСтрока(Резидентность) Тогда
		Возврат "не определён";
	КонецЕсли;

	Возврат Вид + "-" + Резидентность + "-" + ОперацияСценария(Шапка);

КонецФункции

// Имена признаков контрагента, определяющих вид субъекта и резидентность
// сценария (спека п. 4).
//
// Возвращаемое значение:
//  Массив строк.
//
Функция ПризнакиСценария()

	Имена = Новый Массив;
	Имена.Добавить("sd_ОП");
	Имена.Добавить("ОбособленноеПодразделение");
	Имена.Добавить("ГосударственныйОрган");
	Имена.Добавить("sd_ГосударственныеОрганы");
	Имена.Добавить("sd_ИП");
	Имена.Добавить("ИндивидуальныйПредприниматель");
	Имена.Добавить("sd_Нерезидент");
	Возврат Имена;

КонецФункции

// Признаки субъекта по правилу спеки п. 5: существующие в шапке заявки читаются
// одним вызовом БСП, остальные - из модели «стало» (стандарт: не через точку
// по одному признаку).
//
// Параметры:
//  СсылкаЗаявки - ДокументСсылка - заявка (для шапочных признаков).
//  МодельСтало  - Структура     - модель «стало» (может быть Неопределено).
//
// Возвращаемое значение:
//  Соответствие - имя признака -> значение.
//
Функция ПризнакиСубъектаСценария(Знач СсылкаЗаявки, Знач МодельСтало)

	ИменаПризнаков = ПризнакиСценария();
	ШапочныеИмена = ШапочныеИменаЗаявки(ИменаПризнаков);
	ШапочныеЗначения = ЗначенияШапочныхРеквизитов(СсылкаЗаявки, ШапочныеИмена);

	Признаки = Новый Соответствие;
	Для Каждого ИмяПризнака Из ИменаПризнаков Цикл
		Если ШапочныеЗначения.Свойство(ИмяПризнака) Тогда
			Признаки.Вставить(ИмяПризнака, ШапочныеЗначения[ИмяПризнака]);
		Иначе
			Признаки.Вставить(ИмяПризнака, ЗначениеМоделиПоИмени(МодельСтало, ИмяПризнака));
		КонецЕсли;
	КонецЦикла;
	Возврат Признаки;

КонецФункции

// Вид субъекта сценария: ОП / Госорган по признакам, иначе по Юр/Физ и ИП
// (спека п. 4). Пустая строка - определить не удалось.
Функция ВидОбъектаСценария(Знач Шапка, Знач Признаки)

	Если ЗначениеБулево(Признаки.Получить("sd_ОП"))
		Или ЗначениеБулево(Признаки.Получить("ОбособленноеПодразделение")) Тогда
		Возврат "ОП";
	КонецЕсли;

	Если ЗначениеБулево(Признаки.Получить("ГосударственныйОрган"))
		Или ЗначениеБулево(Признаки.Получить("sd_ГосударственныеОрганы")) Тогда
		Возврат "Госорган";
	КонецЕсли;

	Если Шапка.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		Если ЗначениеБулево(Признаки.Получить("sd_ИП"))
			Или ЗначениеБулево(Признаки.Получить("ИндивидуальныйПредприниматель")) Тогда
			Возврат "ИП";
		КонецЕсли;
		Возврат "ЮЛ";
	ИначеЕсли Шапка.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат "ФЛ";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Приводит значение признака контрагента (Булево из модели или шапки, Число,
// Строка) к Булево; Неопределено и незнакомое значение - Ложь.
Функция ЗначениеБулево(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Возврат Текст = "истина" Или Текст = "да" Или Текст = "1";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Резидентность сценария по признаку sd_Нерезидент; пустая строка - признак
// не определён ни в шапке, ни в модели.
Функция РезидентностьСценария(Знач Признаки)

	Значение = Признаки.Получить("sd_Нерезидент");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(ЗначениеБулево(Значение), "нерезидент", "резидент");

КонецФункции

// Операция сценария по ВидОперации шапки (спека п. 4): создание / изменение /
// прочее.
Функция ОперацияСценария(Знач Шапка)

	Если Шапка.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового Тогда
		Возврат "создание";
	ИначеЕсли Шапка.ВидОперации
		= Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение Тогда
		Возврат "изменение";
	Иначе
		Возврат "прочее";
	КонецЕсли;

КонецФункции

// Значение реквизита из модели «стало»: Реквизиты, затем СтандартныеРеквизиты.
Функция ЗначениеМоделиПоИмени(Знач МодельСтало, Знач ИмяРеквизита)

	Если МодельСтало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ЗначениеГруппыМодели(МодельСтало, "Реквизиты", ИмяРеквизита);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеГруппыМодели(МодельСтало, "СтандартныеРеквизиты", ИмяРеквизита);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Значение из группы модели (Структура или Соответствие); Неопределено - группа
// или ключ отсутствуют.
Функция ЗначениеГруппыМодели(Знач Модель, Знач ИмяГруппы, Знач ИмяРеквизита)

	Группа = ГруппаМодели(Модель, ИмяГруппы);
	Возврат ЗначениеИзКоллекцииМодели(Группа, ИмяРеквизита);

КонецФункции

// Группа модели по имени; модель может быть Структурой или Соответствием.
Функция ГруппаМодели(Знач Модель, Знач ИмяГруппы)

	Возврат ЗначениеИзКоллекцииМодели(Модель, ИмяГруппы);

КонецФункции

// Значение из коллекции группы (Структура - по свойству, Соответствие - по
// ключу); Неопределено - нет.
Функция ЗначениеИзКоллекцииМодели(Знач Коллекция, Знач Ключ)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Модель из хранилища значения: Структура или Соответствие; пустое хранилище -
// Неопределено (спека п. 10: fields пуст, warning model_empty).
Функция МодельИзХранилища(Знач Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Модель = Хранилище.Получить();
	Если ТипЗнч(Модель) = Тип("Структура") Или ТипЗнч(Модель) = Тип("Соответствие") Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Пользователь агента из контекста запуска (спека п. 3): Контекст.Агент ->
// реквизит ar_Пользователь; приём ar_ДиалогиСервер.ПользовательАгента. Пустая
// ссылка - агента нет или пользователь не заполнен.
//
// Параметры:
//  Контекст - Структура - контекст запуска (может быть Неопределено).
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи.
//
Функция ПользовательАгентаИзКонтекста(Знач Контекст)

	ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();

	Агент = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("Агент", Агент);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Агент) Или НЕ ОбщегоНазначения.СсылкаСуществует(Агент) Тогда
		Возврат ПустойПользователь;
	КонецЕсли;

	Пользователь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "ar_Пользователь");
	Возврат ?(ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи"),
		Пользователь, ПустойПользователь);

КонецФункции

// Агент из контекста запуска (для отсева отложенных, agentrunner-35): та же
// защита на Неопределено и прочие типы, что у ПользовательАгентаИзКонтекста.
//
// Параметры:
//  Контекст - Структура - контекст запуска (может быть Неопределено).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты, Неопределено - ссылка агента или Неопределено,
//  если в контексте её нет.
//
Функция АгентИзКонтекста(Знач Контекст)

	Агент = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Контекст.Свойство("Агент", Агент);
	КонецЕсли;
	Возврат Агент;

КонецФункции

// Ключи соответствия массивом (для пакетной передачи в запрос).
//
// Параметры:
//  Соответствие - Соответствие - коллекция, чьи ключи собираются в массив.
//
// Возвращаемое значение:
//  Массив - ключи соответствия.
//
Функция КлючиСоответствия(Знач Соответствие)

	Результат = Новый Массив;
	Для Каждого КлючЗначение Из Соответствие Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Предельное число объектов очереди за вызов ar_ОбъектыКОбработке (спека
// agentrunner-34; ядро передаёт не больше 200).
//
// Возвращаемое значение:
//  Число - предельное число объектов очереди.
//
Функция ПредельныйЛимитОчереди()
	Возврат 200;
КонецФункции

// Общий отбор заявок, ждущих визу пользователя агента: кандидаты из регистра
// бит_УстановленныеВизы (СтрокиКандидатовНаВизе) + фильтр по визам агента
// (СтрокиСВизойАгента) + пропуск заявок, переданных агентом сотруднику НСИ
// (agentrunner-35, спека п. 4). Единственная точка отбора очереди:
// инструмент nsi_pending_visas и метод очереди ar_ОбъектыКОбработке обязаны
// видеть одну и ту же очередь - два текста запроса разошлись бы при правке
// (спека agentrunner-34, решение 1).
//
// Отметки отложения читаются ядром одним запросом (через фасад), текущие
// model_hash считаются одним пакетным чтением моделей и только для отмеченных
// заявок. Пропущенные строки не расходуют Лимит; отметка устарела (виза
// другая или хеш другой) - строка остаётся в выдаче.
//
// Параметры:
//  ПользовательАгента - СправочникСсылка.Пользователи - пользователь агента.
//  ИмяОбъекта         - Строка - имя объекта обмена для отбора; "" - все заявки НСИ.
//  Лимит              - Число  - предельное число строк отбора.
//  СсылкАгент         - СправочникСсылка.ar_Агенты - агент очереди (для отметок
//                       отложения); пустая ссылка - отсев не выполняется.
//  ВключаяОтложенных  - Булево - отмеченные строки не пропускаются
//                       (include_handed_over инструмента); по умолчанию Ложь.
//
// Возвращаемое значение:
//  Структура:
//   * Строки              - Массив - строки кандидатов с визой агента (не больше Лимит).
//   * ПросмотреноЗаявок   - Число  - заявок, для которых проверялись визы агента.
//   * ПропущеноОтложенных - Число  - строк, пропущенных по отметке отложения.
//
Функция ЗаявкиНаВизеАгента(Знач ПользовательАгента, Знач ИмяОбъекта, Знач Лимит,
	Знач СсылкАгент, Знач ВключаяОтложенных = Ложь)

	СтрокиКандидатов = СтрокиКандидатовНаВизе(ИмяОбъекта);

	Отложенные = Новый Соответствие;
	ХешиОтпечатков = Новый Соответствие;
	ЗаявкиКандидатов = ЗаявкиИзСтрок(СтрокиКандидатов);
	Если ЗаявкиКандидатов.Количество() > 0 И ЗначениеЗаполнено(СсылкАгент) Тогда
		Отложенные = ar_AuditЗащищённыйРежим.ОтложенныеПредметыПривилегированно(
			СсылкАгент, ЗаявкиКандидатов);
		Если Отложенные.Количество() > 0 Тогда
			ХешиОтпечатков = ХешиМоделейЗаявок(КлючиСоответствия(Отложенные));
		КонецЕсли;
	КонецЕсли;

	Возврат СтрокиСВизойАгента(СтрокиКандидатов, ПользовательАгента, Лимит,
		Отложенные, ХешиОтпечатков, ВключаяОтложенных);

КонецФункции

// Настройка-булево из ar_Настройки в Булево (ядро может вернуть Строку).
Функция НастройкаИстинна(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Возврат Текст = "истина" Или Текст = "да" Или Текст = "1" Или Текст = "yes";
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Дата начала обработки заявок агентом из настройки пакета
// НСИДатаНачалаОбработкиЗаявок (agentrunner-41): тип Дата - как есть; строка -
// разбор «ДД.ММ.ГГГГ» через БСП СтроковыеФункцииКлиентСервер.СтрокаВДату,
// строка из ровно 8 цифр («ГГГГММДД») - платформенным Дата(); пусто, прочие
// типы и неразборчивые значения - 01.11.2026. Неверная настройка ошибкой не
// считается: агент продолжает работу от даты по умолчанию - без исключения
// и записи в журнал. Кэш сеанса настройки - внутри ar_Настройки.
//
// Возвращаемое значение:
//  Дата - начало дня, начиная с которого отбираются заявки (по дате документа).
//
Функция ДатаНачалаОбработкиЗаявок()

	Значение = ar_Настройки.ЗначениеНастройки("НСИДатаНачалаОбработкиЗаявок", "01.11.2026");

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
		Результат = СтроковыеФункцииКлиентСервер.СтрокаВДату(Текст);
		Если Не ЗначениеЗаполнено(Результат)
			И СтрДлина(Текст) = 8
			И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
			Попытка
				Результат = Дата(Текст);
			Исключение
				Результат = Дата(1, 1, 1);
			КонецПопытки;
		КонецЕсли;
	Иначе
		Результат = Дата(1, 1, 1);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Дата(2026, 11, 1);
	КонецЕсли;

	Возврат НачалоДня(Результат);

КонецФункции

#КонецОбласти

#Область МоделиИЗначения

// Нормализация значения для JSON-ответа и хеша (спека п. 10): примитивы - как
// есть; ссылки - Структура {presentation, ref}; коллекции - рекурсивно;
// несериализуемые (хранилища, двоичные данные) - строка «<не выводится>».
//
// Параметры:
//  Значение - Произвольный - значение из модели.
//
// Возвращаемое значение:
//  Произвольный - JSON-безопасное значение (Неопределено сериализуется как null).
//
Функция НормализоватьЗначение(Знач Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Копия.Вставить(КлючИЗначение.Ключ, НормализоватьЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда
		Копия = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Копия.Вставить(КлючИЗначение.Ключ, НормализоватьЗначение(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Копия = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Копия.Добавить(НормализоватьЗначение(Элемент));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Значение) Тогда
		Возврат ПараПредставлениеИСсылка(Значение);
	КонецЕсли;

	Возврат "<не выводится>";

КонецФункции

// Ссылка в JSON-виде: представление и навигационная ссылка (спека п. 9).
Функция ПараПредставлениеИСсылка(Знач Ссылка)

	Пара = Новый Структура;
	Пара.Вставить("presentation", Строка(Ссылка));
	Пара.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Ссылка));
	Возврат Пара;

КонецФункции

// Представление значения для ответа (поля header, presentation полей): строки
// и числа - как есть, ссылки и прочее - Строка(), Неопределено - null.
Функция ЗначениеВСтрокуДляОтвета(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Совпадают ли нормализованные значения (before/after полей): сравнение через
// ar_JSON - единый критерий для скаляров и пар {presentation, ref}.
Функция ЗначенияСовпадают(Знач Первое, Знач Второе)

	Если Первое = Неопределено И Второе = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Первое = Неопределено Или Второе = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Первое) = ar_JSON.ВЗначениеJSON(Второе);

КонецФункции

// SHA-256 строки в UTF-8 (hex) - приём ar_ИнструментыПакеты.ХешМанифеста:
// ПолучитьДвоичныеДанныеИзСтроки -> ХешированиеДанных -> ПолучитьHexСтроку.
Функция ХешСтрокиSHA256(Знач ИсходнаяСтрока)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, КодировкаТекста.UTF8, Ложь);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти

#Область АргументыИОшибки

// Разбирает JSON-строку аргументов инструмента в Соответствие.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; Неопределено при пустом входе или
//  ошибке разбора JSON.
//
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ar_JSON.ИзJSON(АргументыJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает значение поля из Соответствия аргументов с дефолтом при отсутствии.
Функция ЗначениеИзКоллекции(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;

	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Строка из строки ТЧ-подобной коллекции (Структура или Соответствие).
Функция ЗначениеСтрокиКоллекции(Знач СтрокаКоллекции, Знач Ключ)

	Если ТипЗнч(СтрокаКоллекции) = Тип("Структура") Тогда
		Значение = Неопределено;
		СтрокаКоллекции.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(СтрокаКоллекции) = Тип("Соответствие") Тогда
		Возврат СтрокаКоллекции.Получить(Ключ);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Формирует JSON-строку ошибки-observation: {"error": <код>, "message": <текст>}
// (спека п. 2: исключения наружу не выходят).
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Сообщение - Строка - текст для модели и оператора (может быть пустым).
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ОшибкаИнструмента(Знач КодОшибки, Знач Сообщение = "")

	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("message", ?(Сообщение = Неопределено, "", Сообщение));
	Возврат ar_JSON.ВЗначениеJSON(Объект);

КонецФункции

#КонецОбласти

#КонецОбласти
