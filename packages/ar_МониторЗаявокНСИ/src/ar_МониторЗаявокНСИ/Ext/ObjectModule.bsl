////////////////////////////////////////////////////////////////////////////////
// Внешний отчет «Монитор заявок НСИ» (agentrunner-251): монитор нештатных
// ситуаций AgentRunner в обработке заявок НСИ. Отчет только читает данные
// (регистры ядра и пакета НСИ прямыми запросами) и ничего не исправляет;
// вызовы общих модулей расширения и пакета НСИ запрещены спекой (безопасный
// режим, независимость от версии расширения).
//
// Устройство (спека п. 2): ПриКомпоновкеРезультата строит таблицу «Проблемы»
// (один пакетный запрос + проверки настроек в коде; визы этапов проверяются
// одним отдельным запросом - ссылку по GUID язык запросов построить не умеет)
// и выводит ее через СКД, набор данных «объект» «Проблемы» - см. шаблон
// ОсновнаяСхемаКомпоновкиДанных. Окно ошибок (запуски и служебный лог) -
// с последнего формирования отчета или за указанный период: переключатель
// «Ошибки с последнего запуска» (отметка формирования - в хранилище общих
// настроек, образец - sd_МониторингЖР). Условия проверок повторяют код ядра и пакета:
// места сверки перечислены в mcp.md задачи ([P2], [P3]).

#Область ПрограммныйИнтерфейс

// Регистрационные сведения для подсистемы БСП «Дополнительные отчеты и
// обработки» (спека п. 1): глобальный дополнительный отчет. Обязательна
// команда открытия формы - без нее после регистрации отчет не вызвать
// (урок agentrunner-224).
//
// Возвращаемое значение:
//  Структура - см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
	ПараметрыРегистрации.Версия = "1.3.4";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Монитор заявок НСИ AgentRunner'");
	ПараметрыРегистрации.Информация   =
		НСтр("ru = 'Нештатные ситуации AgentRunner в обработке заявок НСИ: заявки, не взятые в
			| работу, зависшие запуски, молчащая очередь, ручной разбор, распознавание (OCR),
			| ошибки и кривые настройки. Отчёт только читает данные и ничего не исправляет;
			| рассчитан на администратора - регистры AgentRunner ролям расширения не выданы,
			| без прав строки не выводятся. Подключается через «Дополнительные отчеты и
			| обработки», вид - дополнительный отчет раздела.'");

	// Отчет только читает данные - ограничений безопасного режима не нарушает (спека п. 2).
	ПараметрыРегистрации.БезопасныйРежим = Истина;

	// Команда запуска отчета (урок agentrunner-224): БСП создает пункт открытия формы.
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Монитор заявок НСИ AgentRunner'");
	НоваяКоманда.Идентификатор        = "ar_ОткрытьОтчет";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Формирование отчета (спека п. 2): данные всех проверок собираются одним
// пакетным запросом, настройки проверяются в коде, строки «Проблемы» выводятся
// через СКД (набор данных «объект»).
//
// Параметры:
//  ДокументРезультат    - ТабличныйДокумент - результат отчета.
//  ДанныеРасшифровки    - ДанныеРасшифровкиКомпоновкиДанных - данные расшифровки.
//  СтандартнаяОбработка - Булево - стандартное формирование (отключается).
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Пороги = ПорогиОтчета(Настройки.ПараметрыДанных);

	ТаблицаПроблем = НоваяТаблицаПроблем();
	СобратьПроблемы(ТаблицаПроблем, Пороги);

	ВнешниеНаборыДанных = Новый Структура("Проблемы", ТаблицаПроблем);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сбор проблем всех категорий (спека п. 5). Части пакетного запроса:
// 0 - заявки-кандидаты очереди, 1 - запуски агентов НСИ, 2 - события свипера,
// 3 - последние тики очереди, 4 - захваты и отложения, 5 - очередь распознавания,
// 6/7 - ошибки лога (группы и тексты), 8 - агенты НСИ, 9/10 - настройки пакета.
//
// Параметры:
//  ТаблицаПроблем - ТаблицаЗначений - приемник строк.
//  Пороги         - Структура - пороги проверок (ПорогиОтчета).
//
Процедура СобратьПроблемы(ТаблицаПроблем, Пороги)

	СекундВЧасе = 3600;
	ТекущийМомент = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстПакетногоЗапроса();
	Запрос.УстановитьПараметр("ГраницаОшибок", ГраницаОшибокОтчета(ТекущийМомент, Пороги));
	// Штатное удержание файла распознавания - 2 ч (МаксОжиданиеРаспознаванияЧасов пакета).
	Запрос.УстановитьПараметр("ГраницаУдержанияФайлов", ТекущийМомент - МаксОжиданиеРаспознаванияЧасов() * СекундВЧасе);
	ГраницаОжиданияРаспознавания = ТекущийМомент - Пороги.ПорогРаспознаванияЧасов * СекундВЧасе;
	Запрос.УстановитьПараметр("ГраницаОжиданияРаспознавания", ГраницаОжиданияРаспознавания);
	Запрос.УстановитьПараметр("ИсключенныеВИС", СсылкиИсключенныхВИС());
	Запрос.УстановитьПараметр("РасширенияРаспознавания", РасширенияРаспознавания());
	// 1.3.4: файл больше предела распознавания заявку не держит (ar_ПакетНСИ 2.5.94).
	Запрос.УстановитьПараметр("ПределРазмераРаспознавания", ПредельныйРазмерФайлаРаспознавания());

	Результаты = Запрос.ВыполнитьПакет();

	НастройкиПоКлючам = НастройкиПоКлючамПакета(Результаты[9], Результаты[10]);
	ДатаНачалаОбработки = РазборДатыНачалаОбработки(НастройкиПоКлючам);

	ДобавитьПроблемыЗаявок(ТаблицаПроблем, Пороги, Результаты[0], ДатаНачалаОбработки);
	ДобавитьПроблемыЗапусков(ТаблицаПроблем, Пороги, Результаты[1], Результаты[2]);
	ДобавитьПроблемыТиков(ТаблицаПроблем, Пороги, Результаты[3], Результаты[8]);
	ДобавитьПроблемыЗахватов(ТаблицаПроблем, Пороги, Результаты[4]);
	ДобавитьПроблемыОтложенных(ТаблицаПроблем, Пороги, Результаты[4]);
	ДобавитьПередачиНаРучнойРазбор(ТаблицаПроблем, Результаты[4]);
	ДобавитьПроблемыРаспознавания(ТаблицаПроблем, Результаты[5]);
	ДобавитьПроблемыОшибок(ТаблицаПроблем, Результаты[6], Результаты[7]);
	ДобавитьПроблемыКонфигурации(ТаблицаПроблем, Результаты[8], ДатаНачалаОбработки);
	ПроверитьВизыЭтапов(ТаблицаПроблем, НастройкиПоКлючам);

	// Отметка формирования - старт окна «Ошибки с последнего запуска» в следующий раз.
	ЗаписатьМоментФормирования(ТекущийМомент);

КонецПроцедуры

// Категория 1 «Не берется в работу» (спека п. 5.1): заявка на активной визе
// агента НСИ без решения, без захвата и отложения, не в терминальном статусе;
// возраст считается от даты заявки. В «Детали» - почему очередь ее не видит,
// по тем же условиям, что СтрокиКандидатовНаВизе пакета НСИ.
//
// Параметры:
//  ТаблицаПроблем      - ТаблицаЗначений - приемник строк.
//  Пороги              - Структура - пороги проверок.
//  РезультатЗаявок     - РезультатЗапроса - часть 0 пакетного запроса.
//  ДатаНачалаОбработки - Структура - разбор настройки даты начала обработки.
//
Процедура ДобавитьПроблемыЗаявок(ТаблицаПроблем, Пороги, РезультатЗаявок, ДатаНачалаОбработки)

	Категория = НСтр("ru = 'Не берётся в работу'");
	Внимание = НСтр("ru = 'Внимание'");
	Выборка = РезультатЗаявок.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВозрастЧасов(Выборка.ДатаЗаявки) <= Пороги.ПорогНеБеретсяЧасов Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание,
			Строка(Выборка.Заявка), Выборка.Заявка, "", Выборка.ДатаЗаявки,
			ПричинаНеВзята(Выборка, ДатаНачалаОбработки));
	КонецЦикла;

КонецПроцедуры

// Категория 2 «Запуск завис / LLM не отвечает» (спека п. 5.2): запуски
// «Выполняется» без свежего пульса, ожидание подтверждения дольше порога,
// ошибки и прерывания за период. Событие свипера добавляется к деталям своей
// строки запуска; без такой строки в части 1 событие дает строку само.
//
// Параметры:
//  ТаблицаПроблем    - ТаблицаЗначений - приемник строк.
//  Пороги            - Структура - пороги проверок.
//  РезультатЗапусков - РезультатЗапроса - часть 1 пакетного запроса.
//  РезультатСобытий  - РезультатЗапроса - часть 2 пакетного запроса.
//
Процедура ДобавитьПроблемыЗапусков(ТаблицаПроблем, Пороги, РезультатЗапусков, РезультатСобытий)

	Категория = НСтр("ru = 'Запуск завис / LLM не отвечает'");
	Критично = НСтр("ru = 'Критично'");
	ТекущийМомент = ТекущаяДатаСеанса();

	СобытияСвипера = ИдентификаторыСобытийСвипера(РезультатСобытий);
	ПоказанныеЗапуски = Новый Соответствие;
	Выборка = РезультатЗапусков.Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификатор = СокрЛП(Выборка.ИдентификаторЗапуска);
		Детали = ДеталиПроблемыЗапуска(Выборка, Пороги, ТекущийМомент,
			СобытияСвипера.Получить(Идентификатор) <> Неопределено);
		Если ПустаяСтрока(Детали) Тогда
			Продолжить;
		КонецЕсли;
		ПоказанныеЗапуски.Вставить(Идентификатор, Истина);
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично, ОбъектПроблемыЗапуска(Выборка),
			Выборка.Заявка, Строка(Выборка.Агент),
			?(ЗначениеЗаполнено(Выборка.ПоследнийПульс), Выборка.ПоследнийПульс, Выборка.СтартовалВ),
			Детали);
	КонецЦикла;

	// События свипера без строки запуска (статус уже сменился) - отдельные строки.
	ДобавитьПропущенныеСобытияСвипера(ТаблицаПроблем, Категория, Критично,
		РезультатСобытий, ПоказанныеЗапуски);

КонецПроцедуры

// Идентификаторы запусков, прерванных свипером за период, с моментами событий.
//
// Параметры:
//  РезультатСобытий - РезультатЗапроса - часть 2 пакетного запроса.
//
// Возвращаемое значение:
//  Соответствие - ИдентификаторЗапуска → Момент события.
//
Функция ИдентификаторыСобытийСвипера(РезультатСобытий)

	События = Новый Соответствие;
	ВыборкаСобытий = РезультатСобытий.Выбрать();
	Пока ВыборкаСобытий.Следующий() Цикл
		События.Вставить(СокрЛП(ВыборкаСобытий.ИдентификаторЗапуска), ВыборкаСобытий.Момент);
	КонецЦикла;
	Возврат События;

КонецФункции

// Детали проблемы запуска (спека п. 5.2): пустая строка - запуск живой и
// строки не требует. Порог пульса ядра - 90 с (HeartbeatПорогСек); здесь
// порог в минутах между тиками планировщика, чтобы не флажить живой запуск
// между тиками (спека п. 4). ОшибкаВыполнения / Прерван отбираются запросом
// в окне ошибок и выводятся всегда.
//
// Параметры:
//  Выборка         - ВыборкаИзРезультатаЗапроса - строка части 1 пакетного запроса.
//  Пороги          - Структура - пороги проверок.
//  ТекущийМомент   - Дата - момент формирования отчета.
//  ПрерванСвипером - Булево - есть событие ЗапускПрерванСвипером у запуска.
//
// Возвращаемое значение:
//  Строка - детали проблемы; пустая - живой запуск.
//
Функция ДеталиПроблемыЗапуска(Выборка, Пороги, ТекущийМомент, ПрерванСвипером)

	СекундВМинуте = 60;
	СекундВЧасе = 3600;
	Если Выборка.Статус = Перечисления.ar_СтатусЗапуска.Выполняется Тогда
		Если ЗначениеЗаполнено(Выборка.ПоследнийПульс)
			И Выборка.ПоследнийПульс >= ТекущийМомент - Пороги.ПорогПульсаМинут * СекундВМинуте Тогда
			Возврат "";
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'этап: %1; шагов: %2; последний пульс %3'"),
			?(ПустаяСтрока(Выборка.Этап), "-", СокрЛП(Выборка.Этап)), Выборка.ШаговВсего,
			ФорматВремени(Выборка.ПоследнийПульс));
	ИначеЕсли Выборка.Статус = Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения Тогда
		Если ЗначениеЗаполнено(Выборка.ПоследнийПульс)
			И Выборка.ПоследнийПульс >= ТекущийМомент - Пороги.ПорогПодтвержденияЧасов * СекундВЧасе Тогда
			Возврат "";
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'ожидание подтверждения %1 ч; этап: %2'"),
			ВозрастЧасов(Выборка.ПоследнийПульс),
			?(ПустаяСтрока(Выборка.Этап), "-", СокрЛП(Выборка.Этап)));
	Иначе
		// ОшибкаВыполнения / Прерван: отбираются запросом в окне ошибок.
		Детали = СтрШаблон(НСтр("ru = 'статус: %1; завершён %2'"),
			Строка(Выборка.Статус), ФорматВремени(Выборка.ЗавершенВ));
		Если ПрерванСвипером Тогда
			Детали = Детали + НСтр("ru = '; прерван свипером (завис без пульса)'");
		КонецЕсли;
		Возврат Детали;
	КонецЕсли;

КонецФункции

// Строки для событий свипера, чьи запуски не попали в часть 1 пакетного
// запроса (статус запуска уже сменился).
//
// Параметры:
//  ТаблицаПроблем    - ТаблицаЗначений - приемник строк.
//  Категория         - Строка - категория проверки.
//  Критично          - Строка - важность строки.
//  РезультатСобытий  - РезультатЗапроса - часть 2 пакетного запроса.
//  ПоказанныеЗапуски - Соответствие - идентификаторы уже выведенных запусков.
//
Процедура ДобавитьПропущенныеСобытияСвипера(ТаблицаПроблем, Категория, Критично,
	РезультатСобытий, ПоказанныеЗапуски)

	ВыборкаСобытий = РезультатСобытий.Выбрать();
	Пока ВыборкаСобытий.Следующий() Цикл
		Идентификатор = СокрЛП(ВыборкаСобытий.ИдентификаторЗапуска);
		Если ПоказанныеЗапуски.Получить(Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично,
			СтрШаблон(НСтр("ru = 'Запуск %1'"), Идентификатор),
			ВыборкаСобытий.Заявка, "", ВыборкаСобытий.Момент,
			НСтр("ru = 'запуск прерван свипером (завис без пульса)'"));
	КонецЦикла;

КонецПроцедуры

// Категория 3 «Очередь не тикает» (спека п. 5.3): у активного агента НСИ
// последний тик очереди (queue_tick) старше порога или отсутствует; привязка
// тика к агенту - как в ar_ПредметыАгентов.ПоследниеТикиОчереди (строкой).
//
// Параметры:
//  ТаблицаПроблем   - ТаблицаЗначений - приемник строк.
//  Пороги           - Структура - пороги проверок.
//  РезультатТиков   - РезультатЗапроса - часть 3 пакетного запроса.
//  РезультатАгентов - РезультатЗапроса - часть 8 пакетного запроса.
//
Процедура ДобавитьПроблемыТиков(ТаблицаПроблем, Пороги, РезультатТиков, РезультатАгентов)

	Категория = НСтр("ru = 'Очередь не тикает'");
	Критично = НСтр("ru = 'Критично'");

	ПоследниеТики = Новый Соответствие;
	ВыборкаТиков = РезультатТиков.Выбрать();
	Пока ВыборкаТиков.Следующий() Цикл
		ПоследниеТики.Вставить(ВыборкаТиков.АгентНавСсылка, ВыборкаТиков.ПоследнийТик);
	КонецЦикла;

	СекундВМинуте = 60;
	ГраницаТика = ТекущаяДатаСеанса() - Пороги.ПорогТикаМинут * СекундВМинуте;
	ВыборкаАгентов = РезультатАгентов.Выбрать();
	Пока ВыборкаАгентов.Следующий() Цикл
		ПоследнийТик = ПоследниеТики.Получить(ПолучитьНавигационнуюСсылку(ВыборкаАгентов.Агент));
		Если ПоследнийТик <> Неопределено И ПоследнийТик >= ГраницаТика Тогда
			Продолжить;
		КонецЕсли;
		Если ПоследнийТик = Неопределено Тогда
			Детали = НСтр("ru = 'записей queue_tick нет'");
			МоментПроблемы = Дата(1, 1, 1);
		Иначе
			Детали = СтрШаблон(НСтр("ru = 'последний тик %1'"), ФорматВремени(ПоследнийТик));
			МоментПроблемы = ПоследнийТик;
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично, Строка(ВыборкаАгентов.Агент),
			Неопределено, Строка(ВыборкаАгентов.Агент), МоментПроблемы, Детали);
	КонецЦикла;

КонецПроцедуры

// Категория 4 «В работе без прогресса» (спека п. 5.4): захват предмета старше
// порога, при котором запуск по нему не выполняется со свежим пульсом.
// Исключенные предметы (ar_Исключён) выводятся отдельными строками.
//
// Параметры:
//  ТаблицаПроблем    - ТаблицаЗначений - приемник строк.
//  Пороги            - Структура - пороги проверок.
//  РезультатЗахватов - РезультатЗапроса - часть 4 пакетного запроса.
//
Процедура ДобавитьПроблемыЗахватов(ТаблицаПроблем, Пороги, РезультатЗахватов)

	Категория = НСтр("ru = 'В работе без прогресса'");
	Внимание = НСтр("ru = 'Внимание'");
	СекундВМинуте = 60;
	ГраницаПульса = ТекущаяДатаСеанса() - Пороги.ПорогПульсаМинут * СекундВМинуте;

	Выборка = РезультатЗахватов.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Отложен Тогда
			Продолжить; // категория 5
		КонецЕсли;
		ДеталиХвост = СтрШаблон(НСтр("ru = '; сбоев подряд: %1; причина: %2'"),
			Выборка.СбоевПодряд,
			?(ПустаяСтрока(Выборка.ПоследняяПричина), "-", СокрЛП(Выборка.ПоследняяПричина)));
		Если Выборка.Исключен Тогда
			ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание, Строка(Выборка.Заявка),
				Выборка.Заявка, Строка(Выборка.Агент), Выборка.Захвачен,
				НСтр("ru = 'исключён из очереди'") + ДеталиХвост);
			Продолжить;
		КонецЕсли;
		Если ВозрастЧасов(Выборка.Захвачен) <= Пороги.ПорогБезПрогрессаЧасов Тогда
			Продолжить;
		КонецЕсли;
		// Живой запуск: «Выполняется» с пульсом моложе порога пульса (как ядро).
		Если Выборка.СтатусЗапуска = Перечисления.ar_СтатусЗапуска.Выполняется
			И ЗначениеЗаполнено(Выборка.ПульсЗапуска)
			И Выборка.ПульсЗапуска >= ГраницаПульса Тогда
			Продолжить;
		КонецЕсли;
		ДеталиЗапуска = ?(ЗначениеЗаполнено(Выборка.СтатусЗапуска),
			СтрШаблон(НСтр("ru = 'статус запуска: %1'"), Строка(Выборка.СтатусЗапуска)),
			НСтр("ru = 'записи о запуске по захвату нет'"));
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание, Строка(Выборка.Заявка),
			Выборка.Заявка, Строка(Выборка.Агент), Выборка.Захвачен, ДеталиЗапуска + ДеталиХвост);
	КонецЦикла;

КонецПроцедуры

// Категория 5 «Ручной разбор / отложено» (спека п. 5.5): отложенный предмет
// старше порога от момента отложения. Передача на ручной разбор - причина,
// отличная от авто-повтора актуализации (service_unavailable:*, возвращается
// пакетом сам) - показывается, только если решение визы все еще пустое;
// авто-повтор тоже ждет дольше порога. Формат причины у пакета не единый:
// префикс «handover:» пишут только пути автоактуализации, ручная передача
// агента - произвольный текст (agentrunner-285), поэтому признак передачи -
// «не service_unavailable:».
//
// Параметры:
//  ТаблицаПроблем    - ТаблицаЗначений - приемник строк.
//  Пороги            - Структура - пороги проверок.
//  РезультатЗахватов - РезультатЗапроса - часть 4 пакетного запроса.
//
Процедура ДобавитьПроблемыОтложенных(ТаблицаПроблем, Пороги, РезультатЗахватов)

	Категория = НСтр("ru = 'Ручной разбор / отложено'");
	Внимание = НСтр("ru = 'Внимание'");

	Выборка = РезультатЗахватов.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Отложен Тогда
			Продолжить;
		КонецЕсли;
		Если ВозрастЧасов(Выборка.ОтложенВ) <= Пороги.ПорогРучногоРазбораЧасов Тогда
			Продолжить;
		КонецЕсли;
		Причина = СокрЛП(Выборка.ОтложенПричина);
		Если Не ЭтоПовторАктуализации(Причина) И Не ПустоеРешениеВизы(Выборка.РешениеВизы) Тогда
			Продолжить; // решение уже дано - заявка больше не на ручном разборе
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание, Строка(Выборка.Заявка),
			Выборка.Заявка, Строка(Выборка.Агент), Выборка.ОтложенВ,
			СтрШаблон(НСтр("ru = 'причина отложения: %1'"), ОбрезатьТекст(Причина, 200)));
	КонецЦикла;

КонецПроцедуры

// Раздел «Передано на ручной разбор» (решение человека 26.10): заявки, переданные
// агентом на ручной разбор, видны сразу с момента передачи, без порога ожидания;
// строка висит, пока решение активной визы пустое и заявка не исполнена и не
// закрыта (отбор в части 4 пакетного запроса). Признак передачи - отложение
// с причиной, отличной от авто-повтора актуализации (service_unavailable:*
// возвращается пакетом сам): формат причины у пакета не единый, префикс
// «handover:» пишут только пути автоактуализации, ручная передача агента -
// произвольный текст (agentrunner-285). Не заменяет категорию «Ручной разбор /
// отложено» - та сигнализирует о передачах, зависших дольше порога.
//
// Параметры:
//  ТаблицаПроблем    - ТаблицаЗначений - приемник строк.
//  РезультатЗахватов - РезультатЗапроса - часть 4 пакетного запроса.
//
Процедура ДобавитьПередачиНаРучнойРазбор(ТаблицаПроблем, РезультатЗахватов)

	Категория = НСтр("ru = 'Передано на ручной разбор'");
	Внимание = НСтр("ru = 'Внимание'");

	Выборка = РезультатЗахватов.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Отложен Тогда
			Продолжить;
		КонецЕсли;
		Причина = СокрЛП(Выборка.ОтложенПричина);
		Если ЭтоПовторАктуализации(Причина) Тогда
			Продолжить; // авто-повтор ЕГР - не передача, заявка вернется в очередь сама
		КонецЕсли;
		Если Не ПустоеРешениеВизы(Выборка.РешениеВизы) Тогда
			Продолжить; // решение уже дано - ручной разбор закончен
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание, Строка(Выборка.Заявка),
			Выборка.Заявка, Строка(Выборка.Агент), Выборка.ОтложенВ,
			СтрШаблон(НСтр("ru = 'причина отложения: %1'"), ОбрезатьТекст(Причина, 200)));
	КонецЦикла;

КонецПроцедуры

// Категория 6 «Распознавание (OCR)» (спека п. 5.6): строки очереди
// распознавания в живых статусах queued/processing дольше порога.
//
// Параметры:
//  ТаблицаПроблем - ТаблицаЗначений - приемник строк.
//  РезультатOCR   - РезультатЗапроса - часть 5 пакетного запроса.
//
Процедура ДобавитьПроблемыРаспознавания(ТаблицаПроблем, РезультатOCR)

	Категория = НСтр("ru = 'Распознавание (OCR)'");
	Внимание = НСтр("ru = 'Внимание'");
	Выборка = РезультатOCR.Выбрать();
	Пока Выборка.Следующий() Цикл
		Детали = СтрШаблон(НСтр("ru = 'владелец: %1; статус: %2; попыток: %3'"),
			ОбрезатьТекст(Выборка.Владелец, 200), СокрЛП(Выборка.СтатусРаспознавания), Выборка.Попыток);
		Если Не ПустаяСтрока(Выборка.ПоследняяОшибка) Тогда
			Детали = Детали + СтрШаблон(НСтр("ru = '; ошибка: %1'"),
				ОбрезатьТекст(Выборка.ПоследняяОшибка, 300));
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание,
			ОбрезатьТекст(Выборка.Файл, 200), Неопределено, "", Выборка.ПоставленоВ, Детали);
	КонецЦикла;

КонецПроцедуры

// Категория 7 «Ошибки» (спека п. 5.7): записи служебного лога с уровнем
// «Ошибка» за период, сгруппированные по источнику и событию; текст берется
// из последней записи группы (выборка текстов упорядочена по моменту убывания).
//
// Параметры:
//  ТаблицаПроблем   - ТаблицаЗначений - приемник строк.
//  РезультатГрупп   - РезультатЗапроса - часть 6 пакетного запроса (группы).
//  РезультатТекстов - РезультатЗапроса - часть 7 пакетного запроса (тексты).
//
Процедура ДобавитьПроблемыОшибок(ТаблицаПроблем, РезультатГрупп, РезультатТекстов)

	ПоследниеТексты = Новый Соответствие;
	ВыборкаТекстов = РезультатТекстов.Выбрать();
	Пока ВыборкаТекстов.Следующий() Цикл
		КлючГруппы = ВыборкаТекстов.Источник + "|" + ВыборкаТекстов.Событие;
		Если ПоследниеТексты.Получить(КлючГруппы) = Неопределено Тогда
			ПоследниеТексты.Вставить(КлючГруппы, ВыборкаТекстов.Текст);
		КонецЕсли;
	КонецЦикла;

	Категория = НСтр("ru = 'Ошибки'");
	Внимание = НСтр("ru = 'Внимание'");
	Выборка = РезультатГрупп.Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючГруппы = Выборка.Источник + "|" + Выборка.Событие;
		ТекстПоследней = ПоследниеТексты.Получить(КлючГруппы);
		Если ТекстПоследней = Неопределено Тогда
			ТекстПоследней = ""; // группа не попала в ограничение ПЕРВЫЕ 300
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание,
			ОбрезатьТекст(Выборка.Источник, 200), Неопределено, "", Выборка.ПоследнийМомент,
			СтрШаблон(НСтр("ru = 'событие: %1; записей: %2; последняя: %3'"),
				СокрЛП(Выборка.Событие), Выборка.Количество, ОбрезатьТекст(ТекстПоследней, 300)));
	КонецЦикла;

КонецПроцедуры

// Категория 8 «Конфигурация» (спека п. 5.8а-в): нет активных агентов НСИ,
// неполные реквизиты агентов, настройка даты начала обработки - не дата
// (критично) или в будущем (внимание).
//
// Параметры:
//  ТаблицаПроблем      - ТаблицаЗначений - приемник строк.
//  РезультатАгентов    - РезультатЗапроса - часть 8 пакетного запроса.
//  ДатаНачалаОбработки - Структура - разбор настройки даты начала обработки.
//
Процедура ДобавитьПроблемыКонфигурации(ТаблицаПроблем, РезультатАгентов, ДатаНачалаОбработки)

	Категория = НСтр("ru = 'Конфигурация'");
	Критично = НСтр("ru = 'Критично'");
	Внимание = НСтр("ru = 'Внимание'");
	АгентовНет = Истина;

	Выборка = РезультатАгентов.Выбрать();
	Пока Выборка.Следующий() Цикл
		АгентовНет = Ложь;
		ПроблемыАгента = Новый Массив;
		Если Не ЗначениеЗаполнено(Выборка.Пользователь) Тогда
			ПроблемыАгента.Добавить(НСтр("ru = 'не задан пользователь - очередь агента всегда пуста'"));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Провайдер) Тогда
			ПроблемыАгента.Добавить(НСтр("ru = 'не задан LLM-провайдер'"));
		КонецЕсли;
		Если ПустаяСтрока(Выборка.Модель) Тогда
			ПроблемыАгента.Добавить(НСтр("ru = 'не задана модель'"));
		КонецЕсли;
		Если ПроблемыАгента.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично, Строка(Выборка.Агент),
			Неопределено, Строка(Выборка.Агент), Дата(1, 1, 1),
			СтрСоединить(ПроблемыАгента, "; "));
	КонецЦикла;

	Если АгентовНет Тогда
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично,
			НСтр("ru = 'Агенты AgentRunner'"), Неопределено, "", Дата(1, 1, 1),
			НСтр("ru = 'нет активного агента с очередью пакета НСИ (ar_ПакетИсточник = nsi) -
				| заявки НСИ не берутся в работу'"));
	КонецЕсли;

	// Настройка даты начала обработки: значение ядра setting/default - норма,
	// invalid - критично (инцидент, спрятавший все заявки); дата в будущем -
	// внимание: заявки с датой документа до нее не берутся.
	НастройкаДаты = НСтр("ru = 'Настройка НСИДатаНачалаОбработкиЗаявок'");
	Если ДатаНачалаОбработки.Источник = "invalid" Тогда
		ДобавитьПроблему(ТаблицаПроблем, Категория, Критично, НастройкаДаты, Неопределено, "",
			Дата(1, 1, 1),
			СтрШаблон(НСтр("ru = 'значение «%1» не дата - применяется 01.11.2026'"),
				ДатаНачалаОбработки.ЗначениеИсходное));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаНачалаОбработки.Дата)
		И ДатаНачалаОбработки.Дата > ТекущаяДатаСеанса() Тогда
		ДобавитьПроблему(ТаблицаПроблем, Категория, Внимание, НастройкаДаты, Неопределено, "",
			Дата(1, 1, 1),
			СтрШаблон(НСтр("ru = 'дата начала обработки %1 в будущем - заявки с датой документа
				| до неё не берутся в работу'"), Формат(ДатаНачалаОбработки.Дата, "ДФ=дд.ММ.гггг")));
	КонецЕсли;

КонецПроцедуры

// Проверка виз этапов (спека п. 5.8г): настройка задает GUID визы этапа,
// но элемента справочника бит_Визы с таким GUID в базе нет. Ссылки строятся
// по платформенному GUID (как СсылкаПоГуиду пакета), существование проверяется
// одним запросом. Настройка пустая или не GUID - считается незаполненной (норма).
//
// Параметры:
//  ТаблицаПроблем   - ТаблицаЗначений - приемник строк.
//  НастройкиПоКлючам - Соответствие - значения настроек пакета.
//
Процедура ПроверитьВизыЭтапов(ТаблицаПроблем, НастройкиПоКлючам)

	СсылкиЭтапов = Новый Соответствие;
	Для НомерЭтапа = 1 По 2 Цикл
		Гуид = ЗначениеНастройкиСтрокой(НастройкиПоКлючам, "НСИГУИДВизыЭтап" + Строка(НомерЭтапа));
		Если ПустаяСтрока(Гуид)
			Или Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Гуид) Тогда
			Продолжить;
		КонецЕсли;
		СсылкиЭтапов.Вставить(НомерЭтапа,
			Справочники.бит_Визы.ПолучитьСсылку(Новый УникальныйИдентификатор(Гуид)));
	КонецЦикла;
	Если СсылкиЭтапов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСсылок = Новый Массив;
	Для Каждого СсылкаЭтапа Из СсылкиЭтапов Цикл
		МассивСсылок.Добавить(СсылкаЭтапа.Значение);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Визы.Ссылка КАК Виза
		|ИЗ
		|	Справочник.бит_Визы КАК Визы
		|ГДЕ
		|	Визы.Ссылка В (&СсылкиВиз)";
	Запрос.УстановитьПараметр("СсылкиВиз", МассивСсылок);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Виза, Истина);
	КонецЦикла;

	Для Каждого СсылкаЭтапа Из СсылкиЭтапов Цикл
		Если Найденные.Получить(СсылкаЭтапа.Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПроблему(ТаблицаПроблем, НСтр("ru = 'Конфигурация'"), НСтр("ru = 'Критично'"),
			СтрШаблон(НСтр("ru = 'Настройка НСИГУИДВизыЭтап%1'"), СсылкаЭтапа.Ключ),
			Неопределено, "", Дата(1, 1, 1),
			НСтр("ru = 'визы с таким GUID в базе нет - очередь этапа не работает'"));
	КонецЦикла;

КонецПроцедуры

// Текст пакетного запроса, собирающего данные всех проверок
// (части перечислены в СобратьПроблемы; настройки - часть 10 - дописывает
// ТекстЗапросаНастроек ради лимита размера метода BSL LS).
//
// Возвращаемое значение:
//  Строка - текст пакетного запроса.
//
Функция ТекстПакетногоЗапроса()

	// Часть 0: заявки-кандидаты очереди (копия отбора СтрокиКандидатовНаВизе
	// пакета НСИ, без усечений очереди): активная виза агента НСИ, решение
	// пустое, не удалена; пометки - файлы распознавания, исключенные ВИС,
	// терминальный статус, захват и отложение; отбор проблем - в ИМЕЮЩИЕ.
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
	|	Визы.Объект КАК Заявка,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Файлы.Ссылка ЕСТЬ NULL
	|				ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ Файлы.ДатаСоздания
	|		КОНЕЦ) КАК ФайлНеИзвлеченС,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СоответствиеВИС.ВнешняяИнформационнаяСистема ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ИсключенаВИС,
	|	МИНИМУМ(Заявки.Дата) КАК ДатаЗаявки
	|ИЗ
	|	РегистрСведений.бит_УстановленныеВизы КАК Визы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
	|		ПО Визы.Объект = Заявки.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
	|		ПО Визы.Пользователь = Агенты.ar_Пользователь
	|			И Агенты.ar_Активен
	|			И Агенты.ar_БратьИзОчередиПакета
	|			И Агенты.ar_ПакетИсточник = ""nsi""
	|			И НЕ Агенты.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.sd_СоответствиеОбъектовВнешнихСистем КАК СоответствиеВИС
	|		ПО СоответствиеВИС.СсылкаБФ = Заявки.Ссылка
	|			И СоответствиеВИС.ВнешняяИнформационнаяСистема В (&ИсключенныеВИС)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы КАК Файлы
	|		ПО Файлы.ВладелецФайла = Заявки.Ссылка
	|			И НЕ Файлы.ПометкаУдаления
	|			И Файлы.СтатусИзвлеченияТекста = ЗНАЧЕНИЕ(Перечисление.СтатусыИзвлеченияТекстаФайлов.НеИзвлечен)
	|			И НЕ Файлы.Зашифрован
	|			И Файлы.Расширение В (&РасширенияРаспознавания)
	|			И Файлы.ДатаСоздания > &ГраницаУдержанияФайлов
	|			И Файлы.Размер <= &ПределРазмераРаспознавания
	|			И Файлы.ДатаМодификацииУниверсальная <> ДАТАВРЕМЯ(1, 1, 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК Статусы
	|		ПО Статусы.Объект = Заявки.Ссылка
	|			И Статусы.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.бит_ВидыСтатусовОбъектов.Статус)
	|			И Статусы.Статус В (ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена),
	|				ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.Закрыт))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ar_ПредметыАгентов КАК Захваты
	|		ПО Захваты.ar_Предмет = Заявки.Ссылка
	|ГДЕ
	|	Визы.АктивнаяВиза
	|	И Визы.Решение = ЗНАЧЕНИЕ(Справочник.бит_ВидыРешенийСогласования.ПустаяСсылка)
	|	И НЕ Заявки.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Визы.Объект
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Статусы.Объект ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) = 0
	|	И МАКСИМУМ(ВЫБОР
	|			КОГДА Захваты.ar_Предмет ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ Захваты.ar_Запуск
	|		КОНЕЦ) = """"
	|	И МАКСИМУМ(ВЫБОР
	|			КОГДА Захваты.ar_Отложен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) = 0
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаявки УБЫВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 1: запуски агентов НСИ в состояниях, требующих внимания.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
	|	Запуски.ar_ИдентификаторЗапуска КАК ИдентификаторЗапуска,
	|	Запуски.ar_Статус КАК Статус,
	|	Запуски.ar_СтартовалВ КАК СтартовалВ,
	|	Запуски.ar_ПоследнийПульс КАК ПоследнийПульс,
	|	Запуски.ar_ЗавершенВ КАК ЗавершенВ,
	|	Запуски.ar_ТекущийЭтап КАК Этап,
	|	Запуски.ar_ШаговВсего КАК ШаговВсего,
	|	ВЫРАЗИТЬ(Запуски.ar_Предмет КАК Документ.бит_мдм_ЗаявкаНаИзменение) КАК Заявка,
	|	Запуски.ar_АгентРеф КАК Агент
	|ИЗ
	|	РегистрСведений.ar_Запуски КАК Запуски
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
	|		ПО Запуски.ar_АгентРеф = Агенты.Ссылка
	|			И Агенты.ar_Активен
	|			И Агенты.ar_БратьИзОчередиПакета
	|			И Агенты.ar_ПакетИсточник = ""nsi""
	|			И НЕ Агенты.ПометкаУдаления
	|ГДЕ
	|	(Запуски.ar_Статус = ЗНАЧЕНИЕ(Перечисление.ar_СтатусЗапуска.Выполняется)
	|			ИЛИ Запуски.ar_Статус = ЗНАЧЕНИЕ(Перечисление.ar_СтатусЗапуска.ПриостановленДляПодтверждения))
	|		ИЛИ (Запуски.ar_Статус В (ЗНАЧЕНИЕ(Перечисление.ar_СтатусЗапуска.ОшибкаВыполнения),
	|				ЗНАЧЕНИЕ(Перечисление.ar_СтатусЗапуска.Прерван))
	|			И Запуски.ar_ЗавершенВ >= &ГраницаОшибок)
	|УПОРЯДОЧИТЬ ПО
	|	СтартовалВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 2: прерывания свипером за период ошибок.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
	|	События.ar_RunId КАК ИдентификаторЗапуска,
	|	События.ar_МоментВремени КАК Момент,
	|	ВЫРАЗИТЬ(Запуски.ar_Предмет КАК Документ.бит_мдм_ЗаявкаНаИзменение) КАК Заявка
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
	|		ПО Запуски.ar_ИдентификаторЗапуска = События.ar_RunId
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
	|		ПО Запуски.ar_АгентРеф = Агенты.Ссылка
	|			И Агенты.ar_Активен
	|			И Агенты.ar_БратьИзОчередиПакета
	|			И Агенты.ar_ПакетИсточник = ""nsi""
	|			И НЕ Агенты.ПометкаУдаления
	|ГДЕ
	|	События.ar_ТипСобытия = ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.ЗапускПрерванСвипером)
	|	И События.ar_МоментВремени >= &ГраницаОшибок
	|УПОРЯДОЧИТЬ ПО
	|	Момент УБЫВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 3: последние тики очереди по агентам (привязка строкой, как в ядре).
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
	|	Лог.ar_ОбъектСсылка КАК АгентНавСсылка,
	|	МАКСИМУМ(Лог.ar_Момент) КАК ПоследнийТик
	|ИЗ
	|	РегистрСведений.ar_СлужебныйЛог КАК Лог
	|ГДЕ
	|	Лог.ar_Источник = ""ar_ДиспетчерОчереди""
	|	И Лог.ar_Событие = ""queue_tick""
	|	И Лог.ar_ОбъектСсылка ПОДОБНО ""e1cib/data/Справочник.ar~_Агенты?ref=%"" СПЕЦСИМВОЛ ""~""
	|СГРУППИРОВАТЬ ПО
	|	Лог.ar_ОбъектСсылка
	|УПОРЯДОЧИТЬ ПО
	|	ПоследнийТик
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 4: захваты и отложения предметов агентов НСИ. Отложенные исполненные и закрытые
	|// заявки не выбираются: разбор по ним окончен, а строки занимали бы лимит ПЕРВЫЕ.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
	|	Захваты.ar_Агент КАК Агент,
	|	ВЫРАЗИТЬ(Захваты.ar_Предмет КАК Документ.бит_мдм_ЗаявкаНаИзменение) КАК Заявка,
	|	Захваты.ar_Запуск КАК ИдентификаторЗапуска,
	|	Захваты.ar_Захвачен КАК Захвачен,
	|	Захваты.ar_СбоевПодряд КАК СбоевПодряд,
	|	Захваты.ar_ПоследняяПричина КАК ПоследняяПричина,
	|	Захваты.ar_Исключён КАК Исключен,
	|	Захваты.ar_Отложен КАК Отложен,
	|	Захваты.ar_ОтложенВ КАК ОтложенВ,
	|	Захваты.ar_ОтложенПричина КАК ОтложенПричина,
	|	Запуски.ar_Статус КАК СтатусЗапуска,
	|	Запуски.ar_ПоследнийПульс КАК ПульсЗапуска,
	|	Визы.Решение КАК РешениеВизы
	|ИЗ
	|	РегистрСведений.ar_ПредметыАгентов КАК Захваты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
	|		ПО Захваты.ar_Агент = Агенты.Ссылка
	|			И Агенты.ar_Активен
	|			И Агенты.ar_БратьИзОчередиПакета
	|			И Агенты.ar_ПакетИсточник = ""nsi""
	|			И НЕ Агенты.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
	|		ПО Запуски.ar_ИдентификаторЗапуска = Захваты.ar_Запуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_УстановленныеВизы КАК Визы
	|		ПО Визы.Объект = Захваты.ar_Предмет
	|			И Визы.АктивнаяВиза
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК Статусы
	|		ПО Статусы.Объект = Захваты.ar_Предмет
	|			И Захваты.ar_Отложен
	|			И Статусы.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.бит_ВидыСтатусовОбъектов.Статус)
	|			И Статусы.Статус В (ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.ЗаявкаНаИзменение_Исполнена),
	|				ЗНАЧЕНИЕ(Справочник.бит_СтатусыОбъектов.Закрыт))
	|ГДЕ
	|	Захваты.ar_Предмет ССЫЛКА Документ.бит_мдм_ЗаявкаНаИзменение
	|	И (Захваты.ar_Запуск <> """" ИЛИ Захваты.ar_Отложен)
	|	И Статусы.Объект ЕСТЬ NULL
	|УПОРЯДОЧИТЬ ПО
	|	Захвачен УБЫВ
	|;";

	Возврат ТекстЗапроса + ТекстЗапросаСлужебныхВыборок();

КонецФункции

// Текст служебных частей пакетного запроса: очередь распознавания, журнал
// ошибок (группы и тексты), агенты НСИ (части 5-8 из СобратьПроблемы);
// настройки дописывает ТекстЗапросаНастроек. Выделена ради лимита размера
// метода BSL LS.
//
// Возвращаемое значение:
//  Строка - текст частей пакетного запроса.
//
Функция ТекстЗапросаСлужебныхВыборок()

	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 5: очередь распознавания, живые строки старше порога.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
	|	Очередь.ar_Файл КАК Файл,
	|	Очередь.ar_Владелец КАК Владелец,
	|	Очередь.ar_Статус КАК СтатусРаспознавания,
	|	Очередь.ar_ПоставленоВ КАК ПоставленоВ,
	|	Очередь.ar_Попыток КАК Попыток,
	|	Очередь.ar_ПоследняяОшибка КАК ПоследняяОшибка
	|ИЗ
	|	РегистрСведений.ar_ОчередьРаспознавания КАК Очередь
	|ГДЕ
	|	Очередь.ar_Статус В (""queued"", ""processing"")
	|	И Очередь.ar_ПоставленоВ <= &ГраницаОжиданияРаспознавания
	|УПОРЯДОЧИТЬ ПО
	|	ПоставленоВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 6: ошибки служебного лога за период - группы по источнику и событию.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
	|	Лог.ar_Источник КАК Источник,
	|	Лог.ar_Событие КАК Событие,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	МАКСИМУМ(Лог.ar_Момент) КАК ПоследнийМомент
	|ИЗ
	|	РегистрСведений.ar_СлужебныйЛог КАК Лог
	|ГДЕ
	|	Лог.ar_Уровень = ""Ошибка""
	|	И Лог.ar_Момент >= &ГраницаОшибок
	|СГРУППИРОВАТЬ ПО
	|	Лог.ar_Источник,
	|	Лог.ar_Событие
	|УПОРЯДОЧИТЬ ПО
	|	ПоследнийМомент УБЫВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 7: тексты ошибок для деталей групп (первая встреченная в коде
	|// группы строка - самая свежая: выборка упорядочена по моменту убывания).
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 300
	|	Лог.ar_Источник КАК Источник,
	|	Лог.ar_Событие КАК Событие,
	|	Лог.ar_Момент КАК Момент,
	|	Лог.ar_Текст КАК Текст
	|ИЗ
	|	РегистрСведений.ar_СлужебныйЛог КАК Лог
	|ГДЕ
	|	Лог.ar_Уровень = ""Ошибка""
	|	И Лог.ar_Момент >= &ГраницаОшибок
	|УПОРЯДОЧИТЬ ПО
	|	Лог.ar_Момент УБЫВ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 8: активные агенты очереди пакета НСИ.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
	|	Агенты.Ссылка КАК Агент,
	|	Агенты.ar_Пользователь КАК Пользователь,
	|	Агенты.ar_LLMПровайдер КАК Провайдер,
	|	Агенты.ar_Модель КАК Модель
	|ИЗ
	|	Справочник.ar_Агенты КАК Агенты
	|ГДЕ
	|	Агенты.ar_Активен
	|	И Агенты.ar_БратьИзОчередиПакета
	|	И Агенты.ar_ПакетИсточник = ""nsi""
	|	И НЕ Агенты.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Агент
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 9: значения активных настроек пакета по проверяемым ключам.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	|	Настройки.Код КАК Код,
	|	Настройки.ar_Значение КАК Значение,
	|	Настройки.ar_ЗначениеСтрока КАК ЗначениеСтрока,
	|	Настройки.ar_ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.ar_ДополнительныеНастройки КАК Настройки
	|ГДЕ
	|	Настройки.Код В (""НСИДатаНачалаОбработкиЗаявок"", ""НСИГУИДВизыЭтап1"", ""НСИГУИДВизыЭтап2"")
	|	И Настройки.ar_Включено
	|	И НЕ Настройки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Код;";

	Возврат ТекстЗапроса + ТекстЗапросаНастроек();

КонецФункции

// Текст части 10 пакетного запроса: проверяемые ключи, оформленные
// настройкой-списком (значения заголовка такие настройки не дают - как
// в ar_Настройки). Соединение с заголовком вместо разыменования Ссылка.Код.
//
// Возвращаемое значение:
//  Строка - текст части пакетного запроса (с разделителем ";").
//
Функция ТекстЗапросаНастроек()

	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Часть 10: ключи настроек-списков.
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 20
	|	Заголовки.Код КАК Код
	|ИЗ
	|	Справочник.ar_ДополнительныеНастройки.ar_Значения КАК Значения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_ДополнительныеНастройки КАК Заголовки
	|		ПО Значения.Ссылка = Заголовки.Ссылка
	|ГДЕ
	|	Заголовки.Код В (""НСИДатаНачалаОбработкиЗаявок"", ""НСИГУИДВизыЭтап1"", ""НСИГУИДВизыЭтап2"")
	|	И Заголовки.ar_Включено
	|	И НЕ Заголовки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Код";

	Возврат ТекстЗапроса;

КонецФункции

// Причина в деталях строки «Не берется в работу»: почему очередь заявки не
// видит, по тем же условиям, что отбор кандидатов пакета (спека п. 5.1).
//
// Параметры:
//  Выборка             - ВыборкаИзРезультатаЗапроса - строка части 0.
//  ДатаНачалаОбработки - Структура - разбор настройки даты начала обработки.
//
// Возвращаемое значение:
//  Строка - причина, почему очередь не берет заявку.
//
Функция ПричинаНеВзята(Выборка, ДатаНачалаОбработки)

	Если ЗначениеЗаполнено(Выборка.ФайлНеИзвлеченС) Тогда
		Возврат СтрШаблон(НСтр("ru = 'ждёт OCR: файл НеИзвлечен %1 ч'"),
			ВозрастЧасов(Выборка.ФайлНеИзвлеченС));
	КонецЕсли;
	Если Выборка.ДатаЗаявки < ДатаНачалаОбработки.Дата Тогда
		Возврат СтрШаблон(НСтр("ru = 'раньше даты начала обработки (%1)'"),
			Формат(ДатаНачалаОбработки.Дата, "ДФ=дд.ММ.гггг"));
	КонецЕсли;
	Если Выборка.ИсключенаВИС = 1 Тогда
		Возврат НСтр("ru = 'исключена: заявка связана с внешней системой из списка исключённых'");
	КонецЕсли;
	Возврат НСтр("ru = 'видна очереди, не взята'");

КонецФункции

// Объект проблемы для строки запуска: заявка, если известна, иначе RunId.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - строка части 1 пакетного запроса.
//
// Возвращаемое значение:
//  Строка - представление заявки или идентификатор запуска.
//
Функция ОбъектПроблемыЗапуска(Выборка)

	Если ЗначениеЗаполнено(Выборка.Заявка) Тогда
		Возврат Строка(Выборка.Заявка);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Запуск %1'"), СокрЛП(Выборка.ИдентификаторЗапуска));

КонецФункции

// Таблица «Проблемы» с типизированными колонками (поля набора «объект» СКД).
//
// Возвращаемое значение:
//  ТаблицаЗначений - Категория, Важность, Объект, Заявка, Агент, Возникло,
//  ВозрастЧасов, Детали.
//
Функция НоваяТаблицаПроблем()

	ТаблицаПроблем = Новый ТаблицаЗначений;
	ТаблицаПроблем.Колонки.Добавить("Категория",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаПроблем.Колонки.Добавить("Важность",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	ТаблицаПроблем.Колонки.Добавить("Объект",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ТаблицаПроблем.Колонки.Добавить("Заявка",
		Новый ОписаниеТипов("ДокументСсылка.бит_мдм_ЗаявкаНаИзменение"));
	ТаблицаПроблем.Колонки.Добавить("Агент",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ТаблицаПроблем.Колонки.Добавить("Возникло",
		Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаПроблем.Колонки.Добавить("ВозрастЧасов",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 1)));
	ТаблицаПроблем.Колонки.Добавить("Детали",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2000)));
	Возврат ТаблицаПроблем;

КонецФункции

// Добавляет строку проблемы; возраст считается от момента возникновения.
//
// Параметры:
//  ТаблицаПроблем - ТаблицаЗначений - приемник строк.
//  Категория      - Строка - категория проверки.
//  Важность       - Строка - «Критично» или «Внимание».
//  Объект         - Строка - представление заявки, агента или записи.
//  Заявка         - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - для расшифровки;
//                   Неопределено - агент или настройка.
//  Агент          - Строка - представление агента.
//  Возникло       - Дата - момент возникновения проблемы.
//  Детали         - Строка - причина и технические подробности.
//
Процедура ДобавитьПроблему(ТаблицаПроблем, Категория, Важность, Объект, Заявка, Агент, Возникло, Детали)

	Если Заявка = Неопределено Тогда
		Заявка = Документы.бит_мдм_ЗаявкаНаИзменение.ПустаяСсылка();
	КонецЕсли;
	СтрокаПроблемы = ТаблицаПроблем.Добавить();
	СтрокаПроблемы.Категория = Категория;
	СтрокаПроблемы.Важность = Важность;
	СтрокаПроблемы.Объект = Объект;
	СтрокаПроблемы.Заявка = Заявка;
	СтрокаПроблемы.Агент = Агент;
	СтрокаПроблемы.Возникло = Возникло;
	СтрокаПроблемы.ВозрастЧасов = ВозрастЧасов(Возникло);
	СтрокаПроблемы.Детали = Детали;

КонецПроцедуры

// Возраст проблемы в часах от указанного момента, один знак после запятой.
//
// Параметры:
//  Момент - Дата - момент возникновения; пустая дата дает 0.
//
// Возвращаемое значение:
//  Число - возраст в часах, один знак после запятой.
//
Функция ВозрастЧасов(Момент)

	Если Не ЗначениеЗаполнено(Момент) Тогда
		Возврат 0;
	КонецЕсли;
	СекундВЧасе = 3600;
	Возврат Макс(Окр((ТекущаяДатаСеанса() - Момент) / СекундВЧасе, 1), 0);

КонецФункции

// Момент времени для деталей: «дд.ММ.гггг ЧЧ:мм»; пустая дата - прочерк.
//
// Параметры:
//  Момент - Дата - читаемый момент.
//
// Возвращаемое значение:
//  Строка - момент в виде «дд.ММ.гггг ЧЧ:мм» или прочерк.
//
Функция ФорматВремени(Момент)

	Если Не ЗначениеЗаполнено(Момент) Тогда
		Возврат "-";
	КонецЕсли;
	Возврат Формат(Момент, "ДФ='дд.ММ.гггг ЧЧ:мм'");

КонецФункции

// Обрезает текст до заданной длины, добавляя многоточие к усеченному хвосту.
//
// Параметры:
//  Текст     - Строка - исходный текст.
//  ДлинаМакс - Число - предельная длина (не меньше 4).
//
// Возвращаемое значение:
//  Строка - текст, обрезанный до ДлинаМакс (с многоточием).
//
Функция ОбрезатьТекст(Знач Текст, Знач ДлинаМакс)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) <= ДлинаМакс Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ДлинаМакс - 3) + "...";

КонецФункции

// Пустое решение визы: строка соединения не дала (NULL) или решение пустое.
//
// Параметры:
//  РешениеВизы - СправочникСсылка.бит_ВидыРешенийСогласования - решение активной визы.
//
// Возвращаемое значение:
//  Булево - Истина, когда решения нет.
//
Функция ПустоеРешениеВизы(РешениеВизы)

	Возврат РешениеВизы = NULL
		Или РешениеВизы = Справочники.бит_ВидыРешенийСогласования.ПустаяСсылка();

КонецФункции

// Авто-повтор актуализации: причина отложения service_unavailable:* - заявку
// вернет в очередь сам пакет (после исчерпания попыток пишет handover:egr_unavailable).
//
// Параметры:
//  Причина - Строка - причина отложения предмета.
//
// Возвращаемое значение:
//  Булево - Истина, когда отложено на авто-повтор актуализации.
//
Функция ЭтоПовторАктуализации(Знач Причина)

	Возврат СтрНачинаетсяС(СокрЛП(Причина), "service_unavailable:");

КонецФункции

// Пороги проверок - пользовательские параметры СКД. Дефолты повторяют значения
// схемы: параметр может быть не заполнен в настройках пользователя.
//
// Параметры:
//  ПараметрыДанных - ПараметрыКомпоновкиДанных - параметры настроек отчета.
//
// Возвращаемое значение:
//  Структура - ПорогНеБеретсяЧасов, ПорогПульсаМинут, ПорогПодтвержденияЧасов,
//  ПорогТикаМинут, ПорогБезПрогрессаЧасов, ПорогРучногоРазбораЧасов,
//  ПорогРаспознаванияЧасов, ПериодОшибокЧасов, ОшибкиСПоследнегоЗапуска.
//
Функция ПорогиОтчета(ПараметрыДанных)

	Пороги = Новый Структура;
	Пороги.Вставить("ПорогНеБеретсяЧасов", ЗначениеПорога(ПараметрыДанных, "ПорогНеБеретсяЧасов", 1));
	Пороги.Вставить("ПорогПульсаМинут", ЗначениеПорога(ПараметрыДанных, "ПорогПульсаМинут", 5));
	Пороги.Вставить("ПорогПодтвержденияЧасов", ЗначениеПорога(ПараметрыДанных, "ПорогПодтвержденияЧасов", 72));
	Пороги.Вставить("ПорогТикаМинут", ЗначениеПорога(ПараметрыДанных, "ПорогТикаМинут", 30));
	Пороги.Вставить("ПорогБезПрогрессаЧасов", ЗначениеПорога(ПараметрыДанных, "ПорогБезПрогрессаЧасов", 1));
	Пороги.Вставить("ПорогРучногоРазбораЧасов", ЗначениеПорога(ПараметрыДанных, "ПорогРучногоРазбораЧасов", 24));
	Пороги.Вставить("ПорогРаспознаванияЧасов", ЗначениеПорога(ПараметрыДанных, "ПорогРаспознаванияЧасов", 1));
	Пороги.Вставить("ПериодОшибокЧасов", ЗначениеПорога(ПараметрыДанных, "ПериодОшибокЧасов", 24));
	Пороги.Вставить("ОшибкиСПоследнегоЗапуска", ЗначениеФлажка(ПараметрыДанных, "ОшибкиСПоследнегоЗапуска", Истина));
	Возврат Пороги;

КонецФункции

// Числовое значение порога из настроек компоновки; не задан пользователем -
// значение по умолчанию. Ноль - допустимое значение (порог снят).
//
// Параметры:
//  ПараметрыДанных - ПараметрыКомпоновкиДанных - параметры настроек отчета.
//  Имя             - Строка - имя параметра СКД.
//  ПоУмолчанию     - Число - значение при не заданном параметре.
//
// Возвращаемое значение:
//  Число - значение порога.
//
Функция ЗначениеПорога(ПараметрыДанных, Имя, ПоУмолчанию)

	ЗначениеПараметра = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если ЗначениеПараметра = Неопределено
		Или Не ЗначениеПараметра.Использование
		Или ТипЗнч(ЗначениеПараметра.Значение) <> Тип("Число") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат ЗначениеПараметра.Значение;

КонецФункции

// Булево значение флажка из настроек компоновки; не задан пользователем -
// значение по умолчанию.
//
// Параметры:
//  ПараметрыДанных - ПараметрыКомпоновкиДанных - параметры настроек отчета.
//  Имя             - Строка - имя параметра СКД.
//  ПоУмолчанию     - Булево - значение при не заданном параметре.
//
// Возвращаемое значение:
//  Булево - значение флажка.
//
Функция ЗначениеФлажка(ПараметрыДанных, Имя, ПоУмолчанию)

	ЗначениеПараметра = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если ЗначениеПараметра = Неопределено
		Или Не ЗначениеПараметра.Использование
		Или ТипЗнч(ЗначениеПараметра.Значение) <> Тип("Булево") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат ЗначениеПараметра.Значение;

КонецФункции

// Левая граница окна ошибок (категории 2 и 7, спека п. 5.2/5.7). Переключатель
// «Ошибки с последнего запуска» (решение человека 26.10, образец - обработка
// sd_МониторингЖР): включен - окно от момента последнего формирования отчета
// (первое формирование или отметка в будущем - от указанного периода),
// выключен - последние ПериодОшибокЧасов часов.
//
// Параметры:
//  ТекущийМомент - Дата - момент формирования отчета.
//  Пороги        - Структура - пороги проверок (ПорогиОтчета).
//
// Возвращаемое значение:
//  Дата - левая граница окна ошибок.
//
Функция ГраницаОшибокОтчета(ТекущийМомент, Пороги)

	СекундВЧасе = 3600;
	ГраницаПоПериоду = ТекущийМомент - Пороги.ПериодОшибокЧасов * СекундВЧасе;

	Если Не Пороги.ОшибкиСПоследнегоЗапуска Тогда
		Возврат ГраницаПоПериоду;
	КонецЕсли;

	ПоследнееФормирование = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаХранилища(), КлючНастройкиФормирования());
	Если ТипЗнч(ПоследнееФормирование) = Тип("Дата")
		И ЗначениеЗаполнено(ПоследнееФормирование)
		И ПоследнееФормирование < ТекущийМомент Тогда
		Возврат ПоследнееФормирование;
	КонецЕсли;
	Возврат ГраницаПоПериоду;

КонецФункции

// Ключ объекта хранилища общих настроек для отметки формирования отчета.
//
// Возвращаемое значение:
//  Строка - ключ объекта.
//
Функция КлючОбъектаХранилища()

	Возврат "ar_МониторЗаявокНСИ";

КонецФункции

// Ключ настройки - отметка момента последнего формирования отчета (старт
// окна «Ошибки с последнего запуска»).
//
// Возвращаемое значение:
//  Строка - ключ настройки.
//
Функция КлючНастройкиФормирования()

	Возврат "ПоследнееФормирование";

КонецФункции

// Запоминает момент формирования отчета - левую границу следующего окна
// «Ошибки с последнего запуска» (образец - ЗаписатьНастройкуПериодАнализаЖР
// обработки sd_МониторингЖР: отметка пишется в конце каждого формирования).
//
// Параметры:
//  ТекущийМомент - Дата - момент формирования отчета.
//
Процедура ЗаписатьМоментФормирования(ТекущийМомент)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаХранилища(), КлючНастройкиФормирования(),
		ТекущийМомент);

КонецПроцедуры

// Значения активных настроек пакета по проверяемым ключам (повтор чтения
// ar_Настройки одним запросом: Код + ar_Включено + НЕ ПометкаУдаления).
// Ключи, оформленные настройкой-списком (часть 10), значения не дают.
//
// Параметры:
//  РезультатНастроек - РезультатЗапроса - часть 9 пакетного запроса.
//  РезультатСписков  - РезультатЗапроса - часть 10 пакетного запроса.
//
// Возвращаемое значение:
//  Соответствие - Ключ → Структура {Значение, ЗначениеСтрока, ТипЗначения}.
//
Функция НастройкиПоКлючамПакета(РезультатНастроек, РезультатСписков)

	Значения = Новый Соответствие;
	Выборка = РезультатНастроек.Выбрать();
	Пока Выборка.Следующий() Цикл
		Значения.Вставить(СокрЛП(Выборка.Код),
			Новый Структура("Значение, ЗначениеСтрока, ТипЗначения",
				Выборка.Значение, Выборка.ЗначениеСтрока, СокрЛП(Выборка.ТипЗначения)));
	КонецЦикла;
	ВыборкаСписков = РезультатСписков.Выбрать();
	Пока ВыборкаСписков.Следующий() Цикл
		Значения.Удалить(СокрЛП(ВыборкаСписков.Код));
	КонецЦикла;
	Возврат Значения;

КонецФункции

// Разбор настройки НСИДатаНачалаОбработкиЗаявок - повтор
// РазборДатыНачалаОбработкиЗаявок пакета НСИ (спека п. 5.8в): тип Дата - как
// есть; строка «ДД.ММ.ГГГГ» или 8 цифр «ГГГГММДД»; пустое или отсутствующее
// значение - дефолт (источник default); неразборчивое значение - invalid,
// применяется дефолт 01.11.2026.
//
// Параметры:
//  НастройкиПоКлючам - Соответствие - значения настроек пакета.
//
// Возвращаемое значение:
//  Структура - Дата (применяемая дата), Источник ("default"/"setting"/"invalid"),
//  ЗначениеИсходное (Строка - значение настройки для деталей).
//
Функция РазборДатыНачалаОбработки(НастройкиПоКлючам)

	Результат = Новый Структура("Дата, Источник, ЗначениеИсходное",
		Дата(2026, 11, 1), "default", "");
	Запись = НастройкиПоКлючам.Получить("НСИДатаНачалаОбработкиЗаявок");
	Если Запись = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = ЗначениеНастройкиИзЗаписи(Запись);
	Результат.ЗначениеИсходное = СокрЛП(Строка(Значение));

	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		Результат.Дата = Значение;
		Результат.Источник = "setting";
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
		Если ПустаяСтрока(Текст) Тогда
			Возврат Результат; // default: пустая строка - дефолт без предупреждения
		КонецЕсли;
		Разобранная = ДатаИзСтрокиНастройки(Текст);
		Если ЗначениеЗаполнено(Разобранная) Тогда
			Результат.Дата = Разобранная;
			Результат.Источник = "setting";
		Иначе
			Результат.Источник = "invalid";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат.Источник = "invalid"; // число, булево и прочее - не дата
	Возврат Результат;

КонецФункции

// Значение настройки из записи регистрационного справочника - повтор
// ar_Настройки.ЗначениеНастройкиБезКэша: дата из ar_Значение даже при непустой
// ar_ЗначениеСтрока (строка затеняла бы дату), иначе строка, иначе составное.
//
// Параметры:
//  Запись - Структура - {Значение, ЗначениеСтрока, ТипЗначения}.
//
// Возвращаемое значение:
//  Произвольный - значение настройки (Дата, Строка или составное).
//
Функция ЗначениеНастройкиИзЗаписи(Запись)

	Если Запись.ТипЗначения = "Дата" Тогда
		Возврат Запись.Значение;
	КонецЕсли;
	Если Не ПустаяСтрока(Запись.ЗначениеСтрока) Тогда
		Возврат Запись.ЗначениеСтрока;
	КонецЕсли;
	Возврат Запись.Значение;

КонецФункции

// Дата из строкового значения настройки - повтор ДатаИзСтрокиНачала пакета
// НСИ: «ДД.ММ.ГГГГ» через БСП СтроковыеФункцииКлиентСервер.СтрокаВДату, строка
// из ровно 8 цифр - платформенным Дата(). Не разобралось - пустая дата.
//
// Параметры:
//  Текст - Строка - непустое строковое значение настройки.
//
// Возвращаемое значение:
//  Дата - разобранная дата; пустая - разобрать не удалось.
//
Функция ДатаИзСтрокиНастройки(Знач Текст)

	Результат = СтроковыеФункцииКлиентСервер.СтрокаВДату(Текст);
	Если Не ЗначениеЗаполнено(Результат)
		И СтрДлина(Текст) = 8
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
		Попытка
			Результат = Дата(Текст);
		Исключение
			Результат = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Строковое значение настройки по ключу; настройки нет - пустая строка.
//
// Параметры:
//  НастройкиПоКлючам - Соответствие - значения настроек пакета.
//  Ключ              - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - значение настройки; настройки нет - пустая строка.
//
Функция ЗначениеНастройкиСтрокой(НастройкиПоКлючам, Ключ)

	Запись = НастройкиПоКлючам.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(ЗначениеНастройкиИзЗаписи(Запись)));

КонецФункции

// Сколько часов файл может ждать распознавания, не удерживая заявку в очереди:
// повтор МаксОжиданиеРаспознаванияЧасов пакета НСИ (константа ядра пакета;
// вызывать пакет отчету запрещено спекой - при изменении пакета править здесь).
//
// Возвращаемое значение:
//  Число - часов ожидания распознавания.
//
Функция МаксОжиданиеРаспознаванияЧасов()

	// 1.3.3 (agentrunner-466): 2 ч - как в ar_ПакетНСИ 2.5.93 (было 24).
	Возврат 2;

КонецФункции

// Предельный размер файла распознавания, байт: повтор
// ПредельныйРазмерФайлаРаспознавания пакета НСИ (1.3.4, agentrunner-469) -
// настройка ПредельныйРазмерФайлаРаспознавания читается запросом, как
// остальные настройки отчета (вызывать модули расширения отчету запрещено
// спекой); нет активной настройки или значение не положительное число -
// значение по умолчанию 20000000, как в пакете.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
Функция ПредельныйРазмерФайлаРаспознавания()

	ПределПоУмолчанию = 20000000;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Настройки.ar_Значение КАК Значение,
		|	Настройки.ar_ЗначениеСтрока КАК ЗначениеСтрока,
		|	Настройки.ar_ТипЗначения КАК ТипЗначения
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|ГДЕ
		|	Настройки.Код = &Код
		|	И Настройки.ar_Включено
		|	И НЕ Настройки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", "ПредельныйРазмерФайлаРаспознавания");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат ПределПоУмолчанию;
	КонецЕсли;

	Запись = Новый Структура("Значение, ЗначениеСтрока, ТипЗначения",
		Выборка.Значение, Выборка.ЗначениеСтрока, СокрЛП(Выборка.ТипЗначения));
	Предел = ЗначениеНастройкиИзЗаписи(Запись);
	Если ТипЗнч(Предел) <> Тип("Число") Или Предел <= 0 Тогда
		Возврат ПределПоУмолчанию;
	КонецЕсли;
	Возврат Предел;

КонецФункции

// Ссылки исключенных внешних систем (Р23): повтор ГУИДыИсключенныхВнешнихСистем
// пакета НСИ; ссылка строится по платформенному GUID, как СсылкаПоГуиду пакета.
// Неизвестный GUID дает пустую ссылку - в соединении она совпадений не дает.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.sd_ВнешниеИнформационныеСистемы - ссылки систем
//  из списка исключённых.
//
Функция СсылкиИсключенныхВИС()

	Гуиды = Новый Массив;
	Гуиды.Добавить("9e6a9907-5e2a-11ef-8112-005056b80223");
	Ссылки = Новый Массив;
	Для Каждого Гуид Из Гуиды Цикл
		Ссылки.Добавить(Справочники.sd_ВнешниеИнформационныеСистемы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Гуид)));
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

// Расширения файлов, которые распознавание еще возьмет в работу: тот же
// список, что РасширенияРаспознавания пакета НСИ (повторен за пакетом - при
// изменении списка править оба места).
//
// Возвращаемое значение:
//  Массив из Строка - расширения в нижнем регистре, без точки.
//
Функция РасширенияРаспознавания()

	Расширения = Новый Массив;
	Расширения.Добавить("pdf");
	Расширения.Добавить("rtf");
	Расширения.Добавить("tif");
	Расширения.Добавить("tiff");
	Расширения.Добавить("jpg");
	Расширения.Добавить("jpeg");
	Расширения.Добавить("png");
	Расширения.Добавить("gif");
	Расширения.Добавить("bmp");
	Расширения.Добавить("xls");
	Расширения.Добавить("xlsx");
	Расширения.Добавить("docx");
	Расширения.Добавить("odt");
	Расширения.Добавить("ods");
	Расширения.Добавить("txt");
	Расширения.Добавить("xml");
	Расширения.Добавить("htm");
	Расширения.Добавить("html");
	Возврат Расширения;

КонецФункции

#КонецОбласти
