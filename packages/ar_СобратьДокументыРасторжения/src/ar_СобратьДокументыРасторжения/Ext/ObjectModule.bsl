#Область ПрограммныйИнтерфейс

// Команда «Собрать документы для расторжения (агент)» (задача agentrunner-471) -
// внешняя обработка вида ЗаполнениеОбъекта для Справочник.ДоговорыКонтрагентов:
// одна команда в подменю «Заполнить» карточки и списка договоров. Обработчик ставит
// выбранные договоры в очередь ядра командных подписок (ar_ЗапросыАгентам.Отправить
// с явным агентом); агент, созданный из пресета пакета ar_ПакетРасторжениеДоговора,
// инструментом contract_termination_collect собирает в каталог из доп. настроек
// комплект документов расторжения (акт сверки, отчет по платежным поручениям,
// вложения КС-2, отчетов комитенту и корректировочных КС-2).
//
// Команда и пакет инструментов - разные обработки (решение человека 19.11.2026):
// у обработки вида ЗаполнениеОбъекта в подменю «Заполнить» видны все её команды,
// включая служебный маркер ar_ToolPack пакета; отдельная команда без маркера
// оставляет подменю договора чистым (критерий 1а спеки agentrunner-471).
//
// Агент ищется по имени обработки пакета (ИмяОбъекта элемента
// Справочник.ДополнительныеОтчетыИОбработки - его задает платформа по имени
// метаданных, пользователь его не меняет), двумя запросами: элемент пакета ->
// агенты с включенным инструментом пакета и подпиской на команду договоров.
// Наименование агента в поиске не участвует (решение человека 19.11.2026):
// агента можно переименовать или скопировать из пресета под другим именем.
//
// Регистрация в БСП «Дополнительные отчеты и обработки»: вид ЗаполнениеОбъекта
// (только у него команды назначаемых обработок попадают в формы объектов БИТ -
// подменю «Заполнить», факт verify agentrunner-436), БезопасныйРежим = Ложь -
// иначе ядро отвечает unsafe_mode (как в пакете agentrunner-453).
//
// Исполнение: серверный вызов; чтение справочников ядра - привилегированно
// с парным сбросом (у нажимающего кнопку может не быть прав на ar_Агенты,
// ar_Инструменты, ar_ПодпискиАгентов и ДополнительныеОтчетыИОбработки).

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчеты и
// обработки» (см. .docs/Контракт-пакета-tools.md 1.1).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиЗаполнениеОбъекта();
	// 1.0.0 - первая версия (agentrunner-471): команда «Собрать документы для
	// расторжения (агент)» для справочника ДоговорыКонтрагентов.
	ПараметрыРегистрации.Версия = ВерсияПакета();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: собрать документы для расторжения договора'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Кнопка «Собрать документы для расторжения (агент)» в карточке договора
		|ставит его в очередь агента: агент сохраняет в каталог из доп. настроек акт сверки,
		|отчет по платежным поручениям и вложения КС-2, отчетов комитенту
		|и корректировочных КС-2.'");
	// Ядро командного запуска отказывает в безопасном режиме (unsafe_mode).
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Назначение.Добавить("Справочник.ДоговорыКонтрагентов");

	КомандаСбора = ПараметрыРегистрации.Команды.Добавить();
	КомандаСбора.Представление = НСтр("ru = 'Собрать документы для расторжения (агент)'");
	КомандаСбора.Идентификатор = "ar_СобратьДокументыРасторжения";
	КомандаСбора.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	КомандаСбора.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Версия обработки - для регистрации (СведенияОВнешнейОбработке).
//
// Возвращаемое значение:
//  Строка - версия обработки.
//
Функция ВерсияПакета()

	Возврат "1.0.0";

КонецФункции

// Обработчик команды БСП «Дополнительные отчеты и обработки» - два контракта
// вызова (см. ДополнительныеОтчетыИОбработки.ВыполнитьКоманду):
//   * назначаемая команда (вид ЗаполнениеОбъекта, кнопка в подменю «Заполнить»
//     формы договора) - (ИдентификаторКоманды, ОбъектыНазначения[,
//     ПараметрыКоманды]): ОбъектыНазначения - Массив ссылок или Неопределено;
//   * команда из карточки обработки («Выполнить») - (ИдентификаторКоманды
//     [, ПараметрыКоманды]): Структура параметров приходит вторым параметром.
// Варианты различаются типом второго параметра и приводятся к общему виду.
//
// Параметры:
//  ИдентификаторКоманды         - Строка - идентификатор вызванной команды.
//  ОбъектыНазначения            - Массив, Неопределено, Структура - ссылки
//                                 назначения (назначаемый вызов) либо Структура
//                                 параметров команды (вызов из карточки).
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения = Неопределено,
	ПараметрыВыполненияКоманды = Неопределено) Экспорт

	Если ТипЗнч(ОбъектыНазначения) = Тип("Структура") Тогда
		// Вызов из карточки обработки: второй параметр - структура параметров.
		ПараметрыВыполненияКоманды = ОбъектыНазначения;
		ОбъектыНазначения = Неопределено;
	КонецЕсли;

	Объекты = Новый Массив;
	Если ОбъектыНазначения <> Неопределено Тогда
		Объекты = ОбъектыНазначения;
	ИначеЕсли ПараметрыВыполненияКоманды <> Неопределено
		И ПараметрыВыполненияКоманды.Свойство("ОбъектыНазначения") Тогда
		Объекты = ПараметрыВыполненияКоманды.ОбъектыНазначения;
	КонецЕсли;

	Если ИдентификаторКоманды = "ar_СобратьДокументыРасторжения" Тогда
		ВыполнитьКомандуСбораДокументов(Объекты);
	Иначе
		ar_СлужебныйЛог.Записать("ar_СобратьДокументыРасторжения.ВыполнитьКоманду", "contract_command_unknown",
			ИдентификаторКоманды, "Предупреждение");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Команда «Собрать документы для расторжения (агент)»: ставит объекты назначения
// в очередь ядра командных подписок с явным агентом пакета - чтобы не будить другие
// командные подписки на Справочник.ДоговорыКонтрагентов (спека agentrunner-471 п.1).
// Агент не настроен или настроено несколько - сообщение пользователю, в очередь
// ничего не ставится. Итоги ядра (queued / already_queued / in_work ...) - по строке
// в сообщение.
//
// Параметры:
//  Объекты - Массив из ЛюбаяСсылка - договоры назначения команды.
//
Процедура ВыполнитьКомандуСбораДокументов(Знач Объекты)

	ПоискАгента = АгентКомандыСбора();

	Если ПоискАгента.Код <> "ok" Тогда
		Сообщить(ТекстСообщенияОАгенте(ПоискАгента));
		Возврат;
	КонецЕсли;

	Результат = ar_ЗапросыАгентам.Отправить(Объекты, Новый Структура("Агент", ПоискАгента.Агент));
	Для Каждого Итог Из Результат Цикл
		Сообщить(Итог.Текст);
	КонецЦикла;

КонецПроцедуры

// Агент для команды «Собрать документы для расторжения (агент)»: активный агент
// с включенным инструментом пакета ar_ПакетРасторжениеДоговора и включенной,
// не помеченной на удаление подпиской на событие «Справочник.ДоговорыКонтрагентов.Команда»
// (спека agentrunner-471 п.1, решение человека 19.11.2026). Два запроса: элементы
// пакета по ИмяОбъекта (ядро хранит пакет инструмента как строку UUID элемента
// в ar_Инструменты.ar_ИдентификаторПакета), затем агенты по идентификаторам пакетов
// и подписке. Условие подписки отсекает агентов, которым инструмент дали для другой
// работы: им ядро все равно ответило бы no_agent. Чтение - привилегированно
// с парным сбросом: у нажимающего кнопку может не быть прав на справочники ядра.
//
// Возвращаемое значение:
//  Структура:
//   * Код          - Строка - "ok" (один агент), "no_package" (пакет не зарегистрирован),
//                   "no_agent" (агент не настроен), "ambiguous" (несколько агентов).
//   * Агент        - СправочникСсылка.ar_Агенты - агент при Код = "ok".
//   * Наименования - Массив из Строка - наименования найденных агентов (для "ambiguous").
//
Функция АгентКомандыСбора()

	Результат = Новый Структура("Код, Агент, Наименования", "no_agent",
		Справочники.ar_Агенты.ПустаяСсылка(), Новый Массив);

	Агенты = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИдентификаторыПакета = ИдентификаторыПакетовИнструментов();
		Если ИдентификаторыПакета.Количество() = 0 Тогда
			Результат.Код = "no_package";
		Иначе
			Агенты = АгентыПакета(ИдентификаторыПакета);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Результат.Код <> "no_package" Тогда
		Для Каждого НайденныйАгент Из Агенты Цикл
			Результат.Наименования.Добавить(НайденныйАгент.Наименование);
		КонецЦикла;
		Если Агенты.Количество() = 1 Тогда
			Результат.Код = "ok";
			Результат.Агент = Агенты[0].Ссылка;
		ИначеЕсли Агенты.Количество() > 1 Тогда
			Результат.Код = "ambiguous";
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Строковые идентификаторы (UUID) элементов Справочник.ДополнительныеОтчетыИОбработки
// пакета ar_ПакетРасторжениеДоговора - так ядро записывает пакет инструмента в
// ar_Инструменты.ar_ИдентификаторПакета (ar_ИнструментыПакеты, «строковое представление
// UUID ссылки»). Нескольких элементов - берутся все. Вызывается в привилегированном
// режиме вызывающего кода.
//
// Возвращаемое значение:
//  Массив из Строка - строковые UUID ссылок пакета.
//
Функция ИдентификаторыПакетовИнструментов()

	Идентификаторы = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Пакеты
		|ГДЕ
		|	Пакеты.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ Пакеты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъектаПакета());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

// Активные агенты с включенным инструментом пакета и включенной, не помеченной
// на удаление подпиской на команду договоров; РАЗЛИЧНЫЕ агенты. Соединения по
// ссылкам, объемы - десятки строк справочников ядра. Вызывается в привилегированном
// режиме вызывающего кода.
//
// Параметры:
//  ИдентификаторыПакета - Массив из Строка - строковые UUID элементов пакета.
//
// Возвращаемое значение:
//  Массив из Структура - {Ссылка: СправочникСсылка.ar_Агенты; Наименование: Строка},
//  упорядочен по наименованию.
//
Функция АгентыПакета(Знач ИдентификаторыПакета)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты.ar_ДоступныеИнструменты КАК ИнструментыАгента
		|		ПО ИнструментыАгента.Ссылка = Агенты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Инструменты КАК Инструменты
		|		ПО Инструменты.Ссылка = ИнструментыАгента.ar_Инструмент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_ПодпискиАгентов КАК Подписки
		|		ПО Подписки.ar_Агент = Агенты.Ссылка
		|ГДЕ
		|	Агенты.ar_Активен
		|	И НЕ Агенты.ПометкаУдаления
		|	И ИнструментыАгента.ar_Включен
		|	И Инструменты.ar_Включён
		|	И НЕ Инструменты.ПометкаУдаления
		|	И Инструменты.ar_ИдентификаторПакета В (&ИдентификаторыПакета)
		|	И Подписки.ar_Включён
		|	И НЕ Подписки.ПометкаУдаления
		|	И Подписки.ar_Событие1С = &Событие
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Запрос.УстановитьПараметр("ИдентификаторыПакета", ИдентификаторыПакета);
	Запрос.УстановитьПараметр("Событие", СобытиеКомандыДоговоров());

	Агенты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Агенты.Добавить(Новый Структура("Ссылка, Наименование", Выборка.Ссылка, Выборка.Наименование));
	КонецЦикла;

	Возврат Агенты;

КонецФункции

// Сообщение о результате поиска агента для пользователя (спека agentrunner-471 п.1).
//
// Параметры:
//  ПоискАгента - Структура - результат АгентКомандыСбора.
//
// Возвращаемое значение:
//  Строка - текст сообщения.
//
Функция ТекстСообщенияОАгенте(Знач ПоискАгента)

	Если ПоискАгента.Код = "no_package" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Пакет инструментов «%1» не зарегистрирован в «Дополнительных отчетах и обработках» -
			|обратитесь к администратору.'"), ИмяОбъектаПакета());
	ИначеЕсли ПоискАгента.Код = "ambiguous" Тогда
		Возврат СтрШаблон(НСтр("ru = 'Найдено несколько агентов сбора документов (%1) -
			|оставьте подписку на команду договоров у одного из них.'"),
			СтрСоединить(ПоискАгента.Наименования, ", "));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Агент для сбора документов не настроен: нужен активный агент
		|с инструментом пакета «%1» и подпиской на команду договоров -
		|обратитесь к администратору.'"), ИмяОбъектаПакета());

КонецФункции

// Имя объекта обработки пакета инструментов (задается платформой по имени
// метаданных, пользователь его не меняет) - константа модуля, связь команды
// и пакета (спека agentrunner-471 п.1, решение человека 19.11.2026).
//
// Возвращаемое значение:
//  Строка - имя объекта обработки пакета.
//
Функция ИмяОбъектаПакета()

	Возврат "ar_ПакетРасторжениеДоговора";

КонецФункции

// Событие командной подписки ядра для договоров: «<ПолноеИмяОбъекта>.Команда»
// (как в ar_ЗапросыАгентам.СуффиксСобытияКоманды).
//
// Возвращаемое значение:
//  Строка - событие подписки.
//
Функция СобытиеКомандыДоговоров()

	Возврат "Справочник.ДоговорыКонтрагентов" + ar_ЗапросыАгентам.СуффиксСобытияКоманды();

КонецФункции

#КонецОбласти
