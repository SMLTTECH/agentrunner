diff --git a/src/CommonForms/ar_Диалог/Ext/Form/Module.bsl b/src/CommonForms/ar_Диалог/Ext/Form/Module.bsl
index 8b98582..548304d 100644
--- a/src/CommonForms/ar_Диалог/Ext/Form/Module.bsl
+++ b/src/CommonForms/ar_Диалог/Ext/Form/Module.bsl
@@ -445,2 +445,2 @@
-// Очистить все служебные регистры/справочники расширения (UI-22, перенесено
-// из ar_ДиалогOld) - необратимо, с диалогом подтверждения.
+// Очистить все служебные регистры/справочники расширения, кроме
+// ar_ХранилищеСекретов (UI-22) - необратимо, с диалогом подтверждения.
@@ -1475,6 +1475,7 @@
-			ТекстФинала = "";
-			Событие.Свойство("ТекстОтвета", ТекстФинала);
-			Если НЕ ПустаяСтрока(ТекстФинала)
-				И ТекстФинала <> ПоследнийТекстЛенты(ТекущийЯкорь, "assistant") Тогда
-				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "assistant", ТекстФинала, ТекущийИдентификаторЗапуска, "");
-			КонецЕсли;
+			// agentrunner-68 (спека А): событие «Завершён» фиксируется на КАЖДОМ
+			// проходе продолжения надзора - писать его текст в ленту здесь
+			// значит дублировать итоговые ответы. Итог пишется один раз по
+			// финальному статусу запуска (блок «2. Статус запуска» ниже -
+			// СинхронизироватьХвостДиалога, идемпотентно по RunId+роли).
+			// Пока идут продолжения (статус «Выполняется»), промежуточные
+			// ответы в ленту не попадают.
@@ -1511,0 +1513,9 @@
+	// 2а. agentrunner-68 (спека А): итоговый ответ - в ленту один раз на запуск,
+	// по финальному статусу (в том же тике, после чтения статуса): текст
+	// последнего события «Завершён», не более одной assistant-записи на RunId.
+	// СинхронизироватьХвостДиалога сама выходит, если статус не финальный;
+	// Failed/MaxStepsReached дают системную строку, как раньше.
+	Если БылоИзменение И ЭтоФинальныйСтатус(СтатусЗапуска) Тогда
+		СинхронизироватьХвостДиалога();
+	КонецЕсли;
+
@@ -1567 +1577 @@
-// ar_ХранилищеСекретов), перенесено из ar_ДиалогOld (UI-22).
+// ar_ХранилищеСекретов), консоль «Диалог с агентом» (UI-22).
@@ -3884 +3894 @@
-// Экранировать спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_ДиалогOld).
