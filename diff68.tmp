+// Копия истории сообщений без служебных сообщений надзора (agentrunner-68,
+// спека В): удаляется каждое сообщение с признаком ar_СлужебноеНадзора и
+// непосредственно предшествующее ему сообщение role=assistant без tool_calls
+// (промежуточный итог прохода). Вызовы инструментов и их observation
+// сохраняются. Исходный массив не меняется - Состояние.Сообщения текущего
+// запуска остается как есть (фильтр - только для СохранитьСессию).
+//
+// Параметры:
+//  ИсходныеСообщения - Массив - Состояние.Сообщения.
+//
+// Возвращаемое значение:
+//  Структура - {Сообщения - Массив (отфильтрованная копия);
+//               Удалено - Число (служебных и промежуточных сообщений)}.
+//
+Функция ИсторияБезСлужебныхНадзора(Знач ИсходныеСообщения)
+
+	Результат = Новый Структура;
+	Результат.Вставить("Сообщения", Новый Массив);
+	Результат.Вставить("Удалено", 0);
+
+	Если ТипЗнч(ИсходныеСообщения) <> Тип("Массив") Тогда
+		Возврат Результат;
+	КонецЕсли;
+
+	Сообщения = Результат.Сообщения;
+	// Индекс последнего добавленного assistant без tool_calls (-1 - нет):
+	// за ним промежуточный итог прохода удаляется вместе со служебным
+	// сообщением надзора; любое другое сообщение сбрасывает след.
+	НомерAssistant = -1;
+
+	Для Каждого Сообщение Из ИсходныеСообщения Цикл
+
+		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
+			Сообщения.Добавить(Сообщение);
+			НомерAssistant = -1;
+			Продолжить;
+		КонецЕсли;
+
+		ПризнакСлужебное = Ложь;
+		Сообщение.Свойство("ar_СлужебноеНадзора", ПризнакСлужебное);
+		Если ПризнакСлужебное = Истина Тогда
+			Результат.Удалено = Результат.Удалено + 1;
+			Если НомерAssistant >= 0 Тогда
+				Сообщения.Удалить(НомерAssistant);
+				Результат.Удалено = Результат.Удалено + 1;
+				НомерAssistant = -1;
+			КонецЕсли;
+			Продолжить;
+		КонецЕсли;
+
+		Роль = "";
+		Сообщение.Свойство("role", Роль);
+		Если Роль = "assistant" И НЕ Сообщение.Свойство("tool_calls") Тогда
+			НомерAssistant = Сообщения.Количество();
+		Иначе
+			НомерAssistant = -1;
+		КонецЕсли;
+		Сообщения.Добавить(Сообщение);
+
+	КонецЦикла;
+
+	Возврат Результат;
+
+КонецФункции
+
+// Имена инструментов запуска из окна контекста последнего шага
+// (tool_definitions) - для блока инструментов расширенного промпта
+// продолжения (agentrunner-68, спека Б.4). Окно не Структура / ключа нет -
+// пустой массив (блок не добавляется).
+//
+// Параметры:
+//  ОкноКонтекста - Структура, Неопределено - окно контекста последнего вызова
+//                  LLM (ПостроитьКонтекст, ключ tool_definitions).
+//
+// Возвращаемое значение:
+//  Массив из Строка.
+//
+Функция ИменаИнструментовИзОкна(Знач ОкноКонтекста)
+
+	Результат = Новый Массив;
+	Если ТипЗнч(ОкноКонтекста) <> Тип("Структура") Тогда
+		Возврат Результат;
+	КонецЕсли;
+
+	Определения = Неопределено;
+	Если Не ОкноКонтекста.Свойство("tool_definitions", Определения)
+		ИЛИ ТипЗнч(Определения) <> Тип("Массив") Тогда
+		Возврат Результат;
+	КонецЕсли;
+
+	Для Каждого Манифест Из Определения Цикл
+		ИмяИнструмента = ИмяИзМанифестаTool(Манифест);
+		Если Не ПустаяСтрока(ИмяИнструмента) Тогда
+			Результат.Добавить(ИмяИнструмента);
+		КонецЕсли;
+	КонецЦикла;
+
+	Возврат Результат;
+
+КонецФункции
+
