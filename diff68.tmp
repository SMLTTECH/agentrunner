+Функция НовоеРешениеНадзора(Знач Вердикт, Знач Источник)
+
+	Решение = Новый Структура;
+	Решение.Вставить("Вердикт", Вердикт);
+	Решение.Вставить("Источник", Источник);
+	Решение.Вставить("Класс", "");
+	Решение.Вставить("Причина", "");
+	Решение.Вставить("НеСделано", "");
+	Решение.Вставить("Модель", "");
+	Решение.Вставить("ТокеновВход", 0);
+	Решение.Вставить("ТокеновВыход", 0);
+	Решение.Вставить("ДлительностьМС", 0);
+	Решение.Вставить("Ответ", "");
+	Решение.Вставить("СообщенияВызова", Неопределено);
+	Решение.Вставить("ПричинаОстановки", "");
+	Возврат Решение;
+
+КонецФункции
+
