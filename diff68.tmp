+	ПродолженийСделано = ar_AuditЗащищённыйРежим.ПрочитатьПродолженийСделаноПривилегированно(RunId);
+	Проход = ПродолженийСделано + 1;
+	ДействийВПроходе = Макс(ЗначениеЧисло(Состояние, "ДействийВсего")
