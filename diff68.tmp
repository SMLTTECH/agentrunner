+		// Первый повтор: продолжение с призывом сменить подход. Признак
+		// ПредложитьСменуПодхода - одноразовый (сбрасывает ПродолжитьЦиклПослеНадзора
+		// после построения текста); ПредыдущийСменаПодхода - персистентный, он же
+		// определяет ветку при следующем повторе.
+		ЗаписатьВСостояние(Состояние, "ПредыдущийСменаПодхода", Истина);
+		ЗаписатьВСостояние(Состояние, "ПредложитьСменуПодхода", Истина);
+		РешениеПовтора = НовоеРешениеНадзора("СменитьПодход", "repeat");
+		ЗафиксироватьРешение(RunId, РешениеПовтора);
+		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
+			"не проверялся", Истина, "СменитьПодход");
+		Возврат НовыйРезультатРешения(Истина, "СменитьПодход");
+	КонецЕсли;
+
+	Если ПовторОтвета И БылаСменаПодхода Тогда
+		ДействияЗапуска = ВыбратьДействияЗапуска(RunId);
+		ОтветЛожный = ПроверитьБезLLM(ФинальныйТекст, ДействияЗапуска).Сработала;
+		РешениеПовтора = НовоеРешениеНадзора("СменитьПодход", "repeat");
+		Если ОтветЛожный Тогда
+			// Объективно ложный ответ (заявлено создание/изменение, результата
+			// нет) - не принимается: эскалация false_claim, запуск «Завершён».
+			Цифры = ЦифрыРешения(Состояние, ДанныеАгента, РезультатПотолка.ПродолженийСделано, "");
+			ЗафиксироватьЭскалацию(RunId, "false_claim", Цифры);
+			ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
+				"не проверялся", Ложь, "Эскалировать");
+			Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
+		КонецЕсли;
+		// Подтверждение после пересмотра: продолжения нет, итоговый ответ
+		// принимается как окончательный (вердикт записи "СменитьПодход", не
+		// "ЦельДостигнута" - надзор цель не подтвердил), stop_reason =
+		// answer_confirmed, без эскалации и письма.
+		РешениеПовтора.ПричинаОстановки = "answer_confirmed";
+		ЗафиксироватьРешение(RunId, РешениеПовтора);
+		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
+			"не проверялся", Ложь, "СменитьПодход");
+		Возврат НовыйРезультатРешения(Ложь, "СменитьПодход");
+	КонецЕсли;
+
+	// --- Слой 2б: result-aware отпечаток прохода (D3/D4/D5) -------------------
+	ГраницаПрохода = ЗначениеЧисло(Состояние, "ДействийВсегоНаНачалоПрохода");
@@ -807,0 +1228,2 @@
+		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, ПовторОтвета,
+			"совпал", Ложь, "Эскалировать");
@@ -822,0 +1245,2 @@
+	ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, ПовторОтвета,
+		"новый", Истина, Вердикт);
@@ -1205,0 +1630,4 @@
+	// agentrunner-68 (спека Г.1): stop_reason несёт причины эскалаций (читается
+	// ar_ПросмотрЗапуска как деталь события) - дубль escalation_reason по
+	// единому протоколу остановок.
+	Payload.Вставить("stop_reason", ПричинаЭскалации);
@@ -1345,0 +1774,351 @@
+// ============================================================================
+// agentrunner-68: расширение промпта продолжения, слой повторов ответа,
+// служебный лог решения.
+// ============================================================================
+
+// Лимит суммарного текста промпта продолжения (символов, спека Б.4).
+//
+Функция ЛимитПромптаПродолжения()
+	Возврат 4000;
+КонецФункции
+
+// Лимит блока цели в промпте продолжения (символов).
+//
+Функция ЛимитЦелиПромпта()
+	Возврат 1000;
+КонецФункции
+
+// Лимит отдельного текстового блока промпта (символов).
+//
+Функция ЛимитБлокаПромпта()
+	Возврат 500;
+КонецФункции
+
+// Максимум действий в блоке «Выполненные действия» (последние, спека Б.4).
+//
+Функция ЛимитДействийПромпта()
+	Возврат 20;
+КонецФункции
+
+// Усечь текст до лимита с пометкой усечения (спека Б.4: «длинные блоки
+// усекаются с пометкой»); строка короче лимита возвращается как есть.
+//
+// Параметры:
+//  Текст - Строка - исходный текст.
+//  Лимит - Число  - максимальная длина результата.
+//
+// Возвращаемое значение:
+//  Строка
+//
+Функция УсечьТекст(Знач Текст, Знач Лимит)
+
+	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
+		Возврат "";
+	КонецЕсли;
+
+	Если СтрДлина(Текст) <= Лимит Тогда
+		Возврат Текст;
+	КонецЕсли;
+
+	Пометка = НСтр("ru = '... (усечено)'; en = '... (truncated)'");
+	Возврат Лев(Текст, Лимит) + Символы.ПС + Пометка;
+
+КонецФункции
+
+// Блок «Выполненные действия» промпта продолжения: инструмент -> результат
+// получен / ошибка / результата нет - не более ЛимитДействийПромпта последних,
+// без содержимого ответов (спека Б.4). Нет действий - пустая строка (блок не
+// добавляется).
+//
+// Параметры:
+//  Действия - ТаблицаЗначений - колонки ИмяTool, ResultRef, ЗавершенСОшибкой
+//             (см. ВыбратьДействияЗапуска).
+//
+// Возвращаемое значение:
+//  Строка
+//
+Функция БлокДействийПромпта(Знач Действия)
+
+	Если ТипЗнч(Действия) <> Тип("ТаблицаЗначений") ИЛИ Действия.Количество() = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+
+	ВсегоДействий = Действия.Количество();
+	НачальныйНомер = Макс(ВсегоДействий - ЛимитДействийПромпта(), 0);
+
+	Строки = Новый Массив;
+	Для НомерДействия = НачальныйНомер По ВсегоДействий - 1 Цикл
+		СтрокаДействия = Действия[НомерДействия];
+		ИмяTool = Строка(СтрокаДействия.ИмяTool);
+		Если СтрокаДействия.ЗавершенСОшибкой = Истина Тогда
+			Итог = НСтр("ru = 'ошибка'; en = 'error'");
+		ИначеЕсли Не ПустаяСтрока(СтрокаДействия.ResultRef) Тогда
+			Итог = НСтр("ru = 'результат получен'; en = 'result produced'");
+		Иначе
+			Итог = НСтр("ru = 'результата нет'; en = 'no result'");
+		КонецЕсли;
+		Строки.Добавить(ИмяTool + " -> " + Итог);
+	КонецЦикла;
+
+	Если Строки.Количество() < ВсегоДействий Тогда
+		Строки.Вставить(0, СтрШаблон(
+			НСтр("ru = '(первые %1 из %2 действий скрыты)'; en = '(first %1 of %2 actions hidden)'"),
+			Формат(ВсегоДействий - Строки.Количество(), "ЧГ=0"), Формат(ВсегоДействий, "ЧГ=0")));
+	КонецЕсли;
+
+	Возврат НСтр("ru = 'Выполненные действия запуска:'; en = 'Actions performed in the run:'")
+		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);
+
+КонецФункции
+
+// Соответствие «имя инструмента -> Истина» по таблице действий - для отметки
+// вызванных инструментов в блоке инструментов промпта.
+//
+Функция ИменаВызванныхИнструментов(Знач Действия)
+
+	Результат = Новый Соответствие;
+	Если ТипЗнч(Действия) <> Тип("ТаблицаЗначений") Тогда
+		Возврат Результат;
+	КонецЕсли;
+	Для Каждого СтрокаДействия Из Действия Цикл
+		Результат.Вставить(Строка(СтрокаДействия.ИмяTool), Истина);
+	КонецЦикла;
+	Возврат Результат;
+
+КонецФункции
+
+// Блок «План» промпта продолжения: шаги и статусы (если план есть, спека Б.4).
+// Удаленные (removed) пункты не выводятся; пустой план - пустая строка.
+//
+Функция БлокПланаПромпта(Знач План)
+
+	Пункты = Неопределено;
+	Если ТипЗнч(План) = Тип("Структура") Тогда
+		План.Свойство("Пункты", Пункты);
+	КонецЕсли;
+	Если ТипЗнч(Пункты) <> Тип("Массив") ИЛИ Пункты.Количество() = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+
+	Строки = Новый Массив;
+	Для Каждого Пункт Из Пункты Цикл
+		СтатусПункта = мСтатусПункта(Пункт);
+		Если СтатусПункта = "" Тогда
+			// removed (и неизвестные статусы) - в промпт не попадают.
+			Продолжить;
+		КонецЕсли;
+		ЗаголовокПункта = "";
+		Если ТипЗнч(Пункт) = Тип("Структура") Тогда
+			Пункт.Свойство("Заголовок", ЗаголовокПункта);
+		КонецЕсли;
+		Строки.Добавить("- " + УсечьТекст(Строка(ЗаголовокПункта), 200) + " - " + СтатусПункта);
+	КонецЦикла;
+
+	Если Строки.Количество() = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+
+	Возврат НСтр("ru = 'План:'; en = 'Plan:'") + Символы.ПС + СтрСоединить(Строки, Символы.ПС);
+
+КонецФункции
+
+// Русское представление статуса пункта плана (см. ar_ПланЗапуска.НовыйПункт);
+// removed и неизвестные значения дают пустую строку (пункт скрыт).
+//
+Функция мСтатусПункта(Знач Пункт)
+
+	Статус = "";
+	Если ТипЗнч(Пункт) = Тип("Структура") Тогда
+		Пункт.Свойство("Статус", Статус);
+	КонецЕсли;
+	Статус = НРег(СокрЛП(Статус));
+
+	Если Статус = "pending" Тогда
+		Возврат НСтр("ru = 'не начат'; en = 'not started'");
+	ИначеЕсли Статус = "in_progress" Тогда
+		Возврат НСтр("ru = 'в работе'; en = 'in progress'");
+	ИначеЕсли Статус = "done" Тогда
+		Возврат НСтр("ru = 'готов'; en = 'done'");
+	ИначеЕсли Статус = "skipped" Тогда
+		Возврат НСтр("ru = 'пропущен'; en = 'skipped'");
+	КонецЕсли;
+
+	Возврат "";
+
+КонецФункции
+
+// Блок «Доступные инструменты» промпта продолжения: имена инструментов запуска
+// с отметкой, какие ещё не вызывались (спека Б.4). Список не передан - пустая
+// строка (блок не добавляется).
+//
+// Параметры:
+//  ДоступныеИнструменты - Массив, Неопределено - имена инструментов запуска.
+//  ВызванныеИнструменты - Соответствие - имена вызванных (ИменаВызванныхИнструментов).
+//
+Функция БлокИнструментовПромпта(Знач ДоступныеИнструменты, Знач ВызванныеИнструменты)
+
+	Если ТипЗнч(ДоступныеИнструменты) <> Тип("Массив") ИЛИ ДоступныеИнструменты.Количество() = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+	Если ТипЗнч(ВызванныеИнструменты) <> Тип("Соответствие") Тогда
+		ВызванныеИнструменты = Новый Соответствие;
+	КонецЕсли;
+
+	Строки = Новый Массив;
+	Для Каждого ИмяИнструмента Из ДоступныеИнструменты Цикл
+		ИмяСтрокой = Строка(ИмяИнструмента);
+		Если ПустаяСтрока(ИмяСтрокой) Тогда
+			Продолжить;
+		КонецЕсли;
+		Отметка = ?(ВызванныеИнструменты.Получить(ИмяСтрокой) = Истина,
+			НСтр("ru = 'вызывался'; en = 'called'"),
+			НСтр("ru = 'ещё не вызывался'; en = 'not called yet'"));
+		Строки.Добавить("- " + ИмяСтрокой + " (" + Отметка + ")");
+	КонецЦикла;
+
+	Если Строки.Количество() = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+
+	Возврат НСтр("ru = 'Доступные инструменты:'; en = 'Available tools:'")
+		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);
+
+КонецФункции
+
+// Нормализованный текст ответа для сравнения повторов (спека Б.5): нижний
+// регистр, ё -> е, без пробельных символов и знаков препинания.
+//
+// Параметры:
+//  Текст - Строка - ответ прохода (или предыдущего прохода).
+//
+// Возвращаемое значение:
+//  Строка - нормализованный текст; пустые ответы остаются пустыми.
+//
+Функция НормализованныйОтветТекста(Знач Текст)
+
+	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
+		Возврат "";
+	КонецЕсли;
+
+	Результат = НРег(СтрЗаменить(Текст, "ё", "е"));
+
+	// Пробельные символы.
+	Результат = СтрЗаменить(Результат, Символы.ПС, "");
+	Результат = СтрЗаменить(Результат, Символы.ВК, "");
+	Результат = СтрЗаменить(Результат, Символы.Таб, "");
+	Результат = СтрЗаменить(Результат, " ", "");
+	Результат = СтрЗаменить(Результат, Символы.НПП, "");
+
+	// Знаки препинания и прочие несмыслоразличающие символы.
+	Знаки = Новый Массив;
+	Знаки.Добавить(".");
+	Знаки.Добавить(",");
+	Знаки.Добавить("!");
+	Знаки.Добавить("?");
+	Знаки.Добавить(":");
+	Знаки.Добавить(";");
+	Знаки.Добавить("""");
+	Знаки.Добавить("'");
+	Знаки.Добавить("(");
+	Знаки.Добавить(")");
+	Знаки.Добавить("[");
+	Знаки.Добавить("]");
+	Знаки.Добавить("{");
+	Знаки.Добавить("}");
+	Знаки.Добавить("-");
+	Знаки.Добавить("*");
+	Знаки.Добавить("/");
+	Знаки.Добавить("\");
+	Знаки.Добавить("|");
+	Знаки.Добавить("«");
+	Знаки.Добавить("»");
+	Знаки.Добавить("—");
+	Знаки.Добавить("–");
+	Знаки.Добавить("…");
+	Знаки.Добавить("_");
+	Знаки.Добавить("<");
+	Знаки.Добавить(">");
+
+	Для Каждого Знак Из Знаки Цикл
+		Результат = СтрЗаменить(Результат, Знак, "");
+	КонецЦикла;
+
+	Возврат Результат;
+
+КонецФункции
+
+// Безопасно извлечь булево поле из Состояния (Структура); отсутствие ключа
+// или другой тип - Ложь (старые снимки без ключа, ДополнитьКлючи подставит).
+//
+Функция ЗначениеБулево(Знач Состояние, Знач ИмяПоля)
+	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
+		Возврат Ложь;
+	КонецЕсли;
+	Значение = Ложь;
+	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Булево") Тогда
+		Возврат Ложь;
+	КонецЕсли;
+	Возврат Значение;
+КонецФункции
+
+// Безопасно прочитать число по ключу структуры ответа LLM (0 при сбое).
+//
+Функция МетрикаЧисло(Знач Источник, Знач ИмяКлюча)
+	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
+		Возврат 0;
+	КонецЕсли;
+	Значение = 0;
+	Если Не Источник.Свойство(ИмяКлюча, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") Тогда
+		Возврат 0;
+	КонецЕсли;
+	Возврат Значение;
+КонецФункции
+
+// Записать значение в ключ Состояния (создав ключ при его отсутствии).
+//
+Процедура ЗаписатьВСостояние(Состояние, Знач ИмяПоля, Знач Значение)
+	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
+		Возврат;
+	КонецЕсли;
+	Состояние.Вставить(ИмяПоля, Значение);
+КонецПроцедуры
+
+// Причина срабатывания дешевой проверки (спека Б.2/Б.4) - единая формулировка
+// для payload события, служебного лога и блока «не сделано» промпта.
+//
+Функция ПричинаДешевойПроверки()
+	Возврат НСтр("ru = 'заявлено создание/изменение, но ни одно изменяющее действие
+		|не дало результата';
+		|en = 'creation/modification is claimed, but no mutating action produced
+		|a result'");
+КонецФункции
+
+// Служебный лог решения слоёв детекции (спека Д, событие supervisor_layers):
+// потолок, бюджет, повтор ответа, отпечаток, итог. Best-effort - вызывается из
+// веток РешитьПродолжатьЛиВнутр перед возвратом; сам лог ошибок не бросает
+// (внутренний перехват), чтобы не мешать уже принятому решению.
+//
+// Параметры:
+//  RunId              - Строка(36) - идентификатор запуска.
+//  Состояние          - Структура, Неопределено - состояние цикла (бюджет).
+//  ПродолженийСделано - Число  - показание счётчика потолка (N/10).
+//  ПовторОтвета       - Булево - сработал ли слой повтора ответа.
+//  ОтпечатокСтатус    - Строка - "совпал" | "новый" | "не проверялся".
+//  Продолжать         - Булево - итоговое решение (продолжение цикла).
+//  Вердикт            - Строка - вердикт для записи.
+//
+Процедура ЛогСлоёв(Знач RunId, Знач Состояние, Знач ПродолженийСделано,
+	Знач ПовторОтвета, Знач ОтпечатокСтатус, Знач Продолжать, Знач Вердикт)
+
+	ar_СлужебныйЛог.Записать("ar_Надзор.РешитьПродолжатьЛи", "supervisor_layers",
+		СтрШаблон("Потолок=%1/10; Бюджет: шагов=%2, действий=%3; ПовторОтвета=%4;
+|Отпечаток=%5; Итог=%6 (%7)",
+			Формат(ПродолженийСделано, "ЧГ=0"),
+			Формат(ЗначениеЧисло(Состояние, "ШаговВсего"), "ЧГ=0"),
+			Формат(ЗначениеЧисло(Состояние, "ДействийВсего"), "ЧГ=0"),
+			?(ПовторОтвета, "да", "нет"), ОтпечатокСтатус,
+			?(Продолжать, "Продолжать", "остановить"), Вердикт),
+		, RunId);
+
+КонецПроцедуры
+
