@@ -276,0 +277,91 @@
+// Текст расширенного промпта продолжения (agentrunner-68, спека Б.4) -
+// экспортно для ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора, который добавляет
+// его role=user с признаком ar_СлужебноеНадзора. Вместо общей фразы «цель ещё
+// не достигнута» агент получает: цель (текущий запрос), что не сделано по
+// оценке надзора, выполненные действия с их итогом, план, доступные
+// инструменты с отметкой неиспользованных и указание о пересмотре подхода.
+//
+// Каждый блок добавляется только при наличии данных; длинные блоки усекаются
+// с пометкой; суммарный объем - до 4000 символов (лимит спеки).
+//
+// Параметры:
+//  RunId                - Строка(36) - идентификатор запуска.
+//  Состояние            - Структура - состояние цикла (Результат, Сообщения,
+//                         План, ПоследнееНеСделано, ПредложитьСменуПодхода).
+//  ДанныеАгента         - Структура - данные агента (Инструкция, Модель).
+//  КонтекстТриггера     - Структура, Неопределено - контекст текущего триггера
+//                         ({Триггер = "supervisor_continue"}).
+//  ДоступныеИнструменты - Массив, Неопределено - имена инструментов запуска
+//                         (из tool_definitions последнего шага); пусто/не
+//                         Массив - блок инструментов не добавляется.
+//
+// Возвращаемое значение:
+//  Строка - текст user-сообщения продолжения.
+//
+Функция ТекстПродолженияНадзора(Знач RunId, Знач Состояние, Знач ДанныеАгента,
+	Знач КонтекстТриггера, Знач ДоступныеИнструменты = Неопределено) Экспорт
+
+	Триггер = "supervisor_continue";
+	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
+		КонтекстТриггера.Свойство("Триггер", Триггер);
+	КонецЕсли;
+	Цель = СформироватьЦель(Триггер, Состояние, ДанныеАгента);
+
+	Блоки = Новый Массив;
+
+	Заголовок = НСтр("ru = 'Надзор: цель ещё не достигнута'; en = 'Supervision: the goal is not achieved yet'");
+	Блоки.Добавить(Заголовок + Символы.ПС + УсечьТекст(Цель, ЛимитЦелиПромпта()));
+
+	НеСделано = ЗначениеСтрока(Состояние, "ПоследнееНеСделано");
+	Если Не ПустаяСтрока(НеСделано) Тогда
+		Блоки.Добавить(СтрШаблон(
+			НСтр("ru = 'Не сделано по оценке надзора: %1'; en = 'Not done per supervision: %1'"),
+			УсечьТекст(НеСделано, ЛимитБлокаПромпта())));
+	КонецЕсли;
+
+	Действия = ВыбратьДействияЗапуска(RunId);
+	БлокДействий = БлокДействийПромпта(Действия);
+	Если Не ПустаяСтрока(БлокДействий) Тогда
+		Блоки.Добавить(БлокДействий);
+		ВызванныеИнструменты = ИменаВызванныхИнструментов(Действия);
+	Иначе
+		ВызванныеИнструменты = Новый Соответствие;
+	КонецЕсли;
+
+	План = Неопределено;
+	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
+		Состояние.Свойство("План", План);
+	КонецЕсли;
+	БлокПлана = БлокПланаПромпта(План);
+	Если Не ПустаяСтрока(БлокПлана) Тогда
+		Блоки.Добавить(БлокПлана);
+	КонецЕсли;
+
+	БлокИнструментов = БлокИнструментовПромпта(ДоступныеИнструменты, ВызванныеИнструменты);
+	Если Не ПустаяСтрока(БлокИнструментов) Тогда
+		Блоки.Добавить(БлокИнструментов);
+	КонецЕсли;
+
+	Если ЗначениеБулево(Состояние, "ПредложитьСменуПодхода") Тогда
+		Блоки.Добавить(НСтр("ru = 'Ты повторил тот же ответ. Пересмотри цель и инструменты,
+			|которые ещё не вызывал; попробуй другой подход. Если цель недостижима -
+			|объясни это в итоговом ответе, сославшись на результаты вызовов.';
+			|en = 'You repeated the same answer. Review the goal and the tools you
+			|have not called yet; try a different approach. If the goal is
+			|unachievable - explain that in your final answer, referencing the
+			|call results.'"));
+	КонецЕсли;
+
+	Блоки.Добавить(НСтр("ru = 'Сверь цель, текущее состояние и инструменты; выполни
+		|недостающие действия; если цель недостижима - дай итоговый ответ с
+		|причиной и подтверждением фактами вызовов; не повторяй вызовы с теми же
+		|аргументами.';
+		|en = 'Compare the goal, the current state and the tools; perform the
+		|missing actions; if the goal is unachievable - give a final answer with
+		|the reason and facts of the calls; do not repeat calls with the same
+		|arguments.'"));
+
+	Возврат УсечьТекст(СтрСоединить(Блоки, Символы.ПС + Символы.ПС), ЛимитПромптаПродолжения());
+
+КонецФункции
+
@@ -282,0 +374,7 @@
+// agentrunner-68: цель берется по текущему запросу (СформироватьЦель), ответ
+// надзора несет класс/причину/missing (РазобратьОтветНадзора), payload событий
+// и служебный лог пополняются деталями решения (pass/actions/source/class/
+// reason/missing/model/tokens/duration/answer/messages), а при вердикте
+// "Продолжить" текст missing (или причина дешевой проверки) кладется в
+// Состояние.ПоследнееНеСделано - его читает ТекстПродолженияНадзора.
+//
@@ -304,0 +403,8 @@
