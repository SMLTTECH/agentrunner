// Служебный модуль для дымовых тестов открытия форм расширения
// (см. ДТОткрытиеФормРасширения). Собирает формы объектов расширения
// из объединённых метаданных базы: объекты расширения находятся в общих
// коллекциях и отбираются методом РасширениеКонфигурации().
//
// Формы объектов адресуются дескриптором основной формы (ФормаОбъекта,
// ФормаСписка, Форма, ФормаЗаписи, ...) - с произвольными именами форм
// ПолучитьФорму из чужого расширения не работает («Неизвестное имя формы»).
// Формы, имя которых не совпадает со стандартным именем основной формы,
// не включаются в прогон (запись в журнале).

#Область СлужебныйПрограммныйИнтерфейс

// Формы расширения, доступные текущему пользователю.
//
// Параметры:
//   ИмяРасширения - Строка - имя расширения, как оно зарегистрировано в базе.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Коллекция    - Строка - имя коллекции метаданных (Справочники, Обработки, ...)
//     * Объект       - Строка - имя объекта метаданных (ar_Агенты) или общей формы
//     * ИмяФормы     - Строка - имя формы в метаданных
//     * ПутьФормы    - Строка - путь формы в метаданных (Справочник.ar_Агенты.ФормаЭлемента)
//     * ПолноеИмя    - Строка - адрес формы для ПолучитьФорму (Справочник.ar_Агенты.ФормаОбъекта)
Функция ФормыРасширения(Знач ИмяРасширения) Экспорт

	Формы = Новый Массив;

	Коллекции = КоллекцииСФормами();

	Для Каждого ИмяКоллекции Из Коллекции.Имена Цикл

		КоличествоФормКоллекции = 0;

		Для Каждого ОбъектМетаданных Из Метаданные[ИмяКоллекции] Цикл

			Если НЕ ЭтоОбъектРасширения(ОбъектМетаданных, ИмяРасширения)
				ИЛИ НЕ ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
				Продолжить;
			КонецЕсли;

			ПутьОбъекта = СтрШаблон("%1.%2", Коллекции.Префиксы[ИмяКоллекции], ОбъектМетаданных.Имя);

			Для Каждого Форма Из ОбъектМетаданных.Формы Цикл

				Дескриптор = ДескрипторФормы(Форма.Имя);

				Если Дескриптор = "" Тогда
					ЮТЛогирование.Предупреждение(СтрШаблон("ДТОткрытиеФормРасширения: форма %1.%2 пропущена - имя формы не является стандартным именем основной формы", ПутьОбъекта, Форма.Имя));
					Продолжить;
				КонецЕсли;

				Формы.Добавить(ОписаниеФормы(ИмяКоллекции, ОбъектМетаданных.Имя, Форма.Имя,
					СтрШаблон("%1.%2", ПутьОбъекта, Форма.Имя),
					СтрШаблон("%1.%2", ПутьОбъекта, Дескриптор)));
				КоличествоФормКоллекции = КоличествоФормКоллекции + 1;

			КонецЦикла;

		КонецЦикла;

		ЮТЛогирование.Отладка(СтрШаблон("ДТОткрытиеФормРасширения: %1 - найдено форм: %2", ИмяКоллекции, КоличествоФормКоллекции));

	КонецЦикла;

	// Общие формы права "Просмотр" не имеют - проверяются без отбора по правам.
	КоличествоОбщихФорм = 0;
	Для Каждого ОбщаяФорма Из Метаданные.ОбщиеФормы Цикл

		Если НЕ ЭтоОбъектРасширения(ОбщаяФорма, ИмяРасширения) Тогда
			Продолжить;
		КонецЕсли;

		Формы.Добавить(ОписаниеФормы("ОбщиеФормы", ОбщаяФорма.Имя, ОбщаяФорма.Имя,
			СтрШаблон("ОбщаяФорма.%1", ОбщаяФорма.Имя),
			СтрШаблон("ОбщаяФорма.%1", ОбщаяФорма.Имя)));
		КоличествоОбщихФорм = КоличествоОбщихФорм + 1;

	КонецЦикла;

	ЮТЛогирование.Отладка(СтрШаблон("ДТОткрытиеФормРасширения: ОбщиеФормы - найдено форм: %1", КоличествоОбщихФорм));
	ЮТЛогирование.Отладка(СтрШаблон("ДТОткрытиеФормРасширения: всего форм расширения %1: %2", ИмяРасширения, Формы.Количество()));

	Возврат Формы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Стандартное имя формы объекта переводится в дескриптор основной формы -
// адрес вида <Тип>.<Объект>.<Дескриптор> понимается из любого расширения.
//
// Параметры:
//   ИмяФормы - Строка - имя формы в метаданных.
//
// Возвращаемое значение:
//   Строка - дескриптор формы; пустая строка для произвольных имён.
Функция ДескрипторФормы(Знач ИмяФормы)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ФормаЭлемента", "ФормаОбъекта");
	Соответствие.Вставить("ФормаДокумента", "ФормаОбъекта");
	Соответствие.Вставить("ФормаОбъекта", "ФормаОбъекта");
	Соответствие.Вставить("ФормаСписка", "ФормаСписка");
	Соответствие.Вставить("ФормаВыбора", "ФормаВыбора");
	Соответствие.Вставить("ФормаВыбораГруппы", "ФормаВыбораГруппы");
	Соответствие.Вставить("ФормаГруппы", "ФормаГруппы");
	Соответствие.Вставить("ФормаЗаписи", "ФормаЗаписи");
	Соответствие.Вставить("ФормаОбработки", "Форма");
	Соответствие.Вставить("ФормаОтчета", "Форма");
	Соответствие.Вставить("ФормаОтчёта", "Форма");
	Соответствие.Вставить("Форма", "Форма");
	Соответствие.Вставить("ФормаНастроек", "ФормаНастроек");
	Соответствие.Вставить("ФормаВарианта", "ФормаВарианта");

	Значение = Соответствие.Получить(ИмяФормы);

	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

Функция КоллекцииСФормами()

	Имена = Новый Массив;
	Имена.Добавить("Справочники");
	Имена.Добавить("Документы");
	Имена.Добавить("Обработки");
	Имена.Добавить("Отчеты");
	Имена.Добавить("РегистрыСведений");
	Имена.Добавить("РегистрыНакопления");

	Префиксы = Новый Структура;
	Префиксы.Вставить("Справочники", "Справочник");
	Префиксы.Вставить("Документы", "Документ");
	Префиксы.Вставить("Обработки", "Обработка");
	Префиксы.Вставить("Отчеты", "Отчет");
	Префиксы.Вставить("РегистрыСведений", "РегистрСведений");
	Префиксы.Вставить("РегистрыНакопления", "РегистрНакопления");

	Возврат Новый Структура("Имена, Префиксы", Имена, Префиксы);

КонецФункции

Функция ЭтоОбъектРасширения(ОбъектМетаданных, Знач ИмяРасширения)

	Расширение = ОбъектМетаданных.РасширениеКонфигурации();

	Возврат Расширение <> Неопределено
		И СтрСравнить(Расширение.Имя, ИмяРасширения) = 0;

КонецФункции

Функция ОписаниеФормы(Коллекция, Объект, ИмяФормы, ПутьФормы, ПолноеИмя)

	Описание = Новый Структура;
	Описание.Вставить("Коллекция", Коллекция);
	Описание.Вставить("Объект", Объект);
	Описание.Вставить("ИмяФормы", ИмяФормы);
	Описание.Вставить("ПутьФормы", ПутьФормы);
	Описание.Вставить("ПолноеИмя", ПолноеИмя);

	Возврат Описание;

КонецФункции

#КонецОбласти
