// Дымовые тесты открытия форм расширения AgentRunner.
//
// Дополняет стандартный ДТОткрытиеФорм: тот обходит метаданные без привязки
// к расширению и формы ar_* не регистрирует. Здесь список форм берётся из
// метаданных расширения (см. ДТОткрытиеФормРасширенияСлужебныйВызовСервера)
// и каждая форма проверяется циклом «получить - открыть - обновить - закрыть».
//
// Формы открываются с параметром «АвтоТест» - единый паттерн форм расширения:
// ПриСозданииНаСервере пропускает инициализацию, зависящую от данных
// и состояния мастера настройки.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.Настроить(ЮТАлюр
		.Epic("Дымовые тесты")
		.ParentSuite("Дымовые тесты")
		.Feature("Открытие форм расширения"));

	ЮТТесты.ВТранзакции().УдалениеТестовыхДанных();

	ФормыРасширения = ДТОткрытиеФормРасширенияСлужебныйВызовСервера.ФормыРасширения(ИмяРасширения());

	Если ФормыРасширения.Количество() = 0 Тогда
		ЮТЛогирование.Предупреждение(СтрШаблон("Расширение %1 не подключено к базе или не содержит доступных форм - тесты открытия форм не зарегистрированы", ИмяРасширения()));
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеФормы Из ФормыРасширения Цикл

		ЮТТесты.ДобавитьКлиентскийТест("ОткрытьФормуРасширения", ОписаниеФормы.ПутьФормы, ЮТКоллекции.ЗначениеВМассиве("ФормыРасширения"))
			.Настроить(ЮТАлюр
				.Story(ОписаниеФормы.ПутьФормы)
				.SubSuite(ОписаниеФормы.Коллекция)
				.Package("Smoke.ДТОткрытиеФормРасширения." + ОписаниеФормы.Коллекция + "." + ОписаниеФормы.Объект))
			.СПараметрами(ОписаниеФормы);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ОткрытьФормуРасширения(ОписаниеФормы) Экспорт

	ЮТЛогирование.Отладка("Открытие формы расширения: " + ОписаниеФормы.ПутьФормы + " по адресу " + ОписаниеФормы.ПолноеИмя);

	// АвтоТест - пропуск инициализации в ПриСозданииНаСервере (паттерн форм расширения).
	ПараметрыОткрытия = Новый Структура("АвтоТест", Истина);

	Попытка
		//@skip-check use-non-recommended-method
		Форма = ПолучитьФорму(ОписаниеФормы.ПолноеИмя, ПараметрыОткрытия, , Новый УникальныйИдентификатор); // BSLLS:GetFormMethod-off
	Исключение
		ЮТРегистрацияОшибок.ДобавитьПояснениеОшибки("Ошибка получения (создания) формы " + ОписаниеФормы.ПутьФормы);
		ВызватьИсключение;
	КонецПопытки;

	ЮТест.ОжидаетЧто(Форма)
		.НеРавно(Неопределено, "Не удалось получить форму");

	Попытка
		Форма.Открыть();
	Исключение
		ЮТРегистрацияОшибок.ДобавитьПояснениеОшибки("Ошибка открытия формы");
		ВызватьИсключение;
	КонецПопытки;

	ЮТест.ОжидаетЧто(Форма.Открыта(), "Не удалось открыть форму")
		.ЭтоИстина();

	Попытка
		Форма.ОбновитьОтображениеДанных();
	Исключение
		ЮТРегистрацияОшибок.ДобавитьПояснениеОшибки("Ошибка обновления данных формы");
		ВызватьИсключение;
	КонецПопытки;

	Форма.Модифицированность = Ложь;
	Попытка
		Форма.Закрыть();
	Исключение
		ЮТРегистрацияОшибок.ДобавитьПояснениеОшибки("Ошибка закрытия формы");
		ВызватьИсключение;
	КонецПопытки;

	ЮТест.ОжидаетЧто(Форма.Открыта(), "Не удалось закрыть форму")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяРасширения()

	Возврат "AgentRunner";

КонецФункции

#КонецОбласти
