///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Надзор.
//
// Тесты надзора (ar_Надзор): РешитьПродолжатьЛи - вердикт не «Продолжить»
// (ЦельДостигнута) значит не продолжать; исчерпан бюджет (ШаговВсего >=
// МаксШагов) - эскалация; потолок 10 продолжений - эскалация safety_cap.
// agentrunner-377: дешевая проверка без LLM (ПроверитьДостижениеЦели -
// заявление о созданном объекте при мутирующих инструментах без действий
// = Продолжить без вызова LLM, source cheap_check) и разбор ответа
// LLM-надзора (классы, мусор в ответе) - через ПроверитьДостижениеЦели
// с ar_LLMMock.
//
// Сценарии раздела 8 из scenarios.md задачи agentrunner-27;
// дешевая проверка и разбор - критерии задачи agentrunner-377 (спека п. 2).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("РешенияПродолжения")
		.ДобавитьСерверныйТест("ЦельДостигнутаНеПродолжает").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИсчерпанБюджетЭскалация").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПотолокПродолженийЭскалация").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗафиксироватьЭскалациюБюджетаВозвращаетВердикт").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-54 ЦифрыЭскалации")
		.ДобавитьСерверныйТест("ЦифрыБюджетаВPayloadНадзорРешения").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-80-106 СлужебныйЛогНадзора")
		.ДобавитьСерверныйТест("СлоиЛогаНулевыеНеПустые").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЛогиНадзораПривязаныКЗапуску").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-377 ДешеваяПроверкаИРазборОтвета")
		.ДобавитьСерверныйТест("ЗаявлениеОСозданномБезДействийПродолжаетБезLLM")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("УспешноеМутирующееДействиеОтменяетДешевуюПроверку")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("РазборВердиктаВыполнено")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("РазборНечегоДелатьСПричинойДостигнута")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("РазборНечегоДелатьБезПричиныПродолжает")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("РазборНеВыполненоПродолжаетСНеСделано")
			.Тег("critical").ВТранзакции().После("ОчиститьMock")
		.ДобавитьСерверныйТест("РазборМусораВОтветеПродолжает")
			.Тег("critical").ВТранзакции().После("ОчиститьMock");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Вердикт ЦельДостигнута: Продолжать = Ложь, вердикт для записи сохранён.
Процедура ЦельДостигнутаНеПродолжает() Экспорт

	Контекст = ПодготовкаЗапуска();

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "ЦельДостигнута");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("ЦельДостигнута");

КонецПроцедуры

// Исчерпан бюджет (ШаговВсего >= МаксШагов): не продолжать, вердикт
// Эскалировать с причиной budget.
Процедура ИсчерпанБюджетЭскалация() Экспорт

	Контекст = ПодготовкаЗапуска();

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(20, 0), ДанныеАгента(20, 50), "Продолжить");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("Эскалировать");

КонецПроцедуры

// Потолок 10 продолжений: ПродолженийСделано = 10 -> эскалация safety_cap.
Процедура ПотолокПродолженийЭскалация() Экспорт

	Контекст = ПодготовкаЗапуска();
	УстановитьПродолженийСделано(Контекст.RunId, 10);

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "Продолжить");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("Эскалировать");

КонецПроцедуры

// ЗафиксироватьЭскалациюБюджета всегда возвращает "Эскалировать" и пишет
// событие надзора.
Процедура ЗафиксироватьЭскалациюБюджетаВозвращаетВердикт() Экспорт

	Контекст = ПодготовкаЗапуска();

	Вердикт = ar_Надзор.ЗафиксироватьЭскалациюБюджета(Контекст.RunId);

	ЮТест.ОжидаетЧто(Вердикт).Равно("Эскалировать");
	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Контекст.RunId, "supervisor_decision")).ЭтоИстина();

КонецПроцедуры

// agentrunner-54 кр. 1-2 (серверная часть): payload события НадзорРешение при
// эскалации бюджета несет цифры - steps/max_steps и limit="steps" при
// исчерпании шагов, limit="actions" при исчерпании действий.
Процедура ЦифрыБюджетаВPayloadНадзорРешения() Экспорт

	КонтекстШаги = ПодготовкаЗапуска();
	ar_Надзор.РешитьПродолжатьЛи(
		КонтекстШаги.RunId, Состояние(3, 0), ДанныеАгента(3, 50), "Продолжить");

	PayloadШаги = PayloadНадзорРешения(КонтекстШаги.RunId);
	ЮТест.ОжидаетЧто(PayloadШаги).Заполнено();
	ЮТест.ОжидаетЧто(ЗначениеPayload(PayloadШаги, "steps")).Равно(3)
		.Что(ЗначениеPayload(PayloadШаги, "max_steps")).Равно(3)
		.Что(Строка(ЗначениеPayload(PayloadШаги, "limit"))).Равно("steps");

	КонтекстДействия = ПодготовкаЗапуска();
	ar_Надзор.РешитьПродолжатьЛи(
		КонтекстДействия.RunId, Состояние(0, 2), ДанныеАгента(50, 2), "Продолжить");

	PayloadДействия = PayloadНадзорРешения(КонтекстДействия.RunId);
	ЮТест.ОжидаетЧто(PayloadДействия).Заполнено();
	ЮТест.ОжидаетЧто(ЗначениеPayload(PayloadДействия, "actions")).Равно(2)
		.Что(ЗначениеPayload(PayloadДействия, "max_actions")).Равно(2)
		.Что(Строка(ЗначениеPayload(PayloadДействия, "limit"))).Равно("actions");

КонецПроцедуры

// agentrunner-80 кр. 1 (серверная часть): служебный лог supervisor_layers
// печатает нулевые числа ("ЧН=0") - Потолок=0/10, шагов=0, действий=0 -
// без пустых значений.
Процедура СлоиЛогаНулевыеНеПустые() Экспорт

	Контекст = ПодготовкаЗапуска();

	ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "Продолжить");

	ЗаписиСлоев = ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(Контекст.RunId, "supervisor_layers");
	ЮТест.ОжидаетЧто(ЗаписиСлоев.Количество()).Больше(0);
	ТекстСлоев = Строка(ЗаписиСлоев[0].Текст);
	// Потолок - показание ПОСЛЕ инкремента первым же вызовом (1, а не 0);
	// критерий 80 - нулевые числа не пустые (Потолок=/10 отсутствует).
	ЮТест.ОжидаетЧто(СтрНайти(ТекстСлоев, "Потолок=1/10") > 0,
		"слои: " + ТекстСлоев).ЭтоИстина()
		.Что(СтрНайти(ТекстСлоев, "шагов=0, действий=0") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстСлоев, "Потолок=/10") = 0).ЭтоИстина();

КонецПроцедуры

// agentrunner-106 кр. 1 (серверная часть): записи надзора несут RunId своего
// запуска и не попадают в лог чужого запуска - у соседнего запуска записей
// supervisor_layers нет.
Процедура ЛогиНадзораПривязаныКЗапуску() Экспорт

	Контекст = ПодготовкаЗапуска();
	КонтекстСосед = ПодготовкаЗапуска();

	ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "Продолжить");

	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(Контекст.RunId, "supervisor_layers")
			.Количество()).Больше(0);
	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(КонтекстСосед.RunId, "supervisor_layers")
			.Количество()).Равно(0);

КонецПроцедуры

// Очистка сценария заглушки после теста (состояние ar_LLMMock живёт в
// ХранилищеОбщихНастроек - вне транзакции теста).
Процедура ОчиститьMock() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-377 кр. 2: дешевая проверка без LLM - цель (инструкция агента)
// заявляет о созданном объекте, среди доступных инструментов есть мутирующие,
// действий запуска нет: вердикт Продолжить БЕЗ вызова LLM (счётчик заглушки
// 0), событие НадзорРешение с source = cheap_check.
Процедура ЗаявлениеОСозданномБезДействийПродолжаетБезLLM() Экспорт

	Подготовка = ПодготовкаЗапускаНадзора(
		"Разберись с поступлениями и отчитайся, что документ создан.");
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		СценарийОдногоОтвета(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));

	Вердикт = ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		СостояниеЦикла("Документ создан и проведён."),
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		ИнструментыСУровнемЗаписи());

	ЮТест.ОжидаетЧто(Вердикт).Равно("Продолжить");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки()).Равно(0);

	Payload = PayloadНадзорРешения(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Payload).Заполнено();
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(Payload, "source"))).Равно("cheap_check")
		.Что(Строка(ЗначениеPayload(Payload, "verdict"))).Равно("Продолжить");

КонецПроцедуры

// agentrunner-377 кр. 2 (контраст): то же заявление при успешном мутирующем
// действии запуска правдоподобно - дешевая проверка не срабатывает, ответ
// классифицирует LLM (счётчик заглушки 1), вердикт выполнено =
// ЦельДостигнута, событие с source = llm и class = выполнено.
Процедура УспешноеМутирующееДействиеОтменяетДешевуюПроверку() Экспорт

	Подготовка = ПодготовкаЗапускаНадзора(
		"Разберись с поступлениями и отчитайся, что документ создан.");
	ЗаписатьУспешноеДействиеЗаписи(Подготовка.RunId);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		СценарийОдногоОтвета(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));

	Вердикт = ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		СостояниеЦикла("Документ создан и проведён."),
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		ИнструментыСУровнемЗаписи());

	ЮТест.ОжидаетЧто(Вердикт).Равно("ЦельДостигнута");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки()).Равно(1);

	Payload = PayloadНадзорРешения(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Payload).Заполнено();
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(Payload, "source"))).Равно("llm")
		.Что(Строка(ЗначениеPayload(Payload, "class"))).Равно("выполнено");

КонецПроцедуры

// agentrunner-377 кр. 2: разбор ответа надзора, класс выполнено -
// ЦельДостигнута (решение фиксируется с source = llm).
Процедура РазборВердиктаВыполнено() Экспорт

	Вердикт = ВердиктНадзораСОтветом("{""class"": ""выполнено""}");

	ЮТест.ОжидаетЧто(Вердикт).Равно("ЦельДостигнута");

КонецПроцедуры

// agentrunner-377 кр. 2: класс нечего_делать с непустой причиной -
// ЦельДостигнута, причина попадает в payload события НадзорРешение.
Процедура РазборНечегоДелатьСПричинойДостигнута() Экспорт

	Ответы = Новый Массив;
	Ответы.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(
		"{""class"": ""нечего_делать"", ""reason"": ""данные уже актуальны""}"));
	Подготовка = ПодготовкаЗапускаНадзора("Проверь справочник контрагентов.");
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Ответы);

	Вердикт = ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		СостояниеЦикла("Справочник проверен."),
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		Неопределено);

	ЮТест.ОжидаетЧто(Вердикт).Равно("ЦельДостигнута");
	Payload = PayloadНадзорРешения(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(Payload, "source"))).Равно("llm")
		.Что(Строка(ЗначениеPayload(Payload, "class"))).Равно("нечего_делать")
		.Что(Строка(ЗначениеPayload(Payload, "reason"))).Равно("данные уже актуальны");

КонецПроцедуры

// agentrunner-377 кр. 2: класс нечего_делать без причины не приравнивается к
// достижению цели - Продолжить.
Процедура РазборНечегоДелатьБезПричиныПродолжает() Экспорт

	Вердикт = ВердиктНадзораСОтветом("{""class"": ""нечего_делать""}");

	ЮТест.ОжидаетЧто(Вердикт).Равно("Продолжить");

КонецПроцедуры

// agentrunner-377 кр. 2: класс не_выполнено - Продолжить, поле missing
// попадает в payload и в Состояние.ПоследнееНеСделано (для текста
// продолжения).
Процедура РазборНеВыполненоПродолжаетСНеСделано() Экспорт

	Ответы = Новый Массив;
	Ответы.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(
		"{""class"": ""не_выполнено"", ""missing"": ""нет подтверждения создания""}"));
	Подготовка = ПодготовкаЗапускаНадзора("Проверь справочник контрагентов.");
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Ответы);
	Состояние = СостояниеЦикла("Справочник проверен.");

	Вердикт = ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		Состояние,
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		Неопределено);

	ЮТест.ОжидаетЧто(Вердикт).Равно("Продолжить");
	Payload = PayloadНадзорРешения(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(Payload, "missing")))
		.Равно("нет подтверждения создания");
	ЮТест.ОжидаетЧто(Состояние).Свойство("ПоследнееНеСделано")
		.Равно("нет подтверждения создания");

КонецПроцедуры

// agentrunner-377 кр. 2: мусор вместо JSON в ответе надзора (СбойРазбора) -
// безопасный default Продолжить; сбой виден в служебном логе supervisor_llm.
Процедура РазборМусораВОтветеПродолжает() Экспорт

	Подготовка = ПодготовкаЗапускаНадзора("Проверь справочник контрагентов.");
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		СценарийОдногоОтвета("Всё в порядке, вопросов нет."));

	Вердикт = ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		СостояниеЦикла("Справочник проверен."),
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		Неопределено);

	ЮТест.ОжидаетЧто(Вердикт).Равно("Продолжить");

	СтрокиЛога = ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(
		Подготовка.RunId, "supervisor_llm");
	ЮТест.ОжидаетЧто(СтрокиЛога.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(
		СтрНайти(СтрокиЛога[0].Текст, "Сбой разбора") > 0,
		"лог: " + СтрокиЛога[0].Текст).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовка: агент, запись запуска.
//
Функция ПодготовкаЗапуска()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	Возврат Новый Структура("RunId", RunId);

КонецФункции

// Подготовка надзора с заданной инструкцией агента: провайдер-заглушка,
// агент, запись запуска.
//
// Параметры:
//  Инструкция - Строка - инструкция агента (текст цели надзора).
//
// Возвращаемое значение:
//  Структура - {RunId, Провайдер, Агент, Инструкция}.
//
Функция ПодготовкаЗапускаНадзора(Знач Инструкция)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура("Инструкция", Инструкция);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	Возврат Новый Структура("RunId, Провайдер, Агент, Инструкция",
		RunId, Провайдер, Агент, Инструкция);

КонецФункции

// Состояние цикла с результатом и нулевыми бюджетами.
//
Функция СостояниеЦикла(Знач Результат)

	Состояние = Новый Структура;
	Состояние.Вставить("Результат", Результат);
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("ШаговВсего", 0);
	Состояние.Вставить("ДействийВсего", 0);
	Возврат Состояние;

КонецФункции

// Данные агента для надзора: ссылка, инструкция, провайдер-заглушка, модель.
//
Функция ДанныеАгентаНадзора(Знач Подготовка)

	Возврат Новый Структура("Ссылка, Инструкция, LLMПровайдер, Модель",
		Подготовка.Агент, Подготовка.Инструкция, Подготовка.Провайдер, "mock-model");

КонецФункции

// Контекст триггера без запроса пользователя: цель надзора - инструкция
// агента (СформироватьЦель для не-manual триггеров).
//
Функция КонтекстТриггераНадзора()

	Возврат Новый Структура("Триггер", "cron");

КонецФункции

// Доступные инструменты запуска с одним мутирующим (уровень Запись).
//
Функция ИнструментыСУровнемЗаписи()

	Инструмент = Новый Структура("Имя, Риск", "тест_тул_запись",
		Строка(Перечисления.ar_УровеньРиска.Запись));
	Инструменты = Новый Массив;
	Инструменты.Добавить(Инструмент);
	Возврат Инструменты;

КонецФункции

// Успешное мутирующее действие запуска в ar_ДействияАгента (инструмент
// уровня Запись, без ошибки) - заявление о созданном объекте становится
// правдоподобным.
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
Процедура ЗаписатьУспешноеДействиеЗаписи(Знач RunId)

	Набор = РегистрыСведений.ar_ДействияАгента.СоздатьНаборЗаписей();
	Запись = Набор.Добавить();
	Запись.ar_ИдентификаторЗапуска = RunId;
	Запись.ar_Последовательность = 1;
	Запись.ar_ИмяИнструмента = "тест_тул_запись";
	Запись.ar_УровеньРиска = Перечисления.ar_УровеньРиска.Запись;
	Запись.ar_ЗавершёнСОшибкой = Ложь;
	Набор.Записать(Истина);

КонецПроцедуры

// Очередь ответов заглушки из одного текстового элемента.
//
Функция СценарийОдногоОтвета(Знач Содержание)

	Ответы = Новый Массив;
	Ответы.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(Содержание));
	Возврат Ответы;

КонецФункции

// Вердикт ПроверитьДостижениеЦели для ответа заглушки: цель без ключевых
// слов дешевой проверки - ответ классифицирует только LLM.
//
Функция ВердиктНадзораСОтветом(Знач Содержание)

	Подготовка = ПодготовкаЗапускаНадзора("Проверь справочник контрагентов.");
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(СценарийОдногоОтвета(Содержание));

	Возврат ar_Надзор.ПроверитьДостижениеЦели(
		Подготовка.RunId,
		СостояниеЦикла("Справочник проверен."),
		ДанныеАгентаНадзора(Подготовка),
		КонтекстТриггераНадзора(),
		Неопределено);

КонецФункции

// Состояние цикла с бюджетными счётчиками.
//
Функция Состояние(Знач ШаговВсего, Знач ДействийВсего)

	Состояние = Новый Структура;
	Состояние.Вставить("ШаговВсего", ШаговВсего);
	Состояние.Вставить("ДействийВсего", ДействийВсего);
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("Результат", "");
	Возврат Состояние;

КонецФункции

// Данные агента с бюджетами (0 - проверка пропускается).
//
Функция ДанныеАгента(Знач МаксШагов, Знач МаксДействий)

	ДанныеАгента = Новый Структура;
	ДанныеАгента.Вставить("МаксШагов", МаксШагов);
	ДанныеАгента.Вставить("МаксДействий", МаксДействий);
	Возврат ДанныеАгента;

КонецФункции

// Пишет ar_ПродолженийСделано в запись запуска (через штатное Создать с
// ключом счётчика).
//
Процедура УстановитьПродолженийСделано(Знач RunId, Знач Число)

	ДанныеСчётчика = Новый Структура;
	ДанныеСчётчика.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеСчётчика.Вставить("ПродолженийСделано", Число);
	ar_AuditЗапуски.Создать(RunId, ДанныеСчётчика);

КонецПроцедуры

// Payload последнего события НадзорРешение запуска (разобранный JSON).
//
Функция PayloadНадзорРешения(Знач RunId)

	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Если СтрокаСобытия.ТипСобытия = Перечисления.ar_ТипСобытия.НадзорРешение Тогда
			Возврат ar_JSON.ИзJSON(СтрокаСобытия.PayloadJSON);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Значение поля разобранного JSON (ИзJSON возвращает Соответствие или
// Структуру - читается одинаково без исключений).
//
Функция ЗначениеPayload(Знач Payload, Знач Ключ)

	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		Возврат Payload.Получить(Ключ);
	КонецЕсли;
	Значение = Неопределено;
	Если ТипЗнч(Payload) = Тип("Структура") Тогда
		Payload.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти
