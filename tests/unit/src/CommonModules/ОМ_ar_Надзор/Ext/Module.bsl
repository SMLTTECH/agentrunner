///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Надзор.
//
// Тесты надзора (ar_Надзор): РешитьПродолжатьЛи - вердикт не «Продолжить»
// (ЦельДостигнута) значит не продолжать; исчерпан бюджет (ШаговВсего >=
// МаксШагов) - эскалация; потолок 10 продолжений - эскалация safety_cap.
// ПроверитьДостижениеЦели не тестируется напрямую (вызывает LLM через
// диспетчер с контекстом запуска - покрыто интеграционными тестами цикла,
// раздел 1).
//
// Сценарии раздела 8 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("РешенияПродолжения")
		.ДобавитьСерверныйТест("ЦельДостигнутаНеПродолжает").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИсчерпанБюджетЭскалация").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПотолокПродолженийЭскалация").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗафиксироватьЭскалациюБюджетаВозвращаетВердикт").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Вердикт ЦельДостигнута: Продолжать = Ложь, вердикт для записи сохранён.
Процедура ЦельДостигнутаНеПродолжает() Экспорт

	Контекст = ПодготовкаЗапуска();

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "ЦельДостигнута");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("ЦельДостигнута");

КонецПроцедуры

// Исчерпан бюджет (ШаговВсего >= МаксШагов): не продолжать, вердикт
// Эскалировать с причиной budget.
Процедура ИсчерпанБюджетЭскалация() Экспорт

	Контекст = ПодготовкаЗапуска();

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(20, 0), ДанныеАгента(20, 50), "Продолжить");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("Эскалировать");

КонецПроцедуры

// Потолок 10 продолжений: ПродолженийСделано = 10 -> эскалация safety_cap.
Процедура ПотолокПродолженийЭскалация() Экспорт

	Контекст = ПодготовкаЗапуска();
	УстановитьПродолженийСделано(Контекст.RunId, 10);

	Решение = ar_Надзор.РешитьПродолжатьЛи(
		Контекст.RunId, Состояние(0, 0), ДанныеАгента(20, 50), "Продолжить");

	ЮТест.ОжидаетЧто(Решение).Свойство("Продолжать").ЭтоЛожь()
		.Свойство("ВердиктДляЗаписи").Равно("Эскалировать");

КонецПроцедуры

// ЗафиксироватьЭскалациюБюджета всегда возвращает "Эскалировать" и пишет
// событие надзора.
Процедура ЗафиксироватьЭскалациюБюджетаВозвращаетВердикт() Экспорт

	Контекст = ПодготовкаЗапуска();

	Вердикт = ar_Надзор.ЗафиксироватьЭскалациюБюджета(Контекст.RunId);

	ЮТест.ОжидаетЧто(Вердикт).Равно("Эскалировать");
	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Контекст.RunId, "supervisor_decision")).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовка: агент, запись запуска.
//
Функция ПодготовкаЗапуска()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	Возврат Новый Структура("RunId", RunId);

КонецФункции

// Состояние цикла с бюджетными счётчиками.
//
Функция Состояние(Знач ШаговВсего, Знач ДействийВсего)

	Состояние = Новый Структура;
	Состояние.Вставить("ШаговВсего", ШаговВсего);
	Состояние.Вставить("ДействийВсего", ДействийВсего);
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("Результат", "");
	Возврат Состояние;

КонецФункции

// Данные агента с бюджетами (0 - проверка пропускается).
//
Функция ДанныеАгента(Знач МаксШагов, Знач МаксДействий)

	ДанныеАгента = Новый Структура;
	ДанныеАгента.Вставить("МаксШагов", МаксШагов);
	ДанныеАгента.Вставить("МаксДействий", МаксДействий);
	Возврат ДанныеАгента;

КонецФункции

// Пишет ar_ПродолженийСделано в запись запуска (через штатное Создать с
// ключом счётчика).
//
Процедура УстановитьПродолженийСделано(Знач RunId, Знач Число)

	ДанныеСчётчика = Новый Структура;
	ДанныеСчётчика.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеСчётчика.Вставить("ПродолженийСделано", Число);
	ar_AuditЗапуски.Создать(RunId, ДанныеСчётчика);

КонецПроцедуры

#КонецОбласти
