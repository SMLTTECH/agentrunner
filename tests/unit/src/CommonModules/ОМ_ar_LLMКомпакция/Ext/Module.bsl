///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_LLMКомпакция.
//
// Тесты компакции контекста (ar_LLMКомпакция): НужнаКомпакция на границе
// окна, ОценкаЗаполненности, Применить - hard-компакция сохраняет системное
// сообщение и последние реплики, не разрывает пару «вызов инструмента -
// результат», ниже порога контекст не трогается.
//
// С agentrunner-67 (регресс agentrunner-65, критерий 4): двухуровневая
// компакция - уровень 1 сжимает старые результаты инструментов и длинные
// аргументы вызовов (переписка, ask_user и хвост не трогаются), уровень 2
// удаляет старые ходы со сводкой (первое/последнее сообщение пользователя,
// запрос запуска защищены; сводка одна, повторный вызов ее дополняет).
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27; уровни 1-2 из
// критерия 4 спеки agentrunner-65.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Компакция")
		.ДобавитьСерверныйТест("НужнаКомпакцияНаГраницеОкна").Тег("critical")
		.ДобавитьСерверныйТест("ОценкаЗаполненностиДоля").Тег("critical")
		.ДобавитьСерверныйТест("ПрименитьНижееПорогаНеТрогает").Тег("critical")
		.ДобавитьСерверныйТест("HardКомпакцияСохраняетСистемуИХвост").Тег("critical")
		.ДобавитьСерверныйТест("ПараВызовРезультатНеРазрывается").Тег("critical")
		.ДобавитьСерверныйТест("ПустойВходБезИсключения").Тег("critical")
		.ДобавитьТестовыйНабор("КомпакцияУровни")
		.ДобавитьСерверныйТест("Уровень1СжимаетРезультатыИнструментов").Тег("critical")
		.ДобавитьСерверныйТест("Уровень1ПерепискаИВопросНеТрогаются").Тег("critical")
		.ДобавитьСерверныйТест("Уровень1ДлинныеАргументыВызововСжимаются").Тег("critical")
		.ДобавитьСерверныйТест("Уровень2УдалениеХодовСводкой").Тег("critical")
		.ДобавитьСерверныйТест("Уровень2ПовторнаяКомпакцияДополняетСводку").Тег("critical");

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// НужнаКомпакция: Истина выше 0.7*MaxContext, Ложь ниже; пустой вход/окно -
// Ложь.
Процедура НужнаКомпакцияНаГраницеОкна() Экспорт

	Сообщения = БольшееОбщение();

	ЮТест.ОжидаетЧто(
		ar_LLMКомпакция.НужнаКомпакция(Сообщения, 100)).ЭтоИстина()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Сообщения, 100000)).ЭтоЛожь()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Новый Массив, 100)).ЭтоЛожь()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Сообщения, 0)).ЭтоЛожь();

КонецПроцедуры

// ОценкаЗаполненности: положительная доля, для пустого входа - 0.
Процедура ОценкаЗаполненностиДоля() Экспорт

	Сообщения = БольшееОбщение();

	Заполненность = ar_LLMКомпакция.ОценкаЗаполненности(Сообщения, 100);
	ЮТест.ОжидаетЧто(Заполненность).Больше(0.7);

	ЮТест.ОжидаетЧто(
		ar_LLMКомпакция.ОценкаЗаполненности(Новый Массив, 100)).Равно(0);

КонецПроцедуры

// Ниже порога Применить возвращает копию без компакции.
Процедура ПрименитьНижееПорогаНеТрогает() Экспорт

	Сообщения = КороткоеОбщение();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 100000);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоЛожь()
		.Свойство("ТипКомпакции").Равно("none")
		.Свойство("УдаленоСообщений").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Равно(Сообщения.Количество());

КонецПроцедуры

// Hard-компакция (> 0.9*MaxContext) сохраняет лидирующие system и последние
// реплики, уменьшая объём.
Процедура HardКомпакцияСохраняетСистемуИХвост() Экспорт

	Сообщения = БольшееОбщение();
	ЧислоДо = Сообщения.Количество();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 60);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("ТипКомпакции").Равно("hard")
		.Свойство("УдаленоСообщений").Больше(0);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Меньше(ЧислоДо);

	Первое = Результат.Сообщения[0];
	ЮТест.ОжидаетЧто(Первое.role).Равно("system");

	Последнее = Результат.Сообщения[Результат.Сообщения.Количество() - 1];
	ЮТест.ОжидаетЧто(Последнее.content).Равно(Сообщения[ЧислоДо - 1].content);

КонецПроцедуры

// Пара «вызов инструмента - результат» не разрывается: после сообщения role
// = "tool" в компактном контексте всегда стоит преемник его tool_calls.
Процедура ПараВызовРезультатНеРазрывается() Экспорт

	Сообщения = ОбщениеСИнструментами();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 60);

	СообщенияПосле = Результат.Сообщения;
	Для Индекс = 1 По СообщенияПосле.Количество() - 1 Цикл
		Если СообщенияПосле[Индекс].role = "tool" Тогда
			Предыдущее = СообщенияПосле[Индекс - 1];
			ЮТест.ОжидаетЧто(Предыдущее.role).Равно("assistant");
			ЮТест.ОжидаетЧто(Предыдущее.Свойство("tool_calls")).ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пустой вход / неверное окно - копия без компакции, без исключения.
Процедура ПустойВходБезИсключения() Экспорт

	Результат = ar_LLMКомпакция.Применить(Неопределено, 100);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("БылаКомпакция").ЭтоЛожь();

	РезультатБезОкна = ar_LLMКомпакция.Применить(КороткоеОбщение(), Неопределено);
	ЮТест.ОжидаетЧто(РезультатБезОкна.БылаКомпакция).ЭтоЛожь();

КонецПроцедуры

// Уровень 1 (критерий 4 спеки agentrunner-65): большие результаты
// инструментов вне хвоста сжаты (признак ar_Сокращено, ид вызова сохранен,
// в тексте имя инструмента, итог, размер, выжимка ключей JSON); ошибка
// {"error":...} попадает в итог; переписка, ask_user и хвост не тронуты;
// удаления и сводки нет; исходный массив не изменен.
Процедура Уровень1СжимаетРезультатыИнструментов() Экспорт

	Сообщения = ДиалогУровня1();
	Окно = ОкноПодКомпакцию(Сообщения);

	Результат = ar_LLMКомпакция.Применить(Сообщения, Окно);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("СжатоРезультатов").Равно(2)
		.Свойство("УдаленоСообщений").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ОценкаПосле).Меньше(Результат.ОценкаДо);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Равно(Сообщения.Количество());
	ЮТест.ОжидаетЧто(ЧислоСводок(Результат.Сообщения)).Равно(0);

	// Сжатый результат: признак, ид вызова, имя инструмента, итог, выжимка.
	Сжатый = Результат.Сообщения[3];
	ЮТест.ОжидаетЧто(ЭтоСжатое(Сжатый)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Сжатый.tool_call_id).Равно("call-1");
	ЮТест.ОжидаетЧто(СтрНайти(Сжатый.content, "read_data")).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(Сжатый.content, "успешно")).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(Сжатый.content, "rows (3)")).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(Сжатый.content, Лев(БольшойРезультатИнструмента(), 50))).Больше(0);
	ЮТест.ОжидаетЧто(
		СтрНайти(Сжатый.content, Формат(СтрДлина(БольшойРезультатИнструмента()), "ЧГ=0") + " знаков")).Больше(0);

	// Ошибка {"error":...} попадает в итог сжатого результата.
	СжатыйСОшибкой = Результат.Сообщения[5];
	ЮТест.ОжидаетЧто(ЭтоСжатое(СжатыйСОшибкой)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СжатыйСОшибкой.tool_call_id).Равно("call-2");
	ЮТест.ОжидаетЧто(СтрНайти(СжатыйСОшибкой.content, "ошибка")).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(СжатыйСОшибкой.content, "отклонил")).Больше(0);

	// Хвост (последние 4 сообщения) и переписка остались как были.
	ЮТест.ОжидаетЧто(Результат.Сообщения[7].content).Равно(БольшойРезультатИнструмента());
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[7])).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Сообщения[8].tool_calls[0].function.name).Равно("ask_user");
	ЮТест.ОжидаетЧто(Результат.Сообщения[9].content).Равно(ОтветВопроса());
	ЮТест.ОжидаетЧто(Результат.Сообщения[1].content).Равно("Задача: верни сводку данных.");
	ЮТест.ОжидаетЧто(Результат.Сообщения[10].content).Равно("Сколько строк в данных?");

	// Исходный массив и его элементы не изменены.
	ЮТест.ОжидаетЧто(Сообщения.Количество()).Равно(11);
	ЮТест.ОжидаетЧто(Сообщения[3].content).Равно(БольшойРезультатИнструмента());
	ЮТест.ОжидаетЧто(ЭтоСжатое(Сообщения[3])).ЭтоЛожь();

КонецПроцедуры

// Уровень 1: переписка (user, текст assistant, пара ask_user с вопросом и
// ответом человека) не сжимается, даже когда длиннее порога; сжаты только
// результаты инструментов.
Процедура Уровень1ПерепискаИВопросНеТрогаются() Экспорт

	Сообщения = ДиалогПереписки();
	Окно = ОкноПодКомпакцию(Сообщения);

	Результат = ar_LLMКомпакция.Применить(Сообщения, Окно);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("СжатоРезультатов").Равно(2)
		.Свойство("УдаленоСообщений").Равно(0);
	ЮТест.ОжидаетЧто(ЧислоСводок(Результат.Сообщения)).Равно(0);

	// Реплики пользователя и текст ответа assistant сохранены.
	ЮТест.ОжидаетЧто(Результат.Сообщения[1].content).Равно("Задача: повтори мою следующую реплику.");
	ЮТест.ОжидаетЧто(Результат.Сообщения[6].content).Равно(ДлиннаяРеплика("ПОВТОР"));
	ЮТест.ОжидаетЧто(Результат.Сообщения[7].content).Равно("Спроси у меня любимый цвет.");
	ЮТест.ОжидаетЧто(Результат.Сообщения[10].content).Равно("Что я ответил?");
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[6])).ЭтоЛожь();

	// Пара ask_user: длинные вопрос и ответ человека не сжаты.
	ЮТест.ОжидаетЧто(Результат.Сообщения[8].tool_calls[0].function.name).Равно("ask_user");
	ЮТест.ОжидаетЧто(Результат.Сообщения[8].tool_calls[0].function.arguments).Равно(ДлинныйВопросПользователю());
	ЮТест.ОжидаетЧто(Результат.Сообщения[9].content).Равно(ОтветВопроса());
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[8])).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[9])).ЭтоЛожь();

	// Сжаты только результаты инструментов read_data.
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[3])).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[5])).ЭтоИстина();

КонецПроцедуры

// Уровень 1: длинные аргументы вызова инструмента сжимаются в валидный JSON
// (разбирается ar_JSON.ИзJSON, ключ "сокращено"), ид вызова и имя инструмента
// сохранены; длинные аргументы ask_user не сжимаются.
Процедура Уровень1ДлинныеАргументыВызововСжимаются() Экспорт

	Сообщения = ДиалогАргументов();
	Окно = ОкноПодКомпакцию(Сообщения);

	Результат = ar_LLMКомпакция.Применить(Сообщения, Окно);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("СжатоРезультатов").Равно(1)
		.Свойство("УдаленоСообщений").Равно(0);
	ЮТест.ОжидаетЧто(ЧислоСводок(Результат.Сообщения)).Равно(0);

	// Сжатый вызов: ид и имя сохранены, аргументы - валидный JSON.
	СжатыйВызов = Результат.Сообщения[2];
	ЮТест.ОжидаетЧто(ЭтоСжатое(СжатыйВызов)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СжатыйВызов.tool_calls.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(СжатыйВызов.tool_calls[0].id).Равно("call-1");
	ЮТест.ОжидаетЧто(СжатыйВызов.tool_calls[0].function.name).Равно("read_data");
	Разбор = ar_JSON.ИзJSON(СжатыйВызов.tool_calls[0].function.arguments);
	ЮТест.ОжидаетЧто(ТипЗнч(Разбор)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(СтрДлина(Строка(Разбор.Получить("сокращено"))) > 0).ЭтоИстина();

	// Длинные аргументы ask_user и результат в хвосте не тронуты.
	ЮТест.ОжидаетЧто(Результат.Сообщения[6].tool_calls[0].function.arguments).Равно(ДлинныйВопросПользователю());
	ЮТест.ОжидаетЧто(ЭтоСжатое(Результат.Сообщения[6])).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Сообщения[5].content).Равно(БольшойРезультатИнструмента());

КонецПроцедуры

// Уровень 2 (окно, в которое не помещается и переписка): ходы с вызовами
// инструментов удаляются раньше переписки; первое сообщение пользователя,
// запрос запуска и последнее сообщение пользователя сохранены; ровно одна
// сводка; протокол tool не нарушен (нет результата без своего вызова).
Процедура Уровень2УдалениеХодовСводкой() Экспорт

	Сообщения = ДиалогУровня2();
	Окно = ОкноПодКомпакцию(Сообщения);

	Результат = ar_LLMКомпакция.Применить(Сообщения, Окно);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("СжатоРезультатов").Равно(0);
	ЮТест.ОжидаетЧто(Результат.УдаленоСообщений).Больше(0);
	ЮТест.ОжидаетЧто(ЧислоСводок(Результат.Сообщения)).Равно(1);

	// Защищенные сообщения пользователя сохранены.
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, "Задача: запомни число 4711")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, "ЗАПРОС ТЕКУЩЕГО ЗАПУСКА")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, "УТОЧНЕНИЕ ПОСЛЕ ЗАПРОСА")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, ОтветВопроса())).ЭтоИстина();

	// Ходы с инструментами удалены раньше переписки: переписка 1 удалена -
	// значит, удалены и все четыре хода read_data.
	Сводка = СводкаКомпакции(Результат.Сообщения);
	ЮТест.ОжидаетЧто(Сводка = Неопределено).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, "ПЕРЕПИСКА1")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ВызововИнструментаВСводке(Сводка.ar_ДанныеСводки, "read_data")).Равно(4);
	ЮТест.ОжидаетЧто(ЕстьТекст(Результат.Сообщения, "ПЕРЕПИСКА3")).ЭтоИстина();

	// Протокол tool не нарушен: нет результата без предшествующего вызова.
	ЮТест.ОжидаетЧто(ЕстьВисячийРезультат(Результат.Сообщения)).ЭтоЛожь();

КонецПроцедуры

// Повторная компакция того же диалога (после добора истории) не создает
// вторую сводку: сводка одна, накопленные данные (Удалено) растут.
Процедура Уровень2ПовторнаяКомпакцияДополняетСводку() Экспорт

	Сообщения = ДиалогУровня2();
	Окно = ОкноПодКомпакцию(Сообщения);

	РезультатПервый = ar_LLMКомпакция.Применить(Сообщения, Окно);
	СводкаПервая = СводкаКомпакции(РезультатПервый.Сообщения);
	ЮТест.ОжидаетЧто(СводкаПервая = Неопределено).ЭтоЛожь();
	УдаленоРанее = СводкаПервая.ar_ДанныеСводки.Удалено;

	// Пользователь продолжает диалог: добавляются новые ходы.
	СообщенияПосле = РезультатПервый.Сообщения;
	СообщенияПосле.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), ДлиннаяРеплика("ДОБАВЛЕНО")));
	СообщенияПосле.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольAssistant(), ДлиннаяРеплика("ОТВЕТ ДОБАВЛЕН")));

	РезультатВторой = ar_LLMКомпакция.Применить(СообщенияПосле, Окно);

	ЮТест.ОжидаетЧто(РезультатВторой.БылаКомпакция).ЭтоИстина();
	ЮТест.ОжидаетЧто(РезультатВторой.УдаленоСообщений).Больше(0);
	ЮТест.ОжидаетЧто(ЧислоСводок(РезультатВторой.Сообщения)).Равно(1);

	СводкаВторая = СводкаКомпакции(РезультатВторой.Сообщения);
	ЮТест.ОжидаетЧто(СводкаВторая = Неопределено).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СводкаВторая.ar_ДанныеСводки.Удалено).Больше(УдаленоРанее);

	// Защищенные сообщения и новый ход сохранены, протокол не нарушен.
	ЮТест.ОжидаетЧто(ЕстьТекст(РезультатВторой.Сообщения, "Задача: запомни число 4711")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьТекст(РезультатВторой.Сообщения, "ЗАПРОС ТЕКУЩЕГО ЗАПУСКА")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьТекст(РезультатВторой.Сообщения, "ДОБАВЛЕНО")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьВисячийРезультат(РезультатВторой.Сообщения)).ЭтоЛожь();

КонецПроцедуры

