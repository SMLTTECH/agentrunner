///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_LLMКомпакция.
//
// Тесты компакции контекста (ar_LLMКомпакция): НужнаКомпакция на границе
// окна, ОценкаЗаполненности, Применить - hard-компакция сохраняет системное
// сообщение и последние реплики, не разрывает пару «вызов инструмента -
// результат», ниже порога контекст не трогается.
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Компакция")
		.ДобавитьСерверныйТест("НужнаКомпакцияНаГраницеОкна").Тег("critical")
		.ДобавитьСерверныйТест("ОценкаЗаполненностиДоля").Тег("critical")
		.ДобавитьСерверныйТест("ПрименитьНижееПорогаНеТрогает").Тег("critical")
		.ДобавитьСерверныйТест("HardКомпакцияСохраняетСистемуИХвост").Тег("critical")
		.ДобавитьСерверныйТест("ПараВызовРезультатНеРазрывается").Тег("critical")
		.ДобавитьСерверныйТест("ПустойВходБезИсключения").Тег("critical");

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// НужнаКомпакция: Истина выше 0.7*MaxContext, Ложь ниже; пустой вход/окно -
// Ложь.
Процедура НужнаКомпакцияНаГраницеОкна() Экспорт

	Сообщения = БольшееОбщение();

	ЮТест.ОжидаетЧто(
		ar_LLMКомпакция.НужнаКомпакция(Сообщения, 100)).ЭтоИстина()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Сообщения, 100000)).ЭтоЛожь()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Новый Массив, 100)).ЭтоЛожь()
		.Что(ar_LLMКомпакция.НужнаКомпакция(Сообщения, 0)).ЭтоЛожь();

КонецПроцедуры

// ОценкаЗаполненности: положительная доля, для пустого входа - 0.
Процедура ОценкаЗаполненностиДоля() Экспорт

	Сообщения = БольшееОбщение();

	Заполненность = ar_LLMКомпакция.ОценкаЗаполненности(Сообщения, 100);
	ЮТест.ОжидаетЧто(Заполненность).Больше(0.7);

	ЮТест.ОжидаетЧто(
		ar_LLMКомпакция.ОценкаЗаполненности(Новый Массив, 100)).Равно(0);

КонецПроцедуры

// Ниже порога Применить возвращает копию без компакции.
Процедура ПрименитьНижееПорогаНеТрогает() Экспорт

	Сообщения = КороткоеОбщение();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 100000);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоЛожь()
		.Свойство("ТипКомпакции").Равно("none")
		.Свойство("УдаленоСообщений").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Равно(Сообщения.Количество());

КонецПроцедуры

// Hard-компакция (> 0.9*MaxContext) сохраняет лидирующие system и последние
// реплики, уменьшая объём.
Процедура HardКомпакцияСохраняетСистемуИХвост() Экспорт

	Сообщения = БольшееОбщение();
	ЧислоДо = Сообщения.Количество();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 60);

	ЮТест.ОжидаетЧто(Результат).Свойство("БылаКомпакция").ЭтоИстина()
		.Свойство("ТипКомпакции").Равно("hard")
		.Свойство("УдаленоСообщений").Больше(0);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Меньше(ЧислоДо);

	Первое = Результат.Сообщения[0];
	ЮТест.ОжидаетЧто(Первое.role).Равно("system");

	Последнее = Результат.Сообщения[Результат.Сообщения.Количество() - 1];
	ЮТест.ОжидаетЧто(Последнее.content).Равно(Сообщения[ЧислоДо - 1].content);

КонецПроцедуры

// Пара «вызов инструмента - результат» не разрывается: после сообщения role
// = "tool" в компактном контексте всегда стоит преемник его tool_calls.
Процедура ПараВызовРезультатНеРазрывается() Экспорт

	Сообщения = ОбщениеСИнструментами();

	Результат = ar_LLMКомпакция.Применить(Сообщения, 60);

	СообщенияПосле = Результат.Сообщения;
	Для Индекс = 1 По СообщенияПосле.Количество() - 1 Цикл
		Если СообщенияПосле[Индекс].role = "tool" Тогда
			Предыдущее = СообщенияПосле[Индекс - 1];
			ЮТест.ОжидаетЧто(Предыдущее.role).Равно("assistant");
			ЮТест.ОжидаетЧто(Предыдущее.Свойство("tool_calls")).ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пустой вход / неверное окно - копия без компакции, без исключения.
Процедура ПустойВходБезИсключения() Экспорт

	Результат = ar_LLMКомпакция.Применить(Неопределено, 100);
	ЮТест.ОжидаетЧто(Результат.Сообщения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("БылаКомпакция").ЭтоЛожь();

	РезультатБезОкна = ar_LLMКомпакция.Применить(КороткоеОбщение(), Неопределено);
	ЮТест.ОжидаетЧто(РезультатБезОкна.БылаКомпакция).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Большой диалог (системное + 12 длинных user/assistant реплик): латиница
// 3.5 симв/токен, строка 300 символов ~ 86 токенов + 4.
//
Функция БольшееОбщение()

	ДлинныйТекст = ПовторитьСтроку("abcdefghij", 30);

	Сообщения = Новый Массив;
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольSystem(), "Ты тестовый агент."));
	Для Сч = 1 По 12 Цикл
		Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
			ar_LLMКонтракт.РольUser(), ДлинныйТекст));
		Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
			ar_LLMКонтракт.РольAssistant(), ДлинныйТекст));
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

// Короткий диалог (2 реплики) - заведомо ниже порогов.
//
Функция КороткоеОбщение()

	Сообщения = Новый Массив;
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольSystem(), "Ты тестовый агент."));
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), "привет"));
	Возврат Сообщения;

КонецФункции

// Диалог с историей вызова инструмента: assistant(tool_calls) + tool.
//
Функция ОбщениеСИнструментами()

	ДлинныйТекст = ПовторитьСтроку("abcdefghij", 30);

	Сообщения = Новый Массив;
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольSystem(), "Ты тестовый агент."));
	Для Сч = 1 По 6 Цикл
		Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
			ar_LLMКонтракт.РольUser(), ДлинныйТекст));

		Вызовы = Новый Массив;
		Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall("call-" + Сч, "get_constants", "{}"));
		Помощник = Новый Структура;
		Помощник.Вставить("role", ar_LLMКонтракт.РольAssistant());
		Помощник.Вставить("content", "");
		Помощник.Вставить("tool_calls", Вызовы);
		Сообщения.Добавить(Помощник);

		Сообщения.Добавить(ar_LLMКонтракт.НовыйToolResult(
			"call-" + Сч, "get_constants", "{}-результат"));
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

// Повторяет строку заданное число раз (конкатенация).
//
Функция ПовторитьСтроку(Знач Фрагмент, Знач Раз)

	Результат = "";
	Для Сч = 1 По Раз Цикл
		Результат = Результат + Фрагмент;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
