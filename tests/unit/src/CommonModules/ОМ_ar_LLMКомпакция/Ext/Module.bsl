// Добавляет ход «вызов инструмента - результат»: assistant с tool_calls и
// следующее за ним сообщение role = "tool".
//
// Параметры:
//   Сообщения      - Массив  - чат-сообщения (дополняется).
//   ИдВызова       - Строка  - ид вызова в tool_calls и tool_call_id.
//   ИмяИнструмента - Строка  - имя tool (в т. ч. "ask_user").
//   Аргументы      - Строка  - JSON-строка аргументов вызова.
//   Результат      - Строка  - содержимое результата инструмента.
//
Процедура ДобавитьХодИнструмента(Сообщения, Знач ИдВызова, Знач ИмяИнструмента, Знач Аргументы, Знач Результат)

	Вызовы = Новый Массив;
	Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall(ИдВызова, ИмяИнструмента, Аргументы));
	Помощник = Новый Структура;
	Помощник.Вставить("role", ar_LLMКонтракт.РольAssistant());
	Помощник.Вставить("content", "");
	Помощник.Вставить("tool_calls", Вызовы);
	Сообщения.Добавить(Помощник);
	Сообщения.Добавить(ar_LLMКонтракт.НовыйToolResult(ИдВызова, ИмяИнструмента, Результат));

КонецПроцедуры

