// Истина, если у сообщения установлен признак ar_Сокращено.
//
// Параметры:
//   Сообщение - Произвольный - проверяемое сообщение.
//
// Возвращаемое значение:
//   Булево - сравнение с Истина вместо приведения: значение ключа может
//   оказаться не булевым (защита, как ЭтоПризнак в ar_LLMКомпакция).
//
Функция ЭтоСжатое(Знач Сообщение)

	Признак = Ложь;
	Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
		Сообщение.Свойство("ar_Сокращено", Признак);
	КонецЕсли;
	Возврат Признак = Истина;

КонецФункции

// Число сообщений-сводок компакции (признак ar_СводкаКомпакции) в массиве.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//
// Возвращаемое значение:
//   Число - количество сводок.
//
Функция ЧислоСводок(Сообщения)

	Число = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Признак = Ложь;
		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Сообщение.Свойство("ar_СводкаКомпакции", Признак);
		КонецЕсли;
		Если Признак = Истина Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

// Первое сообщение-сводка компакции в массиве или Неопределено.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//
// Возвращаемое значение:
//   Структура, Неопределено - сообщение-сводка.
//
Функция СводкаКомпакции(Сообщения)

	Для Каждого Сообщение Из Сообщения Цикл
		Признак = Ложь;
		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Сообщение.Свойство("ar_СводкаКомпакции", Признак);
		КонецЕсли;
		Если Признак = Истина Тогда
			Возврат Сообщение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Число вызовов инструмента с данным именем в накопленных данных сводки.
//
// Параметры:
//   ДанныеСводки   - Структура - см. ar_LLMКомпакция.НовыеДанныеСводки.
//   ИмяИнструмента - Строка    - имя tool.
//
Функция ВызововИнструментаВСводке(Знач ДанныеСводки, Знач ИмяИнструмента)

	Число = 0;
	Для Каждого Элемент Из ДанныеСводки.Инструменты Цикл
		Если Элемент.Имя = ИмяИнструмента Тогда
			Число = Элемент.Количество;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;

КонецФункции

// Индекс сообщения, в content которого входит подстрока, или -1.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//   Подстрока - Строка - искомый фрагмент.
//
// Возвращаемое значение:
//   Число - индекс сообщения или -1.
//
Функция ИндексПоТексту(Сообщения, Знач Подстрока)

	Для Индекс = 0 По Сообщения.Количество() - 1 Цикл
		Содержимое = "";
		Если ТипЗнч(Сообщения[Индекс]) = Тип("Структура") Тогда
			Сообщения[Индекс].Свойство("content", Содержимое);
		КонецЕсли;
		Если СтрНайти(Содержимое, Подстрока) > 0 Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

// Истина, если хоть одно сообщение содержит подстроку в content.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//   Подстрока - Строка - искомый фрагмент.
//
// Возвращаемое значение:
//   Булево - текст найден.
//
Функция ЕстьТекст(Сообщения, Знач Подстрока)

	Возврат ИндексПоТексту(Сообщения, Подстрока) >= 0;

КонецФункции

// Истина, если есть результат инструмента, у которого предыдущее сообщение -
// не вызов с тем же ид (нарушение протокола после компакции).
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//
// Возвращаемое значение:
//   Булево - нарушение протокола найдено.
//
Функция ЕстьВисячийРезультат(Сообщения)

	Для Индекс = 1 По Сообщения.Количество() - 1 Цикл
		Сообщение = Сообщения[Индекс];
		Роль = "";
		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Сообщение.Свойство("role", Роль);
		КонецЕсли;
		Если Роль <> ar_LLMКонтракт.РольTool() Тогда
			Продолжить;
		КонецЕсли;
		ИдВызова = "";
		Сообщение.Свойство("tool_call_id", ИдВызова);
		Если ВызовыСодержатИд(Сообщения[Индекс - 1], ИдВызова) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Истина, если сообщение содержит вызов инструмента с данным ид.
//
// Параметры:
//   Сообщение - Произвольный - проверяемое сообщение.
//   ИдВызова  - Строка       - ид вызова инструмента.
//
// Возвращаемое значение:
//   Булево - вызов с таким ид найден.
//
Функция ВызовыСодержатИд(Знач Сообщение, Знач ИдВызова)

	Вызовы = Неопределено;
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Сообщение.Свойство("tool_calls", Вызовы);
	Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Вызов Из Вызовы Цикл
		Ид = "";
		Если ТипЗнч(Вызов) = Тип("Структура") Тогда
			Вызов.Свойство("id", Ид);
		КонецЕсли;
		Если Ид = ИдВызова Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции


#КонецОбласти

#КонецОбласти
