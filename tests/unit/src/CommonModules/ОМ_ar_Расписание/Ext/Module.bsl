///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Расписание.
//
// Тесты cron-выражений (ar_Расписание): РазобратьВыражение (корректные и
// ошибочные выражения), СовпадаетСВременем, СледующийМомент (шаги, списки,
// диапазоны, переход через сутки и месяц).
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Разбор")
		.ДобавитьСерверныйТест("КорректноеВыражениеРазбирается").Тег("critical")
		.ДобавитьСерверныйТест("ОшибочныеВыраженияОтклоняются").Тег("critical");

	ЮТесты
		.ДобавитьТестовыйНабор("Совпадение")
		.ДобавитьСерверныйТест("СовпадаетСВременемПоПолям").Тег("critical");

	ЮТесты
		.ДобавитьТестовыйНабор("СледующийМомент")
		.ДобавитьСерверныйТест("ШагиСпискиИДиапазоны").Тег("critical")
		.ДобавитьСерверныйТест("ПереходыЧерезСуткиИМесяц").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Корректное выражение: 5 полей, шаги/списки/диапазоны дают массивы чисел.
Процедура КорректноеВыражениеРазбирается() Экспорт

	Разбор = ar_Расписание.РазобратьВыражение("*/5 9-17 1,15 * 1-5");

	ЮТест.ОжидаетЧто(Разбор.ОК).ЭтоИстина()
		.Свойство("Минуты.Количество()").Больше(0)
		.Свойство("Часы.Количество()").Равно(9)
		.Свойство("ДниМесяца.Количество()").Равно(2)
		.Свойство("Месяцы.Количество()").Равно(12)
		.Свойство("ДниНедели.Количество()").Равно(5);

КонецПроцедуры

// Ошибочные выражения: не 5 полей, вне диапазона, мусор.
Процедура ОшибочныеВыраженияОтклоняются() Экспорт

	ЮТест.ОжидаетЧто(ar_Расписание.РазобратьВыражение("* * *").ОК).ЭтоЛожь()
		.Что(ar_Расписание.РазобратьВыражение("60 * * * *").ОК).ЭтоЛожь()
		.Что(ar_Расписание.РазобратьВыражение("abc * * * *").ОК).ЭтоЛожь()
		.Что(ar_Расписание.РазобратьВыражение("").ОК).ЭтоЛожь();

КонецПроцедуры

// СовпадаетСВременем: точное совпадение полей, ошибочное выражение - Ложь.
Процедура СовпадаетСВременемПоПолям() Экспорт

	Момент = Дата(2026, 10, 2, 10, 30, 0);

	ЮТест.ОжидаетЧто(
		ar_Расписание.СовпадаетСВременем("30 10 * * *", Момент)).ЭтоИстина()
		.Что(ar_Расписание.СовпадаетСВременем("*/30 10 * * *", Момент)).ЭтоИстина()
		.Что(ar_Расписание.СовпадаетСВременем("* * * * *", Момент)).ЭтоИстина()
		.Что(ar_Расписание.СовпадаетСВременем("45 10 * * *", Момент)).ЭтоЛожь()
		.Что(ar_Расписание.СовпадаетСВременем("30 11 * * *", Момент)).ЭтоЛожь()
		.Что(ar_Расписание.СовпадаетСВременем("битое", Момент)).ЭтоЛожь();

КонецПроцедуры

// СледующийМомент: шаги (*/15), списки (0,30), диапазоны часов.
Процедура ШагиСпискиИДиапазоны() Экспорт

	Начало = Дата(2026, 10, 2, 10, 31, 0);

	ЮТест.ОжидаетЧто(
		ar_Расписание.СледующийМомент("*/15 * * * *", Начало))
		.Равно(Дата(2026, 10, 2, 10, 45, 0))
		.Что(ar_Расписание.СледующийМомент("0,30 * * * *", Начало))
		.Равно(Дата(2026, 10, 2, 11, 0, 0))
		.Что(ar_Расписание.СледующийМомент("0 9-17 * * *", Начало))
		.Равно(Дата(2026, 10, 3, 9, 0, 0));

КонецПроцедуры

// Переходы через сутки и месяц; на некорректном выражении - Неопределено.
Процедура ПереходыЧерезСуткиИМесяц() Экспорт

	КонецОктября = Дата(2026, 10, 31, 23, 59, 0);

	ЮТест.ОжидаетЧто(
		ar_Расписание.СледующийМомент("0 0 * * *", КонецОктября))
		.Равно(Дата(2026, 11, 1, 0, 0, 0))
		.Что(ar_Расписание.СледующийМомент("0 12 1 * *", КонецОктября))
		.Равно(Дата(2026, 11, 1, 12, 0, 0))
		.Что(ar_Расписание.СледующийМомент("битое", КонецОктября)).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти
