///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Уведомления.
//
// Тесты безотказности уведомлений (ar_Уведомления, план «ТЕСТЫ: расширение
// покрытия ядра», раздел 3.5): Уведомить и УведомитьОВопросе вызываются из
// надзора, подтверждений и цикла агента без обёртки - исключение наружу не
// выходит ни при неверных аргументах, ни без адресатов или учётной записи
// почты; повтор того же повода по запуску отсекается.
//
// В базе прогона может быть учётная запись почты (на стенде - тестовые ящики):
// тесты, которые доходят до отправки, принимают любой штатный итог - письмо
// отправлено или не отправлено с причиной - и проверяют, что исключения нет и
// итог записан в служебный лог запуска.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Безотказность уведомлений")
		.ДобавитьСерверныйТест("УведомлениеНекорректныеАргументы").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("УведомлениеОбЭскалацииЗаписываетИтог").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторноеУведомлениеОтсекается").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("УведомлениеОНеизвестномВопросе").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("АдминистраторыБезДублей").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Пустой ИдЗапуска, пустой повод и пустой идентификатор вопроса - результат с
// причиной invalid_arguments, без исключения.
Процедура УведомлениеНекорректныеАргументы() Экспорт

	ЮТест.ОжидаетЧто(ar_Уведомления.Уведомить("", "escalation"), "пустой ИдЗапуска")
		.Свойство("Отправлено").ЭтоЛожь()
		.Свойство("Причина").Равно("invalid_arguments");

	ЮТест.ОжидаетЧто(ar_Уведомления.Уведомить(ОМ_ar_ТестовыеДанные.НовыйRunId(), ""), "пустой повод")
		.Свойство("Отправлено").ЭтоЛожь()
		.Свойство("Причина").Равно("invalid_arguments");

	ЮТест.ОжидаетЧто(ar_Уведомления.Уведомить(Неопределено, Неопределено), "аргументы Неопределено")
		.Свойство("Причина").Равно("invalid_arguments");

	ЮТест.ОжидаетЧто(ar_Уведомления.УведомитьОВопросе(""), "пустой идентификатор вопроса")
		.Свойство("Отправлено").ЭтоЛожь()
		.Свойство("Причина").Равно("invalid_arguments");

КонецПроцедуры

// Уведомление об эскалации по запуску агента без ответственных (адресаты -
// администраторы): исключения нет, итог штатный - письмо отправлено (ok) или
// не отправлено с причиной no_recipients / no_email_account / send_failed /
// suppressed; Отправлено - только при ok. Итог записан в служебный лог запуска
// (кроме suppressed - письмо отменила обработка переопределения писем).
Процедура УведомлениеОбЭскалацииЗаписываетИтог() Экспорт

	ИдЗапуска = НовыйЗапускАгента();

	Результат = ar_Уведомления.Уведомить(ИдЗапуска, "escalation");

	СобытияЛога = СобытияЛогаПоПричине().Получить(Результат.Причина);
	ЮТест.ОжидаетЧто(СобытияЛога <> Неопределено,
		"штатная причина итога, а не " + Результат.Причина).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Отправлено, "отправлено при причине " + Результат.Причина)
		.Равно(Результат.Причина = "ok");

	Если СобытияЛога.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗаписейЛога = 0;
	Для Каждого СобытиеЛога Из СобытияЛога Цикл
		ЗаписейЛога = ЗаписейЛога
			+ ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(ИдЗапуска, СобытиеЛога).Количество();
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗаписейЛога > 0,
		"запись " + СтрСоединить(СобытияЛога, " / ") + " в служебном логе запуска; "
		+ ОМ_ar_ТестовыеДанные.СледСлужебногоЛога(ИдЗапуска)).ЭтоИстина();

КонецПроцедуры

// Второе уведомление того же повода по тому же запуску отсекается резервом
// отправки (duplicate), другой повод - нет.
Процедура ПовторноеУведомлениеОтсекается() Экспорт

	ИдЗапуска = НовыйЗапускАгента();

	Первое = ar_Уведомления.Уведомить(ИдЗапуска, "escalation");
	Повтор = ar_Уведомления.Уведомить(ИдЗапуска, "escalation");
	ДругойПовод = ar_Уведомления.Уведомить(ИдЗапуска, "retry_exhausted");

	ЮТест.ОжидаетЧто(Первое.Причина, "первое уведомление не отсечено").НеРавно("duplicate");
	ЮТест.ОжидаетЧто(Повтор.Причина, "повтор того же повода").Равно("duplicate");
	ЮТест.ОжидаетЧто(Повтор.Отправлено, "повтор не отправлен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ДругойПовод.Причина, "другой повод не отсечён").НеРавно("duplicate");

КонецПроцедуры

// Уведомление о вопросе, которого нет в очереди: исключения нет, письмо не
// отправлено.
Процедура УведомлениеОНеизвестномВопросе() Экспорт

	Результат = ar_Уведомления.УведомитьОВопросе(Строка(Новый УникальныйИдентификатор()));

	ЮТест.ОжидаетЧто(Результат, "результат уведомления о вопросе")
		.ИмеетТип("Структура")
		.Свойство("Отправлено").ЭтоЛожь();

КонецПроцедуры

// ПользователиАдминистраторов: массив ссылок справочника Пользователи без
// повторов; полноправный текущий пользователь в нём есть.
Процедура АдминистраторыБезДублей() Экспорт

	Администраторы = ar_Уведомления.ПользователиАдминистраторов();

	ЮТест.ОжидаетЧто(Администраторы, "результат").ИмеетТип("Массив");

	Встреченные = Новый Соответствие;
	Для Каждого Пользователь Из Администраторы Цикл
		ЮТест.ОжидаетЧто(ТипЗнч(Пользователь), "тип элемента").Равно(Тип("СправочникСсылка.Пользователи"));
		ЮТест.ОжидаетЧто(Встреченные.Получить(Пользователь), "повтор пользователя " + Пользователь)
			.Равно(Неопределено);
		Встреченные.Вставить(Пользователь, Истина);
	КонецЦикла;

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ.Роли.Содержит(Метаданные.Роли.ПолныеПрава) Тогда
		ЮТест.ОжидаетЧто(Встреченные.Получить(Пользователи.ТекущийПользователь()),
			"полноправный текущий пользователь в списке").Равно(Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запуск агента без профиля и ответственного пользователя (адресаты - только
// администраторы).
//
// Возвращаемое значение:
//  Строка - ИдЗапуска.
//
Функция НовыйЗапускАгента()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	Возврат ОМ_ar_ТестовыеДанные.СоздатьЗапуск(ОМ_ar_ТестовыеДанные.НовыйRunId(), Агент);

КонецФункции

// Штатные причины итога Уведомить и события служебного лога, которыми
// ar_Уведомления записывает каждую из них.
//
// Возвращаемое значение:
//  Соответствие - ключ: причина (Строка), значение: Массив событий лога
//                 (пустой - причина без записи в лог).
//
Функция СобытияЛогаПоПричине()

	Результат = Новый Соответствие;
	Результат.Вставить("ok", СтрРазделить("notify_sent", ","));
	Результат.Вставить("no_recipients", СтрРазделить("notify_no_recipients", ","));
	Результат.Вставить("no_email_account", СтрРазделить("notify_no_email_account,notify_no_mail_subsystem", ","));
	Результат.Вставить("send_failed", СтрРазделить("notify_send_failed,notify_all_recipients_rejected", ","));
	Результат.Вставить("suppressed", Новый Массив);
	Возврат Результат;

КонецФункции

#КонецОбласти
