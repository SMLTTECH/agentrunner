///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_LLMКонтракт.
//
// Тесты контракта LLM (ar_LLMКонтракт): построители НовоеСообщение,
// НовыйToolCall, НовыйToolResult, НовыйUsage, НовыйОтвет, НовыеПараметры,
// роли; ИзвлечьЧисло; валидаторы ВалидироватьUsage, ВалидироватьОтвет,
// ВалидироватьСообщения (пустая строка = ОК, ошибки для нарушений контракта).
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Построители")
		.ДобавитьСерверныйТест("ПостроителиСообщенийИРолей").Тег("critical")
		.ДобавитьСерверныйТест("ПостроительToolCall").Тег("critical")
		.ДобавитьСерверныйТест("ПостроительToolResult").Тег("critical")
		.ДобавитьСерверныйТест("НовыйОтветПолныйСостав").Тег("critical")
		.ДобавитьСерверныйТест("НовыйUsageИНовыеПараметры").Тег("critical")
		.ДобавитьСерверныйТест("ИзвлечьЧислоИзРазныхТипов").Тег("critical");

	ЮТесты
		.ДобавитьТестовыйНабор("Валидаторы")
		.ДобавитьСерверныйТест("ВалидироватьUsageВсеСлучаи").Тег("critical")
		.ДобавитьСерверныйТест("ВалидироватьОтветВсеСлучаи").Тег("critical")
		.ДобавитьСерверныйТест("ВалидироватьСообщенияВсеСлучаи").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// НовоеСообщение: {role, content}; роли - литералы system/user/assistant/tool.
Процедура ПостроителиСообщенийИРолей() Экспорт

	Сообщение = ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), "Вопрос");

	ЮТест.ОжидаетЧто(Сообщение.role).Равно("user")
		.Свойство("content").Равно("Вопрос");

	ЮТест.ОжидаетЧто(ar_LLMКонтракт.РольSystem()).Равно("system")
		.Что(ar_LLMКонтракт.РольAssistant()).Равно("assistant")
		.Что(ar_LLMКонтракт.РольTool()).Равно("tool");

КонецПроцедуры

// НовыйToolCall: {id, type:"function", function:{name, arguments}}.
Процедура ПостроительToolCall() Экспорт

	Вызов = ar_LLMКонтракт.НовыйToolCall("call-1", "get_constants", "{}");

	ЮТест.ОжидаетЧто(Вызов.id).Равно("call-1")
		.Свойство("type").Равно("function")
		.Свойство("function.name").Равно("get_constants")
		.Свойство("function.arguments").Равно("{}");

КонецПроцедуры

// НовыйToolResult: {role:"tool", content, tool_call_id, name}.
Процедура ПостроительToolResult() Экспорт

	Результат = ar_LLMКонтракт.НовыйToolResult("call-1", "get_constants", "{}-результат");

	ЮТест.ОжидаетЧто(Результат.role).Равно("tool")
		.Свойство("content").Равно("{}-результат")
		.Свойство("tool_call_id").Равно("call-1")
		.Свойство("name").Равно("get_constants");

КонецПроцедуры

// НовыйОтвет: полный состав структуры ответа с дефолтами.
Процедура НовыйОтветПолныйСостав() Экспорт

	Ответ = ar_LLMКонтракт.НовыйОтвет();

	ЮТест.ОжидаетЧто(Ответ.Успех).ЭтоЛожь()
		.Свойство("Сообщение").Равно(Неопределено)
		.Свойство("ТокеновВход").Равно(0)
		.Свойство("ТокеновВыход").Равно(0)
		.Свойство("Ошибка").Равно("")
		.Свойство("КодСостояния").Равно(0)
		.Свойство("БалансРуб").Равно(Неопределено)
		.Свойство("БалансНизкий").ЭтоЛожь();

КонецПроцедуры

// НовыйUsage: числа из значений; НовыеПараметры: Провайдер/Модель/Таймаут.
Процедура НовыйUsageИНовыеПараметры() Экспорт

	Usage = ar_LLMКонтракт.НовыйUsage(10, 5);
	ЮТест.ОжидаетЧто(Usage.ТокеновВход).Равно(10)
		.Свойство("ТокеновВыход").Равно(5);

	Провайдер = Справочники.ar_LLMПровайдеры.ПустаяСсылка();
	Параметры = ar_LLMКонтракт.НовыеПараметры(Провайдер, "gpt-test", 30);
	ЮТест.ОжидаетЧто(Параметры.Провайдер).Равно(Провайдер)
		.Свойство("Модель").Равно("gpt-test")
		.Свойство("Таймаут").Равно(30);

КонецПроцедуры

// ИзвлечьЧисло: число как есть (неотрицательное), строка-число парсится,
// мусор и отрицательные дают 0.
Процедура ИзвлечьЧислоИзРазныхТипов() Экспорт

	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ИзвлечьЧисло(42)).Равно(42)
		.Что(ar_LLMКонтракт.ИзвлечьЧисло("120")).Равно(120)
		.Что(ar_LLMКонтракт.ИзвлечьЧисло("-5")).Равно(0)
		.Что(ar_LLMКонтракт.ИзвлечьЧисло("abc")).Равно(0)
		.Что(ar_LLMКонтракт.ИзвлечьЧисло("")).Равно(0)
		.Что(ar_LLMКонтракт.ИзвлечьЧисло(Неопределено)).Равно(0);

КонецПроцедуры

// ВалидироватьUsage: пустая строка для корректного; ошибки для
// Неопределено, не-структуры, отсутствующих ключей, не-чисел, отрицательных.
Процедура ВалидироватьUsageВсеСлучаи() Экспорт

	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьUsage(Неопределено)).Заполнено()
		.Что(ar_LLMКонтракт.ВалидироватьUsage("не структура")).Заполнено();

	Usage = Новый Структура("ТокеновВход, ТокеновВыход", 5, 3);
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьUsage(Usage)).Равно("");

	Неполный = Новый Структура("ТокеновВход", 5);
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьUsage(Неполный)).Заполнено();

	Отрицательный = Новый Структура("ТокеновВход, ТокеновВыход", -1, 0);
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьUsage(Отрицательный)).Заполнено();

КонецПроцедуры

// ВалидироватьОтвет: пустая строка для полного корректного ответа; ошибки
// при отсутствии обязательных ключей и при некорректном сообщении успеха.
Процедура ВалидироватьОтветВсеСлучаи() Экспорт

	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьОтвет(Неопределено)).Заполнено()
		.Что(ar_LLMКонтракт.ВалидироватьОтвет(42)).Заполнено();

	ОтветУспех = ar_LLMКонтракт.НовыйОтвет();
	ОтветУспех.Успех = Истина;
	ОтветУспех.Сообщение = ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольAssistant(), "Готово");
	ОтветУспех.ТокеновВход = 3;
	ОтветУспех.ТокеновВыход = 2;
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьОтвет(ОтветУспех)).Равно("");

	БитыйОтвет = Новый Структура("Успех", Истина);
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьОтвет(БитыйОтвет)).Заполнено();

	ОтветБезСообщения = ar_LLMКонтракт.НовыйОтвет();
	ОтветБезСообщения.Успех = Истина;
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьОтвет(ОтветБезСообщения)).Заполнено();

КонецПроцедуры

// ВалидироватьСообщения: пустая строка для корректного массива; ошибки для
// пустого массива, не-структур, отсутствующих ключей, недопустимой роли,
// роли tool без tool_call_id.
Процедура ВалидироватьСообщенияВсеСлучаи() Экспорт

	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьСообщения(Неопределено)).Заполнено()
		.Что(ar_LLMКонтракт.ВалидироватьСообщения(Новый Массив)).Заполнено();

	Корректные = Новый Массив;
	Корректные.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольSystem(), "Система"));
	Корректные.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), "Вопрос"));
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьСообщения(Корректные)).Равно("");

	Битые = Новый Массив;
	Битые.Добавить(ar_LLMКонтракт.НовоеСообщение("неверная_роль", "Текст"));
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьСообщения(Битые)).Заполнено();

	БезКонтента = Новый Массив;
	БезКонтента.Добавить(Новый Структура("role", "user"));
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьСообщения(БезКонтента)).Заполнено();

	ToolБезИд = Новый Массив;
	ToolБезИд.Добавить(Новый Структура("role, content", "tool", "результат"));
	ЮТест.ОжидаетЧто(ar_LLMКонтракт.ВалидироватьСообщения(ToolБезИд)).Заполнено();

КонецПроцедуры

#КонецОбласти
