///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ОбновлениеРасширения.
//
// Тесты старта сеанса и обновления расширения (план «ТЕСТЫ: расширение
// покрытия ядра», раздел 3.4): список обработчиков обновления
// (ar_ОбновлениеРасширения), прогон обработчиков с ранней версии базы
// (ВыполнитьОбновлениеПриНеобходимости), идемпотентность и сохранение настроек
// tools администратора, инициализация при запуске системы
// (ar_ИнструментыДиспетчер.ИнициализироватьПриЗапускеСистемы), автозаполнение
// пустого реестра tools, миграция снимка запуска (ar_СнимокМигратор).
//
// Версия базы - константа ar_ВерсияРасширенияБД: тест задаёт её в транзакции
// (0.1.0.1 - выполняются все обработчики) и вызывает обновление; итог
// обработчиков - события update_handler_done / update_handler_error
// служебного лога. Всё откатывается вместе с транзакцией теста.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Обработчики обновления")
		.ДобавитьСерверныйТест("ОбработчикиУпорядоченыИУникальны").Тег("critical")
		.ДобавитьСерверныйТест("ВсеОбработчикиИзвестныДиспетчеру").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОбновлениеНаАктуальнойВерсииНичегоНеДелает").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторноеОбновлениеИдемпотентно").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОбновлениеСохраняетНастройкиTools").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВерсияБДПоднимаетсяПослеОбновления").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Старт сеанса")
		.ДобавитьСерверныйТест("ИнициализацияПриЗапускеБезИсключений").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("АвтоЗаполнениеРеестраНаПустомРеестре").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("МиграцияСнимкаЗапуска").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Список обработчиков: версии не убывают и не выше версии расширения,
// идентификаторы уникальны, комментарии заполнены.
Процедура ОбработчикиУпорядоченыИУникальны() Экспорт

	Обработчики = ОбработчикиОбновления();
	ЮТест.ОжидаетЧто(Обработчики.Количество() > 0, "обработчики зарегистрированы").ЭтоИстина();

	ВерсияМетаданных = ar_Утилиты.ВерсияРасширения();
	Идентификаторы = Новый Соответствие;
	ПредыдущаяВерсия = "";
	Для Каждого Обработчик Из Обработчики Цикл

		Описание = Обработчик.Версия + " " + Обработчик.Идентификатор;
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Обработчик.Идентификатор), "идентификатор " + Описание).ЭтоИстина();
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Обработчик.Комментарий), "комментарий " + Описание).ЭтоИстина();
		ЮТест.ОжидаетЧто(Идентификаторы.Получить(Обработчик.Идентификатор), "повтор идентификатора " + Описание)
			.Равно(Неопределено);
		Идентификаторы.Вставить(Обработчик.Идентификатор, Истина);

		Если ЗначениеЗаполнено(ПредыдущаяВерсия) Тогда
			ЮТест.ОжидаетЧто(ar_ПроверкаОбновлений.СравнитьВерсии(ПредыдущаяВерсия, Обработчик.Версия) <= 0,
				"версия " + Описание + " не меньше предыдущей " + ПредыдущаяВерсия).ЭтоИстина();
		КонецЕсли;
		ЮТест.ОжидаетЧто(ar_ПроверкаОбновлений.СравнитьВерсии(Обработчик.Версия, ВерсияМетаданных) <= 0,
			"версия " + Описание + " не выше версии расширения " + ВерсияМетаданных).ЭтоИстина();
		ПредыдущаяВерсия = Обработчик.Версия;

	КонецЦикла;

КонецПроцедуры

// Версия базы 0.1.0.1 - выполняются все обработчики: у каждого есть итог в
// служебном логе (done или error), ни одной ошибки «Неизвестный идентификатор»
// (обработчик добавлен в список без ветки в диспетчере).
Процедура ВсеОбработчикиИзвестныДиспетчеру() Экспорт

	НачалоТеста = ТекущаяДатаСеанса();
	ВыполнитьОбновлениеСВерсии("0.1.0.1");

	Итоги = ИтогиОбработчиков(НачалоТеста);
	Ошибки = Итоги.НайтиСтроки(Новый Структура("Событие", "update_handler_error"));
	Для Каждого Ошибка Из Ошибки Цикл
		ЮТест.ОжидаетЧто(СтрНайти(Ошибка.Текст, "Неизвестный идентификатор") = 0
			И СтрНайти(Ошибка.Текст, "Unknown update handler") = 0,
			"обработчик без ветки в диспетчере: " + Ошибка.Текст).ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(Итоги.Количество(), "итогов обработчиков в служебном логе")
		.Равно(ОбработчикиОбновления().Количество());

КонецПроцедуры

// Версия базы равна версии метаданных: обработчики не выполняются, реестр
// tools не меняется.
Процедура ОбновлениеНаАктуальнойВерсииНичегоНеДелает() Экспорт

	ВерсияМетаданных = ar_Утилиты.ВерсияРасширения();
	Константы.ar_ВерсияРасширенияБД.Установить(ВерсияМетаданных);
	ДоОбновления = СнимокРеестраTools();
	НачалоТеста = ТекущаяДатаСеанса();

	ar_ОбновлениеРасширения.ВыполнитьОбновлениеПриНеобходимости();

	ЮТест.ОжидаетЧто(ИтогиОбработчиков(НачалоТеста).Количество(), "итогов обработчиков").Равно(0);
	ЮТест.ОжидаетЧто(СнимокРеестраTools().Представление, "реестр tools").Равно(ДоОбновления.Представление);
	ЮТест.ОжидаетЧто(Константы.ar_ВерсияРасширенияБД.Получить(), "версия базы").Равно(ВерсияМетаданных);

КонецПроцедуры

// Обновление с 0.1.0.1 дважды подряд даёт тот же реестр: число tools и
// категорий, включённость и флаги подтверждения tools совпадают.
Процедура ПовторноеОбновлениеИдемпотентно() Экспорт

	ВыполнитьОбновлениеСВерсии("0.1.0.1");
	ПослеПервого = СнимокРеестраTools();

	ВыполнитьОбновлениеСВерсии("0.1.0.1");
	ПослеВторого = СнимокРеестраTools();

	ЮТест.ОжидаетЧто(ПослеВторого.ЧислоTools, "число tools").Равно(ПослеПервого.ЧислоTools);
	ЮТест.ОжидаетЧто(ПослеВторого.ЧислоКатегорий, "число категорий").Равно(ПослеПервого.ЧислоКатегорий);
	ЮТест.ОжидаетЧто(ПослеВторого.Представление, "флаги tools").Равно(ПослеПервого.Представление);

КонецПроцедуры

// Администратор выключил tool и включил ему подтверждение: обновление с
// 0.1.0.1 (с перерегистрацией всех tools) эти настройки сохраняет.
Процедура ОбновлениеСохраняетНастройкиTools() Экспорт

	Tool = ВключённыйToolБезПодтверждения();
	Если Tool = Неопределено Тогда
		ЮТест.Пропустить("В реестре нет включённого ядрового tool без подтверждения");
	КонецЕсли;

	ОбъектTool = Tool.ПолучитьОбъект();
	ОбъектTool.ar_Включён = Ложь;
	ОбъектTool.ar_ТребуетApproval = Истина;
	ОбъектTool.Записать();

	ВыполнитьОбновлениеСВерсии("0.1.0.1");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Tool, "ar_Имя, ar_Включён, ar_ТребуетApproval");
	ЮТест.ОжидаетЧто(Реквизиты.ar_Включён, "tool " + Реквизиты.ar_Имя + " остался выключенным").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ar_ТребуетApproval, "tool " + Реквизиты.ar_Имя + " требует подтверждения")
		.ЭтоИстина();

КонецПроцедуры

// Фиксирует текущее поведение (план, 3.12.1): после обновления версия базы
// равна версии метаданных - в том числе если какой-то обработчик завершился
// ошибкой (update_handler_error), упавший обработчик больше не повторится.
// Задача I (не поднимать версию при ошибке) поменяет ожидание этого теста.
Процедура ВерсияБДПоднимаетсяПослеОбновления() Экспорт

	ВыполнитьОбновлениеСВерсии("0.1.0.1");

	ЮТест.ОжидаетЧто(Константы.ar_ВерсияРасширенияБД.Получить(), "версия базы после обновления")
		.Равно(ar_Утилиты.ВерсияРасширения());

КонецПроцедуры

// ИнициализироватьПриЗапускеСистемы на заполненном реестре: результат со
// свойством АдминИМастерНужен, без исключений; повторный вызов не дублирует
// tools и категории.
Процедура ИнициализацияПриЗапускеБезИсключений() Экспорт

	Результат = ar_ИнструментыДиспетчер.ИнициализироватьПриЗапускеСистемы();
	ЮТест.ОжидаетЧто(Результат, "результат инициализации")
		.ИмеетТип("Структура")
		.Свойство("АдминИМастерНужен").ИмеетТип("Булево");
	ПослеПервого = СнимокРеестраTools();

	ar_ИнструментыДиспетчер.ИнициализироватьПриЗапускеСистемы();
	ПослеВторого = СнимокРеестраTools();

	ЮТест.ОжидаетЧто(ПослеПервого.ЧислоTools > 0, "реестр tools заполнен").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПослеВторого.ЧислоTools, "число tools после повтора").Равно(ПослеПервого.ЧислоTools);
	ЮТест.ОжидаетЧто(ПослеВторого.ЧислоКатегорий, "число категорий после повтора")
		.Равно(ПослеПервого.ЧислоКатегорий);
	ЮТест.ОжидаетЧто(ПослеВторого.Представление, "флаги tools после повтора").Равно(ПослеПервого.Представление);

КонецПроцедуры

// Реестр tools очищен (в транзакции): автозаполнение при запуске регистрирует
// tools заново, ядровые категории СписокЯдровыхКатегорий есть в справочнике.
Процедура АвтоЗаполнениеРеестраНаПустомРеестре() Экспорт

	УдалитьВсеЭлементы("ar_Инструменты");
	ЮТест.ОжидаетЧто(СнимокРеестраTools().ЧислоTools, "реестр очищен").Равно(0);

	ar_ИнструментыДиспетчер.АвтоЗаполнитьРеестрToolsПриЗапуске();

	ЮТест.ОжидаетЧто(СнимокРеестраTools().ЧислоTools > 0, "реестр tools заполнен").ЭтоИстина();
	Для Каждого Категория Из ar_ИнструментыДиспетчер.СписокЯдровыхКатегорий() Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Справочники.ar_КатегорииИнструментов.НайтиПоКоду(Категория.Код)),
			"ядровая категория " + Категория.Код).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// ar_СнимокМигратор.Мигрировать: снимок текущей версии - успех без изменений;
// версия новее ядра, нулевая и не число - отказ с причиной.
Процедура МиграцияСнимкаЗапуска() Экспорт

	Текущая = ar_СнимокМигратор.ТекущаяВерсия();
	Снимок = Новый Структура("v, state", Текущая, Новый Структура("Шаг", 3));

	Результат = ar_СнимокМигратор.Мигрировать(Снимок, Текущая);
	ЮТест.ОжидаетЧто(Результат.Успех, "снимок текущей версии").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Снимок.state.Шаг, "данные снимка не изменились").Равно(3);

	НовееЯдра = ar_СнимокМигратор.Мигрировать(Снимок, Текущая + 1);
	ЮТест.ОжидаетЧто(НовееЯдра.Успех, "снимок новее ядра").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрНайти(НовееЯдра.Причина, "snapshot_version_too_new") > 0,
		"причина отказа снимка новее ядра").ЭтоИстина();

	Для Каждого Версия Из НекорректныеВерсииСнимка() Цикл
		Отказ = ar_СнимокМигратор.Мигрировать(Снимок, Версия);
		ЮТест.ОжидаетЧто(Отказ.Успех, "версия снимка " + Строка(Версия)).ЭтоЛожь();
		ЮТест.ОжидаетЧто(Отказ.Причина, "причина для версии " + Строка(Версия))
			.Равно("snapshot_version_unknown");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблица обработчиков обновления в порядке регистрации.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ar_ОбновлениеРасширения.НоваяТаблицаОбработчиковОбновления.
//
Функция ОбработчикиОбновления()

	Обработчики = ar_ОбновлениеРасширения.НоваяТаблицаОбработчиковОбновления();
	ar_ОбновлениеРасширения.ПриДобавленииОбработчиковОбновления(Обработчики);
	Возврат Обработчики;

КонецФункции

// Задаёт версию базы и выполняет обновление расширения.
//
// Параметры:
//  ВерсияБД - Строка - версия, с которой выполняются обработчики.
//
Процедура ВыполнитьОбновлениеСВерсии(Знач ВерсияБД)

	Константы.ar_ВерсияРасширенияБД.Установить(ВерсияБД);
	ar_ОбновлениеРасширения.ВыполнитьОбновлениеПриНеобходимости();

КонецПроцедуры

// Итоги обработчиков обновления в служебном логе с момента начала теста.
//
// Параметры:
//  НачалоТеста - Дата.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Событие, Текст.
//
Функция ИтогиОбработчиков(Знач НачалоТеста)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Лог.ar_Событие КАК Событие,
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Момент >= &НачалоТеста
		|	И Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие В (&События)");
	Запрос.УстановитьПараметр("НачалоТеста", НачалоТеста);
	Запрос.УстановитьПараметр("Источник", "ar_ОбновлениеРасширения.ВыполнитьОдинОбработчик");
	События = Новый Массив;
	События.Добавить("update_handler_done");
	События.Добавить("update_handler_error");
	Запрос.УстановитьПараметр("События", События);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Снимок реестра tools: число tools и категорий, флаги включённости и
// подтверждения по именам одной строкой.
//
// Возвращаемое значение:
//  Структура - {ЧислоTools, ЧислоКатегорий, Представление}.
//
Функция СнимокРеестраTools()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Tools.ar_Имя,
		|	Tools.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Категории.Ссылка) КАК Число
		|ИЗ
		|	Справочник.ar_КатегорииИнструментов КАК Категории
		|ГДЕ
		|	НЕ Категории.ПометкаУдаления");
	Результаты = Запрос.ВыполнитьПакет();

	Строки = Новый Массив;
	ЧислоTools = 0;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЧислоTools = ЧислоTools + 1;
		Строки.Добавить(СтрШаблон("%1:%2:%3", СокрЛП(Выборка.Имя),
			Формат(Выборка.Включён, "БЛ=0; БИ=1"), Формат(Выборка.ТребуетApproval, "БЛ=0; БИ=1")));
	КонецЦикла;

	ВыборкаКатегорий = Результаты[1].Выбрать();
	ВыборкаКатегорий.Следующий();

	Возврат Новый Структура("ЧислоTools, ЧислоКатегорий, Представление",
		ЧислоTools, ВыборкаКатегорий.Число, СтрСоединить(Строки, ";"));

КонецФункции

// Включённый tool без подтверждения из ядрового модуля (не из пакета).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Инструменты, Неопределено.
//
Функция ВключённыйToolБезПодтверждения()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления
		|	И Tools.ar_Включён
		|	И НЕ Tools.ar_ТребуетApproval
		|	И Tools.ar_ОбщийМодуль ПОДОБНО ""ar_Инструменты%""
		|УПОРЯДОЧИТЬ ПО
		|	Tools.ar_Имя");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Удаляет все элементы справочника непосредственно (в транзакции теста).
//
// Параметры:
//  ИмяСправочника - Строка.
//
Процедура УдалитьВсеЭлементы(Знач ИмяСправочника)

	// Ссылки - до удаления: выборка справочника не обходится, пока из него удаляют.
	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Элементы", ИмяСправочника));
	Для Каждого Ссылка Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
		Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

КонецПроцедуры

// Некорректные версии формата снимка.
//
// Возвращаемое значение:
//  Массив - 0, отрицательное число, строка, Неопределено.
//
Функция НекорректныеВерсииСнимка()

	Версии = Новый Массив;
	Версии.Добавить(0);
	Версии.Добавить(-1);
	Версии.Добавить("1");
	Версии.Добавить(Неопределено);
	Возврат Версии;

КонецФункции

#КонецОбласти
