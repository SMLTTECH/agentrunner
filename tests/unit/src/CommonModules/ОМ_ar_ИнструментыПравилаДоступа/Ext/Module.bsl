///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ИнструментыПравилаДоступа.
//
// Тесты эффективного набора инструментов агента
// (ar_ИнструментыПравилаДоступа): ЭффективныйНаборTools при пустых ТЧ (весь
// реестр), явном списке, разрешающих/запрещающих правилах; ToolДоступенАгенту.
//
// Сценарии раздела 2 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЭффективныйНабор")
		.ДобавитьСерверныйТест("ПустыеСпискиДаютВесьРеестр").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЯвныйСписокОграничиваетНабор").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПравилоУровняРискаОпределяетНабор").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗапрещающееПравилоВычёркиваетИзСписка").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустойАгентДаетПустойНабор").Тег("critical");

	ЮТесты
		.ДобавитьТестовыйНабор("ДоступностьTool")
		.ДобавитьСерверныйТест("ДоступенПоРазнымНаборам").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Пустые ТЧ инструментов и правил - весь включённый реестр.
Процедура ПустыеСпискиДаютВесьРеестр() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_а",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_б",
		Перечисления.ar_УровеньРиска.Черновик);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	Набор = ar_ИнструментыПравилаДоступа.ЭффективныйНаборTools(Агент);

	ЮТест.ОжидаетЧто(Набор.Количество()).Больше(1);
	ЮТест.ОжидаетЧто(Набор.НайтиСтроки(Новый Структура("ИмяTool", "тест_инструмент_а")).Количество()).Равно(1)
		.Что(Набор.НайтиСтроки(Новый Структура("ИмяTool", "тест_инструмент_б")).Количество()).Равно(1);

КонецПроцедуры

// Явный список - только включённые строки списка.
Процедура ЯвныйСписокОграничиваетНабор() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_а",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_б",
		Перечисления.ar_УровеньРиска.Чтение);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("тест_инструмент_а"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Набор = ar_ИнструментыПравилаДоступа.ЭффективныйНаборTools(Агент);

	ЮТест.ОжидаетЧто(Набор.Количество()).Равно(1)
		.Свойство("[0].ИмяTool").Равно("тест_инструмент_а");

КонецПроцедуры

// Разрешающее правило по уровню риска собирает набор из реестра.
Процедура ПравилоУровняРискаОпределяетНабор() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_чтение",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_запись",
		Перечисления.ar_УровеньРиска.Запись);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ДобавитьПравилоАгенту(Агент, Перечисления.ar_ТипПравилаДоступа.УровеньРиска,
		"Запись", Истина, 1);

	Набор = ar_ИнструментыПравилаДоступа.ЭффективныйНаборTools(Агент);

	ЮТест.ОжидаетЧто(Набор.НайтиСтроки(Новый Структура("ИмяTool", "тест_инструмент_запись")).Количество()).Равно(1)
		.Что(Набор.НайтиСтроки(Новый Структура("ИмяTool", "тест_инструмент_чтение")).Количество()).Равно(0);

КонецПроцедуры

// Запрещающее правило вычёркивает tool даже из явного списка.
Процедура ЗапрещающееПравилоВычёркиваетИзСписка() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_а",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_б",
		Перечисления.ar_УровеньРиска.Чтение);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты",
		МассивДвухСтрок("тест_инструмент_а", "тест_инструмент_б"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	ДобавитьПравилоАгенту(Агент, Перечисления.ar_ТипПравилаДоступа.Инструмент,
		"тест_инструмент_б", Ложь, 1);

	Набор = ar_ИнструментыПравилаДоступа.ЭффективныйНаборTools(Агент);

	ЮТест.ОжидаетЧто(Набор.Количество()).Равно(1)
		.Свойство("[0].ИмяTool").Равно("тест_инструмент_а");

КонецПроцедуры

// Пустая ссылка агента: набор Неопределено, tool недоступен.
Процедура ПустойАгентДаетПустойНабор() Экспорт

	ЮТест.ОжидаетЧто(
		ar_ИнструментыПравилаДоступа.ЭффективныйНаборTools(
			Справочники.ar_Агенты.ПустаяСсылка())).Равно(Неопределено)
		.Что(ar_ИнструментыПравилаДоступа.ToolДоступенАгенту(
			Справочники.ar_Агенты.ПустаяСсылка(), "любой")).ЭтоЛожь();

КонецПроцедуры

// ToolДоступенАгенту: по явному списку и по всему реестру.
Процедура ДоступенПоРазнымНаборам() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_а",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_б",
		Перечисления.ar_УровеньРиска.Чтение);

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("тест_инструмент_а"));
	АгентСОписком = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	ЮТест.ОжидаетЧто(
		ar_ИнструментыПравилаДоступа.ToolДоступенАгенту(АгентСОписком, "тест_инструмент_а")).ЭтоИстина()
		.Что(ar_ИнструментыПравилаДоступа.ToolДоступенАгенту(АгентСОписком, "тест_инструмент_б")).ЭтоЛожь();

	АгентБезОписка = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ЮТест.ОжидаетЧто(
		ar_ИнструментыПравилаДоступа.ToolДоступенАгенту(АгентБезОписка, "тест_инструмент_б")).ЭтоИстина()
		.Что(ar_ИнструментыПравилаДоступа.ToolДоступенАгенту(АгентБезОписка, "нет_такого")).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет агенту строку в ТЧ правил доступа инструментов.
//
Функция ДобавитьПравилоАгенту(Знач Агент, Знач ТипПравила, Знач Значение,
	Знач Разрешить, Знач Порядок)

	ОбъектАгент = Агент.ПолучитьОбъект();
	СтрокаПравила = ОбъектАгент.ar_ПравилаДоступаИнструментов.Добавить();
	СтрокаПравила.ar_ТипПравила = ТипПравила;
	СтрокаПравила.ar_Значение = Значение;
	СтрокаПравила.ar_Разрешить = Разрешить;
	СтрокаПравила.ar_Порядок = Порядок;
	ОбъектАгент.Записать();
	Возврат ОбъектАгент.Ссылка;

КонецФункции

// Массив из одной строки.
//
Функция МассивСтрок(Знач Строка1)

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Возврат Массив;

КонецФункции

// Массив из двух строк.
//
Функция МассивДвухСтрок(Знач Строка1, Знач Строка2)

	Массив = МассивСтрок(Строка1);
	Массив.Добавить(Строка2);
	Возврат Массив;

КонецФункции

#КонецОбласти
