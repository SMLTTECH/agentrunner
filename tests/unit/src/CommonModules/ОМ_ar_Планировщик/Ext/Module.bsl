///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Планировщик.
//
// Тесты служебных функций планировщика (ar_Планировщик):
// ТерминальныеСтатусыЗапуска - 7 финальных статусов, приостановленные и
// активные не входят; ИзвлечьТипОбъектаИзСобытия - отрезание суффикса
// обработчика события; набор agentrunner-290 ОпросПодписок - тик опроса
// подписок (разбор очереди событий, метка ar_ОпросПодписокПоследнийЗапуск);
// набор agentrunner-362 SCHED-05 - лимиты запусков через ОбработатьПланировщик
// (откладывание при исчерпанном лимите агента/суммарном, чужие запуски не
// входят в лимит агента, старт на тике после освобождения слота);
// набор agentrunner-376 - ветки тиков: упоминания (метка обработки, SCHED-07),
// возобновления одобренных и отвеченных подтверждений (SCHED-03/TOOL-19),
// зависшие по пульсу (SCHED-04), рестарт/ретрай/дедлайн (CONS-09/PLAN-13),
// ротация сессий (SESS-03).
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("СлужебныеФункции")
		.ДобавитьСерверныйТест("ТерминальныеСтатусыЗапускаСостав").Тег("critical")
		.ДобавитьСерверныйТест("ПриостановленныеНеТерминальные").Тег("critical")
		.ДобавитьСерверныйТест("ИзвлечьТипОбъектаИзСобытия").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-104 Техповтор")
		.ДобавитьСерверныйТест("ТехповторБезСнимкаНеБесконечен").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-105 ПозднееЗавершение")
		.ДобавитьСерверныйТест("ПозднееЗавершениеНеПерекрываетПрерван").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-14 Компакция")
		.ДобавитьСерверныйТест("КомпакцияУдаляетТерминальныеЗаписи").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-19 СтрокаЗдоровья")
		.ДобавитьСерверныйТест("СтрокаЗдоровьяДавностьЗапуска").Тег("critical")
		.ДобавитьСерверныйТест("ДиагностикаВключаетВсеЗадания").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-107 Самолечение")
		.ДобавитьСерверныйТест("СамолечениеПаузыApproval").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-109-123-124 ПамятьAuto")
		.ДобавитьСерверныйТест("ТикПамятиПишетПредложенияВПамять").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОшибкиБезТекстаНеСчитаются").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПамятьПоАгентамНеСмешивается").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 ОпросПодписок")
		.ДобавитьСерверныйТест("ОпросСначалаРазбираетОчередь").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОпросБезПодписокСбрасываетМетку").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОпросПишетМеткуНачалаМинуты").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-362 SCHED-05 ЛимитыЗапусков")
		.ДобавитьСерверныйТест("ЛимитАгентаОткладываетЗапускРутины").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СуммарныйЛимитОткладываетЗапуск").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЧужиеЗапускиНеБлокируютАгента").Тег("critical").После("ОчиститьДанныеСтарта")
		.ДобавитьСерверныйТест("СлотОсвободилсяЗапускСтартуетНаТике").Тег("critical").После("ОчиститьДанныеСтарта");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-376 Упоминания")
		.ДобавитьСерверныйТест("УпоминанияБезРутинСдвигаютМеткуОбработки").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторныйТикУпоминанийНеСоздаетЗапуск").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-376 Возобновления")
		.ДобавитьСерверныйТест("ОдобренноеПодтверждениеВозобновляетЗапуск").Тег("critical").После("ОчиститьДанныеРезюме")
		.ДобавитьСерверныйТест("ОтвеченныйВопросВозобновляетЗапуск").Тег("critical").После("ОчиститьДанныеРезюме");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-376 Зависшие")
		.ДобавитьСерверныйТест("ЗависшийПоПульсуПрерывается").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РестартПрерванногоПриСвободномСлоте").Тег("critical").После("ОчиститьДанныеСтарта")
		.ДобавитьСерверныйТест("РестартБезСлотаЖдетСледующийТик").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РетрайТехсбояВозобновляетЗапуск").Тег("critical").После("ОчиститьДанныеСтарта")
		.ДобавитьСерверныйТест("ДедлайнОжиданияБудитЗапуск").Тег("critical").После("ОчиститьДанныеСтарта");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-376 РотацияСессий")
		.ДобавитьСерверныйТест("РотацияЗакрываетПросроченныеСессии").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Безотказность тиков")
		.ДобавитьСерверныйТест("ТикБезИсключений").Тег("critical").ВТранзакции()
			.СПараметрами("ОбработатьПланировщик")
			.СПараметрами("ОбработатьВозобновление")
			.СПараметрами("ОбработатьАвтовозобновление")
			.СПараметрами("ОбработатьОчисткуЗависших")
			.СПараметрами("ОбработатьРотациюСессий")
			.СПараметрами("ОбработатьУпоминания")
			.СПараметрами("ОбработатьКомпакциюAudit")
			.СПараметрами("ОбработатьОбновлениеПамятиAuto")
			.СПараметрами("ОбработатьОпросПодписок")
			.СПараметрами("ОбработатьОчисткуСлужебногоЛога")
		.ДобавитьСерверныйТест("ПовторныйТикИдемпотентен").Тег("critical").После("ОчиститьДанныеСтарта");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ТерминальныеСтатусыЗапуска содержит 7 финальных статусов.
Процедура ТерминальныеСтатусыЗапускаСостав() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(Статусы.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Завершён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Отменён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Прерван)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние)).ЭтоИстина();

КонецПроцедуры

// Приостановленные и активные статусы в терминальные не входят.
Процедура ПриостановленныеНеТерминальные() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Создан)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Выполняется)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия)).ЭтоЛожь();

КонецПроцедуры

// ИзвлечьТипОбъектаИзСобытия отрезает суффикс обработчика; без известного
// суффикса строка возвращается как есть.
Процедура ИзвлечьТипОбъектаИзСобытия() Экспорт

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.ТоварыИУслуги.ПриЗаписи")).Равно("Справочник.ТоварыИУслуги")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.ЗаказКлиента.ПередЗаписью")).Равно("Документ.ЗаказКлиента")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.РеализацияТоваровУслуг.ПриПроведении")).Равно("Документ.РеализацияТоваровУслуг")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.Номенклатура")).Равно("Справочник.Номенклатура")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия("")).Равно("");

КонецПроцедуры

// agentrunner-104 кр. 1: Failed-запуск без снимка с прошедшим ar_ПовторитьПосле
// берется тиком автовозобновления ровно один раз: ПопытокВозобновления +1,
// ar_ПовторитьПосле очищен, событие Ошибка retry_failed (причина -
// snapshot_missing_or_incompatible); повторный тик не бесконечен - запись
// больше не кандидат.
Процедура ТехповторБезСнимкаНеБесконечен() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ДанныеОшибки = Новый Структура;
	ДанныеОшибки.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);
	ДанныеОшибки.Вставить("ОтветLLM", "Технический сбой теста");
	ar_AuditЗапуски.Завершить(RunId, ДанныеОшибки);
	ОМ_ar_ТестовыеДанные.ЗапланироватьПовторЗапуска(RunId, ТекущаяДатаСеанса() - 60);

	ar_Планировщик.ОбработатьАвтовозобновление();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)
		.Свойство("ПопытокВозобновления").Равно(1);

	СобытиеОшибки = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "retry_failed");
	ЮТест.ОжидаетЧто(СобытиеОшибки).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.Ошибка);
	ЮТест.ОжидаетЧто(
		СтрНайти(СобытиеОшибки.PayloadJSON, "snapshot_missing_or_incompatible") > 0).ЭтоИстина();

	ЗаписьПовтораРегистра = ЗаписьПовторитьПосле(RunId);
	ЮТест.ОжидаетЧто(ЗаписьПовтораРегистра = Дата(1, 1, 1)).ЭтоИстина();

	// Повторный тик: ar_ПовторитьПосле пуст - запись больше не кандидат,
	// счетчик попыток не растет (техповтор без снимка не бесконечен).
	ar_Планировщик.ОбработатьАвтовозобновление();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId).ПопытокВозобновления).Равно(1);

КонецПроцедуры

// agentrunner-105 кр. 3: позднее завершение фонового задания не перезаписывает
// финальный статус "Прерван" - статус и дата завершения не меняются, фикс
// события Ошибка late_completion_ignored с желаемым статусом.
Процедура ПозднееЗавершениеНеПерекрываетПрерван() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ar_AuditЗапуски.ПрерватьЗапуск(RunId);

	// ПрерватьЗапуск ставит дату завершения сам; позднее завершение её менять не должно.
	ДатаПрерывания = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId).ЗавершенВ;

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", "Ответ задания после прерывания");
	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеЗавершения);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван)
		.Свойство("ОтветLLM").Равно("")
		.Свойство("ЗавершенВ").Равно(ДатаПрерывания);

	СобытиеПозднего = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "late_completion_ignored");
	ЮТест.ОжидаетЧто(СобытиеПозднего).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.Ошибка);
	ЮТест.ОжидаетЧто(СтрНайти(СобытиеПозднего.PayloadJSON, "Завершён") > 0).ЭтоИстина();

КонецПроцедуры

// agentrunner-14 кр. 1-3: компакция CONS-16 удаляет терминальные записи
// очереди (cancelled) с ar_РешеноВ старше порога ar_КомпакцияAuditДней;
// свежая cancelled и pending (без ar_РешеноВ) любого возраста не удаляются.
Процедура КомпакцияУдаляетТерминальныеЗаписи() Экспорт

	ДнейПорога = ar_Константы.КомпакцияAuditДней();
	Если ДнейПорога <= 0 Тогда
		ДнейПорога = 90;
	КонецЕсли;
	ГраницаСтарая = ТекущаяДатаСеанса() - (ДнейПорога + 1) * 86400;

	// Разрешение компакции - глобальная константа: включается в транзакции
	// теста и откатывается вместе с ней.
	Константы.ar_РазрешитьОчисткуAudit.Установить(Истина);

	ИдСтарая = ЗаписатьОчередьТеста("cancelled", ГраницаСтарая);
	ИдСвежая = ЗаписатьОчередьТеста("cancelled", ТекущаяДатаСеанса());
	ИдОжидающая = ЗаписатьОчередьТеста("pending", ГраницаСтарая);

	ar_Планировщик.ОбработатьКомпакциюAudit();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдСтарая)).Равно("");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдСвежая)).Равно("cancelled");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдОжидающая)).Равно("pending");

КонецПроцедуры

// agentrunner-19 кр. 1, 3, 5: представление времени последнего запуска РЗ -
// давность с ЧН=0 ("0 сек назад"), минутная/секундная градация, «сегодня ЧЧ:ММ»
// для разовых в день заданий и «не запускалось», если запусков не было.
Процедура СтрокаЗдоровьяДавностьЗапуска() Экспорт

	ЭлементМинутный = ЭлементРЗ(10, Ложь);
	ЮТест.ОжидаетЧто(ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементМинутный))
		.Равно("10 сек назад");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(0, Ложь)))
		.Равно("0 сек назад");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(600, Ложь)))
		.Равно("10 мин назад");

	ЭлементРазВДень = ЭлементРЗ(10800, Истина);
	ЭлементРазВДень.Вставить("ПоследнийЗапуск",
		НачалоДня(ТекущаяДатаСеанса()) + 3 * 3600);
	ЮТест.ОжидаетЧто(ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРазВДень))
		.Равно("сегодня 03:00");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(-1, Ложь)))
		.Равно("не запускалось");

КонецПроцедуры

// agentrunner-19 кр. 8: диагностика планировщика содержит все 11 заданий
// AgentRunner, включая автовозобновление запусков и очистку служебного лога
// (agentrunner-314, Н-2).
Процедура ДиагностикаВключаетВсеЗадания() Экспорт

	Диагностика = ar_Планировщик.ДиагностикаПланировщика();

	ЮТест.ОжидаетЧто(Диагностика.Количество()).Равно(11);
	ЕстьАвтовозобновление = Ложь;
	ЕстьОчисткаЛога = Ложь;
	Для Каждого Элемент Из Диагностика Цикл
		Если Элемент.Имя = "ar_АвтовозобновлениеЗапусков" Тогда
			ЕстьАвтовозобновление = Истина;
		КонецЕсли;
		Если Элемент.Имя = "ar_ОчисткаСлужебногоЛога" Тогда
			ЕстьОчисткаЛога = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьАвтовозобновление).ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьОчисткаЛога).ЭтоИстина();

КонецПроцедуры

// agentrunner-107 кр. 8: тик планировщика самолечит паузу approval без
// ожидающих подтверждений - запуск возобновляется (approval_resume) с
// событием АвтоВозобновлён (code = approval_self_healed).
Процедура СамолечениеПаузыApproval() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеПаузы = Новый Структура;
	ДанныеПаузы.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ДанныеПаузы.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunId, ДанныеПаузы);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	ar_Планировщик.ОбработатьАвтовозобновление();

	СобытиеЛечения = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "approval_self_healed");
	ЮТест.ОжидаетЧто(СобытиеЛечения).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.АвтоВозобновлён);

КонецПроцедуры

// agentrunner-109 кр. 1, 123 кр. 1, 3; задача 214 (решение человека 2026-10-19):
// тик SCHED-09 по завершённому запуску с событиями пишет предложения в память
// агента напрямую (fact, rule, note, ar_Источник = auto), очередь подтверждений
// не используется; note несёт RunId итога, у fact/rule ИдЗапуска пустой;
// повторный тик не создает дублей (кр. 3).
Процедура ТикПамятиПишетПредложенияВПамять() Экспорт

	Подготовка = ПодготовитьЗапускСПамятью("Тестовый итог работы", 3, 2, 0, 0);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	// Все три типа - сразу в память (214), по одной записи каждого типа.
	ЗаписиПамяти = ОМ_ar_ТестовыеДанные.ПамятьАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.Количество(), "записей памяти").Равно(3);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.НайтиСтроки(Новый Структура("Тип", "note")).Количество(),
		"записей note").Равно(1);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.НайтиСтроки(Новый Структура("Тип", "fact")).Количество(),
		"записей fact").Равно(1);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.НайтиСтроки(Новый Структура("Тип", "rule")).Количество(),
		"записей rule").Равно(1);

	ЗаписьЗаметка = СтрокаПамятиПоТипу(ЗаписиПамяти, "note");
	ЮТест.ОжидаетЧто(ЗаписьЗаметка.Источник, "источник note").Равно("auto");
	ЮТест.ОжидаетЧто(СтрНайти(ЗаписьЗаметка.Текст, "Итог последнего завершённого запуска:") > 0,
		"текст note").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьЗаметка.ИдЗапуска, "RunId note").Равно(Подготовка.RunId);

	ЗаписьФакт = СтрокаПамятиПоТипу(ЗаписиПамяти, "fact");
	ЮТест.ОжидаетЧто(СтрНайти(ЗаписьФакт.Текст, "тест_частый_тул") > 0,
		"текст fact").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьФакт.ИдЗапуска, "RunId fact").Равно("");

	ЗаписьПравило = СтрокаПамятиПоТипу(ЗаписиПамяти, "rule");
	ЮТест.ОжидаетЧто(СтрНайти(ЗаписьПравило.Текст, "Падение соединения теста") > 0,
		"текст rule").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьПравило.ИдЗапуска, "RunId rule").Равно("");

	// Повторный тик: дублей в памяти нет (кр. 3), очередь подтверждений пуста (214).
	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ПамятьАгента(Подготовка.Агент).Количество(),
		"записей памяти после повтора").Равно(3);
	ЮТест.ОжидаетЧто(ЗаписиОчередиПредложенийПамяти(Подготовка.Агент).Количество(), "записей очереди").Равно(0);

КонецПроцедуры

// agentrunner-109 кр. 5: неуспешные вызовы инструментов и ошибки без текста
// (нет error/reason) не агрегируются - fact и rule не формируются; note по
// завершённому запуску пишется в память (214), очередь не пополняется.
Процедура ОшибкиБезТекстаНеСчитаются() Экспорт

	Подготовка = ПодготовитьЗапускСПамятью("Итог без полезных фактов", 0, 0, 2, 3);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	// В памяти только note (итог запуска); fact и rule не сформированы.
	ЗаписиПамяти = ОМ_ar_ТестовыеДанные.ПамятьАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.Количество(), "записей памяти").Равно(1);
	ЮТест.ОжидаетЧто(ЗаписиПамяти, "записи памяти")
		.Свойство("[0].Тип").Равно("note")
		.Свойство("[0].Источник").Равно("auto");
	ЮТест.ОжидаетЧто(ЗаписиОчередиПредложенийПамяти(Подготовка.Агент).Количество(), "записей очереди").Равно(0);

КонецПроцедуры

// agentrunner-124 кр. 1 в редакции 214 (sentinel-запуски s09_* упразднены):
// у двух агентов одного тика предложения изолированы - в памяти каждого свои
// fact и note, note несёт RunId и итог своего запуска, записи не смешиваются;
// очередь подтверждений не пополняется.
Процедура ПамятьПоАгентамНеСмешивается() Экспорт

	ПодготовкаА = ПодготовитьЗапускСПамятью("Итог агента А", 3, 0, 0, 0);
	ПодготовкаБ = ПодготовитьЗапускСПамятью("Итог агента Б", 3, 0, 0, 0);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	// По 2 записи на агента (fact + note), между агентами не перемешаны.
	ЗаписиА = ОМ_ar_ТестовыеДанные.ПамятьАгента(ПодготовкаА.Агент);
	ЗаписиБ = ОМ_ar_ТестовыеДанные.ПамятьАгента(ПодготовкаБ.Агент);
	ЮТест.ОжидаетЧто(ЗаписиА.Количество(), "записей агента А").Равно(2);
	ЮТест.ОжидаетЧто(ЗаписиБ.Количество(), "записей агента Б").Равно(2);

	ЗаметкаА = СтрокаПамятиПоТипу(ЗаписиА, "note");
	ЗаметкаБ = СтрокаПамятиПоТипу(ЗаписиБ, "note");
	ЮТест.ОжидаетЧто(ЗаметкаА <> Неопределено И ЗаметкаБ <> Неопределено,
		"note у обоих агентов").ЭтоИстина()
		.Что(ЗаметкаА.ИдЗапуска).Равно(ПодготовкаА.RunId)
		.Что(ЗаметкаБ.ИдЗапуска).Равно(ПодготовкаБ.RunId)
		.Что(СтрНайти(ЗаметкаА.Текст, "Итог агента А") > 0).ЭтоИстина()
		.Что(СтрНайти(ЗаметкаБ.Текст, "Итог агента Б") > 0).ЭтоИстина();

	// Очередь подтверждений не пополняется (214).
	ЮТест.ОжидаетЧто(ЗаписиОчередиПредложенийПамяти(ПодготовкаА.Агент).Количество(), "записей очереди А").Равно(0);
	ЮТест.ОжидаетЧто(ЗаписиОчередиПредложенийПамяти(ПодготовкаБ.Агент).Количество(), "записей очереди Б").Равно(0);

КонецПроцедуры

// agentrunner-290 E.1: тик опроса сначала разбирает очередь событий - событие
// с выключенной подпиской, поставленное до вызова, после тика удалено.
Процедура ОпросСначалаРазбираетОчередь() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	ОМ_ar_ТестовыеДанные.ВыключитьПодпискиСобытия();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент,
		Объект.Метаданные().ПолноеИмя(), "", Ложь);
	ОМ_ar_ТестовыеДанные.ДобавитьСтрокуОчереди(Подписка, Объект.Ссылка, ТекущаяДатаСеанса());

	ar_Планировщик.ОбработатьОпросПодписок();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка).Количество(),
		"строк очереди после тика опроса").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 E.2: опрашивать нечего (подписки стенда выключены, у теста -
// только активная подписка на горячий тип) - заполненная метка
// ar_ОпросПодписокПоследнийЗапуск сбрасывается в пустую и повторным тиком
// не пишется, исключений нет.
Процедура ОпросБезПодписокСбрасываетМетку() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	ОМ_ar_ТестовыеДанные.ВыключитьПодпискиСобытия();
	ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ar_ОбработчикПодписок.ГорячиеТипы()[0]);
	Константы.ar_ОпросПодписокПоследнийЗапуск.Установить(ТекущаяДатаСеанса());

	ar_Планировщик.ОбработатьОпросПодписок();

	ЮТест.ОжидаетЧто(Константы.ar_ОпросПодписокПоследнийЗапуск.Получить(),
		"метка после первого тика").Равно(Дата(1, 1, 1));

	ar_Планировщик.ОбработатьОпросПодписок();

	ЮТест.ОжидаетЧто(Константы.ar_ОпросПодписокПоследнийЗапуск.Получить(),
		"метка после второго тика").Равно(Дата(1, 1, 1));

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 E.3: пустая метка + активная подписка на негорячий тип
// (Справочник.ar_Агенты, агент подписки неактивен - запусков нет) - тик пишет
// метку начала текущей минуты (допуск - та же или следующая минута).
Процедура ОпросПишетМеткуНачалаМинуты() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	ОМ_ar_ТестовыеДанные.ВыключитьПодпискиСобытия();
	ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, "Справочник.ar_Агенты");
	Константы.ar_ОпросПодписокПоследнийЗапуск.Установить(Дата(1, 1, 1));

	ar_Планировщик.ОбработатьОпросПодписок();

	Метка = Константы.ar_ОпросПодписокПоследнийЗапуск.Получить();
	ГраницаМинуты = НачалоМинуты(ТекущаяДатаСеанса());
	ЮТест.ОжидаетЧто(Метка = ГраницаМинуты Или Метка = ГраницаМинуты + 60,
		"метка - начало текущей или следующей минуты").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"запусков неактивного агента").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-362 кр. 1: активных запусков агента столько же, сколько
// ar_Константы.МаксОдновременныхЗапусковАгента - рутина, пришедшая по
// расписанию, нового запуска не создает (SCHED-05: ветка «отложен до
// следующего тика», излишек не теряется - продолжение в тесте
// СлотОсвободилсяЗапускСтартуетНаТике). Записи занятых слотов созданы штатным
// ar_AuditЗапуски.Создать - подсчет (привилегированный фасад) их видит.
Процедура ЛимитАгентаОткладываетЗапускРутины() Экспорт

	Подготовка = ПодготовитьАгентаСРутиной();
	Лимит = ar_Константы.МаксОдновременныхЗапусковАгента();
	СоздатьАктивныеЗапуски(Подготовка.Агент, Лимит);
	ЗапускиДо = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество();
	ЮТест.ОжидаетЧто(ЗапускиДо, "занятых слотов до тика").Равно(Лимит);

	ar_Планировщик.ОбработатьПланировщик();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество(),
		"запусков после тика при исчерпанном лимите агента").Равно(ЗапускиДо);

КонецПроцедуры

// agentrunner-362 кр. 2: суммарный лимит активных запусков достигнут - новый
// агент не стартует (SCHED-05: ВсегоАктивных >= ЛимитСуммарный, запуск
// отложен до следующего тика; собственный лимит агента при этом не исчерпан -
// откладывает именно суммарный счетчик).
Процедура СуммарныйЛимитОткладываетЗапуск() Экспорт

	Подготовка = ПодготовитьАгентаСРутиной();
	Паразит = ОМ_ar_ТестовыеДанные.НовыйАгент(Подготовка.Провайдер);
	СоздатьАктивныеЗапуски(Паразит, ar_Константы.МаксСуммарныхЗапусков());

	ar_Планировщик.ОбработатьПланировщик();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество(),
		"запусков нового агента при достигнутом суммарном лимите").Равно(0);

КонецПроцедуры

// agentrunner-362 кр. 3: чужие активные запуски в лимит агента не входят -
// при собственных активных запусках 0 и числе чужих до ЛимитПоАгенту
// включительно агент стартует (глобальный подсчет per-agent лимита отложил бы
// запуск). Подсчет идет через привилегированный фасад ar_AuditЗапуски -
// записи ar_AuditЗапуски.Создать учитываются без прав текущего пользователя.
// Старт реальный: агент на ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура ЧужиеЗапускиНеБлокируютАгента() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьАгентаСРутиной();
	Паразит = ОМ_ar_ТестовыеДанные.НовыйАгент(Подготовка.Провайдер);
	Чужих = МИН(ar_Константы.МаксОдновременныхЗапусковАгента(),
		ar_Константы.МаксСуммарныхЗапусков() - 1);
	СоздатьАктивныеЗапуски(Паразит, Чужих);
	УстановитьСценарийСтарта(Подготовка.Провайдер);

	ar_Планировщик.ОбработатьПланировщик();

	Запуски = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(Запуски.Количество(), "запусков агента при чужих активных запусках").Равно(1)
		.Что(Запуски[0].Триггер).Равно("cron");

КонецПроцедуры

// agentrunner-362 кр. 1 (отложен, а не потерян): при занятом лимите агента
// тик запуск не создает; после освобождения слота (один запуск завершен)
// следующий тик стартует рутину. Внутренний guard агента
// (ar_МаксПараллельныхЗапусков) поднимается до константы SCHED-05, чтобы
// отсечку делал именно rate-limiter планировщика. Старт реальный: агент на
// ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура СлотОсвободилсяЗапускСтартуетНаТике() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьАгентаСРутиной();
	Лимит = ar_Константы.МаксОдновременныхЗапусковАгента();
	ЭлементАгента = Подготовка.Агент.ПолучитьОбъект();
	ЭлементАгента.ar_МаксПараллельныхЗапусков = Лимит;
	ЭлементАгента.Записать();
	РунИды = СоздатьАктивныеЗапуски(Подготовка.Агент, Лимит);
	УстановитьСценарийСтарта(Подготовка.Провайдер);

	ar_Планировщик.ОбработатьПланировщик();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество(),
		"запусков при занятом лимите (первый тик)").Равно(Лимит);

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", "Слот освобожден тестом SCHED-05");
	ar_AuditЗапуски.Завершить(РунИды[0], ДанныеЗавершения);

	ar_Планировщик.ОбработатьПланировщик();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество(),
		"запусков после освобождения слота (второй тик)").Равно(Лимит + 1);

КонецПроцедуры

// agentrunner-376 кр. 1 (ветки входа SCHED-07): тик упоминаний без активных
// mention-рутин сдвигает метку ar_ОбработчикУпоминанийПоследнийЗапуск к текущему
// моменту; при активных рутинах и недоступной СистемеВзаимодействия метка
// остается на границе выборки. Запусков агентов тик в обоих случаях не создает.
// Разбор "@имя" (источник сообщений - СВ) юнит-тестом недостижим - см. tests.md.
Процедура УпоминанияБезРутинСдвигаютМеткуОбработки() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	МеткаТика = ТекущаяДатаСеанса();
	Константы.ar_ОбработчикУпоминанийПоследнийЗапуск.Установить(МеткаТика - 3600);

	ar_Планировщик.ОбработатьУпоминания();

	МеткаПосле = Константы.ar_ОбработчикУпоминанийПоследнийЗапуск.Получить();
	Если ЕстьАктивныеРутиныУпоминаний() Тогда
		// Ветка "есть рутины": метка движется только по датам обработанных сообщений.
		Если НЕ СистемаВзаимодействия.Подключена() Тогда
			ЮТест.ОжидаетЧто(МеткаПосле, "метка при недоступной СВ").Равно(МеткаТика - 3600);
		КонецЕсли;
	Иначе
		// Ветка "нет рутин": метка сдвигается к текущему моменту (допуск минуты).
		ЮТест.ОжидаетЧто(МеткаПосле >= МеткаТика - 60 И МеткаПосле <= ТекущаяДатаСеанса() + 60,
			"метка сдвинута к текущему моменту").ЭтоИстина();
	КонецЕсли;

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"запусков тестового агента").Равно(0);

КонецПроцедуры

// agentrunner-376 кр. 1 (повторная обработка): два тика подряд по свежей метке
// (в выборке нет сообщений с уникальным именем тестового агента) не создают
// запуска - защита от повторного запуска по одному и тому же сообщению.
Процедура ПовторныйТикУпоминанийНеСоздаетЗапуск() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	СоздатьРутинуУпоминаний(Агент);
	Константы.ar_ОбработчикУпоминанийПоследнийЗапуск.Установить(ТекущаяДатаСеанса());

	ar_Планировщик.ОбработатьУпоминания();
	ar_Планировщик.ОбработатьУпоминания();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"запусков агента после двух тиков").Равно(0);

КонецПроцедуры

// agentrunner-376 кр. 2 (SCHED-03): тик возобновления берет approved-запись
// очереди и возобновляет приостановленный на подтверждении запуск - фоновое
// задание поставлено и/или статус покинул паузу (опрос с таймаутом). Реальный
// старт: агент на ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура ОдобренноеПодтверждениеВозобновляетЗапуск() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьПриостановленныйЗапуск(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ЗаписатьПодтверждениеВОчередь("approved", Подготовка.RunId, "{}");

	ar_Планировщик.ОбработатьВозобновление();

	ЮТест.ОжидаетЧто(ЖдатьВозобновлениеЗапуска(Подготовка.RunId),
		"запуск возобновлен тиком по одобренному подтверждению").ЭтоИстина();

КонецПроцедуры

// agentrunner-376 кр. 2 (TOOL-19 D8): тик возобновления берет answered-запись
// (ask_user) с user_answer в payload и возобновляет приостановленный для ввода
// запуск. Реальный старт: агент на ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура ОтвеченныйВопросВозобновляетЗапуск() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьПриостановленныйЗапуск(Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода);
	ПолезнаяНагрузка = Новый Структура("user_answer", "Ответ оператора теста");
	ЗаписатьПодтверждениеВОчередь("answered", Подготовка.RunId, ar_JSON.ВЗначениеJSON(ПолезнаяНагрузка));

	ar_Планировщик.ОбработатьВозобновление();

	ЮТест.ОжидаетЧто(ЖдатьВозобновлениеЗапуска(Подготовка.RunId),
		"запуск возобновлен тиком по отвеченному вопросу").ЭтоИстина();

КонецПроцедуры

// agentrunner-376 кр. 3 (SCHED-04): запуск Выполняется с пульсом старше порога
// HeartbeatПорогСек прерывается очисткой зависших - статус Прерван и событие
// ЗапускПрерванСвипером (heartbeat_timeout); запуск со свежим пульсом тик
// не трогает.
Процедура ЗависшийПоПульсуПрерывается() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	РунИдыЗависший = СоздатьАктивныеЗапуски(Агент, 1, "manual");
	ПорогСек = ar_Константы.HeartbeatПорогСек();
	ОбновитьПолеЗапуска(РунИдыЗависший[0], "ar_ПоследнийПульс",
		ТекущаяДатаСеанса() - ПорогСек - 60);

	РунИдыСвежий = СоздатьАктивныеЗапуски(Агент, 1, "manual");
	ОбновитьПолеЗапуска(РунИдыСвежий[0], "ar_ПоследнийПульс", ТекущаяДатаСеанса());

	ar_Планировщик.ОбработатьОчисткуЗависших();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(РунИдыЗависший[0]).Статус,
		"зависший по пульсу прерван").Равно(Перечисления.ar_СтатусЗапуска.Прерван);

	СобытиеПрерывания = СобытиеТипа(РунИдыЗависший[0], Перечисления.ar_ТипСобытия.ЗапускПрерванСвипером);
	ЮТест.ОжидаетЧто(СобытиеПрерывания <> Неопределено, "событие прерывания записано").ЭтоИстина()
		.Что(СтрНайти(СобытиеПрерывания.PayloadJSON, "heartbeat_timeout") > 0).ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(РунИдыСвежий[0]).Статус,
		"свежий пульс защищает запуск").Равно(Перечисления.ar_СтатусЗапуска.Выполняется);

КонецПроцедуры

// agentrunner-376 кр. 3 (CONS-09, блок 1): прерванный запуск со снимком при
// свободном суммарном слоте рестартуется тиком автовозобновления - статус
// уходит из Прерван и счетчик попыток ставятся синхронно (до старта фонового
// задания), фиксируется событие автовозобновления (process_restart). Итоговый
// статус не проверяется строго: фоновое задание может завершить запуск до
// проверки. Реальный старт: агент на ar_LLMMock, тест вне транзакции,
// очистка - .После.
Процедура РестартПрерванногоПриСвободномСлоте() Экспорт

	ОчиститьДанныеСтарта();
	ЮТест.ОжидаетЧто(СуммарноАктивныхЗапусков() < ar_Константы.МаксСуммарныхЗапусков(),
		"предусловие: суммарный слот свободен").ЭтоИстина();

	Подготовка = ПодготовитьПрерванныйЗапуск();

	ar_Планировщик.ОбработатьАвтовозобновление();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус <> Перечисления.ar_СтатусЗапуска.Прерван,
		"прерванный запуск возвращен в работу").ЭтоИстина()
		.Что(Запуск.ПопытокВозобновления).Равно(1);

	СобытиеРестарта = СобытиеТипа(Подготовка.RunId, Перечисления.ar_ТипСобытия.АвтоВозобновлён);
	ЮТест.ОжидаетЧто(СобытиеРестарта <> Неопределено, "событие автовозобновления записано").ЭтоИстина()
		.Что(СтрНайти(СобытиеРестарта.PayloadJSON, "process_restart") > 0).ЭтоИстина();

КонецПроцедуры

// agentrunner-376 кр. 3 (CONS-09, блок 1): при исчерпанном суммарном лимите
// кандидат рестарта не возобновляется и не теряется - статус Прерван, счетчик
// попыток не растет, событие автовозобновления не пишется (запуск ждет
// следующий тик). Фоновое задание не стартует - тест в транзакции.
Процедура РестартБезСлотаЖдетСледующийТик() Экспорт

	Подготовка = ПодготовитьПрерванныйЗапуск();
	Паразит = ОМ_ar_ТестовыеДанные.НовыйАгент(Подготовка.Провайдер);
	СоздатьАктивныеЗапуски(Паразит, ar_Константы.МаксСуммарныхЗапусков(), "manual");

	ar_Планировщик.ОбработатьАвтовозобновление();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван)
		.Свойство("ПопытокВозобновления").Равно(0);
	ЮТест.ОжидаетЧто(СобытиеТипа(Подготовка.RunId, Перечисления.ar_ТипСобытия.АвтоВозобновлён) = Неопределено,
		"событие рестарта не записано").ЭтоИстина();

КонецПроцедуры

// agentrunner-376 кр. 3 (CONS-09, блок 2): запланированный повтор технического
// сбоя возобновляет запуск - счетчик ПопытокВозобновления растет, фиксируется
// событие автовозобновления (transient_error_retry); оба эффекта ставятся тиком
// синхронно. Очистку ar_ПовторитьПосле и итоговый статус не проверяем строго:
// фоновое задание может успеть изменить их до проверки. Неудачная ветка без
// снимка покрыта тестом ТехповторБезСнимкаНеБесконечен. Реальный старт: агент
// на ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура РетрайТехсбояВозобновляетЗапуск() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьЗапускСПовтором();

	ar_Планировщик.ОбработатьАвтовозобновление();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).ПопытокВозобновления,
		"счетчик попыток возобновления").Равно(1);

	СобытиеРетрая = СобытиеТипа(Подготовка.RunId, Перечисления.ar_ТипСобытия.АвтоВозобновлён);
	ЮТест.ОжидаетЧто(СобытиеРетрая <> Неопределено, "событие автовозобновления записано").ЭтоИстина()
		.Что(СтрНайти(СобытиеРетрая.PayloadJSON, "transient_error_retry") > 0).ЭтоИстина();

КонецПроцедуры

// agentrunner-376 кр. 3 (PLAN-13, блок 3): спящий запуск с истекшим
// ar_ОжиданиеДо разбуждается тиком по триггеру deadline_resume - фиксируется
// событие ОжиданиеСобытия с кодом wait_expired. Реальный старт: агент на
// ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура ДедлайнОжиданияБудитЗапуск() Экспорт

	ОчиститьДанныеСтарта();
	Подготовка = ПодготовитьСпящийЗапуск();

	ar_Планировщик.ОбработатьАвтовозобновление();

	СобытиеДедлайна = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(Подготовка.RunId, "wait_expired");
	ЮТест.ОжидаетЧто(СобытиеДедлайна).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.ОжиданиеСобытия);

КонецПроцедуры

// agentrunner-376 кр. 4 (SESS-03): тик ротации закрывает активные сессии с
// ar_Обновлена старше СессияTTLДней (запись дезактивируется; если она старше
// еще и срока хранения после закрытия - второй шаг тика ее удаляет); свежая
// сессия остается активной.
Процедура РотацияЗакрываетПросроченныеСессии() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	ДнейTTL = Макс(ar_Константы.СессияTTLДней(), 1);
	ЯкорьСтарая = "chat:тест-" + УникальныйСуффикс();
	ЯкорьСвежая = "chat:тест-" + УникальныйСуффикс();
	ЗаписатьСессиюТеста(Агент, ЯкорьСтарая,
		ТекущаяДатаСеанса() - (ДнейTTL + 1) * 86400, Истина);
	ЗаписатьСессиюТеста(Агент, ЯкорьСвежая, ТекущаяДатаСеанса(), Истина);

	ar_Планировщик.ОбработатьРотациюСессий();

	СессияСтарая = СессияПоЯкорю(Агент, ЯкорьСтарая);
	ЮТест.ОжидаетЧто(НЕ СессияСтарая.Активна,
		"просроченная сессия закрыта (или удалена вторым шагом)").ЭтоИстина();

	СессияСвежая = СессияПоЯкорю(Агент, ЯкорьСвежая);
	ЮТест.ОжидаетЧто(СессияСвежая.Найдена И СессияСвежая.Активна,
		"свежая сессия осталась активной").ЭтоИстина();

КонецПроцедуры

// Тик регламентного задания (обработчик ar_Планировщик) на данных стенда не
// выбрасывает исключение - тики единственный «двигатель» фоновой работы.
// Вызов по имени процедуры (параметр теста), в транзакции теста.
//
// Параметры:
//  ИмяПроцедуры - Строка - экспортная процедура ar_Планировщик без параметров.
//
Процедура ТикБезИсключений(Знач ИмяПроцедуры) Экспорт

	ТекстОшибки = "";
	Попытка
		Выполнить("ar_Планировщик." + ИмяПроцедуры + "()");
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "исключение тика ar_Планировщик." + ИмяПроцедуры).Равно("");

КонецПроцедуры

// Два тика ОбработатьПланировщик в одну минуту по рутине «каждую минуту» дают
// один запуск агента, а не два. Тики - в пределах одной минуты (при старте в
// конце минуты тест дожидается следующей). Старт реальный: агент на
// ar_LLMMock, тест вне транзакции, очистка - .После.
Процедура ПовторныйТикИдемпотентен() Экспорт

	// Защиты от второго тика в ту же минуту в ar_Планировщик нет: прогон 14.11.2026
	// дал два запуска. Снять пропуск после исправления src.
	ЮТест.Пропустить("Дефект: второй тик ОбработатьПланировщик в ту же минуту запускает агента повторно (исправление src - отдельной задачей)");

	ОчиститьДанныеСтарта();
	ДождатьсяНачалаМинуты(40);
	Подготовка = ПодготовитьАгентаСРутиной();
	УстановитьСценарийСтарта(Подготовка.Провайдер);
	МинутаПервогоТика = НачалоМинуты(ТекущаяДатаСеанса());

	ar_Планировщик.ОбработатьПланировщик();
	ar_Планировщик.ОбработатьПланировщик();

	ЮТест.ОжидаетЧто(НачалоМинуты(ТекущаяДатаСеанса()), "тики в одну минуту").Равно(МинутаПервогоТика);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент).Количество(),
		"запусков агента после двух тиков в одну минуту").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если текущая секунда минуты больше МаксСекунда, ждёт начала следующей минуты
// (не дольше 25 секунд): действия теста укладываются в одну минуту.
//
// Параметры:
//  МаксСекунда - Число - секунда минуты, после которой ждать следующую.
//
Процедура ДождатьсяНачалаМинуты(Знач МаксСекунда)

	Если Секунда(ТекущаяДатаСеанса()) <= МаксСекунда Тогда
		Возврат;
	КонецЕсли;
	ТекущаяМинута = НачалоМинуты(ТекущаяДатаСеанса());
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + 25000;
	Пока НачалоМинуты(ТекущаяДатаСеанса()) = ТекущаяМинута
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		// Ожидание начала следующей минуты.
	КонецЦикла;

КонецПроцедуры


// Проверяет, что массив ссылок перечисления содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Первая запись памяти агента заданного типа ("fact", "rule", "note").
//
// Параметры:
//  ЗаписиПамяти - ТаблицаЗначений - результат ОМ_ar_ТестовыеДанные.ПамятьАгента.
//  ТипЗаписи    - Строка - значение колонки Тип.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - найденная строка, при отсутствии типа
//  в таблице - Неопределено.
//
Функция СтрокаПамятиПоТипу(Знач ЗаписиПамяти, Знач ТипЗаписи)

	Найденные = ЗаписиПамяти.НайтиСтроки(Новый Структура("Тип", ТипЗаписи));
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Найденные[0];

КонецФункции

// Читает ar_ПовторитьПосле записи запуска (прямым запросом: у ar_AuditЗапуски
// нет экспортного чтения этого поля).
//
Функция ЗаписьПовторитьПосле(Знач RunId)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Запуски.ar_ПовторитьПосле КАК ПовторитьПосле
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId");
	Запрос.УстановитьПараметр("RunId", RunId);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПовторитьПосле;
	КонецЕсли;
	Возврат Дата(1, 1, 1);

КонецФункции

// Создает запись очереди подтверждений с заданным статусом и временем решения
// (прямая запись менеджером - как СостаритьЗаписьОчереди в ОМ_ar_Подтверждение).
//
// Возвращаемое значение:
//  Строка - ApprovalId созданной записи.
//
Функция ЗаписатьОчередьТеста(Знач Статус, Знач РешеноВ)

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = "{}";
	Запись.ar_Статус = Статус;
	Запись.ar_СозданоВ = РешеноВ;
	Запись.ar_РешеноВ = РешеноВ;
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Структура элемента диагностики РЗ (состав - как ar_Планировщик.ЭлементДиагностики).
//
Функция ЭлементРЗ(Знач СекундНазад, Знач РазВДень)

	Элемент = Новый Структура;
	Элемент.Вставить("Имя", "тест_задание");
	Элемент.Вставить("Синоним", "Тестовое задание");
	Элемент.Вставить("ПоследнийЗапуск", '00010101');
	Элемент.Вставить("СекундНазад", СекундНазад);
	Элемент.Вставить("Статус", "ok");
	Элемент.Вставить("РазВДень", РазВДень);
	Возврат Элемент;

КонецФункции

// Завершенный запуск агента с событиями для агрегации SCHED-09: итог (content),
// успешные вызовы инструмента, ошибки с причиной и без нее, неуспешные вызовы.
//
// Параметры:
//  ИтогТекст          - Строка - content события Завершён (и ОтветLLM записи);
//  УспешныхВызовов    - Число  - ВызванИнструмент success=true, один tool;
//  ОшибокСПричиной    - Число  - Ошибка с reason;
//  ОшибокБезПричины   - Число  - Ошибка без reason (в агрегацию не попадают);
//  НеуспешныхВызовов  - Число  - ВызванИнструмент success=false (не считаются).
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовитьЗапускСПамятью(Знач ИтогТекст, Знач УспешныхВызовов, Знач ОшибокСПричиной,
	Знач ОшибокБезПричины, Знач НеуспешныхВызовов)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", ИтогТекст);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	PayloadИтога = Новый Структура;
	PayloadИтога.Вставить("code", "run_completed");
	PayloadИтога.Вставить("content", ИтогТекст);
	ar_AuditСобытия.Зафиксировать(RunId, "Завершён", PayloadИтога);

	Сч = 0;
	Пока Сч < УспешныхВызовов Цикл
		Сч = Сч + 1;
		PayloadВызова = Новый Структура;
		PayloadВызова.Вставить("code", "tool_called");
		PayloadВызова.Вставить("tool", "тест_частый_тул");
		PayloadВызова.Вставить("success", Истина);
		ar_AuditСобытия.Зафиксировать(RunId, "ВызванИнструмент", PayloadВызова);
	КонецЦикла;

	Сч = 0;
	Пока Сч < ОшибокСПричиной Цикл
		Сч = Сч + 1;
		PayloadОшибки = Новый Структура;
		PayloadОшибки.Вставить("code", "run_failed");
		PayloadОшибки.Вставить("reason", "Падение соединения теста");
		ar_AuditСобытия.Зафиксировать(RunId, "Ошибка", PayloadОшибки);
	КонецЦикла;

	Сч = 0;
	Пока Сч < ОшибокБезПричины Цикл
		Сч = Сч + 1;
		PayloadПустой = Новый Структура;
		PayloadПустой.Вставить("code", "run_failed");
		ar_AuditСобытия.Зафиксировать(RunId, "Ошибка", PayloadПустой);
	КонецЦикла;

	Сч = 0;
	Пока Сч < НеуспешныхВызовов Цикл
		Сч = Сч + 1;
		PayloadНеудачи = Новый Структура;
		PayloadНеудачи.Вставить("code", "tool_called");
		PayloadНеудачи.Вставить("tool", "тест_ошибочный_тул");
		PayloadНеудачи.Вставить("success", Ложь);
		ar_AuditСобытия.Зафиксировать(RunId, "ВызванИнструмент", PayloadНеудачи);
	КонецЦикла;

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

// Записи очереди подтверждений SCHED-09 (предложения памяти) по агенту:
// IdempotencyKey предложений начинается с "sched09_<представление агента>_".
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ApprovalId, Статус, RunId, IdempotencyKey,
//  ActionPayloadJSON.
//
Функция ЗаписиОчередиПредложенийПамяти(Знач Агент)

	ИмяАгента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "Наименование");
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Очередь.ar_ApprovalId КАК ApprovalId,
		|	Очередь.ar_Статус КАК Статус,
		|	Очередь.ar_RunId КАК RunId,
		|	Очередь.ar_IdempotencyKey КАК IdempotencyKey,
		|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_IdempotencyKey ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_СозданоВ");
	// Служебные символы имени (% _ [ ] ^) экранируются, хвост "%" оставлен wildcard'ом.
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе("sched09_" + СокрЛП(ИмяАгента)) + "%");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Создает активного агента с cron-рутиной «каждую минуту» и проверяет
// предусловие: cron-выражение соответствует текущей минуте (иначе планировщик
// агента не выберет и тест проверял бы не ту ветку).
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, РутинаРеф}.
//
Функция ПодготовитьАгентаСРутиной()

	ЮТест.ОжидаетЧто(
		ar_Расписание.СовпадаетСВременем(ВыражениеКаждуюМинуту(), НачалоМинуты(ТекущаяДатаСеанса())),
		"предусловие: cron-выражение соответствует текущей минуте").ЭтоИстина();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	РутинаРеф = СоздатьКронРутину(Агент);

	Возврат Новый Структура("Провайдер, Агент, РутинаРеф", Провайдер, Агент, РутинаРеф);

КонецФункции

// Cron-выражение «каждая минута»: совпадает с любым моментом, поэтому тик
// внутри теста всегда выбирает рутину независимо от перехода минуты.
//
// Возвращаемое значение:
//  Строка - cron-выражение из пяти полей.
//
Функция ВыражениеКаждуюМинуту()

	Возврат "* * * * *";

КонецФункции

// Создает активную cron-рутину агента (ROUT-02): ar_ТипТриггера = "cron", в
// ar_ПараметрыJSON - выражение «каждую минуту» (разбор в АгентыИзРутин).
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент рутины.
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Рутины - созданная рутина.
//
Функция СоздатьКронРутину(Знач Агент)

	Рутина = Справочники.ar_Рутины.СоздатьЭлемент();
	Рутина.Наименование = "ТестРутина_" + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	Рутина.ar_Агент = Агент;
	Рутина.ar_Активна = Истина;
	Рутина.ar_ТипТриггера = "cron";
	Рутина.ar_ПараметрыJSON = "{""expression"": ""* * * * *""}";
	Рутина.ar_ИнструкцияПереопределение = "";
	Рутина.Записать();

	Возврат Рутина.Ссылка;

КонецФункции

// Создает заданное число активных (Выполняется) записей запусков агента -
// занятые слоты rate-limiter SCHED-05. Записи создаются штатным фасадом
// ar_AuditЗапуски.Создать - ровно как видит их реальный подсчет.
//
// Параметры:
//  Агент      - СправочникСсылка.ar_Агенты - владелец слотов;
//  Количество - Число - сколько слотов занять;
//  Триггер    - Строка - триггер записей (по умолчанию "cron").
//
// Возвращаемое значение:
//  Массив из Строка - RunId созданных записей.
//
Функция СоздатьАктивныеЗапуски(Знач Агент, Знач Количество, Знач Триггер = "cron")

	РунИды = Новый Массив;
	Сч = 0;
	Пока Сч < Количество Цикл
		Сч = Сч + 1;
		RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
		ДанныеЗапуска = Новый Структура;
		ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
		ДанныеЗапуска.Вставить("АгентРеф", Агент);
		ДанныеЗапуска.Вставить("Триггер", Триггер);
		ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);
		РунИды.Добавить(RunId);
	КонецЦикла;

	Возврат РунИды;

КонецФункции

// Устанавливает персональный сценарий заглушки провайдера для реального
// старта: текстовый ответ и вердикт «выполнено» (цикл завершится сам).
//
// Параметры:
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер агента старта.
//
Процедура УстановитьСценарийСтарта(Знач Провайдер)

	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Отчет готов."));
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий, Провайдер);

КонецПроцедуры

// Очистка данных тестов с реальным стартом (.После, и самопроверка перед
// тестом): гасит фоновые задания тестовых агентов (ar_RuntimeЗапуск.Отменить),
// очищает сценарий заглушки, удаляет записи ar_Запуски/ar_СобытияЗапуска/
// ar_ДействияАгента и объекты (рутины, агенты, провайдеры) по служебным
// префиксам. Транзакционные тесты не трогает - их данные откатывает движок.
Процедура ОчиститьДанныеСтарта() Экспорт

	Агенты = СсылкиТестовыхОбъектов("ar_Агенты", "ТестАгент_");
	РунИды = Новый Массив;
	Если Агенты.Количество() > 0 Тогда
		РунИды = РунИдыАгентов(Агенты);
		Для Каждого RunId Из РунИды Цикл
			Попытка
				ar_RuntimeЗапуск.Отменить(RunId);
			Исключение
				// Не прерываем очистку: запись запуска будет удалена ниже напрямую.
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		// Дети раньше родителей: действия и события, затем сами запуски.
		УдалитьЗаписиДействий(РунИды);
		УдалитьЗаписиСобытий(РунИды);
		УдалитьЗаписиЗапусков(РунИды);
	КонецЕсли;

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();
	УдалитьТестовыеОбъекты("ar_Рутины", "ТестРутина_");
	УдалитьТестовыеОбъекты("ar_Агенты", "ТестАгент_");
	УдалитьТестовыеОбъекты("ar_LLMПровайдеры", "ТестЗаглушка_");

КонецПроцедуры

// Ссылки элементов справочника по префиксу наименования (тесты создают данные
// только с префиксами "ТестАгент_", "ТестРутина_", "ТестЗаглушка_").
//
// Параметры:
//  ИмяКаталога - Строка - имя справочника расширения;
//  Префикс     - Строка - префикс наименования тестовых элементов.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка - найденные элементы.
//
Функция СсылкиТестовыхОбъектов(Знач ИмяКаталога, Знач Префикс)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	Объекты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Объекты
		|ГДЕ
		|	Объекты.Наименование ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""",
		ИмяКаталога);
	// Служебные символы префикса экранируются, хвост "%" оставлен wildcard'ом.
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Префикс) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// RunId всех записей запусков перечисленных агентов (ar_Запуски.ar_АгентРеф).
//
// Параметры:
//  Агенты - Массив из СправочникСсылка.ar_Агенты.
//
// Возвращаемое значение:
//  Массив из Строка - идентификаторы запусков.
//
Функция РунИдыАгентов(Знач Агенты)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Запуски.ar_ИдентификаторЗапуска КАК RunId
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_АгентРеф В (&Агенты)");
	Запрос.УстановитьПараметр("Агенты", Агенты);

	Выборка = Запрос.Выполнить().Выбрать();
	РунИды = Новый Массив;
	Пока Выборка.Следующий() Цикл
		РунИды.Добавить(Выборка.RunId);
	КонецЦикла;

	Возврат РунИды;

КонецФункции

// Удаляет записи запусков тестовых агентов из ar_Запуски (измерение
// ar_ИдентификаторЗапуска, один RunId - один набор).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиЗапусков(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_Запуски.СоздатьНаборЗаписей();
		Набор.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет события тестовых запусков из ar_СобытияЗапуска (измерение ar_RunId).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиСобытий(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_СобытияЗапуска.СоздатьНаборЗаписей();
		Набор.Отбор.ar_RunId.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет действия тестовых запусков из ar_ДействияАгента (измерение
// ar_ИдентификаторЗапуска).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиДействий(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_ДействияАгента.СоздатьНаборЗаписей();
		Набор.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет элементы справочника по префиксу наименования (данные тестов).
//
// Параметры:
//  ИмяКаталога - Строка - имя справочника расширения;
//  Префикс     - Строка - префикс наименования тестовых элементов.
//
Процедура УдалитьТестовыеОбъекты(Знач ИмяКаталога, Знач Префикс)

	Ссылки = СсылкиТестовыхОбъектов(ИмяКаталога, Префикс);
	Для Каждого Ссылка Из Ссылки Цикл
		Элемент = Ссылка.ПолучитьОбъект();
		Если Элемент <> Неопределено Тогда
			Элемент.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Очистка тестов возобновления (.После): гасит фоновые задания и удаляет
// данные тестовых запусков (ОчиститьДанныеСтарта), затем удаляет записи
// очереди подтверждений по RunId этих запусков - одобренные/отвеченные
// остатки не должны попадать в тики других тестов.
Процедура ОчиститьДанныеРезюме() Экспорт

	РунИды = РунИдыАгентов(СсылкиТестовыхОбъектов("ar_Агенты", "ТестАгент_"));
	ОчиститьДанныеСтарта();
	УдалитьЗаписиПодтверждений(РунИды);

КонецПроцедуры

// Удаляет записи очереди подтверждений тестовых запусков. У регистра одно
// измерение ar_ApprovalId, а ar_RunId - ресурс: отбор набора по ресурсу не
// существует, поэтому идентификаторы подтверждений выбираются одним запросом
// (условие В (&РунИды)), а записи удаляются наборами с отбором по измерению.
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиПодтверждений(Знач РунИды)

	Если РунИды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Подтверждения.ar_ApprovalId КАК ApprovalId
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Подтверждения
		|ГДЕ
		|	Подтверждения.ar_RunId В (&РунИды)");
	Запрос.УстановитьПараметр("РунИды", РунИды);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ar_ОчередьApproval.СоздатьНаборЗаписей();
		Набор.Отбор.ar_ApprovalId.Установить(Выборка.ApprovalId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Создает агента на заглушке и приостановленный запуск со снимком состояния
// (контракт возобновления: снимок обязателен, иначе Возобновить откажет с
// snapshot_missing_or_incompatible).
//
// Параметры:
//  СтатусПаузы - ПеречислениеСсылка.ar_СтатусЗапуска - статус паузы запуска.
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, RunId}.
//
Функция ПодготовитьПриостановленныйЗапуск(Знач СтатусПаузы)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	УстановитьСценарийСтарта(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", СтатусПаузы);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "manual");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	Возврат Новый Структура("Провайдер, Агент, RunId", Провайдер, Агент, RunId);

КонецФункции

// Создает прерванный запуск со снимком - кандидат рестарта CONS-09 (статус
// Прерван, ar_ЗавершенВ свежая, снимок непуст, попыток возобновления 0).
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, RunId}.
//
Функция ПодготовитьПрерванныйЗапуск()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	УстановитьСценарийСтарта(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ar_AuditЗапуски.ПрерватьЗапуск(RunId);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	Возврат Новый Структура("Провайдер, Агент, RunId", Провайдер, Агент, RunId);

КонецФункции

// Создает Failed-запуск с наступившим ar_ПовторитьПосле и снимком - кандидат
// повтора технического сбоя (CONS-09, блок 2).
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, RunId}.
//
Функция ПодготовитьЗапускСПовтором()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	УстановитьСценарийСтарта(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ДанныеОшибки = Новый Структура;
	ДанныеОшибки.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);
	ДанныеОшибки.Вставить("ОтветLLM", "Транзиентный сбой теста");
	ar_AuditЗапуски.Завершить(RunId, ДанныеОшибки);
	ОМ_ar_ТестовыеДанные.ЗапланироватьПовторЗапуска(RunId, ТекущаяДатаСеанса() - 60);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	Возврат Новый Структура("Провайдер, Агент, RunId", Провайдер, Агент, RunId);

КонецФункции

// Создает спящий запуск (ПриостановленДляСобытия) с истекшим ar_ОжиданиеДо и
// снимком - кандидат дедлайна ожидания события (PLAN-13, блок 3).
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, RunId}.
//
Функция ПодготовитьСпящийЗапуск()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	УстановитьСценарийСтарта(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "manual");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);
	ОбновитьПолеЗапуска(RunId, "ar_ОжиданиеДо", ТекущаяДатаСеанса() - 60);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	Возврат Новый Структура("Провайдер, Агент, RunId", Провайдер, Агент, RunId);

КонецФункции

// Опрос возобновления запуска с таймаутом: фоновое задание активно и/или
// статус покинул паузу. Паузы между проверками - ОбменДаннымиСервер.Пауза
// (БСП); вызывается только из нетранзакционных тестов.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска;
//  ТаймаутСек - Число - предел ожидания (по умолчанию 20).
//
// Возвращаемое значение:
//  Булево - Истина, если возобновление зафиксировано.
//
Функция ЖдатьВозобновлениеЗапуска(Знач RunId, Знач ТаймаутСек = 20)

	ПределМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределМс Цикл
		Если ЗапускВозобновлен(RunId) Тогда
			Возврат Истина;
		КонецЕсли;
		ОбменДаннымиСервер.Пауза(1);
	КонецЦикла;

	Возврат ЗапускВозобновлен(RunId);

КонецФункции

// Возобновился ли запуск: есть активное фоновое задание по RunId или запись
// вышла из пауз возобновления (ПриостановленДляПодтверждения/ПриостановленДляВвода).
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗапускВозобновлен(Знач RunId)

	Если ar_RuntimeЗапуск.ЗаданиеЗапускаАктивно(RunId) Тогда
		Возврат Истина;
	КонецЕсли;

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	Возврат Запуск.Найден
		И Запуск.Статус <> Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения
		И Запуск.Статус <> Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода;

КонецФункции

// Создает запись очереди подтверждений для заданного запуска (статус и
// payload - как их оставляют Принять/ОтветитьНаВопрос ядра; ключ ApprovalId -
// новый UUID).
//
// Параметры:
//  Статус      - Строка - ar_Статус записи ("approved"/"answered");
//  RunId       - Строка - идентификатор запуска;
//  PayloadJSON - Строка - значение ar_ActionPayloadJSON.
//
// Возвращаемое значение:
//  Строка - ApprovalId созданной записи.
//
Функция ЗаписатьПодтверждениеВОчередь(Знач Статус, Знач RunId, Знач PayloadJSON)

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = RunId;
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = PayloadJSON;
	Запись.ar_Статус = Статус;
	Запись.ar_СозданоВ = ТекущаяДатаСеанса();
	Запись.ar_РешеноВ = ТекущаяДатаСеанса();
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Обновляет одно поле записи запуска менеджером записи (экспортного частичного
// обновления поля в ar_AuditЗапуски нет - по образцу ЗапланироватьПовторЗапуска).
//
// Параметры:
//  RunId    - Строка - идентификатор запуска;
//  ИмяПоля  - Строка - имя реквизита регистра ("ar_ПоследнийПульс", "ar_ОжиданиеДо");
//  Значение - Произвольный - новое значение поля.
//
Процедура ОбновитьПолеЗапуска(Знач RunId, Знач ИмяПоля, Знач Значение)

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ИдентификаторЗапуска = RunId;
	МенеджерЗаписи.Прочитать();
	// Прочитать() без найденной записи сбрасывает поля вместе с ключом:
	// запись запуска должна существовать (создана раньше тестом).
	Если Не МенеджерЗаписи.Выбран() Тогда
		ВызватьИсключение СтрШаблон("Запись запуска %1 не найдена", RunId);
	КонецЕсли;
	МенеджерЗаписи[ИмяПоля] = Значение;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Создает запись сессии в ar_Сессии менеджером записи (данные тестов ротации).
//
// Параметры:
//  Агент    - СправочникСсылка.ar_Агенты - агент сессии;
//  Якорь    - Строка - универсальный якорь диалога (уникальный ключ теста);
//  Обновлена - Дата - значения ar_Обновлена и ar_Создана;
//  Активна  - Булево - значение ar_Активна.
//
Процедура ЗаписатьСессиюТеста(Знач Агент, Знач Якорь, Знач Обновлена, Знач Активна)

	Запись = РегистрыСведений.ar_Сессии.СоздатьМенеджерЗаписи();
	Запись.ar_Агент = Агент;
	Запись.ar_Якорь = Якорь;
	Запись.ar_Активна = Активна;
	Запись.ar_Создана = Обновлена;
	Запись.ar_Обновлена = Обновлена;
	Запись.Записать(Истина);

КонецПроцедуры

// Читает запись сессии по паре (Агент, Якорь).
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент сессии;
//  Якорь - Строка - якорь сессии.
//
// Возвращаемое значение:
//  Структура - {Найдена, Активна} (для отсутствующей записи обе Ложь).
//
Функция СессияПоЯкорю(Знач Агент, Знач Якорь)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сессии.ar_Активна КАК Активна
		|ИЗ
		|	РегистрСведений.ar_Сессии КАК Сессии
		|ГДЕ
		|	Сессии.ar_Агент = &Агент
		|	И Сессии.ar_Якорь = &Якорь");
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("Якорь", Якорь);

	Результат = Новый Структура("Найдена, Активна", Ложь, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найдена = Истина;
		Результат.Активна = Выборка.Активна;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Первое событие запуска заданного типа (чтение по ar_ТипСобытия; для событий
// с машиночитаемым кодом в payload есть ОМ_ar_ТестовыеДанные.СобытиеПоКоду).
//
// Параметры:
//  RunId       - Строка - идентификатор запуска;
//  ТипСобытия  - ПеречислениеСсылка.ar_ТипСобытия - искомый тип.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка СобытияЗапуска или Неопределено.
//
Функция СобытиеТипа(Знач RunId, Знач ТипСобытия)

	Строки = ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("ТипСобытия", ТипСобытия));
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строки[0];

КонецФункции

// Есть ли в базе активные mention-рутины с активными агентами (тот же отбор,
// что НайтиАктивныеРутиныMention ядра: тип триггера "mention", оба объекта
// активны и не помечены на удаление).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьАктивныеРутиныУпоминаний()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК ЕстьРутина
		|ИЗ
		|	Справочник.ar_Рутины КАК Рутины
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
		|		ПО Рутины.ar_Агент = Агенты.Ссылка
		|ГДЕ
		|	НЕ Рутины.ПометкаУдаления
		|	И Рутины.ar_Активна
		|	И Рутины.ar_ТипТриггера = ""mention""
		|	И НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_Активен");

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Создает активную mention-рутину агента (ROUT-03): ar_ТипТриггера = "mention".
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент рутины.
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Рутины - созданная рутина.
//
Функция СоздатьРутинуУпоминаний(Знач Агент)

	Рутина = Справочники.ar_Рутины.СоздатьЭлемент();
	Рутина.Наименование = "ТестРутина_" + УникальныйСуффикс();
	Рутина.ar_Агент = Агент;
	Рутина.ar_Активна = Истина;
	Рутина.ar_ТипТриггера = "mention";
	Рутина.ar_ПараметрыJSON = "{}";
	Рутина.ar_ИнструкцияПереопределение = "";
	Рутина.Записать();

	Возврат Рутина.Ссылка;

КонецФункции

// Суммарное число активных запусков (Выполняется, ПриостановленДляСобытия) -
// тот же отбор, что в подсчете rate-limiter (ПодсчитатьАктивныеЗапуски
// БезПривилегий).
//
// Возвращаемое значение:
//  Число.
//
Функция СуммарноАктивныхЗапусков()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ВсегоАктивных
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_Статус В (&СтатусВыполняется, &СтатусПаузаСобытия)");
	Запрос.УстановитьПараметр("СтатусВыполняется", Перечисления.ar_СтатусЗапуска.Выполняется);
	Запрос.УстановитьПараметр("СтатусПаузаСобытия", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.ВсегоАктивных;

КонецФункции

// Уникальный суффикс для имен тестовых данных (УИД без дефисов).
//
// Возвращаемое значение:
//  Строка.
//
Функция УникальныйСуффикс()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");

КонецФункции

