///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Планировщик.
//
// Тесты служебных функций планировщика (ar_Планировщик):
// ТерминальныеСтатусыЗапуска - 7 финальных статусов, приостановленные и
// активные не входят; ИзвлечьТипОбъектаИзСобытия - отрезание суффикса
// обработчика события.
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("СлужебныеФункции")
		.ДобавитьСерверныйТест("ТерминальныеСтатусыЗапускаСостав").Тег("critical")
		.ДобавитьСерверныйТест("ПриостановленныеНеТерминальные").Тег("critical")
		.ДобавитьСерверныйТест("ИзвлечьТипОбъектаИзСобытия").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ТерминальныеСтатусыЗапуска содержит 7 финальных статусов.
Процедура ТерминальныеСтатусыЗапускаСостав() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(Статусы.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Завершён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Отменён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Прерван)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние)).ЭтоИстина();

КонецПроцедуры

// Приостановленные и активные статусы в терминальные не входят.
Процедура ПриостановленныеНеТерминальные() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Создан)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Выполняется)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия)).ЭтоЛожь();

КонецПроцедуры

// ИзвлечьТипОбъектаИзСобытия отрезает суффикс обработчика; без известного
// суффикса строка возвращается как есть.
Процедура ИзвлечьТипОбъектаИзСобытия() Экспорт

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.ТоварыИУслуги.ПриЗаписи")).Равно("Справочник.ТоварыИУслуги")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.ЗаказКлиента.ПередЗаписью")).Равно("Документ.ЗаказКлиента")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.РеализацияТоваровУслуг.ПриПроведении")).Равно("Документ.РеализацияТоваровУслуг")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.Номенклатура")).Равно("Справочник.Номенклатура")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия("")).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что массив ссылок перечисления содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
