///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Планировщик.
//
// Тесты служебных функций планировщика (ar_Планировщик):
// ТерминальныеСтатусыЗапуска - 7 финальных статусов, приостановленные и
// активные не входят; ИзвлечьТипОбъектаИзСобытия - отрезание суффикса
// обработчика события.
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("СлужебныеФункции")
		.ДобавитьСерверныйТест("ТерминальныеСтатусыЗапускаСостав").Тег("critical")
		.ДобавитьСерверныйТест("ПриостановленныеНеТерминальные").Тег("critical")
		.ДобавитьСерверныйТест("ИзвлечьТипОбъектаИзСобытия").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-104 Техповтор")
		.ДобавитьСерверныйТест("ТехповторБезСнимкаНеБесконечен").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-105 ПозднееЗавершение")
		.ДобавитьСерверныйТест("ПозднееЗавершениеНеПерекрываетПрерван").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-14 Компакция")
		.ДобавитьСерверныйТест("КомпакцияУдаляетТерминальныеЗаписи").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-19 СтрокаЗдоровья")
		.ДобавитьСерверныйТест("СтрокаЗдоровьяДавностьЗапуска").Тег("critical")
		.ДобавитьСерверныйТест("ДиагностикаВключаетВсеЗадания").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-107 Самолечение")
		.ДобавитьСерверныйТест("СамолечениеПаузыApproval").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-109-123-124 ПамятьAuto")
		.ДобавитьСерверныйТест("ТикПамятиСтроитProposals").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОшибкиБезТекстаНеСчитаются").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("SentinelRunIdУникаленПоАгентам").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ТерминальныеСтатусыЗапуска содержит 7 финальных статусов.
Процедура ТерминальныеСтатусыЗапускаСостав() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(Статусы.Количество()).Равно(7);
	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Завершён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Отменён)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Прерван)).ЭтоИстина()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние)).ЭтоИстина();

КонецПроцедуры

// Приостановленные и активные статусы в терминальные не входят.
Процедура ПриостановленныеНеТерминальные() Экспорт

	Статусы = ar_Планировщик.ТерминальныеСтатусыЗапуска();

	ЮТест.ОжидаетЧто(МассивСодержит(Статусы,
		Перечисления.ar_СтатусЗапуска.Создан)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.Выполняется)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода)).ЭтоЛожь()
		.Что(МассивСодержит(Статусы, Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия)).ЭтоЛожь();

КонецПроцедуры

// ИзвлечьТипОбъектаИзСобытия отрезает суффикс обработчика; без известного
// суффикса строка возвращается как есть.
Процедура ИзвлечьТипОбъектаИзСобытия() Экспорт

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.ТоварыИУслуги.ПриЗаписи")).Равно("Справочник.ТоварыИУслуги")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.ЗаказКлиента.ПередЗаписью")).Равно("Документ.ЗаказКлиента")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Документ.РеализацияТоваровУслуг.ПриПроведении")).Равно("Документ.РеализацияТоваровУслуг")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия(
			"Справочник.Номенклатура")).Равно("Справочник.Номенклатура")
		.Что(ar_Планировщик.ИзвлечьТипОбъектаИзСобытия("")).Равно("");

КонецПроцедуры

// agentrunner-104 кр. 1: Failed-запуск без снимка с прошедшим ar_ПовторитьПосле
// берется тиком автовозобновления ровно один раз: ПопытокВозобновления +1,
// ar_ПовторитьПосле очищен, событие Ошибка retry_failed (причина -
// snapshot_missing_or_incompatible); повторный тик не бесконечен - запись
// больше не кандидат.
Процедура ТехповторБезСнимкаНеБесконечен() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ДанныеОшибки = Новый Структура;
	ДанныеОшибки.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);
	ДанныеОшибки.Вставить("ОтветLLM", "Технический сбой теста");
	ar_AuditЗапуски.Завершить(RunId, ДанныеОшибки);
	ОМ_ar_ТестовыеДанные.ЗапланироватьПовторЗапуска(RunId, ТекущаяДатаСеанса() - 60);

	ar_Планировщик.ОбработатьАвтовозобновление();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)
		.Свойство("ПопытокВозобновления").Равно(1);

	СобытиеОшибки = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "retry_failed");
	ЮТест.ОжидаетЧто(СобытиеОшибки).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.Ошибка);
	ЮТест.ОжидаетЧто(
		СтрНайти(СобытиеОшибки.PayloadJSON, "snapshot_missing_or_incompatible") > 0).ЭтоИстина();

	ЗаписьПовтораРегистра = ЗаписьПовторитьПосле(RunId);
	ЮТест.ОжидаетЧто(ЗаписьПовтораРегистра = Дата(1, 1, 1)).ЭтоИстина();

	// Повторный тик: ar_ПовторитьПосле пуст - запись больше не кандидат,
	// счетчик попыток не растет (техповтор без снимка не бесконечен).
	ar_Планировщик.ОбработатьАвтовозобновление();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId).ПопытокВозобновления).Равно(1);

КонецПроцедуры

// agentrunner-105 кр. 3: позднее завершение фонового задания не перезаписывает
// финальный статус "Прерван" - статус и дата завершения не меняются, фикс
// события Ошибка late_completion_ignored с желаемым статусом.
Процедура ПозднееЗавершениеНеПерекрываетПрерван() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ar_AuditЗапуски.ПрерватьЗапуск(RunId);

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", "Ответ задания после прерывания");
	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеЗавершения);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван)
		.Свойство("ОтветLLM").Равно("")
		.Свойство("ЗавершенВ").Равно(Дата(1, 1, 1));

	СобытиеПозднего = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "late_completion_ignored");
	ЮТест.ОжидаетЧто(СобытиеПозднего).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.Ошибка);
	ЮТест.ОжидаетЧто(СтрНайти(СобытиеПозднего.PayloadJSON, "Завершён") > 0).ЭтоИстина();

КонецПроцедуры

// agentrunner-14 кр. 1-3: компакция CONS-16 удаляет терминальные записи
// очереди (cancelled) с ar_РешеноВ старше порога ar_КомпакцияAuditДней;
// свежая cancelled и pending (без ar_РешеноВ) любого возраста не удаляются.
Процедура КомпакцияУдаляетТерминальныеЗаписи() Экспорт

	ДнейПорога = ar_Константы.КомпакцияAuditДней();
	Если ДнейПорога <= 0 Тогда
		ДнейПорога = 90;
	КонецЕсли;
	ГраницаСтарая = ТекущаяДатаСеанса() - (ДнейПорога + 1) * 86400;

	// Разрешение компакции - глобальная константа: включается в транзакции
	// теста и откатывается вместе с ней.
	Константы.ar_РазрешитьОчисткуAudit.Установить(Истина);

	ИдСтарая = ЗаписатьОчередьТеста("cancelled", ГраницаСтарая);
	ИдСвежая = ЗаписатьОчередьТеста("cancelled", ТекущаяДатаСеанса());
	ИдОжидающая = ЗаписатьОчередьТеста("pending", ГраницаСтарая);

	ar_Планировщик.ОбработатьКомпакциюAudit();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдСтарая)).Равно("");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдСвежая)).Равно("cancelled");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ИдОжидающая)).Равно("pending");

КонецПроцедуры

// agentrunner-19 кр. 1, 3, 5: представление времени последнего запуска РЗ -
// давность с ЧН=0 ("0 сек назад"), минутная/секундная градация, «сегодня ЧЧ:ММ»
// для разовых в день заданий и «не запускалось», если запусков не было.
Процедура СтрокаЗдоровьяДавностьЗапуска() Экспорт

	ЭлементМинутный = ЭлементРЗ(10, Ложь);
	ЮТест.ОжидаетЧто(ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементМинутный))
		.Равно("10 сек назад");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(0, Ложь)))
		.Равно("0 сек назад");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(600, Ложь)))
		.Равно("10 мин назад");

	ЭлементРазВДень = ЭлементРЗ(-1, Истина);
	ЭлементРазВДень.Вставить("ПоследнийЗапуск",
		НачалоДня(ТекущаяДатаСеанса()) + 3 * 3600);
	ЮТест.ОжидаетЧто(ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРазВДень))
		.Равно("сегодня 03:00");

	ЮТест.ОжидаетЧто(
		ar_Планировщик.ПредставлениеВремениПоследнегоЗапуска(ЭлементРЗ(-1, Ложь)))
		.Равно("не запускалось");

КонецПроцедуры

// agentrunner-19 кр. 8: диагностика планировщика содержит все 10 заданий
// AgentRunner, включая автовозобновление запусков.
Процедура ДиагностикаВключаетВсеЗадания() Экспорт

	Диагностика = ar_Планировщик.ДиагностикаПланировщика();

	ЮТест.ОжидаетЧто(Диагностика.Количество()).Равно(10);
	ЕстьАвтовозобновление = Ложь;
	Для Каждого Элемент Из Диагностика Цикл
		Если Элемент.Имя = "ar_АвтовозобновлениеЗапусков" Тогда
			ЕстьАвтовозобновление = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьАвтовозобновление).ЭтоИстина();

КонецПроцедуры

// agentrunner-107 кр. 8: тик планировщика самолечит паузу approval без
// ожидающих подтверждений - запуск возобновляется (approval_resume) с
// событием АвтоВозобновлён (code = approval_self_healed).
Процедура СамолечениеПаузыApproval() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеПаузы = Новый Структура;
	ДанныеПаузы.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ДанныеПаузы.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunId, ДанныеПаузы);
	ar_AuditЗапуски.СохранитьСнимок(RunId, Новый Структура("ШаговВсего", 1));

	ar_Планировщик.ОбработатьАвтовозобновление();

	СобытиеЛечения = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "approval_self_healed");
	ЮТест.ОжидаетЧто(СобытиеЛечения).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.АвтоВозобновлён);

КонецПроцедуры

// agentrunner-109 кр. 1, 123 кр. 1, 3: тик SCHED-09 по завершённому запуску
// с событиями формирует proposals: fact (3+ успешных вызова инструмента) - в
// очередь подтверждений pending; note (итог запуска) - сразу в память агента
// (ar_Источник = auto, RunId итога); повторный тик не создает дублей.
Процедура ТикПамятиСтроитProposals() Экспорт

	Подготовка = ПодготовитьЗапускСПамятью("Тестовый итог работы", 3, 2);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();
	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	// note - сразу в память (123 кр. 1), без записи очереди и без дублей (кр. 3).
	ЗаписиПамяти = ОМ_ar_ТестовыеДанные.ПамятьАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(ЗаписиПамяти.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ЗаписиПамяти)
		.Свойство("[0].Тип").Равно("note")
		.Свойство("[0].Источник").Равно("auto")
		.Что(СтрНайти(ЗаписиПамяти[0].Текст, "Итог последнего завершённого запуска:") > 0)
			.ЭтоИстина()
		.Свойство("[0].ИдЗапуска").Равно(Подготовка.RunId);

	// fact и rule - в очереди подтверждений, по одному (идемпотентность по ключу).
	Предложения = ЗаписиSched09(Подготовка.Агент);
	ЮТест.ОжидаетЧто(Предложения.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Предложения)
		.Свойство("[0].Статус").Равно("pending");
	ЕстьFact = Ложь;
	ЕстьRule = Ложь;
	Для Каждого СтрокаПредложения Из Предложения Цикл
		Если СтрНайти(СтрокаПредложения.ActionPayloadJSON, """type"": ""fact""") > 0 Тогда
			ЕстьFact = Истина;
		КонецЕсли;
		Если СтрНайти(СтрокаПредложения.ActionPayloadJSON, """type"": ""rule""") > 0 Тогда
			ЕстьRule = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьFact).ЭтоИстина()
		.Что(ЕстьRule).ЭтоИстина();

КонецПроцедуры

// agentrunner-109 кр. 5: неуспешные вызовы инструментов и ошибки без текста
// (нет error/reason) не агрегируются - fact и rule не формируются (note по
// завершённому запуску в очередь не попадает).
Процедура ОшибкиБезТекстаНеСчитаются() Экспорт

	Подготовка = ПодготовитьЗапускСПамятью("Итог без полезных фактов", 0, 0, 2, 3);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	ЮТест.ОжидаетЧто(ЗаписиSched09(Подготовка.Агент).Количество()).Равно(0);

КонецПроцедуры

// agentrunner-124 кр. 1: у двух агентов одного тика уникальные sentinel RunId
// предложений (s09_ + 32 символа, длина 36); в ar_Запуски - по записи на
// каждого агента, записи друг друга не перезаписываются.
Процедура SentinelRunIdУникаленПоАгентам() Экспорт

	ПодготовкаА = ПодготовитьЗапускСПамятью("Итог агента А", 3, 0, 0, 0);
	ПодготовкаБ = ПодготовитьЗапускСПамятью("Итог агента Б", 3, 0, 0, 0);

	ar_Планировщик.ОбработатьОбновлениеПамятиAuto();

	ПредложенияА = ЗаписиSched09(ПодготовкаА.Агент);
	ПредложенияБ = ЗаписиSched09(ПодготовкаБ.Агент);
	ЮТест.ОжидаетЧто(ПредложенияА.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ПредложенияБ.Количество()).Равно(1);

	RunIdА = СокрЛП(Строка(ПредложенияА[0].RunId));
	RunIdБ = СокрЛП(Строка(ПредложенияБ[0].RunId));
	ЮТест.ОжидаетЧто(СтрДлина(RunIdА)).Равно(36)
		.Что(СтрНачинаетсяС(RunIdА, "s09_")).ЭтоИстина()
		.Что(СтрДлина(RunIdБ)).Равно(36)
		.Что(СтрНачинаетсяС(RunIdБ, "s09_")).ЭтоИстина()
		.Что(RunIdА <> RunIdБ).ЭтоИстина();

	ЗапускА = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunIdА);
	ЗапускБ = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunIdБ);
	ЮТест.ОжидаетЧто(ЗапускА).Свойство("Найден").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗапускБ).Свойство("Найден").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что массив ссылок перечисления содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Читает ar_ПовторитьПосле записи запуска (прямым запросом: у ar_AuditЗапуски
// нет экспортного чтения этого поля).
//
Функция ЗаписьПовторитьПосле(Знач RunId)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Запуски.ar_ПовторитьПосле КАК ПовторитьПосле
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId");
	Запрос.УстановитьПараметр("RunId", RunId);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПовторитьПосле;
	КонецЕсли;
	Возврат Дата(1, 1, 1);

КонецФункции

// Создает запись очереди подтверждений с заданным статусом и временем решения
// (прямая запись менеджером - как СостаритьЗаписьОчереди в ОМ_ar_Подтверждение).
//
// Возвращаемое значение:
//  Строка - ApprovalId созданной записи.
//
Функция ЗаписатьОчередьТеста(Знач Статус, Знач РешеноВ)

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = "{}";
	Запись.ar_Статус = Статус;
	Запись.ar_СозданоВ = РешеноВ;
	Запись.ar_РешеноВ = РешеноВ;
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Структура элемента диагностики РЗ (состав - как ar_Планировщик.ЭлементДиагностики).
//
Функция ЭлементРЗ(Знач СекундНазад, Знач РазВДень)

	Элемент = Новый Структура;
	Элемент.Вставить("Имя", "тест_задание");
	Элемент.Вставить("Синоним", "Тестовое задание");
	Элемент.Вставить("ПоследнийЗапуск", '00010101');
	Элемент.Вставить("СекундНазад", СекундНазад);
	Элемент.Вставить("Статус", "ok");
	Элемент.Вставить("РазВДень", РазВДень);
	Возврат Элемент;

КонецФункции

// Завершенный запуск агента с событиями для агрегации SCHED-09: итог (content),
// успешные вызовы инструмента, ошибки с причиной и без нее, неуспешные вызовы.
//
// Параметры:
//  ИтогТекст          - Строка - content события Завершён (и ОтветLLM записи);
//  УспешныхВызовов    - Число  - ВызванИнструмент success=true, один tool;
//  ОшибокСПричиной    - Число  - Ошибка с reason;
//  ОшибокБезПричины   - Число  - Ошибка без reason (в агрегацию не попадают);
//  НеуспешныхВызовов  - Число  - ВызванИнструмент success=false (не считаются).
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовитьЗапускСПамятью(Знач ИтогТекст, Знач УспешныхВызовов, Знач ОшибокСПричиной,
	Знач ОшибокБезПричины, Знач НеуспешныхВызовов)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", ИтогТекст);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	PayloadИтога = Новый Структура;
	PayloadИтога.Вставить("code", "run_completed");
	PayloadИтога.Вставить("content", ИтогТекст);
	ar_AuditСобытия.Зафиксировать(RunId, "Завершён", PayloadИтога);

	Сч = 0;
	Пока Сч < УспешныхВызовов Цикл
		Сч = Сч + 1;
		PayloadВызова = Новый Структура;
		PayloadВызова.Вставить("code", "tool_called");
		PayloadВызова.Вставить("tool", "тест_частый_тул");
		PayloadВызова.Вставить("success", Истина);
		ar_AuditСобытия.Зафиксировать(RunId, "ВызванИнструмент", PayloadВызова);
	КонецЦикла;

	Сч = 0;
	Пока Сч < ОшибокСПричиной Цикл
		Сч = Сч + 1;
		PayloadОшибки = Новый Структура;
		PayloadОшибки.Вставить("code", "run_failed");
		PayloadОшибки.Вставить("reason", "Падение соединения теста");
		ar_AuditСобытия.Зафиксировать(RunId, "Ошибка", PayloadОшибки);
	КонецЦикла;

	Сч = 0;
	Пока Сч < ОшибокБезПричины Цикл
		Сч = Сч + 1;
		PayloadПустой = Новый Структура;
		PayloadПустой.Вставить("code", "run_failed");
		ar_AuditСобытия.Зафиксировать(RunId, "Ошибка", PayloadПустой);
	КонецЦикла;

	Сч = 0;
	Пока Сч < НеуспешныхВызовов Цикл
		Сч = Сч + 1;
		PayloadНеудачи = Новый Структура;
		PayloadНеудачи.Вставить("code", "tool_called");
		PayloadНеудачи.Вставить("tool", "тест_ошибочный_тул");
		PayloadНеудачи.Вставить("success", Ложь);
		ar_AuditСобытия.Зафиксировать(RunId, "ВызванИнструмент", PayloadНеудачи);
	КонецЦикла;

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

// Записи очереди подтверждений SCHED-09 (предложения памяти) по агенту:
// IdempotencyKey предложений начинается с "sched09_<представление агента>_".
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ApprovalId, Статус, RunId, IdempotencyKey,
//  ActionPayloadJSON.
//
Функция ЗаписиSched09(Знач Агент)

	ИмяАгента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "Наименование");
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Очередь.ar_ApprovalId КАК ApprovalId,
		|	Очередь.ar_Статус КАК Статус,
		|	Очередь.ar_RunId КАК RunId,
		|	Очередь.ar_IdempotencyKey КАК IdempotencyKey,
		|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_IdempotencyKey ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_СозданоВ");
	// Служебные символы имени (% _ [ ] ^) экранируются, хвост "%" оставлен wildcard'ом.
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе("sched09_" + СокрЛП(ИмяАгента)) + "%");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
