	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-105 ПозднееЗавершение")
		.ДобавитьСерверныйТест("ПозднееЗавершениеНеПерекрываетПрерван").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-14 Компакция")
		.ДобавитьСерверныйТест("КомпакцияУдаляетТерминальныеЗаписи").Тег("critical").ВТранзакции();

	ЮТТесты
