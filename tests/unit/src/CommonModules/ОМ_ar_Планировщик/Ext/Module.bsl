		.ДобавитьСерверныйТест("ПамятьПоАгентамНеСмешивается").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 ОпросПодписок")
		.ДобавитьСерверныйТест("ОпросСначалаРазбираетОчередь").Тег("critical").ВТранзакции()
