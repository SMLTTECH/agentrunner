// ИНН юрлица тестовых данных: «99» и 8 случайных цифр (контрольные разряды
// обработка не проверяет).
//
// Возвращаемое значение:
//  Строка - 10 цифр.
//
Функция ИННЮрлица()

	Возврат "99" + СлучайныеЦифры(8);

КонецФункции

// ИНН физлица тестовых данных: «99» и 10 случайных цифр.
//
// Возвращаемое значение:
//  Строка - 12 цифр.
//
Функция ИННФизлица()

	Возврат "99" + СлучайныеЦифры(10);

