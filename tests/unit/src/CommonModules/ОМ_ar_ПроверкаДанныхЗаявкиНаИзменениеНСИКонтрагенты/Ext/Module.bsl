	МодельИП.Реквизиты.Вставить("ИндивидуальныйПредприниматель", Истина);
	ДобавитьСчет(МодельИП, Свойства, "40702810" + СлучайныеЦифры(12));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, СоздатьЗаявку(ВидОперацииСоздание(), МодельИП))),
			"счёт ИП не с 40802")
		.НеСодержит("БанковскийСчетДопРеквизиты");

	МодельЮЛ = МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "Тест");
	ДобавитьСчет(МодельЮЛ, Свойства, "40702 810" + СлучайныеЦифры(10));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, СоздатьЗаявку(ВидОперацииСоздание(), МодельЮЛ))))
		.Содержит("БанковскийСчетДопРеквизиты");

	ВерныйИП = МодельФизлица(ИННФизлица(), "Тестов Тест Тестович");
	ВерныйИП.Реквизиты.Вставить("ИндивидуальныйПредприниматель", Истина);
	ДобавитьСчет(ВерныйИП, Свойства, "40802 810" + СлучайныеЦифры(12));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, СоздатьЗаявку(ВидОперацииСоздание(), ВерныйИП))))
		.НеСодержит("БанковскийСчетДопРеквизиты");

	// Правило 20 цифр резидента у ИП осталось - единственное правило счёта ИП / ФЛ.
	КороткийИП = МодельФизлица(ИННФизлица(), "Тестов Тест Тестович");
	КороткийИП.Реквизиты.Вставить("ИндивидуальныйПредприниматель", Истина);
	ДобавитьСчет(КороткийИП, Свойства, "40802 810" + СлучайныеЦифры(10));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, СоздатьЗаявку(ВидОперацииСоздание(), КороткийИП))),
			"счёт ИП из 18 цифр")
		.Содержит("БанковскийСчетДопРеквизиты");

	МодельФЛ = МодельФизлица(ИННФизлица(), "Тестов Тест Тестович");
	ДобавитьСчет(МодельФЛ, Свойства, "40702810" + СлучайныеЦифры(12));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, СоздатьЗаявку(ВидОперацииСоздание(), МодельФЛ))),
			"счёт физлица не с 40817")
		.НеСодержит("БанковскийСчетДопРеквизиты");

КонецПроцедуры

#КонецОбласти

#Область Печать

// Печать БСП: протокол и результат по заявке с ошибкой ИНН заполняют табличные
// документы и синонимы макетов; в результате - «Не пройдены проверки».
Процедура ПечатьПротоколаИРезультата() Экспорт

	Обработка = ОбъектОбработки();
	Заявки = Новый Массив;
	Заявки.Добавить(СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННФизлица(), КППЮрлица("01"), "Тест")));

	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("Протокол,Результат");
	Обработка.Печать(Заявки, КоллекцияПечатныхФорм, Новый СписокЗначений, Новый Структура);

	Протокол = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Протокол");
	Результат = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Результат");

	ЮТест.ОжидаетЧто(Протокол.СинонимМакета, "синоним протокола").Равно("Проверка данных (протокол)")
		.Что(ТекстТабличногоДокумента(Протокол.ТабличныйДокумент), "текст протокола")
			.Содержит("Итого:")
			.Содержит("ИНН заполнен и соответствует виду лица - не пройдена")
		.Что(Результат.СинонимМакета, "синоним результата").Равно("Проверка данных (результат)")
		.Что(ТекстТабличногоДокумента(Результат.ТабличныйДокумент), "текст результата")
			.Содержит("Не пройдены проверки");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработкаИРезультат

// Объект зарегистрированной обработки; без регистрации или при ошибке
// подключения тест пропускается с сообщением (не красный). ЮТест.Пропустить
// прерывает тест исключением - код после вызова не выполняется.
//
// Возвращаемое значение:
//  ВнешняяОбработкаОбъект - объект обработки с экспортными методами.
//
Функция ОбъектОбработки()

	СсылкаОбработки = СсылкаРегистрацииОбработки();

	Попытка
		Объект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(СсылкаОбработки);
	Исключение
		ЮТест.Пропустить("Не удалось подключить обработку " + ИмяОбработки() + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Объект = Неопределено Тогда
		ЮТест.Пропустить("ОбъектВнешнейОбработки вернул Неопределено для обработки " + ИмяОбработки());
	КонецЕсли;

	Возврат Объект;

КонецФункции

// Элемент справочника ДополнительныеОтчетыИОбработки с обработкой; не найден -
// тест пропускается.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - регистрация обработки.
//
Функция СсылкаРегистрацииОбработки()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбработки());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЮТест.Пропустить("Обработка " + ИмяОбработки()
			+ " не зарегистрирована в справочнике ДополнительныеОтчетыИОбработки");
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Имя объекта обработки.
//
// Возвращаемое значение:
//  Строка - ИмяОбъекта в ДополнительныеОтчетыИОбработки.
//
Функция ИмяОбработки()

	Возврат "ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты";

КонецФункции

// Результат проверки одной заявки, прочитанный из JSON.
//
// Параметры:
//  Обработка - ВнешняяОбработкаОбъект - см. ОбъектОбработки().
//  Заявка    - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
// Возвращаемое значение:
//  Соответствие - объект JSON (ключи - см. ДанныеРезультатаДляМодели обработки).
//
Функция ДанныеРезультата(Знач Обработка, Знач Заявка)

	Возврат ПрочитанныйJSON(Обработка.РезультатПроверкиДляМодели(Заявка));

КонецФункции

// Значение JSON-текста: объекты - Соответствие.
//
// Параметры:
//  ТекстJSON - Строка.
//
// Возвращаемое значение:
//  Соответствие, Массив.
//
Функция ПрочитанныйJSON(Знач ТекстJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Коды замечаний результата (remarks[].code).
//
// Параметры:
//  Данные - Соответствие - см. ДанныеРезультата().
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция КодыЗамечаний(Знач Данные)

	Коды = Новый Массив;
	Для Каждого Замечание Из Данные.Получить("remarks") Цикл
		Коды.Добавить(Замечание.Получить("code"));
	КонецЦикла;
	Возврат Коды;

КонецФункции

// Замечание результата по коду.
//
// Параметры:
//  Данные - Соответствие - см. ДанныеРезультата().
//  Код    - Строка - код проверки.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - замечание не найдено.
//
Функция ЗамечаниеПоКоду(Знач Данные, Знач Код)

	Для Каждого Замечание Из Данные.Получить("remarks") Цикл
		Если Замечание.Получить("code") = Код Тогда
			Возврат Замечание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Текст табличного документа отчёта: обработка выводит строки в первую колонку.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент.
//
// Возвращаемое значение:
//  Строка - строки документа через перевод строки.
//
Функция ТекстТабличногоДокумента(Знач ТабличныйДокумент)

	Строки = Новый Массив;
	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		Строки.Добавить(ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ДанныеЗаявки

// Заявка НСИ с моделями «стало» и «было», записанная в транзакции теста; не
// записалась - тест пропускается.
//
// Параметры:
//  ВидОперации    - ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение.
//  МодельСтало    - Структура, Неопределено - модель «стало» (Неопределено - без модели).
//  МодельБыло     - Структура, Неопределено - модель «было».
//  Предмет        - СправочникСсылка.Контрагенты, Неопределено - предмет заявки; для
//                   изменения по умолчанию - пустая ссылка Контрагентов.
//  ПоКонтрагентам - Булево - заполнить описание объекта обмена «Контрагенты».
//
// Возвращаемое значение:
//  ДокументСсылка.бит_мдм_ЗаявкаНаИзменение.
//
Функция СоздатьЗаявку(Знач ВидОперации, Знач МодельСтало, Знач МодельБыло = Неопределено,
	Знач Предмет = Неопределено, Знач ПоКонтрагентам = Истина)

	Если Предмет = Неопределено И ВидОперации = ВидОперацииИзменение() Тогда
		Предмет = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	ОписаниеОбъекта = Неопределено;
	Если ПоКонтрагентам Тогда
		ОписаниеОбъекта = ОписаниеОбъектаКонтрагенты();
	КонецЕсли;

	Попытка
		Заявка = Документы.бит_мдм_ЗаявкаНаИзменение.СоздатьДокумент();
		Заявка.Дата = ТекущаяДатаСеанса();
		Заявка.ВидОперации = ВидОперации;
		Заявка.ОписаниеОбъекта = ОписаниеОбъекта;
		Заявка.Предмет = Предмет;
		Заявка.Ответственный = Пользователи.ТекущийПользователь();
		Заявка.Комментарий = "Тест ОМ_ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты";
		Если МодельСтало <> Неопределено Тогда
			Заявка.ЗаписатьМодельОбъекта(МодельСтало);
		КонецЕсли;
		Если МодельБыло <> Неопределено Тогда
			Заявка.ЗаписатьМодельОбъектаПред(МодельБыло);
		КонецЕсли;
		Заявка.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ЮТест.Пропустить("Не удалось создать заявку НСИ: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Заявка.Ссылка;

КонецФункции

// Карточка контрагента для поиска дублей, записанная в транзакции теста без
// обработчиков (ОбменДанными.Загрузка); не записалась - тест пропускается.
//
// Параметры:
//  Наименование - Строка.
//  ИНН          - Строка.
//  КПП          - Строка.
//  ЮрФизЛицо    - ПеречислениеСсылка.ЮридическоеФизическоеЛицо.
//  Серия        - Строка - серия документа физлица.
//  Номер        - Строка - номер документа физлица.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты.
//
Функция СоздатьКонтрагента(Знач Наименование, Знач ИНН, Знач КПП, Знач ЮрФизЛицо,
	Знач Серия = "", Знач Номер = "")

	Попытка
		Карточка = Справочники.Контрагенты.СоздатьЭлемент();
		Карточка.Наименование = Наименование;
		Карточка.НаименованиеПолное = Наименование;
		Карточка.ИНН = ИНН;
		Карточка.КПП = КПП;
		Карточка.ЮридическоеФизическоеЛицо = ЮрФизЛицо;
		Карточка.sd_ДокументСерия = Серия;
		Карточка.sd_ДокументНомер = Номер;
		Карточка.ОбменДанными.Загрузка = Истина;
		Карточка.Записать();
	Исключение
		ЮТест.Пропустить("Не удалось создать контрагента для проверки дублей: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Карточка.Ссылка;

КонецФункции

// Описание объекта обмена «Контрагенты» текущей базы (как у СТ_НСИОбщий); не
// найдено - тест пропускается.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_мдм_ОписанияОбъектовОбмена - описание.
//
Функция ОписаниеОбъектаКонтрагенты()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Описания.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ОписанияОбъектовОбмена КАК Описания
		|ГДЕ
		|	Описания.Наименование = ""Контрагенты""
		|	И Описания.Владелец = ЗНАЧЕНИЕ(Справочник.бит_мпд_ВидыИнформационныхБаз.ТекущаяИнформационнаяБаза)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЮТест.Пропустить("Описание объекта обмена «Контрагенты» текущей базы не найдено");
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Свойства дополнительных реквизитов банковского счёта (БИКБанка,
// НомерОсновногоБанковскогоСчета); не найдены - тест пропускается.
//
// Возвращаемое значение:
//  Структура:
//   * БИКБанка   - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//   * НомерСчета - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//
Функция СвойстваСчета()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", СтрРазделить("БИКБанка,НомерОсновногоБанковскогоСчета", ","));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Свойства.Ссылка КАК Ссылка,
		|	Свойства.Имя КАК Имя
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ГДЕ
		|	Свойства.Имя В (&Имена)
		|	И НЕ Свойства.ПометкаУдаления";

	Свойства = Новый Структура("БИКБанка, НомерСчета");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Имя = "БИКБанка" Тогда
			Свойства.БИКБанка = Выборка.Ссылка;
		Иначе
			Свойства.НомерСчета = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Свойства.БИКБанка) Или НЕ ЗначениеЗаполнено(Свойства.НомерСчета) Тогда
		ЮТест.Пропустить("Дополнительные реквизиты БИКБанка и НомерОсновногоБанковскогоСчета не найдены");
	КонецЕсли;

	Возврат Свойства;

КонецФункции

// Вид операции «Ввод нового».
//
// Возвращаемое значение:
//  ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение.
//
Функция ВидОперацииСоздание()

	Возврат Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового;

КонецФункции

// Вид операции «Изменение».
//
// Возвращаемое значение:
//  ПеречислениеСсылка.бит_мдм_ВидыОперацийЗаявкаНаИзменение.
//
