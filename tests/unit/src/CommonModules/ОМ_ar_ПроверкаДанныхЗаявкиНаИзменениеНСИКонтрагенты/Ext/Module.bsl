#Область МоделиЗаявки

// Пустая модель заявки: группы Реквизиты, СтандартныеРеквизиты, ТабличныеЧасти.
//
// Параметры:
//  ЮрФизЛицо - ПеречислениеСсылка.ЮридическоеФизическоеЛицо, Неопределено - не заполнять.
//
// Возвращаемое значение:
//  Структура.
//
Функция НоваяМодель(Знач ЮрФизЛицо)

	Модель = Новый Структура;
	Модель.Вставить("Реквизиты", Новый Структура);
	Модель.Вставить("СтандартныеРеквизиты", Новый Структура);
	Модель.Вставить("ТабличныеЧасти", Новый Структура);
	Если ЮрФизЛицо <> Неопределено Тогда
		Модель.Реквизиты.Вставить("ЮридическоеФизическоеЛицо", ЮрФизЛицо);
	КонецЕсли;
	Возврат Модель;

КонецФункции

// Модель юрлица-резидента, зарегистрированного в России.
//
// Параметры:
//  ИНН          - Строка.
//  КПП          - Строка.
//  Наименование - Строка.
//
// Возвращаемое значение:
//  Структура - см. НоваяМодель().
//
Функция МодельЮрлица(Знач ИНН, Знач КПП, Знач Наименование)

	Модель = НоваяМодель(ЮридическоеЛицо());
	Модель.СтандартныеРеквизиты.Вставить("Наименование", Наименование);
	Модель.Реквизиты.Вставить("НаименованиеПолное", Наименование);
	Модель.Реквизиты.Вставить("ИНН", ИНН);
	Модель.Реквизиты.Вставить("КПП", КПП);
	Модель.Реквизиты.Вставить("sd_Нерезидент", Ложь);
	Модель.Реквизиты.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
	Возврат Модель;

КонецФункции

