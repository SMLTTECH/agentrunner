КонецФункции

// Строка случайных цифр из уникальных идентификаторов: шестнадцатеричный знак -
// цифра его значения по модулю 10. Генератор случайных чисел не используется:
// два генератора, созданные подряд, могут дать одну последовательность.
//
// Параметры:
//  Длина - Число - число цифр.
//
// Возвращаемое значение:
//  Строка.
//
Функция СлучайныеЦифры(Знач Длина)

	ЗнакиИдентификатора = "0123456789abcdef";
	ЧислоЦифр = 10;
	Цифры = "";
	Пока СтрДлина(Цифры) < Длина Цикл
		Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		Для Позиция = 1 По СтрДлина(Идентификатор) Цикл
			Значение = СтрНайти(ЗнакиИдентификатора, Сред(Идентификатор, Позиция, 1)) - 1;
			Цифры = Цифры + Формат(Значение % ЧислоЦифр, "ЧН=0; ЧГ=0");
		КонецЦикла;
	КонецЦикла;
	Возврат Лев(Цифры, Длина);

КонецФункции

