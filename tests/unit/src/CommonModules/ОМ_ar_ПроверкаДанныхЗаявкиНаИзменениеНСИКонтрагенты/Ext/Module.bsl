// Модель юрлица с признаком ВГО и одним адресом электронной почты.
//
// Параметры:
//  ИНН          - Строка.
//  КПП          - Строка.
//  Наименование - Строка - полное наименование.
//  Адрес        - Строка - адрес электронной почты.
//
// Возвращаемое значение:
//  Структура - см. НоваяМодель().
//
Функция МодельВГО(Знач ИНН, Знач КПП, Знач Наименование, Знач Адрес)

	Модель = МодельЮрлица(ИНН, КПП, "ООО Тест ВГО");
	Модель.Реквизиты.Вставить("НаименованиеПолное", Наименование);
	Модель.Реквизиты.Вставить("sd_ВГО", Истина);
	ДобавитьАдресЭлектроннойПочты(Модель, Адрес);
	Возврат Модель;

КонецФункции

// Добавляет в табличную часть КонтактнаяИнформация модели адрес электронной почты.
//
// Параметры:
//  Модель - Структура - см. НоваяМодель() (изменяется).
//  Адрес  - Строка.
//
Процедура ДобавитьАдресЭлектроннойПочты(Модель, Знач Адрес)

	Строки = Неопределено;
	Если НЕ Модель.ТабличныеЧасти.Свойство("КонтактнаяИнформация", Строки) Тогда
		Строки = Новый Массив;
		Модель.ТабличныеЧасти.Вставить("КонтактнаяИнформация", Строки);
	КонецЕсли;

	СтрокаКИ = Новый Структура;
	СтрокаКИ.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	СтрокаКИ.Вставить("АдресЭП", Адрес);
	СтрокаКИ.Вставить("Представление", Адрес);
	Строки.Добавить(СтрокаКИ);

КонецПроцедуры

// Заполняет в модели паспорт РФ: вид документа, серию, номер и код подразделения.
//
// Параметры:
//  Модель           - Структура - см. НоваяМодель() (изменяется).
//  Серия            - Строка.
//  Номер            - Строка.
//  КодПодразделения - Строка.
//
Процедура ЗаполнитьПаспорт(Модель, Знач Серия, Знач Номер, Знач КодПодразделения)

	Модель.Реквизиты.Вставить("sd_ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ);
	Модель.Реквизиты.Вставить("sd_ДокументСерия", Серия);
	Модель.Реквизиты.Вставить("sd_ДокументНомер", Номер);
	Модель.Реквизиты.Вставить("sd_ДокументКодПодразделения", КодПодразделения);

КонецПроцедуры

// Добавляет в табличную часть ДополнительныеРеквизиты модели БИК и номер счёта.
//
// Параметры:
//  Модель     - Структура - см. НоваяМодель() (изменяется).
//  Свойства   - Структура - см. СвойстваСчета().
//  НомерСчета - Строка.
//
Процедура ДобавитьСчет(Модель, Знач Свойства, Знач НомерСчета)

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Свойство, Значение, ТекстоваяСтрока",
		Свойства.БИКБанка, "044525225", ""));
	Строки.Добавить(Новый Структура("Свойство, Значение, ТекстоваяСтрока",
		Свойства.НомерСчета, НомерСчета, ""));
	Модель.ТабличныеЧасти.Вставить("ДополнительныеРеквизиты", Строки);

КонецПроцедуры

