///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты.
//
// Тесты внешней печатной формы ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты
// («Проверка данных заявки на изменение НСИ (контрагенты)») через её контракт -
// экспортные методы модуля объекта: СведенияОВнешнейОбработке,
// РезультатПроверкиДляМодели (JSON для языковой модели) и Печать (команды
// «Протокол» и «Результат»). Служебные функции обработки неэкспортны и
// проверяются через замечания JSON (remarks[].code).
//
// Наборы:
//  - Регистрация: печатная форма БСП, безопасный режим, назначение - заявка
//    бит_мдм_ЗаявкаНаИзменение, три команды печати MXL;
//  - РезультатДляМодели: заявка не по «Контрагентам», заявка без модели, одна
//    заявка - объект JSON, несколько - массив, корректное юрлицо без замечаний,
//    незаполненные юр/физ лицо и юрисдикция;
//  - ПроверкиЮрлица: ИНН и КПП по формату, знаки 5-6 КПП и вид, дубль по ИНН + КПП +
//    наименованию, вторая карточка юрлица с КПП «01» / «50», адрес электронной почты;
//  - ПроверкиИзменения: ИНН не меняется, ИП не меняет вид, признаки ЖКХ и ЗУП не
//    снимаются, у ВГО меняются только контакты, КПП крупнейшего налогоплательщика;
//  - ПроверкиФизлица: паспорт РФ, документ карточки другого лица, дубль физлица по
//    документу, ИНН ИП обязателен, ИНН физлица - нет;
//  - БанковскийСчет: счёт резидента РФ - 20 цифр, начальные цифры счёта ИП и ФЛ не
//    проверяются (дополнительные реквизиты);
//  - Печать: протокол и результат заполняют табличные документы.
//
// Заявки (и контрагенты для поиска дублей) создаются в транзакции теста и
// откатываются. ИНН и КПП тестовых данных начинаются с «99» и содержат случайные
// цифры - с карточками базы не пересекаются. Модели заявки собираются вручную
// (группы Реквизиты, СтандартныеРеквизиты, ТабличныеЧасти) - обработка читает
// только нужные ключи.
//
// Обработка берётся зарегистрированной: Справочник.ДополнительныеОтчетыИОбработки
// (ИмяОбъекта = "ar_ПроверкаДанныхЗаявкиНаИзменениеНСИКонтрагенты") ->
// ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки. Обработка не
// зарегистрирована или не подключилась - тест пропускается с сообщением.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Регистрация")
		.ДобавитьСерверныйТест("СведенияРегистрацииПечатнаяФормаТриКоманды").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("РезультатДляМодели")
		.ДобавитьСерверныйТест("ЗаявкаНеПоКонтрагентамНеПроверяется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗаявкаБезМоделиПроверкиНеПрименимы").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОднаЗаявкаОбъектНесколькоМассив").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КорректноеЮрлицоБезЗамечаний").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НеЗаполненыЮрФизЛицоИЮрисдикция").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ПроверкиЮрлица")
		.ДобавитьСерверныйТест("ИННЮрлицаНеДесятьЗнаков").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КППЮрлицаНеДевятьЦифр").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КППИВидКонтрагентаНеСовпадают").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ДубльПоИННКППНаименованию").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВтораяКарточкаЮрлицаКПП01И50").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("АдресЭлектроннойПочтыНеверный").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ПроверкиИзменения")
		.ДобавитьСерверныйТест("ИННМеняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИПМеняетВид").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПризнакиЖКХИЗУПСнимаются").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВГОМеняютсяТолькоКонтакты").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КППКрупнейшегоНалогоплательщикаНаОбычный").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ПроверкиФизлица")
		.ДобавитьСерверныйТест("ПаспортРФНеверныйФормат").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ДокументКарточкиДругогоЛица").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ДубльФизлицаПоДокументу").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИННОбязателенИПНоНеФизлицу").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("БанковскийСчет")
		.ДобавитьСерверныйТест("СчетИПИСчетРезидентаПоПравилам").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Печать")
		.ДобавитьСерверныйТест("ПечатьПротоколаИРезультата").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Регистрация

// Регистрация БСП: печатная форма, безопасный режим, назначение - заявка НСИ,
// команды Протокол / Результат / РезультатДляМодели с модификатором ПечатьMXL.
Процедура СведенияРегистрацииПечатнаяФормаТриКоманды() Экспорт

	Обработка = ОбъектОбработки();
	Сведения = Обработка.СведенияОВнешнейОбработке();

	ЮТест.ОжидаетЧто(Сведения.Вид)
		.Равно(ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма())
		.Что(Сведения.БезопасныйРежим, "БезопасныйРежим").ЭтоИстина()
		.Что(Сведения.Версия, "Версия").Заполнено()
		.Что(Сведения.Назначение, "Назначение").Содержит("Документ.бит_мдм_ЗаявкаНаИзменение")
		.Что(Сведения.Команды.Количество(), "Количество команд").Равно(3);

	Для Каждого Идентификатор Из СтрРазделить("Протокол,Результат,РезультатДляМодели", ",") Цикл
		Команда = Сведения.Команды.Найти(Идентификатор, "Идентификатор");
		ЮТест.ОжидаетЧто(Команда <> Неопределено, "команда " + Идентификатор).ЭтоИстина();
		ЮТест.ОжидаетЧто(Команда.Модификатор, "Модификатор " + Идентификатор).Равно("ПечатьMXL")
			.Что(Команда.Представление, "Представление " + Идентификатор).Заполнено();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РезультатДляМодели

// Заявка без объекта обмена «Контрагенты» - checked = false, причина, без замечаний.
Процедура ЗаявкаНеПоКонтрагентамНеПроверяется() Экспорт

	Обработка = ОбъектОбработки();
	Заявка = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "Тест"),
		Неопределено, Неопределено, Ложь);

	Данные = ДанныеРезультата(Обработка, Заявка);

	ЮТест.ОжидаетЧто(Данные.Получить("checked"), "checked").ЭтоЛожь()
		.Что(Данные.Получить("all_checks_passed"), "all_checks_passed").ЭтоНеопределено()
		.Что(Данные.Получить("reason"), "reason").Содержит("объект обмена не указан")
		.Что(Данные.Получить("remarks"), "remarks").ИмеетДлину(0)
		.Что(Данные.Получить("remarks_text"), "remarks_text").Равно("")
		.Что(Данные.Получить("ref"), "ref").Заполнено();

КонецПроцедуры

// Заявка по «Контрагентам» без модели - все проверки «не применима», это не ошибка.
Процедура ЗаявкаБезМоделиПроверкиНеПрименимы() Экспорт

	Обработка = ОбъектОбработки();
	Заявка = СоздатьЗаявку(ВидОперацииСоздание(), Неопределено);

	Данные = ДанныеРезультата(Обработка, Заявка);
	Сводка = Данные.Получить("summary");

	ЮТест.ОжидаетЧто(Данные.Получить("checked"), "checked").ЭтоИстина()
		.Что(Данные.Получить("all_checks_passed"), "all_checks_passed").ЭтоИстина()
		.Что(Сводка.Получить("passed"), "passed").Равно(0)
		.Что(Сводка.Получить("failed"), "failed").Равно(0)
		.Что(Сводка.Получить("errors"), "errors").Равно(0)
		.Что(Сводка.Получить("not_applicable"), "not_applicable").Больше(0)
		.Что(Данные.Получить("remarks"), "remarks").ИмеетДлину(0);

КонецПроцедуры

// Одна заявка (ссылка или массив из одной) - объект JSON, две - массив из двух объектов.
Процедура ОднаЗаявкаОбъектНесколькоМассив() Экспорт

	Обработка = ОбъектОбработки();
	Первая = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "Тест один"));
	Вторая = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "Тест два"));

	ПоСсылке = ПрочитанныйJSON(Обработка.РезультатПроверкиДляМодели(Первая));
	ЮТест.ОжидаетЧто(ПоСсылке).ИмеетТип("Соответствие")
		.Что(ПоСсылке.Получить("checked"), "checked").ЭтоИстина();

	ОдинЭлемент = Новый Массив;
	ОдинЭлемент.Добавить(Первая);
	ЮТест.ОжидаетЧто(ПрочитанныйJSON(Обработка.РезультатПроверкиДляМодели(ОдинЭлемент)))
		.ИмеетТип("Соответствие");

	Заявки = Новый Массив;
	Заявки.Добавить(Первая);
	Заявки.Добавить(Вторая);
	Результат = ПрочитанныйJSON(Обработка.РезультатПроверкиДляМодели(Заявки));
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Массив").ИмеетДлину(2)
		.Что(Результат[0].Получить("request"), "request первой").Равно(Строка(Первая))
		.Что(Результат[1].Получить("request"), "request второй").Равно(Строка(Вторая));

КонецПроцедуры

// Корректное юрлицо-резидент на создание: вид, юрисдикция, операция, проверки без замечаний.
Процедура КорректноеЮрлицоБезЗамечаний() Экспорт

	Обработка = ОбъектОбработки();
	Модель = МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "ООО Тест корректный");
	ДобавитьАдресЭлектроннойПочты(Модель, "info@example.ru");
	Заявка = СоздатьЗаявку(ВидОперацииСоздание(), Модель);

	Данные = ДанныеРезультата(Обработка, Заявка);
	Контрагент = Данные.Получить("counterparty");
	Сводка = Данные.Получить("summary");

	ЮТест.ОжидаетЧто(Данные.Получить("checked"), "checked").ЭтоИстина()
		.Что(Данные.Получить("all_checks_passed"), "all_checks_passed").ЭтоИстина()
		.Что(Контрагент.Получить("kind"), "kind").Равно("юридическое лицо")
		.Что(Контрагент.Получить("jurisdiction"), "jurisdiction").Равно("резидент РФ")
		.Что(Контрагент.Получить("operation"), "operation").Равно("создание")
		.Что(Сводка.Получить("passed"), "passed").Больше(0)
		.Что(Сводка.Получить("failed"), "failed").Равно(0)
		.Что(Сводка.Получить("errors"), "errors").Равно(0)
		.Что(Данные.Получить("remarks"), "remarks").ИмеетДлину(0)
		.Что(Данные.Получить("remarks_text"), "remarks_text").Равно("");

КонецПроцедуры

// Юр/физ лицо и юрисдикция в модели не заполнены - замечание, а не молчаливое «не применима».
Процедура НеЗаполненыЮрФизЛицоИЮрисдикция() Экспорт

	Обработка = ОбъектОбработки();
	Модель = НоваяМодель(Неопределено);
	Модель.Реквизиты.Вставить("ИНН", ИННЮрлица());
	Заявка = СоздатьЗаявку(ВидОперацииСоздание(), Модель);

	Данные = ДанныеРезультата(Обработка, Заявка);
	Контрагент = Данные.Получить("counterparty");

	ЮТест.ОжидаетЧто(Данные.Получить("all_checks_passed"), "all_checks_passed").ЭтоЛожь()
		.Что(Контрагент.Получить("kind"), "kind").Равно("вид не определен")
		.Что(Контрагент.Получить("jurisdiction"), "jurisdiction").Равно("не определена")
		.Что(КодыЗамечаний(Данные), "коды замечаний").Содержит("ЗаполненыРеквизитыУсловийПроверок")
		.Что(Данные.Получить("remarks_text"), "remarks_text").Содержит("1. ");

КонецПроцедуры

#КонецОбласти

#Область ПроверкиЮрлица

// ИНН юрлица из 12 знаков и пустой ИНН юрлица-резидента - замечание ИННПоВидуЛица.
Процедура ИННЮрлицаНеДесятьЗнаков() Экспорт

	Обработка = ОбъектОбработки();

	Длинный = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННФизлица(), КППЮрлица("01"), "Тест"));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Длинный)))
		.Содержит("ИННПоВидуЛица");

	Пустой = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица("", КППЮрлица("01"), "Тест"));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Пустой)))
		.Содержит("ИННПоВидуЛица");

КонецПроцедуры

// КПП юрлица, зарегистрированного в России: не 9 цифр и пустой - замечание КППЮрлицаРФ;
// у нерезидента (признак sd_Нерезидент, страна регистрации не указана) КПП и ИНН по виду
// лица не проверяются.
Процедура КППЮрлицаНеДевятьЦифр() Экспорт

	Обработка = ОбъектОбработки();

	Короткий = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), "99010100", "Тест"));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Короткий)))
		.Содержит("КППЮрлицаРФ");

	Пустой = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), "", "Тест"));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Пустой)))
		.Содержит("КППЮрлицаРФ");

	МодельНерезидента = МодельЮрлица("", "", "Foreign Ltd");
	МодельНерезидента.Реквизиты.Вставить("sd_Нерезидент", Истина);
	МодельНерезидента.Реквизиты.Вставить("СтранаРегистрации", Справочники.СтраныМира.ПустаяСсылка());
	Нерезидент = СоздатьЗаявку(ВидОперацииСоздание(), МодельНерезидента);
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Нерезидент)))
		.НеСодержит("КППЮрлицаРФ")
		.НеСодержит("ИННПоВидуЛица");

КонецПроцедуры

// Знаки 5-6 КПП: юрлицо с КПП подразделения «43» и ОП с КПП юрлица «01» - замечание;
// государственный орган с КПП «43» - проверка не применяется.
Процедура КППИВидКонтрагентаНеСовпадают() Экспорт

	Обработка = ОбъектОбработки();

	ЮрлицоСКППОП = СоздатьЗаявку(ВидОперацииСоздание(), МодельЮрлица(ИННЮрлица(), КППЮрлица("43"), "Тест"));
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, ЮрлицоСКППОП)))
		.Содержит("КППИВидКонтрагента");

	МодельОП = МодельЮрлица(ИННЮрлица(), КППЮрлица("01"), "Тест ОП");
	МодельОП.Реквизиты.Вставить("sd_ОП", Истина);
	ОПСКППЮрлица = СоздатьЗаявку(ВидОперацииСоздание(), МодельОП);
	Данные = ДанныеРезультата(Обработка, ОПСКППЮрлица);
	ЮТест.ОжидаетЧто(Данные.Получить("counterparty").Получить("kind"), "kind")
		.Равно("обособленное подразделение")
		.Что(КодыЗамечаний(Данные), "коды замечаний").Содержит("КППИВидКонтрагента");

	МодельГосоргана = МодельЮрлица(ИННЮрлица(), КППЮрлица("43"), "Тест госорган");
	МодельГосоргана.Реквизиты.Вставить("ГосударственныйОрган", Истина);
	Госорган = СоздатьЗаявку(ВидОперацииСоздание(), МодельГосоргана);
	ЮТест.ОжидаетЧто(КодыЗамечаний(ДанныеРезультата(Обработка, Госорган)))
		.НеСодержит("КППИВидКонтрагента");

КонецПроцедуры

