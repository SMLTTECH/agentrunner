///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ОчисткаДанных.
//
// Тесты регламентных заданий, которые удаляют данные (план «ТЕСТЫ: расширение
// покрытия ядра», раздел 3.3): очистка служебного лога и снимков запусков
// (ar_Планировщик.ОбработатьОчисткуСлужебногоЛога), компакция аудита
// (ar_Планировщик.ОбработатьКомпакциюAudit). Проверяются обе стороны границы
// срока хранения: старое удалено, свежее и защищённое - цело. Ошибка границы
// удалила бы живые снимки - возобновление запуска стало бы невозможным.
//
// Все тесты в транзакции: сроки хранения (константы, настройки) задаются в ней
// и откатываются вместе с тестовыми данными и с тем, что тик удалил на стенде.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Очистка служебного лога")
		.ДобавитьСерверныйТест("ОчисткаСлужебногоЛогаПоСроку").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НекорректныйСрокХраненияЛогаПоУмолчанию").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Очистка снимков запусков")
		.ДобавитьСерверныйТест("ОчисткаСнимковТолькоТерминальных").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НекорректныйСрокХраненияСнимковПоУмолчанию").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Компакция аудита")
		.ДобавитьСерверныйТест("КомпакцияАудитаНеТрогаетАктивные").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сроки хранения в тестах - десятки лет (ДнейХранения, ДнейХраненияОтладки), а
// тестовые записи датированы по обе стороны этих границ: тик в транзакции
// удаляет только данные теста. С короткими сроками он построчно удалял бы
// весь накопленный лог стенда в транзакции теста - это часы.

// Срок хранения лога ДнейХранения, отладки ДнейХраненияОтладки: запись старше
// срока хранения удалена, младше - цела; отладочная старше срока отладки
// удалена, младше - цела; ошибка старше срока отладки (не отладка) цела;
// защищённое событие tool_access_rules_widened цело при любой давности.
Процедура ОчисткаСлужебногоЛогаПоСроку() Экспорт

	УстановитьДлинныеСрокиЛога();
	ДатаСеанса = ТекущаяДатаСеанса();

	Старая = ЗаписатьЛог("test_cleanup_old", "Информация", ДатаСеанса - ДнейВСекундах(ДнейХранения() + 1));
	Свежая = ЗаписатьЛог("test_cleanup_fresh", "Информация", ДатаСеанса - ДнейВСекундах(ДнейХранения() - 1));
	ОтладкаСтарая = ЗаписатьЛог("test_cleanup_debug_old", "Отладка",
		ДатаСеанса - ДнейВСекундах(ДнейХраненияОтладки() + 1));
	ОтладкаСвежая = ЗаписатьЛог("test_cleanup_debug_fresh", "Отладка",
		ДатаСеанса - ДнейВСекундах(ДнейХраненияОтладки() - 1));
	ОшибкаСтарая = ЗаписатьЛог("test_cleanup_error", "Ошибка",
		ДатаСеанса - ДнейВСекундах(ДнейХраненияОтладки() + 1));
	Защищённая = ЗаписатьЛог("tool_access_rules_widened", "Информация",
		ДатаСеанса - ДнейВСекундах(ДнейХранения() + 100));

	ar_Планировщик.ОбработатьОчисткуСлужебногоЛога();

	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(Старая), "запись старше срока хранения").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(Свежая), "запись младше срока хранения").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(ОтладкаСтарая), "отладка старше срока отладки").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(ОтладкаСвежая), "отладка младше срока отладки").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(ОшибкаСтарая), "ошибка старше срока отладки").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьЛогаЕсть(Защищённая), "защищённое событие").ЭтоИстина();

КонецПроцедуры

// Срок хранения 0 (не задан) или отрицательный - сроки по умолчанию 30 и 7
// дней, а не «удалить всё» (граница очистки - ar_Константы).
Процедура НекорректныйСрокХраненияЛогаПоУмолчанию() Экспорт

	Константы.ar_СлужебныйЛогХранитьДней.Установить(0);
	Константы.ar_СлужебныйЛогХранитьОтладкуДней.Установить(0);

	ЮТест.ОжидаетЧто(ar_Константы.СлужебныйЛогХранитьДней(), "срок хранения при 0").Равно(30);
	ЮТест.ОжидаетЧто(ar_Константы.СлужебныйЛогХранитьОтладкуДней(), "срок отладки при 0").Равно(7);

КонецПроцедуры

// Срок хранения снимков ДнейХранения: снимок завершённого запуска старше срока
// очищен; снимок завершённого запуска младше срока и снимки приостановленных
// (подтверждение, событие) старше срока целы - по ним запуск возобновляется.
Процедура ОчисткаСнимковТолькоТерминальных() Экспорт

	УстановитьДлинныеСрокиЛога();
	УстановитьСрокХраненияСнимков(ДнейХранения());
	ДатаСеанса = ТекущаяДатаСеанса();
	Давно = ДатаСеанса - ДнейВСекундах(ДнейХранения() + 1);
	Недавно = ДатаСеанса - ДнейВСекундах(ДнейХранения() - 1);

	ЗавершённыйСтарый = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Завершён, Давно, Давно);
	ЗавершённыйСвежий = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Завершён, Недавно, Недавно);
	ЖдётПодтверждения = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения, Давно);
	ЖдётСобытия = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия, Давно);

	// Курсор очистки - перед датами теста: на стенде он сдвинут ночными
	// запусками, записи раньше курсора тик не смотрит.
	УстановитьКурсорОчисткиСнимков(Давно - ДнейВСекундах(1));

	ar_Планировщик.ОбработатьОчисткуСлужебногоЛога();

	ЮТест.ОжидаетЧто(СнимокЕсть(ЗавершённыйСтарый), "снимок завершённого запуска старше срока").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СнимокЕсть(ЗавершённыйСвежий), "снимок завершённого запуска младше срока").ЭтоИстина();
	ЮТест.ОжидаетЧто(СнимокЕсть(ЖдётПодтверждения), "снимок запуска, ждущего подтверждения").ЭтоИстина();
	ЮТест.ОжидаетЧто(СнимокЕсть(ЖдётСобытия), "снимок запуска, ждущего события").ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(ЗавершённыйСтарый).Статус, "статус очищенного запуска")
		.Равно(Перечисления.ar_СтатусЗапуска.Завершён);

КонецПроцедуры

// Некорректный срок хранения снимков (отрицательный, не число) - срок по
// умолчанию 30 дней: снимок возрастом 20 дней цел, 30,5 дня - очищен. Курсор -
// за сутки до границы: тик смотрит только сутки завершённых запусков стенда.
Процедура НекорректныйСрокХраненияСнимковПоУмолчанию() Экспорт

	УстановитьДлинныеСрокиЛога();
	ДатаСеанса = ТекущаяДатаСеанса();
	Давно = ДатаСеанса - ДнейВСекундах(30) - 43200;
	Недавно = ДатаСеанса - ДнейВСекундах(20);

	Для Каждого Срок Из ЗначенияНекорректногоСрока() Цикл

		УстановитьСрокХраненияСнимков(Срок);
		Старый = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Завершён, Давно, Давно);
		Свежий = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Завершён, Недавно, Недавно);
		УстановитьКурсорОчисткиСнимков(ДатаСеанса - ДнейВСекундах(31));

		ar_Планировщик.ОбработатьОчисткуСлужебногоЛога();

		ЮТест.ОжидаетЧто(СнимокЕсть(Свежий), "снимок возрастом 20 дней при сроке " + Срок).ЭтоИстина();
		ЮТест.ОжидаетЧто(СнимокЕсть(Старый), "снимок возрастом 30,5 дня при сроке " + Срок).ЭтоЛожь();

	КонецЦикла;

КонецПроцедуры

// Компакция аудита: событие старше порога у завершённого запуска удалено, у
// выполняющегося запуска - цело, сам выполняющийся запуск цел.
Процедура КомпакцияАудитаНеТрогаетАктивные() Экспорт

	Константы.ar_РазрешитьОчисткуAudit.Установить(Истина);
	ДнейПорога = ar_Константы.КомпакцияAuditДней();
	Если ДнейПорога <= 0 Тогда
		ДнейПорога = 90;
	КонецЕсли;
	Давно = ТекущаяДатаСеанса() - ДнейВСекундах(ДнейПорога + 2);

	Завершённый = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Завершён, Давно, Давно);
	Активный = ЗапускСоСнимком(Перечисления.ar_СтатусЗапуска.Выполняется, Давно);
	ЗаписатьСобытиеЗапуска(Завершённый, Давно);
	ЗаписатьСобытиеЗапуска(Активный, Давно);

	ar_Планировщик.ОбработатьКомпакциюAudit();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СобытияЗапуска(Завершённый).Количество(),
		"событий завершённого запуска старше порога").Равно(0);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СобытияЗапуска(Активный).Количество(),
		"событий выполняющегося запуска").Равно(1);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Активный), "выполняющийся запуск")
		.Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Выполняется);
	ЮТест.ОжидаетЧто(СнимокЕсть(Активный), "снимок выполняющегося запуска").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Срок хранения служебного лога в тестах очистки, дней (около 25 лет): старше
// него на стенде записей нет.
//
// Возвращаемое значение:
//  Число.
//
Функция ДнейХранения()

	Возврат 9000;

КонецФункции

// Срок хранения отладки служебного лога в тестах очистки, дней (около 22 лет).
//
// Возвращаемое значение:
//  Число.
//
Функция ДнейХраненияОтладки()

	Возврат 8000;

КонецФункции

// Задаёт длинные сроки хранения служебного лога (ДнейХранения,
// ДнейХраненияОтладки): шаги очистки лога не трогают записи стенда.
Процедура УстановитьДлинныеСрокиЛога()

	Константы.ar_СлужебныйЛогХранитьДней.Установить(ДнейХранения());
	Константы.ar_СлужебныйЛогХранитьОтладкуДней.Установить(ДнейХраненияОтладки());

КонецПроцедуры

// Число секунд в заданном числе суток.
//
// Параметры:
//  Дней - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция ДнейВСекундах(Знач Дней)

	Возврат Дней * 86400;

КонецФункции

// Записывает строку служебного лога с заданным моментом (менеджер записи
// регистра: штатная запись ar_СлужебныйЛог.Записать ставит текущий момент).
//
// Параметры:
//  Событие - Строка;
//  Уровень - Строка - "Информация" / "Отладка" / "Ошибка";
//  Момент  - Дата.
//
// Возвращаемое значение:
//  Структура - ключ записи {ИдЗаписи, Момент}.
//
Функция ЗаписатьЛог(Знач Событие, Знач Уровень, Знач Момент)

	ИдЗаписи = Строка(Новый УникальныйИдентификатор());
	Запись = РегистрыСведений.ar_СлужебныйЛог.СоздатьМенеджерЗаписи();
	Запись.ar_ЗаписьId = ИдЗаписи;
	Запись.ar_Момент = Момент;
	Запись.ar_Источник = "ОМ_ar_ОчисткаДанных";
	Запись.ar_Событие = Событие;
	Запись.ar_Уровень = Уровень;
	Запись.ar_Текст = "Тестовая запись очистки";
	Запись.Записать(Истина);

	Возврат Новый Структура("ИдЗаписи, Момент", ИдЗаписи, Момент);

КонецФункции

// Есть ли строка служебного лога с ключом.
//
// Параметры:
//  Ключ - Структура - {ИдЗаписи, Момент} из ЗаписатьЛог.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаписьЛогаЕсть(Знач Ключ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_ЗаписьId = &ИдЗаписи
		|	И Лог.ar_Момент = &Момент");
	Запрос.УстановитьПараметр("ИдЗаписи", Ключ.ИдЗаписи);
	Запрос.УстановитьПараметр("Момент", Ключ.Момент);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Создаёт запуск с заданным статусом, датами и непустым снимком состояния.
//
// Параметры:
//  Статус     - ПеречислениеСсылка.ar_СтатусЗапуска;
//  СтартовалВ - Дата;
//  ЗавершенВ  - Дата - пустая для незавершённого запуска.
//
// Возвращаемое значение:
//  Строка - ИдЗапуска.
//
Функция ЗапускСоСнимком(Знач Статус, Знач СтартовалВ, Знач ЗавершенВ = '00010101')

	ИдЗапуска = ОМ_ar_ТестовыеДанные.СоздатьЗапуск(ОМ_ar_ТестовыеДанные.НовыйRunId(), Неопределено);

	Запись = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	Запись.ar_ИдентификаторЗапуска = ИдЗапуска;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		ВызватьИсключение СтрШаблон("Запись запуска %1 не создана", ИдЗапуска);
	КонецЕсли;
	Запись.ar_Статус = Статус;
	Запись.ar_СтартовалВ = СтартовалВ;
	Запись.ar_ЗавершенВ = ЗавершенВ;
	Запись.ar_ПовторитьПосле = '00010101';
	Запись.ar_StateSnapshot = Новый ХранилищеЗначения(Новый Структура("v, state", 1, Новый Структура));
	Запись.Записать(Истина);

	Возврат ИдЗапуска;

КонецФункции

// Снимок состояния запуска не пуст.
//
// Параметры:
//  ИдЗапуска - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция СнимокЕсть(Знач ИдЗапуска)

	Запись = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	Запись.ar_ИдентификаторЗапуска = ИдЗапуска;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Запись.ar_StateSnapshot.Получить() <> Неопределено;

КонецФункции

// Событие аудита запуска с заданным моментом.
//
// Параметры:
//  ИдЗапуска  - Строка;
//  Момент - Дата.
//
Процедура ЗаписатьСобытиеЗапуска(Знач ИдЗапуска, Знач Момент)

	Запись = РегистрыСведений.ar_СобытияЗапуска.СоздатьМенеджерЗаписи();
	Запись.ar_RunId = ИдЗапуска;
	Запись.ar_Sequence = 1;
	Запись.ar_МоментВремени = Момент;
	Запись.ar_ТипСобытия = Перечисления.ar_ТипСобытия.Стартован;
	Запись.ar_PayloadJSON = "{""code"": ""run_started""}";
	Запись.Записать(Истина);

КонецПроцедуры

// Задаёт настройку СнимкиЗапусковХранитьДней и сбрасывает кэш настроек сеанса.
//
// Параметры:
//  Срок - Произвольный - значение настройки.
//
Процедура УстановитьСрокХраненияСнимков(Знач Срок)

	ar_Настройки.УстановитьЗначение("СнимкиЗапусковХранитьДней", Срок, Истина,
		"Тест: срок хранения снимков запусков");
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Задаёт курсор очистки снимков СнимкиЗапусковОчищеноДо.
//
// Параметры:
//  Курсор - Дата.
//
Процедура УстановитьКурсорОчисткиСнимков(Знач Курсор)

	ar_Настройки.УстановитьЗначение("СнимкиЗапусковОчищеноДо", Курсор, Истина,
		"Тест: снимки запусков очищены до");

КонецПроцедуры

// Некорректные значения срока хранения снимков.
