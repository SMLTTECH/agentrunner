///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_RuntimeПарсер.
//
// Тесты парсера ответов модели (ar_RuntimeПарсер.РазобратьОтвет): нативные
// вызовы (Сообщение.tool_calls), запасной формат tool_call-тегов в тексте,
// пропуски невалидных вызовов (пустое имя, невалидный JSON аргументов,
// превышение размера) с ЕстьОшибки, тихий пропуск чужого type, пустой
// результат без исключения для не-структуры / Успех=Ложь.
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("РазборОтвета")
		.ДобавитьСерверныйТест("ТекстовыйОтветБезВызовов").Тег("critical")
		.ДобавитьСерверныйТест("НативныеВызовыРазбираются").Тег("critical")
		.ДобавитьСерверныйТест("ЗапаснойФорматВТекстеРазбирается").Тег("critical")
		.ДобавитьСерверныйТест("ПустоеИмяОтмечаетОшибку").Тег("critical")
		.ДобавитьСерверныйТест("НевалидныйJSONАргументовОтмечаетОшибку").Тег("critical")
		.ДобавитьСерверныйТест("ПревышениеРазмераАргументовОтмечаетОшибку").Тег("critical")
		.ДобавитьСерверныйТест("ЧужойTypeПропускаетсяТихо").Тег("critical")
		.ДобавитьСерверныйТест("ПустойОтветБезИсключения").Тег("critical")
		.ДобавитьСерверныйТест("ПустыеАргументыЗаменяютсяФигурнымиСкобками").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Текст без tool_calls: Действия пустые, ТекстОтвета заполнен, ошибок нет.
Процедура ТекстовыйОтветБезВызовов() Экспорт

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("Просто текст", Неопределено));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ТекстОтвета").Равно("Просто текст")
		.Свойство("ЕстьОшибки").ЭтоЛожь();

КонецПроцедуры

// Нативные tool_calls разбираются в действия {Имя, ИдВызова, Аргументы}.
Процедура НативныеВызовыРазбираются() Экспорт

	Вызовы = Новый Массив;
	Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall("call-9", "get_constants",
		"{""раздел"": ""тест""}"));

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоЛожь()
		.Свойство("Действия[0].Имя").Равно("get_constants")
		.Свойство("Действия[0].ИдВызова").Равно("call-9")
		.Свойство("Действия[0].Аргументы").Равно("{""раздел"": ""тест""}");

КонецПроцедуры

// Запасной формат - tool_call-теги в тексте - разбирается в действия.
Процедура ЗапаснойФорматВТекстеРазбирается() Экспорт

	Текст = "Выполняю поиск. <tool_call>{""tool"": ""get_constants"", ""args"": {""а"": 1}}</tool_call> Готово.";

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели(Текст, Неопределено));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоЛожь()
		.Свойство("Действия[0].Имя").Равно("get_constants");
	// ФАКТ: аргументы запасного формата пересериализуются ar_JSON.ВЗначениеJSON,
	// сериализация даёт пробелы после разделителей: { "а": 1 }.
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Действия[0].Аргументы, """а""") > 0)
		.Что(СтрНайти(Результат.Действия[0].Аргументы, "1") > 0).ЭтоИстина();

КонецПроцедуры

// Пустое имя инструмента: вызов пропущен, ЕстьОшибки = Истина.
Процедура ПустоеИмяОтмечаетОшибку() Экспорт

	Вызовы = Новый Массив;
	Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall("call-1", "", "{}"));

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоИстина();

КонецПроцедуры

// Невалидный JSON аргументов: вызов пропущен, ЕстьОшибки = Истина.
Процедура НевалидныйJSONАргументовОтмечаетОшибку() Экспорт

	Вызовы = Новый Массив;
	Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall("call-1", "get_constants", "{битый json"));

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоИстина();

КонецПроцедуры

// Аргументы больше лимита 64 КБ (UTIL-03): вызов пропущен до разбора JSON,
// ЕстьОшибки = Истина.
Процедура ПревышениеРазмераАргументовОтмечаетОшибку() Экспорт

	Части = Новый Массив;
	Для Сч = 1 По 7000 Цикл
		Части.Добавить("xxxxxxxxxx");
	КонецЦикла;
	БольшойJSON = "{""поле"": """ + СтрСоединить(Части, "") + """}";

	Вызовы = Новый Массив;
	Вызовы.Добавить(ar_LLMКонтракт.НовыйToolCall("call-4", "get_constants", БольшойJSON));

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоИстина();

КонецПроцедуры

// type, отличный от "function" (непустой), пропускается тихо - без ошибки.
Процедура ЧужойTypeПропускаетсяТихо() Экспорт

	ЧужойВызов = Новый Структура;
	ЧужойВызов.Вставить("id", "call-2");
	ЧужойВызов.Вставить("type", "custom_tool");
	ЧужойВызов.Вставить("function", Новый Структура("name, arguments", "get_constants", "{}"));

	Вызовы = Новый Массив;
	Вызовы.Добавить(ЧужойВызов);

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ЕстьОшибки").ЭтоЛожь();

КонецПроцедуры

// Не структура / Успех = Ложь / Сообщение не структура - пустой результат
// без исключения.
Процедура ПустойОтветБезИсключения() Экспорт

	Пустой = ar_RuntimeПарсер.РазобратьОтвет(Неопределено);
	ЮТест.ОжидаетЧто(Пустой.Действия.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Пустой)
		.Свойство("ЕстьОшибки").ЭтоЛожь();

	Провал = ar_LLMКонтракт.НовыйОтвет();
	Провал.Ошибка = "Тестовая ошибка";
	ПустойПровал = ar_RuntimeПарсер.РазобратьОтвет(Провал);
	ЮТест.ОжидаетЧто(ПустойПровал.Действия.Количество()).Равно(0);

	БезСообщения = ar_LLMКонтракт.НовыйОтвет();
	БезСообщения.Успех = Истина;
	ПустойБезСообщения = ar_RuntimeПарсер.РазобратьОтвет(БезСообщения);
	ЮТест.ОжидаетЧто(ПустойБезСообщения.Действия.Количество()).Равно(0);

КонецПроцедуры

// Пустые arguments подставляются "{}".
Процедура ПустыеАргументыЗаменяютсяФигурнымиСкобками() Экспорт

	ВызовБезАргументов = Новый Структура;
	ВызовБезАргументов.Вставить("id", "call-3");
	ВызовБезАргументов.Вставить("type", "function");
	ВызовБезАргументов.Вставить("function", Новый Структура("name, arguments", "get_constants", ""));

	Вызовы = Новый Массив;
	Вызовы.Добавить(ВызовБезАргументов);

	Результат = ar_RuntimeПарсер.РазобратьОтвет(ОтветМодели("", Вызовы));

	ЮТест.ОжидаетЧто(Результат.Действия.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("Действия[0].Аргументы").Равно("{}");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ответ модели: {Успех, Сообщение: {role, content, [tool_calls]}}.
//
Функция ОтветМодели(Знач Содержание, Знач ВызовыИнструментов)

	Сообщение = Новый Структура;
	Сообщение.Вставить("role", ar_LLMКонтракт.РольAssistant());
	Сообщение.Вставить("content", Содержание);
	Если ВызовыИнструментов <> Неопределено Тогда
		Сообщение.Вставить("tool_calls", ВызовыИнструментов);
	КонецЕсли;

	Ответ = ar_LLMКонтракт.НовыйОтвет();
	Ответ.Успех = Истина;
	Ответ.Сообщение = Сообщение;
	Ответ.КодСостояния = 200;
	Возврат Ответ;

КонецФункции

#КонецОбласти
