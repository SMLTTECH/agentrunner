///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_RuntimeЗапуск.
//
// Тесты управления запуском (ar_RuntimeЗапуск): СтартоватьВФоне - ветки отказа
// до постановки фонового задания (agent_not_found_or_inactive,
// agent_already_running) и guard R2 «спящий PausedForEvent считается активным»;
// пробуждение спящих запусков (PLAN-12): подходящее событие возобновляет спящий
// запуск тем же RunId, неподходящее (нет СобытиеТипа / чужой тип / фильтр не
// прошел) - обычный guard-отказ; СтартоватьВФонеБезАгента - запуск без агента
// со стартовым сообщением; ЗаданиеЗапускаАктивно - несуществующий и завершенный
// RunId не активны; Отменить - несуществующий и завершенный запуск не
// отменяются, приостановленный отменяется.
//
// Тесты, где ядро ставит реальное фоновое задание (пробуждение, старт без
// агента), регистрируются БЕЗ ВТранзакции: задание не видит незавершенную
// транзакцию (спека agentrunner-373, «Общие правила»). Очистка их данных -
// в конце тела теста (RunId и ссылки локальны), сценарий ar_LLMMock гасится
// .После("ОчиститьMock") при любом исходе.
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27; критерии 1-4
// спеки agentrunner-373 («ТЕСТЫ: guard старта и пробуждение спящих запусков»).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("СтартоватьВФоне")
		.ДобавитьСерверныйТест("НеактивныйАгентНеСтартирует").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустойАгентНеСтартирует").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("УжеЗапущенныйАгентНеСтартирует").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СпящийЗапускСчитаетсяАктивным").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Пробуждение спящих (PLAN-12)")
		.ДобавитьСерверныйТест("ПодходящееСобытиеРазбудитСпящийЗапуск").Тег("critical").После("ОчиститьMock")
		.ДобавитьСерверныйТест("ТриггерБезСобытияНеРазбудит").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СобытиеДругогоТипаНеРазбудит").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СобытиеСНесовпадающимФильтромНеРазбудит").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Старт без агента")
		.ДобавитьСерверныйТест("СтартБезАгентаСоздаетЗапускСоСтартовымСообщением")
			.Тег("critical").После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("Отмена")
		.ДобавитьСерверныйТест("НесуществующийЗапускНеОтменяется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗавершённыйЗапускНеОтменяется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПриостановленныйЗапускОтменяется").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ЗаданиеЗапускаАктивно")
		.ДобавитьСерверныйТест("ЗаданиеНесуществующегоЗапускаНеактивно").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗаданиеЗавершенногоЗапускаНеактивно").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// СтартоватьВФоне с неактивным агентом: Успех = Ложь,
// agent_not_found_or_inactive, записи запуска нет.
Процедура НеактивныйАгентНеСтартирует() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_not_found_or_inactive");

КонецПроцедуры

// СтартоватьВФоне с пустой ссылкой агента - та же ветка отказа.
Процедура ПустойАгентНеСтартирует() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(
		Справочники.ar_Агенты.ПустаяСсылка(), Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_not_found_or_inactive");

КонецПроцедуры

// СтартоватьВФоне при активном запуске агента (Выполняется): Успех = Ложь,
// agent_already_running.
Процедура УжеЗапущенныйАгентНеСтартирует() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "manual");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");

КонецПроцедуры

// Спящий запуск агента (ПриостановленДляСобытия, PLAN-11) без ar_ОжидаетСобытия:
// пробуждение не срабатывает (данных события нет), guard R2 считает паузу
// активной - Успех = Ложь, agent_already_running, второй запуск не создан
// (спека agentrunner-373, критерий 1; PLAN-12 DoD D7, R2).
Процедура СпящийЗапускСчитаетсяАктивным() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	Пауза = Новый Структура;
	Пауза.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	ar_AuditЗапуски.Завершить(RunId, Пауза);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество()).Равно(1);

КонецПроцедуры

// Подходящее событие (тип из СобытиеТипа совпал с object_type из
// ar_ОжидаетСобытия, пустой фильтр пропускает любой якорь) возобновляет спящий
// запуск тем же RunId вместо нового запуска (спека agentrunner-373, критерий 2;
// PLAN-12 S1, шаг 5). Спящая пауза ставится настоящим циклом: mock-сценарий
// [wait_for_event, финальный текст] уводит запуск в паузу PLAN-11 со снимком.
// Тест БЕЗ транзакции: возобновление ставит реальное фоновое задание; очистка
// данных - в конце тела, сценарий заглушки - .После("ОчиститьMock").
Процедура ПодходящееСобытиеРазбудитСпящийЗапуск() Экспорт

	ТипОжидания = "Справочник.УчетныеЗаписиЭлектроннойПочты";

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Инструмент = ОМ_ar_ТестовыеДанные.НовыйИнструментСМетодом("wait_for_event",
		Перечисления.ar_УровеньРиска.Чтение, "ar_ИнструментыПлан", "ОжидатьСобытия");
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	Сценарий = Новый Массив;
	АргументыОжидания = ar_JSON.ВЗначениеJSON(
		Новый Структура("object_type, deadline_hours", ТипОжидания, 1));
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветToolCall("wait_for_event", АргументыОжидания));
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Событие наступило, работа продолжена."));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Агент, RunId);

	// Приготовление состоялось: пауза PLAN-11 со снимком - иначе проверять нечего.
	Пауза = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Пауза.Статус).Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	ЮТест.ОжидаетЧто(Пауза.СнимокЕсть).ЭтоИстина();

	Якорь = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа().Ссылка;
	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "webhook");
	Контекст.Вставить("СобытиеТип", ТипОжидания + ".ПриЗаписи");
	Контекст.Вставить("ЯкорьСсылка", Якорь);

	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина()
		.Свойство("RunId").Равно(RunId); // тот же RunId - новый запуск не создан
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество()).Равно(1);

	УбратьДанныеПробуждения(RunId, Инструмент, Агент, Провайдер, Якорь);

КонецПроцедуры

// Ручной триггер (без СобытиеТипа/ЯкорьСсылка) спящий запуск не будит:
// пробуждение возвращает Неопределено и старт доходит до guard'а R2 -
// agent_already_running, второй запуск не создан (спека agentrunner-373,
// критерий 2, «неподходящее - отказ guard'а»; PLAN-12 D11).
Процедура ТриггерБезСобытияНеРазбудит() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ФильтрОжидания = Новый Структура;
	Ожидание = Новый Структура("object_type, filter",
		"Справочник.УчетныеЗаписиЭлектроннойПочты", ФильтрОжидания);
	Пауза = Новый Структура;
	Пауза.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	Пауза.Вставить("ОжидаетСобытия", ar_JSON.ВЗначениеJSON(Ожидание));
	ar_AuditЗапуски.Завершить(RunId, Пауза);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество()).Равно(1);

КонецПроцедуры

// Событие чужого типа (СобытиеТип не совпал с object_type из
// ar_ОжидаетСобытия) спящий запуск не будит: type mismatch -> Неопределено,
// guard R2 - agent_already_running, второй запуск не создан (спека
// agentrunner-373, критерий 2; PLAN-12 D11).
Процедура СобытиеДругогоТипаНеРазбудит() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ФильтрОжидания = Новый Структура;
	Ожидание = Новый Структура("object_type, filter",
		"Справочник.УчетныеЗаписиЭлектроннойПочты", ФильтрОжидания);
	Пауза = Новый Структура;
	Пауза.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	Пауза.Вставить("ОжидаетСобытия", ar_JSON.ВЗначениеJSON(Ожидание));
	ar_AuditЗапуски.Завершить(RunId, Пауза);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "webhook");
	Контекст.Вставить("СобытиеТип", "Документ.бит_мдм_ЗаявкаНаИзменение.ПриЗаписи");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество()).Равно(1);

КонецПроцедуры

// Событие подходящего типа, но не прошедшее фильтр ожидания (Наименование
// якоря не совпало со значением filter из ar_ОжидаетСобытия): пробуждение не
// срабатывает - guard R2, agent_already_running, второй запуск не создан
// (спека agentrunner-373, критерий 2; PLAN-12 шаг 4).
Процедура СобытиеСНесовпадающимФильтромНеРазбудит() Экспорт

	ТипОжидания = "Справочник.УчетныеЗаписиЭлектроннойПочты";
	Якорь = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа().Ссылка;

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ФильтрОжидания = Новый Структура;
	ФильтрОжидания.Вставить("Наименование", "СовпаденийНеБудет_" + RunId);
	Ожидание = Новый Структура("object_type, filter", ТипОжидания, ФильтрОжидания);
	Пауза = Новый Структура;
	Пауза.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	Пауза.Вставить("ОжидаетСобытия", ar_JSON.ВЗначениеJSON(Ожидание));
	ar_AuditЗапуски.Завершить(RunId, Пауза);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "webhook");
	Контекст.Вставить("СобытиеТип", ТипОжидания + ".ПриЗаписи");
	Контекст.Вставить("ЯкорьСсылка", Якорь);
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество()).Равно(1);

КонецПроцедуры

// СтартоватьВФонеБезАгента (UI-22): запись запуска создается с пустым агентом
// и триггером manual_chat_no_agent; признак БезАгента и стартовое сообщение
// (ЗапросПользователя) передаются циклу в параметрах фонового задания
// (спека agentrunner-373, критерий 3). Тест БЕЗ транзакции (реальное
// фоновое задание); очистка - в конце тела, mock - .После("ОчиститьMock").
Процедура СтартБезАгентаСоздаетЗапускСоСтартовымСообщением() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Ответ цикла без агента."));
	// Вердикт завершения: без него надзор отвечает «не определен», цикл
	// продолжается вторым шагом, сценарий исчерпан, и запуск зависает в
	// Выполняется на повторах с паузами (диагностика прогона 2).
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));
	// Персональный сценарий провайдера: фоновый цикл должен получить ровно этот
	// ответ, даже пока «хвостовое» фоновое задание соседнего теста докручивает
	// свой цикл на общем сценарии заглушки (пересечение сценариев - предписание
	// спеки, раздел Б8).
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий, Провайдер);

	ТекстЗапроса = "Тестовый запрос без агента " + Строка(Новый УникальныйИдентификатор());
	Контекст = Новый Структура;
	Контекст.Вставить("БезАгента", Истина);
	Контекст.Вставить("ОверрайдTools", Новый Массив);
	Контекст.Вставить("ОверрайдПровайдер", Провайдер);
	Контекст.Вставить("ЗапросПользователя", ТекстЗапроса);
	Контекст.Вставить("Триггер", "manual_chat_no_agent");

	Результат = ar_RuntimeЗапуск.СтартоватьВФонеБезАгента(Контекст);
	RunId = Результат.RunId;

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрДлина(RunId))
		.Равно(СтрДлина(Строка(Новый УникальныйИдентификатор()))); // формат UUID

	// Запуск без агента: запись с пустым АгентРеф и триггером режима без агента.
	ЗаписиБезАгента = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Справочники.ar_Агенты.ПустаяСсылка());
	ОтборЗаписи = Новый Структура("RunId, Триггер", RunId, "manual_chat_no_agent");
	ЮТест.ОжидаетЧто(ЗаписиБезАгента.НайтиСтроки(ОтборЗаписи).Количество()).Равно(1);

	// Контракт передачи проверяем по эффекту: свойства Параметры у ФоновоеЗадание
	// нет (MCP get_type_methods, 8.3.27). Дождаться завершения реального задания
	// и убедиться, что стартовое сообщение пользователя дошло до цикла: оно
	// попадает в данные запуска - в сообщения промпта события llm_called
	// (ключ messages, UI-11). Тот же запрос без агента должен выполнить запуск.
	ОтборЗадания = Новый Структура("Ключ", "ar_run_" + RunId);
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборЗадания);
	Если Задания.Количество() > 0 Тогда
		Задания[0].ОжидатьЗавершенияВыполнения(30);
		ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId)
			.Статус, "запуск без агента выполнился фоновым заданием; "
				+ ДиагностикаЗапуска(RunId))
			.Равно(Перечисления.ar_СтатусЗапуска.Завершён);
	Иначе
		// Задания нет - цикл выполнен синхронно (лимит активных заданий
		// файловой ИБ); серверный прогон юнитов в эту ветку не попадает.
		ЮТест.ОжидаетЧто(ОбщегоНазначения.ИнформационнаяБазаФайловая()).ЭтоИстина();
	КонецЕсли;

	ЮТест.ОжидаетЧто(СтартовыйЗапросВСобытиях(RunId, ТекстЗапроса),
		"стартовое сообщение пользователя в сообщениях вызова LLM").ЭтоИстина();

	УбратьДанныеБезАгента(RunId, Провайдер);

КонецПроцедуры

// Отменить несуществующий запуск: Ложь (фантомная запись не создаётся).
Процедура НесуществующийЗапускНеОтменяется() Экспорт

	ЮТест.ОжидаетЧто(
		ar_RuntimeЗапуск.Отменить(ОМ_ar_ТестовыеДанные.НовыйRunId())).ЭтоЛожь();

КонецПроцедуры

// Отменить уже завершённый запуск: Ложь, статус не меняется.
Процедура ЗавершённыйЗапускНеОтменяется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.Отменить(RunId)).ЭтоЛожь();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.Завершён);

КонецПроцедуры

// Отменить приостановленный (ПриостановленДляПодтверждения) запуск: Истина,
// статус Прерван (факт: Отменить переводит в Прерван - см. scenarios.md 1.12).
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.12, tests.md agentrunner-27 №7): тест закрепляет текущее поведение
// «Отменить переводит приостановленный запуск в Прерван (не Отменен)»;
// ожидалось «статус Отменен». Если решат изменить поведение - поправить тест вместе с кодом.
Процедура ПриостановленныйЗапускОтменяется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ДанныеПаузы = Новый Структура;
	ДанныеПаузы.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ar_AuditЗапуски.Завершить(RunId, ДанныеПаузы);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.Отменить(RunId)).ЭтоИстина();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.Прерван);

КонецПроцедуры

// ЗаданиеЗапускаАктивно для несуществующего RunId: Ложь
// (спека agentrunner-373, критерий 4).
Процедура ЗаданиеНесуществующегоЗапускаНеактивно() Экспорт

	ЮТест.ОжидаетЧто(
		ar_RuntimeЗапуск.ЗаданиеЗапускаАктивно(ОМ_ar_ТестовыеДанные.НовыйRunId())).ЭтоЛожь();

КонецПроцедуры

// ЗаданиеЗапускаАктивно для завершенного запуска: Ложь - фонового задания
// по ключу RunId нет (спека agentrunner-373, критерий 4).
Процедура ЗаданиеЗавершенногоЗапускаНеактивно() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.ЗаданиеЗапускаАктивно(RunId)).ЭтоЛожь();

КонецПроцедуры

// Гасит сценарий заглушки (идиома проекта - ОМ_ar_RuntimeЦикл.ОчиститьMock):
// нетранзакционные тесты модуля (старт в фоне) держат состояние ar_LLMMock
// вне транзакции теста, очистка обязательна при любом исходе.
Процедура ОчиститьMock() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Очистка нетранзакционного теста пробуждения: гасит возможное возобновленное
// фоновое задание, удаляет служебные записи запуска и тестовые каталоги.
//
// Параметры:
//  RunId     - Строка - идентификатор запуска теста;
//  Инструмент - СправочникСсылка.ar_Инструменты - тестовая запись wait_for_event;
//  Агент     - СправочникСсылка.ar_Агенты - агент теста;
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер теста;
//  Якорь     - СправочникСсылка - тестовый объект горячего типа (якорь события).
//
Процедура УбратьДанныеПробуждения(Знач RunId, Знач Инструмент, Знач Агент,
	Знач Провайдер, Знач Якорь)

	ar_RuntimeЗапуск.Отменить(RunId);
	УдалитьДанныеЗапуска(RunId);

	Ссылки = Новый Массив;
	Ссылки.Добавить(Якорь);
	Ссылки.Добавить(Инструмент);
	Ссылки.Добавить(Агент);
	Ссылки.Добавить(Провайдер);
	УдалитьСсылки(Ссылки);

КонецПроцедуры

// Очистка нетранзакционного теста старта без агента: гасит поставленное
// фоновое задание, удаляет записи запуска и провайдера-заглушку.
//
// Параметры:
//  RunId     - Строка - идентификатор запуска теста;
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер теста.
//
Процедура УбратьДанныеБезАгента(Знач RunId, Знач Провайдер)

	ar_RuntimeЗапуск.Отменить(RunId);
	УдалитьДанныеЗапуска(RunId);

	Ссылки = Новый Массив;
	Ссылки.Добавить(Провайдер);
	УдалитьСсылки(Ссылки);

КонецПроцедуры

// Удаляет служебные записи запуска по RunId из четырех регистров расширения:
// ar_Запуски, ar_СобытияЗапуска, ar_ДействияАгента, ar_СлужебныйЛог.
// Пустой набор с отбором по ключу замещает записи - удаляет их.
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
Процедура УдалитьДанныеЗапуска(Знач RunId)

	НаборЗапуски = РегистрыСведений.ar_Запуски.СоздатьНаборЗаписей();
	НаборЗапуски.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
	НаборЗапуски.Записать(Истина);

	НаборСобытия = РегистрыСведений.ar_СобытияЗапуска.СоздатьНаборЗаписей();
	НаборСобытия.Отбор.ar_RunId.Установить(RunId);
	НаборСобытия.Записать(Истина);

	НаборДействия = РегистрыСведений.ar_ДействияАгента.СоздатьНаборЗаписей();
	НаборДействия.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
	НаборДействия.Записать(Истина);

	УдалитьЗаписиЛогаЗапуска(RunId);

КонецПроцедуры

// Удаляет записи служебного лога запуска. В ar_СлужебныйЛог измерения -
// ar_ЗаписьId и ar_Момент, а ar_RunId - ресурс: отбор набора по ресурсу не
// существует, поэтому ключи записей выбираются одним запросом по ar_RunId,
// а записи удаляются наборами с отбором по обоим измерениям.
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
Процедура УдалитьЗаписиЛогаЗапуска(Знач RunId)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Лог.ar_ЗаписьId КАК ЗаписьId,
		|	Лог.ar_Момент КАК Момент
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_RunId = &RunId");
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЛог = РегистрыСведений.ar_СлужебныйЛог.СоздатьНаборЗаписей();
		НаборЛог.Отбор.ar_ЗаписьId.Установить(Выборка.ЗаписьId);
		НаборЛог.Отбор.ar_Момент.Установить(Выборка.Момент);
		НаборЛог.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Диагностика неуспешного завершения запуска (в описании упавшего
// утверждения): события запуска (тип и код) и записи служебного лога по
// RunId - видно, на каком шаге завис или упал фоновый цикл.
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - события и записи лога через "; "; "" - записей нет.
//
Функция ДиагностикаЗапуска(Знач RunId)

	Строки = Новый Массив;
	Для Каждого Событие Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Строки.Добавить("событие " + Строка(Событие.ТипСобытия) + "/" + Событие.Код);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Лог.ar_Источник КАК Источник,
		|	Лог.ar_Событие КАК Событие,
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_RunId = &RunId
		|УПОРЯДОЧИТЬ ПО
		|	Лог.ar_Момент");
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("лог " + Выборка.Источник + "/" + Выборка.Событие + ": " + Выборка.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Строки, "; ");

КонецФункции

// Ищет стартовый запрос пользователя в сообщениях вызова LLM. Событие
// llm_called несет в payload ключ messages - промпт вызова (UI-11),
// стартовое сообщение приходит в нем user-репликой.
//
// Параметры:
//  RunId        - Строка - идентификатор запуска;
//  ТекстЗапроса - Строка - стартовый запрос пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если запрос найден в сообщениях события llm_called.
//
Функция СтартовыйЗапросВСобытиях(Знач RunId, Знач ТекстЗапроса)

	Для Каждого Событие Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Если Событие.Код <> "llm_called" Тогда
			Продолжить;
		КонецЕсли;
		Сообщения = ЗначениеPayload(ar_JSON.ИзJSON(Событие.PayloadJSON), "messages");
		Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Сообщение Из Сообщения Цикл
			Содержание = ЗначениеPayload(Сообщение, "content");
			Если ТипЗнч(Содержание) = Тип("Строка")
				И СтрНайти(Содержание, ТекстЗапроса) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Значение ключа соответствия или структуры - результат разбора JSON payload
// (ar_JSON.ИзJSON читает в соответствие; структура - на случай смены режима).
//
// Параметры:
//  Payload - Произвольный - соответствие/структура/прочее;
//  Ключ    - Строка - имя ключа.
//
// Возвращаемое значение:
//  Произвольный - значение ключа; Неопределено - нет ключа или тип не тот.
//
Функция ЗначениеPayload(Знач Payload, Знач Ключ)

	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		Возврат Payload.Получить(Ключ);
	КонецЕсли;
	Значение = Неопределено;
	Если ТипЗнч(Payload) = Тип("Структура") Тогда
		Payload.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Удаляет тестовые объекты по ссылкам. Ошибки удаления (объект занят
// параллельным заданием) пишутся в журнал регистрации и не роняют тест -
// транзакции нет, остатки идентифицируются уникальными наименованиями.
//
// Параметры:
//  Ссылки - Массив из Ссылка - тестовые объекты для удаления.
//
Процедура УдалитьСсылки(Знач Ссылки)

	Для Каждого ТекущаяСсылка Из Ссылки Цикл

		Объект = ТекущаяСсылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Объект.Удалить();
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'ОМ_ar_RuntimeЗапуск: не удален тестовый объект';
					|en = 'ОМ_ar_RuntimeЗапуск: test object deletion failed'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				ТекущаяСсылка,
				ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
