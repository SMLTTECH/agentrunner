///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_RuntimeЗапуск.
//
// Тесты управления запуском (ar_RuntimeЗапуск): СтартоватьВФоне - только
// ветки отказа до постановки фонового задания (agent_not_found_or_inactive,
// agent_already_running); Отменить - несуществующий и уже завершённый запуск
// возвращают Ложь, активный переводится в Прерван. Сам фоновый запуск не
// проверяется (сценарий 6 - только ветки отказа).
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("СтартоватьВФоне")
		.ДобавитьСерверныйТест("НеактивныйАгентНеСтартирует").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустойАгентНеСтартирует").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("УжеЗапущенныйАгентНеСтартирует").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Отмена")
		.ДобавитьСерверныйТест("НесуществующийЗапускНеОтменяется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗавершённыйЗапускНеОтменяется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПриостановленныйЗапускОтменяется").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// СтартоватьВФоне с неактивным агентом: Успех = Ложь,
// agent_not_found_or_inactive, записи запуска нет.
Процедура НеактивныйАгентНеСтартирует() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_not_found_or_inactive");

КонецПроцедуры

// СтартоватьВФоне с пустой ссылкой агента - та же ветка отказа.
Процедура ПустойАгентНеСтартирует() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(
		Справочники.ar_Агенты.ПустаяСсылка(), Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_not_found_or_inactive");

КонецПроцедуры

// СтартоватьВФоне при активном запуске агента (Выполняется): Успех = Ложь,
// agent_already_running.
Процедура УжеЗапущенныйАгентНеСтартирует() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "manual");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Контекст = Новый Структура;
	Контекст.Вставить("Триггер", "manual");
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Агент, Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("agent_already_running");

КонецПроцедуры

// Отменить несуществующий запуск: Ложь (fanтомная запись не создаётся).
Процедура НесуществующийЗапускНеОтменяется() Экспорт

	ЮТест.ОжидаетЧто(
		ar_RuntimeЗапуск.Отменить(ОМ_ar_ТестовыеДанные.НовыйRunId())).ЭтоЛожь();

КонецПроцедуры

// Отменить уже завершённый запуск: Ложь, статус не меняется.
Процедура ЗавершённыйЗапускНеОтменяется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.Отменить(RunId)).ЭтоЛожь();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.Завершён);

КонецПроцедуры

// Отменить приостановленный (ПриостановленДляПодтверждения) запуск: Истина,
// статус Прерван (факт: Отменить переводит в Прерван - см. scenarios.md 1.12).
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.12, tests.md agentrunner-27 №7): тест закрепляет текущее поведение
// «Отменить переводит приостановленный запуск в Прерван (не Отменен)»;
// ожидалось «статус Отменен». Если решат изменить поведение - поправить тест вместе с кодом.
Процедура ПриостановленныйЗапускОтменяется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ДанныеПаузы = Новый Структура;
	ДанныеПаузы.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ar_AuditЗапуски.Завершить(RunId, ДанныеПаузы);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.Отменить(RunId)).ЭтоИстина();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.Прерван);

КонецПроцедуры

#КонецОбласти
