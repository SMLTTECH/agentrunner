///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_LLMДиспетчер.
//
// Тесты диспетчера LLM (ar_LLMДиспетчер.Вызвать): валидация входа (нет
// контекста/сообщений/провайдера), отключённый провайдер, успех с первой
// попытки, переход на резервного провайдера (персональные сценарии
// ar_LLMMock у основного и резервного, модель резерва - его DefaultModel),
// объединенный текст ошибки при двойном отказе; ЭтоТранзиентнаяОшибка (0,
// 429, 5xx - транзиентные; 400 и «не реализован» - нет). Повторы с паузами
// (2/4/8/16 сек) не проверяются временем - счетчиком ПопытокСделано на
// коротком сценарии МаксПопыток = 2.
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27; персональные
// сценарии заглушки и модель резерва - задача agentrunner-29.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ВалидацияВхода")
		.ДобавитьСерверныйТест("БезКонтекстаВозвращаетсяОшибка").Тег("critical")
		.ДобавитьСерверныйТест("БезСообщенийВозвращаетсяОшибка").Тег("critical")
		.ДобавитьСерверныйТест("БезПровайдераВозвращаетсяОшибка").Тег("critical")
		.ДобавитьСерверныйТест("ОтключенныйПровайдерВозвращаетОшибку").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки");

	ЮТТесты
		.ДобавитьТестовыйНабор("ВызовыПровайдера")
		.ДобавитьСерверныйТест("УспехСПервойПопытки").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки")
		.ДобавитьСерверныйТест("ПереходНаРезервногоПровайдера").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки")
		.ДобавитьСерверныйТест("ДвойнойОтказОбъединяетОшибки").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки")
		.ДобавитьСерверныйТест("ОчисткаСценариевЗаглушки").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки");

	ЮТТесты
		.ДобавитьТестовыйНабор("Транзиентность")
		.ДобавитьСерверныйТест("КодыТранзиентныхОшибок").Тег("critical")
		.ДобавитьСерверныйТест("КодыНетранзиентныхОшибок").Тег("critical")
		.ДобавитьСерверныйТест("ПовторПриВременнойОшибкеСчитается").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарийЗаглушки");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Контекст не структура: Успех = Ложь, «Контекст не задан», провайдер не
// вызывался.
Процедура БезКонтекстаВозвращаетсяОшибка() Экспорт

	Результат = ar_LLMДиспетчер.Вызвать(Неопределено);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Ошибка").Равно("Контекст не задан")
		.Свойство("ПровайдерИтог").Равно("")
		.Свойство("ПопытокСделано").Равно(0);

КонецПроцедуры

// Сообщения отсутствуют/пусты: «Сообщения не заданы».
Процедура БезСообщенийВозвращаетсяОшибка() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Провайдер", ПровайдерЗаглушкиИзБазы());

	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Ошибка").Равно("Сообщения не заданы");

КонецПроцедуры

// Провайдер не задан: «Провайдер не задан».
Процедура БезПровайдераВозвращаетсяОшибка() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Сообщения", СообщенияПользователя());

	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("Ошибка").Равно("Провайдер не задан");

КонецПроцедуры

// Отключённый провайдер: Успех = Ложь, «Провайдер отключён: ...», без вызова.
Процедура ОтключенныйПровайдерВозвращаетОшибку() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ОбъектПровайдера = Провайдер.ПолучитьОбъект();
	ОбъектПровайдера.ar_Включён = Ложь;
	ОбъектПровайдера.Записать();

	Контекст = КонтекстВызова(Провайдер);
	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Ошибка, "Провайдер отключён") = 1).ЭтоИстина()
		.Что(Результат.ПопытокСделано).Равно(0)
		.Что(ar_LLMMock.ПолучитьСчётчикВызовов()).Равно(0);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Успех с первой попытки: ответ заглушки передан полностью, счётчик попыток 1.
Процедура УспехСПервойПопытки() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Ответ заглушки.", 12, 8));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий);

	Контекст = КонтекстВызова(Провайдер);
	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина()
		.Свойство("ПопытокСделано").Равно(1)
		.Свойство("ТокеновВход").Равно(12)
		.Свойство("ТокеновВыход").Равно(8)
		.Свойство("ПровайдерИтог").Заполнено();
	ЮТест.ОжидаетЧто(Результат.Сообщение.Свойство("content")).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Основной провайдер падает (нетранзиентная ошибка 400, одна попытка) -
// вызов уходит резервному провайдеру-заглушке с его персональным сценарием
// ar_LLMMock и тот отвечает: две попытки, каждая заглушка вызвана ровно один
// раз, резервному передана его DefaultModel, а не модель основного из контекста.
Процедура ПереходНаРезервногоПровайдера() Экспорт

	ПровайдерОшибка = ПровайдерЗаглушкиСОшибкой(400, "Недопустимый запрос основного");
	ПровайдерРезерв = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Ответ резерва."));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий, ПровайдерРезерв);

	Контекст = КонтекстВызова(ПровайдерОшибка);
	Контекст.Вставить("Модель", "модель-основного-из-контекста");
	Контекст.Вставить("ФallbackПровайдер", ПровайдерРезерв);
	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина()
		.Свойство("ПопытокСделано").Равно(2)
		.Свойство("ПровайдерИтог").Равно(СокрЛП(ПровайдерРезерв.Наименование));
	ЮТест.ОжидаетЧто(Результат.Сообщение.content).Равно("Ответ резерва.");

	// Персональные счетчики ar_LLMMock: каждая заглушка вызвана ровно один раз.
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерОшибка)).Равно(1)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерРезерв)).Равно(1);

	// Модель: основному - явная из контекста, резервному - его DefaultModel
	// ("mock-model" из НовыйПровайдерЗаглушка), а не модель основного.
	ЮТест.ОжидаетЧто(ar_LLMMock.МодельПоследнегоВызова(ПровайдерОшибка)).Равно("модель-основного-из-контекста")
		.Что(ar_LLMMock.МодельПоследнегоВызова(ПровайдерРезерв)).Равно("mock-model");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Двойной отказ (основной и резерв - свои персональные сценарии-ошибки) -
// объединенный текст ошибки содержит оба текста, суммарно две попытки,
// каждая заглушка вызвана ровно один раз.
Процедура ДвойнойОтказОбъединяетОшибки() Экспорт

	ПровайдерОшибка = ПровайдерЗаглушкиСОшибкой(400, "Основной отказал");
	ПровайдерРезерв = ПровайдерЗаглушкиСОшибкой(400, "Резерв отказал");

	Контекст = КонтекстВызова(ПровайдерОшибка);
	Контекст.Вставить("ФallbackПровайдер", ПровайдерРезерв);
	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Ошибка, "Основной отказал") > 0).ЭтоИстина()
		.Что(СтрНайти(Результат.Ошибка, "Резерв отказал") > 0).ЭтоИстина()
		.Что(Результат.ПопытокСделано).Равно(2)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерОшибка)).Равно(1)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерРезерв)).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Критерий 3 спеки agentrunner-29: тест задал сценарии двум провайдерам и
// общий, после очистки без параметра состояние чистое - счетчики всех
// очередей нулевые, очереди пусты.
Процедура ОчисткаСценариевЗаглушки() Экспорт

	ПровайдерОшибка = ПровайдерЗаглушкиСОшибкой(400, "Основной отказал");
	ПровайдерРезерв = ПровайдерЗаглушкиСОшибкой(400, "Резерв отказал");
	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Общий ответ."));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

	// Счетчики обнулены: общий и обоих провайдеров.
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки()).Равно(0)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерОшибка)).Равно(0)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерРезерв)).Равно(0);

	// Очереди пусты: любой вызов отвечает «сценарий исчерпан»; провайдерская
	// очередь после очистки недоступна - вызов уходит в общий счетчик.
	ОтветПров = ar_LLMMock.Чат(СообщенияПользователя(), Новый Структура("Провайдер", ПровайдерРезерв));
	ЮТест.ОжидаетЧто(ОтветПров.Успех).ЭтоЛожь()
		.Что(СтрНайти(ОтветПров.Ошибка, "сценарий исчерпан") > 0).ЭтоИстина()
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки()).Равно(1)
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки(ПровайдерРезерв)).Равно(0);

	ОтветОбщий = ar_LLMMock.Чат(СообщенияПользователя());
	ЮТест.ОжидаетЧто(ОтветОбщий.Успех).ЭтоЛожь()
		.Что(СтрНайти(ОтветОбщий.Ошибка, "сценарий исчерпан") > 0).ЭтоИстина()
		.Что(ОМ_ar_ТестовыеДанные.СчетчикВызововЗаглушки()).Равно(2);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// ЭтоТранзиентнаяОшибка: 0, 429, 500-599 - транзиентные.
Процедура КодыТранзиентныхОшибок() Экспорт

	ЮТест.ОжидаетЧто(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветСОшибкой(0))).ЭтоИстина()
		.Что(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветСОшибкой(429))).ЭтоИстина()
		.Что(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветСОшибкой(500))).ЭтоИстина()
		.Что(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветСОшибкой(599))).ЭтоИстина();

КонецПроцедуры

// ЭтоТранзиентнаяОшибка: 400 и «не реализован» - нет; не структура - нет.
Процедура КодыНетранзиентныхОшибок() Экспорт

	ОтветНеРеализован = ОтветСОшибкой(0);
	ОтветНеРеализован.Вставить("НеРеализован", Истина);

	ЮТест.ОжидаетЧто(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветСОшибкой(400))).ЭтоЛожь()
		.Что(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветНеРеализован)).ЭтоЛожь()
		.Что(ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(Неопределено)).ЭтоЛожь();

КонецПроцедуры

// Временная ошибка повторяется: при МаксПопыток = 2 счётчик попыток равен 2
// (исчерпанный сценарий заглушки даёт ошибку с кодом 0 - транзиентную).
Процедура ПовторПриВременнойОшибкеСчитается() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Новый Массив);

	Контекст = КонтекстВызова(Провайдер);
	Контекст.Вставить("МаксПопыток", 2);
	Результат = ar_LLMДиспетчер.Вызвать(Контекст);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь()
		.Свойство("ПопытокСделано").Равно(2)
		.Что(ar_LLMMock.ПолучитьСчётчикВызовов()).Равно(2);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Включённый провайдер-заглушка из базы (создаётся без сохранения в сценарий).
//
Функция ПровайдерЗаглушкиИзБазы()

	Возврат ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();

КонецФункции

// Провайдер-заглушка со сценарием-ошибкой заданного кода; сценарий
// назначается именно этому провайдеру (персональная очередь ar_LLMMock).
//
Функция ПровайдерЗаглушкиСОшибкой(Знач КодСостояния, Знач Текст)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветОшибка(КодСостояния, Текст));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий, Провайдер);
	Возврат Провайдер;

КонецФункции

// Очистка сценариев заглушки после теста - в том числе упавшего посередине:
// ar_LLMMock.ОчиститьСценарий() без параметра стирает общий и все
// провайдерские сценарии, счетчики и модели последнего вызова.
//
Процедура ОчиститьСценарийЗаглушки() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Базовый контекст вызова: непустые сообщения + провайдер.
//
Функция КонтекстВызова(Знач Провайдер)

	Контекст = Новый Структура;
	Контекст.Вставить("Сообщения", СообщенияПользователя());
	Контекст.Вставить("Провайдер", Провайдер);
	Возврат Контекст;

КонецФункции

// Одно user-сообщение.
//
Функция СообщенияПользователя()

	Сообщения = Новый Массив;
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), "Тестовый вопрос"));
	Возврат Сообщения;

КонецФункции

// Ответ провайдера с ошибкой заданного кода (для проверки транзиентности).
//
Функция ОтветСОшибкой(Знач КодСостояния)

	Ответ = ar_LLMКонтракт.НовыйОтвет();
	Ответ.Вставить("Ошибка", "Тестовая ошибка");
	Ответ.Вставить("КодСостояния", КодСостояния);
	Возврат Ответ;

КонецФункции

#КонецОбласти
