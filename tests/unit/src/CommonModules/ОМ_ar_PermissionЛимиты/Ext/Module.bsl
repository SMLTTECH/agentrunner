///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_PermissionЛимиты.
//
// Тесты лимитов действий (ar_PermissionЛимиты.Проверить): лимит количества
// действий (max_actions_exceeded, граничное значение «равно лимиту» - deny),
// лимит суммы действия (action_sum_exceeds_limit, граница «равно лимиту» -
// allow, сумма из аргументов amount/sum/сумма/value).
//
// Сценарии раздела 2 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Лимиты")
		.ДобавитьСерверныйТест("ПревышениеЛимитаДействийОтклоняется").Тег("critical")
		.ДобавитьСерверныйТест("ГраницаЛимитаДействийОтклоняется").Тег("critical")
		.ДобавитьСерверныйТест("ВПределеЛимитаДействийРазрешено").Тег("critical")
		.ДобавитьСерверныйТест("ПревышениеЛимитаСуммыОтклоняется").Тег("critical")
		.ДобавитьСерверныйТест("ГраницаЛимитаСуммыРазрешена").Тег("critical")
		.ДобавитьСерверныйТест("СуммаБерётсяИзДенежныхАргументов").Тег("critical")
		.ДобавитьСерверныйТест("БезЛимитовРазрешено").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Sequence меньше лимита - allow.
Процедура ВПределеЛимитаДействийРазрешено() Экспорт

	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(2, 0), ДанныеTool(), КонтекстСSequence(1), Действие());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

// Sequence, равный лимиту, отклоняется (лимит N разрешает Sequence 0..N-1).
Процедура ГраницаЛимитаДействийОтклоняется() Экспорт

	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(2, 0), ДанныеTool(), КонтекстСSequence(2), Действие());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny")
		.Свойство("Причина").Равно("max_actions_exceeded");

КонецПроцедуры

// Sequence больше лимита - deny max_actions_exceeded.
Процедура ПревышениеЛимитаДействийОтклоняется() Экспорт

	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(2, 0), ДанныеTool(), КонтекстСSequence(5), Действие());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny")
		.Свойство("Причина").Равно("max_actions_exceeded");

КонецПроцедуры

// Сумма действия больше лимита - deny action_sum_exceeds_limit.
Процедура ПревышениеЛимитаСуммыОтклоняется() Экспорт

	Действие = ДействиеССуммой(1000);
	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(0, 500), ДанныеTool(), КонтекстСSequence(0), Действие);

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny")
		.Свойство("Причина").Равно("action_sum_exceeds_limit");

КонецПроцедуры

// Сумма, равная лимиту, разрешена (сравнение строгое «больше»).
Процедура ГраницаЛимитаСуммыРазрешена() Экспорт

	Действие = ДействиеССуммой(500);
	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(0, 500), ДанныеTool(), КонтекстСSequence(0), Действие);

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

// Сумма извлекается из денежных аргументов (ключи amount/sum/сумма/value).
Процедура СуммаБерётсяИзДенежныхАргументов() Экспорт

	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(0, 100), ДанныеTool(), КонтекстСSequence(0),
		ДействиеСАргументамиНаСумму(150));

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny")
		.Свойство("Причина").Равно("action_sum_exceeds_limit");

	РешениеВПределах = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(0, 100), ДанныеTool(), КонтекстСSequence(0),
		ДействиеСАргументамиНаСумму(50));

	ЮТест.ОжидаетЧто(РешениеВПределах.Решение).Равно("allow");

КонецПроцедуры

// Лимиты не заданы (0) - проверка пропускается.
Процедура БезЛимитовРазрешено() Экспорт

	Решение = ar_PermissionЛимиты.Проверить(
		ДанныеАгентаСЛимитами(0, 0), ДанныеTool(), КонтекстСSequence(100), ДействиеССуммой(999999));

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ДанныеАгента с лимитами (0 - лимит выключен).
//
Функция ДанныеАгентаСЛимитами(Знач МаксДействий, Знач МаксСуммаДействия)

	Возврат Новый Структура("МаксДействий, МаксСуммаДействия", МаксДействий, МаксСуммаДействия);

КонецФункции

// ДанныеTool - в логике лимитов не используются, достаточно пустой структуры.
//
Функция ДанныеTool()

	Возврат Новый Структура;

КонецФункции

// Контекст запуска с номером действия.
//
Функция КонтекстСSequence(Знач Sequence)

	Возврат Новый Структура("Sequence", Sequence);

КонецФункции

// Действие без аргументов.
//
Функция Действие()

	Возврат Новый Структура("Имя", "тест_инструмент");

КонецФункции

// Действие с JSON-аргументами, содержащими сумму.
//
Функция ДействиеСАргументамиНаСумму(Знач Сумма)

	Действие = Новый Структура("Имя, Аргументы", "тест_инструмент",
		"{""amount"": " + Формат(Сумма, "ЧГ=0") + "}");
	Возврат Действие;

КонецФункции

// Действие с суммой в обёртке (как движок передаёт в лимиты).
//
Функция ДействиеССуммой(Знач Сумма)

	Возврат ДействиеСАргументамиНаСумму(Сумма);

КонецФункции

#КонецОбласти
