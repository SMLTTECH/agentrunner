///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Хуки.
//
// Тесты безотказности вызова хуков (ar_Хуки.Вызвать, план «ТЕСТЫ: расширение
// покрытия ядра», раздел 3.5): ошибка хука не прерывает вызов и цикл агента
// (событие аудита ОшибкаХука), порядок по приоритету, сигнал Прервать,
// выключенный хук не вызывается.
//
// Хуки - типа «Код» (ar_ТипОбработчика = "Код"): код выполняется диспетчером
// ar_ДиспетчерХуков в безопасном режиме и видит переменные КонтекстСобытия и
// Результат. След вызовов копится в поле КонтекстСобытия.След. Хуки стенда на
// время теста выключаются (в транзакции теста, откат вернёт их).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Безотказность хуков")
		.ДобавитьСерверныйТест("ХукСИсключениемНеЛомаетВызов").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ХукиПорядокИСобытие").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ХукПрерываетЦепочку").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтключённыйХукНеВызывается").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЦиклАгентаСПадающимХуком").Тег("critical").ВТранзакции()
			.После("ОчиститьСценарий");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Очистка сценария заглушки LLM после теста с циклом агента.
Процедура ОчиститьСценарий() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// Хук с исключением (приоритет 10) не прерывает вызов: следующий хук
// (приоритет 20) выполнен, управление вернулось, у запуска событие аудита
// ОшибкаХука с именем хука в payload.
Процедура ХукСИсключениемНеЛомаетВызов() Экспорт

	ВыключитьХукиСтенда();
	ИдЗапуска = ОМ_ar_ТестовыеДанные.СоздатьЗапуск(ОМ_ar_ТестовыеДанные.НовыйRunId(), Неопределено);

	Событие = Перечисления.ar_СобытиеХука.ПередШагом;
	ХукОшибка = НовыйХук(Событие, "ВызватьИсключение ""Тестовая ошибка хука"";", 10);
	НовыйХук(Событие, КодДописатьСлед("Б"), 20);

	Контекст = НовыйКонтекст(ИдЗапуска);
	ar_Хуки.Вызвать(Событие, Контекст);

	ЮТест.ОжидаетЧто(Контекст.След, "след вызовов").Равно("Б");
	ЮТест.ОжидаетЧто(Контекст.Свойство("Прервать"), "цепочка не прервана").ЭтоЛожь();

	СобытияОшибки = ОМ_ar_ТестовыеДанные.СобытияЗапуска(ИдЗапуска).НайтиСтроки(
		Новый Структура("ТипСобытия", Перечисления.ar_ТипСобытия.ОшибкаХука));
	ЮТест.ОжидаетЧто(СобытияОшибки.Количество(), "событий ОшибкаХука").Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(СобытияОшибки[0].PayloadJSON, "code:" + Строка(ХукОшибка)) > 0,
		"в payload имя хука").ЭтоИстина();

КонецПроцедуры

// Вызываются только хуки своего события, по возрастанию приоритета (хуки
// записаны в обратном порядке). Поле Событие дописывается в контекст.
Процедура ХукиПорядокИСобытие() Экспорт

	ВыключитьХукиСтенда();

	Событие = Перечисления.ar_СобытиеХука.ПослеШага;
	НовыйХук(Событие, КодДописатьСлед("3"), 30);
	НовыйХук(Перечисления.ar_СобытиеХука.ПередШагом, КодДописатьСлед("Ч"), 15);
	НовыйХук(Событие, КодДописатьСлед("2"), 20);
	НовыйХук(Событие, КодДописатьСлед("1"), 10);

	Контекст = НовыйКонтекст("");
	ar_Хуки.Вызвать(Событие, Контекст);

	ЮТест.ОжидаетЧто(Контекст.След, "след вызовов по приоритету").Равно("123");
	ЮТест.ОжидаетЧто(Контекст.Событие, "событие в контексте").Равно(Событие);

КонецПроцедуры

// Хук вернул Прервать: следующие хуки не вызваны, КонтекстСобытия.Прервать = Истина.
Процедура ХукПрерываетЦепочку() Экспорт

	ВыключитьХукиСтенда();

	Событие = Перечисления.ar_СобытиеХука.ПередВызовомИнструмента;
	НовыйХук(Событие, КодДописатьСлед("1"), 10);
	НовыйХук(Событие, КодДописатьСлед("2") + Символы.ПС + "Результат.Прервать = Истина;", 20);
	НовыйХук(Событие, КодДописатьСлед("3"), 30);

	Контекст = НовыйКонтекст("");
	ar_Хуки.Вызвать(Событие, Контекст);

	ЮТест.ОжидаетЧто(Контекст.След, "след вызовов").Равно("12");
	ЮТест.ОжидаетЧто(Контекст.Свойство("Прервать") И Контекст.Прервать = Истина,
		"признак Прервать в контексте").ЭтоИстина();

КонецПроцедуры

// Выключенный хук и хук, помеченный на удаление, не вызываются.
Процедура ОтключённыйХукНеВызывается() Экспорт

	ВыключитьХукиСтенда();

	Событие = Перечисления.ar_СобытиеХука.ПослеВызоваLLM;
	НовыйХук(Событие, КодДописатьСлед("1"), 10);
	НовыйХук(Событие, КодДописатьСлед("В"), 20, Ложь);
	Помеченный = НовыйХук(Событие, КодДописатьСлед("П"), 30);
	ОбъектХука = Помеченный.ПолучитьОбъект();
	ОбъектХука.УстановитьПометкуУдаления(Истина);

	Контекст = НовыйКонтекст("");
	ar_Хуки.Вызвать(Событие, Контекст);

	ЮТест.ОжидаетЧто(Контекст.След, "след вызовов").Равно("1");

КонецПроцедуры

// Цикл агента с хуком «перед шагом», который выбрасывает исключение: запуск
// завершается статусом Завершён (не ОшибкаВыполнения), ошибка хука - событием
// аудита ОшибкаХука запуска.
Процедура ЦиклАгентаСПадающимХуком() Экспорт

	ВыключитьХукиСтенда();
	НовыйХук(Перечисления.ar_СобытиеХука.ПередШагом, "ВызватьИсключение ""Тестовая ошибка хука"";", 10);

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ИдЗапуска = ОМ_ar_ТестовыеДанные.СоздатьЗапуск(ОМ_ar_ТестовыеДанные.НовыйRunId(), Агент);

	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Отчёт готов."));
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий);

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Агент, ИдЗапуска);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(ИдЗапуска);
	ЮТест.ОжидаетЧто(Запуск.Статус, "статус запуска; " + ОМ_ar_ТестовыеДанные.СледСлужебногоЛога(ИдЗапуска))
		.Равно(Перечисления.ar_СтатусЗапуска.Завершён);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СобытияЗапуска(ИдЗапуска).НайтиСтроки(
		Новый Структура("ТипСобытия", Перечисления.ar_ТипСобытия.ОшибкаХука)).Количество() > 0,
		"событие ОшибкаХука у запуска").ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт включённый хук типа «Код».
//
// Параметры:
//  Событие   - ПеречислениеСсылка.ar_СобытиеХука;
//  Код       - Строка - код обработчика (выполняется в безопасном режиме);
//  Приоритет - Число;
//  Включён   - Булево.
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Хуки.
//
Функция НовыйХук(Знач Событие, Знач Код, Знач Приоритет, Знач Включён = Истина)

	Хук = Справочники.ar_Хуки.СоздатьЭлемент();
	Хук.Наименование = "ТестХук_" + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	Хук.ar_Событие = Событие;
	Хук.ar_ТипОбработчика = "Код";
	Хук.ar_КодОбработчика = Код;
	Хук.ar_Приоритет = Приоритет;
	Хук.ar_Включён = Включён;
	Хук.Записать();

	Возврат Хук.Ссылка;

КонецФункции

// Код хука, дописывающий метку в поле След контекста события.
//
// Параметры:
//  Метка - Строка.
//
// Возвращаемое значение:
//  Строка - код 1С.
//
Функция КодДописатьСлед(Знач Метка)

	Возврат СтрШаблон("КонтекстСобытия.Вставить(""След"", КонтекстСобытия.След + ""%1"");", Метка);

КонецФункции

// Контекст события хука с пустым следом.
//
// Параметры:
//  ИдЗапуска - Строка - идентификатор запуска для аудита (пусто - без запуска).
//
// Возвращаемое значение:
//  Структура - {ИдЗапуска, След}.
//
Функция НовыйКонтекст(Знач ИдЗапуска)

	Возврат Новый Структура("ИдЗапуска, След", ИдЗапуска, "");

КонецФункции

// Выключает все включённые хуки стенда (в транзакции теста - откат вернёт их):
// тест видит только свои хуки.
Процедура ВыключитьХукиСтенда()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Хуки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Хуки КАК Хуки
		|ГДЕ
		|	Хуки.ar_Включён = ИСТИНА");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектХука = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектХука.ar_Включён = Ложь;
		ОбъектХука.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
