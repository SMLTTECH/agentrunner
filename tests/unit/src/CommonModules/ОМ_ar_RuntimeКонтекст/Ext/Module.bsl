///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_RuntimeКонтекст.
//
// Тесты сборки контекста (ar_RuntimeКонтекст): ПостроитьКонтекст - в контексте
// есть инструкция агента (внутри system-сообщения), определения только
// доступных инструментов, признак компакции; MaxContextПровайдера -
// значение ar_MaxContext провайдера.
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Контекст")
		.ДобавитьСерверныйТест("ИнструкцияАгентаВСистемномСообщении").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОпределенияДоступныхИнструментов").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПризнакКомпакцииБезКомпакции").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("MaxContextПровайдераИзРеестра").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("MaxContextПустогоПровайдераНоль").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инструкция агента попадает в текст system-сообщения контекста.
Процедура ИнструкцияАгентаВСистемномСообщении() Экспорт

	Подготовка = ПодготовитьДанные("Уникальная тестовая инструкция агента.");

	Контекст = ar_RuntimeКонтекст.ПостроитьКонтекст(
		Подготовка.Состояние, Подготовка.ДанныеАгента);

	ЮТест.ОжидаетЧто(Контекст.messages.Количество()).Больше(0);
	Первое = Контекст.messages[0];
	ЮТест.ОжидаетЧто(Первое.role).Равно("system");
	ЮТест.ОжидаетЧто(СтрНайти(Первое.content, "Уникальная тестовая инструкция агента.") > 0).ЭтоИстина();

КонецПроцедуры

// tool_definitions содержит определения только доступных агенту инструментов.
Процедура ОпределенияДоступныхИнструментов() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_доступный",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_запретный",
		Перечисления.ar_УровеньРиска.Чтение);

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("тест_инструмент_доступный"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	Состояние = ТестовоеСостояние();

	Контекст = ar_RuntimeКонтекст.ПостроитьКонтекст(Состояние, ДанныеАгентаПоСсылке(Агент));

	ЮТест.ОжидаетЧто(Контекст.tool_definitions.Количество()).Равно(1);
	Определение = Контекст.tool_definitions[0];
	ЮТест.ОжидаетЧто(СтрНайти(Строка(Определение.Получить("name")), "тест_инструмент_доступный") > 0).ЭтоИстина();

КонецПроцедуры

// Признак компакции: при заведомо малом контексте БылаКомпакция = Ложь,
// ТипКомпакции = "none".
Процедура ПризнакКомпакцииБезКомпакции() Экспорт

	Подготовка = ПодготовитьДанные("");

	Контекст = ar_RuntimeКонтекст.ПостроитьКонтекст(
		Подготовка.Состояние, Подготовка.ДанныеАгента);

	ЮТест.ОжидаетЧто(Контекст).Свойство("БылаКомпакция").ЭтоЛожь()
		.Свойство("ТипКомпакции").Равно("none")
		.Свойство("ОценкаТокенов").Больше(0);

КонецПроцедуры

// MaxContextПровайдера возвращает ar_MaxContext провайдера агента.
Процедура MaxContextПровайдераИзРеестра() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка(123456);
	ДанныеАгента = ДанныеАгентаПоСсылке(ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер));

	ЮТест.ОжидаетЧто(ar_RuntimeКонтекст.MaxContextПровайдера(ДанныеАгента)).Равно(123456);

КонецПроцедуры

// MaxContextПровайдера для пустого провайдера - 0.
Процедура MaxContextПустогоПровайдераНоль() Экспорт

	ДанныеАгента = ДанныеАгентаПоСсылке(Справочники.ar_Агенты.ПустаяСсылка());
	ДанныеАгента.LLMПровайдер = Справочники.ar_LLMПровайдеры.ПустаяСсылка();

	ЮТест.ОжидаетЧто(ar_RuntimeКонтекст.MaxContextПровайдера(ДанныеАгента)).Равно(0)
		.Что(ar_RuntimeКонтекст.MaxContextПровайдера(Неопределено)).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт провайдера, агента и тестовое состояние цикла.
//
Функция ПодготовитьДанные(Знач Инструкция)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("Инструкция", Инструкция);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Подготовка = Новый Структура;
	Подготовка.Вставить("Состояние", ТестовоеСостояние());
	Подготовка.Вставить("ДанныеАгента", ДанныеАгентаПоСсылке(Агент));
	Возврат Подготовка;

КонецФункции

// Тестовое состояние цикла (состав ключей - как НовоеСостояние ar_RuntimeЦикл).
//
Функция ТестовоеСостояние()

	Состояние = Новый Структура;
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), "Тестовый запрос"));
	Состояние.Вставить("ШаговВсего", 0);
	Состояние.Вставить("ДействийВсего", 0);
	Состояние.Вставить("ОжидаютApproval", 0);
	Состояние.Вставить("ОжидаютInput", 0);
	Состояние.Вставить("Результат", "");
	Состояние.Вставить("RunId", ОМ_ar_ТестовыеДанные.НовыйRunId());
	Состояние.Вставить("ТокеновВход", 0);
	Состояние.Вставить("ТокеновВыход", 0);
	Состояние.Вставить("DryRun", Ложь);
	Состояние.Вставить("ПользовательUUID", "");
	Состояние.Вставить("ПодгруженныеTools", Новый Массив);
	Состояние.Вставить("План", ar_ПланЗапуска.НовыйПлан());
	Состояние.Вставить("ИнструкцияДобавка", "");
	Состояние.Вставить("ФактОбластиДанных", "");
	Возврат Состояние;

КонецФункции

// ДанныеАгента по ссылке (состав ключей - как ПрочитатьДанныеАгента цикла).
//
Функция ДанныеАгентаПоСсылке(Знач Агент)

	ДанныеАгента = Новый Структура;
	ДанныеАгента.Вставить("Ссылка", Агент);
	ДанныеАгента.Вставить("Наименование", "ТестАгент");
	ДанныеАгента.Вставить("ИмяРоли1С", "");
	ДанныеАгента.Вставить("LLMПровайдер", Справочники.ar_LLMПровайдеры.ПустаяСсылка());
	ДанныеАгента.Вставить("Модель", "mock-model");
	ДанныеАгента.Вставить("Температура", 0.2);
	ДанныеАгента.Вставить("МаксШагов", 5);
	ДанныеАгента.Вставить("МаксДействий", 5);
	ДанныеАгента.Вставить("МаксСуммаДействия", 0);
	ДанныеАгента.Вставить("РежимАвтономии", Перечисления.ar_РежимАвтономии.Ручной);
	ДанныеАгента.Вставить("ИспользоватьСессии", Ложь);
	ДанныеАгента.Вставить("ПланироватьРаботу", Ложь);
	ДанныеАгента.Вставить("ПунктыШаблонаПлана", Новый Массив);
	ДанныеАгента.Вставить("Инструкция", "Тестовая инструкция агента.");

	Если ТипЗнч(Агент) = Тип("СправочникСсылка.ar_Агенты") И ЗначениеЗаполнено(Агент) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Агенты.ar_LLMПровайдер КАК Провайдер,
			|	Агенты.ar_Инструкция КАК Инструкция
			|ИЗ
			|	Справочник.ar_Агенты КАК Агенты
			|ГДЕ
			|	Агенты.Ссылка = &Агент");
		Запрос.УстановитьПараметр("Агент", Агент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДанныеАгента.LLMПровайдер = Выборка.Провайдер;
			ДанныеАгента.Инструкция = Выборка.Инструкция;
		КонецЕсли;
	КонецЕсли;

	Возврат ДанныеАгента;

КонецФункции

// Массив из одной строки.
//
Функция МассивСтрок(Знач Строка1)

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Возврат Массив;

КонецФункции

#КонецОбласти
