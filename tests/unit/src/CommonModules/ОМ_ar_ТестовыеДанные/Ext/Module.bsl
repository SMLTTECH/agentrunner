///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ТестовыеДанные.
//
// Общая тестовая оснастка для модульных тестов AgentRunner (ar_*):
// построители тестовых данных (провайдер-заглушка, агент, инструмент,
// запись запуска) и чтение результата прогона (статус запуска, события,
// действия, очередь подтверждений). Тестовый набор НЕ содержит - без
// ИсполняемыеСценарии.
//
// Все данные создаются вызывающим тестом в его транзакции
// (регистрация теста с .ВТранзакции()) и откатываются движком.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создаёт включённого провайдера LLM типа «Заглушка» - его обслуживает
// ar_LLMMock (детерминированные ответы без сети).
//
// Параметры:
//  MaxContext - Число - значение реквизита ar_MaxContext провайдера
//             (используется ar_RuntimeКонтекст.MaxContextПровайдера).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_LLMПровайдеры - созданный провайдер.
//
Функция НовыйПровайдерЗаглушка(Знач MaxContext = 100000) Экспорт

	Провайдер = Справочники.ar_LLMПровайдеры.СоздатьЭлемент();
	Провайдер.Наименование = "ТестЗаглушка_" + УникальнаяСтрока();
	Провайдер.ar_Тип = Перечисления.ar_ТипПровайдера.Заглушка;
	Провайдер.ar_Включён = Истина;
	Провайдер.ar_ПоддерживаетВызовыИнструментов = Истина;
	Провайдер.ar_DefaultModel = "mock-model";
	Провайдер.ar_MaxContext = MaxContext;
	Провайдер.Записать();

	Возврат Провайдер.Ссылка;

КонецФункции

// Создаёт агента (по умолчанию активного) с заданным провайдером.
//
// Параметры:
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер агента.
//  Параметры - Структура - необязательные переопределения:
//    * РежимАвтономии        - ПеречислениеСсылка.ar_РежимАвтономии - по умолчанию Ручной;
//    * МаксШагов             - Число - по умолчанию 5;
//    * МаксДействий          - Число - по умолчанию 5;
//    * МаксСуммаДействия     - Число - по умолчанию 0 (лимит суммы выключен);
//    * Активен               - Булево - по умолчанию Истина;
//    * Инструкция            - Строка;
//    * ПланироватьРаботу     - Булево - по умолчанию Ложь;
//    * ИмяРоли1С             - Строка - по умолчанию "" (ролевой контроль отключён);
//    * ДоступныеИнструменты  - Массив из Строка - явный белый список имён tool
//      (заполняет ТЧ ar_ДоступныеИнструменты; пустой массив = весь реестр).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты - созданный агент.
//
Функция НовыйАгент(Знач Провайдер, Знач Параметры = Неопределено) Экспорт

	Режим = Перечисления.ar_РежимАвтономии.Ручной;
	МаксШагов = 5;
	МаксДействий = 5;
	МаксСумма = 0;
	Активен = Истина;
	Инструкция = "Тестовая инструкция агента.";
	ПланироватьРаботу = Ложь;
	ИмяРоли = "";
	СписокИнструментов = Новый Массив;

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Режим = ЗначениеПараметра(Параметры, "РежимАвтономии", Режим);
		МаксШагов = ЗначениеПараметра(Параметры, "МаксШагов", МаксШагов);
		МаксДействий = ЗначениеПараметра(Параметры, "МаксДействий", МаксДействий);
		МаксСумма = ЗначениеПараметра(Параметры, "МаксСуммаДействия", МаксСумма);
		Активен = ЗначениеПараметра(Параметры, "Активен", Активен);
		Инструкция = ЗначениеПараметра(Параметры, "Инструкция", Инструкция);
		ПланироватьРаботу = ЗначениеПараметра(Параметры, "ПланироватьРаботу", ПланироватьРаботу);
		ИмяРоли = ЗначениеПараметра(Параметры, "ИмяРоли1С", ИмяРоли);
		СписокИнструментов = ЗначениеПараметра(Параметры, "ДоступныеИнструменты", СписокИнструментов);
	КонецЕсли;

	Агент = Справочники.ar_Агенты.СоздатьЭлемент();
	Агент.Наименование = "ТестАгент_" + УникальнаяСтрока();
	Агент.ar_LLMПровайдер = Провайдер;
	Агент.ar_РежимАвтономии = Режим;
	Агент.ar_МаксШагов = МаксШагов;
	Агент.ar_МаксДействий = МаксДействий;
	Агент.ar_МаксСуммаДействия = МаксСумма;
	Агент.ar_Активен = Активен;
	Агент.ar_Инструкция = Инструкция;
	Агент.ar_ПланироватьРаботу = ПланироватьРаботу;
	Агент.ar_ИмяРоли1С = ИмяРоли;

	Для Каждого ИмяTool Из СписокИнструментов Цикл
		СтрокаСписка = Агент.ar_ДоступныеИнструменты.Добавить();
		СтрокаСписка.ar_Инструмент = ИмяTool;
		СтрокаСписка.ar_Включен = Истина;
	КонецЦикла;

	Агент.Записать();

	Возврат Агент.Ссылка;

КонецФункции

// Создаёт включённый инструмент в реестре ar_Инструменты.
//
// Параметры:
//  Имя             - Строка - имя tool (ar_Имя, snake_case);
//  УровеньРиска    - ПеречислениеСсылка.ar_УровеньРиска - уровень риска;
//  ТребуетApproval - Булево - флаг обязательного подтверждения;
//  ОбщийМодуль     - Строка - имя модуля реализации (по умолчанию
//                    ar_ИнструментыУниверсальный - ядровой диспетчер).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Инструменты - созданный инструмент.
//
Функция НовыйИнструмент(Знач Имя, Знач УровеньРиска, Знач ТребуетApproval = Ложь,
	Знач ОбщийМодуль = "ar_ИнструментыУниверсальный") Экспорт

	Tool = Справочники.ar_Инструменты.СоздатьЭлемент();
	Tool.Наименование = Имя;
	Tool.ar_Имя = Имя;
	Tool.ar_Представление = Имя;
	Tool.ar_Описание = "Тестовый инструмент " + Имя;
	Tool.ar_RiskLevel = УровеньРиска;
	Tool.ar_ТребуетApproval = ТребуетApproval;
	Tool.ar_Включён = Истина;
	Tool.ar_Доступен = Истина;
	Tool.ar_ОбщийМодуль = ОбщийМодуль;
	Tool.ar_ИмяПроцедуры = "СписокКонстант";
	Tool.ar_JSONManifest = "{""name"":""" + Имя + """,""description"":""тестовый инструмент""}";
	Tool.Записать();

	Возврат Tool.Ссылка;

КонецФункции

// Генерирует уникальный идентификатор запуска (Строка(36) - UUID).
//
// Возвращаемое значение:
//  Строка - новый RunId.
//
Функция НовыйRunId() Экспорт

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Создаёт запись запуска в ar_Запуски через штатный ar_AuditЗапуски.Создать.
//
// Параметры:
//  RunId   - Строка - идентификатор запуска;
//  Агент   - СправочникСсылка.ar_Агенты - агент запуска (допустима пустая);
//  Триггер - Строка - триггер запуска (по умолчанию "manual").
//
// Возвращаемое значение:
//  Строка - тот же RunId (для цепочек вызовов).
//
Функция СоздатьЗапуск(Знач RunId, Знач Агент, Знач Триггер = "manual") Экспорт

	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Создан);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", Триггер);
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Возврат RunId;

КонецФункции

// Строит элемент сценария ar_LLMMock: финальный текстовый ответ.
//
// Параметры:
//  Содержание   - Строка - текст ответа ассистента;
//  ТокеновВход  - Число  - имитируемые токены входа;
//  ТокеновВыход - Число  - имитируемые токены выхода.
//
// Возвращаемое значение:
//  Структура - элемент сценария {ТипОтвета:"text", ...}.
//
Функция ОтветТекст(Знач Содержание, Знач ТокеновВход = 10, Знач ТокеновВыход = 10) Экспорт

	Возврат Новый Структура("ТипОтвета, Содержание, ТокеновВход, ТокеновВыход",
		"text", Содержание, ТокеновВход, ТокеновВыход);

КонецФункции

// Строит элемент сценария ar_LLMMock: промежуточный вызов инструмента.
//
// Параметры:
//  ИмяTool       - Строка - имя tool;
//  АргументыJSON - Строка - JSON-аргументы вызова;
//  ИдВызова      - Строка - tool_call_id (по умолчанию "call_1").
//
// Возвращаемое значение:
//  Структура - элемент сценария {ТипОтвета:"tool_call", ...}.
//
Функция ОтветToolCall(Знач ИмяTool, Знач АргументыJSON, Знач ИдВызова = "call_1") Экспорт

	Возврат Новый Структура("ТипОтвета, ИмяTool, АргументыJSON, ToolCallId",
		"tool_call", ИмяTool, АргументыJSON, ИдВызова);

КонецФункции

// Строит элемент сценария ar_LLMMock: ошибка провайдера.
//
// Параметры:
//  КодСостояния - Число  - HTTP-код состояния (400 - нетранзиентная, 0/429/5xx - транзиентная);
//  Текст        - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Структура - элемент сценария {ТипОтвета:"error", ...}.
//
Функция ОтветОшибка(Знач КодСостояния, Знач Текст = "Ошибка теста") Экспорт

	Возврат Новый Структура("ТипОтвета, КодСостояния, Ошибка",
		"error", КодСостояния, Текст);

КонецФункции

// Готовый JSON-вердикт надзора: {"class":"выполнено"} - ar_Надзор разбирает
// его как "ЦельДостигнута", цикл завершается без продолжений.
//
// Возвращаемое значение:
//  Строка - содержимое вердикта.
//
Функция ВердиктВыполнено() Экспорт

	Возврат "{""class"": ""выполнено""}";

КонецФункции

// Устанавливает сценарий заглушки из массива ответов (обёртка ar_LLMMock).
//
// Параметры:
//  Сценарий  - Массив - очередь элементов из ОтветТекст/ОтветToolCall/ОтветОшибка.
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - провайдер
//              персонального сценария; без провайдера — общий сценарий.
//
Процедура УстановитьСценарий(Знач Сценарий, Знач Провайдер = Неопределено) Экспорт

	ar_LLMMock.УстановитьСценарий(Сценарий, Провайдер);

КонецПроцедуры

// Очищает сценарий заглушки (обёртка ar_LLMMock.ОчиститьСценарий):
// общий и все провайдерские сценарии, счётчики и модели последнего вызова.
// Вызывается в конце каждого теста и в .После-обработчиках.
Процедура ОчиститьСценарий() Экспорт

	ar_LLMMock.ОчиститьСценарий();

КонецПроцедуры

// Число вызовов Чат() заглушки с момента последней установки/очистки
// сценария (обёртка ar_LLMMock.ПолучитьСчётчикВызовов).
//
// Параметры:
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - счётчик
//              персонального сценария провайдера; без параметра — общий.
//
// Возвращаемое значение:
//  Число - количество вызовов (>= 0).
//
Функция СчётчикВызововЗаглушки(Знач Провайдер = Неопределено) Экспорт

	Возврат ar_LLMMock.ПолучитьСчётчикВызовов(Провайдер);

КонецФункции

// Запускает агентный цикл напрямую (синхронно) - НЕ через СтартоватьВФоне:
// фоновое задание не видит данные незавершённой транзакции теста.
//
// Параметры:
//  Агент            - СправочникСсылка.ar_Агенты;
//  RunId            - Строка;
//  КонтекстТриггера - Структура - {Триггер, Снимок, DryRun, ...}.
//
Процедура ЗапуститьЦикл(Знач Агент, Знач RunId, Знач КонтекстТриггера = Неопределено) Экспорт

	Если КонтекстТриггера = Неопределено Тогда
		КонтекстТриггера = Новый Структура;
		КонтекстТриггера.Вставить("Триггер", "manual");
	КонецЕсли;
	ar_RuntimeЦикл.ВыполнитьАгента(Агент, RunId, КонтекстТриггера);

КонецПроцедуры

// Читает запись запуска из ar_Запуски.
//
// Возвращаемое значение:
//  Структура - {Найден, Статус, ОтветLLM, ШаговВсего, ТокеновВход, ТокеновВыход,
//               Триггер, СтартовалВ, ЗавершенВ, ПоследнийПульс, ПопытокВозобновления,
//               ПродолженийСделано, ОтпечатокШага, СнимокЕсть} или {Найден:Ложь}.
//
Функция ЗапускПоИд(Знач RunId) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Статус", Неопределено);
	Результат.Вставить("ОтветLLM", "");
	Результат.Вставить("ШаговВсего", 0);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Триггер", "");
	Результат.Вставить("СтартовалВ", '00010101');
	Результат.Вставить("ЗавершенВ", '00010101');
	Результат.Вставить("ПоследнийПульс", '00010101');
	Результат.Вставить("ПопытокВозобновления", 0);
	Результат.Вставить("ПродолженийСделано", 0);
	Результат.Вставить("ОтпечатокШага", "");
	Результат.Вставить("СнимокЕсть", Ложь);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Запуски.ar_Статус КАК Статус,
		|	Запуски.ar_ОтветLLM КАК ОтветLLM,
		|	Запуски.ar_ШаговВсего КАК ШаговВсего,
		|	Запуски.ar_ТокеновВход КАК ТокеновВход,
		|	Запуски.ar_ТокеновВыход КАК ТокеновВыход,
		|	Запуски.ar_Триггер КАК Триггер,
		|	Запуски.ar_СтартовалВ КАК СтартовалВ,
		|	Запуски.ar_ЗавершенВ КАК ЗавершенВ,
		|	Запуски.ar_ПоследнийПульс КАК ПоследнийПульс,
		|	Запуски.ar_ПопытокВозобновления КАК ПопытокВозобновления,
		|	Запуски.ar_ПродолженийСделано КАК ПродолженийСделано,
		|	Запуски.ar_ОтпечатокШага КАК ОтпечатокШага,
		|	ВЫБОР КОГДА Запуски.ar_StateSnapshot ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК СнимокЕсть
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId");
	Запрос.УстановитьПараметр("RunId", RunId);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найден = Истина;
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает события запуска из ar_СобытияЗапуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ТипСобытия, Код (из payload "code"), PayloadJSON, Sequence.
//
Функция СобытияЗапуска(Знач RunId) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	События.ar_ТипСобытия КАК ТипСобытия,
		|	События.ar_PayloadJSON КАК PayloadJSON,
		|	События.ar_Sequence КАК Sequence
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|ГДЕ
		|	События.ar_RunId = &RunId
		|УПОРЯДОЧИТЬ ПО
		|	События.ar_Sequence");
	Запрос.УстановитьПараметр("RunId", RunId);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ТипСобытия");
	Таблица.Колонки.Добавить("Код");
	Таблица.Колонки.Добавить("PayloadJSON");
	Таблица.Колонки.Добавить("Sequence");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		Строка.ТипСобытия = Выборка.ТипСобытия;
		Строка.PayloadJSON = Выборка.PayloadJSON;
		Строка.Sequence = Выборка.Sequence;
		Строка.Код = КодИзPayload(Выборка.PayloadJSON);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Проверяет наличие события с машиночитаемым кодом (payload "code").
//
// Параметры:
//  RunId - Строка;  Код - Строка - например "run_completed".
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьСобытиеСКодом(Знач RunId, Знач Код) Экспорт

	Возврат СобытияЗапуска(RunId).НайтиСтроки(Новый Структура("Код", Код)).Количество() > 0;

КонецФункции

// Читает действия агента из ar_ДействияАгента.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ИмяИнструмента, АргументыJSON, УровеньРиска,
//  СсылкаНаРезультат, ДлительностьМС, ЗавершёнСОшибкой, Последовательность.
//
Функция ДействияЗапуска(Знач RunId) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Действия.ar_ИмяИнструмента КАК ИмяИнструмента,
		|	Действия.ar_АргументыJSON КАК АргументыJSON,
		|	Действия.ar_УровеньРиска КАК УровеньРиска,
		|	Действия.ar_СсылкаНаРезультат КАК СсылкаНаРезультат,
		|	Действия.ar_ДлительностьМС КАК ДлительностьМС,
		|	Действия.ar_ЗавершёнСОшибкой КАК ЗавершёнСОшибкой,
		|	Действия.ar_Последовательность КАК Последовательность
		|ИЗ
		|	РегистрСведений.ar_ДействияАгента КАК Действия
		|ГДЕ
		|	Действия.ar_ИдентификаторЗапуска = &RunId
		|УПОРЯДОЧИТЬ ПО
		|	Действия.ar_Последовательность");
	Запрос.УстановитьПараметр("RunId", RunId);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Читает записи очереди подтверждений (одного запуска или все).
//
// Параметры:
//  RunId - Строка - идентификатор запуска; пусто - все записи.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ApprovalId, Статус, RunId, IdempotencyKey,
//  ActionPayloadJSON, СозданоВ, РешеноВ.
//
Функция ЗаписиОчереди(Знач RunId = "") Экспорт

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Очередь.ar_ApprovalId КАК ApprovalId,
		|	Очередь.ar_Статус КАК Статус,
		|	Очередь.ar_RunId КАК RunId,
		|	Очередь.ar_IdempotencyKey КАК IdempotencyKey,
		|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON,
		|	Очередь.ar_СозданоВ КАК СозданоВ,
		|	Очередь.ar_РешеноВ КАК РешеноВ
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь";
	Если Не ПустаяСтрока(RunId) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	Очередь.ar_RunId = &RunId";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_СозданоВ";

	Запрос = Новый Запрос(ТекстЗапроса);
	Если Не ПустаяСтрока(RunId) Тогда
		Запрос.УстановитьПараметр("RunId", RunId);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает статус записи очереди подтверждений по ApprovalId
// (обёртка ar_Подтверждение.СтатусЗаписиОчередиБезПривилегий).
//
// Возвращаемое значение:
//  Строка - "pending"/"approved"/"rejected"/"expired"/"executed"/"cancelled"/
//  "awaiting_input"/"answered" или "" - запись не найдена.
//
Функция СтатусОчереди(Знач ApprovalId) Экспорт

	Возврат ar_Подтверждение.СтатусЗаписиОчередиБезПривилегий(ApprovalId);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает машиночитаемый код события ("code") из JSON-полезной нагрузки.
//
Функция КодИзPayload(Знач PayloadJSON)

	Значение = ar_JSON.ИзJSON(PayloadJSON);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Код = "";
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Код = Строка(Значение.Получить("code"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение.Свойство("code", Код);
	КонецЕсли;
	Возврат Код;

КонецФункции

// Уникальный суффикс для имён тестовых данных.
//
Функция УникальнаяСтрока()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");

КонецФункции

#КонецОбласти

// Безопасное чтение параметра структуры: Свойство(Ключ, Перем) на 8.3.27
// затирает Перем значением Неопределено, когда ключа нет, поэтому дефолты
// читаются через явную проверку наличия ключа.
//
// Параметры:
//  Параметры - Структура - источник;
//  Ключ - Строка - имя параметра;
//  ПоУмолчанию - Произвольный - значение при отсутствии ключа.
//
// Возвращаемое значение:
//  Произвольный - значение параметра или ПоУмолчанию.
//
Функция ЗначениеПараметра(Параметры, Знач Ключ, Знач ПоУмолчанию)

	Результат = ПоУмолчанию;
	Если Параметры.Свойство(Ключ) Тогда
		Результат = Параметры[Ключ];
	КонецЕсли;
	Возврат Результат;

КонецФункции
