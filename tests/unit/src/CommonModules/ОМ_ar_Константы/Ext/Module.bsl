///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Константы.
//
// Тесты констант (ar_Константы): ХостИзURL (схема, user@, порт, путь -
// остаётся только хост в нижнем регистре; мусор - пусто), значения по
// умолчанию лимитов при пустых константах (читаются фактические значения
// геттеров - дефолт >= ожидаемого минимума).
//
// Сценарии раздела 7 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Константы")
		.ДобавитьСерверныйТест("ХостИзURLРазныеформаты").Тег("critical")
		.ДобавитьСерверныйТест("ЗначенияПоУмолчаниюЛимитов").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ХостИзURL отбрасывает схему, учётные данные, порт, путь/запрос/фрагмент;
// результат в нижнем регистре; мусор - пустая строка.
Процедура ХостИзURLРазныеформаты() Экспорт

	ЮТест.ОжидаетЧто(
		ar_Константы.ХостИзURL("http://192.168.1.50:1234/v1")).Равно("192.168.1.50")
		.Что(ar_Константы.ХостИзURL("HTTPS://User:Pass@Api.Example.com/path?q=1#f"))
		.Равно("api.example.com")
		.Что(ar_Константы.ХостИзURL("https://api.example.com")).Равно("api.example.com")
		.Что(ar_Константы.ХостИзURL("no-host")).Равно("no-host")
		.Что(ar_Константы.ХостИзURL("")).Равно("");

КонецПроцедуры

// Геттеры лимитов возвращают положительные значения по умолчанию при пустых
// константах (таймаут, шаги, действия, TTL подтверждений, порог пульса).
Процедура ЗначенияПоУмолчаниюЛимитов() Экспорт

	ЮТест.ОжидаетЧто(ar_Константы.ТаймаутLLM()).Больше(0)
		.Что(ar_Константы.МаксШагов()).Больше(0)
		.Что(ar_Константы.МаксДействий()).Больше(0)
		.Что(ar_Константы.ApprovalExpirationЧасов()).Больше(0)
		.Что(ar_Константы.HeartbeatПорогСек()).Больше(0)
		.Что(ar_Константы.МаксОдновременныхЗапусковАгента()).Больше(0);

КонецПроцедуры

#КонецОбласти
