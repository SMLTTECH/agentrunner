КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Нормализация: нижний регистр, ё -> е, кавычки-тире-неразрывные пробелы к одному виду.
Процедура НормализованныйТекстПробелыРегистрТире() Экспорт

	Пакет = ОбъектПакета();

	// Неразрывный пробел внутри числа и тире между группами (Символ(8212) - длинное тире).
	ИсходныйТекст = "РасчЁтный  СчЁт: 40702" + Символы.НПП + "5104 " + Символ(8212) + " 4000";
	ЮТест.ОжидаетЧто(Пакет.НормализованныйТекст(ИсходныйТекст))
		.Равно("расчетный счет: 40702 5104 - 4000");

КонецПроцедуры

// Слияние групп разрядов счёта в один токен (СлияниеПробелов) и раздельные группы (без него).
Процедура ПоследовательностиЦифрГруппыРазрядов() Экспорт

	Пакет = ОбъектПакета();
	ТекстНорм = "счет 40702510 4000 0000 2345 бик 044525225";

	Слитно = Пакет.ПоследовательностиЦифр(ТекстНорм, Истина);
	ЮТест.ОжидаетЧто(Слитно).ИмеетДлину(2)
		.Что(Слитно[0]).Равно("40702510400000002345")
		.Что(Слитно[1]).Равно("044525225");

	БезСлияния = Пакет.ПоследовательностиЦифр(ТекстНорм, Ложь);
	ЮТест.ОжидаетЧто(БезСлияния).ИмеетДлину(5)
		.Что(БезСлияния[0]).Равно("40702510")
		.Что(БезСлияния[1]).Равно("4000")
		.Что(БезСлияния[4]).Равно("044525225");

КонецПроцедуры

// ИНН заявки из фикстуры признан корректным (контрольный разряд БСП сходится).
Процедура ИннТекстаНаходитИННЗаявки() Экспорт

	Пакет = ОбъектПакета();
	ТекстНорм = Пакет.НормализованныйТекст(ТекстФикстуры());

	Инн = Пакет.ИннТекста(ТекстНорм);
	ЮТест.ОжидаетЧто(Инн).ИмеетДлину(1)
		.Что(Инн[0]).Равно("7707083893");

	// Иной контрольный разряд - ИНН не корректен, в список не попадает.
	ЮТест.ОжидаетЧто(Пакет.ИннТекста("инн 7707083894")).ИмеетДлину(0);

КонецПроцедуры

// БИК заявки из фикстуры найден; невалидные коды (не 9 цифр, не РФ) отброшены.
Процедура БикТекстаНаходитБикЗаявки() Экспорт

	Пакет = ОбъектПакета();
	ТекстНорм = Пакет.НормализованныйТекст(ТекстФикстуры());

	Бики = Пакет.БикТекста(ТекстНорм);
	ЮТест.ОжидаетЧто(Бики).ИмеетДлину(1)
		.Что(Бики[0]).Равно("044525225");

	ЮТест.ОжидаетЧто(Пакет.БикТекста("бик 04452522 и 144525225")).ИмеетДлину(0);

КонецПроцедуры

// Фактическое поведение прогона 88: счёт фикстуры не признан - контрольный ключ
// счёта не верен для БИК (см. КлючСчетаКорректенФикстураИВариант), текст и
// нормализация тут ни при чём (ИНН и БИК из того же текста находятся).
Процедура СчетаТекстаФикстураСчетНеПризнан() Экспорт

	Пакет = ОбъектПакета();
	ТекстНорм = Пакет.НормализованныйТекст(ТекстФикстуры());

	ДопБики = Новый Массив;
	ДопБики.Добавить("044525225");

	ЮТест.ОжидаетЧто(Пакет.СчетаТекста(ТекстНорм, ДопБики)).ИмеетДлину(0);
	// Счёт в тексте есть, но ключ его не верен для БИК - страховка права, а заявка 14
	// прогона 88 содержала счёт с неверным контрольным ключом (данные, не код):
	// критерий 1 спеки расходится с фактом по причине данных (см.
	// КлючСчетаКорректенФикстураИВариант, runs.md agentrunner-88 итерация 3).

КонецПроцедуры

// Форматирование номера: пробелы, дефисы, неразрывные пробелы сливаются в один
// токен и счёт признаётся; перенос строки внутри номера разрывает токен.
Процедура СчетаТекстаВариацииФорматаСчета() Экспорт

	Пакет = ОбъектПакета();
	Счет = СчетСВернымКлючом();
	ДопБики = Новый Массив;
	ДопБики.Добавить("044525225");

	ЮТест.ОжидаетЧто(Пакет.СчетаТекста("счет 40702510 4000 0000 2345 конец", ДопБики))
		.ИмеетДлину(1).Свойство("[0]").Равно(Счет);

	ЮТест.ОжидаетЧто(Пакет.СчетаТекста("счет 4070-2510-4000-0000-2345 конец", ДопБики))
		.ИмеетДлину(1).Свойство("[0]").Равно(Счет);

	ТекстСНеразрывными = "счет 4070" + Символы.НПП + "2510" + Символы.НПП
		+ "4000" + Символы.НПП + "0000" + Символы.НПП + "2345 конец";
	ТекстНорм = Пакет.НормализованныйТекст(ТекстСНеразрывными);
	ЮТест.ОжидаетЧто(Пакет.СчетаТекста(ТекстНорм, ДопБики))
		.ИмеетДлину(1).Свойство("[0]").Равно(Счет);

	// Перенос строки внутри номера: слияния нет, счёт не найден (фактическое
	// поведение - вторая возможная причина прогона 88 наряду с ключом счёта).
	ТекстСПереносом = "счет 40702510400000" + Символы.ПС + "002345 конец";
	ЮТест.ОжидаетЧто(Пакет.СчетаТекста(ТекстСПереносом, ДопБики)).ИмеетДлину(0);

КонецПроцедуры

// БИК корректен: 9 цифр и код страны РФ.
Процедура БикКорректенПроверка() Экспорт

	Пакет = ОбъектПакета();

	ЮТест.ОжидаетЧто(Пакет.БИККорректен("044525225")).Равно(Истина)
		.Что(Пакет.БИККорректен("144525225")).Равно(Ложь)
		.Что(Пакет.БИККорректен("04452522")).Равно(Ложь)
		.Что(Пакет.БИККорректен("")).Равно(Ложь);

КонецПроцедуры

// Локализация расхождения прогона 88: контрольный ключ счёта фикстуры не верен
// для БИК; подобранный вариант (16-й разряд) ключ проходит.
Процедура КлючСчетаКорректенФикстураИВариант() Экспорт

	Пакет = ОбъектПакета();

	// Фактическое поведение: ключ счёта 40702510400000012345 не верен для БИК
	// 044525225 (письмо ЦБР 515) - поэтому страховка счет не признает. Код прав:
	// счет с неверным ключом был в данных заявки 14 прогона 88. Текст замечания
	// страховки при этом вводил в заблуждение («в файлах не найдены счёт и БИК»)
	// - уточнено в agentrunner-121: при неверном ключе замечание
	// bank_account_invalid_key с честным текстом (см. ФикстураПрогонаДаетЗамечание;
	// runs.md agentrunner-88 итерация 3, спека agentrunner-116 раздел 4).
	ЮТест.ОжидаетЧто(Пакет.КлючСчетаКорректен("40702510400000012345", "044525225")).Равно(Ложь)
		.Что(Пакет.КлючСчетаКорректен(СчетСВернымКлючом(), "044525225")).Равно(Истина);

КонецПроцедуры

// Относимость файла: ИНН заявки, маркер физлица, наименование для создания без ИНН.
Процедура ФайлОтноситсяПоКлючевымРеквизитам() Экспорт

	Пакет = ОбъектПакета();
	Контекст = КонтекстЮл();
	ТекстНорм = Пакет.НормализованныйТекст(ТекстФикстуры());

	ЮТест.ОжидаетЧто(Пакет.ФайлОтносится(Контекст, ТекстНорм)).Равно(Истина)
		.Что(Пакет.ФайлОтносится(Контекст, "договор аренды помещения")).Равно(Ложь);

	// Физлицо: любой из маркеров (в нормализованном виде).
	КонтекстФл = КонтекстФизЛица();
	ЮТест.ОжидаетЧто(Пакет.ФайлОтносится(КонтекстФл,
		"заявление иванов сергей петрович счет")).Равно(Истина)
		.Что(Пакет.ФайлОтносится(КонтекстФл, "выписка по счету")).Равно(Ложь);

	// Создание без ИНН: по наименованию.
	Контекст.Вставить("ИНН", "");
	ЮТест.ОжидаетЧто(Пакет.ФайлОтносится(Контекст, ТекстНорм)).Равно(Истина);

КонецПроцедуры

// Паспорт ищется по группам цифр (agentrunner-414): пробелы, дефис и «№» не
// мешают, номер внутри длинного числа (счета) не находится.
Процедура ПаспортНаходитсяПоГруппамЦифр() Экспорт

	Пакет = ОбъектПакета();
	ЮТест.ОжидаетЧто(Пакет.ЦифрыПаспортаВТексте("паспорт 45 10 123456 выдан", "4510123456")).Равно(Истина)
		.Что(Пакет.ЦифрыПаспортаВТексте("серия 45 10 № 123456", "4510123456")).Равно(Истина)
		.Что(Пакет.ЦифрыПаспортаВТексте("4510 123456 17.09.2011", "4510123456")).Равно(Истина)
		.Что(Пакет.ЦифрыПаспортаВТексте("код подразделения 500-525", "500525")).Равно(Истина)
		.Что(Пакет.ЦифрыПаспортаВТексте("счет 40817810045101234567", "4510123456")).Равно(Ложь)
		.Что(Пакет.ЦифрыПаспортаВТексте("паспорт 45 10 123457", "4510123456")).Равно(Ложь);

	// Ревью c9ed5cd1 (agentrunner-415): точка и длинный промежуток рвут склейку -
	// дата не дает серию или код подразделения.
	ЮТест.ОжидаетЧто(Пакет.ЦифрыПаспортаВТексте("выдан 17.09.2011", "1709")).Равно(Ложь)
		.Что(Пакет.ЦифрыПаспортаВТексте("выдан 17.09.2011", "092011")).Равно(Ложь)
		.Что(Пакет.ЦифрыПаспортаВТексте("4510 и далее длинный текст договора 123456", "4510123456")).Равно(Ложь)
		.Что(Пакет.ЦифрыПаспортаВТексте("серия 4510 номер 123456", "4510123456")).Равно(Истина);

	// Относимость файла физлица по маркеру паспорта (цифры подряд).
	КонтекстФл = КонтекстФизЛица();
	КонтекстФл.МаркерыФизЛица.Добавить("4510123456");
	ЮТест.ОжидаетЧто(Пакет.ФайлОтносится(КонтекстФл, "паспорт серия 45 10 номер 123456")).Равно(Истина);

КонецПроцедуры

// Физлицо (agentrunner-416): ИНН, КПП, ОГРН файла с заявкой не сверяются;
// КПП и ОГРН не дозаполняются, ИНН - если модель отнесла его к другому лицу.
Процедура ФизЛицоИннФайлаНеСверяетсяИНеДозаполняетсяЧужим() Экспорт

	Пакет = ОбъектПакета();

