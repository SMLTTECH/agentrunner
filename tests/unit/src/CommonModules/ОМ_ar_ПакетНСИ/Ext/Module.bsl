// Параметры:
//  Пакет    - ВнешняяОбработка - объект пакета.
//  Контекст - Структура        - контекст сверки.
//  Файлы    - Массив           - файлы (см. ФайлСверки).
//
// Возвращаемое значение:
//  Массив из Структура - результаты СтатусФайлаСверки.
//
Функция СтатусыФайловПакета(Знач Пакет, Знач Контекст, Знач Файлы)

	Статусы = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Статусы.Добавить(Пакет.СтатусФайлаСверки(Контекст, Файл));
	КонецЦикла;
	Возврат Статусы;

КонецФункции

// Сверка по полям, которые читает ПроверитьОбязательныеДокументы; ПроверенныеЗначения -
// пустое соответствие (структурная заглушка пути «принятых значений»).
//
// Параметры:
//  СтатусыФайлов - Массив - результаты СтатусФайлаСверки.
//
// Возвращаемое значение:
//  Структура - сверка для ПроверитьОбязательныеДокументы.
//
Функция СверкаСФайлами(Знач СтатусыФайлов)

	Сверка = Новый Структура;
	Сверка.Вставить("СтатусыФайлов", СтатусыФайлов);
	Сверка.Вставить("Замечания", Новый Массив);
	Сверка.Вставить("НезаполненОбязательныйДокумент", Ложь);
	Сверка.Вставить("СчетНеПодтвержденДокументами", Ложь);
	Сверка.Вставить("ЧужиеФайлыБлокируют", Ложь);
	Сверка.Вставить("ПроверенныеЗначения", Новый Соответствие);
	Возврат Сверка;

КонецФункции

