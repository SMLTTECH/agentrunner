// Заявка не передана, ссылка на несуществующую заявку, строка без номера -
// request_not_found с текстом для модели, не терминальный (модель может
// исправить аргумент), у всех инструментов одной заявки.
Процедура ЗаявкаНеНайденаНеТерминально() Экспорт

	Пакет = ОбъектПакета();
	ВариантыАргументов = Новый Массив;
	ВариантыАргументов.Добавить("{}");
	ВариантыАргументов.Добавить(АргументыЗаявки(СсылкаНесуществующейЗаявки()));
	ВариантыАргументов.Добавить(АргументыЗаявки("заявка без номера"));

	ИнструментыЗаявки = Новый Массив;
	ИнструментыЗаявки.Добавить("nsi_get_request");
	ИнструментыЗаявки.Добавить("nsi_verify_request");
	ИнструментыЗаявки.Добавить("nsi_submit_file_data");
	ИнструментыЗаявки.Добавить("nsi_actualize_request");

	Для Каждого ИмяИнструмента Из ИнструментыЗаявки Цикл
		Для Каждого АргументыJSON Из ВариантыАргументов Цикл
			Описание = ИмяИнструмента + " " + АргументыJSON;
			Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента, АргументыJSON, Неопределено));
			ЮТест.ОжидаетЧто(Ответ, Описание)
				.Свойство("error").Равно("request_not_found")
				.Свойство("message").Заполнено()
				.НетСвойства("terminal");
		КонецЦикла;
	КонецЦикла;

