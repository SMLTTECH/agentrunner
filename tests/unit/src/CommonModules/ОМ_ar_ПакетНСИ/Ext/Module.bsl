// Отметка комментария approve - по фактической причине: файлов нет; только
// чужой файл; файл контрагента без счёта и чужой файл.
Процедура ОтметкаВизыПоПричине() Экспорт

	Пакет = ОбъектПакета();
	Контекст = КонтекстЮл();
	Контекст.НомерСчета = СчетСВернымКлючом();

	СверкаБезФайлов = СверкаСФайлами(Новый Массив);
	СверкаБезФайлов.СчетНеПодтвержденДокументами = Истина;
	ЮТест.ОжидаетЧто(Пакет.ОтметкаСверкиДляВизы(ПроверкиСоСверкой(Контекст, СверкаБезФайлов)))
		.Равно("Нет файлов для проверки расчётного счёта.");

	ФайлыЧужие = Новый Массив;
	ФайлыЧужие.Добавить(ФайлСверки("СТРОЙТЕХГАРАНТ - Банк", ТекстЧужогоФайла()));
	СверкаЧужие = СверкаСФайлами(СтатусыФайловПакета(Пакет, Контекст, ФайлыЧужие));
	СверкаЧужие.СчетНеПодтвержденДокументами = Истина;
	ОтметкаЧужие = Пакет.ОтметкаСверкиДляВизы(ПроверкиСоСверкой(Контекст, СверкаЧужие));
	ЮТест.ОжидаетЧто(ОтметкаЧужие)
		.НеСодержит("Нет файлов")
		.Содержит("нет документа контрагента")
		.Содержит("«СТРОЙТЕХГАРАНТ - Банк» относится к другой организации (ИНН 9718288751)");

	ФайлыСмешанные = Новый Массив;
	ФайлыСмешанные.Добавить(ФайлСверки("СТРОЙТЕХГАРАНТ - Банк", ТекстЧужогоФайла()));
	ФайлыСмешанные.Добавить(ФайлСверки("Карточка", ТекстФикстуры()));
	СверкаСмешанная = СверкаСФайлами(СтатусыФайловПакета(Пакет, Контекст, ФайлыСмешанные));
	СверкаСмешанная.СчетНеПодтвержденДокументами = Истина;
	ЮТест.ОжидаетЧто(Пакет.ОтметкаСверкиДляВизы(ПроверкиСоСверкой(Контекст, СверкаСмешанная)))
		.Содержит("В файлах контрагента нет расчётного счёта заявки.")
		.Содержит("Не учитывался.");

КонецПроцедуры

// Цитатная форма (agentrunner-407): переводы строк и возвраты каретки - в
// пробел, повторные пробелы свёрнуты; базовая НормализованныйТекст переводы
// строк сохраняет (иначе счёт в соседней строке слился бы с ИНН); от уже
// нормализованного текста результат тот же (идемпотентность).
Процедура НормализованныйТекстЦитатыБезПереводовСтрок() Экспорт

	Пакет = ОбъектПакета();
	ИсходныйТекст = "Расчётный" + Символы.ПС + "счёт:" + Символы.ВК + Символы.ПС + "  40702 "
		+ Символы.Таб + "5104";

	ЮТест.ОжидаетЧто(Пакет.НормализованныйТекстЦитаты(ИсходныйТекст))
			.Равно("расчетный счет: 40702 5104")
		.Что(Пакет.НормализованныйТекстЦитаты(Пакет.НормализованныйТекст(ИсходныйТекст)))
			.Равно("расчетный счет: 40702 5104")
		.Что(Пакет.НормализованныйТекст(ИсходныйТекст))
			.Содержит(Символы.ПС);

КонецПроцедуры

// Редкие пробелы (узкий неразрывный U+202F, цифровой U+2007, тонкий U+2009),
// неразрывный дефис U+2011 и типографские кавычки „“ приводятся к обычным -
// цитата модели совпадает с текстом файла (решение agentrunner-402: выравниваются
// пробелы, кавычки и дефисы).
