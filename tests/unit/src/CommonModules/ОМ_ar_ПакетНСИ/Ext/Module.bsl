		+ Символ(8199) + "г." + Символ(8201) + "код 500" + Символ(8209) + "525";

	ЮТест.ОжидаетЧто(Пакет.НормализованныйТекст(ИсходныйТекст))
		.Равно("ооо ""ромашка"" от 1 января 2026 г. код 500-525");

КонецПроцедуры

// Манифест: схема 2, пространство имён nsi, версия манифеста равна версии
// регистрации; инструменты - те, что разбирает ar_ВыполнитьИнструмент, с
// префиксом nsi_, без повторов, схема аргументов в формате OpenAI с именем
// инструмента.
Процедура МанифестИнструментыВПространствеИменНСИ() Экспорт

	Пакет = ОбъектПакета();
	Манифест = Пакет.ar_ОписаниеИнструментов();
	Сведения = Пакет.СведенияОВнешнейОбработке();
	ИменаПакета = ИменаИнструментов();

	ЮТест.ОжидаетЧто(Манифест)
		.Свойство("ВерсияСхемы").Равно(2)
		.Свойство("ПространствоИмён").Равно("nsi")
		.Свойство("Версия").Равно(Сведения.Версия)
		.Свойство("Категории[0].Имя").Равно("nsi")
		.Свойство("Инструменты").ИмеетДлину(ИменаПакета.Количество());

	Встречены = Новый Соответствие;
	Для Каждого Инструмент Из Манифест.Инструменты Цикл
		Схема = ar_JSON.ИзJSON(Инструмент.СхемаАргументовJSON);
		ЮТест.ОжидаетЧто(ИменаПакета, Инструмент.Имя).Содержит(Инструмент.Имя)
			.Что(Встречены.Получить(Инструмент.Имя), "Повтор " + Инструмент.Имя).ЭтоНеопределено()
			.Что(Схема, Инструмент.Имя).ИмеетТип("Соответствие")
			.Что(Схема.Получить("type"), Инструмент.Имя).Равно("function")
			.Что(Схема.Получить("function").Получить("name"), Инструмент.Имя).Равно(Инструмент.Имя);
		Встречены.Вставить(Инструмент.Имя, Истина);
	КонецЦикла;

КонецПроцедуры

// Манифест проходит валидацию ядра под идентификатором своей регистрации.
Процедура МанифестПроходитВалидациюЯдра() Экспорт

	Пакет = ОбъектПакета();
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Пакет.ar_ОписаниеИнструментов(),
		Строка(СсылкаРегистрацииПакета().УникальныйИдентификатор()));

	ЮТест.ОжидаетЧто(Результат.Корректно, СтрСоединить(Результат.Ошибки, "; ")).ЭтоИстина()
		.Что(Результат.Ошибки).ИмеетДлину(0);

КонецПроцедуры

