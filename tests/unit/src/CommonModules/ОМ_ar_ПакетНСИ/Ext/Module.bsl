// Контекст сверки физлица: без ИНН, счёт с верным ключом, поиск файла по
// маркеру (ФИО).
//
// Возвращаемое значение:
//  Структура - контекст сверки.
//
Функция КонтекстФизЛица()

	Контекст = КонтекстЮл();
	Контекст.ИНН = "";
	Контекст.КПП = "";
	Контекст.ОГРН = "";
	Контекст.НомерСчета = СчетСВернымКлючом();
	Контекст.ЭтоФизЛицо = Истина;
	Контекст.Наименование = "иванов сергей петрович";
	Маркеры = Новый Массив;
	Маркеры.Добавить("иванов сергей петрович");
	Контекст.МаркерыФизЛица = Маркеры;
	Возврат Контекст;

КонецФункции

// Файл сверки по полям ФайлыЗаявкиДляСверки пакета; дата старая - вне границы
// ожидания распознавания (ответ не зависит от времени прогона).
//
// Параметры:
//  Имя   - Строка - имя файла для лога сверки.
//  Текст - Строка - извлечённый текст файла.
//
// Возвращаемое значение:
//  Структура - файл для СтатусФайлаСверки.
//
Функция ФайлСверки(Знач Имя, Знач Текст)

	Файл = Новый Структура;
	Файл.Вставить("Имя", Имя);
	Файл.Вставить("Статус", Перечисления.СтатусыИзвлеченияТекстаФайлов.Извлечен);
	Файл.Вставить("Текст", Текст);
	Файл.Вставить("ДатаСоздания", Дата(2026, 10, 14, 10, 0, 0));
	Файл.Вставить("Зашифрован", Ложь);
	Файл.Вставить("ПоддерживаетсяРасширение", Истина);
	Возврат Файл;

КонецФункции

// Статусы файлов по СтатусФайлаСверки пакета.
