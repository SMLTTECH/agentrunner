// Объект зарегистрированного пакета ar_ПакетНСИ; без регистрации или при ошибке
// подключения тест пропускается с сообщением (не красный). ЮТест.Пропустить
// прерывает тест исключением - код после вызова не выполняется.
//
// Возвращаемое значение:
//  ВнешняяОбработка - объект пакета с экспортными функциями.
//
Функция ОбъектПакета()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", "ar_ПакетНСИ");
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЮТест.Пропустить("Пакет ar_ПакетНСИ не зарегистрирован в справочнике ДополнительныеОтчетыИОбработки");
	КонецЕсли;

	Попытка
		Объект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Выборка.Ссылка);
	Исключение
		ЮТест.Пропустить("Не удалось подключить пакет ar_ПакетНСИ: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Объект = Неопределено Тогда
		ЮТест.Пропустить("ОбъектВнешнейОбработки вернул Неопределено для пакета ar_ПакетНСИ");
	КонецЕсли;

	Возврат Объект;

КонецФункции

