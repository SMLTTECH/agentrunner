// Фикстура прогона 88 - кейс А (agentrunner-121): ключ счета не верен для БИК,
// страховка дает замечание возврата bank_account_invalid_key с текстом про
// проверку номера счета и БИК в заявке. ЮЛ и ФЛ - одинаково (ранняя проверка
// ключа, до ветки вида лица).
Процедура ФикстураПрогонаДаетЗамечание() Экспорт

	Пакет = ОбъектПакета();
	Контекст = КонтекстЮл();

	Файлы = Новый Массив;
	Файлы.Добавить(ФайлСверки("Карточка", ТекстФикстуры()));
	Сверка = СверкаСФайлами(СтатусыФайловПакета(Пакет, Контекст, Файлы));

	Пакет.ПроверитьОбязательныеДокументы(Контекст, Сверка);

	ЮТест.ОжидаетЧто(Сверка)
		.Свойство("НезаполненОбязательныйДокумент").Равно(Истина)
		.Свойство("Замечания").ИмеетДлину(1)
		.Свойство("Замечания[0].code").Равно("bank_account_invalid_key")
		.Свойство("Замечания[0].text").Равно(ТекстЗамечанияКлюча(Контекст));

	// ФЛ: тот же код и текст - ФЛ-ветка проверки ключа не отличается.
	КонтекстФл = КонтекстФизЛица();
	КонтекстФл.НомерСчета = Контекст.НомерСчета;
	СверкаФл = СверкаСФайлами(СтатусыФайловПакета(Пакет, КонтекстФл, Файлы));

	Пакет.ПроверитьОбязательныеДокументы(КонтекстФл, СверкаФл);

	ЮТест.ОжидаетЧто(СверкаФл)
		.Свойство("НезаполненОбязательныйДокумент").Равно(Истина)
		.Свойство("Замечания").ИмеетДлину(1)
		.Свойство("Замечания[0].code").Равно("bank_account_invalid_key")
		.Свойство("Замечания[0].text").Равно(ТекстЗамечанияКлюча(КонтекстФл));

КонецПроцедуры

