Процедура ПараметрыОткрытияПредметаТолькоДляЗаявки() Экспорт

	Пакет = ОбъектПакета();
	ЮТест.ОжидаетЧто(Пакет.ar_ПараметрыОткрытияПредмета(Пользователи.ТекущийПользователь())).ЭтоНеопределено();

	Заявка = Документы.бит_мдм_ЗаявкаНаИзменение.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Открытие = Пакет.ar_ПараметрыОткрытияПредмета(Заявка);
	ЮТест.ОжидаетЧто(Открытие).ИмеетТип("Структура");

	ФормаИсправления = СтрЗаканчиваетсяНа(Открытие.ИмяФормы, ".Форма.ИсправлениеЗаявки");
	Если ФормаИсправления Тогда
		ЮТест.ОжидаетЧто(Открытие.ПараметрыФормы).Свойство("Заявка").Равно(Заявка);
	Иначе
		ЮТест.ОжидаетЧто(Открытие.ИмяФормы).Равно("Документ.бит_мдм_ЗаявкаНаИзменение.ФормаОбъекта")
			.Что(Открытие.ПараметрыФормы).Свойство("Ключ").Равно(Заявка);
	КонецЕсли;

КонецПроцедуры

