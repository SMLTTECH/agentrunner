///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Подтверждение.
//
// Тесты жизненного цикла очереди подтверждений (ar_Подтверждение):
// Поставить -> Принять / Отклонить / Истечь; повторное решение по решённой
// записи; МассовоПринять (часть успешна, часть нет); ОтветитьНаВопрос для
// записи ожидания ввода; идемпотентность (ПометитьApprovalВыполненным,
// НайтиПредыдущийРезультат); выборки НайтиОдобренныеApproval,
// НайтиПросроченныеApproval (граница ApprovalExpirationЧасов),
// ЗакрытьОжидающиеApprovalЗапуска.
//
// По п.8 спеки (пересечение с agentrunner-26): истечение проверяется только
// для записей pending; для вопросов - только ОтветитьНаВопрос (статус
// answered, ответ в записи, повторный ответ отклонён) без проверок срока;
// возобновление запуска в фоне не проверяется - только состояние очереди.
//
// Сценарии раздела 3 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЖизненныйЦиклЗаписи")
		.ДобавитьСерверныйТест("ПостановкаСоздаетЗаписьИПриостанавливаетЗапуск").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПринятиеПереводитВApproved").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтклонениеПереводитВRejected").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИстечениеТребуетПросроченнуюЗапись").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторноеРешениеОтклоняется").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("МассовыеИВопросныеОперации")
		.ДобавитьСерверныйТест("МассовоеПринятиеСЧастичнымУспехом").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтветНаВопросИПовторныйОтвет").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ИдемпотентностьИВыборки")
		.ДобавитьСерверныйТест("ИдемпотентностьИсполненияПоКлючу").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВыборкиОдобренныхИПросроченных").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗакрытиеОжидающихЗаписейЗапуска").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-13 ОтвеченныеВыборка")
		.ДобавитьСерверныйТест("ОтвеченныеВыбираютсяТочечно").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-16 ДваОтвета")
		.ДобавитьСерверныйТест("ВозобновлениеАктуальнымОтветом").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-79 ПакетБезИсполнителя")
		.ДобавитьСерверныйТест("ПодтверждениеПакетногоБезИсполнителяОтклоняется")
			.Тег("critical").ВТранзакции().После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-32 Захваты")
		.ДобавитьСерверныйТест("ЗахватПарыОтказИОсвобождение").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПараллельностьЗахватаПоАгенту").Тег("critical").ВТранзакции();

КонецПроцедуры

// Очистка сценария заглушки после теста (состояние ar_LLMMock живёт в
// ХранилищеОбщихНастроек - вне транзакции теста).
Процедура ОчиститьMock() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Поставить создаёт pending-запись в ar_ОчередьApproval и приостанавливает
// запуск (ПриостановленДляПодтверждения).
Процедура ПостановкаСоздаетЗаписьИПриостанавливаетЗапуск() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	ЮТест.ОжидаетЧто(ApprovalId).Заполнено();

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Контекст.RunId);
	ЮТест.ОжидаетЧто(Очередь).ИмеетДлину(1)
		.Свойство("[0].ApprovalId").Равно(ApprovalId)
		.Свойство("[0].Статус").Равно("pending");

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Контекст.RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

КонецПроцедуры

// Принять переводит pending-запись в approved и возвращает Успех с RunId.
Процедура ПринятиеПереводитВApproved() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	Результат = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина()
		.Свойство("RunId").Равно(Контекст.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("approved");

КонецПроцедуры

// Отклонить переводит pending-запись в rejected.
Процедура ОтклонениеПереводитВRejected() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	Результат = ar_Подтверждение.Отклонить(ApprovalId, ПустойПользователь(), "Опасное действие");

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоИстина()
		.Свойство("RunId").Равно(Контекст.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("rejected");

КонецПроцедуры

// Истечь: свежая запись не истекает (not_expired_yet); запись с ar_СозданоВ
// старше ApprovalExpirationЧасов истекает (pending -> expired).
Процедура ИстечениеТребуетПросроченнуюЗапись() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	РезультатСвежей = ar_Подтверждение.Истечь(ApprovalId);
	ЮТест.ОжидаетЧто(РезультатСвежей).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("not_expired_yet");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("pending");

	СостаритьЗаписьОчереди(ApprovalId);
	РезультатСтарой = ar_Подтверждение.Истечь(ApprovalId);
	ЮТест.ОжидаетЧто(РезультатСтарой.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("expired");

КонецПроцедуры

// Повторное решение по уже решённой записи отклоняется (не исключение):
// Успех = Ложь, Причина = "status_mismatch: <текущий статус>".
Процедура ПовторноеРешениеОтклоняется() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());
	ar_Подтверждение.Отклонить(ApprovalId, ПустойПользователь(), "Первое решение");

	РезультатПовтора = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());

	ЮТест.ОжидаетЧто(РезультатПовтора).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("status_mismatch: rejected");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("rejected");

КонецПроцедуры

// МассовоПринять: часть записей принимается, часть (уже решённая) - нет;
// исключений нет, счётчики корректны.
Процедура МассовоеПринятиеСЧастичнымУспехом() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId1 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_1"));
	ApprovalId2 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_2"));
	ar_Подтверждение.Отклонить(ApprovalId2, ПустойПользователь(), "Заранее отклонена");

	Список = Новый Массив;
	Список.Добавить(ApprovalId1);
	Список.Добавить(ApprovalId2);

	Итог = ar_Подтверждение.МассовоПринять(Список, ПустойПользователь());

	ЮТест.ОжидаетЧто(Итог).Свойство("ВсегоЗапросов").Равно(2)
		.Свойство("Принято").Равно(1)
		.Свойство("НеПринято").Равно(1);
	ЮТест.ОжидаетЧто(Итог.ОшибкиПоId.Получить(ApprovalId2)).Заполнено();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId1)).Равно("approved")
		.Что(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId2)).Равно("rejected");

КонецПроцедуры

// ОтветитьНаВопрос для записи awaiting_input: статус answered, ответ
// (user_answer) в записи; повторный ответ отклонён.
Процедура ОтветНаВопросИПовторныйОтвет() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ЗаписатьВопросОчереди(Контекст.RunId);

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ОтветитьНаВопрос(ApprovalId, ПустойПользователь(), "Ответ агента")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("answered");

	Запись = ar_Подтверждение.ПрочитатьЗаписьОчередиБезПривилегий(ApprovalId);
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ActionPayloadJSON, "user_answer") > 0).ЭтоИстина();

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ОтветитьНаВопрос(ApprovalId, ПустойПользователь(), "Повтор")).ЭтоЛожь();

КонецПроцедуры

// Идемпотентность: ПометитьApprovalВыполненным переводит approved ->
// executed; НайтиПредыдущийРезультат возвращает кэш; повторная постановка с
// тем же ключом возвращает прежний ApprovalId.
Процедура ИдемпотентностьИсполненияПоКлючу() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Контекст = ПодготовкаЗапуска();
	КлючИдемпотентности = "тест-ключ-" + ОМ_ar_ТестовыеДанные.НовыйRunId();

	Действие = ДействиеСИменем("get_constants");
	Действие.Вставить("IdempotencyKey", КлючИдемпотентности);
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие);

	РезультатПринятия = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());
	ЮТест.ОжидаетЧто(РезультатПринятия.Успех).ЭтоИстина();

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ПометитьApprovalВыполненным(КлючИдемпотентности)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("executed");

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.НайтиПредыдущийРезультат(КлючИдемпотентности)).Заполнено();

	Повторный = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие);
	ЮТест.ОжидаетЧто(Повторный).Равно(ApprovalId);

КонецПроцедуры

// Выборки: НайтиОдобренныеApproval видит approved-запись приостановленного
// запуска; НайтиПросроченныеApproval видит состаренную pending-запись.
Процедура ВыборкиОдобренныхИПросроченных() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОдобренныеApproval(), ApprovalId)).ЭтоЛожь();

	ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());
	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОдобренныеApproval(), ApprovalId)).ЭтоИстина();

	КонтекстПросрочки = ПодготовкаЗапуска();
	ApprovalIdПросроченный = ar_Подтверждение.Поставить(
		КонтекстПросрочки.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_просрочка"));
	СостаритьЗаписьОчереди(ApprovalIdПросроченный);

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиПросроченныеApproval(), ApprovalIdПросроченный)).ЭтоИстина();

КонецПроцедуры

// ЗакрытьОжидающиеApprovalЗапуска переводит все pending/awaiting_input
// записи запуска в cancelled.
Процедура ЗакрытиеОжидающихЗаписейЗапуска() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId1 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_1"));
	ApprovalId2 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_2"));

	Ожидающие = ar_Подтверждение.НайтиОжидающиеApprovalЗапускаБезПривилегий(Контекст.RunId);
	ЮТест.ОжидаетЧто(Ожидающие.Количество()).Равно(2);

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ЗакрытьОжидающиеApprovalЗапуска(Контекст.RunId)).ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId1)).Равно("cancelled")
		.Что(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId2)).Равно("cancelled");

КонецПроцедуры

// agentrunner-13 кр. 1-4: выборка отвеченных - answered-записи выбираются
// только у запусков в "Ожидание ввода" (запуск Завершён - не выбирается),
// при новом awaiting_input старый ответ запуска не выбирается, единственный
// answered у запуска на паузе выбирается (регресс TOOL-19).
Процедура ОтвеченныеВыбираютсяТочечно() Экспорт

	// 1) Запуск Завершён: его answered не выбирается.
	КонтекстЗавершенный = ПодготовкаЗапуска();
	ИдЗавершенный = ЗаписатьОтветОчереди(КонтекстЗавершенный.RunId, ТекущаяДатаСеанса());
	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(КонтекстЗавершенный.RunId, ДанныеЗавершения);

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОтвеченныеApproval(), ИдЗавершенный)).ЭтоЛожь();

	// 2) Запуск в Ожидание ввода с новым awaiting_input: старый answered
	//    того же запуска не выбирается.
	КонтекстСВопросом = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(КонтекстСВопросом.RunId);
	ИдСтарыйОтвет = ЗаписатьОтветОчереди(КонтекстСВопросом.RunId, ТекущаяДатаСеанса() - 120);
	ЗаписатьВопросОчереди(КонтекстСВопросом.RunId);

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОтвеченныеApproval(), ИдСтарыйОтвет)).ЭтоЛожь();

	// 3) Единственная answered у запуска на паузе ввода - выбирается.
	КонтекстЕдинственный = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(КонтекстЕдинственный.RunId);
	ИдЕдинственный = ЗаписатьОтветОчереди(КонтекстЕдинственный.RunId, ТекущаяДатаСеанса());

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОтвеченныеApproval(), ИдЕдинственный)).ЭтоИстина();

КонецПроцедуры

// agentrunner-16 кр. 1-4: при двух answered одного запуска выбирается только
// актуальный (позже по ar_СозданоВ, при равенстве - детерминированно один);
// у разных запусков выбираются обе записи.
Процедура ВозобновлениеАктуальнымОтветом() Экспорт

	Контекст = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(Контекст.RunId);
	ИдРанний = ЗаписатьОтветОчереди(Контекст.RunId, ТекущаяДатаСеанса() - 60);
	ИдПоздний = ЗаписатьОтветОчереди(Контекст.RunId, ТекущаяДатаСеанса());

	Отвеченные = ar_Подтверждение.НайтиОтвеченныеApproval();
	ЮТест.ОжидаетЧто(МассивСодержит(Отвеченные, ИдПоздний)).ЭтоИстина()
		.Что(МассивСодержит(Отвеченные, ИдРанний)).ЭтоЛожь();

	// Равное ar_СозданоВ: выбирается ровно одна из двух.
	ОдноВремя = ТекущаяДатаСеанса();
	КонтекстРавные = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(КонтекстРавные.RunId);
	ИдРавный1 = ЗаписатьОтветОчереди(КонтекстРавные.RunId, ОдноВремя);
	ИдРавный2 = ЗаписатьОтветОчереди(КонтекстРавные.RunId, ОдноВремя);

	ОтвеченныеРавные = ar_Подтверждение.НайтиОтвеченныеApproval();
	ЧислоРавных = 0;
	Если МассивСодержит(ОтвеченныеРавные, ИдРавный1) Тогда
		ЧислоРавных = ЧислоРавных + 1;
	КонецЕсли;
	Если МассивСодержит(ОтвеченныеРавные, ИдРавный2) Тогда
		ЧислоРавных = ЧислоРавных + 1;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЧислоРавных).Равно(1);

	// Разные запуски: обе единственные answered выбираются.
	КонтекстА = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(КонтекстА.RunId);
	ИдА = ЗаписатьОтветОчереди(КонтекстА.RunId, ТекущаяДатаСеанса());
	КонтекстБ = ПодготовкаЗапуска();
	ПеревестиВОжиданиеВвода(КонтекстБ.RunId);
	ИдБ = ЗаписатьОтветОчереди(КонтекстБ.RunId, ТекущаяДатаСеанса());

	ОтвеченныеДва = ar_Подтверждение.НайтиОтвеченныеApproval();
	ЮТест.ОжидаетЧто(МассивСодержит(ОтвеченныеДва, ИдА)).ЭтоИстина()
		.Что(МассивСодержит(ОтвеченныеДва, ИдБ)).ЭтоИстина();

КонецПроцедуры

// agentrunner-79 кр. 1: действие пакетного инструмента без отложенного
// исполнителя подтверждения не получает - очередь пуста, событие Запрещён
// approval_unsupported_by_package, запись в служебном логе с RunId, запуск
// продолжается и завершается.
Процедура ПодтверждениеПакетногоБезИсполнителяОтклоняется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура("РежимАвтономии", Перечисления.ar_РежимАвтономии.Ручной);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	ОМ_ar_ТестовыеДанные.НовыйИнструментПакета("тест_пакетное_действие",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_пакетное_действие", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Действие невозможно, продолжаю без него."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Агент, RunId);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗаписиОчереди(RunId)).ИмеетДлину(0);

	СобытиеОтказа = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(RunId, "approval_unsupported_by_package");
	ЮТест.ОжидаетЧто(СобытиеОтказа).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.Запрещён);

	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(RunId, "approval_unsupported_by_package")
			.Количество()).Больше(0);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-32 кр. 1-3 (серверная часть): захват предмета запуском - при
// живом запуске повторный захват отказывает с RunId держателя, после снятия
// захвата предмет снова берется.
Процедура ЗахватПарыОтказИОсвобождение() Экспорт

	Предмет = Пользователи.ТекущийПользователь();
	ПодготовкаА = ПодготовкаЗапускаДляЗахвата();
	ПодготовкаБ = ПодготовкаЗапускаДляЗахвата();

	ЗахватА = ar_ПредметыАгентов.ЗахватитьЗапуском(
		ПодготовкаА.Агент, Предмет, ПодготовкаА.RunId, "manual", "");
	ЮТест.ОжидаетЧто(ЗахватА).Свойство("Успех").ЭтоИстина()
		.Свойство("Причина").Равно("");

	// Отказ - при повторном захвате тем же агентом, пока его запуск жив
	// (ключ пары агент+предмет; сосед по агенту не блокируется - см. ПараллельностьЗахватаПоАгенту).
	ЗахватПовтор = ar_ПредметыАгентов.ЗахватитьЗапуском(
		ПодготовкаА.Агент, Предмет, ПодготовкаБ.RunId, "manual", "");
	ЮТест.ОжидаетЧто(ЗахватПовтор).Свойство("Успех").ЭтоЛожь()
		.Свойство("Причина").Равно("subject_captured")
		.Свойство("RunIdДержатель").Равно(ПодготовкаА.RunId);

	// Пока запуск жив, захват вручную не снимается; после финального статуса -
	// снимается, и предмет снова берется следующим запуском.
	ЮТест.ОжидаетЧто(ar_ПредметыАгентов.СнятьЗахватЗапуска(ПодготовкаА.RunId)).ЭтоЛожь();

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(ПодготовкаА.RunId, ДанныеЗавершения);

	ЮТест.ОжидаетЧто(ar_ПредметыАгентов.СнятьЗахватЗапуска(ПодготовкаА.RunId)).ЭтоИстина();

	ЗахватПослеСнятия = ar_ПредметыАгентов.ЗахватитьЗапуском(
		ПодготовкаБ.Агент, Предмет, ПодготовкаБ.RunId, "manual", "");
	ЮТест.ОжидаетЧто(ЗахватПослеСнятия).Свойство("Успех").ЭтоИстина();

КонецПроцедуры

// agentrunner-32 кр. 2 (серверная часть): ручные запуски разных агентов по
// одному предмету работают параллельно - захват по паре (агент, предмет),
// сосед по очереди не блокирует.
Процедура ПараллельностьЗахватаПоАгенту() Экспорт

	Предмет = Пользователи.ТекущийПользователь();
	ПодготовкаА = ПодготовкаЗапускаДляЗахвата();
	ПодготовкаБ = ПодготовкаЗапускаДляЗахвата();

	ЗахватА = ar_ПредметыАгентов.ЗахватитьЗапуском(
		ПодготовкаА.Агент, Предмет, ПодготовкаА.RunId, "manual", "");
	ЗахватБ = ar_ПредметыАгентов.ЗахватитьЗапуском(
		ПодготовкаБ.Агент, Предмет, ПодготовкаБ.RunId, "manual", "");

	ЮТест.ОжидаетЧто(ЗахватА).Свойство("Успех").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗахватБ).Свойство("Успех").ЭтоИстина()
		.Что(ЗахватБ.Причина).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовка запуска: провайдер, агент (Ручной), запись запуска, контекст
// постановки в очередь.
//
Функция ПодготовкаЗапуска()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	// Движок после решения подтверждения резюмирует запуск по снимку - без
	// снимка Принять/Отклонить/Истечь возвращают Успех=Ложь (resume_failed).
	СостояниеСнимка = Новый Структура;
	СостояниеСнимка.Вставить("Сообщения", Новый Массив);
	СостояниеСнимка.Вставить("ШаговВсего", 0);
	СостояниеСнимка.Вставить("Результат", "");
	ar_AuditЗапуски.СохранитьСнимок(RunId, СостояниеСнимка);

	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("RunId", RunId);
	КонтекстЗапуска.Вставить("Sequence", 0);

	Возврат Новый Структура("RunId, КонтекстЗапуска", RunId, КонтекстЗапуска);

КонецФункции

// Действие для постановки в очередь (get_constants - безопасный ядровой tool).
//
Функция Действие()

	Возврат ДействиеСИменем("get_constants");

КонецФункции

