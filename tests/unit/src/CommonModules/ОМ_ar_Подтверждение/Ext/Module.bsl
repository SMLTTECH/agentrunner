///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Подтверждение.
//
// Тесты жизненного цикла очереди подтверждений (ar_Подтверждение):
// Поставить -> Принять / Отклонить / Истечь; повторное решение по решённой
// записи; МассовоПринять (часть успешна, часть нет); ОтветитьНаВопрос для
// записи ожидания ввода; идемпотентность (ПометитьApprovalВыполненным,
// НайтиПредыдущийРезультат); выборки НайтиОдобренныеApproval,
// НайтиПросроченныеApproval (граница ApprovalExpirationЧасов),
// ЗакрытьОжидающиеApprovalЗапуска.
//
// По п.8 спеки (пересечение с agentrunner-26): истечение проверяется только
// для записей pending; для вопросов - только ОтветитьНаВопрос (статус
// answered, ответ в записи, повторный ответ отклонён) без проверок срока;
// возобновление запуска в фоне не проверяется - только состояние очереди.
//
// Сценарии раздела 3 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЖизненныйЦиклЗаписи")
		.ДобавитьСерверныйТест("ПостановкаСоздаетЗаписьИПриостанавливаетЗапуск").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПринятиеПереводитВApproved").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтклонениеПереводитВRejected").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИстечениеТребуетПросроченнуюЗапись").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторноеРешениеОтклоняется").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("МассовыеИВопросныеОперации")
		.ДобавитьСерверныйТест("МассовоеПринятиеСЧастичнымУспехом").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтветНаВопросИПовторныйОтвет").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ИдемпотентностьИВыборки")
		.ДобавитьСерверныйТест("ИдемпотентностьИсполненияПоКлючу").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВыборкиОдобренныхИПросроченных").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗакрытиеОжидающихЗаписейЗапуска").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Поставить создаёт pending-запись в ar_ОчередьApproval и приостанавливает
// запуск (ПриостановленДляПодтверждения).
Процедура ПостановкаСоздаетЗаписьИПриостанавливаетЗапуск() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	ЮТест.ОжидаетЧто(ApprovalId).Заполнено();

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Контекст.RunId);
	ЮТест.ОжидаетЧто(Очередь.Количество()).Равно(1)
		.Свойство("[0].ApprovalId").Равно(ApprovalId)
		.Свойство("[0].Статус").Равно("pending");

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Контекст.RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

КонецПроцедуры

// Принять переводит pending-запись в approved и возвращает Успех с RunId.
Процедура ПринятиеПереводитВApproved() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	Результат = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина()
		.Свойство("RunId").Равно(Контекст.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("approved");

КонецПроцедуры

// Отклонить переводит pending-запись в rejected.
Процедура ОтклонениеПереводитВRejected() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	Результат = ar_Подтверждение.Отклонить(ApprovalId, ПустойПользователь(), "Опасное действие");

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина()
		.Свойство("RunId").Равно(Контекст.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("rejected");

КонецПроцедуры

// Истечь: свежая запись не истекает (not_expired_yet); запись с ar_СозданоВ
// старше ApprovalExpirationЧасов истекает (pending -> expired).
Процедура ИстечениеТребуетПросроченнуюЗапись() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	РезультатСвежей = ar_Подтверждение.Истечь(ApprovalId);
	ЮТест.ОжидаетЧто(РезультатСвежей.Успех).ЭтоЛожь()
		.Свойство("Причина").Равно("not_expired_yet");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("pending");

	СостаритьЗаписьОчереди(ApprovalId);
	РезультатСтарой = ar_Подтверждение.Истечь(ApprovalId);
	ЮТест.ОжидаетЧто(РезультатСтарой.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("expired");

КонецПроцедуры

// Повторное решение по уже решённой записи отклоняется (не исключение):
// Успех = Ложь, Причина = "status_mismatch: <текущий статус>".
Процедура ПовторноеРешениеОтклоняется() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());
	ar_Подтверждение.Отклонить(ApprovalId, ПустойПользователь(), "Первое решение");

	РезультатПовтора = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());

	ЮТест.ОжидаетЧто(РезультатПовтора.Успех).ЭтоЛожь()
		.Свойство("Причина").Равно("status_mismatch: rejected");
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("rejected");

КонецПроцедуры

// МассовоПринять: часть записей принимается, часть (уже решённая) - нет;
// исключений нет, счётчики корректны.
Процедура МассовоеПринятиеСЧастичнымУспехом() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId1 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_1"));
	ApprovalId2 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_2"));
	ar_Подтверждение.Отклонить(ApprovalId2, ПустойПользователь(), "Заранее отклонена");

	Список = Новый Массив;
	Список.Добавить(ApprovalId1);
	Список.Добавить(ApprovalId2);

	Итог = ar_Подтверждение.МассовоПринять(Список, ПустойПользователь());

	ЮТест.ОжидаетЧто(Итог.ВсегоЗапросов).Равно(2)
		.Свойство("Принято").Равно(1)
		.Свойство("НеПринято").Равно(1);
	ЮТест.ОжидаетЧто(Итог.ОшибкиПоId.Получить(ApprovalId2)).Заполнено();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId1)).Равно("approved")
		.Что(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId2)).Равно("rejected");

КонецПроцедуры

// ОтветитьНаВопрос для записи awaiting_input: статус answered, ответ
// (user_answer) в записи; повторный ответ отклонён.
Процедура ОтветНаВопросИПовторныйОтвет() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ЗаписатьВопросОчереди(Контекст.RunId);

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ОтветитьНаВопрос(ApprovalId, ПустойПользователь(), "Ответ агента")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("answered");

	Запись = ar_Подтверждение.ПрочитатьЗаписьОчередиБезПривилегий(ApprovalId);
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ActionPayloadJSON, "user_answer") > 0).ЭтоИстина();

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ОтветитьНаВопрос(ApprovalId, ПустойПользователь(), "Повтор")).ЭтоЛожь();

КонецПроцедуры

// Идемпотентность: ПометитьApprovalВыполненным переводит approved ->
// executed; НайтиПредыдущийРезультат возвращает кэш; повторная постановка с
// тем же ключом возвращает прежний ApprovalId.
Процедура ИдемпотентностьИсполненияПоКлючу() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Контекст = ПодготовкаЗапуска();
	КлючИдемпотентности = "тест-ключ-" + ОМ_ar_ТестовыеДанные.НовыйRunId();

	Действие = ДействиеСИменем("get_constants");
	Действие.Вставить("IdempotencyKey", КлючИдемпотентности);
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие);

	РезультатПринятия = ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());
	ЮТест.ОжидаетЧто(РезультатПринятия.Успех).ЭтоИстина();

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ПометитьApprovalВыполненным(КлючИдемпотентности)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId)).Равно("executed");

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.НайтиПредыдущийРезультат(КлючИдемпотентности)).Заполнено();

	Повторный = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие);
	ЮТест.ОжидаетЧто(Повторный).Равно(ApprovalId);

КонецПроцедуры

// Выборки: НайтиОдобренныеApproval видит approved-запись приостановленного
// запуска; НайтиПросроченныеApproval видит состаренную pending-запись.
Процедура ВыборкиОдобренныхИПросроченных() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, Действие());

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОдобренныеApproval(), ApprovalId)).ЭтоЛожь();

	ar_Подтверждение.Принять(ApprovalId, ПустойПользователь());
	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиОдобренныеApproval(), ApprovalId)).ЭтоИстина();

	КонтекстПросрочки = ПодготовкаЗапуска();
	ApprovalIdПросроченный = ar_Подтверждение.Поставить(
		КонтекстПросрочки.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_просрочка"));
	СостаритьЗаписьОчереди(ApprovalIdПросроченный);

	ЮТест.ОжидаетЧто(
		МассивСодержит(ar_Подтверждение.НайтиПросроченныеApproval(), ApprovalIdПросроченный)).ЭтоИстина();

КонецПроцедуры

// ЗакрытьОжидающиеApprovalЗапуска переводит все pending/awaiting_input
// записи запуска в cancelled.
Процедура ЗакрытиеОжидающихЗаписейЗапуска() Экспорт

	Контекст = ПодготовкаЗапуска();
	ApprovalId1 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_1"));
	ApprovalId2 = ar_Подтверждение.Поставить(Контекст.КонтекстЗапуска, ДействиеСИменем("тест_инструмент_2"));

	Ожидающие = ar_Подтверждение.НайтиОжидающиеApprovalЗапускаБезПривилегий(Контекст.RunId);
	ЮТест.ОжидаетЧто(Ожидающие.Количество()).Равно(2);

	ЮТест.ОжидаетЧто(
		ar_Подтверждение.ЗакрытьОжидающиеApprovalЗапуска(Контекст.RunId)).ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId1)).Равно("cancelled")
		.Что(ОМ_ar_ТестовыеДанные.СтатусОчереди(ApprovalId2)).Равно("cancelled");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовка запуска: провайдер, агент (Ручной), запись запуска, контекст
// постановки в очередь.
//
Функция ПодготовкаЗапуска()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("RunId", RunId);
	КонтекстЗапуска.Вставить("Sequence", 0);

	Возврат Новый Структура("RunId, КонтекстЗапуска", RunId, КонтекстЗапуска);

КонецФункции

// Действие для постановки в очередь (get_constants - безопасный ядровой tool).
//
Функция Действие()

	Возврат ДействиеСИменем("get_constants");

КонецФункции

// Действие с заданным именем инструмента.
//
Функция ДействиеСИменем(Знач ИмяTool)

	Возврат Новый Структура("Имя, Аргументы, Обоснование",
		ИмяTool, "{}", "Тестовое действие");

КонецФункции

// Пустая ссылка пользователя (Пользователи) - допустима по контракту.
//
Функция ПустойПользователь()

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Состаривает запись очереди: ar_СозданоВ = текущий сеанс - (TTL + 1 час).
//
Процедура СостаритьЗаписьОчереди(Знач ApprovalId)

	ГраницаИстечения = ar_Константы.ApprovalExpirationЧасов() * 3600;
	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ApprovalId;
	Запись.Прочитать();
	Запись.ar_СозданоВ = ТекущаяДатаСеанса() - ГраницаИстечения - 3600;
	Запись.Записать(Истина);

КонецПроцедуры

// Создаёт запись очереди типа «вопрос» (статус awaiting_input) напрямую.
//
Функция ЗаписатьВопросОчереди(Знач RunId)

	Payload = Новый Структура;
	Payload.Вставить("ask_user", Истина);
	Payload.Вставить("tool_name", "ask_user");
	Payload.Вставить("question", "Тестовый вопрос агенту");

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = RunId;
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = ar_JSON.ВЗначениеJSON(Payload);
	Запись.ar_Статус = "awaiting_input";
	Запись.ar_СозданоВ = ТекущаяДатаСеанса();
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Проверяет, что массив строк содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Заполняет реестр инструментов ядровыми описаниями.
//
Процедура ЗарегистрироватьЯдровойРеестр()

	ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools();

КонецПроцедуры

#КонецОбласти
