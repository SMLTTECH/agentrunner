КонецФункции

// Пустая ссылка пользователя (Пользователи) - допустима по контракту.
//
Функция ПустойПользователь()

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Состаривает запись очереди: ar_СозданоВ = текущий сеанс - (TTL + 1 час).
//
Процедура СостаритьЗаписьОчереди(Знач ApprovalId)

	ГраницаИстечения = ar_Константы.ApprovalExpirationЧасов() * 3600;
	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ApprovalId;
	Запись.Прочитать();
	Запись.ar_СозданоВ = ТекущаяДатаСеанса() - ГраницаИстечения - 3600;
	Запись.Записать(Истина);

КонецПроцедуры

// Создаёт запись очереди типа «вопрос» (статус awaiting_input) напрямую.
//
Функция ЗаписатьВопросОчереди(Знач RunId)

	Payload = Новый Структура;
	Payload.Вставить("ask_user", Истина);
	Payload.Вставить("tool_name", "ask_user");
	Payload.Вставить("question", "Тестовый вопрос агенту");

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = RunId;
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = ar_JSON.ВЗначениеJSON(Payload);
	Запись.ar_Статус = "awaiting_input";
	Запись.ar_СозданоВ = ТекущаяДатаСеанса();
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Проверяет, что массив строк содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Заполняет реестр инструментов ядровыми описаниями.
//
Процедура ЗарегистрироватьЯдровойРеестр()

	ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools();

КонецПроцедуры

// Создает запись очереди со статусом answered (прямая запись менеджером -
// регистр допускает, состояние запуска настраивается отдельно).
//
// Параметры:
//  RunId    - Строка - идентификатор запуска;
//  СозданоВ - Дата   - момент постановки записи (для отбора актуального).
//
// Возвращаемое значение:
//  Строка - ApprovalId созданной записи.
//
Функция ЗаписатьОтветОчереди(Знач RunId, Знач СозданоВ)

	Запись = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	Запись.ar_ApprovalId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	Запись.ar_RunId = RunId;
	Запись.ar_Sequence = 0;
	Запись.ar_ActionPayloadJSON = "{""ask_user"": Истина}";
	Запись.ar_Статус = "answered";
	Запись.ar_СозданоВ = СозданоВ;
	Запись.ar_РешеноВ = СозданоВ;
	Запись.Записать(Истина);

	Возврат Запись.ar_ApprovalId;

КонецФункции

// Переводит запись запуска в статус "Ожидание ввода" (условие выборки
// отвеченных): Создать перезаписывает запись по ar_ИдентификаторЗапуска.
//
Процедура ПеревестиВОжиданиеВвода(Знач RunId)

	ДанныеВвода = Новый Структура;
	ДанныеВвода.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода);
	ar_AuditЗапуски.Создать(RunId, ДанныеВвода);

КонецПроцедуры

// Запуск с агентом в статусе Выполняется - для тестов захвата предмета.
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовкаЗапускаДляЗахвата()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

// Массив ответов сценария из переданных элементов (до шести).
//
Функция МассивОтветов(Знач Ответ1, Знач Ответ2 = Неопределено, Знач Ответ3 = Неопределено,
	Знач Ответ4 = Неопределено, Знач Ответ5 = Неопределено, Знач Ответ6 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Ответ1);
	Если Ответ2 <> Неопределено Тогда
		Массив.Добавить(Ответ2);
	КонецЕсли;
	Если Ответ3 <> Неопределено Тогда
		Массив.Добавить(Ответ3);
	КонецЕсли;
	Если Ответ4 <> Неопределено Тогда
		Массив.Добавить(Ответ4);
	КонецЕсли;
	Если Ответ5 <> Неопределено Тогда
		Массив.Добавить(Ответ5);
	КонецЕсли;
	Если Ответ6 <> Неопределено Тогда
		Массив.Добавить(Ответ6);
	КонецЕсли;
	Возврат Массив;

КонецФункции

#КонецОбласти
