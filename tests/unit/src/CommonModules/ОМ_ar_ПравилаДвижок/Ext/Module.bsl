///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПравилаДвижок.
//
// Тесты движка разрешений (ar_ПравилаДвижок): порядок уровней проверок
// РазрешитьДействие (agent_data_missing -> empty_tool_name -> tool_not_found
// -> tool_disabled -> tool_misconfigured -> whitelist -> роль -> лимиты ->
// Guard запрещённых объектов -> режим автономии), исключения ask_user /
// update_plan, матрица «режим автономии x уровень риска» на все 16 сочетаний
// (параметризованный тест), реестр ar_ЗапрещённыеОбъекты (ОбъектЗапрещён:
// точный тип, wildcard, режимы запрета; инструмент записи по запрещённому
// объекту - deny, в том числе при DryRun).
//
// Сценарии раздела 2 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ПорядокУровнейПроверок")
		.ДобавитьСерверныйТест("ОтсутствующиеДанныеАгентаОтклоняются").Тег("critical")
		.ДобавитьСерверныйТест("ПустоеИмяToolОтклоняется").Тег("critical")
		.ДобавитьСерверныйТест("НеизвестныйToolОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтключённыйToolОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НеконфигурированныйЯдровойToolОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ToolНеИзБелогоСпискаОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("WhitelistПоОверрайдуДиалога").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("WhitelistРежимБезАгента").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("AskUserПроходитБезБелогоСписка").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("UpdatePlanПроходитТолькоПриПланировании").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("МатрицаРежимРиск")
		.ДобавитьСерверныйТест("Матрица16Сочетаний").Тег("critical").ВТранзакции()
			.СПараметрами("ТолькоЧтение", "Чтение", "allow", "")
			.СПараметрами("ТолькоЧтение", "Черновик", "deny", "read_only_agent_write_attempt")
			.СПараметрами("ТолькоЧтение", "Запись", "deny", "read_only_agent_write_attempt")
			.СПараметрами("ТолькоЧтение", "Фиксация", "deny", "read_only_agent_write_attempt")
			.СПараметрами("Ручной", "Чтение", "allow", "")
			.СПараметрами("Ручной", "Черновик", "approval_required", "manual_mode_non_read_action")
			.СПараметрами("Ручной", "Запись", "approval_required", "manual_mode_non_read_action")
			.СПараметрами("Ручной", "Фиксация", "approval_required", "manual_mode_non_read_action")
			.СПараметрами("АвтоПорог", "Чтение", "allow", "")
			.СПараметрами("АвтоПорог", "Черновик", "allow", "")
			.СПараметрами("АвтоПорог", "Запись", "approval_required", "auto_threshold_high_risk")
			.СПараметрами("АвтоПорог", "Фиксация", "approval_required", "auto_threshold_high_risk")
			.СПараметрами("Автономный", "Чтение", "allow", "")
			.СПараметрами("Автономный", "Черновик", "allow", "")
			.СПараметрами("Автономный", "Запись", "allow", "")
			.СПараметрами("Автономный", "Фиксация", "approval_required", "commit_always_requires_approval");

	ЮТТесты
		.ДобавитьТестовыйНабор("ОсобыеПравилаРежимов")
		.ДобавитьСерверныйТест("ФлагПодтвержденияТребуетApproval").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ФлагПодтвержденияНеСпасаетВТолькоЧтение").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустойРежимРаботаетКакРучной").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("RememberРазрешёнБезПодтверждения").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ЗапрещённыеОбъекты")
		.ДобавитьСерверныйТест("ЗапретПоТочномуТипуИРежиму").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗапретПоШаблонуЗвёздочкаПобеждает").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ИнструментЗаписиПоЗапрещённомуОбъектуОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗапретДействуетИПриDryRun").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// 2.х Уровень 0: ДанныеАгента = Неопределено -> deny agent_data_missing.
Процедура ОтсутствующиеДанныеАгентаОтклоняются() Экспорт

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		Неопределено, ДействиеИнструмента("get_constants"), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("agent_data_missing");

КонецПроцедуры

// 2.х Уровень 0: пустое имя tool (нет ключей Имя/name) -> deny
// empty_tool_name.
Процедура ПустоеИмяToolОтклоняется() Экспорт

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(), Новый Структура, КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("empty_tool_name");

КонецПроцедуры

// 2.х Уровень L0: tool нет в реестре -> deny tool_not_found.
Процедура НеизвестныйToolОтклоняется() Экспорт

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(),
		ДействиеИнструмента("нет_такого_инструмента"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("tool_not_found");

КонецПроцедуры

// 2.х Уровень L0: tool отключён -> deny tool_disabled.
Процедура ОтключённыйToolОтклоняется() Экспорт

	СсылкаTool = ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_отключённый",
		Перечисления.ar_УровеньРиска.Чтение);
	ОбъектTool = СсылкаTool.ПолучитьОбъект();
	ОбъектTool.ar_Включён = Ложь;
	ОбъектTool.Записать();

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(),
		ДействиеИнструмента("тест_отключённый"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("tool_disabled");

КонецПроцедуры

// 2.х Уровень L0: ядровой tool без модуля/процедуры -> deny
// tool_misconfigured.
Процедура НеконфигурированныйЯдровойToolОтклоняется() Экспорт

	Tool = Справочники.ar_Инструменты.СоздатьЭлемент();
	Tool.Наименование = "тест_неконфигурированный";
	Tool.ar_Имя = "тест_неконфигурированный";
	Tool.ar_Включён = Истина;
	Tool.ar_RiskLevel = Перечисления.ar_УровеньРиска.Чтение;
	Tool.ar_ОбщийМодуль = "";
	Tool.ar_ИмяПроцедуры = "";
	Tool.Записать();

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(),
		ДействиеИнструмента("тест_неконфигурированный"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("tool_misconfigured");

КонецПроцедуры

// 2.х Уровень L1: tool вне явного белого списка агента -> deny
// tool_not_in_whitelist.
Процедура ToolНеИзБелогоСпискаОтклоняется() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("list_catalogs"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаПоСсылке(Агент),
		ДействиеИнструмента("get_constants"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("tool_not_in_whitelist");

КонецПроцедуры

// 2.х Уровень L1: у агента с переопределённым в диалоге набором (UI-30,
// КонтекстЗапуска.ОверрайдTools) whitelist проверяется по оверрайду: tool из
// оверрайда разрешён, tool из ТЧ агента, но вне оверрайда, отклоняется.
Процедура WhitelistПоОверрайдуДиалога() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_оверрайд_в_списке",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_агентский_вне_оверрайда",
		Перечисления.ar_УровеньРиска.Чтение);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("тест_агентский_вне_оверрайда"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Контекст = КонтекстЗапуска();
	Контекст.Вставить("ОверрайдTools", МассивСтрок("тест_оверрайд_в_списке"));

	РешениеИзОверрайда = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаПоСсылке(Агент),
		ДействиеИнструмента("тест_оверрайд_в_списке"),
		Контекст);

	РешениеВнеОверрайда = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаПоСсылке(Агент),
		ДействиеИнструмента("тест_агентский_вне_оверрайда"),
		Контекст);

	ЮТест.ОжидаетЧто(РешениеИзОверрайда.Решение).Равно("allow")
		.Что(РешениеВнеОверрайда.Решение).Равно("deny")
		.Что(РешениеВнеОверрайда.Причина).Равно("tool_not_in_whitelist");

КонецПроцедуры

// 2.х Уровень L1: режим «без агента» (UI-22) не имеет ТЧ ДоступныеTools -
// whitelist проверяется только по КонтекстЗапуска.ОверрайдTools: tool из
// списка разрешён, tool вне списка отклоняется с tool_not_in_whitelist.
Процедура WhitelistРежимБезАгента() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_безагента_в_списке",
		Перечисления.ar_УровеньРиска.Чтение);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_безагента_вне_списка",
		Перечисления.ar_УровеньРиска.Чтение);

	Контекст = КонтекстЗапуска();
	Контекст.Вставить("БезАгента", Истина);
	Контекст.Вставить("ОверрайдTools", МассивСтрок("тест_безагента_в_списке"));

	РешениеИзСписка = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(),
		ДействиеИнструмента("тест_безагента_в_списке"),
		Контекст);

	РешениеВнеСписка = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаИзСтруктуры(),
		ДействиеИнструмента("тест_безагента_вне_списка"),
		Контекст);

	ЮТест.ОжидаетЧто(РешениеИзСписка.Решение).Равно("allow")
		.Что(РешениеВнеСписка.Решение).Равно("deny")
		.Что(РешениеВнеСписка.Причина).Равно("tool_not_in_whitelist");

КонецПроцедуры
Процедура AskUserПроходитБезБелогоСписка() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("ask_user",
		Перечисления.ar_УровеньРиска.Чтение);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("другое_имя"));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаПоСсылке(Агент),
		ДействиеИнструмента("ask_user"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

// 2.х Исключение whitelist: update_plan проходит только при включённом
// планировании агента.
Процедура UpdatePlanПроходитТолькоПриПланировании() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("update_plan",
		Перечисления.ar_УровеньРиска.Чтение);
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок("другое_имя"));

	Параметры.Вставить("ПланироватьРаботу", Истина);
	АгентСПланом = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	ДанныеСПланом = ДанныеАгентаПоСсылке(АгентСПланом);
	ДанныеСПланом.ПланироватьРаботу = Истина;
	РешениеПлан = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеСПланом,
		ДействиеИнструмента("update_plan"),
		КонтекстЗапуска());

	Параметры.ПланироватьРаботу = Ложь;
	АгентБезПлана = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);
	РешениеБезПлана = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаПоСсылке(АгентБезПлана),
		ДействиеИнструмента("update_plan"),
		КонтекстЗапуска());

	ЮТест.ОжидаетЧто(РешениеПлан.Решение).Равно("allow")
		.Что(РешениеБезПлана.Решение).Равно("deny")
		.Что(РешениеБезПлана.Причина).Равно("tool_not_in_whitelist");

КонецПроцедуры

// 2.х Матрица «режим автономии x уровень риска» - все 16 сочетаний.
// Параметры: РежимСтрока, УровеньСтрока, ОжидаемоеРешение, ОжидаемаяПричина.
Процедура Матрица16Сочетаний(Знач РежимСтрока, Знач УровеньСтрока,
	Знач ОжидаемоеРешение, Знач ОжидаемаяПричина) Экспорт

	ИмяИнструмента = "тест_матрица_" + НРег(УровеньСтрока);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент(ИмяИнструмента, УровеньРиска(УровеньСтрока));

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("РежимАвтономии", РежимАвтономии(РежимСтрока));
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок(ИмяИнструмента));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	ДанныеАгента = ДанныеАгентаСРежимом(РежимАвтономии(РежимСтрока));
	ДанныеАгента.Ссылка = Агент;

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгента, ДействиеИнструмента(ИмяИнструмента), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно(ОжидаемоеРешение);
	Если Не ПустаяСтрока(ОжидаемаяПричина) Тогда
		ЮТест.ОжидаетЧто(Решение.Причина).Равно(ОжидаемаяПричина);
	КонецЕсли;

КонецПроцедуры

// 2.х Флаг «требует подтверждения» -> approval_required в любом режиме
// (кроме ТолькоЧтение), даже на уровне Чтение.
Процедура ФлагПодтвержденияТребуетApproval() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_с_подтверждением",
		Перечисления.ar_УровеньРиска.Чтение, Истина);
	ДанныеАгента = ДанныеАгентаСTool("тест_с_подтверждением",
		Перечисления.ar_РежимАвтономии.Автономный);

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгента, ДействиеИнструмента("тест_с_подтверждением"), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("approval_required")
		.Свойство("Причина").Равно("tool_requires_approval");

КонецПроцедуры

// 2.х В режиме ТолькоЧтение флаг подтверждения не спасает: запись всё равно
// deny (проверка режима стоит раньше флага).
Процедура ФлагПодтвержденияНеСпасаетВТолькоЧтение() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_запись_с_подтверждением",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ДанныеАгента = ДанныеАгентаСTool("тест_запись_с_подтверждением",
		Перечисления.ar_РежимАвтономии.ТолькоЧтение);

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгента, ДействиеИнструмента("тест_запись_с_подтверждением"), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("read_only_agent_write_attempt");

КонецПроцедуры

// 2.х Пустой режим автономии работает как Ручной: запись -> approval_required.
Процедура ПустойРежимРаботаетКакРучной() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_пустой_режим",
		Перечисления.ar_УровеньРиска.Запись);
	ДанныеАгента = ДанныеАгентаСTool("тест_пустой_режим",
		Перечисления.ar_РежимАвтономии.ПустаяСсылка());

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгента, ДействиеИнструмента("тест_пустой_режим"), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("approval_required")
		.Свойство("Причина").Равно("manual_mode_non_read_action");

КонецПроцедуры

// 2.х remember разрешён без подтверждения (в обход порога режима).
Процедура RememberРазрешёнБезПодтверждения() Экспорт

	ОМ_ar_ТестовыеДанные.НовыйИнструмент("remember",
		Перечисления.ar_УровеньРиска.Фиксация);
	ДанныеАгента = ДанныеАгентаСTool("remember",
		Перечисления.ar_РежимАвтономии.Ручной);

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгента, ДействиеИнструмента("remember"), КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

// 2.х ОбъектЗапрещён: точный тип + режимы запрета (Запись / Удаление / Любое).
Процедура ЗапретПоТочномуТипуИРежиму() Экспорт

	ЗаписатьЗапрет("Справочник.Валюты", Перечисления.ar_РежимЗапретаЗаписи.Запись);

	ЮТест.ОжидаетЧто(
		ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Валюты",
			Перечисления.ar_РежимЗапретаЗаписи.Запись)).ЭтоИстина()
		.Что(ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Валюты",
			Перечисления.ar_РежимЗапретаЗаписи.Удаление)).ЭтоЛожь()
		.Что(ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Валюты",
			Перечисления.ar_РежимЗапретаЗаписи.Любое)).ЭтоЛожь()
		.Что(ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Контрагенты",
			Перечисления.ar_РежимЗапретаЗаписи.Запись)).ЭтоЛожь();

КонецПроцедуры

// 2.х Запрет по шаблону «*» с режимом «Любое» действует на любой тип и режим.
Процедура ЗапретПоШаблонуЗвёздочкаПобеждает() Экспорт

	ЗаписатьЗапрет("*", Перечисления.ar_РежимЗапретаЗаписи.Любое);

	ЮТест.ОжидаетЧто(
		ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Валюты",
			Перечисления.ar_РежимЗапретаЗаписи.Запись)).ЭтоИстина()
		.Что(ar_ПравилаДвижок.ОбъектЗапрещён("Справочник.Валюты",
			Перечисления.ar_РежимЗапретаЗаписи.Удаление)).ЭтоИстина()
		.Что(ar_ПравилаДвижок.ОбъектЗапрещён("Документ.ЗаказКлиента",
			Перечисления.ar_РежимЗапретаЗаписи.Любое)).ЭтоИстина();

КонецПроцедуры

// 2.х Инструмент записи по запрещённому объекту -> deny
// object_write_forbidden (Guard уровня L3.5).
Процедура ИнструментЗаписиПоЗапрещённомуОбъектуОтклоняется() Экспорт

	ЗаписатьЗапрет("Справочник.Валюты", Перечисления.ar_РежимЗапретаЗаписи.Запись);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_запись_валют",
		Перечисления.ar_УровеньРиска.Запись);

	Действие = ДействиеИнструмента("тест_запись_валют");
	Действие.Вставить("Аргументы", АргументыСТипомОбъекта("Справочник.Валюты"));

	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаСTool("тест_запись_валют",
		Перечисления.ar_РежимАвтономии.Автономный),
		Действие, КонтекстЗапуска());

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny");
	ЮТест.ОжидаетЧто(СтрНайти(Решение.Причина, "object_write_forbidden") = 1).ЭтоИстина();

КонецПроцедуры

// 2.х DryRun не обходит запрет: инструмент записи по запрещённому объекту
// остаётся deny и при DryRun.
Процедура ЗапретДействуетИПриDryRun() Экспорт

	ЗаписатьЗапрет("Справочник.Валюты", Перечисления.ar_РежимЗапретаЗаписи.Запись);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_запись_валют_dry",
		Перечисления.ar_УровеньРиска.Запись);

	Действие = ДействиеИнструмента("тест_запись_валют_dry");
	Действие.Вставить("Аргументы", АргументыСТипомОбъекта("Справочник.Валюты"));

	Контекст = КонтекстЗапуска();
	Контекст.Вставить("DryRun", Истина);
	Решение = ar_ПравилаДвижок.РазрешитьДействие(
		ДанныеАгентаСTool("тест_запись_валют_dry",
		Перечисления.ar_РежимАвтономии.Автономный),
		Действие, Контекст);

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("deny");
	ЮТест.ОжидаетЧто(СтрНайти(Решение.Причина, "object_write_forbidden") = 1).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает запрет объекта в реестр ar_ЗапрещённыеОбъекты.
//
Процедура ЗаписатьЗапрет(Знач ТипОбъекта, Знач РежимЗапрета)

	Запись = РегистрыСведений.ar_ЗапрещённыеОбъекты.СоздатьМенеджерЗаписи();
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.РежимЗапрета = РежимЗапрета;
	Запись.Включен = Истина;
	Запись.Причина = "Тестовый запрет";
	Запись.Записать(Истина);

КонецПроцедуры

// ДанныеАгента без ссылки (для уровней, не требующих белого списка).
//
Функция ДанныеАгентаИзСтруктуры()

	Возврат ДанныеАгентаСРежимом(Перечисления.ar_РежимАвтономии.Ручной);

КонецФункции

// ДанныеАгента с пустой ссылкой агента и заданным режимом.
//
Функция ДанныеАгентаСРежимом(Знач РежимАвтономии)

	ДанныеАгента = Новый Структура;
	ДанныеАгента.Вставить("Ссылка", Справочники.ar_Агенты.ПустаяСсылка());
	ДанныеАгента.Вставить("РежимАвтономии", РежимАвтономии);
	ДанныеАгента.Вставить("ИмяРоли1С", "");
	ДанныеАгента.Вставить("ПланироватьРаботу", Ложь);
	ДанныеАгента.Вставить("МаксДействий", 0);
	ДанныеАгента.Вставить("МаксСуммаДействия", 0);
	Возврат ДанныеАгента;

КонецФункции

// ДанныеАгента по ссылке реального агента (для проверок белого списка).
//
Функция ДанныеАгентаПоСсылке(Знач Агент)

	ДанныеАгента = ДанныеАгентаСРежимом(Перечисления.ar_РежимАвтономии.Ручной);
	ДанныеАгента.Ссылка = Агент;
	Возврат ДанныеАгента;

КонецФункции

// Действие вызова инструмента: {Имя}.
//
Функция ДействиеИнструмента(Знач ИмяTool)

	Возврат Новый Структура("Имя", ИмяTool);

КонецФункции

// Аргументы действия с указанием типа объекта (для Guard).
//
Функция АргументыСТипомОбъекта(Знач ТипОбъекта)

	Аргументы = Новый Соответствие;
	Аргументы.Вставить("object_type", ТипОбъекта);
	Возврат Аргументы;

КонецФункции

// Минимальный контекст запуска.
//
Функция КонтекстЗапуска()

	Контекст = Новый Структура;
	Контекст.Вставить("RunId", ОМ_ar_ТестовыеДанные.НовыйRunId());
	Контекст.Вставить("Sequence", 0);
	Контекст.Вставить("DryRun", Ложь);
	Возврат Контекст;

КонецФункции

// Значение перечисления ar_РежимАвтономии по имени.
//
Функция РежимАвтономии(Знач Имя)

	Возврат Перечисления.ar_РежимАвтономии[Имя];

КонецФункции

// Значение перечисления ar_УровеньРиска по имени.
//
Функция УровеньРиска(Знач Имя)

	Возврат Перечисления.ar_УровеньРиска[Имя];

КонецФункции

// ДанныеАгента по реальному агенту с включённым tool в белом списке:
// L1 (whitelist) проверяет ТЧ ar_ДоступныеИнструменты агента, у ПустаяСсылка
// эффективный набор пуст (SCALE-07) - иначе режимы/риски недостижимы.
//
// Параметры:
//  ИмяTool - Строка - имя инструмента для белого списка;
//  Режим - ПеречислениеСсылка.ar_РежимАвтономии - режим агента.
//
// Возвращаемое значение:
//  Структура - ДанныеАгента со ссылкой реального агента.
//
Функция ДанныеАгентаСTool(Знач ИмяTool, Знач Режим)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("РежимАвтономии", Режим);
	Параметры.Вставить("ДоступныеИнструменты", МассивСтрок(ИмяTool));
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	Возврат ДанныеАгентаПоСсылкеСРежимом(Агент, Режим);

КонецФункции

// ДанныеАгентаСРежимом со ссылкой на реального агента (режим проверки может
// отличаться от режима агента - проверка конкретного сочетания режим x риск).
Функция ДанныеАгентаПоСсылкеСРежимом(Знач Агент, Знач Режим)

	ДанныеАгента = ДанныеАгентаСРежимом(Режим);
	ДанныеАгента.Ссылка = Агент;
	Возврат ДанныеАгента;

КонецФункции

// Массив из одной строки.
//
Функция МассивСтрок(Знач Строка1)

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Возврат Массив;

КонецФункции

#КонецОбласти
