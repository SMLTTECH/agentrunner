///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль СТ_НСИПроверка.
//
// Сквозной тест процесса НСИ, набор 2 «проверка» (agentrunner-226): по заявкам
// прогона (созданы набором СТ_НСИСоздание) сверяет итог процесса с ожиданиями
// сценария - визы, запуски агента, созданные контрагент и счёт, диалог, события
// служебного лога.
//
// Сценарий, который агент ещё обрабатывает, тест пропускает с сообщением,
// начинающимся с СТ_НСИОбщий.ПризнакОжидания(): AR (ar e2e) повторяет набор, пока
// такие сценарии есть и не истёк срок прогона. Набор отвечает на вопрос агента
// (поле answer сценария) и создаёт заявку сценария с полем after, когда сценарий-
// предшественник пройден.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("СквознойТестНСИПроверка");
	Для Каждого Сценарий Из СТ_НСИОбщий.Сценарии() Цикл
		Набор.ДобавитьСерверныйТест("ПроверитьСценарий",
				СтрШаблон("%1: %2", Сценарий.Получить("id"), Сценарий.Получить("title")))
			.СПараметрами(Сценарий.Получить("id"));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сверяет итог сценария с ожиданиями; незавершённый сценарий пропускается.
//
// Параметры:
//  Идентификатор - Строка - id сценария.
//
Процедура ПроверитьСценарий(Идентификатор) Экспорт

	Сценарий = СТ_НСИОбщий.Сценарий(Идентификатор);
	Состояние = СТ_НСИОбщий.СостояниеПрогона();
	ЮТест.ОжидаетЧто(Состояние.Идентификатор, НСтр("ru = 'Метка прогона (набор СТ_НСИСоздание)'"))
		.Заполнено();

	Заявка = Состояние.Заявки.Получить(Идентификатор);
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		СоздатьОтложеннуюЗаявку(Сценарий, Состояние); // завершает тест пропуском или ошибкой
		Возврат;
	КонецЕсли;

	Факты = СТ_НСИОбщий.ФактыЗаявки(Заявка);
	Описание = СТ_НСИОбщий.ПредставлениеФактов(Заявка, Факты);

	Переспросил = Ложь;
	Если ЗначениеЗаполнено(Факты.ВопросАгента) Тогда
		Если Сценарий.Получить("answer") = Неопределено Тогда
			// Сценарий ответа не предусматривает: ждать бесполезно - запуск стоит до срока ответа.
			ТекстОшибки = НСтр("ru = 'агент ждёт ответа, сценарий его не предусматривает. Вопрос: %1. %2'");
			ВызватьИсключение СтрШаблон(ТекстОшибки, Факты.ТекстВопроса, Описание);
		КонецЕсли;
		Отвеченный = Состояние.Ответы.Получить(Идентификатор);
		Если Не ЗначениеЗаполнено(Отвеченный) Тогда
			ОтветитьНаВопрос(Сценарий, Факты, Состояние, Описание); // завершает тест пропуском или ошибкой
			Возврат;
		ИначеЕсли Отвеченный = Факты.ВопросАгента Тогда
			ПропуститьОжидание(СтрШаблон(НСтр("ru = 'ответ дан, запуск еще не возобновлен. %1'"), Описание));
			Возврат;
		КонецЕсли;
		// Новый вопрос после ответа: агент переспросил. Отвечаем один раз - дальше это итог
		// сценария, допустимый только при ask_again_allowed (решения по визе нет).
		Если Сценарий.Получить("expect").Получить("ask_again_allowed") <> Истина Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'после ответа агент задал новый вопрос: %1. %2'"),
				Факты.ТекстВопроса, Описание);
		КонецЕсли;
		Переспросил = Истина;
	КонецЕсли;

	Если Не Переспросил И ИдётОбработка(Сценарий, Факты) Тогда
		ПропуститьОжидание(Описание);
		Возврат;
	КонецЕсли;

	Расхождения = СТ_НСИОбщий.Расхождения(Сценарий, Факты);
	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), Описание).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первый вопрос агента по сценарию: структура вопроса (номер заявки, ИНН, ссылка на
// карточку) проверяется до ответа; затем ответ путем answer_via, ApprovalId
// запоминается в состоянии прогона - на вопрос сценария отвечаем один раз.
Процедура ОтветитьНаВопрос(Знач Сценарий, Знач Факты, Состояние, Знач Описание)

	РасхожденияВопроса = СТ_НСИОбщий.РасхожденияВопроса(Сценарий, Факты);
	ЮТест.ОжидаетЧто(СтрСоединить(РасхожденияВопроса, "; "),
		СтрШаблон(НСтр("ru = 'Структура вопроса агента: %1'"), Факты.ТекстВопроса)).Равно("");

	Итог = СТ_НСИОбщий.ОтветитьАгенту(Сценарий, Факты);
	Если Не Итог.Принят Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'ответ «%1» путем %2 не принят: %3. %4'"), Сценарий.Получить("answer"),
			Итог.Путь, Итог.Сообщение, Описание);
	КонецЕсли;
	Состояние.Ответы.Вставить(Сценарий.Получить("id"), Факты.ВопросАгента);
	СТ_НСИОбщий.СохранитьСостояниеПрогона(Состояние);

	ПропуститьОжидание(СтрШаблон(НСтр("ru = 'агенту дан ответ «%1» путем %2, ждем возобновления запуска. %3'"),
		Сценарий.Получить("answer"), Итог.Путь, Описание));

КонецПроцедуры

// Агент ещё работает со сценарием: запуска нет, запуск не завершён, либо этап 1
// согласован, а визу этапа 2, которую ждёт сценарий, агент возьмёт следующим запуском.
Функция ИдётОбработка(Знач Сценарий, Знач Факты)

	Если Факты.Запуски.Количество() = 0 Или Факты.ИдётОбработка Тогда
		Возврат Истина;
	КонецЕсли;

	Визы = Сценарий.Получить("expect").Получить("visas");
	Если Визы = Неопределено Или Визы.Получить("2") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ВизаЭтап1 = Факты.Визы.Получить("1");
	ВизаЭтап2 = Факты.Визы.Получить("2");

	Возврат ВизаЭтап1 <> Неопределено И ВизаЭтап1.Решение = Визы.Получить("1")
		И (ВизаЭтап2 = Неопределено Или Не ЗначениеЗаполнено(ВизаЭтап2.Решение));

КонецФункции

// Заявка сценария с полем after (дубль): создаётся, когда сценарий-предшественник
// пройден (его контрагент создан). Тест пропускается в любом случае: проверять новую
// заявку рано, её возьмёт агент.
Процедура СоздатьОтложеннуюЗаявку(Знач Сценарий, Состояние)

	Предшественник = Сценарий.Получить("after");
	Если Предшественник = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Заявка сценария не создана набором СТ_НСИСоздание (см. тест сценария в нём)'");
	КонецЕсли;

	ЗаявкаПредшественника = Состояние.Заявки.Получить(Предшественник);
	Если Не ЗначениеЗаполнено(ЗаявкаПредшественника) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет заявки сценария-предшественника %1'"), Предшественник);
	КонецЕсли;
	ФактыПредшественника = СТ_НСИОбщий.ФактыЗаявки(ЗаявкаПредшественника);
	ОписаниеПредшественника = СТ_НСИОбщий.Сценарий(Предшественник);
	Если ИдётОбработка(ОписаниеПредшественника, ФактыПредшественника) Тогда
		ПропуститьОжидание(СтрШаблон(НСтр("ru = 'сценарий %1 ещё не завершён, заявка дубля не создана'"),
			Предшественник));
		Возврат;
	КонецЕсли;
	Расхождения = СТ_НСИОбщий.Расхождения(ОписаниеПредшественника, ФактыПредшественника);
	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "),
		СтрШаблон(НСтр("ru = 'Сценарий-предшественник %1 не пройден - дубль не проверяется'"),
			Предшественник)).Равно("");

	Заявка = СТ_НСИОбщий.СоздатьЗаявку(Сценарий, Состояние.Идентификатор);
	Состояние.Заявки.Вставить(Сценарий.Получить("id"), Заявка);
	Состояние.История.Добавить(Заявка);
	СТ_НСИОбщий.СохранитьСостояниеПрогона(Состояние);
	ПропуститьОжидание(СтрШаблон(НСтр("ru = 'создана заявка %1, ждём агента'"), Заявка));

КонецПроцедуры

Процедура ПропуститьОжидание(Знач Подробности)

	ЮТест.Пропустить(СтрШаблон("%1: %2", СТ_НСИОбщий.ПризнакОжидания(), Подробности));

КонецПроцедуры

#КонецОбласти
