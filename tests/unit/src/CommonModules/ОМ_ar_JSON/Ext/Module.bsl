///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_JSON.
//
// Тесты JSON-помощника (ar_JSON): ИзJSON / ВЗначениеJSON туда и обратно,
// невалидный текст (Неопределено, без исключения), ВалидироватьПоСхеме
// (обязательные поля, типы, дополнительные поля), ПроверитьРазмерАргументов
// (граница включающая, лимит 0 отключает проверку).
//
// Сценарии раздела 8 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Сериализация")
		.ДобавитьСерверныйТест("ТудуИОбратно").Тег("critical")
		.ДобавитьСерверныйТест("НевалидныйТекстБезИсключения").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("Валидация")
		.ДобавитьСерверныйТест("СхемаОбязательныеПоляИТипы").Тег("critical")
		.ДобавитьСерверныйТест("РазмерАргументовГраницы").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// ВЗначениеJSON -> ИзJSON: структура данных восстанавливается.
Процедура ТудуИОбратно() Экспорт

	Исходное = Новый Структура;
	Исходное.Вставить("name", "get_constants");
	Исходное.Вставить("count", 42);
	Исходное.Вставить("flag", Истина);

	Текст = ar_JSON.ВЗначениеJSON(Исходное);
	Восстановленное = ar_JSON.ИзJSON(Текст);

	ЮТест.ОжидаетЧто(Текст).Заполнено();
	ЮТест.ОжидаетЧто(Восстановленное <> Неопределено).ЭтоИстина();
	ЮТест.ОжидаетЧто(Восстановленное.Получить("name")).Равно("get_constants")
		.Что(Восстановленное.Получить("count")).Равно(42)
		.Что(Восстановленное.Получить("flag")).ЭтоИстина();

КонецПроцедуры

// Невалидный текст -> Неопределено без исключения; Неопределено -> "null".
Процедура НевалидныйТекстБезИсключения() Экспорт

	ЮТест.ОжидаетЧто(ar_JSON.ИзJSON("{битый json")).Равно(Неопределено)
		.Что(ar_JSON.ИзJSON("")).Равно(Неопределено)
		.Что(ar_JSON.ИзJSON(Неопределено)).Равно(Неопределено)
		.Что(ar_JSON.ВЗначениеJSON(Неопределено)).Равно("null");

КонецПроцедуры

// ВалидироватьПоСхеме: обязательные поля и типы; без схемы - корректно.
Процедура СхемаОбязательныеПоляИТипы() Экспорт

	Схема = ar_JSON.ИзJSON(
		"{""type"": ""object"",
		|""required"": [""name""],
		|""properties"": {""name"": {""type"": ""string""}, ""count"": {""type"": ""number""}}}");

	Корректно = ar_JSON.ИзJSON("{""name"": ""инструмент"", ""count"": 3}");
	ИтогКорректно = ar_JSON.ВалидироватьПоСхеме(Корректно, Схема);
	ЮТест.ОжидаетЧто(ИтогКорректно).Свойство("Корректно").ЭтоИстина()
		.Что(ИтогКорректно.Ошибки.Количество()).Равно(0);

	БезИмени = ar_JSON.ИзJSON("{""count"": 3}");
	ИтогБезИмени = ar_JSON.ВалидироватьПоСхеме(БезИмени, Схема);
	ЮТест.ОжидаетЧто(ИтогБезИмени).Свойство("Корректно").ЭтоЛожь()
		.Что(ИтогБезИмени.Ошибки.Количество()).Больше(0);

	НеТоТип = ar_JSON.ИзJSON("{""name"": 15}");
	ИтогНеТоТип = ar_JSON.ВалидироватьПоСхеме(НеТоТип, Схема);
	ЮТест.ОжидаетЧто(ИтогНеТоТип.Корректно).ЭтоЛожь();

	БезСхемы = ar_JSON.ВалидироватьПоСхеме(Корректно, Неопределено);
	ЮТест.ОжидаетЧто(БезСхемы.Корректно).ЭтоИстина();

КонецПроцедуры

// ПроверитьРазмерАргументов: граница включающая, превышение - ошибка,
// лимит 0 отключает проверку.
Процедура РазмерАргументовГраницы() Экспорт

	Малые = "{""а"": """ + Повтор("а", 100) + """}";
	ИтогМалых = ar_JSON.ПроверитьРазмерАргументов(Малые, 65536);
	ЮТест.ОжидаетЧто(ИтогМалых).Свойство("Корректно").ЭтоИстина()
		.Свойство("РазмерБайт").Больше(0);

	Большие = "{""а"": """ + Повтор("а", 70000) + """}";
	ИтогБольших = ar_JSON.ПроверитьРазмерАргументов(Большие, 65536);
	ЮТест.ОжидаетЧто(ИтогБольших).Свойство("Корректно").ЭтоЛожь()
		.Свойство("Сообщение").Заполнено();

	ИтогБезЛимита = ar_JSON.ПроверитьРазмерАргументов(Большие, 0);
	ЮТест.ОжидаетЧто(ИтогБезЛимита.Корректно).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Повторяет односимвольный фрагмент заданное число раз.
//
Функция Повтор(Знач Символ, Знач Раз)

	Результат = "";
	Для Сч = 1 По Раз Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
