///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ИнструментыПакеты.
//
// Регрессионные тесты валидации манифестов пакетов tools (agentrunner-370,
// критерии спеки задачи «ТЕСТЫ: валидация манифестов пакетов инструментов»,
// п.6 предложения agentrunner-362). Точка входа - только экспортный метод ядра
// ar_ИнструментыПакеты.ВалидироватьМанифест(Манифест, ИдентификаторОбработки):
// отдельные проверки (ПроверитьВерсиюСхемы, ПроверитьПространствоИмён,
// ВалидироватьОдинTool, ПроверитьУровеньРискаTool, ВалидироватьJSONManifest)
// неэкспортны и проверяются через неё. Делать методы ядра экспортными ради
// теста нельзя.
//
// Матрица спеки: корректный манифест проходит; неподдерживаемая версия схемы
// (включая латинский ключ schema_version); неверный формат пространства имён;
// пространство имён, занятое другим пакетом; недопустимый уровень риска tool;
// битая JSON-схема аргументов tool. Каждой ошибке валидации - свой тест с
// ожидаемым кодом причины отказа (см. шапку ВалидироватьМанифест в ядре).
//
// Валидация чистая: LLM не вызывается (ar_LLMMock не трогается), фоновых
// заданий нет. Запись регистра ar_ПакетыИнструментов только в тесте коллизии
// namespace - выполняется в транзакции теста и откатывается.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("КорректныйМанифест")
		.ДобавитьСерверныйТест("КорректныйМанифестПроходитВалидацию").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ВерсияСхемыИПространствоИмён")
		.ДобавитьСерверныйТест("НеподдерживаемаяВерсияСхемыОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЛатинскийКлючВерсииОтклоняетсяКакLegacy").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НеверныйФорматПространстваИмёнОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПространствоИмёнЧужогоПакетаОтклоняетсяКоллизией").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Инструменты")
		.ДобавитьСерверныйТест("НедопустимыйУровеньРискаИнструментаОтклоняется").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("БитаяJSONСхемаАргументовОтклоняется").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Критерий 1: корректный манифест (схема 2, namespace латиницей, инструмент
// уровня риска «Чтение» с корректной OpenAI-схемой аргументов) проходит
// валидацию без единой ошибки.
Процедура КорректныйМанифестПроходитВалидацию() Экспорт

	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестПакетаТестовый(), ИдентификаторПакетаТестового());

	ЮТест.ОжидаетЧто(Результат.Корректно, СтрСоединить(Результат.Ошибки, "; ")).ЭтоИстина()
		.Что(Результат.Ошибки.Количество()).Равно(0);

КонецПроцедуры

// Критерий 2: неподдерживаемая версия схемы отклоняется с кодом
// unsupported_schema_version:<значение> - и число, отличное от поддерживаемой,
// и значение нечислового типа (представление подставляется в код причины).
Процедура НеподдерживаемаяВерсияСхемыОтклоняется() Экспорт

	Манифест = МанифестПакетаТестовый("ВерсияСхемы", 3);
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Манифест, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(Результат.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(Результат.Ошибки, "unsupported_schema_version"))
		.Равно("unsupported_schema_version:3");

	МанифестСтрокой = МанифестПакетаТестовый("ВерсияСхемы", "2");
	РезультатСтрокой = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестСтрокой, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатСтрокой.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатСтрокой.Ошибки, "unsupported_schema_version"))
		.Равно("unsupported_schema_version:2");

КонецПроцедуры

// Критерий 2: манифест со старым латинским ключом schema_version (схема 1)
// отклоняется отдельным кодом legacy_manifest_keys, а не невнятным
// unsupported_schema_version.
Процедура ЛатинскийКлючВерсииОтклоняетсяКакLegacy() Экспорт

	Манифест = МанифестПакетаТестовый("schema_version", 2);
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Манифест, ИдентификаторПакетаТестового());

	ЮТест.ОжидаетЧто(Результат.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(Результат.Ошибки, "legacy_manifest_keys")).Равно("legacy_manifest_keys");

КонецПроцедуры

// Критерий 2: неверный формат пространства имён отклоняется с кодом
// invalid_namespace:<значение> - кириллица, цифра первым символом, слишком
// короткое имя (формат ядра: [a-z][a-z0-9_]{1,30}).
Процедура НеверныйФорматПространстваИмёнОтклоняется() Экспорт

	МанифестКириллицей = МанифестПакетаТестовый();
	МанифестКириллицей.Вставить("ПространствоИмён", "Демо");
	РезультатКириллицей = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестКириллицей, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатКириллицей.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатКириллицей.Ошибки, "invalid_namespace")).Равно("invalid_namespace:Демо");

	МанифестСЦифры = МанифестПакетаТестовый();
	МанифестСЦифры.Вставить("ПространствоИмён", "370test");
	РезультатСЦифры = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестСЦифры, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатСЦифры.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатСЦифры.Ошибки, "invalid_namespace")).Равно("invalid_namespace:370test");

	МанифестКороткий = МанифестПакетаТестовый();
	МанифестКороткий.Вставить("ПространствоИмён", "a");
	РезультатКороткий = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестКороткий, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатКороткий.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатКороткий.Ошибки, "invalid_namespace")).Равно("invalid_namespace:a");

КонецПроцедуры

// Критерий 2: namespace, занятый ДРУГИМ активным пакетом, отклоняется с кодом
// namespace_collision:<ns>; повторная валидация от того же пакета (тот же
// идентификатор обработки) коллизией не считается, а запись реестра со статусом
// «Отклонён» пространство имён не блокирует.
//
// Статусы и идентификаторы - литералы ядра: «Зарегистрирован»/«Отклонён» пишутся
// в ar_ПакетыИнструментов.ar_Статус самим ядром (ЗафиксироватьОтклонённыйПакет).
Процедура ПространствоИмёнЧужогоПакетаОтклоняетсяКоллизией() Экспорт

	ЗаписатьПакетВРегистр(ИдентификаторЧужогоПакета(), ПространствоИмёнТестовое(), "Зарегистрирован");
	ЗаписатьПакетВРегистр(ИдентификаторПакетаОтклоненнойЗаписи(),
		ПространствоИмёнОтклоненнойЗаписи(), "Отклонён");

	РезультатКоллизии = ar_ИнструментыПакеты.ВалидироватьМанифест(
		МанифестПакетаТестовый(), ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатКоллизии.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатКоллизии.Ошибки, "namespace_collision"))
		.Равно("namespace_collision:" + ПространствоИмёнТестовое());

	РезультатСвоегоПакета = ar_ИнструментыПакеты.ВалидироватьМанифест(
		МанифестПакетаТестовый(), ИдентификаторЧужогоПакета());
	ЮТест.ОжидаетЧто(РезультатСвоегоПакета.Корректно, СтрСоединить(РезультатСвоегоПакета.Ошибки, "; ")).ЭтоИстина();

	// namespace отклоненной записи подставляется в готовый манифест вместе с
	// именем tool и его схемой: имя tool обязано начинаться с namespace
	// манифеста (name_not_namespaced), а function.name в схеме - с имени tool.
	// Параметры МанифестПакетаТестовый - это ключ и значение версии схемы, а не
	// namespace (подмена ключа ВерсияСхемы давала unsupported_schema_version:undefined).
	МанифестОтклоненной = МанифестПакетаТестовый();
	МанифестОтклоненной.Вставить("ПространствоИмён", ПространствоИмёнОтклоненнойЗаписи());
	МанифестОтклоненной.Инструменты[0].Вставить("Имя", ИмяИнструментаОтклоненнойЗаписи());
	МанифестОтклоненной.Инструменты[0].Вставить("СхемаАргументовJSON",
		СхемаАргументовЭхо(ИмяИнструментаОтклоненнойЗаписи()));
	РезультатОтклоненной = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестОтклоненной, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатОтклоненной.Корректно, СтрСоединить(РезультатОтклоненной.Ошибки, "; ")).ЭтоИстина();

КонецПроцедуры

// Критерий 3: недопустимый уровень риска tool (значение не из списка имён
// перечисления ar_УровеньРиска, а также отсутствующий ключ) отклоняется с
// кодом invalid_risk_level:<имя tool>.
Процедура НедопустимыйУровеньРискаИнструментаОтклоняется() Экспорт

	Манифест = МанифестПакетаТестовый();
	Манифест.Инструменты[0].Вставить("УровеньРиска", "Удаление");
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Манифест, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(Результат.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(Результат.Ошибки, "invalid_risk_level"))
		.Равно("invalid_risk_level:" + ИмяИнструментаТестового());

	ИнструментБезРиска = Новый Структура;
	ИнструментБезРиска.Вставить("Имя", ИмяИнструментаТестового());
	ИнструментБезРиска.Вставить("Описание", "Возвращает переданный текст без изменений.");
	ИнструментБезРиска.Вставить("Версия", "1.0.0");
	ИнструментБезРиска.Вставить("СхемаАргументовJSON", СхемаАргументовЭхо(ИмяИнструментаТестового()));
	МанифестБезРиска = МанифестПакетаТестовый();
	МанифестБезРиска.Инструменты.Очистить();
	МанифестБезРиска.Инструменты.Добавить(ИнструментБезРиска);
	РезультатБезРиска = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестБезРиска, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатБезРиска.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатБезРиска.Ошибки, "invalid_risk_level"))
		.Равно("invalid_risk_level:" + ИмяИнструментаТестового());

КонецПроцедуры

// Критерий 3: битая JSON-схема аргументов tool отклоняется - обрезанная
// JSON-строка с кодом invalid_tool_manifest:<имя>:parse_error, значение не
// строкового типа с кодом invalid_tool_manifest:<имя>:JSONManifest.
Процедура БитаяJSONСхемаАргументовОтклоняется() Экспорт

	Манифест = МанифестПакетаТестовый();
	Манифест.Инструменты[0].Вставить("СхемаАргументовJSON", "{""type"": ""function"", ""function"": {""name""");
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Манифест, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(Результат.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(Результат.Ошибки, "invalid_tool_manifest"))
		.Равно("invalid_tool_manifest:" + ИмяИнструментаТестового() + ":parse_error");

	МанифестНеСтрока = МанифестПакетаТестовый();
	МанифестНеСтрока.Инструменты[0].Вставить("СхемаАргументовJSON", 42);
	РезультатНеСтрока = ar_ИнструментыПакеты.ВалидироватьМанифест(МанифестНеСтрока, ИдентификаторПакетаТестового());
	ЮТест.ОжидаетЧто(РезультатНеСтрока.Корректно).ЭтоЛожь()
		.Что(НайтиОшибкуВалидации(РезультатНеСтрока.Ошибки, "invalid_tool_manifest"))
		.Равно("invalid_tool_manifest:" + ИмяИнструментаТестового() + ":JSONManifest");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Корректный манифест тестового пакета (схема 2): namespace "paket370",
// версия пакета, одна категория и один инструмент чтения с корректной
// OpenAI-схемой аргументов. Ключ версии схемы и её значение - параметры, чтобы
// одни и те же тесты проверяли и латинский ключ schema_version, и нечисловую
// версию схемы.
//
// Параметры:
//  КлючВерсииСхемы - Строка - имя ключа версии схемы ("ВерсияСхемы" или
//                        старый латинский "schema_version").
//  ЗначениеВерсииСхемы - Произвольный - значение версии схемы (2, 3, "2").
//
// Возвращаемое значение:
//  Структура - манифест пакета по контракту (см. examples/ar_ПакетПример).
//
Функция МанифестПакетаТестовый(Знач КлючВерсииСхемы = "ВерсияСхемы", Знач ЗначениеВерсииСхемы = 2)

	Манифест = Новый Структура;
	Манифест.Вставить(КлючВерсииСхемы, ЗначениеВерсииСхемы);
	Манифест.Вставить("ПространствоИмён", ПространствоИмёнТестовое());
	Манифест.Вставить("Версия", "1.0.0");

	Категория = Новый Структура;
	Категория.Вставить("Имя", "демо");
	Категория.Вставить("Представление", "Демонстрационные инструменты");
	Категория.Вставить("ОписаниеДляLLM", "Инструменты тестового пакета");
	Категория.Вставить("Порядок", 1);
	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструментаТестового());
	Манифест.Вставить("Инструменты", Инструменты);

	Возврат Манифест;

КонецФункции

// Описание единственного инструмента тестового пакета - чтение с корректной
// схемой аргументов (function.name совпадает с именем tool).
//
// Возвращаемое значение:
//  Структура - элемент массива Инструменты манифеста пакета.
//
Функция ОписаниеИнструментаТестового()

	Описание = Новый Структура;
	Описание.Вставить("Имя", ИмяИнструментаТестового());
	Описание.Вставить("Описание", "Возвращает переданный текст без изменений.");
	Описание.Вставить("КраткоеОписание", "Эхо переданного текста");
	Описание.Вставить("СхемаАргументовJSON", СхемаАргументовЭхо(ИмяИнструментаТестового()));
	Описание.Вставить("УровеньРиска", "Чтение");
	Описание.Вставить("ТребуетПодтверждения", Ложь);
	Описание.Вставить("Версия", "1.0.0");
	Возврат Описание;

КонецФункции

// Схема аргументов тестового инструмента в OpenAI tool-format: строка JSON
// вида {"type":"function","function":{"name","description","parameters"}} -
// тот же контракт, что у эталонного пакета (examples/ar_ПакетПример).
//
// Параметры:
//  Имя - Строка - полное имя tool (с namespace); попадает в function.name.
//
// Возвращаемое значение:
//  Строка - JSON-манифест схемы аргументов.
//
Функция СхемаАргументовЭхо(Знач Имя)

	Схема = "{""type"": ""function"", ""function"": {""name"": ""%1"","
		+ " ""description"": ""Возвращает текст без изменения."","
		+ " ""parameters"": {""type"": ""object"", ""properties"": {""text"": {""type"": ""string""}},"
		+ " ""required"": [""text""]}}}";
	Возврат СтрШаблон(Схема, Имя);

КонецФункции

// Записывает запись реестра пакетов ar_ПакетыИнструментов - фикстуру теста
// коллизии namespace. Запись откатывается транзакцией теста.
//
// Параметры:
//  Идентификатор - Строка - UUID идентификатора обработки пакета (36 символов).
//  ПространствоИмён - Строка - namespace пакета.
//  Статус - Строка - статус записи реестра ("Зарегистрирован"/"Отклонён").
//
Процедура ЗаписатьПакетВРегистр(Знач Идентификатор, Знач ПространствоИмён, Знач Статус)

	МенеджерЗаписи = РегистрыСведений.ar_ПакетыИнструментов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ИдентификаторОбработки = Идентификатор;
	МенеджерЗаписи.ar_Namespace = ПространствоИмён;
	МенеджерЗаписи.ar_Статус = Статус;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Возвращает элемент массива ошибок валидации, начинающийся с префикса.
// Точное ожидаемое значение кода причины проверяется тестом.
//
// Параметры:
//  Ошибки - Массив - ошибки результата ВалидироватьМанифест (строки-коды причин).
//  Префикс - Строка - префикс кода причины ("invalid_namespace" и т.п.).
//
// Возвращаемое значение:
//  Строка - найденная ошибка; "" - не найдена.
//
Функция НайтиОшибкуВалидации(Знач Ошибки, Знач Префикс)

	Для Каждого КодПричины Из Ошибки Цикл
		Если СтрНачинаетсяС(КодПричины, Префикс) Тогда
			Возврат КодПричины;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Namespace тестового пакета: латиница нижним регистром, как требует формат
// ядра ([a-z][a-z0-9_]{1,30}); на стенде не занят реальными пакетами.
//
// Возвращаемое значение:
//  Строка - namespace тестового пакета.
//
Функция ПространствоИмёнТестовое()

	Возврат "paket370";

КонецФункции

// Полное имя tool тестового пакета: namespace с суффиксом "_echo", как в
// эталонном пакете (demo_echo). Латиница в значении - ключ внешнего контракта.
//
// Возвращаемое значение:
//  Строка - имя tool тестового пакета.
//
Функция ИмяИнструментаТестового()

	Возврат ПространствоИмёнТестовое() + "_echo";

КонецФункции

// Идентификатор обработки валидируемого пакета: строковое представление UUID
// (36 символов, как Строка(Ссылка.УникальныйИдентификатор()) в ядре).
//
// Возвращаемое значение:
//  Строка - идентификатор тестового пакета.
//
Функция ИдентификаторПакетаТестового()

	Возврат "11111111-1111-1111-1111-111111111111";

КонецФункции

// Идентификатор «чужого» пакета-владельца namespace: отличается от
// идентификатора валидируемого пакета, чтобы запись реестра считалась
// коллизией, и совпадает в тесте повторной регистрации того же пакета.
//
// Возвращаемое значение:
//  Строка - идентификатор чужого пакета.
//
Функция ИдентификаторЧужогоПакета()

	Возврат "22222222-2222-2222-2222-222222222222";

КонецФункции

// Идентификатор пакета, чья запись реестра в фикстуре помечена статусом
// «Отклонён» (такие записи namespace не блокируют - проверяется тестом).
//
// Возвращаемое значение:
//  Строка - идентификатор пакета с отклоненной записью.
//
Функция ИдентификаторПакетаОтклоненнойЗаписи()

	Возврат "33333333-3333-3333-3333-333333333333";

КонецФункции

// Namespace записи реестра со статусом «Отклонён» в фикстуре теста коллизии:
// тот же, что валидируемый манифест подставляет в ПространствоИмён (запись
// «Отклонён» не блокирует - манифест проходит валидацию).
//
// Возвращаемое значение:
//  Строка - namespace отклоненной записи (латиница, формат ядра).
//
Функция ПространствоИмёнОтклоненнойЗаписи()

	Возврат "paket370otkl";

КонецФункции

// Полное имя tool манифеста с namespace отклоненной записи: имя tool обязано
// начинаться с namespace манифеста (name_not_namespaced валидатора).
//
// Возвращаемое значение:
//  Строка - имя tool (латиница - ключ внешнего контракта).
//
Функция ИмяИнструментаОтклоненнойЗаписи()

	Возврат ПространствоИмёнОтклоненнойЗаписи() + "_echo";

КонецФункции

#КонецОбласти
