#Область СлужебныеПроцедурыИФункции

// Создаёт провайдера-заглушку, агента с заданным режимом автономии и запись
// запуска.
//
// Параметры:
//  РежимАвтономии   - ПеречислениеСсылка.ar_РежимАвтономии;
//  ПараметрыАгента  - Структура - МаксШагов/МаксДействий/Активен/
//                     ДоступныеИнструменты (опционально).
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовитьЗапуск(Знач РежимАвтономии, Знач ПараметрыАгента = Неопределено)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("РежимАвтономии", РежимАвтономии);
	Если ПараметрыАгента <> Неопределено Тогда
		Если ПараметрыАгента.Свойство("ДоступныеИнструменты") Тогда
			Параметры.Вставить("ДоступныеИнструменты", ПараметрыАгента.ДоступныеИнструменты);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксШагов") Тогда
			Параметры.Вставить("МаксШагов", ПараметрыАгента.МаксШагов);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксДействий") Тогда
			Параметры.Вставить("МаксДействий", ПараметрыАгента.МаксДействий);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("Активен") Тогда
			Параметры.Вставить("Активен", ПараметрыАгента.Активен);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("ПланироватьРаботу") Тогда
			Параметры.Вставить("ПланироватьРаботу", ПараметрыАгента.ПланироватьРаботу);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("ШаблонПлана") Тогда
			Параметры.Вставить("ШаблонПлана", ПараметрыАгента.ШаблонПлана);
		КонецЕсли;
	КонецЕсли;
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

// Структура параметров агента с включенным планированием и шаблоном плана
// (переводы строк шаблона - через Символы.ПС: в литерале 1С "|" - признак
// продолжения строки и в текст шаблона попасть не может).
//
Функция ПараметрыСШаблономПлана(Знач Строка1, Знач Строка2 = "", Знач Строка3 = "")

	СтрокиШаблона = Новый Массив;
	СтрокиШаблона.Добавить(Строка1);
	Если Не ПустаяСтрока(Строка2) Тогда
		СтрокиШаблона.Добавить(Строка2);
	КонецЕсли;
	Если Не ПустаяСтрока(Строка3) Тогда
		СтрокиШаблона.Добавить(Строка3);
	КонецЕсли;

	Возврат Новый Структура("ПланироватьРаботу, ШаблонПлана",
		Истина, СтрСоединить(СтрокиШаблона, Символы.ПС));

КонецФункции

// Число событий запуска с заданным машиночитаемым кодом payload.
//
Функция ЧислоСобытийСКодом(Знач RunId, Знач Код)

	Возврат ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("Код", Код)).Количество();

КонецФункции

// Минимальный Sequence среди событий заданного типа; 0 - событий нет.
//
Функция ПервыйSequenceТипа(Знач RunId, Знач ТипСобытия)

	МинимальныйSequence = 0;
	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Если СтрокаСобытия.ТипСобытия <> ТипСобытия Тогда
			Продолжить;
		КонецЕсли;
		Если МинимальныйSequence = 0 Или СтрокаСобытия.Sequence < МинимальныйSequence Тогда
			МинимальныйSequence = СтрокаСобытия.Sequence;
		КонецЕсли;
	КонецЦикла;
	Возврат МинимальныйSequence;

КонецФункции

// Числовое поле разобранного JSON-payload (0 при отсутствии/ошибке типа).
//
Функция ЧислоИзPayload(Знач Payload, Знач Ключ)

	Значение = ЗначениеPayload(Payload, Ключ);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Значение поля разобранного JSON (ИзJSON возвращает Соответствие или
// Структуру - читается одинаково без исключений).
//
Функция ЗначениеPayload(Знач Payload, Знач Ключ)

	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		Возврат Payload.Получить(Ключ);
	КонецЕсли;
	Значение = Неопределено;
	Если ТипЗнч(Payload) = Тип("Структура") Тогда
		Payload.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Заполняет реестр инструментов ядровыми описаниями
// (ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools) - идемпотентно.
//
Процедура ЗарегистрироватьЯдровойРеестр()

	ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools();

КонецПроцедуры

// Единственное событие с заданным кодом (для проверки payload).
//
Функция ЕдинственноеСобытиеСКодом(Знач RunId, Знач Код)

	Строки = ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("Код", Код));
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строки[0];

КонецФункции

// Массив ответов сценария из переданных элементов (до шести).
//
Функция МассивОтветов(Знач Ответ1, Знач Ответ2 = Неопределено, Знач Ответ3 = Неопределено,
	Знач Ответ4 = Неопределено, Знач Ответ5 = Неопределено, Знач Ответ6 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Ответ1);
	Если Ответ2 <> Неопределено Тогда
		Массив.Добавить(Ответ2);
	КонецЕсли;
	Если Ответ3 <> Неопределено Тогда
		Массив.Добавить(Ответ3);
	КонецЕсли;
	Если Ответ4 <> Неопределено Тогда
		Массив.Добавить(Ответ4);
	КонецЕсли;
	Если Ответ5 <> Неопределено Тогда
		Массив.Добавить(Ответ5);
	КонецЕсли;
	Если Ответ6 <> Неопределено Тогда
		Массив.Добавить(Ответ6);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Массив из одной-двух строк (для белых списков инструментов).
//
Функция МассивСтрок(Знач Строка1, Знач Строка2 = "")

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Если Не ПустаяСтрока(Строка2) Тогда
		Массив.Добавить(Строка2);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Создает предмет (элемент горячего типа из состава ar_ПрикладнойОбъект) и
// запись захвата в ar_ПредметыАгентов за запуском. В проде захват делает
// СтартоватьВФоне; тест идет через ЗапуститьЦикл (ВыполнитьАгента напрямую),
// который захват не выполняет - запись создается как тестовые данные.
//
// Параметры:
//  Агент       - СправочникСсылка.ar_Агенты - агент запуска;
//  RunId       - Строка - идентификатор запуска-держателя;
//  СбоевПодряд - Число  - начальное значение счетчика сбоев записи
//                (для проверки сброса/прироста при снятии захвата).
//
// Возвращаемое значение:
//  ЛюбаяСсылка - предмет захвата.
//
Функция СоздатьЗахватПредмета(Знач Агент, Знач RunId, Знач СбоевПодряд)

	Предмет = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа().Ссылка;

	Захват = РегистрыСведений.ar_ПредметыАгентов.СоздатьМенеджерЗаписи();
	Захват.ar_Агент = Агент;
	Захват.ar_Предмет = Предмет;
	Захват.ar_Запуск = RunId;
	Захват.ar_Захвачен = ТекущаяДатаСеанса();
	Захват.ar_Триггер = "manual";
	Захват.ar_СбоевПодряд = СбоевПодряд;
	Захват.Записать(Истина);

	Возврат Предмет;

КонецФункции

// Запись захвата предмета из ar_ПредметыАгентов по паре (агент, предмет).
//
// Возвращаемое значение:
//  Структура - {Найден, RunIdЗахвата (ar_Запуск, "" после снятия),
//  Причина (ar_ПоследняяПричина), СбоевПодряд} или {Найден: Ложь}.
//
Функция ЗахватПоПредмету(Знач Агент, Знач Предмет)

	Результат = Новый Структура("Найден, RunIdЗахвата, Причина, СбоевПодряд",
		Ложь, "", "", 0);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Захваты.ar_Запуск КАК RunIdЗахвата,
		|	Захваты.ar_ПоследняяПричина КАК Причина,
		|	Захваты.ar_СбоевПодряд КАК СбоевПодряд
		|ИЗ
		|	РегистрСведений.ar_ПредметыАгентов КАК Захваты
		|ГДЕ
		|	Захваты.ar_Агент = &Агент
		|	И Захваты.ar_Предмет = &Предмет");
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("Предмет", Предмет);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найден = Истина;
		Результат.RunIdЗахвата = СокрЛП(Выборка.RunIdЗахвата);
		Результат.Причина = СокрЛП(Выборка.Причина);
		Результат.СбоевПодряд = Выборка.СбоевПодряд;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Число событий запуска заданного типа (ar_ТипСобытия).
//
Функция ЧислоТиповСобытия(Знач RunId, Знач ТипСобытия)

	Возврат ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("ТипСобытия", ТипСобытия)).Количество();

КонецФункции

// Последнее событие запуска заданного типа (ar_ТипСобытия); Неопределено -
// событий нет.
//
Функция ПоследнееСобытиеТипа(Знач RunId, Знач ТипСобытия)

	Последнее = Неопределено;
	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Если СтрокаСобытия.ТипСобытия = ТипСобытия Тогда
			Последнее = СтрокаСобытия;
		КонецЕсли;
	КонецЦикла;
	Возврат Последнее;

КонецФункции

// Элемент сценария ar_LLMMock: вызов update_plan с тремя пунктами шагов
// (для сценария частично закрытого плана - полный ответ ОтветЗакрытьПлан
// закрывает все пункты, и ядру нечего закрывать при завершении).
//
// Параметры:
//  Пункт1, Пункт2, Пункт3 - Структура - пункты из ПунктПланаСоСтатусом.
//
// Возвращаемое значение:
//  Структура - элемент сценария {ТипОтвета:"tool_call", ИмяTool:"update_plan", ...}.
//
Функция ОтветОбновитьПлан(Знач Пункт1, Знач Пункт2, Знач Пункт3)

	Шаги = Новый Массив;
	Шаги.Добавить(Пункт1);
	Шаги.Добавить(Пункт2);
	Шаги.Добавить(Пункт3);
	Возврат ОМ_ar_ТестовыеДанные.ОтветToolCall("update_plan",
		ar_JSON.ВЗначениеJSON(Новый Структура("steps", Шаги)), "call_plan");

КонецФункции

// Пункт массива steps аргументов update_plan: {title, status}.
//
// Параметры:
//  Заголовок - Строка - заголовок пункта плана;
//  Статус    - Строка - статус пункта ("pending"/"in_progress"/"done").
//
// Возвращаемое значение:
//  Структура - {title, status}.
//
Функция ПунктПланаСоСтатусом(Знач Заголовок, Знач Статус)

	Возврат Новый Структура("title, status", Заголовок, Статус);

КонецФункции

// Статус шага плана из массива steps payload события ПланОбновлён; "" - шага
// с таким заголовком в payload нет.
//
// Параметры:
//  Шаги      - Массив, Неопределено - значение payload "steps";
//  Заголовок - Строка - заголовок шага (title).
//
// Возвращаемое значение:
//  Строка - статус шага ("done"/"skipped"/...).
//
Функция СтатусШагаПлана(Знач Шаги, Знач Заголовок)

	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Шаг Из Шаги Цикл
		Если Строка(ЗначениеPayload(Шаг, "title")) = Заголовок Тогда
			Возврат Строка(ЗначениеPayload(Шаг, "status"));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
