КонецПроцедуры

// 1.12 Запуск отменён (ar_RuntimeЗапуск.Отменить) до шага: цикл выходит.
// ФАКТ (расхождение с scenarios.md 1.12): ar_RuntimeЗапуск.Отменить переводит
// запись в статус Прерван (не Отменён), цикл выходит тихо, статус остаётся
// Прерван. Тест фиксирует фактическое поведение.
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.12, tests.md agentrunner-27 №1 и №7): тест закрепляет текущее поведение
// «Отменить переводит запуск в Прерван (не Отменен), применим к запуску на паузе»;
// ожидалось «статус Отменен». Если решат изменить поведение - поправить тест вместе с кодом.
Процедура ОтменённыйДоШагаЗапускНеВыполняется() Экспорт

	// ФАКТ (расхождение со сценарием 1.12 зафиксировано в tests.md): Отменить
	// переводит запись в статус Прерван (не Отменён) и применим к запуску на
	// паузе; для записи "Создан" без фонового задания возвращается Ложь.
	// Возобновлённый вручную цикл на терминальном статусе не выполняется.
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	Отменено = ar_RuntimeЗапуск.Отменить(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Отменено).ЭтоИстина();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_completed")).ЭтоЛожь();

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Очередь).ИмеетДлину(1)
		.Свойство("[0].Статус").Равно("cancelled");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.13 Режим пробного выполнения (DryRun) с инструментом записи: вызов
// доходит до диспетчера с флагом DryRun (в журнале действий имя
// "save_object (dry_run)"), постановки в очередь подтверждений нет.
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.13, tests.md agentrunner-27 №8): тест закрепляет текущее поведение
// «в DryRun подтверждение для фиксации ставится, dry-прогон выполняется на предпроверке до очереди»;
// ожидалось «DryRun выполняет инструмент без постановки в очередь подтверждений».
// Если решат изменить поведение - поправить тест вместе с кодом.
Процедура DryRunВыполняетИнструментБезЗаписи() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Автономный);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("save_object", "{""object_type"": ""Справочник.Валюты""}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Пробный прогон завершён."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	КонтекстПрогона = Новый Структура;
	КонтекстПрогона.Вставить("Триггер", "manual");
	КонтекстПрогона.Вставить("DryRun", Истина);
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId, КонтекстПрогона);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	// ФАКТ (расхождение со сценарием 1.13): DryRun не отменяет подтверждение -
	// для фиксации ставится approval, dry-прогон выполняется на предпроверке
	// до постановки в очередь (ПредпроверкаДействия вызывает tool с _dry_run).
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "approval_requested")).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Действия).ИмеетДлину(1)
		.Свойство("[0].ИмяИнструмента").Равно("save_object (dry_run)");

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId)).ИмеетДлину(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт провайдера-заглушку, агента с заданным режимом автономии и запись
// запуска.
//
// Параметры:
//  РежимАвтономии   - ПеречислениеСсылка.ar_РежимАвтономии;
//  ПараметрыАгента  - Структура - МаксШагов/МаксДействий/Активен/
//                     ДоступныеИнструменты (опционально).
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовитьЗапуск(Знач РежимАвтономии, Знач ПараметрыАгента = Неопределено)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("РежимАвтономии", РежимАвтономии);
	Если ПараметрыАгента <> Неопределено Тогда
		Если ПараметрыАгента.Свойство("ДоступныеИнструменты") Тогда
			Параметры.Вставить("ДоступныеИнструменты", ПараметрыАгента.ДоступныеИнструменты);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксШагов") Тогда
			Параметры.Вставить("МаксШагов", ПараметрыАгента.МаксШагов);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксДействий") Тогда
			Параметры.Вставить("МаксДействий", ПараметрыАгента.МаксДействий);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("Активен") Тогда
			Параметры.Вставить("Активен", ПараметрыАгента.Активен);
		КонецЕсли;
	КонецЕсли;
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

