// Единственное событие с заданным кодом (для проверки payload).
//
Функция ЕдинственноеСобытиеСКодом(Знач RunId, Знач Код)

	Строки = ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("Код", Код));
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строки[0];

КонецФункции

// Массив ответов сценария из переданных элементов.
//
Функция МассивОтветов(Знач Ответ1, Знач Ответ2 = Неопределено, Знач Ответ3 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Ответ1);
	Если Ответ2 <> Неопределено Тогда
		Массив.Добавить(Ответ2);
	КонецЕсли;
	Если Ответ3 <> Неопределено Тогда
		Массив.Добавить(Ответ3);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Массив из одной-двух строк (для белых списков инструментов).
//
Функция МассивСтрок(Знач Строка1, Знач Строка2 = "")

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Если Не ПустаяСтрока(Строка2) Тогда
		Массив.Добавить(Строка2);
	КонецЕсли;
	Возврат Массив;

КонецФункции

#КонецОбласти
