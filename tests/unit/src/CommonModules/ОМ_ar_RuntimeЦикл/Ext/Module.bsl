// 1.12 Запуск отменён (ar_RuntimeЗапуск.Отменить) до шага: цикл выходит.
// ФАКТ (расхождение с scenarios.md 1.12): ar_RuntimeЗапуск.Отменить переводит
// запись в статус Прерван (не Отменён), цикл выходит тихо, статус остаётся
// Прерван. Тест фиксирует фактическое поведение.
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.12, tests.md agentrunner-27 №1 и №7): тест закрепляет текущее поведение
// «Отменить переводит запуск в Прерван (не Отменен), применим к запуску на паузе»;
// ожидалось «статус Отменен». Если решат изменить поведение - поправить тест вместе с кодом.
Процедура ОтменённыйДоШагаЗапускНеВыполняется() Экспорт

	// ФАКТ (расхождение со сценарием 1.12 зафиксировано в tests.md): Отменить
	// переводит запись в статус Прерван (не Отменён) и применим к запуску на
	// паузе; для записи "Создан" без фонового задания возвращается Ложь.
	// Возобновлённый вручную цикл на терминальном статусе не выполняется.
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	Отменено = ar_RuntimeЗапуск.Отменить(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Отменено).ЭтоИстина();

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_completed")).ЭтоЛожь();

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Очередь).ИмеетДлину(1)
		.Свойство("[0].Статус").Равно("cancelled");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.13 Режим пробного выполнения (DryRun) с инструментом записи: вызов
// доходит до диспетчера с флагом DryRun (в журнале действий имя
// "save_object (dry_run)"), постановки в очередь подтверждений нет.
// ОЖИДАЕТ РЕШЕНИЯ (сценарий 1.13, tests.md agentrunner-27 №8): тест закрепляет текущее поведение
// «в DryRun подтверждение для фиксации ставится, dry-прогон выполняется на предпроверке до очереди»;
// ожидалось «DryRun выполняет инструмент без постановки в очередь подтверждений».
// Если решат изменить поведение - поправить тест вместе с кодом.
Процедура DryRunВыполняетИнструментБезЗаписи() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Автономный);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("save_object", "{""object_type"": ""Справочник.Валюты""}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Пробный прогон завершён."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	КонтекстПрогона = Новый Структура;
	КонтекстПрогона.Вставить("Триггер", "manual");
	КонтекстПрогона.Вставить("DryRun", Истина);
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId, КонтекстПрогона);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	// ФАКТ (расхождение со сценарием 1.13): DryRun не отменяет подтверждение -
	// для фиксации ставится approval, dry-прогон выполняется на предпроверке
	// до постановки в очередь (ПредпроверкаДействия вызывает tool с _dry_run).
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "approval_requested")).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Действия).ИмеетДлину(1)
		.Свойство("[0].ИмяИнструмента").Равно("save_object (dry_run)");

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId)).ИмеетДлину(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-20 кр. 2-3: план из шаблона карточки агента фиксируется до
// первого вызова модели - событие ПланОбновлён (source = template,
// steps_total = 3, steps_done = 0) имеет Sequence раньше первого ВызванLLM;
// решение по tool_choice первого шага - без принуждения update_plan
// (ПринудитьОбновлениеПлана=Нет, ПунктовПлана=3); запуск завершается.
// Шаблон - простые строки, без привязки инструментов (кр. 2 спеки: пункты
// шаблона без «|tool» - необязательные). Сценарий из трех ответов: текст -
// закрывающий шаг плана (PLAN-17) - вердикт надзора.
Процедура ПланИзШаблонаДоПервогоВызоваЛЛМ() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		ПараметрыСШаблономПлана("Собрать данные", "Проанализировать данные",
			"Сформировать ответ"));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Отчёт готов."),
			ОМ_ar_ТестовыеДанные.ОтветЗакрытьПлан("Собрать данные", "Проанализировать данные",
				"Сформировать ответ"),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	СобытиеПлана = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(Подготовка.RunId, "plan_updated");
	ЮТест.ОжидаетЧто(СобытиеПлана).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.ПланОбновлён);

	PayloadПлана = ar_JSON.ИзJSON(СобытиеПлана.PayloadJSON);
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(PayloadПлана, "source"))).Равно("template")
		.Что(ЧислоИзPayload(PayloadПлана, "steps_total")).Равно(3)
		.Что(ЧислоИзPayload(PayloadПлана, "steps_done")).Равно(0);

	ПервыйLLM = ПервыйSequenceТипа(Подготовка.RunId, Перечисления.ar_ТипСобытия.ВызванLLM);
	ЮТест.ОжидаетЧто(ПервыйLLM).Больше(0)
		.Что(СобытиеПлана.Sequence).Меньше(ПервыйLLM);

	ЗаписиВыбора = ОМ_ar_ТестовыеДанные.ЗаписьСлужебногоЛога(
		Подготовка.RunId, "debug_tool_choice_decision");
	ЮТест.ОжидаетЧто(ЗаписиВыбора.Количество()).Больше(0);
	ТекстВыбора = Строка(ЗаписиВыбора[0].Текст);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстВыбора, "ПунктовПлана=3") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыбора, "ПринудитьОбновлениеПлана=Нет") > 0).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-20 кр. 9: при возобновлении запуска по снимку шаблон плана
// повторно не применяется - событие ПланОбновлён с source = template ровно
// одно, от старта запуска.
Процедура ВозобновлениеНеВторитШаблону() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		ПараметрыСШаблономПлана("Собрать данные", "Сформировать ответ"));
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	Снимок = ar_AuditЗапуски.ПрочитатьСнимок(Подготовка.RunId);
	КонтекстРезюме = Новый Структура;
	КонтекстРезюме.Вставить("Триггер", "approval_resume");
	КонтекстРезюме.Вставить("Снимок", Снимок);
	// Закрывающий шаг плана (PLAN-17): план из снимка непуст, перед финальным
	// ответом ядро требует update_plan - сценарий обязан иметь этот ответ.
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Продолжил после паузы."),
			ОМ_ar_ТестовыеДанные.ОтветЗакрытьПлан("Собрать данные", "Сформировать ответ"),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId, КонтекстРезюме);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ШаблонныхСобытий = 0;
	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(Подготовка.RunId) Цикл
		Если СтрокаСобытия.ТипСобытия <> Перечисления.ar_ТипСобытия.ПланОбновлён Тогда
			Продолжить;
		КонецЕсли;
		PayloadСобытия = ar_JSON.ИзJSON(СтрокаСобытия.PayloadJSON);
		Если PayloadСобытия <> Неопределено
			И Строка(ЗначениеPayload(PayloadСобытия, "source")) = "template" Тогда
			ШаблонныхСобытий = ШаблонныхСобытий + 1;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(ШаблонныхСобытий).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-66 кр. 6, agentrunner-107 кр. 4: повтор неудачного вызова с теми
// же аргументами не выполняется (событие Запрещён repeated_failed_call,
// диспетчеризация ровно одна), а 4-й отсеченный повтор завершает запуск с
// reason "лимит повторов вызова (4)" и событием plan_not_completed.
Процедура ПовторНеудачногоВызоваЛимитится() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	ОМ_ar_ТестовыеДанные.НовыйИнструментСМетодом("тест_падающий_вызов",
		Перечисления.ar_УровеньРиска.Чтение, "ar_ИнструментыУниверсальный",
		"НесуществующаяПроцедураТеста");
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Автономный,
		Новый Структура("МаксШагов", 8));

	Сценарий = Новый Массив;
	Для Сч = 1 По 5 Цикл
		Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветToolCall(
			"тест_падающий_вызов", "{""текст"": ""тот же""}", "call_" + Формат(Сч, "ЧГ=0")));
	КонецЦикла;
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий);

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	Если Не Запуск.Найден Тогда
		// Диагностика agentrunner-147: при живом цикле «Найден=Ложь» означает
		// откат транзакции теста вложенным ОтменитьТранзакцию ядра (гаснут и
		// запись, и ранние записи лога); след лога показывает, где цикл
		// оказался после отката (см. tests.md).
		ЮТест.ОжидаетЧто(Запуск.Найден,
			ОМ_ar_ТестовыеДанные.СледСлужебногоЛога(Подготовка.RunId)).ЭтоИстина();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения)
		.Что(СтрНайти(Запуск.ОтветLLM, "лимит повторов вызова (4)") > 0).ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId).Количество())
		.Равно(1);

	ЮТест.ОжидаетЧто(ЧислоСобытийСКодом(Подготовка.RunId, "repeated_failed_call")).Равно(3);

	СобытиеЛимита = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(Подготовка.RunId, "plan_not_completed");
	ЮТест.ОжидаетЧто(СобытиеЛимита).Заполнено();
	PayloadЛимита = ar_JSON.ИзJSON(СобытиеЛимита.PayloadJSON);
	ЮТест.ОжидаетЧто(СтрНайти(Строка(ЗначениеPayload(PayloadЛимита, "reason")), "лимит повторов вызова") > 0)
		.ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-68 кр. 1 (серверная часть): два продолжения надзора (первое по
// вердикту модели, второе - СменитьПодход из-за повторения того же ответа,
// answer_confirmed); итоговый ответ сохранен ровно один раз - дублей нет,
// эскалации нет, запуск Завершён.
Процедура ПовторОтветаСменаПодходаБезДублей() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОтветАгента = "Сделаю это позже.";
	ВердиктПродолжить = "{""class"": ""не_выполнено"", ""missing"": ""заметка не создана""}";
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОтветАгента),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ВердиктПродолжить),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОтветАгента),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ВердиктПродолжить),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОтветАгента),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ВердиктПродолжить)));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён)
		.Свойство("ПродолженийСделано").Равно(2)
		.Свойство("ОтветLLM").Равно(ОтветАгента);

	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Запуск.ОтветLLM, ОтветАгента)).Равно(1);

	ВидыПродолжений = Новый Массив;
	ЕстьПодтверждениеОтвета = Ложь;
	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(Подготовка.RunId) Цикл
		PayloadСобытия = ar_JSON.ИзJSON(СтрокаСобытия.PayloadJSON);
		Если PayloadСобытия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаСобытия.ТипСобытия = Перечисления.ar_ТипСобытия.ПродолжениеСтартовало Тогда
			ВидыПродолжений.Добавить(Строка(ЗначениеPayload(PayloadСобытия, "kind")));
		КонецЕсли;
		Если СтрНайти(СтрокаСобытия.PayloadJSON, "answer_confirmed") > 0 Тогда
			ЕстьПодтверждениеОтвета = Истина;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(ВидыПродолжений.Количество()).Равно(2)
		.Что(ВидыПродолжений[0]).Равно("continue")
		.Что(ВидыПродолжений[1]).Равно("change_approach")
		.Что(ЕстьПодтверждениеОтвета).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-105 кр. 1 (серверная часть): пульс запуска обновляется во время
// работы цикла (перед вызовами LLM) - ar_ПоследнийПульс не раньше момента
// старта прогона; запуск долгого вызова сборщиком не помечается.
Процедура ПульсОбновляетсяВоВремяЗапуска() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Отчёт готов."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	МоментСтарта = ТекущаяДатаСеанса();
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён)
		.Свойство("ПоследнийПульс").Больше(МоментСтарта - 1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-26 кр. 1 (серверная часть, без письма): вызов ask_user
// приостанавливает запуск для ввода - запись очереди awaiting_input, событие
// user_input_requested; ответ оператора через ОтветитьНаВопрос переводит
// запись в answered.
Процедура AskUserПриостанавливаетДляВвода() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		Новый Структура("ДоступныеИнструменты", МассивСтрок("ask_user")));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(ОМ_ar_ТестовыеДанные.ОтветToolCall(
			"ask_user", "{""question"": ""Уточните период""}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода);

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Очередь).ИмеетДлину(1)
		.Свойство("[0].Статус").Равно("awaiting_input");

	СобытиеВвода = ОМ_ar_ТестовыеДанные.СобытиеПоКоду(Подготовка.RunId, "user_input_requested");
	ЮТест.ОжидаетЧто(СобытиеВвода).Заполнено()
		.Свойство("ТипСобытия").Равно(Перечисления.ar_ТипСобытия.ЗапрошенОтветПользователя);

	ЮТест.ОжидаетЧто(ar_Подтверждение.ОтветитьНаВопрос(
		Очередь[0].ApprovalId, Справочники.Пользователи.ПустаяСсылка(), "Текущий месяц"))
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтатусОчереди(Очередь[0].ApprovalId))
		.Равно("answered");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт провайдера-заглушку, агента с заданным режимом автономии и запись
// запуска.
//
// Параметры:
//  РежимАвтономии   - ПеречислениеСсылка.ar_РежимАвтономии;
//  ПараметрыАгента  - Структура - МаксШагов/МаксДействий/Активен/
//                     ДоступныеИнструменты (опционально).
//
// Возвращаемое значение:
//  Структура - {Агент, RunId}.
//
Функция ПодготовитьЗапуск(Знач РежимАвтономии, Знач ПараметрыАгента = Неопределено)

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Параметры = Новый Структура;
	Параметры.Вставить("РежимАвтономии", РежимАвтономии);
	Если ПараметрыАгента <> Неопределено Тогда
		Если ПараметрыАгента.Свойство("ДоступныеИнструменты") Тогда
			Параметры.Вставить("ДоступныеИнструменты", ПараметрыАгента.ДоступныеИнструменты);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксШагов") Тогда
			Параметры.Вставить("МаксШагов", ПараметрыАгента.МаксШагов);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("МаксДействий") Тогда
			Параметры.Вставить("МаксДействий", ПараметрыАгента.МаксДействий);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("Активен") Тогда
			Параметры.Вставить("Активен", ПараметрыАгента.Активен);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("ПланироватьРаботу") Тогда
			Параметры.Вставить("ПланироватьРаботу", ПараметрыАгента.ПланироватьРаботу);
		КонецЕсли;
		Если ПараметрыАгента.Свойство("ШаблонПлана") Тогда
			Параметры.Вставить("ШаблонПлана", ПараметрыАгента.ШаблонПлана);
		КонецЕсли;
	КонецЕсли;
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, Параметры);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	Возврат Новый Структура("Агент, RunId", Агент, RunId);

КонецФункции

// Структура параметров агента с включенным планированием и шаблоном плана
// (переводы строк шаблона - через Символы.ПС: в литерале 1С "|" - признак
// продолжения строки и в текст шаблона попасть не может).
//
Функция ПараметрыСШаблономПлана(Знач Строка1, Знач Строка2 = "", Знач Строка3 = "")

	СтрокиШаблона = Новый Массив;
	СтрокиШаблона.Добавить(Строка1);
	Если Не ПустаяСтрока(Строка2) Тогда
		СтрокиШаблона.Добавить(Строка2);
	КонецЕсли;
	Если Не ПустаяСтрока(Строка3) Тогда
		СтрокиШаблона.Добавить(Строка3);
	КонецЕсли;

	Возврат Новый Структура("ПланироватьРаботу, ШаблонПлана",
		Истина, СтрСоединить(СтрокиШаблона, Символы.ПС));

КонецФункции

// Число событий запуска с заданным машиночитаемым кодом payload.
//
Функция ЧислоСобытийСКодом(Знач RunId, Знач Код)

	Возврат ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("Код", Код)).Количество();

КонецФункции

// Минимальный Sequence среди событий заданного типа; 0 - событий нет.
//
Функция ПервыйSequenceТипа(Знач RunId, Знач ТипСобытия)

	МинимальныйSequence = 0;
	Для Каждого СтрокаСобытия Из ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId) Цикл
		Если СтрокаСобытия.ТипСобытия <> ТипСобытия Тогда
			Продолжить;
		КонецЕсли;
		Если МинимальныйSequence = 0 Или СтрокаСобытия.Sequence < МинимальныйSequence Тогда
			МинимальныйSequence = СтрокаСобытия.Sequence;
		КонецЕсли;
	КонецЦикла;
	Возврат МинимальныйSequence;

КонецФункции

// Числовое поле разобранного JSON-payload (0 при отсутствии/ошибке типа).
//
Функция ЧислоИзPayload(Знач Payload, Знач Ключ)

	Значение = ЗначениеPayload(Payload, Ключ);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Значение поля разобранного JSON (ИзJSON возвращает Соответствие или
// Структуру - читается одинаково без исключений).
//
Функция ЗначениеPayload(Знач Payload, Знач Ключ)

	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		Возврат Payload.Получить(Ключ);
	КонецЕсли;
	Значение = Неопределено;
	Если ТипЗнч(Payload) = Тип("Структура") Тогда
		Payload.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Заполняет реестр инструментов ядровыми описаниями
// (ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools) - идемпотентно.
//
Процедура ЗарегистрироватьЯдровойРеестр()

	ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools();

КонецПроцедуры

// Единственное событие с заданным кодом (для проверки payload).
//
Функция ЕдинственноеСобытиеСКодом(Знач RunId, Знач Код)

	Строки = ОМ_ar_ТестовыеДанные.СобытияЗапуска(RunId)
		.НайтиСтроки(Новый Структура("Код", Код));
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строки[0];

КонецФункции

// Массив ответов сценария из переданных элементов (до шести).
//
Функция МассивОтветов(Знач Ответ1, Знач Ответ2 = Неопределено, Знач Ответ3 = Неопределено,
	Знач Ответ4 = Неопределено, Знач Ответ5 = Неопределено, Знач Ответ6 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Ответ1);
	Если Ответ2 <> Неопределено Тогда
		Массив.Добавить(Ответ2);
	КонецЕсли;
	Если Ответ3 <> Неопределено Тогда
		Массив.Добавить(Ответ3);
	КонецЕсли;
	Если Ответ4 <> Неопределено Тогда
		Массив.Добавить(Ответ4);
	КонецЕсли;
	Если Ответ5 <> Неопределено Тогда
		Массив.Добавить(Ответ5);
	КонецЕсли;
	Если Ответ6 <> Неопределено Тогда
		Массив.Добавить(Ответ6);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Массив из одной-двух строк (для белых списков инструментов).
//
Функция МассивСтрок(Знач Строка1, Знач Строка2 = "")

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Если Не ПустаяСтрока(Строка2) Тогда
		Массив.Добавить(Строка2);
	КонецЕсли;
	Возврат Массив;

КонецФункции

#КонецОбласти
