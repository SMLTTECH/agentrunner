		.Свойство("Причина").Равно("completed");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-368 кр. 1 (путь Отменён): отмена запуска на паузе подтверждения
// переводит запись в Прерван (фактическое поведение ar_RuntimeЗапуск.Отменить,
// см. tests.md agentrunner-27), фиксирует дату завершения и снимает захват
// предмета с причиной cancelled; на паузе (нефинальный статус) захват ещё
// держится.
Процедура ОтменаНаПаузеФиксируетАудитИСнимаетЗахват() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	Предмет = СоздатьЗахватПредмета(Подготовка.Агент, Подготовка.RunId, 0);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
