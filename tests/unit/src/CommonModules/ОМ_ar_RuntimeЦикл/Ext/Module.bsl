		.Свойство("Причина").Равно("cancelled")
		.Свойство("СбоевПодряд").Равно(0);

	ЮТест.ОжидаетЧто(ЧислоТиповСобытия(Подготовка.RunId, Перечисления.ar_ТипСобытия.ЗахватСнят)).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-368 кр. 2 (agentrunner-363): принятый итоговый ответ закрывает
// незакрытые пункты плана - in_progress переводится в done, pending в skipped
// с причиной "не понадобился: запуск завершён"; последнее событие ПланОбновлён
// имеет source = core и снимок итоговых статусов шагов.
Процедура ИтоговыйОтветЗакрываетНезакрытыеПунктыПлана() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		ПараметрыСШаблономПлана("Собрать данные", "Разобрать спорные", "Сформировать ответ"));
	// План из шаблона: модель на закрывающем шаге (PLAN-17) закрывает первый
	// пункт, второй оставляет pending, третий ведёт (in_progress) - при
	// завершении ядро закрывает оба: in_progress в done, pending в skipped.
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Отчёт готов."),
			ОтветОбновитьПлан(
				ПунктПланаСоСтатусом("Собрать данные", "done"),
				ПунктПланаСоСтатусом("Разобрать спорные", "pending"),
				ПунктПланаСоСтатусом("Сформировать ответ", "in_progress")),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	СобытиеЗакрытия = ПоследнееСобытиеТипа(Подготовка.RunId, Перечисления.ar_ТипСобытия.ПланОбновлён);
	ЮТест.ОжидаетЧто(СобытиеЗакрытия).Заполнено();
	PayloadЗакрытия = ar_JSON.ИзJSON(СобытиеЗакрытия.PayloadJSON);
	ЮТест.ОжидаетЧто(Строка(ЗначениеPayload(PayloadЗакрытия, "source"))).Равно("core")
		.Что(ЧислоИзPayload(PayloadЗакрытия, "skipped_steps")).Равно(1)
		.Что(Строка(ЗначениеPayload(PayloadЗакрытия, "skipped_reason")))
			.Равно("не понадобился: запуск завершён");

	ШагиПлана = ЗначениеPayload(PayloadЗакрытия, "steps");
	ЮТест.ОжидаетЧто(СтатусШагаПлана(ШагиПлана, "Собрать данные")).Равно("done")
		.Что(СтатусШагаПлана(ШагиПлана, "Разобрать спорные")).Равно("skipped")
		.Что(СтатусШагаПлана(ШагиПлана, "Сформировать ответ")).Равно("done");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-368 кр. 3: повторная финализация прерванного запуска (цикл
// доходит до запуска после отмены оператором) ничего не меняет: запись
// остаётся в Прерван, дата завершения и метрики не перезаписываются,
// поздний переход в Выполняется фиксируется событием late_completion_ignored;
// итогового перехода цикл не делает - до первого шага он выходит на проверке
// отмены (статус Прерван), поэтому событие одно. Захват предмета не
// переснимается.
Процедура ПовторнаяФинализацияПрерванногоНичегоНеМеняет() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	Предмет = СоздатьЗахватПредмета(Подготовка.Агент, Подготовка.RunId, 0);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	ЮТест.ОжидаетЧто(ar_RuntimeЗапуск.Отменить(Подготовка.RunId)).ЭтоИстина();
	ЗапускОтмены = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(ЗапускОтмены).Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван);

	// Повторная финализация: цикл запускается снова по завершённому (Прерван)
	// запуску - как фоновое задание, закончившее шаг после прерывания.
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Повторный прогон."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Прерван)
		.Свойство("ЗавершенВ").Равно(ЗапускОтмены.ЗавершенВ)
		.Свойство("ТокеновВход").Равно(ЗапускОтмены.ТокеновВход);

	// Поздняя попытка одна: переход в Выполняется отклонён и зафиксирован,
	// дальше цикл выходит на проверке отмены (статус Прерван - ar_RuntimeЦикл:
	// ЗавершитьЗапуск Running, heartbeat, ПроверитьОтмену) - итогового
	// перехода до проверки не бывает, инвариант «ничего не меняет» полон.
	ЮТест.ОжидаетЧто(ЧислоСобытийСКодом(Подготовка.RunId, "late_completion_ignored")).Равно(1);

	// Захват снят один раз (при отмене), повторный прогон его не переснимает.
	Захват = ЗахватПоПредмету(Подготовка.Агент, Предмет);
	ЮТест.ОжидаетЧто(Захват).Свойство("Найден").ЭтоИстина()
		.Свойство("RunIdЗахвата").Равно("")
		.Свойство("Причина").Равно("cancelled")
		.Свойство("СбоевПодряд").Равно(0);
	ЮТест.ОжидаетЧто(ЧислоТиповСобытия(Подготовка.RunId, Перечисления.ar_ТипСобытия.ЗахватСнят)).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// agentrunner-377 кр. 3: КаноническийJSON сортирует ключи объектов без учета
// регистра - разные порядки ключей входа дают одну и ту же каноническую
