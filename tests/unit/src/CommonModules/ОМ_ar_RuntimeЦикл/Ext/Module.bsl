///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_RuntimeЦикл.
//
// Интеграционные тесты ReAct-цикла агента (ar_RuntimeЦикл.ВыполнитьАгента)
// на провайдере-заглушке ar_LLMMock: запуск -> рассуждение -> разрешения ->
// инструмент / подтверждение -> завершение и аудит.
//
// Сценарии 1.1-1.13 из scenarios.md задачи agentrunner-27.
// Требования спеки: ВыполнитьАгента вызывается напрямую (синхронно); сценарий
// заглушки покрывает все обращения к модели, включая надзор (ответ
// {"class":"выполнено"} -> ЦельДостигнута -> штатное завершение); негативные
// ответы модели - нетранзиентный код 400; тексты финальных ответов без
// ключевых слов дешёвой проверки надзора (иначе надзор вернёт «Продолжить»
// без LLM и цикл продолжится).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ШтатноеЗавершение")
		.ДобавитьСерверныйТест("ТекстовыйОтветЗавершаетЗапуск").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("ВызовИнструментаЧтенияЗавершаетЗапуск").Тег("critical").ВТранзакции()
			.После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("РазрешенияИПодтверждения")
		.ДобавитьСерверныйТест("ИнструментНеИзСпискаОтклоняетсяЗапускПродолжается").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("ИнструментЗаписиВРучномРежимеЖдётПодтверждения").Тег("critical").ВТранзакции()
			.После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("ЛимитыИОшибки")
		.ДобавитьСерверныйТест("ИсчерпаниеШаговЗавершаетЗапускСпециальнымСтатусом").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("ПревышениеМаксДействийФиксируетсяСобытием").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("НетранзиентнаяОшибкаМоделиЗавершаетЗапускОшибкой").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("НеактивныйАгентЗавершаетЗапускОшибкой").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустойОтветМоделиПовторяетсяОдинРаз").Тег("critical").ВТранзакции()
			.После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("ВозобновлениеИОтмена")
		.ДобавитьСерверныйТест("ВозобновлениеПоСнимкуВосстанавливаетИсторию").Тег("critical").ВТранзакции()
			.После("ОчиститьMock")
		.ДобавитьСерверныйТест("НесовместимыйСнимокЗавершаетЗапускСпециальнымСтатусом").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтменённыйДоШагаЗапускНеВыполняется").Тег("critical").ВТранзакции()
			.После("ОчиститьMock");

	ЮТТесты
		.ДобавитьТестовыйНабор("ПробныйРежим")
		.ДобавитьСерверныйТест("DryRunВыполняетИнструментБезЗаписи").Тег("critical").ВТранзакции()
			.После("ОчиститьMock");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Очистка сценария заглушки после теста (состояние ar_LLMMock живёт в
// ХранилищеОбщихНастроек - вне транзакции теста).
Процедура ОчиститьMock() Экспорт

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.1 Модель сразу отвечает текстом: статус Завершён, события run_started,
// context_built, run_completed, ответ сохранён в записи запуска.
Процедура ТекстовыйОтветЗавершаетЗапуск() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Отчёт готов."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён)
		.Свойство("ОтветLLM").Равно("Отчёт готов.");

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_started")).ЭтоИстина()
		.Что(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "context_built")).ЭтоИстина()
		.Что(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_completed")).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.2 Вызов ядрового инструмента чтения -> текст: событие tool_called,
// запись в ar_ДействияАгента, затем Завершён.
Процедура ВызовИнструментаЧтенияЗавершаетЗапуск() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("get_constants", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Константы получены."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "tool_called")).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Действия).ИмеетДлину(1)
		.Свойство("[0].ИмяИнструмента").Равно("get_constants");

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.3 Вызов инструмента не из списка агента: событие permission_denied с
// причиной tool_not_in_whitelist, запуск продолжается и завершается.
Процедура ИнструментНеИзСпискаОтклоняетсяЗапускПродолжается() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		Новый Структура("ДоступныеИнструменты", МассивСтрок("list_catalogs")));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("get_constants", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Обошёлся без инструмента."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "permission_denied")).ЭтоИстина();

	СобытиеОтказа = ЕдинственноеСобытиеСКодом(Подготовка.RunId, "permission_denied");
	ЮТест.ОжидаетЧто(СтрНайти(СобытиеОтказа.PayloadJSON, "tool_not_in_whitelist") > 0).ЭтоИстина();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId).Количество()).Равно(0);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.4 Вызов инструмента записи в режиме Ручной: запись в ar_ОчередьApproval,
// событие approval_requested, статус ПриостановленДляПодтверждения, снимок
// состояния сохранён.
Процедура ИнструментЗаписиВРучномРежимеЖдётПодтверждения() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	Очередь = ОМ_ar_ТестовыеДанные.ЗаписиОчереди(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Очередь).ИмеетДлину(1)
		.Свойство("[0].Статус").Равно("pending");

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "approval_requested")).ЭтоИстина();

	Снимок = ar_AuditЗапуски.ПрочитатьСнимок(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Снимок <> Неопределено).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.5 Модель бесконечно вызывает инструмент, МаксШагов = 2: статус
// ДостигнутМаксимумШагов, событие max_steps_reached.
Процедура ИсчерпаниеШаговЗавершаетЗапускСпециальнымСтатусом() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Автономный,
		Новый Структура("МаксШагов", 2));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("get_constants", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветToolCall("get_constants", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "max_steps_reached")).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.6 Превышен МаксДействий: событие max_actions_reached, цикл прерван -
// второе действие не выполняется, запуск штатно завершается.
Процедура ПревышениеМаксДействийФиксируетсяСобытием() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Автономный,
		Новый Структура("МаксДействий", 1));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("get_constants", "{}"),
			ОМ_ar_ТестовыеДанные.ОтветТекст("Хватит действий."),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "max_actions_reached")).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Действия.Количество()).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.7 Ошибка модели (нетранзиентная, код 400): статус ОшибкаВыполнения,
// событие run_failed, повторов нет.
Процедура НетранзиентнаяОшибкаМоделиЗавершаетЗапускОшибкой() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветОшибка(400, "Недопустимый запрос теста")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_failed")).ЭтоИстина()
		.Что(ar_LLMMock.ПолучитьСчётчикВызовов()).Равно(1);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.8 Агент не найден / неактивен: статус ОшибкаВыполнения, причина
// agent_not_found_or_inactive.
Процедура НеактивныйАгентЗавершаетЗапускОшибкой() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной,
		Новый Структура("Активен", Ложь));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);

	СобытиеОшибки = ЕдинственноеСобытиеСКодом(Подготовка.RunId, "run_failed");
	ЮТест.ОжидаетЧто(СтрНайти(СобытиеОшибки.PayloadJSON, "agent_not_found_or_inactive") > 0).ЭтоИстина();

КонецПроцедуры

// 1.9 Пустой ответ модели дважды: ровно одна повторная попытка, затем
// корректное завершение (не бесконечный цикл).
Процедура ПустойОтветМоделиПовторяетсяОдинРаз() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст(""),
			ОМ_ar_ТестовыеДанные.ОтветТекст(""),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён)
		.Свойство("ОтветLLM").Заполнено();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_completed")).ЭтоИстина()
		.Что(ar_LLMMock.ПолучитьСчётчикВызовов()).Равно(3);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.10 Возобновление approval_resume со снимком: история и счётчики
// восстановлены из снимка, запуск доходит до Завершён.
Процедура ВозобновлениеПоСнимкуВосстанавливаетИсторию() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);
	ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_инструмент_записи",
		Перечисления.ar_УровеньРиска.Запись, Истина);
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветToolCall("тест_инструмент_записи", "{}")));

	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId);
	ЗапускПауза = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(ЗапускПауза.Статус).Равно(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);

	Снимок = ar_AuditЗапуски.ПрочитатьСнимок(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Снимок <> Неопределено).ЭтоИстина();

	ОМ_ar_ТестовыеДанные.УстановитьСценарий(
		МассивОтветов(
			ОМ_ar_ТестовыеДанные.ОтветТекст("Продолжил после паузы.", 7, 3),
			ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено())));

	КонтекстРезюме = Новый Структура;
	КонтекстРезюме.Вставить("Триггер", "approval_resume");
	КонтекстРезюме.Вставить("Снимок", Снимок);
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId, КонтекстРезюме);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Завершён);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЕстьСобытиеСКодом(Подготовка.RunId, "run_completed")).ЭтоИстина()
		.Что(Запуск.ШаговВсего).Равно(1) // факт: счётчик шагов восстановлен из снимка
		.Что(Запуск.ТокеновВход).Больше(0);

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// 1.11 Возобновление с несовместимым снимком: статус
// ОшибкаНесовместимоеСостояние.
Процедура НесовместимыйСнимокЗавершаетЗапускСпециальнымСтатусом() Экспорт

	Подготовка = ПодготовитьЗапуск(Перечисления.ar_РежимАвтономии.Ручной);

	КонтекстРезюме = Новый Структура;
	КонтекстРезюме.Вставить("Триггер", "approval_resume");
	КонтекстРезюме.Вставить("Снимок", Новый Структура("v, state", 1, "несовместимое состояние"));
	ОМ_ar_ТестовыеДанные.ЗапуститьЦикл(Подготовка.Агент, Подготовка.RunId, КонтекстРезюме);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(Подготовка.RunId);
	ЮТест.ОжидаетЧто(Запуск).Свойство("Найден").ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние);

	СобытиеОшибки = ЕдинственноеСобытиеСКодом(Подготовка.RunId, "run_failed");
