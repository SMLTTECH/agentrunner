///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПакетПрисоединённыеФайлы.
//
// Тесты пакета инструментов ar_ПакетПрисоединённыеФайлы (files_list,
// files_get_text) через его контракт - экспортные методы модуля объекта:
// СведенияОВнешнейОбработке, ar_ОписаниеИнструментов, ar_ВыполнитьИнструмент,
// ar_ИсполнитьПодтверждённыйИнструмент. Служебные функции пакета неэкспортны и
// проверяются через ответы инструментов.
//
// Наборы:
//  - Манифест: схема 2, версия манифеста = версия регистрации, схемы аргументов
//    в формате OpenAI, манифест проходит валидацию ядра, ключи настроек без
//    повторов, команды регистрации БСП;
//  - ОтказыПоАргументам: коды ошибок без обращения к базе файлов и сервисам
//    (неизвестный инструмент, битый JSON, владелец не найден, предел 10 файлов);
//  - ФайлыВладельца: заявка НСИ с двумя файлами создаётся в транзакции теста
//    (откатывается): список файлов, текст из кэша, отказ по расширению без
//    сервиса, пробный запуск. Сервисы RAGU и S.Docster не вызываются: текст
//    берётся из кэша либо отказ происходит до обращения к сервису.
//
// Пакет берётся зарегистрированным: Справочник.ДополнительныеОтчетыИОбработки
// (ИмяОбъекта = "ar_ПакетПрисоединённыеФайлы") ->
// ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки. Пакет не
// зарегистрирован или не подключился - тест пропускается с сообщением.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Манифест")
		.ДобавитьСерверныйТест("МанифестСхемаДваИВерсияРегистрации").Тег("critical")
		.ДобавитьСерверныйТест("СхемыАргументовВФорматеOpenAI").Тег("critical")
		.ДобавитьСерверныйТест("МанифестПроходитВалидациюЯдра").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НастройкиПакетаБезПовторовКлючей").Тег("critical")
		.ДобавитьСерверныйТест("СведенияРегистрацииКомандыИБезопасныйРежим").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("ОтказыПоАргументам")
		.ДобавитьСерверныйТест("НеизвестныйИнструментОтказ").Тег("critical")
		.ДобавитьСерверныйТест("НеверныйJSONАргументовОтказ").Тег("critical")
		.ДобавитьСерверныйТест("ВладелецНеРазобранОтказ").Тег("critical")
		.ДобавитьСерверныйТест("НесуществующийВладелецОтказ").Тег("critical")
		.ДобавитьСерверныйТест("ФайлыНеСтрокиИБитыеСсылкиОтбрасываются").Тег("critical")
		.ДобавитьСерверныйТест("ПределДесятьФайловЗаВызов").Тег("critical")
		.ДобавитьСерверныйТест("ИсполнительПодтвержденногоТолькоДляТекстаФайлов").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("ФайлыВладельца")
		.ДобавитьСерверныйТест("СписокФайловВладельца").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ТекстФайлаИзКэшаБезСервисов").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НеподдерживаемоеРасширениеОтказБезСервиса").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПробныйЗапускБезИзвлечения").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Манифест: схема 2, пространство имён files, версия манифеста равна версии
// регистрации обработки (правило agentrunner-213), два инструмента уровня
// «Чтение» без подтверждения (files_get_text - с agentrunner-100).
Процедура МанифестСхемаДваИВерсияРегистрации() Экспорт

	Пакет = ОбъектПакета();
	Манифест = Пакет.ar_ОписаниеИнструментов();
	Сведения = Пакет.СведенияОВнешнейОбработке();

	ЮТест.ОжидаетЧто(Манифест)
		.Свойство("ВерсияСхемы").Равно(2)
		.Свойство("ПространствоИмён").Равно("files")
		.Свойство("Версия").Равно(Сведения.Версия)
		.Свойство("Категории").ИмеетДлину(1)
		.Свойство("Категории[0].Имя").Равно("files")
		.Свойство("Инструменты").ИмеетДлину(2)
		.Свойство("Инструменты[0].Имя").Равно("files_list")
		.Свойство("Инструменты[0].УровеньРиска").Равно("Чтение")
		.Свойство("Инструменты[0].ТребуетПодтверждения").Равно(Ложь)
		.Свойство("Инструменты[0].Категория").Равно("files")
		.Свойство("Инструменты[1].Имя").Равно("files_get_text")
		.Свойство("Инструменты[1].УровеньРиска").Равно("Чтение")
		.Свойство("Инструменты[1].ТребуетПодтверждения").Равно(Ложь)
		.Свойство("Инструменты[1].Категория").Равно("files");

КонецПроцедуры

// Схема аргументов каждого инструмента - JSON вида {"type":"function",
// "function":{name, description, parameters}}; имя функции совпадает с именем
// инструмента; files_list требует owner, files_get_text принимает files
// (массив строк) или owner.
Процедура СхемыАргументовВФорматеOpenAI() Экспорт

	Пакет = ОбъектПакета();
	Манифест = Пакет.ar_ОписаниеИнструментов();

	Для Каждого Инструмент Из Манифест.Инструменты Цикл
		Схема = ar_JSON.ИзJSON(Инструмент.СхемаАргументовJSON);
		ЮТест.ОжидаетЧто(Схема, Инструмент.Имя)
			.ИмеетТип("Соответствие")
			.Что(Схема.Получить("type"), Инструмент.Имя).Равно("function")
			.Что(Схема.Получить("function").Получить("name"), Инструмент.Имя).Равно(Инструмент.Имя)
			.Что(Схема.Получить("function").Получить("parameters").Получить("type"), Инструмент.Имя)
				.Равно("object");
	КонецЦикла;

	ПараметрыСписка = ПараметрыСхемыИнструмента(Манифест, "files_list");
	ЮТест.ОжидаетЧто(ПараметрыСписка.Получить("required")).Содержит("owner")
		.Что(ПараметрыСписка.Получить("properties").Получить("owner").Получить("type")).Равно("string");

	ПараметрыТекста = ПараметрыСхемыИнструмента(Манифест, "files_get_text");
	СвойствоФайлов = ПараметрыТекста.Получить("properties").Получить("files");
	ЮТест.ОжидаетЧто(СвойствоФайлов.Получить("type")).Равно("array")
		.Что(СвойствоФайлов.Получить("items").Получить("type")).Равно("string")
		.Что(ПараметрыТекста.Получить("properties").Получить("owner")).Заполнено()
		.Что(ПараметрыТекста.Получить("required")).ЭтоНеопределено();

КонецПроцедуры

// Манифест пакета проходит валидацию ядра под идентификатором своей
// регистрации (коллизии пространства имён с самим собой нет).
Процедура МанифестПроходитВалидациюЯдра() Экспорт

	Пакет = ОбъектПакета();
	Результат = ar_ИнструментыПакеты.ВалидироватьМанифест(Пакет.ar_ОписаниеИнструментов(),
		ИдентификаторРегистрацииПакета());

	ЮТест.ОжидаетЧто(Результат.Корректно, СтрСоединить(Результат.Ошибки, "; ")).ЭтоИстина()
		.Что(Результат.Ошибки).ИмеетДлину(0);

КонецПроцедуры

// Ключи настроек пакета уникальны (ядро создаёт настройки по ключу) и
// содержат настройки сервисов распознавания и пределов извлечения.
Процедура НастройкиПакетаБезПовторовКлючей() Экспорт

	Пакет = ОбъектПакета();
	Настройки = Пакет.ar_ОписаниеИнструментов().Настройки;

	Ключи = Новый Соответствие;
	Для Каждого Настройка Из Настройки Цикл
		ЮТест.ОжидаетЧто(Ключи.Получить(Настройка.Ключ), "Повтор ключа " + Настройка.Ключ).ЭтоНеопределено();
		Ключи.Вставить(Настройка.Ключ, Настройка.ЗначениеПоУмолчанию);
	КонецЦикла;

	ЮТест.ОжидаетЧто(Ключи.Получить("ПредельнаяДлинаТекстаФайла")).Равно(50000)
		.Что(Ключи.Получить("ПредельныйРазмерФайлаРаспознавания")).Равно(20000000)
		.Что(Ключи.Получить("ПредельноеВремяВызоваТекстаФайлов")).Равно(600)
		.Что(Ключи.Получить("RAGUОжидание")).Равно(60)
		.Что(Ключи.Получить("OCRВоркеровМаксимум")).Равно(0);

	// Адрес и ключи сервисов - без значения по умолчанию (создаются выключенными).
	ЮТест.ОжидаетЧто(Ключи.Получить("RAGUАдресСервиса")).ЭтоНеопределено()
		.Что(Ключи.Получить("RAGUТокен")).ЭтоНеопределено()
		.Что(Ключи.Получить("SDocsterАдресСервиса")).ЭтоНеопределено();

КонецПроцедуры

// Регистрация БСП: небезопасный режим (выход в сеть к сервисам), маркерная
// команда ar_ToolPack и команда-задание предварительного распознавания.
Процедура СведенияРегистрацииКомандыИБезопасныйРежим() Экспорт

	Пакет = ОбъектПакета();
	Сведения = Пакет.СведенияОВнешнейОбработке();

	ЮТест.ОжидаетЧто(Сведения.БезопасныйРежим).ЭтоЛожь()
		.Что(Сведения.Команды.Найти("ar_ToolPack", "Идентификатор") <> Неопределено, "ar_ToolPack").ЭтоИстина()
		.Что(Сведения.Команды.Найти("ar_ПредварительноеРаспознавание", "Идентификатор") <> Неопределено,
			"ar_ПредварительноеРаспознавание").ЭтоИстина();

КонецПроцедуры

// Имя вне пакета - {"error":"unknown_tool"}.
Процедура НеизвестныйИнструментОтказ() Экспорт

	Пакет = ОбъектПакета();
	ЮТест.ОжидаетЧто(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент("files_delete", "{}", Неопределено)))
		.Равно("unknown_tool");

КонецПроцедуры

// Аргументы не разбираются как JSON или пусты - invalid_json_arguments у обоих
// инструментов.
Процедура НеверныйJSONАргументовОтказ() Экспорт

	Пакет = ОбъектПакета();
	Для Каждого ИмяИнструмента Из ИменаИнструментов() Цикл
		ЮТест.ОжидаетЧто(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента, "не json", Неопределено)),
				ИмяИнструмента)
			.Равно("invalid_json_arguments")
			.Что(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента, "", Неопределено)), ИмяИнструмента)
			.Равно("invalid_json_arguments");
	КонецЦикла;

КонецПроцедуры

// Владелец не передан или ссылка не разбирается - owner_not_found_or_denied
// (у files_get_text - при отсутствии аргумента files).
Процедура ВладелецНеРазобранОтказ() Экспорт

	Пакет = ОбъектПакета();
	Для Каждого ИмяИнструмента Из ИменаИнструментов() Цикл
		ЮТест.ОжидаетЧто(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента, "{}", Неопределено)),
				ИмяИнструмента)
			.Равно("owner_not_found_or_denied")
			.Что(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента,
				АргументыВладельца("Заявка 00-00000001"), Неопределено)), ИмяИнструмента)
			.Равно("owner_not_found_or_denied");
	КонецЦикла;

КонецПроцедуры

// Ссылка разобрана, но объекта нет в базе - тот же код, что у скрытого
// ограничением доступа владельца (запрос РАЗРЕШЕННЫЕ).
Процедура НесуществующийВладелецОтказ() Экспорт

	Пакет = ОбъектПакета();
	СсылкаВладельца = ar_Утилиты.НавигационнаяСсылкаОбъекта(
		Документы.бит_мдм_ЗаявкаНаИзменение.ПолучитьСсылку(Новый УникальныйИдентификатор));

	Для Каждого ИмяИнструмента Из ИменаИнструментов() Цикл
		ЮТест.ОжидаетЧто(КодОшибкиОтвета(Пакет.ar_ВыполнитьИнструмент(ИмяИнструмента,
				АргументыВладельца(СсылкаВладельца), Неопределено)), ИмяИнструмента)
			.Равно("owner_not_found_or_denied");
	КонецЦикла;

КонецПроцедуры

// Элементы files не строкой и неразбираемые ссылки отбрасываются без элемента
// ответа и без учёта в files_skipped.
Процедура ФайлыНеСтрокиИБитыеСсылкиОтбрасываются() Экспорт

	Пакет = ОбъектПакета();
	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_get_text",
		"{""files"": [1, true, ""не ссылка"", ""e1cib/data/Справочник.НетТакого?ref=00""]}", Неопределено));

	ЮТест.ОжидаетЧто(Ответ)
		.НетСвойства("error")
		.Свойство("count").Равно(0)
		.Свойство("files_skipped").Равно(0)
		.Свойство("results").ИмеетДлину(0);

КонецПроцедуры

// Не более 10 файлов за вызов: из 12 ссылок обрабатываются первые 10, лишние -
// в files_skipped; несуществующий файл - элемент с ошибкой
// file_not_found_or_denied (без обращения к сервисам).
Процедура ПределДесятьФайловЗаВызов() Экспорт

	Пакет = ОбъектПакета();
	СсылкиФайлов = Новый Массив;
	Для Номер = 1 По 12 Цикл
		СсылкиФайлов.Добавить(ar_Утилиты.НавигационнаяСсылкаОбъекта(
			Справочники.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы.ПолучитьСсылку(Новый УникальныйИдентификатор)));
	КонецЦикла;

	Аргументы = Новый Структура("files", СсылкиФайлов);
	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_get_text", ar_JSON.ВЗначениеJSON(Аргументы),
		Неопределено));

	ЮТест.ОжидаетЧто(Ответ)
		.Свойство("count").Равно(10)
		.Свойство("files_skipped").Равно(2)
		.Свойство("results").ИмеетДлину(10)
		.Свойство("results[0].ref").Равно(СсылкиФайлов[0])
		.Свойство("results[0].error").Равно("file_not_found_or_denied")
		.Свойство("results[9].ref").Равно(СсылкиФайлов[9])
		.Свойство("results[9].error").Равно("file_not_found_or_denied");

КонецПроцедуры

// Исполнитель подтверждённого действия есть только у files_get_text: прочие
// инструменты - Выполнено = Ложь с no_executor_for_action; files_get_text
// возвращает ответ инструмента единственным сообщением.
Процедура ИсполнительПодтвержденногоТолькоДляТекстаФайлов() Экспорт

	Пакет = ОбъектПакета();

	Отказ = Пакет.ar_ИсполнитьПодтверждённыйИнструмент("files_list", "approval-1", "{}");
	ЮТест.ОжидаетЧто(Отказ)
		.Свойство("Выполнено").Равно(Ложь)
		.Свойство("Сообщения").ИмеетДлину(1)
		.Свойство("Сообщения[0]").Равно("no_executor_for_action:files_list");

	Исполнение = Пакет.ar_ИсполнитьПодтверждённыйИнструмент("files_get_text", "approval-2",
		"{""arguments"": {""files"": []}}");
	ЮТест.ОжидаетЧто(Исполнение)
		.Свойство("Выполнено").Равно(Истина)
		.Свойство("Сообщения").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(ar_JSON.ИзJSON(Исполнение.Сообщения[0]))
		.Свойство("count").Равно(0);

	// Аргументов нет - владелец не найден, Выполнено = Ложь.
	БезАргументов = Пакет.ar_ИсполнитьПодтверждённыйИнструмент("files_get_text", "approval-3", "{}");
	ЮТест.ОжидаетЧто(БезАргументов)
		.Свойство("Выполнено").Равно(Ложь)
		.Что(КодОшибкиОтвета(БезАргументов.Сообщения[0])).Равно("owner_not_found_or_denied");

КонецПроцедуры

// files_list: файлы владельца по имени, признак текста в кэше, расширение,
// навигационная ссылка файла.
Процедура СписокФайловВладельца() Экспорт

	Пакет = ОбъектПакета();
	Владелец = ВладелецСФайлами();

	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_list",
		АргументыВладельца(Владелец.СсылкаВладельца), Неопределено));

	ЮТест.ОжидаетЧто(Ответ)
		.НетСвойства("error")
		.Свойство("owner").Равно(Владелец.СсылкаВладельца)
		.Свойство("count").Равно(2)
		.Свойство("files[0].ref").Равно(Владелец.СсылкаФайлаСТекстом)
		.Свойство("files[0].name").Равно("Анкета контрагента")
		.Свойство("files[0].extension").Равно("txt")
		.Свойство("files[0].has_text").Равно(Истина)
		.Свойство("files[0].encrypted").Равно(Ложь)
		.Свойство("files[0].being_edited").Равно(Ложь)
		.Свойство("files[1].ref").Равно(Владелец.СсылкаФайлаБезТекста)
		.Свойство("files[1].extension").Равно("xyz")
		.Свойство("files[1].has_text").Равно(Ложь);

КонецПроцедуры

// files_get_text по файлу с текстом в кэше: текст возвращается из кэша без
// сервисов (service пуст), saved = Истина, без усечения.
Процедура ТекстФайлаИзКэшаБезСервисов() Экспорт

	Пакет = ОбъектПакета();
	Владелец = ВладелецСФайлами();

	Аргументы = Новый Структура("files", Новый Массив);
	Аргументы.files.Добавить(Владелец.СсылкаФайлаСТекстом);
	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_get_text", ar_JSON.ВЗначениеJSON(Аргументы),
		Новый Структура("RunId", "")));

	ЮТест.ОжидаетЧто(Ответ)
		.Свойство("count").Равно(1)
		.Свойство("files_skipped").Равно(0)
		.Свойство("results[0].ref").Равно(Владелец.СсылкаФайлаСТекстом)
		.Свойство("results[0].name").Равно("Анкета контрагента")
		.Свойство("results[0].source").Равно("кэш")
		.Свойство("results[0].service").Равно("")
		.Свойство("results[0].error").Равно("")
		.Свойство("results[0].saved").Равно(Истина)
		.Свойство("results[0].truncated").Равно(Ложь)
		.Свойство("results[0].text").Содержит("ИНН 7707083893");

КонецПроцедуры

// Файл без текста с расширением, которого нет ни у платформы, ни у сервисов, -
// отказ до чтения данных и обращения к сервису; остальные файлы владельца
// обрабатываются (ошибка одного файла не мешает другим).
Процедура НеподдерживаемоеРасширениеОтказБезСервиса() Экспорт

	Пакет = ОбъектПакета();
	Владелец = ВладелецСФайлами();

	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_get_text",
		АргументыВладельца(Владелец.СсылкаВладельца), Неопределено));

	ЮТест.ОжидаетЧто(Ответ)
		.Свойство("count").Равно(2)
		.Свойство("results[0].source").Равно("кэш")
		.Свойство("results[1].ref").Равно(Владелец.СсылкаФайлаБезТекста)
		.Свойство("results[1].error").Равно("Расширение ""xyz"" не поддерживается")
		.Свойство("results[1].text").Равно("")
		.Свойство("results[1].service").Равно("")
		.Свойство("results[1].saved").Равно(Ложь);

КонецПроцедуры

// Пробный запуск (_dry_run): ответ ядра {dry_run, tool, simulated} с планом по
// каждому файлу, ничего не извлекается и не пишется.
Процедура ПробныйЗапускБезИзвлечения() Экспорт

	Пакет = ОбъектПакета();
	Владелец = ВладелецСФайлами();

	Аргументы = Новый Структура("owner, _dry_run", Владелец.СсылкаВладельца, Истина);
	Ответ = ar_JSON.ИзJSON(Пакет.ar_ВыполнитьИнструмент("files_get_text", ar_JSON.ВЗначениеJSON(Аргументы),
		Неопределено));

	ЮТест.ОжидаетЧто(Ответ)
		.Свойство("dry_run").Равно(Истина)
		.Свойство("tool").Равно("files_get_text")
		.Свойство("simulated.count").Равно(2)
		.Свойство("simulated.files_skipped").Равно(0)
		.Свойство("simulated.files[0].ref").Равно(Владелец.СсылкаФайлаСТекстом)
		.Свойство("simulated.files[0].action").Равно("вернуть текст из кэша")
		.Свойство("simulated.files[1].action").Равно("ошибка: расширение файла не поддерживается");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект зарегистрированного пакета; без регистрации или при ошибке
// подключения тест пропускается с сообщением (не красный). ЮТест.Пропустить
// прерывает тест исключением - код после вызова не выполняется.
//
// Возвращаемое значение:
//  ВнешняяОбработкаОбъект - объект пакета с экспортными функциями.
//
Функция ОбъектПакета()

	СсылкаПакета = СсылкаРегистрацииПакета();

	Попытка
		Объект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(СсылкаПакета);
	Исключение
		ЮТест.Пропустить("Не удалось подключить пакет " + ИмяПакета() + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Объект = Неопределено Тогда
		ЮТест.Пропустить("ОбъектВнешнейОбработки вернул Неопределено для пакета " + ИмяПакета());
	КонецЕсли;

	Возврат Объект;

КонецФункции

// Элемент справочника ДополнительныеОтчетыИОбработки с пакетом; не найден -
// тест пропускается.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - регистрация пакета.
//
Функция СсылкаРегистрацииПакета()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяПакета());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И НЕ ДополнительныеОтчетыИОбработки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЮТест.Пропустить("Пакет " + ИмяПакета() + " не зарегистрирован в справочнике ДополнительныеОтчетыИОбработки");
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Идентификатор пакета для ядра (ar_ИнструментыПакеты): строка UUID элемента
// ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Строка - идентификатор регистрации.
//
Функция ИдентификаторРегистрацииПакета()

	Возврат Строка(СсылкаРегистрацииПакета().УникальныйИдентификатор());

КонецФункции

// Имя объекта обработки пакета.
//
// Возвращаемое значение:
//  Строка - ИмяОбъекта в ДополнительныеОтчетыИОбработки.
//
Функция ИмяПакета()

	Возврат "ar_ПакетПрисоединённыеФайлы";

КонецФункции

// Инструменты пакета.
//
// Возвращаемое значение:
//  Массив из Строка - имена инструментов.
//
Функция ИменаИнструментов()

	Имена = Новый Массив;
	Имена.Добавить("files_list");
	Имена.Добавить("files_get_text");
	Возврат Имена;

КонецФункции

// JSON аргументов {"owner": <ссылка>}.
//
// Параметры:
//  СсылкаВладельца - Строка - значение аргумента owner.
//
// Возвращаемое значение:
//  Строка - JSON аргументов.
//
Функция АргументыВладельца(Знач СсылкаВладельца)

	Возврат ar_JSON.ВЗначениеJSON(Новый Структура("owner", СсылкаВладельца));

КонецФункции

// Код ошибки ответа инструмента ({"error": <код>}); ответ без ошибки -
// Неопределено.
//
// Параметры:
//  ОтветJSON - Строка - ответ инструмента.
//
// Возвращаемое значение:
//  Строка, Неопределено - код ошибки.
//
Функция КодОшибкиОтвета(Знач ОтветJSON)

	Ответ = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ.Получить("error");

КонецФункции

// Параметры JSON-схемы инструмента манифеста (function.parameters).
//
// Параметры:
//  Манифест       - Структура - манифест пакета.
//  ИмяИнструмента - Строка    - имя инструмента.
//
// Возвращаемое значение:
//  Соответствие - parameters схемы аргументов.
//
Функция ПараметрыСхемыИнструмента(Знач Манифест, Знач ИмяИнструмента)

	Для Каждого Инструмент Из Манифест.Инструменты Цикл
		Если Инструмент.Имя = ИмяИнструмента Тогда
			Возврат ar_JSON.ИзJSON(Инструмент.СхемаАргументовJSON).Получить("function").Получить("parameters");
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Инструмент %1 не найден в манифесте", ИмяИнструмента);

КонецФункции

// Новая заявка НСИ (без проведения) с двумя файлами - вызывается в транзакции
// теста, всё откатывается: «Анкета контрагента.txt» с текстом в кэше (текст
// передаётся БСП при добавлении - статус «Извлечен», как у протоколов
// ar_ПакетНСИ) и «Скан реквизитов.xyz» без текста. Нет описания объекта
// обмена «Контрагенты» или заявка не записалась - тест пропускается.
//
// Возвращаемое значение:
//  Структура - навигационные ссылки:
//   * СсылкаВладельца      - Строка - заявка.
//   * СсылкаФайлаСТекстом  - Строка - файл txt с текстом в кэше.
//   * СсылкаФайлаБезТекста - Строка - файл xyz без текста.
//
Функция ВладелецСФайлами()

	ОписаниеОбъекта = ОписаниеОбъектаКонтрагенты();

	Попытка
		Заявка = Документы.бит_мдм_ЗаявкаНаИзменение.СоздатьДокумент();
		Заявка.Дата = ТекущаяДатаСеанса();
		Заявка.ВидОперации = Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение;
		Заявка.ОписаниеОбъекта = ОписаниеОбъекта;
		Заявка.Ответственный = Пользователи.ТекущийПользователь();
		Заявка.Комментарий = "Тест ОМ_ar_ПакетПрисоединённыеФайлы";
		Заявка.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЮТест.Пропустить("Не удалось создать заявку НСИ - владельца файлов: " + ТекстОшибки);
	КонецПопытки;

	ТекстАнкеты = "Анкета контрагента
		|ИНН 7707083893
		|Расчетный счет 40702510400000002345";
	ФайлСТекстом = ДобавитьФайлЗаявки(Заявка.Ссылка, "Анкета контрагента", "txt",
		ПолучитьДвоичныеДанныеИзСтроки(ТекстАнкеты, КодировкаТекста.UTF8, Ложь), Истина);
	ФайлБезТекста = ДобавитьФайлЗаявки(Заявка.Ссылка, "Скан реквизитов", "xyz",
		ПолучитьДвоичныеДанныеИзСтроки("xyz", КодировкаТекста.UTF8, Ложь), Ложь);

	Результат = Новый Структура;
	Результат.Вставить("СсылкаВладельца", ar_Утилиты.НавигационнаяСсылкаОбъекта(Заявка.Ссылка));
	Результат.Вставить("СсылкаФайлаСТекстом", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлСТекстом));
	Результат.Вставить("СсылкаФайлаБезТекста", ar_Утилиты.НавигационнаяСсылкаОбъекта(ФайлБезТекста));
	Возврат Результат;

КонецФункции

// Присоединённый файл заявки через РаботаСФайлами.ДобавитьФайл; данные и текст -
// разные адреса временного хранилища (БСП может освободить адрес текста после
// чтения), оба освобождаются после записи.
//
// Параметры:
//  Заявка             - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - владелец.
//  ИмяБезРасширения   - Строка          - имя файла.
//  Расширение         - Строка          - расширение без точки.
//  ДвоичныеДанные     - ДвоичныеДанные  - содержимое файла.
//  ТекстВКэш          - Булево          - передать содержимое как извлечённый текст.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_мдм_ЗаявкаНаИзменениеПрисоединенныеФайлы - файл.
//
Функция ДобавитьФайлЗаявки(Знач Заявка, Знач ИмяБезРасширения, Знач Расширение, Знач ДвоичныеДанные,
	Знач ТекстВКэш)

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Заявка;
	ПараметрыФайла.ИмяБезРасширения = ИмяБезРасширения;
	ПараметрыФайла.РасширениеБезТочки = Расширение;
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();

	ИдентификаторХранения = Новый УникальныйИдентификатор;
	АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения);
	АдресТекста = "";
	Если ТекстВКэш Тогда
		АдресТекста = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторХранения);
	КонецЕсли;

	Попытка
		Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанных, АдресТекста);
	Исключение
		ОсвободитьАдреса(АдресДанных, АдресТекста);
		ВызватьИсключение;
	КонецПопытки;
	ОсвободитьАдреса(АдресДанных, АдресТекста);

	Возврат Файл;

КонецФункции

// Освобождает адреса временного хранилища (пустой адрес пропускается).
//
// Параметры:
//  АдресДанных - Строка - адрес данных файла.
//  АдресТекста - Строка - адрес текста файла либо "".
//
Процедура ОсвободитьАдреса(Знач АдресДанных, Знач АдресТекста)

	Если ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		УдалитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(АдресТекста) Тогда
		УдалитьИзВременногоХранилища(АдресТекста);
	КонецЕсли;

КонецПроцедуры

// Описание объекта обмена «Контрагенты» текущей базы (как у СТ_НСИОбщий):
// нужно для записи заявки. Не найдено - тест пропускается.
//
// Возвращаемое значение:
//  СправочникСсылка.бит_мдм_ОписанияОбъектовОбмена - описание.
//
Функция ОписаниеОбъектаКонтрагенты()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Описания.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ОписанияОбъектовОбмена КАК Описания
		|ГДЕ
		|	Описания.Наименование = ""Контрагенты""
		|	И Описания.Владелец = ЗНАЧЕНИЕ(Справочник.бит_мпд_ВидыИнформационныхБаз.ТекущаяИнформационнаяБаза)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ЮТест.Пропустить("Описание объекта обмена «Контрагенты» текущей базы не найдено");
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
