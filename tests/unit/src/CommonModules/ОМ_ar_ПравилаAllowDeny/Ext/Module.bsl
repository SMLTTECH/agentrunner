///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПравилаAllowDeny.
//
// Тесты правил allow/deny (ar_ПравилаAllowDeny): ЭтоРазрешеноПоПравилам
// (три состояния логики: без ограничений, только разрешённые, все кроме
// запрещённых; приоритет запрета над разрешением), КлассификацияПравил.
//
// Сценарии раздела 2 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("РазрешениеПоПравилам")
		.ДобавитьСерверныйТест("БезПравилВсёРазрешено").Тег("critical")
		.ДобавитьСерверныйТест("ТолькоРазрешённыеПропускаютСовпадения").Тег("critical")
		.ДобавитьСерверныйТест("ЗапретПобеждаетРазрешение").Тег("critical")
		.ДобавитьСерверныйТест("ПустоеЗначениеНеРазрешено").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("Классификация")
		.ДобавитьСерверныйТест("КлассификацияТрёхСостояний").Тег("critical")
		.ДобавитьСерверныйТест("СпискиКлассификацииУчитываютПриоритетЗапрета").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Без правил (пустой массив) значение разрешено - ограничений нет.
Процедура БезПравилВсёРазрешено() Экспорт

	ЮТест.ОжидаетЧто(
		ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("Справочник.Валюты", Новый Массив)).ЭтоИстина();

КонецПроцедуры

// Есть разрешающие правила - разрешено только совпавшее.
Процедура ТолькоРазрешённыеПропускаютСовпадения() Экспорт

	Правила = Новый Массив;
	Правила.Добавить(Правило("Справочник.Валюты", Истина));
	Правила.Добавить(Правило("Справочник.Контрагенты", Истина));

	ЮТест.ОжидаетЧто(
		ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("Справочник.Валюты", Правила)).ЭтоИстина()
		.Что(ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("Справочник.Контрагенты", Правила)).ЭтоИстина()
		.Что(ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("Документ.ЗаказКлиента", Правила)).ЭтоЛожь();

КонецПроцедуры

// Запрещающее правило побеждает разрешающее (даже при совпадении обоих).
Процедура ЗапретПобеждаетРазрешение() Экспорт

	Правила = Новый Массив;
	Правила.Добавить(Правило("Справочник.Валюты", Истина));
	Правила.Добавить(Правило("Справочник.Валюты", Ложь));

	ЮТест.ОжидаетЧто(
		ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("Справочник.Валюты", Правила)).ЭтоЛожь();

КонецПроцедуры

// Пустое проверяемое значение не разрешено.
Процедура ПустоеЗначениеНеРазрешено() Экспорт

	ЮТест.ОжидаетЧто(
		ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам("", Новый Массив)).ЭтоЛожь();

КонецПроцедуры

// Классификация правил: три состояния - без ограничений, только разрешённые,
// все кроме запрещённых.
Процедура КлассификацияТрёхСостояний() Экспорт

	ПустыеПравила = Новый Массив;
	КлассификацияПустых = ar_ПравилаAllowDeny.КлассификацияПравил(ПустыеПравила);
	ЮТест.ОжидаетЧто(КлассификацияПустых.Состояние)
		.Равно(ar_ПравилаAllowDeny.СостояниеБезОграничений());

	ТолькоРазрешающие = Новый Массив;
	ТолькоРазрешающие.Добавить(Правило("Справочник.Валюты", Истина));
	КлассификацияРазрешающих = ar_ПравилаAllowDeny.КлассификацияПравил(ТолькоРазрешающие);
	ЮТест.ОжидаетЧто(КлассификацияРазрешающих.Состояние)
		.Равно(ar_ПравилаAllowDeny.СостояниеТолькоРазрешённые());

	ТолькоЗапрещающие = Новый Массив;
	ТолькоЗапрещающие.Добавить(Правило("Справочник.Валюты", Ложь));
	КлассификацияЗапрещающих = ar_ПравилаAllowDeny.КлассификацияПравил(ТолькоЗапрещающие);
	ЮТест.ОжидаетЧто(КлассификацияЗапрещающих.Состояние)
		.Равно(ar_ПравилаAllowDeny.СостояниеВсеКромеЗапрещённых());

КонецПроцедуры

// В расшифровке классификации запрет вытесняет значение из списка разрешённых.
Процедура СпискиКлассификацииУчитываютПриоритетЗапрета() Экспорт

	Правила = Новый Массив;
	Правила.Добавить(Правило("Справочник.Валюты", Истина));
	Правила.Добавить(Правило("Справочник.Контрагенты", Истина));
	Правила.Добавить(Правило("Справочник.Валюты", Ложь));

	Классификация = ar_ПравилаAllowDeny.КлассификацияПравил(Правила);

	ЮТест.ОжидаетЧто(Классификация.СписокЗапретить.Количество()).Равно(1)
		.Свойство("[0]").Равно("Справочник.Валюты");
	ЮТест.ОжидаетЧто(Классификация.СписокРазрешить.Количество()).Равно(1)
		.Свойство("[0]").Равно("Справочник.Контрагенты");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правило allow/deny: {Значение, Разрешить}.
//
Функция Правило(Знач Значение, Знач Разрешить)

	Возврат Новый Структура("Значение, Разрешить", Значение, Разрешить);

КонецФункции

#КонецОбласти
