///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПланЗапуска.
//
// Тесты плана запуска (ar_ПланЗапуска): Применить - лимит 12 пунктов,
// заголовок до 150 символов (обрезка = признак усечения), слияние по
// заголовку (анти-раззакрытие done), пропавшие пункты -> removed;
// ТекущийПункт (первый in_progress, иначе pending), Прогресс ({Всего,
// Закрыто}).
//
// Сценарии раздела 8 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Применение")
		.ДобавитьСерверныйТест("НовыйПланПустой").Тег("critical")
		.ДобавитьСерверныйТест("ПрименитьСоздаетПункты").Тег("critical")
		.ДобавитьСерверныйТест("Лимит12Пунктов").Тег("critical")
		.ДобавитьСерверныйТест("ДлинныйЗаголовокОбрезается").Тег("critical")
		.ДобавитьСерверныйТест("СлияниеПоЗаголовкуСохраняетDone").Тег("critical")
		.ДобавитьСерверныйТест("НевалидныеПунктыПропускаются").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("Чтение")
		.ДобавитьСерверныйТест("ТекущийПунктВыбирается").Тег("critical")
		.ДобавитьСерверныйТест("ПрогрессСчитается").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-20 ШаблонПлана")
		.ДобавитьСерверныйТест("РазборСтрокиШаблонаНормализуется").Тег("critical")
		.ДобавитьСерверныйТест("ПланИзШаблонаЛимитыИПервыйШаг").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-66 ПропускПоПричине")
		.ДобавитьСерверныйТест("ПропускОбязательногоСПричинойИБез").Тег("critical");

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-107 ПорядокИСлияние")
		.ДобавитьСерверныйТест("ПорядокОбязательныхСохраняется").Тег("critical")
		.ДобавитьСерверныйТест("ДубльЗакрытогоШагаНеДублируется").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// НовыйПлан: пустые пункты, без усечения.
Процедура НовыйПланПустой() Экспорт

	План = ar_ПланЗапуска.НовыйПлан();

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(План)
		.Свойство("Усечено").ЭтоЛожь();

КонецПроцедуры

// Применить создаёт пункты с нормализованными статусами.
Процедура ПрименитьСоздаетПункты() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Собрать данные", "in_progress"));
	Пункты.Добавить(Пункт("Оформить документ", "бредовый статус"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(План.Пункты)
		.Свойство("[0].Заголовок").Равно("Собрать данные")
		.Свойство("[0].Статус").Равно("in_progress")
		.Свойство("[1].Статус").Равно("pending");
	ЮТест.ОжидаетЧто(План).Свойство("Усечено").ЭтоЛожь();

КонецПроцедуры

// Лимит 12 пунктов: сверх лимита отбрасываются, Усечено = Истина.
Процедура Лимит12Пунктов() Экспорт

	Пункты = Новый Массив;
	Для Сч = 1 По 15 Цикл
		Пункты.Добавить(Пункт("Пункт " + Сч, "pending"));
	КонецЦикла;

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(12);
	ЮТест.ОжидаетЧто(План)
		.Свойство("Усечено").ЭтоИстина();

КонецПроцедуры

// Заголовок длиннее 150 символов обрезается, план помечен усечённым.
Процедура ДлинныйЗаголовокОбрезается() Экспорт

	ДлинныйЗаголовок = Повторить("з", 200);

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт(ДлинныйЗаголовок, "pending"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(План.Пункты)
		.Свойство("[0].Заголовок").Заполнено();
	ЮТест.ОжидаетЧто(СтрДлина(План.Пункты[0].Заголовок)).Равно(150)
		.Что(План.Усечено).ЭтоИстина();

КонецПроцедуры

// Слияние по заголовку: выполненный пункт не раззакрывается при повторном
// поступлении с тем же заголовком и статусом pending.
Процедура СлияниеПоЗаголовкуСохраняетDone() Экспорт

	Пункты1 = Новый Массив;
	Пункты1.Добавить(Пункт("Шаг один", "done"));
	Пункты1.Добавить(Пункт("Шаг два", "pending"));
	План1 = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты1);

	Пункты2 = Новый Массив;
	Пункты2.Добавить(Пункт("шаг ОДИН", "pending"));
	Пункты2.Добавить(Пункт("Шаг два", "done"));

	План2 = ar_ПланЗапуска.Применить(План1, Пункты2);

	ЮТест.ОжидаетЧто(План2.Пункты.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(План2.Пункты)
		// Сопоставленный по нормализованному заголовку пункт сохраняет заголовок
		// прежнего пункта плана (шаг шаблона), регистр из нового списка модели
		// игнорируется (agentrunner-66, PLAN Б.1); done-статус сохраняется.
		.Свойство("[0].Заголовок").Равно("Шаг один")
		.Свойство("[0].Статус").Равно("done")
		.Свойство("[1].Статус").Равно("done");

КонецПроцедуры

// Мусорные пункты (не структура, без title, пустой title) пропускаются.
Процедура НевалидныеПунктыПропускаются() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить("не структура");
	Пункты.Добавить(Новый Структура("status", "done"));
	Пункты.Добавить(Пункт("   ", "pending"));
	Пункты.Добавить(Пункт("Валидный пункт", "pending"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(План.Пункты)
		.Свойство("[0].Заголовок").Равно("Валидный пункт");

КонецПроцедуры

// ТекущийПункт: первый in_progress, иначе первый pending, иначе
// Неопределено.
Процедура ТекущийПунктВыбирается() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Готовый", "done"));
	Пункты.Добавить(Пункт("В работе", "in_progress"));
	Пункты.Добавить(Пункт("Ожидающий", "pending"));
	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	Текущий = ar_ПланЗапуска.ТекущийПункт(План);
	ЮТест.ОжидаетЧто(Текущий.Заголовок).Равно("В работе");

	// Всё закрыто - Неопределено.
	ПунктыГотовые = Новый Массив;
	ПунктыГотовые.Добавить(Пункт("Только готовый", "done"));
	ПланГотовый = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), ПунктыГотовые);

	ЮТест.ОжидаетЧто(ar_ПланЗапуска.ТекущийПункт(ПланГотовый)).Равно(Неопределено);

КонецПроцедуры

// Прогресс: Всего - не removed, Закрыто - done и skipped.
Процедура ПрогрессСчитается() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Один", "done"));
	Пункты.Добавить(Пункт("Два", "skipped"));
	Пункты.Добавить(Пункт("Три", "pending"));
	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	Прогресс = ar_ПланЗапуска.Прогресс(План);

	ЮТест.ОжидаетЧто(Прогресс).Свойство("Всего").Равно(3)
		.Свойство("Закрыто").Равно(2);

КонецПроцедуры

// agentrunner-20 кр. 5: маркеры списка, нумерация и обрамление снимаются;
// "Шаг|tool|инструкция" делает пункт обязательным со списком закрывающих
// инструментов и инструкцией.
Процедура РазборСтрокиШаблонаНормализуется() Экспорт

	ЮТест.ОжидаетЧто(ar_ПланЗапуска.РазобратьСтрокуШаблона("- Первый"))
		.Свойство("Заголовок").Равно("Первый")
		.Свойство("Обязательный").ЭтоЛожь()
		.Что(ar_ПланЗапуска.РазобратьСтрокуШаблона("2. Второй").Заголовок).Равно("Второй")
		.Что(ar_ПланЗапуска.РазобратьСтрокуШаблона("   Третий  ").Заголовок).Равно("Третий");

	Разбор = ar_ПланЗапуска.РазобратьСтрокуШаблона("Проверить|tool_a, tool_b|Сначала проверь");
	ЮТест.ОжидаетЧто(Разбор).Свойство("Заголовок").Равно("Проверить")
		.Свойство("Обязательный").ЭтоИстина()
		.Свойство("Инструкция").Равно("Сначала проверь");
	ЮТест.ОжидаетЧто(Разбор.ЗакрывающиеИнструменты).ИмеетДлину(2)
		.Свойство("[0]").Равно("tool_a")
		.Свойство("[1]").Равно("tool_b");

КонецПроцедуры

// agentrunner-20 кр. 6: шаблон из 14 строк, одна длиннее 150 символов - план
// из 12 пунктов, длинный заголовок обрезан до 150, план помечен усечённым;
// первый обязательный пункт открывается in_progress.
Процедура ПланИзШаблонаЛимитыИПервыйШаг() Экспорт

	ПунктыШаблона = Новый Массив;
	Для Сч = 1 По 11 Цикл
		ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона("Шаг " + Сч + "|тест_тул"));
	КонецЦикла;
	ПунктыШаблона.Добавить(
		ar_ПланЗапуска.РазобратьСтрокуШаблона(Повторить("длинный заголовок ", 12)));

	План = ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(12);
	ЮТест.ОжидаетЧто(План).Свойство("Усечено").ЭтоИстина();
	ЮТест.ОжидаетЧто(План.Пункты)
		.Свойство("[0].Заголовок").Равно("Шаг 1")
		.Свойство("[0].Статус").Равно("in_progress")
		.Свойство("[1].Статус").Равно("pending")
		.Что(СтрДлина(План.Пункты[11].Заголовок)).Равно(150);

КонецПроцедуры

// agentrunner-66 кр. 5: пропуск обязательного шага update_plan'ом применяется
// только с непустой причиной (заполняется ПричинаПропуска, заголовок шага
// прежний, лишних пунктов нет); без причины шаг не изменен, пункт попадает
// в предупреждения.
Процедура ПропускОбязательногоСПричинойИБез() Экспорт

	ПунктыШаблона = Новый Массив;
	ПунктыШаблона.Добавить(
		ar_ПланЗапуска.РазобратьСтрокуШаблона("Сверка с ЕГРЮЛ|nsi_official_data"));
	ПунктыШаблона.Добавить(
		ar_ПланЗапуска.РазобратьСтрокуШаблона("Решение по визе|nsi_set_visa_decision"));
	План = ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона);

	ПунктыМодели = Новый Массив;
	ПунктыМодели.Добавить(Пункт("Сверка с ЕГРЮЛ", "skipped"));
	ПланПропуск = ar_ПланЗапуска.ПрименитьСПричиной(План, ПунктыМодели, "Сервис ЕГРЮЛ недоступен");

	ЮТест.ОжидаетЧто(ПланПропуск.Пункты.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ПланПропуск.Пункты)
		.Свойство("[0].Заголовок").Равно("Сверка с ЕГРЮЛ")
		.Свойство("[0].Статус").Равно("skipped")
		.Свойство("[0].ПричинаПропуска").Равно("Сервис ЕГРЮЛ недоступен")
		.Свойство("[1].Заголовок").Равно("Решение по визе");

	Отчет = ar_ПланЗапуска.ПрименитьСОтчетом(
		ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона), ПунктыМодели, "");

	ЮТест.ОжидаетЧто(Отчет.План.Пункты)
		.Свойство("[0].Статус").НеРавно("skipped");
	ЮТест.ОжидаетЧто(Отчет.Предупреждения.Количество()).Больше(0);

КонецПроцедуры

// agentrunner-107 кр. 2: перемешанный список модели не меняет порядок
// обязательных шагов шаблона (А, Б, В), пункт модели добавляется после
// последнего сопоставленного, отсутствующий в списке шаблонный пункт
// ("Итоговый отчёт") не снимается.
Процедура ПорядокОбязательныхСохраняется() Экспорт

	ПунктыШаблона = Новый Массив;
	ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона("А|тул_а"));
	ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона("Б|тул_б"));
	ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона("В|тул_в"));
	ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона("Итоговый отчёт"));
	План = ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона);

	ПунктыМодели = Новый Массив;
	ПунктыМодели.Добавить(Пункт("В", "pending"));
	ПунктыМодели.Добавить(Пункт("Б", "pending"));
	ПунктыМодели.Добавить(Пункт("Свой пункт", "pending"));
	ПунктыМодели.Добавить(Пункт("А", "pending"));
	ПланСлитый = ar_ПланЗапуска.Применить(План, ПунктыМодели);

	// Скелет результата - прежние пункты в их порядке; группа новых пунктов
	// модели вставляется единым блоком после последнего сопоставленного (В).
	ЮТест.ОжидаетЧто(ПланСлитый.Пункты).ИмеетДлину(5)
		.Свойство("[0].Заголовок").Равно("А")
		.Свойство("[1].Заголовок").Равно("Б")
		.Свойство("[2].Заголовок").Равно("В")
		.Свойство("[3].Заголовок").Равно("Свой пункт")
		.Свойство("[3].Статус").Равно("pending")
		.Свойство("[4].Заголовок").Равно("Итоговый отчёт")
		.Свойство("[4].Статус").НеРавно("removed");

КонецПроцедуры

// agentrunner-107 кр. 3: пункт модели, повторяющий закрытый обязательный шаг
// (совпадение по нормализованному заголовку), не создает дубль - шаг остается
// в единственном экземпляре со статусом done.
Процедура ДубльЗакрытогоШагаНеДублируется() Экспорт

	ПунктыШаблона = Новый Массив;
	ПунктыШаблона.Добавить(
		ar_ПланЗапуска.РазобратьСтрокуШаблона("Сверка контрагента|тест_тул_сверка"));
	План = ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона);
	Закрытие = ar_ПланЗапуска.ЗакрытьШагИнструментом(План, "тест_тул_сверка");
	ЮТест.ОжидаетЧто(Закрытие.Закрыт).ЭтоИстина();

	ПунктыМодели = Новый Массив;
	ПунктыМодели.Добавить(Пункт("СВЕРКА КОНТРАГЕНТА", "pending"));
	ПланСлитый = ar_ПланЗапуска.Применить(План, ПунктыМодели);

	ЮТест.ОжидаетЧто(ПланСлитый.Пункты).ИмеетДлину(1)
		.Свойство("[0].Заголовок").Равно("Сверка контрагента")
		.Свойство("[0].Статус").Равно("done");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пункт плана от LLM: {title, status}.
//
Функция Пункт(Знач Заголовок, Знач Статус)

	Возврат Новый Структура("title, status", Заголовок, Статус);

КонецФункции

// Повторяет строку заданное число раз.
//
Функция Повторить(Знач Фрагмент, Знач Раз)

	Результат = "";
	Для Сч = 1 По Раз Цикл
		Результат = Результат + Фрагмент;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
