///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПланЗапуска.
//
// Тесты плана запуска (ar_ПланЗапуска): Применить - лимит 12 пунктов,
// заголовок до 150 символов (обрезка = признак усечения), слияние по
// заголовку (анти-раззакрытие done), пропавшие пункты -> removed;
// ТекущийПункт (первый in_progress, иначе pending), Прогресс ({Всего,
// Закрыто}).
//
// Сценарии раздела 8 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Применение")
		.ДобавитьСерверныйТест("НовыйПланПустой").Тег("critical")
		.ДобавитьСерверныйТест("ПрименитьСоздаетПункты").Тег("critical")
		.ДобавитьСерверныйТест("Лимит12Пунктов").Тег("critical")
		.ДобавитьСерверныйТест("ДлинныйЗаголовокОбрезается").Тег("critical")
		.ДобавитьСерверныйТест("СлияниеПоЗаголовкуСохраняетDone").Тег("critical")
		.ДобавитьСерверныйТест("НевалидныеПунктыПропускаются").Тег("critical");

	ЮТесты
		.ДобавитьТестовыйНабор("Чтение")
		.ДобавитьСерверныйТест("ТекущийПунктВыбирается").Тег("critical")
		.ДобавитьСерверныйТест("ПрогрессСчитается").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// НовыйПлан: пустые пункты, без усечения.
Процедура НовыйПланПустой() Экспорт

	План = ar_ПланЗапуска.НовыйПлан();

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(0)
		.Свойство("Усечено").ЭтоЛожь();

КонецПроцедуры

// Применить создаёт пункты с нормализованными статусами.
Процедура ПрименитьСоздаетПункты() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Собрать данные", "in_progress"));
	Пункты.Добавить(Пункт("Оформить документ", "бредовый статус"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(2)
		.Свойство("[0].Заголовок").Равно("Собрать данные")
		.Свойство("[0].Статус").Равно("in_progress")
		.Свойство("[1].Статус").Равно("pending")
		.Свойство("Усечено").ЭтоЛожь();

КонецПроцедуры

// Лимит 12 пунктов: сверх лимита отбрасываются, Усечено = Истина.
Процедура Лимит12Пунктов() Экспорт

	Пункты = Новый Массив;
	Для Сч = 1 По 15 Цикл
		Пункты.Добавить(Пункт("Пункт " + Сч, "pending"));
	КонецЦикла;

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(12)
		.Свойство("Усечено").ЭтоИстина();

КонецПроцедуры

// Заголовок длиннее 150 символов обрезается, план помечен усечённым.
Процедура ДлинныйЗаголовокОбрезается() Экспорт

	ДлинныйЗаголовок = Повторить("з", 200);

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт(ДлинныйЗаголовок, "pending"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(1)
		.Свойство("[0].Заголовок").Заполнено();
	ЮТест.ОжидаетЧто(СтрДлина(План.Пункты[0].Заголовок)).Равно(150)
		.Что(План.Усечено).ЭтоИстина();

КонецПроцедуры

// Слияние по заголовку: выполненный пункт не раззакрывается при повторном
// поступлении с тем же заголовком и статусом pending.
Процедура СлияниеПоЗаголовкуСохраняетDone() Экспорт

	Пункты1 = Новый Массив;
	Пункты1.Добавить(Пункт("Шаг один", "done"));
	Пункты1.Добавить(Пункт("Шаг два", "pending"));
	План1 = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты1);

	Пункты2 = Новый Массив;
	Пункты2.Добавить(Пункт("шаг ОДИН", "pending"));
	Пункты2.Добавить(Пункт("Шаг два", "done"));

	План2 = ar_ПланЗапуска.Применить(План1, Пункты2);

	ЮТест.ОжидаетЧто(План2.Пункты.Количество()).Равно(2)
		.Свойство("[0].Заголовок").Равно("Шаг один")
		.Свойство("[0].Статус").Равно("done")
		.Свойство("[1].Статус").Равно("done");

КонецПроцедуры

// Мусорные пункты (не структура, без title, пустой title) пропускаются.
Процедура НевалидныеПунктыПропускаются() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить("не структура");
	Пункты.Добавить(Новый Структура("status", "done"));
	Пункты.Добавить(Пункт("   ", "pending"));
	Пункты.Добавить(Пункт("Валидный пункт", "pending"));

	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	ЮТест.ОжидаетЧто(План.Пункты.Количество()).Равно(1)
		.Свойство("[0].Заголовок").Равно("Валидный пункт");

КонецПроцедуры

// ТекущийПункт: первый in_progress, иначе первый pending, иначе
// Неопределено.
Процедура ТекущийПунктВыбирается() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Готовый", "done"));
	Пункты.Добавить(Пункт("В работе", "in_progress"));
	Пункты.Добавить(Пункт("Ожидающий", "pending"));
	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	Текущий = ar_ПланЗапуска.ТекущийПункт(План);
	ЮТест.ОжидаетЧто(Текущий.Заголовок).Равно("В работе");

	// Всё закрыто - Неопределено.
	ПунктыГотовые = Новый Массив;
	ПунктыГотовые.Добавить(Пункт("Только готовый", "done"));
	ПланГотовый = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), ПунктыГотовые);

	ЮТест.ОжидаетЧто(ar_ПланЗапуска.ТекущийПункт(ПланГотовый)).Равно(Неопределено);

КонецПроцедуры

// Прогресс: Всего - не removed, Закрыто - done.
Процедура ПрогрессСчитается() Экспорт

	Пункты = Новый Массив;
	Пункты.Добавить(Пункт("Один", "done"));
	Пункты.Добавить(Пункт("Два", "done"));
	Пункты.Добавить(Пункт("Три", "pending"));
	План = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), Пункты);

	Прогресс = ar_ПланЗапуска.Прогресс(План);

	ЮТест.ОжидаетЧто(Прогресс.Всего).Равно(3)
		.Свойство("Закрыто").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пункт плана от LLM: {title, status}.
//
Функция Пункт(Знач Заголовок, Знач Статус)

	Возврат Новый Структура("title, status", Заголовок, Статус);

КонецФункции

// Повторяет строку заданное число раз.
//
Функция Повторить(Знач Фрагмент, Знач Раз)

	Результат = "";
	Для Сч = 1 По Раз Цикл
		Результат = Результат + Фрагмент;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
