///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ИнструментыДиспетчер.
//
// Тесты диспетчера инструментов (ar_ИнструментыДиспетчер): Вызвать - успешный
// вызов ядрового инструмента чтения (структура результата {Успех, Результат,
// ResultRef, RiskLevel}, запись в ar_ДействияАгента), неизвестное имя и пустая
// ссылка (tool_ref_missing) - наблюдение с ошибкой БЕЗ исключения наружу,
// отключённый инструмент, аргументы больше 64 КБ (arguments_too_large),
// невалидный JSON аргументов (передаётся инструменту, ошибки диспетчера нет),
// повторный вызов с тем же ключом идемпотентности возвращает прежний результат;
// ИзвлечьDryRun, ИзвлечьIdempotencyKey, СформироватьDryRunJSON,
// НайтиToolПоИмени, НормализованнаяВерсия.
//
// Сценарии раздела 4 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ВызовИнструмента")
		.ДобавитьСерверныйТест("УспешныйВызовЧитающегоИнструмента").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НеизвестноеИмяБезИсключения").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПустаяСсылкаДаетToolRefMissing").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтключенныйИнструментБезИсключения").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СлишкомБольшиеАргументыОтклоняются").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НевалидныйJSONПередаетсяИнструменту").Тег("critical").ВТранзакции();

	ЮТесты
		.ДобавитьТестовыйНабор("СлужебныеФункции")
		.ДобавитьСерверныйТест("ИзвлечьDryRunИКлючИдемпотентности").Тег("critical")
		.ДобавитьСерверныйТест("СформироватьDryRunJSONСтруктура").Тег("critical")
		.ДобавитьСерверныйТест("НормализованнаяВерсияДополняетДвухсоставную").Тег("critical")
		.ДобавитьСерверныйТест("НайтиToolПоИмениВозвращаетСсылкуИлиНеопределено").Тег("critical").ВТранзакции();

	ЮТесты
		.ДобавитьТестовыйНабор("Идемпотентность")
		.ДобавитьСерверныйТест("ПовторныйВызовСКлючомВозвращаетКэш").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Успешный вызов ядрового get_constants: Успех = Истина, JSON-наблюдение без
// ошибки, RiskLevel передан, действие записано в ar_ДействияАгента.
Процедура УспешныйВызовЧитающегоИнструмента() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Контекст = КонтекстЗапуска();

	Результат = ar_ИнструментыДиспетчер.Вызвать("get_constants", "{}", Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина()
		.Свойство("Результат").Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Результат, """error""") = 0).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Контекст.RunId);
	ЮТест.ОжидаетЧто(Действия.Количество()).Равно(1)
		.Свойство("[0].ИмяИнструмента").Равно("get_constants");

КонецПроцедуры

// Неизвестное имя: наблюдение с ошибкой tool_disabled_or_not_found, без
// исключения наружу, записи действия нет.
Процедура НеизвестноеИмяБезИсключения() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Контекст = КонтекстЗапуска();

	Результат = ar_ИнструментыДиспетчер.Вызвать("нет_такого_инструмента", "{}", Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина()
		.Свойство("Результат").Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Результат, "tool_disabled_or_not_found") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ДействияЗапуска(Контекст.RunId).Количество()).Равно(0);

КонецПроцедуры

// Пустая ссылка инструмента: observation {"error":"tool_ref_missing"}, без
// исключения.
Процедура ПустаяСсылкаДаетToolRefMissing() Экспорт

	Контекст = КонтекстЗапуска();

	Результат = ar_ИнструментыДиспетчер.Вызвать(
		Справочники.ar_Инструменты.ПустаяСсылка(), "{}", Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Результат, "tool_ref_missing") > 0).ЭтоИстина();

КонецПроцедуры

// Отключённый инструмент: observation с ошибкой, без исключения, записи
// действия нет.
Процедура ОтключенныйИнструментБезИсключения() Экспорт

	СсылкаTool = ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_отключённый_дисп",
		Перечисления.ar_УровеньРиска.Чтение);
	ОбъектTool = СсылкаTool.ПолучитьОбъект();
	ОбъектTool.ar_Включён = Ложь;
	ОбъектTool.Записать();

	Контекст = КонтекстЗапуска();
	Результат = ar_ИнструментыДиспетчер.Вызвать(СсылкаTool, "{}", Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Результат, "tool_disabled_or_not_found") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ДействияЗапуска(Контекст.RunId).Количество()).Равно(0);

КонецПроцедуры

// Аргументы больше 64 КБ: observation {"error":"arguments_too_large"},
// действие записано с ошибкой.
Процедура СлишкомБольшиеАргументыОтклоняются() Экспорт

	СсылкаTool = ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_большие_аргументы",
		Перечисления.ar_УровеньРиска.Чтение);
	// ~90 Кириллических символов (180 байт UTF-8) x 400 повторов > 64 КБ.
	БлокСимволов = "абвгдежзиклмнопрстуфхцчшщыэюя0123456789абвгдежзиклмнопрстуфхцчшщыэюя0123456789";
	АргументыБезСкобок = "";
	Для Сч = 1 По 400 Цикл
		АргументыБезСкобок = АргументыБезСкобок + БлокСимволов;
	КонецЦикла;
	БольшиеАргументы = "{\"текст\": \"" + АргументыБезСкобок + "\"}";

	Контекст = КонтекстЗапуска();
	Результат = ar_ИнструментыДиспетчер.Вызвать(СсылкаTool, БольшиеАргументы, Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Результат, "arguments_too_large") > 0).ЭтоИстина();

	Действия = ОМ_ar_ТестовыеДанные.ДействияЗапуска(Контекст.RunId);
	ЮТест.ОжидаетЧто(Действия.Количество()).Равно(1)
		.Свойство("[0].ЗавершёнСОшибкой").ЭтоИстина();

КонецПроцедуры

// Невалидный JSON аргументов не является ошибкой диспетчера: без исключения,
// наблюдение возвращается инструментом (ошибка внутри JSON).
Процедура НевалидныйJSONПередаетсяИнструменту() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Контекст = КонтекстЗапуска();

	Результат = ar_ИнструментыДиспетчер.Вызвать("get_constants", "{невалидный json", Контекст);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина()
		.Свойство("Результат").Заполнено();

КонецПроцедуры

// ИзвлечьDryRun распознаёт только булево true; ИзвлечьIdempotencyKey
// возвращает только строку.
Процедура ИзвлечьDryRunИКлючИдемпотентности() Экспорт

	ЮТест.ОжидаетЧто(
		ar_ИнструментыДиспетчер.ИзвлечьDryRun("{\"_dry_run\": true}")).ЭтоИстина()
		.Что(ar_ИнструментыДиспетчер.ИзвлечьDryRun("{\"_dry_run\": false}")).ЭтоЛожь()
		.Что(ar_ИнструментыДиспетчер.ИзвлечьDryRun("{}")).ЭтоЛожь()
		.Что(ar_ИнструментыДиспетчер.ИзвлечьDryRun("невалидный")).ЭтоЛожь();

	ЮТест.ОжидаетЧто(
		ar_ИнструментыДиспетчер.ИзвлечьIdempotencyKey(
			"{\"_idempotency_key\": \"ключ-1\"}")).Равно("ключ-1")
		.Что(ar_ИнструментыДиспетчер.ИзвлечьIdempotencyKey("{}")).Равно("");

КонецПроцедуры

// СформироватьDryRunJSON: {"dry_run": true, "tool": ..., "simulated": ...}.
Процедура СформироватьDryRunJSONСтруктура() Экспорт

	JSON = ar_ИнструментыДиспетчер.СформироватьDryRunJSON("save_object",
		Новый Структура("действие", "запись"));

	ЮТест.ОжидаетЧто(СтрНайти(JSON, """dry_run"": true") > 0).ЭтоИстина()
		.Что(СтрНайти(JSON, """tool"": ""save_object""") > 0).ЭтоИстина()
		.Что(СтрНайти(JSON, """simulated""") > 0).ЭтоИстина();

КонецПроцедуры

// НормализованнаяВерсия: ровно 2 сегмента дополняются ".0".
Процедура НормализованнаяВерсияДополняетДвухсоставную() Экспорт

	ЮТест.ОжидаетЧто(ar_ИнструментыДиспетчер.НормализованнаяВерсия("3.1")).Равно("3.1.0")
		.Что(ar_ИнструментыДиспетчер.НормализованнаяВерсия("3.1.5")).Равно("3.1.5")
		.Что(ar_ИнструментыДиспетчер.НормализованнаяВерсия("3.1.5.7")).Равно("3.1.5.7");

КонецПроцедуры

// НайтиToolПоИмени: включённый - ссылка, неизвестный - Неопределено.
Процедура НайтиToolПоИмениВозвращаетСсылкуИлиНеопределено() Экспорт

	СсылкаTool = ОМ_ar_ТестовыеДанные.НовыйИнструмент("тест_поиск_по_имени",
		Перечисления.ar_УровеньРиска.Чтение);

	ЮТест.ОжидаетЧто(ar_ИнструментыДиспетчер.НайтиToolПоИмени("тест_поиск_по_имени"))
		.Равно(СсылкаTool)
		.Что(ar_ИнструментыДиспетчер.НайтиToolПоИмени("нет_такого")).Равно(Неопределено)
		.Что(ar_ИнструментыДиспетчер.НайтиToolПоИмени("")).Равно(Неопределено);

КонецПроцедуры

// Повторный вызов с тем же ключом идемпотентности возвращает прежний
// результат без повторного исполнения (replay из executed-записи очереди).
Процедура ПовторныйВызовСКлючомВозвращаетКэш() Экспорт

	ЗарегистрироватьЯдровойРеестр();
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);
	КлючИдемпотентности = "тест-ключ-" + ОМ_ar_ТестовыеДанные.НовыйRunId();

	// Исполнение с ключом через штатную цепочку: постановка -> принятие ->
	// отметка исполненной записи.
	КонтекстПостановки = Новый Структура;
	КонтекстПостановки.Вставить("RunId", RunId);
	КонтекстПостановки.Вставить("Sequence", 0);
	Действие = Новый Структура("Имя, Аргументы, IdempotencyKey",
		"get_constants", "{\"_idempotency_key\": \"" + КлючИдемпотентности + "\"}", КлючИдемпотентности);
	ApprovalId = ar_Подтверждение.Поставить(КонтекстПостановки, Действие);
	ar_Подтверждение.Принять(ApprovalId, Справочники.Пользователи.ПустаяСсылка());
	ar_Подтверждение.ПометитьApprovalВыполненным(КлючИдемпотентности);

	// Повторный вызов диспетчера с тем же ключом - из кэша executed-записи.
	КонтекстПовтора = КонтекстЗапуска();
	КонтекстПовтора.Вставить("Sequence", 1);
	РезультатПовтора = ar_ИнструментыДиспетчер.Вызвать("get_constants",
		"{\"_idempotency_key\": \"" + КлючИдемпотентности + "\"}", КонтекстПовтора);

	ЮТест.ОжидаетЧто(РезультатПовтора.Успех).ЭтоИстина()
		.Свойство("Результат").Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(РезультатПовтора.Результат, """error""") = 0).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Контекст запуска с уникальным RunId.
//
Функция КонтекстЗапуска()

	Контекст = Новый Структура;
	Контекст.Вставить("RunId", ОМ_ar_ТестовыеДанные.НовыйRunId());
	Контекст.Вставить("Sequence", 0);
	Контекст.Вставить("DryRun", Ложь);
	Возврат Контекст;

КонецФункции

// Заполняет реестр инструментов ядровыми описаниями.
//
Процедура ЗарегистрироватьЯдровойРеестр()

	ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools();

КонецПроцедуры

#КонецОбласти
