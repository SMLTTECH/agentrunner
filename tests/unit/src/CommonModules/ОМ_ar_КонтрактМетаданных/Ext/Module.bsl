///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_КонтрактМетаданных.
//
// Контракт точек входа расширения AgentRunner (план «ТЕСТЫ: расширение
// покрытия ядра», раздел 3.1): подписка на события, регламентные задания и
// HTTP-сервисы указывают на существующие экспортные методы, задания
// предопределённые и включены, расширение в базе прогона не в безопасном
// режиме. Ловит то, что компиляция при слиянии не проверяет: переименованный
// метод молча отключает механизм (ошибка - только в журнале регистрации).
//
// Методы не вызываются: существование и число параметров проверяются вызовом
// через Выполнить в безопасном режиме с заведомо неверным числом аргументов -
// платформа отвечает ошибкой «слишком много/мало параметров» до входа в тело.
// Тесты без данных и без транзакции, тег contract.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Контракт точек входа", "contract")
		.ДобавитьСерверныйТест("ПодпискаУказываетНаЭкспортныйМетод").Тег("contract")
		.ДобавитьСерверныйТест("ИсточникиПодпискиСовпадаютСГорячимиТипами").Тег("contract")
		.ДобавитьСерверныйТест("РегламентныеЗаданияСостав").Тег("contract")
		.ДобавитьСерверныйТест("МетодыРегламентныхЗаданийСуществуют").Тег("contract")
		.ДобавитьСерверныйТест("РегламентныеЗаданияВДиагностике").Тег("contract")
		.ДобавитьСерверныйТест("HTTPСервисыШаблоныИМетоды").Тег("contract")
		.ДобавитьСерверныйТест("РасширениеНеВБезопасномРежиме").Тег("contract");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подписка ar_ПодпискаОбъектов: событие ПриЗаписи, обработчик
// ar_ОбработчикПодписок.ПриЗаписиОбъекта существует ровно с двумя параметрами
// (Источник, Отказ) - иначе платформа не вызовет обработчик.
Процедура ПодпискаУказываетНаЭкспортныйМетод() Экспорт

	Подписка = Метаданные.ПодпискиНаСобытия.Найти("ar_ПодпискаОбъектов");
	ЮТест.ОжидаетЧто(Подписка <> Неопределено, "подписка ar_ПодпискаОбъектов есть").ЭтоИстина();

	Событие = Строка(Подписка.Событие);
	ЮТест.ОжидаетЧто(Событие = "ПриЗаписи" Или Событие = "OnWrite",
		"событие подписки ПриЗаписи, а не " + Событие).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИмяМетодаСовпадает(Подписка.Обработчик, "ar_ОбработчикПодписок.ПриЗаписиОбъекта"),
		"обработчик подписки ar_ОбработчикПодписок.ПриЗаписиОбъекта, а не " + Подписка.Обработчик).ЭтоИстина();

	ЮТест.ОжидаетЧто(ЧислоПараметровМетода("ar_ОбработчикПодписок", "ПриЗаписиОбъекта", 2),
		"ar_ОбработчикПодписок.ПриЗаписиОбъекта существует с двумя параметрами").ЭтоИстина();

КонецПроцедуры

// Источник подписки - определяемый тип ar_ПрикладнойОбъектОбъект, его состав
// совпадает с ar_ОбработчикПодписок.ГорячиеТипы() (горячие типы исключаются
// из опроса подписок - расхождение дало бы двойной или пропущенный запуск).
Процедура ИсточникиПодпискиСовпадаютСГорячимиТипами() Экспорт

	Подписка = Метаданные.ПодпискиНаСобытия.ar_ПодпискаОбъектов;
	ГорячиеТипы = ar_ОбработчикПодписок.ГорячиеТипы();

	ТипыИсточника = Подписка.Источник.Типы();
	ЮТест.ОжидаетЧто(ТипыИсточника.Количество(), "типов в источнике подписки")
		.Равно(Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъектОбъект.Тип.Типы().Количество());
	ЮТест.ОжидаетЧто(ГорячиеТипы.Количество(), "горячих типов").Равно(ТипыИсточника.Количество());

	Для Каждого ТипИсточника Из ТипыИсточника Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипИсточника);
		ЮТест.ОжидаетЧто(ОбъектМетаданных <> Неопределено, "тип источника есть в метаданных").ЭтоИстина();
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		ЮТест.ОжидаетЧто(ГорячиеТипы.Найти(ПолноеИмя) <> Неопределено,
			"тип источника " + ПолноеИмя + " в ГорячиеТипы").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Регламентные задания ar_* - ровно эталонный список, каждое предопределённое
// и включённое в метаданных. Новое задание без записи в эталоне роняет тест:
// напоминание добавить в эталон и тесты на его обработчик.
Процедура РегламентныеЗаданияСостав() Экспорт

	Эталон = ЭталонРегламентныхЗаданий();

	ЗаданияРасширения = Новый Массив;
	Для Каждого Задание Из Метаданные.РегламентныеЗадания Цикл
		Если СтрНачинаетсяС(Задание.Имя, "ar_") Тогда
			ЗаданияРасширения.Добавить(Задание.Имя);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяЗадания Из ЗаданияРасширения Цикл
		ЮТест.ОжидаетЧто(Эталон.Получить(ИмяЗадания) <> Неопределено,
			"задание " + ИмяЗадания + " есть в эталоне теста").ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗаданияРасширения.Количество(), "заданий ar_* в метаданных").Равно(Эталон.Количество());

	Для Каждого КлючИЗначение Из Эталон Цикл
		Задание = Метаданные.РегламентныеЗадания.Найти(КлючИЗначение.Ключ);
		ЮТест.ОжидаетЧто(Задание <> Неопределено, "задание " + КлючИЗначение.Ключ + " есть").ЭтоИстина();
		ЮТест.ОжидаетЧто(Задание.Предопределенное, "задание " + Задание.Имя + " предопределённое").ЭтоИстина();
		ЮТест.ОжидаетЧто(Задание.Использование, "задание " + Задание.Имя + " включено").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Имя метода каждого задания эталона: общий модуль расширения - серверный, не
// глобальный, метод существует и вызывается без параметров. Для задания
// ar_ПроверкаВерсии - ar_ПроверкаОбновлений.ПроверитьВерсиюРегламентнымЗаданием.
Процедура МетодыРегламентныхЗаданийСуществуют() Экспорт

	Эталон = ЭталонРегламентныхЗаданий();

	Для Каждого КлючИЗначение Из Эталон Цикл

		Задание = Метаданные.РегламентныеЗадания[КлючИЗначение.Ключ];
		ЮТест.ОжидаетЧто(ИмяМетодаСовпадает(Задание.ИмяМетода, КлючИЗначение.Значение),
			"метод задания " + Задание.Имя + ": " + КлючИЗначение.Значение
			+ ", а не " + Задание.ИмяМетода).ЭтоИстина();

		Части = СтрРазделить(КлючИЗначение.Значение, ".");
		ИмяМодуля = Части[0];
		ИмяМетода = Части[1];

		Модуль = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
		ЮТест.ОжидаетЧто(Модуль <> Неопределено, "общий модуль " + ИмяМодуля).ЭтоИстина();
		ЮТест.ОжидаетЧто(Модуль.Сервер, "модуль " + ИмяМодуля + " серверный").ЭтоИстина();
		ЮТест.ОжидаетЧто(Модуль.Глобальный, "модуль " + ИмяМодуля + " не глобальный").ЭтоЛожь();

		ЮТест.ОжидаетЧто(ЧислоПараметровМетода(ИмяМодуля, ИмяМетода, 0),
			КлючИЗначение.Значение + " существует без параметров").ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Каждое задание эталона есть в ar_Планировщик.ДиагностикаПланировщика()
// (форма здоровья планировщика показывает все задания расширения).
Процедура РегламентныеЗаданияВДиагностике() Экспорт

	Диагностика = ar_Планировщик.ДиагностикаПланировщика();

	ИменаДиагностики = Новый Соответствие;
	Для Каждого Элемент Из Диагностика Цикл
		ИменаДиагностики.Вставить(Элемент.Имя, Истина);
	КонецЦикла;
	ЮТест.ОжидаетЧто(ИменаДиагностики.Получить("diagnostic_error"), "диагностика без ошибки")
		.Равно(Неопределено);

	Для Каждого КлючИЗначение Из ЭталонРегламентныхЗаданий() Цикл
		ЮТест.ОжидаетЧто(ИменаДиагностики.Получить(КлючИЗначение.Ключ),
			"задание " + КлючИЗначение.Ключ + " в диагностике").Равно(Истина);
	КонецЦикла;

КонецПроцедуры

// HTTP-сервисы ar_AgentsAPI, ar_RunsAPI, ar_HealthAPI: эталонный набор
// шаблонов URL и методов, у каждого метода заполнен обработчик. Обработчик
// модуля HTTP-сервиса вызовом через Выполнить не проверить: связь метода с
// обработчиком проверяет конфигуратор при загрузке, тест фиксирует состав.
Процедура HTTPСервисыШаблоныИМетоды() Экспорт

	Эталон = Новый Соответствие;
	Эталон.Вставить("ar_AgentsAPI", "/v1/agents/{id}/trigger POST v1_agents_id_trigger_post");
	Эталон.Вставить("ar_RunsAPI", "/v1/runs/{id} GET v1_runs_id_get;"
		+ "/v1/runs/{id}/events GET v1_runs_id_events_get");
	Эталон.Вставить("ar_HealthAPI", "/v1/health GET v1_health_get");

	Для Каждого КлючИЗначение Из Эталон Цикл

		Сервис = Метаданные.HTTPСервисы.Найти(КлючИЗначение.Ключ);
		ЮТест.ОжидаетЧто(Сервис <> Неопределено, "HTTP-сервис " + КлючИЗначение.Ключ).ЭтоИстина();
		ЮТест.ОжидаетЧто(Сервис.КорневойURL, "корневой URL " + Сервис.Имя).Равно(Сервис.Имя);

		Фактически = Новый Массив;
		Для Каждого Шаблон Из Сервис.ШаблоныURL Цикл
			Для Каждого Метод Из Шаблон.Методы Цикл
				ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Метод.Обработчик),
					"обработчик метода " + Шаблон.Шаблон).ЭтоИстина();
				Фактически.Добавить(СтрШаблон("%1 %2 %3", Шаблон.Шаблон,
					ИмяHTTPМетода(Метод.HTTPМетод), Метод.Обработчик));
			КонецЦикла;
		КонецЦикла;

		Ожидается = СтрРазделить(КлючИЗначение.Значение, ";");
		ЮТест.ОжидаетЧто(СтрСоединить(Фактически, ";"), "шаблоны и методы " + Сервис.Имя)
			.Равно(СтрСоединить(Ожидается, ";"));

	КонецЦикла;

КонецПроцедуры

// Расширение AgentRunner в базе прогона подключено без безопасного режима:
// иначе ar_ОбработчикПодписок.ПриЗаписиОбъекта не включит привилегированный
// режим, и у пользователей без ролей AgentRunner событие молча не ставится.
// Проверяется конфигурация базы, на которой идёт прогон.
Процедура РасширениеНеВБезопасномРежиме() Экспорт

	Расширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", "AgentRunner"));
	ЮТест.ОжидаетЧто(Расширения.Количество(), "расширение AgentRunner подключено").Равно(1);

	Расширение = Расширения[0];
	ЮТест.ОжидаетЧто(Расширение.Активно, "расширение активно").ЭтоИстина();
	ЮТест.ОжидаетЧто(Расширение.БезопасныйРежим, "безопасный режим расширения").Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Эталон регламентных заданий расширения: имя задания -> «Модуль.Метод».
//
// Возвращаемое значение:
//  Соответствие - ключ: имя задания, значение: «ИмяМодуля.ИмяМетода».
//
Функция ЭталонРегламентныхЗаданий()

	Эталон = Новый Соответствие;
	Эталон.Вставить("ar_ПланировщикАгентов", "ar_Планировщик.ОбработатьПланировщик");
	Эталон.Вставить("ar_ВозобновлениеПослеApproval", "ar_Планировщик.ОбработатьВозобновление");
	Эталон.Вставить("ar_АвтовозобновлениеЗапусков", "ar_Планировщик.ОбработатьАвтовозобновление");
	Эталон.Вставить("ar_ОчисткаЗависших", "ar_Планировщик.ОбработатьОчисткуЗависших");
	Эталон.Вставить("ar_РотацияСессий", "ar_Планировщик.ОбработатьРотациюСессий");
	Эталон.Вставить("ar_ОбработчикУпоминаний", "ar_Планировщик.ОбработатьУпоминания");
	Эталон.Вставить("ar_КомпакцияAudit", "ar_Планировщик.ОбработатьКомпакциюAudit");
	Эталон.Вставить("ar_ОбновлениеПамятиAuto", "ar_Планировщик.ОбработатьОбновлениеПамятиAuto");
	Эталон.Вставить("ar_ОпросПодписокАгентов", "ar_Планировщик.ОбработатьОпросПодписок");
	Эталон.Вставить("ar_ОчисткаСлужебногоЛога", "ar_Планировщик.ОбработатьОчисткуСлужебногоЛога");
	Эталон.Вставить("ar_ПроверкаВерсии", "ar_ПроверкаОбновлений.ПроверитьВерсиюРегламентнымЗаданием");
	Возврат Эталон;

КонецФункции

// Метод общего модуля существует и принимает ровно ЧислоПараметров параметров
// (необязательных параметров у проверяемых точек входа нет). Проверка без
// входа в тело метода: вызов с ЧислоПараметров + 1 аргументами должен дать
// ошибку «слишком много параметров», а с ЧислоПараметров - 1 (при
// ЧислоПараметров > 0) - «слишком мало параметров». Вызов - в безопасном
// режиме: если сигнатура разошлась и тело всё же выполнится, оно не получит
// привилегий.
//
// Параметры:
//  ИмяМодуля       - Строка - имя общего модуля;
//  ИмяМетода       - Строка - имя экспортного метода;
//  ЧислоПараметров - Число - ожидаемое число параметров.
//
// Возвращаемое значение:
//  Булево - метод есть и число параметров совпало.
//
Функция ЧислоПараметровМетода(Знач ИмяМодуля, Знач ИмяМетода, Знач ЧислоПараметров)

	ТипыОшибок = ЮТФабрикаСлужебный.ТипыОшибок();

	ТипЛишний = ТипОшибкиВызова(ИмяМодуля, ИмяМетода, ЧислоПараметров + 1);
	Если ТипЛишний <> ТипыОшибок.МногоПараметров Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЧислоПараметров = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ТипОшибкиВызова(ИмяМодуля, ИмяМетода, ЧислоПараметров - 1) = ТипыОшибок.МалоПараметров;

КонецФункции

// Тип ошибки вызова метода с заданным числом аргументов Неопределено (см.
// ЮТРегистрацияОшибокСлужебный.ТипОшибки).
//
// Параметры:
//  ИмяМодуля       - Строка;
//  ИмяМетода       - Строка;
//  ЧислоАргументов - Число.
//
// Возвращаемое значение:
//  Строка - тип ошибки из ЮТФабрикаСлужебный.ТипыОшибок(); "" - вызов прошёл без ошибки.
//
Функция ТипОшибкиВызова(Знач ИмяМодуля, Знач ИмяМетода, Знач ЧислоАргументов)

	Аргументы = Новый Массив;
	Для Номер = 1 По ЧислоАргументов Цикл
		Аргументы.Добавить("Неопределено");
	КонецЦикла;
	ПолноеИмяМетода = ИмяМодуля + "." + ИмяМетода;
	Выражение = ПолноеИмяМетода + "(" + СтрСоединить(Аргументы, ", ") + ")";

	Попытка
		УстановитьБезопасныйРежим(Истина);
		Выполнить(Выражение);
	Исключение
		Возврат ЮТРегистрацияОшибокСлужебный.ТипОшибки(ИнформацияОбОшибке(), ПолноеИмяМетода);
	КонецПопытки;

	Возврат "";

КонецФункции

// Полное имя метода из метаданных («CommonModule.Модуль.Метод» или
// «ОбщийМодуль.Модуль.Метод» - зависит от языка платформы) указывает на
// «Модуль.Метод».
//
// Параметры:
//  ПолноеИмя   - Строка - значение свойства ИмяМетода / Обработчик метаданных;
//  МодульМетод - Строка - «ИмяМодуля.ИмяМетода».
//
// Возвращаемое значение:
//  Булево.
//
Функция ИмяМетодаСовпадает(Знач ПолноеИмя, Знач МодульМетод)

	ПолноеИмя = СокрЛП(Строка(ПолноеИмя));
	Возврат ПолноеИмя = МодульМетод Или СтрЗаканчиваетсяНа(ПолноеИмя, "." + МодульМетод);

КонецФункции

// Имя HTTP-метода (GET, POST, ...) из значения перечисления метаданных.
//
// Параметры:
//  HTTPМетод - Произвольный - значение свойства HTTPМетод метода шаблона.
//
// Возвращаемое значение:
//  Строка.
