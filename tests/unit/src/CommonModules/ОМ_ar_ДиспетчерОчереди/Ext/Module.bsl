///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ДиспетчерОчереди.
//
// Интеграционные тесты диспетчеризации пакетов - точка входа
// ar_ДиспетчерОчереди.ОбработатьОчереди (спека agentrunner-372,
// функциональность agentrunner-32):
//  * кандидаты пакета по контракту ar_ОбъектыКОбработке(Агент, Лимит) стартуют
//    в свободные слоты агента, не больше лимита SCHED-05 (критерий 1);
//  * кандидаты вне состава определяемого типа ar_ПрикладнойОбъект отсеиваются
//    без создания запуска, с предупреждением queue_subject_type_not_supported
//    (критерий 2);
//  * сбой источника (namespace отсутствует в реестре ar_ПакетыИнструментов)
//    пишет queue_source_failed один раз в паузу ПаузаСбоевИсточника (30 минут
//    по агенту и тексту): повторный тик в паузе повторную запись не создаёт
//    (критерий 3).
//
// Тестовый пакет-заглушка собирается на лету движком YAxUnit
// (ЮТВнешниеОбработкиСлужебныйСервер.СкомпилироватьВнешнююОбработку) и
// регистрируется так же, как боевой пакет: элемент Справочник.
// ДополнительныеОтчетыИОбработки (Вид = ДополнительнаяОбработка,
// ХранилищеОбработки) + запись РегистрСведений.ar_ПакетыИнструментов со
// статусом "Зарегистрирован". Разрешение пакета ядром идёт штатным путём
// (ar_ДиспетчерОчереди.КандидатыПакета -> ar_ИнструментыДиспетчерПовтИсп.
// ОбъектПакета -> ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки).
// Кандидаты заглушка берёт из Хранилище общих настроек (как ar_LLMMock -
// состояние вне транзакции теста): массив ссылок по ключу настройки - имя агента.
//
// Старты реальные (тик вызывает ar_RuntimeЗапуск.СтартоватьВФоне): агент на
// ar_LLMMock (персональный сценарий провайдера: текст + вердикт "выполнено"),
// тесты старта вне транзакции, очистка - .После("ОчиститьДанныеТеста"):
// отмена запусков (ar_RuntimeЗапуск.Отменить), удаление записей ar_Запуски,
// ar_СобытияЗапуска, ar_ДействияАгента, захватов ar_ПредметыАгентов, пакета
// (запись реестра и элемент справочника БСП), кандидатов и объектов агентов.
// Тест паузы сбоя - в транзакции (стартов нет, данные откатывает движок).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТесты
		.ДобавитьТестовыйНабор("agentrunner-372 ДиспетчеризацияОчереди")
		.ДобавитьСерверныйТест("КандидатыПакетаСтартуютВСвободныеСлоты").Тег("critical")
			.После("ОчиститьДанныеТеста")
		.ДобавитьСерверныйТест("КандидатыВнеСоставаОтсеиваютсяБезСтарта").Тег("critical")
			.После("ОчиститьДанныеТеста")
		.ДобавитьСерверныйТест("СбойИсточникаНеПишетПовторВПаузе").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Критерий 1 спеки agentrunner-372: агент с "Брать из очереди пакета" получает
// кандидатов от пакета-заглушки (ar_ОбъектыКОбработке) и стартует их в свободные
// слоты - не больше лимита SCHED-05. Лимит слотов агента 2, кандидатов 3:
// стартовано ровно 2 (излишек остаётся на следующий тик), триггер каждого
// запуска "queue", предмет - кандидат пакета.
Процедура КандидатыПакетаСтартуютВСвободныеСлоты() Экспорт

	ОчиститьДанныеТеста();
	Подготовка = ПодготовитьАгентаОчереди();
	ПодготовитьПакетЗаглушку(Подготовка);
	Кандидаты = Новый Массив;
	Сч = 0;
	Пока Сч < 3 Цикл
		Сч = Сч + 1;
		Кандидаты.Добавить(НовыйКандидатПочты());
	КонецЦикла;
	ЗадатьДанныеПакета(Подготовка.Агент, Кандидаты);
	УстановитьСценарийСтарта(Подготовка.Провайдер);

	ar_ДиспетчерОчереди.ОбработатьОчереди();

	Лимит = ar_ПредметыАгентов.ЛимитЗапусковПоРеквизиту(Подготовка.МаксПараллельных);
	Запуски = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(Запуски.Количество(), "стартовано не больше свободных слотов агента")
		.Равно(Мин(Кандидаты.Количество(), Лимит));

	Для Каждого СтрокаЗапуска Из Запуски Цикл
		ЮТест.ОжидаетЧто(СтрокаЗапуска.Триггер, "триггер тика очереди").Равно("queue");
		ЮТест.ОжидаетЧто(МассивСодержит(Кандидаты, СтрокаЗапуска.Предмет),
			"предмет запуска - кандидат пакета").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Критерий 2 спеки agentrunner-372: кандидат вне состава определяемого типа
// ar_ПрикладнойОбъект (подписка агентов) отсеивается без создания запуска;
// кандидат в составе (учётная запись почты) стартует; в журнале - предупреждение
// queue_subject_type_not_supported по агенту.
Процедура КандидатыВнеСоставаОтсеиваютсяБезСтарта() Экспорт

	ОчиститьДанныеТеста();
	Подготовка = ПодготовитьАгентаОчереди();
	ПодготовитьПакетЗаглушку(Подготовка);
	КандидатВнутри = НовыйКандидатПочты();
	КандидатВне = ОМ_ar_ТестовыеДанные.НоваяПодписка(Подготовка.Агент, "Справочник.Контрагенты");
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(КандидатВнутри);
	Кандидаты.Добавить(КандидатВне);
	ЗадатьДанныеПакета(Подготовка.Агент, Кандидаты);
	УстановитьСценарийСтарта(Подготовка.Провайдер);

	ar_ДиспетчерОчереди.ОбработатьОчереди();

	Запуски = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Подготовка.Агент);
	ЮТест.ОжидаетЧто(Запуски.Количество(), "кандидат вне состава пакета не стартует").Равно(1);
	ЮТест.ОжидаетЧто(Запуски[0].Предмет, "стартован кандидат в составе ar_ПрикладнойОбъект")
		.Равно(КандидатВнутри);
	ЮТест.ОжидаетЧто(ЕстьСобытиеАгента("queue_subject_type_not_supported", Строка(Подготовка.Агент)),
		"предупреждение о неподдерживаемом типе предмета").ЭтоИстина();

КонецПроцедуры

// Критерий 3 спеки agentrunner-372: сбой источника (namespace агента отсутствует
// в реестре пакетов) - первый тик пишет queue_source_failed; повторный тик в
// паузе ПаузаСбоевИсточника (30 минут по агенту и тексту) повторную запись не
// создаёт; запусков при сбойном источнике нет. Тест в транзакции - записи лога
// и данные агента на стенде не остаются.
Процедура СбойИсточникаНеПишетПовторВПаузе() Экспорт

	Namespace = "тест-очередь-" + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = НовыйАгентОчереди(Провайдер, Namespace);

	ar_ДиспетчерОчереди.ОбработатьОчереди();

	ИмяАгента = Строка(Агент);
	ЮТест.ОжидаетЧто(СчетСобытийАгента("queue_source_failed", ИмяАгента),
		"первый сбой источника записан").Равно(1);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"сбойный источник запусков не даёт").Равно(0);

	ar_ДиспетчерОчереди.ОбработатьОчереди();

	ЮТест.ОжидаетЧто(СчетСобытийАгента("queue_source_failed", ИмяАгента),
		"повторный сбой в паузе не записан").Равно(1);

КонецПроцедуры

// Очистка данных тестов с реальным стартом (.После, и самопроверка перед
// тестом): гасит фоновые задания тестовых агентов очереди (ar_RuntimeЗапуск.
// Отменить), снимает их захваты предметов, очищает сценарий заглушки и
// настройки пакета-заглушки, удаляет записи ar_Запуски/ar_СобытияЗапуска/
// ar_ДействияАгента, реестр пакета (ar_ПакетыИнструментов), элемент
// ДополнительныеОтчетыИОбработки и объекты теста (подписки, агенты,
// провайдеры, кандидаты). Транзакционные тесты не трогает.
Процедура ОчиститьДанныеТеста() Экспорт

	Агенты = СсылкиТестовыхОбъектов("ar_Агенты", ИмяПрефиксаАгента());
	ИменаАгентов = ИменаАгентовИзСсылок(Агенты);

	Если Агенты.Количество() > 0 Тогда
		РунИды = РунИдыАгентов(Агенты);
		Для Каждого RunId Из РунИды Цикл
			Попытка
				ar_RuntimeЗапуск.Отменить(RunId);
			Исключение
				// Не прерываем очистку: запись запуска будет удалена ниже напрямую.
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		// Дети раньше родителей: захваты, действия и события, затем сами запуски.
		Для Каждого Агент Из Агенты Цикл
			НаборЗахватов = РегистрыСведений.ar_ПредметыАгентов.СоздатьНаборЗаписей();
			НаборЗахватов.Отбор.ar_Агент.Установить(Агент);
			НаборЗахватов.Записать(Истина);
		КонецЦикла;
		УдалитьЗаписиДействий(РунИды);
		УдалитьЗаписиСобытий(РунИды);
		УдалитьЗаписиЗапусков(РунИды);
	КонецЕсли;

	УдалитьКандидатовИзНастроек(ИменаАгентов);
	ОчиститьНастройкиПакета(ИменаАгентов);
	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();
	УдалитьПакетыЗаглушки();
	УдалитьТестовыеОбъекты("ar_ПодпискиАгентов", ИмяПрефиксаПодписки());
	УдалитьТестовыеОбъекты("ar_Агенты", ИмяПрефиксаАгента());
	УдалитьТестовыеОбъекты("ar_LLMПровайдеры", "ТестЗаглушка_");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Агент очереди для тестов: активный, на провайдере-заглушке, с признаком
// "Брать из очереди пакета" и уникальным пространством имён источника
// (ar_ПакетИсточник); лимит параллельных запусков 2 - потолок слотов тика.
//
// Возвращаемое значение:
//  Структура - {Провайдер, Агент, Namespace, МаксПараллельных}.
//
Функция ПодготовитьАгентаОчереди()

	Namespace = "тест-очередь-" + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = НовыйАгентОчереди(Провайдер, Namespace);
	МаксПараллельных = 2;
	ЭлементАгента = Агент.ПолучитьОбъект();
	ЭлементАгента.ar_МаксПараллельныхЗапусков = МаксПараллельных;
	ЭлементАгента.Записать();

	Возврат Новый Структура("Провайдер, Агент, Namespace, МаксПараллельных",
		Провайдер, Агент, Namespace, МаксПараллельных);

КонецФункции

// Активный агент с признаком очереди пакета (реквизиты ar_БратьИзОчередиПакета
// и ar_ПакетИсточник заполняются поверх базовой фикстуры НовыйАгент).
//
// Параметры:
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер агента;
//  Namespace - Строка - пространство имён пакета-источника (ar_ПакетИсточник).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты - созданный агент.
//
Функция НовыйАгентОчереди(Знач Провайдер, Знач Namespace)

	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ЭлементАгента = Агент.ПолучитьОбъект();
	ЭлементАгента.ar_БратьИзОчередиПакета = Истина;
	ЭлементАгента.ar_ПакетИсточник = Namespace;
	ЭлементАгента.Записать();

	Возврат Агент;

КонецФункции

// Сборка и регистрация пакета-заглушки ("тестовая обработка-пакет" из спеки):
// epf собирается движком YAxUnit из текста модуля (ТекстМодуляПакета), кладётся
// в элемент Справочник.ДополнительныеОтчетыИОбработки (Вид = ДополнительнаяОбработка,
// БезопасныйРежим = Ложь, ХранилищеОбработки), в ar_ПакетыИнструментов -
// запись "Зарегистрирован" по namespace агента (измерение ar_ИдентификаторОбработки -
// UUID элемента; именно по нему ядро разыменовывает пакет).
//
// Параметры:
//  Подготовка - Структура - {Агент, Namespace} (см. ПодготовитьАгентаОчереди).
//
Процедура ПодготовитьПакетЗаглушку(Знач Подготовка)

	ИмяОбъектаПакета = "ar_ПакетОчередиТест";
	ЭлементПакета = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
	ЭлементПакета.Наименование = ИмяПрефиксаПакета() + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	ЭлементПакета.ИмяОбъекта = ИмяОбъектаПакета;
	ЭлементПакета.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка;
	ЭлементПакета.БезопасныйРежим = Ложь;
	ЭлементПакета.ХранилищеОбработки = НовоеХранилищеЗначения(
		ЮТВнешниеОбработкиСлужебныйСервер.СкомпилироватьВнешнююОбработку(ТекстМодуляПакета()));
	ЭлементПакета.Записать();

	МенеджерПакета = РегистрыСведений.ar_ПакетыИнструментов.СоздатьМенеджерЗаписи();
	МенеджерПакета.ar_ИдентификаторОбработки = Строка(ЭлементПакета.Ссылка.УникальныйИдентификатор());
	МенеджерПакета.ar_Namespace = Подготовка.Namespace;
	МенеджерПакета.ar_Статус = "Зарегистрирован";
	МенеджерПакета.ar_ИмяОбъектаОбработки = ИмяОбъектаПакета;
	МенеджерПакета.Записать(Истина);

КонецПроцедуры

// Текст модуля объекта пакета-заглушки - контракт пакета (спека agentrunner-32
// п.7): ar_ОбъектыКОбработке(Агент, Лимит) возвращает сохранённые тестом
// кандидаты (массив ссылок из Хранилище общих настроек, ключ настройки - имя
// агента) в порядке приоритета, не больше Лимит. Запросов нет - ссылки
// сериализуются значением, как хранит их ХранилищеОбщихНастроек.
//
// Возвращаемое значение:
//  Строка - текст модуля объекта для СкомпилироватьВнешнююОбработку.
//
Функция ТекстМодуляПакета()

	Возврат "Функция ar_ОбъектыКОбработке(Знач Агент, Знач Лимит) Экспорт
		|
		|	Данные = ХранилищеОбщихНастроек.Загрузить(""ar_ТестПакетОчереди"", Строка(Агент));
		|	Если ТипЗнч(Данные) <> Тип(""Массив"") Тогда
		|		Возврат Новый Массив;
		|	КонецЕсли;
		|
		|	Результат = Новый Массив;
		|	Для Номер = 0 По Данные.ВГраница() Цикл
		|		Если Результат.Количество() >= Лимит Тогда
		|			Прервать;
		|		КонецЕсли;
		|		Результат.Добавить(Данные[Номер]);
		|	КонецЦикла;
		|
		|	Возврат Результат;
		|
		|КонецФункции";

КонецФункции

// Данные пакета-заглушки - кандидаты по ключу "имя агента" в Хранилище общих
// настроек (состояние вне транзакции теста - как сценарий ar_LLMMock).
//
// Параметры:
//  Агент     - СправочникСсылка.ar_Агенты - агент очереди;
//  Кандидаты - Массив - ссылки-кандидаты пакета (в порядке приоритета).
//
Процедура ЗадатьДанныеПакета(Знач Агент, Знач Кандидаты)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаПакета(), Строка(Агент), Кандидаты);

КонецПроцедуры

// Персональный сценарий заглушки провайдера для реального старта: текстовый
// ответ и вердикт "выполнено" (цикл запуска завершится сам, без сети).
//
// Параметры:
//  Провайдер - СправочникСсылка.ar_LLMПровайдеры - провайдер агента старта.
//
Процедура УстановитьСценарийСтарта(Знач Провайдер)

	Сценарий = Новый Массив;
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст("Отчет готов."));
	Сценарий.Добавить(ОМ_ar_ТестовыеДанные.ОтветТекст(ОМ_ar_ТестовыеДанные.ВердиктВыполнено()));
	ОМ_ar_ТестовыеДанные.УстановитьСценарий(Сценарий, Провайдер);

КонецПроцедуры

// Новый кандидат в составе определяемого типа ar_ПрикладнойОбъект: элемент
// Справочник.УчетныеЗаписиЭлектроннойПочты с уникальным наименованием
// (пишется на стенде - см. ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа).
//
// Возвращаемое значение:
//  СправочникСсылка.УчетныеЗаписиЭлектроннойПочты - созданный кандидат.
//
Функция НовыйКандидатПочты()

	Кандидат = Справочники.УчетныеЗаписиЭлектроннойПочты.СоздатьЭлемент();
	Кандидат.Наименование = ИмяПрефиксаКандидата() + ОМ_ar_ТестовыеДанные.УникальнаяСтрока();
	Кандидат.Записать();

	Возврат Кандидат.Ссылка;

КонецФункции

// Число записей события диспетчера очереди по тестовому агенту: отбор по
// источнику "ar_ДиспетчерОчереди", коду события и префиксу текста записи
// "Агент=<имя>" (тексты записей диспетчера начинаются с него).
//
// Параметры:
//  Событие   - Строка - код события ("queue_source_failed",
//              "queue_subject_type_not_supported");
//  ИмяАгента - Строка - наименование тестового агента.
//
// Возвращаемое значение:
//  Число - количество записей.
//
Функция СчетСобытийАгента(Знач Событие, Знач ИмяАгента)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|	И Лог.ar_Текст ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""";
	Запрос.УстановитьПараметр("Источник", "ar_ДиспетчерОчереди");
	Запрос.УстановитьПараметр("Событие", Событие);
	// Служебные символы имени (% _ [ ] ^) экранируются, хвост "%" - wildcard.
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе("Агент=" + ИмяАгента) + "%");

	Возврат Запрос.Выполнить().Выбрать().Количество();

КонецФункции

// Есть ли запись события диспетчера по агенту (обёртка СчетСобытийАгента).
//
// Параметры: см. СчетСобытийАгента.
//
// Возвращаемое значение:
//  Булево - Истина, если запись есть.
//
Функция ЕстьСобытиеАгента(Знач Событие, Знач ИмяАгента)

	Возврат СчетСобытийАгента(Событие, ИмяАгента) > 0;

КонецФункции

// Проверяет, что массив содержит значение (сравнение ссылок).
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Наименования тестовых агентов - ключи настроек пакета-заглушки
// (ХранилищеОбщихНастроек хранит данные пакета по имени агента).
//
// Параметры:
//  Агенты - Массив из СправочникСсылка.ar_Агенты - тестовые агенты.
//
// Возвращаемое значение:
//  Массив из Строка - наименования агентов.
//
Функция ИменаАгентовИзСсылок(Знач Агенты)

	Имена = Новый Массив;
	Для Каждого Агент Из Агенты Цикл
		Имена.Добавить(Строка(Агент));
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Удаление кандидатов (элементы Справочник.УчетныеЗаписиЭлектроннойПочты),
// чьи ссылки сохранены в настройках пакета-заглушки: точечное удаление своих
// данных основной конфигурации по сохранённым ссылкам, без поиска по префиксу.
//
// Параметры:
//  ИменаАгентов - Массив из Строка - ключи настроек (имена агентов).
//
Процедура УдалитьКандидатовИзНастроек(Знач ИменаАгентов)

	Для Каждого ИмяАгента Из ИменаАгентов Цикл
		Данные = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаПакета(), ИмяАгента);
		Если ТипЗнч(Данные) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из Данные Цикл
			Если ТипЗнч(Кандидат) <> Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты") Тогда
				Продолжить;
			КонецЕсли;
			ОбъектКандидата = Кандидат.ПолучитьОбъект();
			Если ОбъектКандидата <> Неопределено Тогда
				ОбъектКандидата.Удалить();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Сброс настроек пакета-заглушки: запись пустого массива по каждому ключу
// (приём ar_LLMMock - состояние вне транзакции, затирается явно).
//
// Параметры:
//  ИменаАгентов - Массив из Строка - ключи настроек (имена агентов).
//
Процедура ОчиститьНастройкиПакета(Знач ИменаАгентов)

	Для Каждого ИмяАгента Из ИменаАгентов Цикл
		ХранилищеОбщихНастроек.Сохранить(КлючОбъектаПакета(), ИмяАгента, Новый Массив);
	КонецЦикла;

КонецПроцедуры

// Удаление реестра пакета-заглушки: записи ar_ПакетыИнструментов по namespace
// теста ("тест-очередь-...") и элементы Справочник.ДополнительныеОтчетыИОбработки
// с наименованием "ТестПакетОчереди_...". Записи реестра удаляются наборами
// записей по измерению ar_ИдентификаторОбработки (отбор по ресурсу ar_Namespace
// нужен только чтобы их найти - одним запросом на очистку).
//
Процедура УдалитьПакетыЗаглушки()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""";
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе("тест-очередь-") + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборПакетов = РегистрыСведений.ar_ПакетыИнструментов.СоздатьНаборЗаписей();
		НаборПакетов.Отбор.ar_ИдентификаторОбработки.Установить(Выборка.ИдентификаторОбработки);
		НаборПакетов.Записать(Истина);
	КонецЦикла;

	УдалитьТестовыеОбъекты("ДополнительныеОтчетыИОбработки", ИмяПрефиксаПакета());

КонецПроцедуры

// Ссылки элементов справочника по префиксу наименования (тесты создают данные
// только с префиксами ИмяПрефиксаАгента/ИмяПрефиксаПодписки/ИмяПрефиксаПакета,
// провайдеры - "ТестЗаглушка_").
//
// Параметры:
//  ИмяКаталога - Строка - имя справочника (расширения или основной конфигурации);
//  Префикс     - Строка - префикс наименования тестовых элементов.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка - найденные элементы.
//
Функция СсылкиТестовыхОбъектов(Знач ИмяКаталога, Знач Префикс)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		|	Объекты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Объекты
		|ГДЕ
		|	Объекты.Наименование ПОДОБНО &Образец СПЕЦСИМВОЛ ""~""",
		ИмяКаталога);
	// Служебные символы префикса экранируются, хвост "%" оставлен wildcard'ом.
	Запрос.УстановитьПараметр("Образец",
		ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Префикс) + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// RunId всех записей запусков перечисленных агентов (ar_Запуски.ar_АгентРеф).
//
// Параметры:
//  Агенты - Массив из СправочникСсылка.ar_Агенты.
//
// Возвращаемое значение:
//  Массив из Строка - идентификаторы запусков.
//
Функция РунИдыАгентов(Знач Агенты)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Запуски.ar_ИдентификаторЗапуска КАК RunId
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_АгентРеф В (&Агенты)");
	Запрос.УстановитьПараметр("Агенты", Агенты);

	Выборка = Запрос.Выполнить().Выбрать();
	РунИды = Новый Массив;
	Пока Выборка.Следующий() Цикл
		РунИды.Добавить(Выборка.RunId);
	КонецЦикла;

	Возврат РунИды;

КонецФункции

// Удаляет записи запусков тестовых агентов из ar_Запуски (измерение
// ar_ИдентификаторЗапуска, один RunId - один набор).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиЗапусков(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_Запуски.СоздатьНаборЗаписей();
		Набор.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет события тестовых запусков из ar_СобытияЗапуска (измерение ar_RunId).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиСобытий(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_СобытияЗапуска.СоздатьНаборЗаписей();
		Набор.Отбор.ar_RunId.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет действия тестовых запусков из ar_ДействияАгента (измерение
// ar_ИдентификаторЗапуска).
//
// Параметры:
//  РунИды - Массив из Строка - идентификаторы запусков.
//
Процедура УдалитьЗаписиДействий(Знач РунИды)

	Для Каждого RunId Из РунИды Цикл
		Набор = РегистрыСведений.ar_ДействияАгента.СоздатьНаборЗаписей();
		Набор.Отбор.ar_ИдентификаторЗапуска.Установить(RunId);
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Удаляет элементы справочника по префиксу наименования (данные тестов).
//
// Параметры:
//  ИмяКаталога - Строка - имя справочника (расширения или основной конфигурации);
//  Префикс     - Строка - префикс наименования тестовых элементов.
//
Процедура УдалитьТестовыеОбъекты(Знач ИмяКаталога, Знач Префикс)

	Ссылки = СсылкиТестовыхОбъектов(ИмяКаталога, Префикс);
	Для Каждого Ссылка Из Ссылки Цикл
		Элемент = Ссылка.ПолучитьОбъект();
		Если Элемент <> Неопределено Тогда
			Элемент.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Префикс наименований тестовых агентов очереди (совпадает с базовой
// фикстурой ОМ_ar_ТестовыеДанные.НовыйАгент).
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ИмяПрефиксаАгента()

	Возврат "ТестАгент_";

КонецФункции

// Префикс наименований тестовых подписок (фикстура ОМ_ar_ТестовыеДанные.
// НоваяПодписка).
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ИмяПрефиксаПодписки()

	Возврат "ТестПодписка_";

КонецФункции

// Префикс наименований элементов ДополнительныеОтчетыИОбработки - пакеты-заглушки.
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ИмяПрефиксаПакета()

	Возврат "ТестПакетОчереди_";

КонецФункции

// Префикс наименований кандидатов теста (УчетныеЗаписиЭлектроннойПочты).
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ИмяПрефиксаКандидата()

	Возврат "ТестОчередь_";

КонецФункции

// Ключ объекта настроек пакета-заглушки в Хранилище общих настроек
// (ключ настройки - имя агента очереди).
//
// Возвращаемое значение:
//  Строка - ключ объекта.
//
Функция КлючОбъектаПакета()

	Возврат "ar_ТестПакетОчереди";

КонецФункции

