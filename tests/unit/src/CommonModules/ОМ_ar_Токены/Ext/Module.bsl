///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Токены.
//
// Тесты оценки токенов (ar_Токены): Оценить (пустая строка, латиница,
// кириллица - кириллица дороже), ОценитьМассив (оверхед на сообщение и
// tool_calls), ДоляКириллицы (0..1, пустая строка и латиница - 0).
//
// Сценарии раздела 5 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ОценкаТокенов")
		.ДобавитьСерверныйТест("ОценитьПустаяИЛатиница").Тег("critical")
		.ДобавитьСерверныйТест("КириллическийТекстДороже").Тег("critical")
		.ДобавитьСерверныйТест("ОценитьМассивСУчётомОверхеда").Тег("critical")
		.ДобавитьСерверныйТест("ДоляКириллицыГраничныеСлучаи").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Пустая строка - 0; латиница - положительная оценка.
Процедура ОценитьПустаяИЛатиница() Экспорт

	ЮТест.ОжидаетЧто(ar_Токены.Оценить("")).Равно(0)
		.Что(ar_Токены.Оценить(Неопределено)).Равно(0)
		.Что(ar_Токены.Оценить("hello world")).Больше(0);

КонецПроцедуры

// Кириллический текст той же длины оценивается большим числом токенов
// (коэффициент кириллицы 1.8 против латиницы 3.5 симв/токен).
Процедура КириллическийТекстДороже() Экспорт

	Латиница = ar_Токены.Оценить("abcdefghij" + "abcdefghij" + "abcdefghij" + "abcdefghij");
	Кириллица = ar_Токены.Оценить("абвгдежзикл" + "абвгдежзикл" + "абвгдежзикл" + "абвгдежзикл");

	ЮТест.ОжидаетЧто(Латиница).Больше(0)
		.Что(Кириллица).Больше(Латиница);

КонецПроцедуры

// Оценка массива сообщений больше оценки текста: +4 за каждое сообщение,
// +8 за каждый tool_call, +3 прайминг.
Процедура ОценитьМассивСУчётомОверхеда() Экспорт

	Сообщения = Новый Массив;
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольSystem(), "system"));
	Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольUser(), "привет"));

	Оценка = ar_Токены.ОценитьМассив(Сообщения);

	ЮТест.ОжидаетЧто(Оценка).Больше(0)
		.Что(Оценка).Больше(ar_Токены.Оценить("system") + ar_Токены.Оценить("привет"));

	ПустойМассив = Новый Массив;
	ЮТест.ОжидаетЧто(ar_Токены.ОценитьМассив(ПустойМассив)).Равно(0)
		.Что(ar_Токены.ОценитьМассив(Неопределено)).Равно(0);

КонецПроцедуры

// ДоляКириллицы: пусто/латиница - 0, кириллица - 1, смесь - между.
Процедура ДоляКириллицыГраничныеСлучаи() Экспорт

	ЮТест.ОжидаетЧто(ar_Токены.ДоляКириллицы("")).Равно(0)
		.Что(ar_Токены.ДоляКириллицы("hello")).Равно(0)
		.Что(ar_Токены.ДоляКириллицы("привет")).Равно(1)
		.Что(ar_Токены.ДоляКириллицы("hello привет")).Больше(0)
		.Что(ar_Токены.ДоляКириллицы("hello привет")).Меньше(1);

КонецПроцедуры

#КонецОбласти
