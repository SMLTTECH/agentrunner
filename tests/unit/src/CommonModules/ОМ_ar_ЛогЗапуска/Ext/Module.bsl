///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ЛогЗапуска.
//
// Регрессионные тесты маскирования ПДн в выгрузке лога запуска (agentrunner-369,
// критерии спеки задачи «ТЕСТЫ: маскирование ПДн в логе запуска», п.4 предложения
// agentrunner-362). Точки входа - только экспортные методы ядра ar_ЛогЗапуска
// (СобратьПакет, ПакетВJSON, ТекстовыйВид, ИмяФайлаВыгрузки): текстовые маскеры
// (КПП/счет/адрес/организация) и проверка чувствительных имен полей неэкспортны
// и проверяются через них. Делать методы ядра экспортными ради теста нельзя.
//
// Данные - тестовый запуск с действием агента (ПДн в аргументах JSON) и событием
// ВызванИнструмент (ПДн в payload). Цикл агента не запускается: ar_LLMMock не
// трогается, фоновых заданий нет - тесты выполняются в транзакции с откатом
// (включая правило регистра ar_ПравилаМаскированияПДн, создаваемое тестом).
//
// Выгрузка доступна только полноправному пользователю (ar_ЛогЗапуска.СобратьПакет
// проверяет Пользователи.ЭтоПолноправныйПользователь): прогон предполагает
// пользователя стенда с полными правами.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("МаскированиеПДн")
		.ДобавитьСерверныйТест("БезМаскированияПДнВыгружаютсяКакЕсть").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("МаскированиеЗаменяетКППСчетАдресОрганизацию").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЧувствительноеИмяПоляСкрываетсяЦеликом").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПакетВJSONСодержитЗамаскированныеДанные").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ТекстовыйВидПомечаетРежимБезПДн").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("ИмяФайлаВыгрузки")
		.ДобавитьСерверныйТест("ИмяФайлаСодержитRunIdИПризнакМаскирования").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Критерий 1 (без маскирования): СобратьПакет без ключа МаскироватьПДн
// выгружает КПП, банковский счет, адрес и наименование организации как есть -
// и в аргументах действия, и в payload события; метка режима meta.pii_masked
// ложь.
Процедура БезМаскированияПДнВыгружаютсяКакЕсть() Экспорт

	Подготовка = ПодготовитьЗапускСПДн();

	Пакет = ar_ЛогЗапуска.СобратьПакет(Подготовка.RunId);

	ЮТест.ОжидаетЧто(Пакет.meta.pii_masked).ЭтоЛожь()
		.Что(Пакет.meta.run_id).Равно(Подготовка.RunId);

	АргументыДействия = АргументыПервогоДействия(Пакет);
	ЮТест.ОжидаетЧто(СтрНайти(АргументыДействия, СчетТестовый()) > 0, АргументыДействия).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, КППТестовый()) > 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, АдресТестовый()) > 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, ОрганизацияТестовая()) > 0).ЭтоИстина();

	ПолезнаяНагрузка = ПолезнаяНагрузкаСобытияСПДн(Пакет);
	ЮТест.ОжидаетЧто(ПолезнаяНагрузка <> Неопределено, "событие с ПДн найдено в пакете").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "кпп"))).Равно(КППТестовый())
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "счет"))).Равно(СчетТестовый())
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "адрес"))).Равно(АдресТестовый())
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "контрагент"))).Равно(ОрганизацияТестовая());

КонецПроцедуры

// Критерий 1 (с маскированием): в режиме "без ПДн" КПП, банковский счет,
// адрес и наименование организации заменены метками (***КПП***, ***СЧЕТ***,
// ***АДРЕС***, ***ОРГ***) и исходные значения не видны; meta.pii_masked
// истина.
Процедура МаскированиеЗаменяетКППСчетАдресОрганизацию() Экспорт

	Подготовка = ПодготовитьЗапускСПДн();

	ПараметрыСбора = Новый Структура("МаскироватьПДн", Истина);
	Пакет = ar_ЛогЗапуска.СобратьПакет(Подготовка.RunId, ПараметрыСбора);

	ЮТест.ОжидаетЧто(Пакет.meta.pii_masked).ЭтоИстина();

	АргументыДействия = АргументыПервогоДействия(Пакет);
	ЮТест.ОжидаетЧто(СтрНайти(АргументыДействия, "***КПП***") > 0, АргументыДействия).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, "***СЧЕТ***") > 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, "***АДРЕС***") > 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, "***ОРГ***") > 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, КППТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, СчетТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, АдресТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(АргументыДействия, ОрганизацияТестовая()) = 0).ЭтоИстина();

	ПолезнаяНагрузка = ПолезнаяНагрузкаСобытияСПДн(Пакет);
	ЮТест.ОжидаетЧто(ПолезнаяНагрузка <> Неопределено, "событие с ПДн найдено в пакете").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "кпп"))).Равно("***КПП***")
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "счет"))).Равно("***СЧЕТ***")
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "адрес"))).Равно("***АДРЕС***")
		.Что(Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "контрагент"))).Равно("ООО «***ОРГ***»");

КонецПроцедуры

// Критерий 2: поле структуры с чувствительным именем скрыто целиком
// ("[REDACTED]"). Проверка через раздел настроек pii_masking_rules (структуры
// строк регистра ar_ПравилаМаскированияПДн): ключ "ИмяПоля" содержит паттерн
// "имя" списка ar_Утилиты.ЭтоЧувствительноеИмяПоля, ключ "Объект" попадает
// под wildcard-правило регистра (Объект = "*", ИмяПоля = "объект"), созданное
// тестом в той же транзакции. Служебные ключи "ar_*" и нечувствительные
// ключи при этом не скрываются.
Процедура ЧувствительноеИмяПоляСкрываетсяЦеликом() Экспорт

	Подготовка = ПодготовитьЗапускСПДн();
	ДобавитьПравилоПолногоСокрытия("объект");

	ПараметрыСбора = Новый Структура("МаскироватьПДн", Истина);
	Пакет = ar_ЛогЗапуска.СобратьПакет(Подготовка.RunId, ПараметрыСбора);

	Правила = Пакет.settings.pii_masking_rules;
	ЮТест.ОжидаетЧто(Правила.Количество() > 0, "правила маскирования выгружены").ЭтоИстина();
	Для Каждого СтрокаПравила Из Правила Цикл
		ЮТест.ОжидаетЧто(СтрокаПравила.ИмяПоля, "чувствительное имя поля скрыто").Равно("[REDACTED]")
			.Что(СтрокаПравила.Объект).Равно("[REDACTED]");
	КонецЦикла;

	// Служебный ключ "ar_*" проверке имён не подлежит - значение не скрыто.
	ЮТест.ОжидаетЧто(Пакет.run.ar_Триггер, "служебный ключ ar_* не скрывается").Равно("manual");

	// Нечувствительный ключ не скрыт: значение проходит текстовые маскеры
	// (представление перечисления зависит от языка сеанса, поэтому проверяем
	// заполненность и отсутствие метки полного сокрытия).
	Для Каждого СтрокаПравила Из Правила Цикл
		ЮТест.ОжидаетЧто(СтрокаПравила.СпособМаскирования, "нечувствительное имя поля не скрыто")
			.Заполнено();
		ЮТест.ОжидаетЧто(СтрНайти(Строка(СтрокаПравила.СпособМаскирования), "[REDACTED]") = 0).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Критерий 1 на уровне JSON-текста (содержимое файла выгрузки): в режиме
// "без ПДн" в тексте стоят метки маскеров и нет исходных значений; без
// маскирования исходные значения в тексте остаются.
Процедура ПакетВJSONСодержитЗамаскированныеДанные() Экспорт

	Подготовка = ПодготовитьЗапускСПДн();

	ПараметрыСбора = Новый Структура("МаскироватьПДн", Истина);
	ТекстВыгрузки = ar_ЛогЗапуска.ПакетВJSON(Подготовка.RunId, ПараметрыСбора);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстВыгрузки, "pii_masked") > 0, ТекстВыгрузки).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, "***КПП***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, "***СЧЕТ***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, "***АДРЕС***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, "***ОРГ***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, КППТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, СчетТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузки, ОрганизацияТестовая()) = 0).ЭтоИстина();

	ТекстВыгрузкиБезМаскирования = ar_ЛогЗапуска.ПакетВJSON(Подготовка.RunId);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстВыгрузкиБезМаскирования, СчетТестовый()) > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузкиБезМаскирования, КППТестовый()) > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстВыгрузкиБезМаскирования, ОрганизацияТестовая()) > 0).ЭтоИстина();

КонецПроцедуры

// Критерий 1 через ТекстовыйВид (точка входа с параметром маскирования):
// в режиме "без ПДн" шапка текста содержит пометку режима, в тексте видны
// метки маскеров и не видны исходные значения; без маскирования пометки нет,
// исходные значения в хронологии и вызовах инструментов остаются.
Процедура ТекстовыйВидПомечаетРежимБезПДн() Экспорт

	Подготовка = ПодготовитьЗапускСПДн();

	ПараметрыСбора = Новый Структура("МаскироватьПДн", Истина);
	ТекстЛога = ar_ЛогЗапуска.ТекстовыйВид(Подготовка.RunId, ПараметрыСбора);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстЛога, "Персональные данные замаскированы") > 0, ТекстЛога).ЭтоИстина()
		.Что(СтрНайти(ТекстЛога, "***КПП***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстЛога, "***СЧЕТ***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстЛога, "***АДРЕС***") > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстЛога, КППТестовый()) = 0).ЭтоИстина()
		.Что(СтрНайти(ТекстЛога, СчетТестовый()) = 0).ЭтоИстина();

	ТекстЛогаБезМаскирования = ar_ЛогЗапуска.ТекстовыйВид(Подготовка.RunId);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЛогаБезМаскирования, "Персональные данные замаскированы") = 0)
		.ЭтоИстина()
		.Что(СтрНайти(ТекстЛогаБезМаскирования, СчетТестовый()) > 0).ЭтоИстина()
		.Что(СтрНайти(ТекстЛогаБезМаскирования, КППТестовый()) > 0).ЭтоИстина();

КонецПроцедуры

// Критерий 3: имя файла выгрузки содержит RunId, версию расширения и
// признак режима ("_masked") - файлы двух режимов не перепутать на диске.
Процедура ИмяФайлаСодержитRunIdИПризнакМаскирования() Экспорт

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ВерсияРасширения = ar_Утилиты.ВерсияРасширения();

	ЮТест.ОжидаетЧто(ar_ЛогЗапуска.ИмяФайлаВыгрузки(RunId), "имя файла без маскирования")
		.Равно("ar_log_" + RunId + "_" + ВерсияРасширения + ".json")
		.Что(ar_ЛогЗапуска.ИмяФайлаВыгрузки(RunId, Истина))
		.Равно("ar_log_" + RunId + "_" + ВерсияРасширения + "_masked.json");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает запуск с агентом-заглушкой и записывает в него действие и событие
// ВызванИнструмент, чьи аргументы и payload содержат ПДн (КПП, банковский
// счет, адрес, наименование организации).
//
// Возвращаемое значение:
//  Структура - {RunId}.
//
Функция ПодготовитьЗапускСПДн()

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Агент);

	АргументыИнструмента = СтрШаблон(
		"{""контрагент"": ""%1"", ""кпп"": ""%2"", ""счет"": ""%3"", ""адрес"": ""%4""}",
		ОрганизацияТестовая(), КППТестовый(), СчетТестовый(), АдресТестовый());
	ar_AuditДействия.Записать(RunId, 0, "тест_инструмент_выгрузки", АргументыИнструмента,
		Перечисления.ar_УровеньРиска.Чтение);

	ar_AuditСобытия.Зафиксировать(RunId, Перечисления.ar_ТипСобытия.ВызванИнструмент, ПолезнаяНагрузкаСПДн());

	Возврат Новый Структура("RunId", RunId);

КонецФункции

// Полезная нагрузка события с ПДн: те же значения, что в аргументах действия,
// по одному в значении (в пакете payload разбирается в соответствие и
// маскируется по-значению).
//
// Возвращаемое значение:
//  Структура.
//
Функция ПолезнаяНагрузкаСПДн()

	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("code", "test_tool_call");
	ПолезнаяНагрузка.Вставить("контрагент", ОрганизацияТестовая());
	ПолезнаяНагрузка.Вставить("кпп", КППТестовый());
	ПолезнаяНагрузка.Вставить("счет", СчетТестовый());
	ПолезнаяНагрузка.Вставить("адрес", АдресТестовый());
	Возврат ПолезнаяНагрузка;

КонецФункции

// Создает включенное wildcard-правило полного сокрытия (Объект = "*") в
// транзакции теста: сборщик пакета читает его для проверки имен полей,
// после теста запись откатывается. Способ маскирования обязателен "Полностью
// скрыть" - запись с иным способом отклоняется обработчиком ПередЗаписью
// регистра (PII-09).
//
// Параметры:
//  ИмяПоляПравила - Строка - значение измерения ИмяПоля.
//
Процедура ДобавитьПравилоПолногоСокрытия(Знач ИмяПоляПравила)

	ЗаписьПравила = РегистрыСведений.ar_ПравилаМаскированияПДн.СоздатьМенеджерЗаписи();
	ЗаписьПравила.Объект = "*";
	ЗаписьПравила.ИмяПоля = ИмяПоляПравила;
	ЗаписьПравила.СпособМаскирования = Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть;
	ЗаписьПравила.Включён = Истина;
	ЗаписьПравила.Записать(Истина);

КонецПроцедуры

// Аргументы первого действия запуска из пакета (строка JSON); отсутствие
// действия - чистое сообщение об ошибке вместо ошибки индекса.
//
// Параметры:
//  Пакет - Структура - пакет лога запуска (СобратьПакет).
//
// Возвращаемое значение:
//  Строка.
//
Функция АргументыПервогоДействия(Знач Пакет)

	Действия = Пакет.run_data.actions;
	ЮТест.ОжидаетЧто(Действия.Количество() > 0, "действие с ПДн в пакете").ЭтоИстина();
	Возврат Строка(Действия[0].ar_АргументыJSON);

КонецФункции

// Payload события с ПДн из пакета: поиск события по метке "code" =
// "test_tool_call" среди разобранных payload (соответствия).
//
// Параметры:
//  Пакет - Структура - пакет лога запуска (СобратьПакет).
//
// Возвращаемое значение:
//  Соответствие - полезная нагрузка события; Неопределено - не найдено.
//
Функция ПолезнаяНагрузкаСобытияСПДн(Знач Пакет)

	Для Каждого Событие Из Пакет.run_data.events Цикл
		ПолезнаяНагрузка = Неопределено;
		Если Событие.Свойство("payload", ПолезнаяНагрузка)
			И ТипЗнч(ПолезнаяНагрузка) = Тип("Соответствие")
			И Строка(ЗначениеПолезнойНагрузки(ПолезнаяНагрузка, "code")) = "test_tool_call" Тогда
			Возврат ПолезнаяНагрузка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Значение поля разобранного payload (ar_JSON.ИзJSON возвращает соответствие,
// для устойчивости к смене типа читается и структура).
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие|Структура|Произвольный - разобранный payload.
//  Ключ             - Строка - имя поля.
//
// Возвращаемое значение:
//  Произвольный - Неопределено, если поля нет.
//
Функция ЗначениеПолезнойНагрузки(Знач ПолезнаяНагрузка, Знач Ключ)

	Если ТипЗнч(ПолезнаяНагрузка) = Тип("Соответствие") Тогда
		Возврат ПолезнаяНагрузка.Получить(Ключ);
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(ПолезнаяНагрузка) = Тип("Структура") Тогда
		ПолезнаяНагрузка.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// КПП тестового контрагента: 9 цифр - длина КПП/БИК (метка "***КПП***"),
// не совпадающая с длинами ИНН (10/12) и СНИЛС/телефона (11).
//
// Возвращаемое значение:
//  Строка.
//
Функция КППТестовый()

	Возврат "773401001";

КонецФункции

