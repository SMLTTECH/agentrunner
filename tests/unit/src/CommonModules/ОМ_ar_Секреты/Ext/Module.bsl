///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_Секреты.
//
// Тесты хранилища секретов (ar_Секреты): Сохранить -> Прочитать -> Удалить;
// отсутствующий ключ - Неопределено; формат ключей КлючПровайдера /
// КлючТокенаАгента / КлючУстановки.
//
// Сценарии раздела 7 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Хранилище")
		.ДобавитьСерверныйТест("СохранитьПрочитатьУдалить").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ОтсутствующийКлючНеопределено").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ФорматыКлючей").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сохранить -> Прочитать возвращает значение; Удалить - идемпотентно,
// после удаления значение недоступно.
Процедура СохранитьПрочитатьУдалить() Экспорт

	Ключ = "тест-" + ОМ_ar_ТестовыеДанные.НовыйRunId();

	ar_Секреты.Сохранить(Ключ, "значение-секрета-123");
	ЮТест.ОжидаетЧто(ar_Секреты.Прочитать(Ключ)).Равно("значение-секрета-123");

	ar_Секреты.Удалить(Ключ);
	ЮТест.ОжидаетЧто(ar_Секреты.Прочитать(Ключ)).Равно(Неопределено);

	// Повторное удаление отсутствующего ключа - без исключения.
	ar_Секреты.Удалить(Ключ);

КонецПроцедуры

// Прочитать отсутствующего ключа - Неопределено.
Процедура ОтсутствующийКлючНеопределено() Экспорт

	ЮТест.ОжидаетЧто(
		ar_Секреты.Прочитать("нет-такого-" + ОМ_ar_ТестовыеДанные.НовыйRunId()))
		.Равно(Неопределено);

КонецПроцедуры

// КлючПровайдера / КлючТокенаАгента / КлючУстановки - ожидаемые форматы.
Процедура ФорматыКлючей() Экспорт

	УИД = ОМ_ar_ТестовыеДанные.НовыйRunId();

	ЮТест.ОжидаетЧто(ar_Секреты.КлючПровайдера(УИД)).Равно("llm_provider." + УИД)
		.Что(ar_Секреты.КлючТокенаАгента(УИД)).Равно("agent.token." + УИД)
		.Что(ar_Секреты.КлючУстановки()).Равно("install_id");

КонецПроцедуры

#КонецОбласти
