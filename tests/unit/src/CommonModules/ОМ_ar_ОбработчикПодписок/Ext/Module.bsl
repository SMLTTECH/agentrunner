///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ОбработчикПодписок.
//
// Тесты подписок агентов на запись объектов (agentrunner-290): постановка
// событий в очередь ar_ОчередьСобытийПодписок при записи «горячего» типа
// (ar_ОбработчикПодписок.ПриЗаписиОбъекта), разбор очереди
// (ar_ОбработчикПодписок.ОбработатьОчередьСобытий), кэш сеанса активных
// подписок (ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта) и контракт
// экспортных функций (ГорячиеТипы, ПроверитьФильтр, СформироватьКонтекстТриггера).
//
// Без Мокито: СтартоватьВФоне вызывается настоящий, исход задается данными -
// неактивный агент (отказ «прочий»), запуск «Выполняется» (отказ занятости),
// провайдер-заглушка (успешный запуск, проверка по ar_Запуски).
// Все тесты в транзакции: очередь очищается в ее начале (разбор видит только
// события теста), данные откатываются; кэш подписок сеанса сбрасывается до и
// после теста (откат оставляет в кэше ссылки на несуществующие подписки).
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 Постановка в очередь")
		.ДобавитьСерверныйТест("ЗаписьНовогоОбъектаСтавитСобытие").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ФильтрПодпискиОтбираетСобытия").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("НевалидныйJSONФильтраСобытиеСтавится").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ВыключеннаяИПомеченнаяПодпискиМолчат").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗаписьВРежимеОбменаБезСобытия").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПовторнаяЗаписьСохраняетПризнакНового").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СобытиеПоПерезаписиСуществующего").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ДвеПодпискиДвеСтрокиОчереди").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 Разбор очереди")
		.ДобавитьСерверныйТест("РазборУдаляетСобытияВыключенныхПодписок").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборУдаляетСобытиеУдаленногоОбъекта").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборУдаляетПросроченноеСобытие").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборУдаляетСобытиеНеактивногоАгента").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборХранитСобытиеЗанятогоАгента").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборЗапускаетАгентаИУдаляетСобытие").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("РазборПродолжаетПослеОтказаОдногоСобытия").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 Кэш подписок")
		.ДобавитьСерверныйТест("КэшСоставИЗначенияПодписки").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ЗаписьПодпискиСбрасываетКэш").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КэшПустДляТипаБезПодписок").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("agentrunner-290 Контракт экспортных функций")
		.ДобавитьСерверныйТест("ГорячиеТипыСовпадаютСОпределяемымТипом").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПроверитьФильтрСценарии").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("КонтекстТриггераСостав").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// agentrunner-290 A.1: запись нового объекта горячего типа при активной
// подписке с пустым фильтром ставит одну строку очереди (Подписка, Объект,
// ДатаСобытия не раньше начала теста, ЭтоНовый = Истина); агент в сеансе
// пользователя не запускается.
Процедура ЗаписьНовогоОбъектаСтавитСобытие() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();
	НачалоТеста = ТекущаяДатаСеанса();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Образец.Метаданные().ПолноеИмя());

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();

	Строки = ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка);
	ЮТест.ОжидаетЧто(Строки.Количество(), "строк очереди").Равно(1);
	ЮТест.ОжидаетЧто(Строки[0].Объект, "объект события").Равно(Объект.Ссылка);
	ЮТест.ОжидаетЧто(Строки[0].ЭтоНовый, "признак нового").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строки[0].ДатаСобытия >= НачалоТеста, "дата события").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"запусков агента в сеансе теста").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.2: фильтр подписки по реквизитам объекта - совпадающий
// ставит событие, с иным значением и по несуществующему реквизиту - нет.
Процедура ФильтрПодпискиОтбираетСобытия() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ПолноеИмяТипа = Образец.Метаданные().ПолноеИмя();

	ИмяОбъекта = "ТестПодписка_" + УникальныйСуффикс();
	ПодпискаСовпадение = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа,
		"{""Наименование"": """ + ИмяОбъекта + """}");
	ПодпискаИноеЗначение = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа,
		"{""Наименование"": """ + УникальныйСуффикс() + """}");
	ПодпискаНетРеквизита = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа,
		"{""НесуществующийРеквизит"": ""Значение""}");

	ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа(ИмяОбъекта);

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаСовпадение).Количество(),
		"строк по совпадающему фильтру").Равно(1);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаИноеЗначение).Количество(),
		"строк по фильтру с иным значением").Равно(0);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаНетРеквизита).Количество(),
		"строк по фильтру с несуществующим реквизитом").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.3: невалидный JSON фильтра фильтр не применяет (поведение
// ПроверитьФильтр) - событие ставится в очередь, объект записан, исключения нет.
Процедура НевалидныйJSONФильтраСобытиеСтавится() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Образец.Метаданные().ПолноеИмя(),
		"{не json");

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.Ссылка), "объект записан").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка).Количество(),
		"строк очереди при невалидном фильтре").Равно(1);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.4: выключенная подписка и подписка, помеченная на удаление,
// событий не ставят.
Процедура ВыключеннаяИПомеченнаяПодпискиМолчат() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ПолноеИмяТипа = Образец.Метаданные().ПолноеИмя();
	ПодпискаВыключенная = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа, "", Ложь);
	ПодпискаПомеченная = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа, "", Истина, Истина);

	ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаВыключенная).Количество(),
		"строк по выключенной подписке").Равно(0);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаПомеченная).Количество(),
		"строк по помеченной подписке").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.5: запись с ОбменДанными.Загрузка = Истина событий не ставит.
Процедура ЗаписьВРежимеОбменаБезСобытия() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Объект.Метаданные().ПолноеИмя());

	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка).Количество(),
		"строк очереди после записи в режиме обмена").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.6: повторная запись объекта до разбора очереди не плодит
// строки - одна строка на пару Подписка+Объект, ЭтоНовый = Истина сохраняется,
// ДатаСобытия не откатывается.
Процедура ПовторнаяЗаписьСохраняетПризнакНового() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Образец.Метаданные().ПолноеИмя());

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ДатаПерваяЗапись = ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка)[0].ДатаСобытия;

	// У документа наименования нет - повторная запись без изменения реквизитов.
	Если СтрНачинаетсяС(Объект.Метаданные().ПолноеИмя(), "Справочник.") Тогда
		Объект.Наименование = Объект.Наименование + "_повтор";
	КонецЕсли;
	Объект.Записать();

	Строки = ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка);
	ЮТест.ОжидаетЧто(Строки.Количество(), "строк очереди после перезаписи").Равно(1);
	ЮТест.ОжидаетЧто(Строки[0].ЭтоНовый, "признак нового сохранен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строки[0].ДатаСобытия >= ДатаПерваяЗапись, "дата события обновлена").ЭтоИстина();

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.7: объект, созданный до подписки, события не ставит;
// перезапись существующего объекта после создания подписки ставит одну строку
// с ЭтоНовый = Ложь.
Процедура СобытиеПоПерезаписиСуществующего() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Объект.Метаданные().ПолноеИмя());

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка).Количество(),
		"строк до перезаписи").Равно(0);

	Объект.Записать();

	Строки = ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка);
	ЮТест.ОжидаетЧто(Строки.Количество(), "строк после перезаписи").Равно(1);
	ЮТест.ОжидаетЧто(Строки[0].ЭтоНовый, "признак существующего объекта").ЭтоЛожь();

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 A.8: две активные подписки на один тип - по строке очереди
// на каждую подписку.
Процедура ДвеПодпискиДвеСтрокиОчереди() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Образец = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ПолноеИмяТипа = Образец.Метаданные().ПолноеИмя();
	ПодпискаПервая = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа);
	ПодпискаВторая = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа);

	ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаПервая).Количество(),
		"строк первой подписки").Равно(1);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаВторая).Количество(),
		"строк второй подписки").Равно(1);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 B.1: разбор очереди удаляет события выключенных подписок
// (ar_Включён = Ложь и помеченных на удаление), агентов не запускает.
Процедура РазборУдаляетСобытияВыключенныхПодписок() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	ПараметрыАгента = Новый Структура;
	ПараметрыАгента.Вставить("Активен", Ложь);
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер, ПараметрыАгента);

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	ПолноеИмяТипа = Объект.Метаданные().ПолноеИмя();
