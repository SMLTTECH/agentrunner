	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 B.6: успешный запуск - строка очереди удалена, у агента одна
// новая запись ar_Запуски с Триггер = "event", предметом - объект события и
// инициатором - служебный пользователь (если константа на стенде задана).
Процедура РазборЗапускаетАгентаИУдаляетСобытие() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	СлужебныйПользователь = ar_Константы.СлужебныйПользователь();

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, Объект.Метаданные().ПолноеИмя());
	ОМ_ar_ТестовыеДанные.ДобавитьСтрокуОчереди(Подписка, Объект.Ссылка, ТекущаяДатаСеанса(), Истина);

	ar_ОбработчикПодписок.ОбработатьОчередьСобытий();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(Подписка).Количество(),
		"строк очереди после разбора").Равно(0);

	Запуски = ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент);
	ЮТест.ОжидаетЧто(Запуски.Количество(), "записей запуска").Равно(1);
	ЮТест.ОжидаетЧто(Запуски[0].Триггер, "триггер события").Равно("event");
	ЮТест.ОжидаетЧто(Запуски[0].Предмет, "предмет запуска").Равно(Объект.Ссылка);
	// Пустая константа на стенде - инициатор не проверяется (запуск под текущим пользователем).
	Если ЗначениеЗаполнено(СлужебныйПользователь) Тогда
		ЮТест.ОжидаетЧто(Запуски[0].Пользователь, "инициатор запуска").Равно(СлужебныйПользователь);
	КонецЕсли;

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 B.7: отказ по одному событию не прерывает разбор остальных -
// событие выключенной подписки удалено, событие занятого агента осталось.
Процедура РазборПродолжаетПослеОтказаОдногоСобытия() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "manual");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ОМ_ar_ТестовыеДанные.ОчиститьОчередьПодписок();
	ПолноеИмяТипа = Объект.Метаданные().ПолноеИмя();
	ПодпискаВыключенная = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа, "", Ложь);
	ПодпискаЗанятая = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа);
	ДатаСобытия = ТекущаяДатаСеанса();
	ОМ_ar_ТестовыеДанные.ДобавитьСтрокуОчереди(ПодпискаВыключенная, Объект.Ссылка, ДатаСобытия);
	ОМ_ar_ТестовыеДанные.ДобавитьСтрокуОчереди(ПодпискаЗанятая, Объект.Ссылка, ДатаСобытия, Истина);

	ar_ОбработчикПодписок.ОбработатьОчередьСобытий();

	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаВыключенная).Количество(),
		"строк выключенной подписки").Равно(0);
	Строки = ОМ_ar_ТестовыеДанные.СтрокиОчереди(ПодпискаЗанятая);
	ЮТест.ОжидаетЧто(Строки.Количество(), "событие занятого агента осталось").Равно(1);
	ЮТест.ОжидаетЧто(Строки[0].ДатаСобытия).Равно(ДатаСобытия);
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
		"новых запусков не появилось").Равно(1);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 C.1: результат АктивныеПодпискиОбъекта - ФиксированныйМассив
// из ФиксированнаяСтруктура с ключами Ссылка, ar_Агент, ar_ФильтрJSON; подписка
// теста в нем есть с теми же значениями.
Процедура КэшСоставИЗначенияПодписки() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ПолноеИмяТипа = ПервыйГорячийТип();
	ФильтрТеста = "{""Наименование"": """ + УникальныйСуффикс() + """}";
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа, ФильтрТеста);

	Результат = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяТипа);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат), "тип результата").Равно(Тип("ФиксированныйМассив"));

	Найдена = Ложь;
	Для Каждого Элемент Из Результат Цикл
		ЮТест.ОжидаетЧто(ТипЗнч(Элемент), "тип элемента").Равно(Тип("ФиксированнаяСтруктура"));
		// Чтение всех трех ключей: отсутствие ключа дает исключение и падение теста.
		СсылкаЭлемента = Элемент.Ссылка;
		АгентЭлемента = Элемент.ar_Агент;
		ФильтрЭлемента = Элемент.ar_ФильтрJSON;
		Если СсылкаЭлемента = Подписка Тогда
			Найдена = Истина;
			ЮТест.ОжидаетЧто(АгентЭлемента, "агент подписки").Равно(Агент);
			ЮТест.ОжидаетЧто(ФильтрЭлемента, "фильтр подписки").Равно(ФильтрТеста);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдена, "подписка теста в результате").ЭтоИстина();

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 C.2: прогретый кэш не содержит новую подписку; запись
// подписки сбрасывает кэш сеанса - повторный вызов ее содержит; выключение
// и запись подписки убирают ее из результата.
Процедура ЗаписьПодпискиСбрасываетКэш() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	ПолноеИмяТипа = ПервыйГорячийТип();

	ДоПодписки = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяТипа);
	Подписка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа);

	ЮТест.ОжидаетЧто(ПодпискаВМассиве(ДоПодписки, Подписка), "подписки нет до записи").ЭтоЛожь();

	ПослеЗаписи = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяТипа);
	ЮТест.ОжидаетЧто(ПодпискаВМассиве(ПослеЗаписи, Подписка), "подписка есть после записи").ЭтоИстина();

	ОбъектПодписки = Подписка.ПолучитьОбъект();
	ОбъектПодписки.ar_Включён = Ложь;
	ОбъектПодписки.Записать();

	ПослеВыключения = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяТипа);
	ЮТест.ОжидаетЧто(ПодпискаВМассиве(ПослеВыключения, Подписка),
		"выключенной подписки нет").ЭтоЛожь();

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 C.3: тип без активных подписок - пустой ФиксированныйМассив.
Процедура КэшПустДляТипаБезПодписок() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	ПолноеИмяТипа = ПервыйГорячийТип();
	ОМ_ar_ТестовыеДанные.ВыключитьПодпискиСобытия(ПолноеИмяТипа);

	Результат = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяТипа);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат), "тип результата").Равно(Тип("ФиксированныйМассив"));
	ЮТест.ОжидаетЧто(Результат.Количество(), "подписок в результате").Равно(0);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// agentrunner-290 D.1: ГорячиеТипы возвращает массив строк по составу
// определяемого типа ar_ПрикладнойОбъектОбъект, включая справочник контрагентов
// и документ заявки на изменение.
Процедура ГорячиеТипыСовпадаютСОпределяемымТипом() Экспорт

	Типы = ar_ОбработчикПодписок.ГорячиеТипы();

	ОжидаемоеКоличество = Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъектОбъект.Тип.Типы().Количество();
	ЮТест.ОжидаетЧто(Типы.Количество(), "количество горячих типов").Равно(ОжидаемоеКоличество);
	ЮТест.ОжидаетЧто(Типы.Найти("Справочник.Контрагенты") <> Неопределено,
		"в составе справочник контрагентов").ЭтоИстина()
		.Что(Типы.Найти("Документ.бит_мдм_ЗаявкаНаИзменение") <> Неопределено,
		"в составе документ заявки на изменение").ЭтоИстина();

	ВсеСтроки = Истина;
	Для Каждого ИмяТипа Из Типы Цикл
		Если ТипЗнч(ИмяТипа) <> Тип("Строка") Тогда
			ВсеСтроки = Ложь;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ВсеСтроки, "все элементы - строки").ЭтоИстина();

КонецПроцедуры

// agentrunner-290 D.2: ПроверитьФильтр - пустой фильтр и невалидный JSON
// пропускают объект (Истина), JSON-массив вместо объекта не применяется
// (Истина), совпадение по двум ключам - Истина, иное значение и отсутствующий
// реквизит - Ложь.
Процедура ПроверитьФильтрСценарии() Экспорт

	Источник = Справочники.Контрагенты.СоздатьЭлемент();
	Источник.Наименование = "ТестПодписка_Фильтр";
	Источник.ИНН = "7707000000";

	ПодпискаБезФильтра = ПодпискаДляПроверкиФильтра("");
	ПодпискаСовпадение = ПодпискаДляПроверкиФильтра(
		"{""Наименование"": ""ТестПодписка_Фильтр"", ""ИНН"": ""7707000000""}");
	ПодпискаИноеЗначение = ПодпискаДляПроверкиФильтра("{""Наименование"": ""ИноеНаименование""}");
	ПодпискаНетРеквизита = ПодпискаДляПроверкиФильтра("{""НесуществующийРеквизит"": ""Значение""}");
	ПодпискаБитыйJSON = ПодпискаДляПроверкиФильтра("{не json");
	ПодпискаМассив = ПодпискаДляПроверкиФильтра("[1, 2]");

	ЮТест.ОжидаетЧто(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаБезФильтра, Источник),
		"пустой фильтр").ЭтоИстина()
		.Что(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаСовпадение, Источник),
		"совпадение по двум ключам").ЭтоИстина()
		.Что(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаИноеЗначение, Источник),
		"одно несовпадение").ЭтоЛожь()
		.Что(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаНетРеквизита, Источник),
		"нет реквизита").ЭтоЛожь()
		.Что(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаБитыйJSON, Источник),
		"невалидный JSON").ЭтоИстина()
		.Что(ar_ОбработчикПодписок.ПроверитьФильтр(ПодпискаМассив, Источник),
		"JSON-массив вместо объекта").ЭтоИстина();

КонецПроцедуры

// agentrunner-290 D.3: СформироватьКонтекстТриггера возвращает структуру
// Триггер = "event", ЯкорьСсылка = ссылка объекта, СобытиеТип = тип + ".ПриЗаписи",
// ЭтоНовый (Булево), ПодпискаРеф = ссылка подписки.
Процедура КонтекстТриггераСостав() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	Объект = ОМ_ar_ТестовыеДанные.НовыйОбъектГорячегоТипа();
	ПолноеИмяТипа = Объект.Метаданные().ПолноеИмя();
	ПодпискаСсылка = ОМ_ar_ТестовыеДанные.НоваяПодписка(Агент, ПолноеИмяТипа);

	Источник = Объект.Ссылка.ПолучитьОбъект();
	Подписка = Новый ФиксированнаяСтруктура(Новый Структура("Ссылка", ПодпискаСсылка));

	Контекст = ar_ОбработчикПодписок.СформироватьКонтекстТриггера(Источник, Подписка, ПолноеИмяТипа);

	ЮТест.ОжидаетЧто(ТипЗнч(Контекст), "тип результата").Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Контекст.Триггер).Равно("event");
	ЮТест.ОжидаетЧто(Контекст.ЯкорьСсылка, "якорь").Равно(Объект.Ссылка);
	ЮТест.ОжидаетЧто(Контекст.СобытиеТип, "тип события").Равно(ПолноеИмяТипа + ".ПриЗаписи");
	ЮТест.ОжидаетЧто(ТипЗнч(Контекст.ЭтоНовый), "тип признака нового").Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(Контекст.ЭтоНовый, "записанный объект не новый").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Контекст.ПодпискаРеф, "ссылка подписки").Равно(ПодпискаСсылка);

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первый тип из состава ГорячиеТипы - для подписок, где сам горячий тип не важен.
//
// Возвращаемое значение:
//  Строка - полное имя типа метаданных.
//
Функция ПервыйГорячийТип()

	Возврат ar_ОбработчикПодписок.ГорячиеТипы()[0];

КонецФункции

// Есть ли подписка в массиве структур кэша (по полю Ссылка).
//
// Параметры:
//  Подписки - ФиксированныйМассив из ФиксированнаяСтруктура - результат
//             АктивныеПодпискиОбъекта;
//  Подписка - СправочникСсылка.ar_ПодпискиАгентов - искомая подписка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПодпискаВМассиве(Знач Подписки, Знач Подписка)

	Для Каждого Элемент Из Подписки Цикл
		Если Элемент.Ссылка = Подписка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ФиксированнаяСтруктура подписки для ПроверитьФильтр (ключи Ссылка
// и ar_ФильтрJSON).
//
// Параметры:
//  ФильтрJSON - Строка - значение ar_ФильтрJSON.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура.
//
Функция ПодпискаДляПроверкиФильтра(Знач ФильтрJSON)

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", Справочники.ar_ПодпискиАгентов.ПустаяСсылка());
	Данные.Вставить("ar_ФильтрJSON", ФильтрJSON);
	Возврат Новый ФиксированнаяСтруктура(Данные);

КонецФункции

// Уникальный суффикс для имен тестовых данных.
//
// Возвращаемое значение:
//  Строка - УИД без дефисов.
//
Функция УникальныйСуффикс()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");

КонецФункции

#КонецОбласти
