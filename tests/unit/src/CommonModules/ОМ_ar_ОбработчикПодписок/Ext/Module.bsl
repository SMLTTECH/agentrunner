	ЮТест.ОжидаетЧто(Строки[0].ДатаСобытия, "дата события не изменилась").Равно(ДатаСобытия);
	ЮТест.ОжидаетЧто(Строки[0].ЭтоНовый, "признак нового не изменился").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОМ_ar_ТестовыеДанные.ЗапускиАгента(Агент).Количество(),
