///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_AuditЗапуски.
//
// Тесты аудита запусков (ar_AuditЗапуски): Создать -> Завершить;
// СохранитьСнимок -> ПрочитатьСнимок (содержимое совпадает); Heartbeat;
// ПрерватьЗапуск (финальные статусы не трогаются); НайтиКандидатовРестарта
// (зависший по порогу пульса - да, свежий - нет, ПриостановленДляСобытия -
// не кандидат); ПодсчитатьАктивныеЗапуски учитывает ПриостановленДляСобытия.
//
// Сценарии раздела 6 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЖизненныйЦикл")
		.ДобавитьСерверныйТест("СоздатьИЗавершитьЗапуск").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("СнимокСохраняетсяИЧитается").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("HeartbeatОбновляетПульс").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПрерватьЗапускНеТрогаетФинальные").Тег("critical").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("СлужебныеВыборки")
		.ДобавитьСерверныйТест("КандидатыРестартаПоПорогуПульса").Тег("critical").ВТранзакции()
		.ДобавитьСерверныйТест("ПодсчётАктивныхЗапусков").Тег("critical").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создать пишет запись с дефолтами, Завершить - финальный статус и дату.
Процедура СоздатьИЗавершитьЗапуск() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();

	ДанныеЗапуска = Новый Структура;
	ДанныеЗапуска.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Создан);
	ДанныеЗапуска.Вставить("АгентРеф", Агент);
	ДанныеЗапуска.Вставить("Триггер", "cron");
	ar_AuditЗапуски.Создать(RunId, ДанныеЗапуска);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Найден).ЭтоИстина()
		.Свойство("Статус").Равно(Перечисления.ar_СтатусЗапуска.Создан)
		.Свойство("Триггер").Равно("cron")
		.Свойство("СтартовалВ").Заполнено();

	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗавершения.Вставить("ОтветLLM", "Финальный ответ");
	ДанныеЗавершения.Вставить("ШаговВсего", 3);
	ar_AuditЗапуски.Завершить(RunId, ДанныеЗавершения);

	Запуск = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Запуск.Статус).Равно(Перечисления.ar_СтатусЗапуска.Завершён)
		.Свойство("ОтветLLM").Равно("Финальный ответ")
		.Свойство("ШаговВсего").Равно(3)
		.Свойство("ЗавершенВ").Заполнено();

КонецПроцедуры

// СохранитьСнимок -> ПрочитатьСнимок: структура с версией и состоянием,
// содержимое совпадает.
Процедура СнимокСохраняетсяИЧитается() Экспорт

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Справочники.ar_Агенты.ПустаяСсылка());

	Состояние = Новый Структура;
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("ШаговВсего", 7);
	Состояние.Вставить("Результат", "Тестовое состояние");
	ar_AuditЗапуски.СохранитьСнимок(RunId, Состояние);

	Снимок = ar_AuditЗапуски.ПрочитатьСнимок(RunId);

	ЮТест.ОжидаетЧто(Снимок <> Неопределено).ЭтоИстина()
		.Свойство("v").Равно(1);
	ЮТест.ОжидаетЧто(Снимок.state.ШаговВсего).Равно(7)
		.Свойство("state.Результат").Равно("Тестовое состояние");

КонецПроцедуры

// Heartbeat обновляет ar_ПоследнийПульс; для отсутствующей записи - без
// исключения.
Процедура HeartbeatОбновляетПульс() Экспорт

	RunId = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunId, Справочники.ar_Агенты.ПустаяСсылка());

	Было = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ar_AuditЗапуски.Heartbeat(RunId);

	Стало = ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunId);
	ЮТест.ОжидаетЧто(Стало.ПоследнийПульс).Больше(Было.ПоследнийПульс - 1);

	// Отсутствующий запуск - тихо (не исключение).
	ar_AuditЗапуски.Heartbeat(ОМ_ar_ТестовыеДанные.НовыйRunId());

КонецПроцедуры

// ПрерватьЗапуск переводит активный запуск в Прерван; финальные статусы
// (Завершён) не трогаются.
Процедура ПрерватьЗапускНеТрогаетФинальные() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunIdАктивный = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunIdАктивный, Агент);
	ar_AuditЗапуски.ПрерватьЗапуск(RunIdАктивный);

	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunIdАктивный).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.Прерван);

	RunIdФинальный = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunIdФинальный, Агент);
	ДанныеЗавершения = Новый Структура;
	ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ar_AuditЗапуски.Завершить(RunIdФинальный, ДанныеЗавершения);

	ar_AuditЗапуски.ПрерватьЗапуск(RunIdФинальный);
	ЮТест.ОжидаетЧто(
		ОМ_ar_ТестовыеДанные.ЗапускПоИд(RunIdФинальный).Статус)
		.Равно(Перечисления.ar_СтатусЗапуска.Завершён);

КонецПроцедуры

// НайтиКандидатовРестартаБезПривилегий: Прерванный запуск со снимком и
// ЗавершенВ >= границы - кандидат; свежий Прерванный (ЗавершенВ < границы) -
// нет; ПриостановленДляСобытия со снимком - не кандидат.
Процедура КандидатыРестартаПоПорогуПульса() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);
	Граница = ТекущаяДатаСеанса() - 3600;

	// Кандидат: Прерван + снимок + ЗавершенВ теперь (>= границы).
	RunIdКандидат = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunIdКандидат, Агент);
	ar_AuditЗапуски.СохранитьСнимок(RunIdКандидат, Новый Структура("ШаговВсего", 1));
	ar_AuditЗапуски.ПрерватьЗапуск(RunIdКандидат);

	// Не кандидат: свежий Прерванный без ЗавершенВ в прошлом (порог в будущем
	// отсекает всё - проверка фильтра по дате).
	RunIdСвежий = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ОМ_ar_ТестовыеДанные.СоздатьЗапуск(RunIdСвежий, Агент);
	ar_AuditЗапуски.СохранитьСнимок(RunIdСвежий, Новый Структура("ШаговВсего", 1));
	ar_AuditЗапуски.ПрерватьЗапуск(RunIdСвежий);
	КандидатыБудущее = ar_AuditЗапуски.НайтиКандидатовРестартаБезПривилегий(
		ТекущаяДатаСеанса() + 3600);

	// Не кандидат: ПриостановленДляСобытия (не Прерван).
	RunIdСобытие = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	ar_AuditЗапуски.Создать(RunIdСобытие, ДанныеСобытия);
	ar_AuditЗапуски.СохранитьСнимок(RunIdСобытие, Новый Структура("ШаговВсего", 1));

	Кандидаты = ar_AuditЗапуски.НайтиКандидатовРестартаБезПривилегий(Граница);

	ЮТест.ОжидаетЧто(МассивСодержит(Кандидаты, RunIdКандидат)).ЭтоИстина()
		.Что(МассивСодержит(Кандидаты, RunIdСобытие)).ЭтоЛожь()
		.Что(МассивСодержит(КандидатыБудущее, RunIdКандидат)).ЭтоЛожь();

	ОМ_ar_ТестовыеДанные.ОчиститьСценарий();

КонецПроцедуры

// ПодсчитатьАктивныеЗапускиБезПривилегий: учитывает Выполняется и
// ПриостановленДляСобытия.
Процедура ПодсчётАктивныхЗапусков() Экспорт

	Провайдер = ОМ_ar_ТестовыеДанные.НовыйПровайдерЗаглушка();
	Агент = ОМ_ar_ТестовыеДанные.НовыйАгент(Провайдер);

	RunIdВыполняется = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеВып = Новый Структура;
	ДанныеВып.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Выполняется);
	ДанныеВып.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunIdВыполняется, ДанныеВып);

	RunIdСобытие = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеСоб = Новый Структура;
	ДанныеСоб.Вставить("Статус", Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);
	ДанныеСоб.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunIdСобытие, ДанныеСоб);

	RunIdЗавершён = ОМ_ar_ТестовыеДанные.НовыйRunId();
	ДанныеЗав = Новый Структура;
	ДанныеЗав.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Завершён);
	ДанныеЗав.Вставить("АгентРеф", Агент);
	ar_AuditЗапуски.Создать(RunIdЗавершён, ДанныеЗав);

	Счётчик = ar_AuditЗапуски.ПодсчитатьАктивныеЗапускиБезПривилегий(Агент);

	ЮТест.ОжидаетЧто(Счётчик.ПоАгенту).Равно(2)
		.Свойство("ВсегоАктивных").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что массив строк содержит значение.
//
Функция МассивСодержит(Знач Массив, Знач Значение)

	Для Каждого Элемент Из Массив Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
