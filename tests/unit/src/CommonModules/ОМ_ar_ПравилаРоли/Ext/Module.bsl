///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль ОМ_ar_ПравилаРоли.
//
// Тесты ролевого контроля (ar_ПравилаРоли.Проверить): пустая роль - allow
// (контроль отключён), несуществующая роль - deny
// agent_role_not_found_in_metadata.
//
// Сценарии раздела 2 из scenarios.md задачи agentrunner-27.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Роли")
		.ДобавитьСерверныйТест("ПустаяРольРазрешаетДействие").Тег("critical")
		.ДобавитьСерверныйТест("НесуществующаяРольОтклоняется").Тег("critical");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Пустая ИмяРоли1С - ролевой контроль отключён, allow.
Процедура ПустаяРольРазрешаетДействие() Экспорт

	Решение = ar_ПравилаРоли.Проверить(
		ДанныеАгентаСРолью(""), Новый Структура);

	ЮТест.ОжидаетЧто(Решение.Решение).Равно("allow");

КонецПроцедуры

// Роль не найдена в метаданных конфигурации - deny
// agent_role_not_found_in_metadata.
Процедура НесуществующаяРольОтклоняется() Экспорт

	Решение = ar_ПравилаРоли.Проверить(
		ДанныеАгентаСРолью("НесуществующаяТестоваяРольАгента"), Новый Структура);

	ЮТест.ОжидаетЧто(Решение).Свойство("Решение").Равно("deny")
		.Свойство("Причина").Равно("agent_role_not_found_in_metadata");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ДанныеАгента с именем роли 1С.
//
Функция ДанныеАгентаСРолью(Знач ИмяРоли1С)

	Возврат Новый Структура("ИмяРоли1С", ИмяРоли1С);

КонецФункции

#КонецОбласти
