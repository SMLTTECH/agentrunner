///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль СТ_НСИОбщий.
//
// Сквозной тест процесса НСИ (agentrunner-226): заявка -> очередь -> агент НСИ ->
// визы -> контрагент и счёт -> письмо и диалог. Общая часть наборов
// СТ_НСИСоздание (создаёт заявки сценариев) и СТ_НСИПроверка (проверяет итог):
// сценарии из макета СТ_НСИСценарии, состояние прогона в хранилище общих
// настроек, создание заявок, факты базы по заявке и сверка с ожиданиями.
// Тестов не содержит (без ИсполняемыеСценарии).
//
// Между наборами агент обрабатывает заявки регламентными заданиями стенда;
// ожидание ведёт AR (ar e2e): набор проверки повторяется, пока сценарии
// пропущены с сообщением «ещё идёт».
//
// Данные пишутся в базу стенда без транзакции теста: это сквозной тест, а не
// модульный. Префикс СТ_, а не ОМ_: модульный прогон (stand-tests unit) берёт
// все модули ОМ_ и не должен создавать заявки.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Начало сообщения пропуска теста, по которому AR узнаёт незавершённый сценарий.
//
// Возвращаемое значение:
//  Строка - префикс сообщения.
//
Функция ПризнакОжидания() Экспорт

	Возврат "ещё идёт";

КонецФункции

// Сценарии сквозного теста из общего макета СТ_НСИСценарии.
//
// Возвращаемое значение:
//  Массив из Соответствие - описания сценариев (ключи - как в макете).
//
Функция Сценарии() Экспорт

	Данные = ПолучитьОбщийМакет("СТ_НСИСценарии");
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8));
	Описание = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Описание.Получить("scenarios");

КонецФункции

// Сценарий по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - id сценария (s1, s2, ...).
//
// Возвращаемое значение:
//  Соответствие - описание сценария; Неопределено - нет такого.
//
Функция Сценарий(Знач Идентификатор) Экспорт

	Для Каждого Описание Из Сценарии() Цикл
		Если Описание.Получить("id") = Идентификатор Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Состояние прогона: текущий прогон и заявки всех прошлых прогонов.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - метка текущего прогона (дата и время начала);
//   * Заявки - Соответствие - id сценария -> ДокументСсылка.бит_мдм_ЗаявкаНаИзменение;
//   * История - Массив из ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявки всех прогонов
//     (подготовка следующего прогона помечает их на удаление).
//
Функция СостояниеПрогона() Экспорт

	Состояние = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючХранилища(), "Прогон");
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Состояние = Новый Структура("Идентификатор, Заявки, История", "", Новый Соответствие, Новый Массив);
	КонецЕсли;
	// Ответы на вопросы агента: id сценария -> ApprovalId отвеченного вопроса (один ответ на сценарий).
	Если Не Состояние.Свойство("Ответы") Или ТипЗнч(Состояние.Ответы) <> Тип("Соответствие") Тогда
		Состояние.Вставить("Ответы", Новый Соответствие);
	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Сохраняет состояние прогона (см. СостояниеПрогона).
//
// Параметры:
//  Состояние - Структура - см. СостояниеПрогона.
//
Процедура СохранитьСостояниеПрогона(Знач Состояние) Экспорт

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючХранилища(), "Прогон", Состояние);

КонецПроцедуры

// Помечает на удаление заявки прошлых прогонов, а также контрагентов, созданных
// заявками на ввод нового, и их банковские счета: проверка дублей, очередь агента и
// поиск счетов помеченные объекты не видят, поэтому сценарии можно повторять.
//
// Параметры:
//  Заявки - Массив из ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявки прошлых прогонов.
//
// Возвращаемое значение:
//  Массив из Строка - ошибки пометки (пустой - всё помечено).
//
Функция ПометитьДанныеПрошлыхПрогонов(Знач Заявки) Экспорт

	Ошибки = Новый Массив;
	Если Заявки.Количество() = 0 Тогда
		Возврат Ошибки;
	КонецЕсли;

	// Контрагенты и счета - только с ИНН сценариев ввода нового: заявка изменения, созданная
	// по ошибке как ввод нового (второй прогон 21.10), не должна задеть исходные данные базы.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявки", Заявки);
	Запрос.УстановитьПараметр("ВводНового", Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);
	Запрос.УстановитьПараметр("ИННСценариев", ИННСценариевВводаНового());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заявки.Ссылка КАК Ссылка,
		|	Заявки.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка В (&Заявки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Заявки.Предмет = Контрагенты.Ссылка
		|ГДЕ
		|	Заявки.Ссылка В (&Заявки)
		|	И Заявки.ВидОперации = &ВводНового
		|	И Контрагенты.ИНН В (&ИННСценариев)
		|	И НЕ Контрагенты.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Заявки.Предмет = Контрагенты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК Счета
		|		ПО Заявки.Предмет = Счета.Владелец
		|ГДЕ
		|	Заявки.Ссылка В (&Заявки)
		|	И Заявки.ВидОперации = &ВводНового
		|	И Контрагенты.ИНН В (&ИННСценариев)
		|	И НЕ Счета.ПометкаУдаления";
	Результаты = Запрос.ВыполнитьПакет();

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗаявкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ЗаявкаОбъект.Проведен Тогда
				ЗаявкаОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ЗаявкаОбъект.УстановитьПометкуУдаления(Истина);
		Исключение
			Ошибки.Добавить(СтрШаблон("%1: %2", Выборка.Ссылка,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Для Индекс = 1 По 2 Цикл
		Выборка = Результаты[Индекс].Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
				// Тестовые карточки и счета: проверки и подписки записи БИТ пометку не пропускают
				// (третий прогон 21.10: «Не удалось записать»), запись - в режиме загрузки.
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				ЭлементОбъект.УстановитьПометкуУдаления(Истина);
			Исключение
				Ошибки.Добавить(СтрШаблон("%1: %2", Выборка.Ссылка,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// Готовит данные сценария (раздел prepare): например, неверный КПП в карточке, который
// исправит автоактуализация.
//
// Параметры:
//  Сценарий - Соответствие - описание сценария.
//
Процедура ПодготовитьДанные(Знач Сценарий) Экспорт

	Создание = Сценарий.Получить("create");
	Если Создание.Получить("kind") = "new" И Сценарий.Получить("after") = Неопределено Тогда
		// Контрагента сценария мог создать не прошлый прогон, а ручная проверка (прогоны
		// agentrunner-213): созданных с даты defaults.retire_since помечаем на удаление, иначе - дубль.
		Ошибки = ПометитьТестовыхКонтрагентов(Создание.Получить("inn"));
		Если Ошибки.Количество() > 0 Тогда
			ВызватьИсключение СтрСоединить(Ошибки, "; ");
		КонецЕсли;
	КонецЕсли;

	Шаги = Сценарий.Получить("prepare");
	Если Шаги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Шаг Из Шаги Цикл
		Если Шаг.Получить("op") = "set_counterparty" Тогда
			Контрагент = КонтрагентПоИНН(Шаг.Получить("inn"), Шаг.Получить("code"));
			Если Контрагент = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Подготовка: контрагент с ИНН %1 не найден'"),
					Шаг.Получить("inn"));
			КонецЕсли;
			КонтрагентОбъект = Контрагент.Ссылка.ПолучитьОбъект();
			КонтрагентОбъект.КПП = Шаг.Получить("kpp");
			// Неверный КПП - условие сценария: проверки и подписки записи БИТ его не пропускают
			// (первый прогон 21.10: «Не удалось записать»), запись - в режиме загрузки.
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			КонтрагентОбъект.Записать();
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Подготовка: неизвестный шаг %1'"), Шаг.Получить("op"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Создаёт заявку сценария (раздел create) от имени текущего пользователя (он инициатор,
// письма приходят ему).
//
// Параметры:
//  Сценарий      - Соответствие - описание сценария.
//  Идентификатор - Строка - метка прогона (в комментарий заявки, кроме автоактуализации:
//                  её комментарий - признак сценария actualize для пакета).
//
// Возвращаемое значение:
//  ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - созданная заявка.
//
Функция СоздатьЗаявку(Знач Сценарий, Знач Идентификатор) Экспорт

	Создание = Сценарий.Получить("create");
	Вид = Создание.Получить("kind");
	Метка = СтрШаблон(НСтр("ru = 'Сквозной тест НСИ: прогон %1, сценарий %2'"), Идентификатор, Сценарий.Получить("id"));

	Если Вид = "actualize" Тогда
		Возврат СоздатьЗаявкуАктуализации(Создание);
	ИначеЕсли Вид = "new" Тогда
		Возврат СоздатьЗаявкуВводаНового(Создание, Метка, Сценарий.Получить("after") <> Неопределено);
	ИначеЕсли Вид = "change_email" Тогда
		Возврат СоздатьЗаявкуИзмененияПочты(Создание, Метка);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид заявки сценария: %1'"), Вид);

КонецФункции

// Контрагент по ИНН (не помеченный на удаление).
//
// Параметры:
//  ИНН - Строка - ИНН контрагента.
//  Код - Строка, Неопределено - код карточки (поле code сценария): по ИНН карточек может быть несколько.
//
// Возвращаемое значение:
//  Структура - {Ссылка, КПП, Количество - сколько найдено}; Неопределено - не найден.
//
Функция КонтрагентПоИНН(Знач ИНН, Знач Код = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("Код", ?(ЗначениеЗаполнено(Код), СокрЛП(Код), ""));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.КПП КАК КПП
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.ЭтоГруппа
		|	И (&Код = """"
		|			ИЛИ Контрагенты.Код = &Код)";
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Если Выгрузка.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Ссылка, КПП, Количество", Выгрузка[0].Ссылка, Выгрузка[0].КПП, Выгрузка.Количество());

КонецФункции

// Факты базы по заявке сценария: проведение, визы этапов, запуски агента, диалог,
// открытый вопрос агента, события служебного лога запусков.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка сценария.
//
// Возвращаемое значение:
//  Структура:
//   * Проведен - Булево;
//   * Предмет - СправочникСсылка - предмет заявки (созданный контрагент - после исполнения);
//   * Визы - Соответствие - номер этапа ("1", "2") -> Структура {Решение, Комментарий} (представления);
//   * Запуски - Массив из Структура - {Идентификатор, Статус};
//   * ИдётОбработка - Булево - есть запуск, который ещё не завершился;
//   * ДиалогЕсть - Булево; ДиалогОжидаетОтвета - Булево;
//   * ВопросАгента - Строка - ApprovalId открытого вопроса агента (ask_user), пусто - нет;
//   * ТекстВопроса - Строка - текст этого вопроса;
//   * События - Массив из Строка - события служебного лога запусков заявки;
//   * Ошибки - Массив из Строка - записи служебного лога уровня «Ошибка».
//
Функция ФактыЗаявки(Знач Заявка) Экспорт

	Факты = Новый Структура("Проведен, Предмет, ИдётОбработка, ДиалогЕсть, ДиалогОжидаетОтвета, ВопросАгента",
		Ложь, Неопределено, Ложь, Ложь, Ложь, "");
	Факты.Вставить("ТекстВопроса", "");
	Факты.Вставить("Номер", "");
	Факты.Вставить("ДиалогОжидания", Неопределено);
	Факты.Вставить("Визы", Новый Соответствие);
	Факты.Вставить("Запуски", Новый Массив);
	Факты.Вставить("События", Новый Массив);
	Факты.Вставить("Ошибки", Новый Массив);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ОжидаетОтвета", Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заявки.Проведен КАК Проведен,
		|	Заявки.Предмет КАК Предмет,
		|	Заявки.Номер КАК Номер,
		|	Заявки.Дата КАК Дата
		|ИЗ
		|	Документ.бит_мдм_ЗаявкаНаИзменение КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка = &Заявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(Визы.Виза) КАК Виза,
		|	ПРЕДСТАВЛЕНИЕ(Визы.Решение) КАК Решение,
		|	Визы.Комментарий КАК Комментарий,
		|	Визы.КодСортировки КАК КодСортировки
		|ИЗ
		|	РегистрСведений.бит_УстановленныеВизы КАК Визы
		|ГДЕ
		|	Визы.Объект = &Заявка
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодСортировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Запуски.ar_ИдентификаторЗапуска КАК Идентификатор,
		|	Запуски.ar_Статус КАК Статус,
		|	Запуски.ar_СтартовалВ КАК СтартовалВ
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_Предмет = &Заявка
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтартовалВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Диалоги.Ссылка КАК Ссылка,
		|	Диалоги.ar_Состояние = &ОжидаетОтвета КАК ОжидаетОтвета
		|ИЗ
		|	Справочник.ar_Диалоги КАК Диалоги
		|ГДЕ
		|	Диалоги.ar_Предмет = &Заявка
		|	И НЕ Диалоги.ПометкаУдаления";
	Результаты = Запрос.ВыполнитьПакет();

	НомерЗаявки = "";
	ДатаЗаявки = '00010101';
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Факты.Проведен = Выборка.Проведен;
		Факты.Предмет = Выборка.Предмет;
		НомерЗаявки = Выборка.Номер;
		Факты.Номер = СокрЛП(Выборка.Номер);
		ДатаЗаявки = Выборка.Дата;
	КонецЕсли;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Этап = ЭтапВизы(Выборка.Виза);
		Если ЗначениеЗаполнено(Этап) Тогда
			Факты.Визы.Вставить(Этап, Новый Структура("Решение, Комментарий", Выборка.Решение, Выборка.Комментарий));
		КонецЕсли;
	КонецЦикла;

	Незавершенные = НезавершенныеСтатусыЗапуска();
	Идентификаторы = Новый Массив;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Факты.Запуски.Добавить(Новый Структура("Идентификатор, Статус", Выборка.Идентификатор, Строка(Выборка.Статус)));
		Идентификаторы.Добавить(Выборка.Идентификатор);
		Если Незавершенные.Найти(Выборка.Статус) <> Неопределено Тогда
			Факты.ИдётОбработка = Истина;
		КонецЕсли;
	КонецЦикла;

	// Письма по диалогу и заявке пишутся в служебный лог без RunId, со ссылкой на объект
	// (третий прогон 21.10): события ищутся и по запускам, и по ссылкам заявки и диалогов.
	СсылкиОбъектов = Новый Массив;
	СсылкиОбъектов.Добавить(ar_Утилиты.НавигационнаяСсылкаОбъекта(Заявка));
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Факты.ДиалогЕсть = Истина;
		Факты.ДиалогОжидаетОтвета = Факты.ДиалогОжидаетОтвета Или Выборка.ОжидаетОтвета;
		Если Выборка.ОжидаетОтвета Тогда
			Факты.ДиалогОжидания = Выборка.Ссылка;
		КонецЕсли;
		СсылкиОбъектов.Добавить(ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка));
	КонецЦикла;

	ЗаполнитьФактыЗапусков(Факты, Идентификаторы, СсылкиОбъектов, НомерЗаявки, ДатаЗаявки);

	Возврат Факты;

КонецФункции

// Сверяет факты заявки с ожиданиями сценария (раздел expect).
//
// Параметры:
//  Сценарий - Соответствие - описание сценария.
//  Факты    - Структура - см. ФактыЗаявки.
//
// Возвращаемое значение:
//  Массив из Строка - расхождения (пустой - сценарий пройден).
//
Функция Расхождения(Знач Сценарий, Знач Факты) Экспорт

	Итог = Новый Массив;
	Ожидания = Сценарий.Получить("expect");

	Значение = Ожидания.Получить("posted");
	Если Значение <> Неопределено И Значение <> Факты.Проведен Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'проведена: ожидалось %1, факт %2'"), Значение, Факты.Проведен));
	КонецЕсли;

	ПроверитьВизы(Итог, Ожидания, Факты);
	ПроверитьЗапуски(Итог, Ожидания, Факты);
	ПроверитьКонтрагентов(Итог, Ожидания, Факты);
	ПроверитьДиалогИЛог(Итог, Ожидания, Факты);
	ПроверитьЗапретыРешений(Итог, Ожидания, Факты);

	Если Факты.Ошибки.Количество() > 0 Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'ошибки в служебном логе: %1'"), СтрСоединить(Факты.Ошибки, "; ")));
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Сверяет вопрос агента со структурой из сценария (раздел question): текст вопроса
// модель формулирует каждый раз по-своему, поэтому проверяется не формулировка, а
// наличие фактов, без которых пользователь не поймет, о чем речь.
//
// Параметры:
//  Сценарий - Соответствие - описание сценария.
//  Факты    - Структура - см. ФактыЗаявки (ТекстВопроса, Номер).
//
// Возвращаемое значение:
//  Массив из Строка - расхождения (пустой - вопрос содержит все обязательное).
//
Функция РасхожденияВопроса(Знач Сценарий, Знач Факты) Экспорт

	Итог = Новый Массив;
	Требования = Сценарий.Получить("question");
	Если Требования = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Текст = НРег(Факты.ТекстВопроса);
	Обязательные = Требования.Получить("contains");
	Если Обязательные <> Неопределено Тогда
		Для Каждого Фрагмент Из Обязательные Цикл
			Значение = СтрЗаменить(Фрагмент, "{номер}", Факты.Номер);
			Если СтрНайти(Текст, НРег(Значение)) = 0 Тогда
				Итог.Добавить(СтрШаблон(НСтр("ru = 'в вопросе нет «%1»'"), Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЛюбойИз = Требования.Получить("contains_any");
	Если ЛюбойИз <> Неопределено И ЛюбойИз.Количество() > 0 Тогда
		Найден = Ложь;
		Для Каждого Фрагмент Из ЛюбойИз Цикл
			Найден = Найден Или СтрНайти(Текст, НРег(Фрагмент)) > 0;
		КонецЦикла;
		Если Не Найден Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'в вопросе нет ни одного из: %1'"), СтрСоединить(ЛюбойИз, " | ")));
		КонецЕсли;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Отвечает на открытый вопрос агента текстом answer сценария тем путем, которым
// отвечает человек (поле answer_via): dialog - сообщение в диалог по предмету из
// формы диалога (ar_ДиалогиСервер.ОтправитьСообщение, единая точка ввода форм);
// queue - очередь подтверждений (ar_Подтверждение.ОтветитьНаВопрос, форма
// подтверждений и консоль).
//
// Параметры:
//  Сценарий - Соответствие - описание сценария (answer, answer_via).
//  Факты    - Структура - см. ФактыЗаявки (ВопросАгента, ДиалогОжидания).
//
// Возвращаемое значение:
//  Структура - {Принят: Булево, Путь: Строка, Сообщение: Строка}.
//
Функция ОтветитьАгенту(Знач Сценарий, Знач Факты) Экспорт

	Ответ = Сценарий.Получить("answer");
	Путь = Сценарий.Получить("answer_via");
	Если Путь = Неопределено Тогда
		Путь = "queue";
	КонецЕсли;
	Итог = Новый Структура("Принят, Путь, Сообщение", Ложь, Путь, "");

	Если Путь = "dialog" Тогда
		Если Не ЗначениеЗаполнено(Факты.ДиалогОжидания) Тогда
			Итог.Сообщение = НСтр("ru = 'вопрос есть, а диалога, ожидающего ответа, по заявке нет'");
			Возврат Итог;
		КонецЕсли;
		Результат = ar_ДиалогиСервер.ОтправитьСообщение(Факты.ДиалогОжидания, Ответ);
		Итог.Принят = Результат.Успех;
		Итог.Сообщение = Результат.Сообщение;
	Иначе
		Итог.Принят = ar_Подтверждение.ОтветитьНаВопрос(Факты.ВопросАгента, Пользователи.ТекущийПользователь(), Ответ);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Кратко о фактах заявки - для сообщений тестов.
//
// Параметры:
//  Заявка - ДокументСсылка.бит_мдм_ЗаявкаНаИзменение - заявка.
//  Факты  - Структура - см. ФактыЗаявки.
//
// Возвращаемое значение:
//  Строка - описание.
//
Функция ПредставлениеФактов(Знач Заявка, Знач Факты) Экспорт

	Визы = Новый Массив;
	Для Каждого КлючИЗначение Из Факты.Визы Цикл
		Визы.Добавить(СтрШаблон("%1: %2", КлючИЗначение.Ключ,
			?(ЗначениеЗаполнено(КлючИЗначение.Значение.Решение), КлючИЗначение.Значение.Решение, "-")));
	КонецЦикла;
	Запуски = Новый Массив;
	Для Каждого Запуск Из Факты.Запуски Цикл
		Запуски.Добавить(СтрШаблон("%1 %2", Запуск.Идентификатор, Запуск.Статус));
	КонецЦикла;

	// Статус заявки: «Исполнена» - механизм БИТ внес изменения в справочник.
	Возврат СтрШаблон(НСтр("ru = '%1 (статус «%4»); визы [%2]; запуски [%3]'"), Заявка, СтрСоединить(Визы, ", "),
		СтрСоединить(Запуски, ", "), бит_ВизированиеСервер.ТекущийСтатус(Заявка));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Помечает на удаление контрагентов с ИНН сценария, созданных с даты defaults.retire_since
// макета сценариев (карточки ручных проверок agentrunner-213 и прошлых прогонов), и их
// банковские счета. Карточки исходных данных базы (созданные раньше) не трогаются.
Функция ПометитьТестовыхКонтрагентов(Знач ИНН)

	Ошибки = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаТестовыхДанных());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ДатаСоздания >= &ДатаНачала
		|	И НЕ Контрагенты.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Счета.Владелец = Контрагенты.Ссылка
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ДатаСоздания >= &ДатаНачала
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Счета.ПометкаУдаления";
	Результаты = Запрос.ВыполнитьПакет();

	Для Каждого Результат Из Результаты Цикл
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
				// Тестовые карточки и счета: проверки и подписки записи БИТ пометку не пропускают
				// (третий прогон 21.10: «Не удалось записать»), запись - в режиме загрузки.
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				ЭлементОбъект.УстановитьПометкуУдаления(Истина);
			Исключение
				Ошибки.Добавить(СтрШаблон("%1: %2", Выборка.Ссылка,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// ИНН сценариев ввода нового: только такие контрагенты создаются тестом и помечаются при очистке.
Функция ИННСценариевВводаНового()

	Итог = Новый Массив;
	Для Каждого Описание Из Сценарии() Цикл
		Создание = Описание.Получить("create");
		Если Создание.Получить("kind") = "new" И Итог.Найти(Создание.Получить("inn")) = Неопределено Тогда
			Итог.Добавить(Создание.Получить("inn"));
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Дата, с которой карточки с ИНН сценариев считаются тестовыми (defaults.retire_since макета).
Функция ДатаТестовыхДанных()

	Данные = ПолучитьОбщийМакет("СТ_НСИСценарии");
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8));
	Описание = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Значение = Описание.Получить("defaults").Получить("retire_since");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение НСтр("ru = 'В макете СТ_НСИСценарии нет defaults.retire_since'");
	КонецЕсли;

	Возврат XMLЗначение(Тип("Дата"), Значение + "T00:00:00");

КонецФункции

Функция КлючХранилища()

	Возврат "СквознойТестНСИ";

КонецФункции

// Этап визы по её наименованию: «Анализ БА (согл)» - этап 1, «Анализ БА (утв)» - этап 2.
Функция ЭтапВизы(Знач ПредставлениеВизы)

	Текст = НРег(ПредставлениеВизы);
	Если СтрНайти(Текст, "(согл)") > 0 Тогда
		Возврат "1";
	ИначеЕсли СтрНайти(Текст, "(утв)") > 0 Тогда
		Возврат "2";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция НезавершенныеСтатусыЗапуска()

	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.Создан);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.Выполняется);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);

	Возврат Статусы;

КонецФункции

// События служебного лога заявки: по запускам агента, по ссылкам заявки и диалогов, а
// письма (notify_*) - ещё и по номеру заявки в тексте записи: письмо по диалогу пишется
// без RunId и без объекта (ar_Уведомления.ЗаписатьПисьмоВЛог, пятый прогон 21.10).
Процедура ЗаполнитьФактыЗапусков(Факты, Знач Идентификаторы, Знач СсылкиОбъектов, Знач НомерЗаявки,
	Знач ДатаЗаявки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Запуски", Идентификаторы);
	Запрос.УстановитьПараметр("Объекты", СсылкиОбъектов);
	Запрос.УстановитьПараметр("ОжидаетВвода", "awaiting_input");
	Запрос.УстановитьПараметр("НачалоПоиска", ДатаЗаявки);
	Запрос.УстановитьПараметр("ШаблонНомера", "%" + СокрЛП(НомерЗаявки) + "%");
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Лог.ar_Событие КАК Событие,
		|	Лог.ar_Уровень КАК Уровень,
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	(Лог.ar_RunId В (&Запуски)
		|			ИЛИ Лог.ar_ОбъектСсылка В (&Объекты)
		|			ИЛИ Лог.ar_Событие ПОДОБНО ""notify%""
		|				И Лог.ar_Момент >= &НачалоПоиска
		|				И ВЫРАЗИТЬ(Лог.ar_Текст КАК СТРОКА(1000)) ПОДОБНО &ШаблонНомера)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ApprovalId КАК ApprovalId,
		|	Очередь.ar_ActionPayloadJSON КАК Payload
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_RunId В (&Запуски)
		|	И Очередь.ar_Статус = &ОжидаетВвода";
	Результаты = Запрос.ВыполнитьПакет();

	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Факты.События.Найти(Выборка.Событие) = Неопределено Тогда
			Факты.События.Добавить(Выборка.Событие);
		КонецЕсли;
		Если Выборка.Уровень = "Ошибка" Тогда
			Факты.Ошибки.Добавить(СтрШаблон("%1: %2", Выборка.Событие, Лев(Выборка.Текст, 2000)));
		КонецЕсли;
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Факты.ВопросАгента = Выборка.ApprovalId;
		Факты.ТекстВопроса = ТекстВопросаИзPayload(Выборка.Payload);
	КонецЕсли;

КонецПроцедуры

// Текст вопроса ask_user из JSON записи очереди подтверждений (ключ question).
Функция ТекстВопросаИзPayload(Знач Payload)

	Если Не ЗначениеЗаполнено(Payload) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Payload);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Лев(Payload, 300);
	КонецПопытки;
	Текст = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("question"), Неопределено);

	Возврат ?(ТипЗнч(Текст) = Тип("Строка"), Текст, Лев(Payload, 300));

КонецФункции

Процедура ПроверитьВизы(Итог, Знач Ожидания, Знач Факты)

	Решения = Ожидания.Получить("visas");
	Если Решения <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Решения Цикл
			Виза = Факты.Визы.Получить(КлючИЗначение.Ключ);
			Факт = ?(Виза = Неопределено, НСтр("ru = 'нет визы'"), Виза.Решение);
			Если Факт <> КлючИЗначение.Значение Тогда
				Итог.Добавить(СтрШаблон(НСтр("ru = 'виза %1: ожидалось «%2», факт «%3»'"), КлючИЗначение.Ключ,
					КлючИЗначение.Значение, Факт));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Комментарии = Ожидания.Получить("visa_comment");
	Если Комментарии <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Комментарии Цикл
			Виза = Факты.Визы.Получить(КлючИЗначение.Ключ);
			Факт = ?(Виза = Неопределено, "", Виза.Комментарий);
			Если СтрНайти(НРег(Факт), НРег(КлючИЗначение.Значение)) = 0 Тогда
				Итог.Добавить(СтрШаблон(НСтр("ru = 'виза %1: в комментарии нет «%2» (комментарий: %3)'"),
					КлючИЗначение.Ключ,
					КлючИЗначение.Значение, Лев(Факт, 200)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗапуски(Итог, Знач Ожидания, Знач Факты)

	Запуски = Ожидания.Получить("runs");
	Если Запуски = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Количество = Запуски.Получить("count");
	Если Количество <> Неопределено И Количество <> Факты.Запуски.Количество() Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'запусков агента: ожидалось %1, факт %2'"),
			Количество, Факты.Запуски.Количество()));
	КонецЕсли;

	Статус = Запуски.Получить("status");
	Если Статус <> Неопределено Тогда
		Для Каждого Запуск Из Факты.Запуски Цикл
			Если Запуск.Статус <> Статус Тогда
				Итог.Добавить(СтрШаблон(НСтр("ru = 'запуск %1: статус «%2», ожидался «%3»'"), Запуск.Идентификатор,
					Запуск.Статус, Статус));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКонтрагентов(Итог, Знач Ожидания, Знач Факты)

	Ожидание = Ожидания.Получить("counterparty");
	Если Ожидание <> Неопределено Тогда
		Контрагент = КонтрагентПоИНН(Ожидание.Получить("inn"), Ожидание.Получить("code"));
		Если Контрагент = Неопределено Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'контрагент с ИНН %1 не найден'"), Ожидание.Получить("inn")));
		ИначеЕсли Ожидание.Получить("kpp") <> Неопределено И Контрагент.КПП <> Ожидание.Получить("kpp") Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'КПП контрагента: ожидался %1, факт %2'"),
				Ожидание.Получить("kpp"), Контрагент.КПП));
		КонецЕсли;
	КонецЕсли;

	Ожидание = Ожидания.Получить("created_counterparty");
	Если Ожидание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Неопределено;
	Если ТипЗнч(Факты.Предмет) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Факты.Предмет) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Факты.Предмет, "ИНН, КПП");
	КонецЕсли;

	Если Ожидание.Получить("exists") = Ложь Тогда
		Если Реквизиты <> Неопределено Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'контрагент создан, а не должен: %1'"), Факты.Предмет));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Реквизиты = Неопределено Тогда
		Итог.Добавить(НСтр("ru = 'контрагент по заявке не создан (предмет заявки пуст)'"));
		Возврат;
	КонецЕсли;
	Если Ожидание.Получить("inn") <> Неопределено И Реквизиты.ИНН <> Ожидание.Получить("inn") Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'ИНН созданного контрагента: ожидался %1, факт %2'"),
			Ожидание.Получить("inn"), Реквизиты.ИНН));
	КонецЕсли;
	Если Ожидание.Получить("kpp") <> Неопределено И Реквизиты.КПП <> Ожидание.Получить("kpp") Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'КПП созданного контрагента: ожидался %1, факт %2'"),
			Ожидание.Получить("kpp"), Реквизиты.КПП));
	КонецЕсли;

	Счет = Ожидания.Получить("bank_account");
	Если Счет <> Неопределено И Не ЕстьСчетКонтрагента(Факты.Предмет, Счет.Получить("number")) Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'банковский счёт %1 у контрагента не создан'"), Счет.Получить("number")));
	КонецЕсли;

КонецПроцедуры

// Запреты и допустимые исходы после ответа пользователя: visa_not - решение, которого
// быть не должно (главное - нет «Согласовано» при неоднозначном ответе), visa_any_of -
// допустимые решения ("" - решения нет), counterparty_count - сколько карточек с ИНН
// допустимо (ответ «создай» не должен порождать дубль в обход проверок).
Процедура ПроверитьЗапретыРешений(Итог, Знач Ожидания, Знач Факты)

	ПроверитьЗапрещенныеРешения(Итог, Ожидания.Получить("visa_not"), Факты);
	ПроверитьДопустимыеРешения(Итог, Ожидания.Получить("visa_any_of"), Факты);
	ПроверитьКоличествоКарточек(Итог, Ожидания.Получить("counterparty_count"));

КонецПроцедуры

Процедура ПроверитьЗапрещенныеРешения(Итог, Знач Запреты, Знач Факты)

	Если Запреты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Запреты Цикл
		Виза = Факты.Визы.Получить(КлючИЗначение.Ключ);
		Если Виза <> Неопределено И Виза.Решение = КлючИЗначение.Значение Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'виза %1: недопустимое решение «%2»'"), КлючИЗначение.Ключ,
				КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьДопустимыеРешения(Итог, Знач Допустимые, Знач Факты)

	Если Допустимые = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Допустимые Цикл
		Виза = Факты.Визы.Получить(КлючИЗначение.Ключ);
		Факт = ?(Виза = Неопределено, "", Виза.Решение);
		Если КлючИЗначение.Значение.Найти(Факт) = Неопределено Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'виза %1: решение «%2» не из допустимых (%3)'"), КлючИЗначение.Ключ,
				Факт, СтрСоединить(КлючИЗначение.Значение, ", ")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКоличествоКарточек(Итог, Знач Количество)

	Если Количество = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контрагент = КонтрагентПоИНН(Количество.Получить("inn"));
	Факт = ?(Контрагент = Неопределено, 0, Контрагент.Количество);
	Если Факт > Количество.Получить("max") Тогда
		Итог.Добавить(СтрШаблон(НСтр("ru = 'карточек с ИНН %1: %2, допустимо не больше %3 (создан дубль)'"),
			Количество.Получить("inn"), Факт, Количество.Получить("max")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДиалогИЛог(Итог, Знач Ожидания, Знач Факты)

	Диалог = Ожидания.Получить("dialog");
	Если Диалог <> Неопределено Тогда
		Если Диалог.Получить("exists") <> Неопределено И Диалог.Получить("exists") <> Факты.ДиалогЕсть Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'диалог по заявке: ожидалось %1, факт %2'"),
				Диалог.Получить("exists"), Факты.ДиалогЕсть));
		КонецЕсли;
		Если Диалог.Получить("waiting") <> Неопределено И Диалог.Получить("waiting") <> Факты.ДиалогОжидаетОтвета Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'диалог ожидает ответа: ожидалось %1, факт %2'"),
				Диалог.Получить("waiting"),
				Факты.ДиалогОжидаетОтвета));
		КонецЕсли;
	КонецЕсли;

	События = Ожидания.Получить("service_log");
	Если События = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Событие Из События Цикл
		Если Факты.События.Найти(Событие) = Неопределено Тогда
			Итог.Добавить(СтрШаблон(НСтр("ru = 'в служебном логе запусков нет события %1 (есть: %2)'"), Событие,
				СтрСоединить(Факты.События, ", ")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСчетКонтрагента(Знач Контрагент, Знач НомерСчета)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Владелец
		|	И Счета.НомерСчета = &НомерСчета
		|	И НЕ Счета.ПометкаУдаления";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция СоздатьЗаявкуАктуализации(Знач Создание)

	Контрагент = КонтрагентПоИНН(Создание.Получить("inn"), Создание.Получить("code"));
	Если Контрагент = Неопределено Или Контрагент.Количество > 1 Тогда
		ТекстОшибки = НСтр("ru = 'Автоактуализация: по ИНН %1 (код «%2») нужен ровно один контрагент, найдено %3'");
		ВызватьИсключение СтрШаблон(ТекстОшибки, Создание.Получить("inn"), Создание.Получить("code"),
			?(Контрагент = Неопределено, 0, Контрагент.Количество));
	КонецЕсли;
	Ссылка = Контрагент.Ссылка;

	Заявка = НоваяЗаявка(Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение, Ссылка);
	Заявка.Дата = ТекущаяДатаСеанса();
	Заявка.Предмет = Ссылка;
	Заявка.sd_ЦелевойЭлемент = Ссылка;
	МетаданныеКонтрагента = Метаданные.Справочники.Контрагенты;
	Описания = Справочники.бит_мдм_ОписанияОбъектовОбмена;
	Заявка.ЗаписатьМодельОбъектаПред(Описания.ЭмулироватьРеальныйОбъект(Ссылка, МетаданныеКонтрагента));
	Заявка.ЗаписатьМодельОбъекта(Описания.ЭмулироватьРеальныйОбъект(Ссылка, МетаданныеКонтрагента));
	// Признаки автоактуализации - значения настроек пакета НСИАктуализацияАргументация /
	// НСИАктуализацияКомментарий на стенде: пакет узнаёт сценарий actualize по точному совпадению.
	Заявка.сд_Аргументация = "Актуализация статуса по ИНН/КПП";
	Заявка.Комментарий = "Сформировано автоматически обработкой";
	Заявка.Записать(РежимЗаписиДокумента.Запись);

	Возврат Заявка.Ссылка;

КонецФункции

Функция СоздатьЗаявкуВводаНового(Знач Создание, Знач Метка, Знач ДубльОжидается)

	Образец = КонтрагентПоИНН("7707327229");
	Если Образец = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Ввод нового: контрагент-образец модели (ЦУМ, ИНН 7707327229) не найден'");
	КонецЕсли;
	// Сценарий дубля (поле after) создаёт заявку на уже существующего контрагента намеренно.
	Существующий = КонтрагентПоИНН(Создание.Получить("inn"));
	Если Существующий <> Неопределено И Не ДубльОжидается Тогда
		ТекстОшибки = НСтр("ru = 'Ввод нового: контрагент с ИНН %1 есть в базе не от сквозного теста (%2)'");
		ВызватьИсключение СтрШаблон(ТекстОшибки, Создание.Получить("inn"), Существующий.Ссылка);
	КонецЕсли;

	Модель = Справочники.бит_мдм_ОписанияОбъектовОбмена.ЭмулироватьРеальныйОбъект(Образец.Ссылка,
		Метаданные.Справочники.Контрагенты);
	Если Модель.СтандартныеРеквизиты.Свойство("Наименование") Тогда
		Модель.СтандартныеРеквизиты.Вставить("Наименование", Создание.Получить("name"));
	КонецЕсли;
	Реквизиты = Модель.Реквизиты;
	Реквизиты.Вставить("Наименование", Создание.Получить("name"));
	Реквизиты.Вставить("НаименованиеПолное", Создание.Получить("full_name"));
	Реквизиты.Вставить("ИНН", Создание.Получить("inn"));
	Реквизиты.Вставить("КПП", Создание.Получить("kpp"));
	Реквизиты.Вставить("РегистрационныйНомер", Создание.Получить("ogrn"));
	Реквизиты.Вставить("РасширенноеПредставлениеИНН", Создание.Получить("inn"));
	Реквизиты.Вставить("РасширенноеПредставлениеКПП", Создание.Получить("kpp"));
	Реквизиты.Вставить("ГоловнойКонтрагент", Справочники.Контрагенты.ПустаяСсылка());
	Модель.ТабличныеЧасти.Вставить("КонтактнаяИнформация", АдресаМосква());
	ОчиститьПризнакиЛиквидации(Модель);
	Модель.ТабличныеЧасти.Вставить("ДополнительныеРеквизиты", СтрокиБанковскогоСчета(Создание));

	Заявка = НоваяЗаявка(Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.ВводНового);
	Заявка.Дата = ТекущаяДатаСеанса();
	Заявка.ЗаписатьМодельОбъектаПред(Модель);
	Заявка.ЗаписатьМодельОбъекта(Модель);
	Заявка.Комментарий = Метка;
	// Файлы - до проведения: проведение ставит заявку в очередь агента, а заявка с
	// файлами на распознавании агенту не выдаётся, пока текст не извлечён.
	Заявка.Записать(РежимЗаписиДокумента.Запись);
	ПрисоединитьФайлы(Заявка.Ссылка, Создание.Получить("files"));
	Заявка.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Заявка.Ссылка;

КонецФункции

Функция СоздатьЗаявкуИзмененияПочты(Знач Создание, Знач Метка)

	Контрагент = КонтрагентПоИНН(Создание.Получить("inn"));
	Если Контрагент = Неопределено Или Контрагент.Количество > 1 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Изменение почты: по ИНН %1 нужен ровно один контрагент'"),
			Создание.Получить("inn"));
	КонецЕсли;
	Ссылка = Контрагент.Ссылка;
	МетаданныеКонтрагента = Метаданные.Справочники.Контрагенты;

	МодельБыло = Справочники.бит_мдм_ОписанияОбъектовОбмена.ЭмулироватьРеальныйОбъект(Ссылка, МетаданныеКонтрагента);
	МодельСтало = Справочники.бит_мдм_ОписанияОбъектовОбмена.ЭмулироватьРеальныйОбъект(Ссылка, МетаданныеКонтрагента);
	МодельСтало.ТабличныеЧасти.Вставить("КонтактнаяИнформация",
		КонтактнаяИнформацияСПочтой(МодельСтало.ТабличныеЧасти, Создание.Получить("email")));

	Заявка = НоваяЗаявка(Перечисления.бит_мдм_ВидыОперацийЗаявкаНаИзменение.Изменение, Ссылка);
	Заявка.Дата = ТекущаяДатаСеанса();
	Заявка.Предмет = Ссылка;
	Заявка.sd_ЦелевойЭлемент = Ссылка;
	Заявка.ЗаписатьМодельОбъектаПред(МодельБыло);
	Заявка.ЗаписатьМодельОбъекта(МодельСтало);
	Заявка.сд_Аргументация = НСтр("ru = 'Изменение адреса электронной почты'");
	Заявка.Комментарий = Метка;
	Заявка.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Заявка.Ссылка;

КонецФункции

// Новая заявка с общими реквизитами: юрлицо, описание объекта «Контрагенты», текущий
// пользователь - инициатор и ответственный (адресат ожидания исправления; у заявки
// без ответственного форма исправления недоступна - прогон agentrunner-213).
// Заполнение по основанию - до реквизитов: обработка заполнения перезаписывает вид
// операции (второй прогон 21.10: заявки изменения создались как ввод нового).
Функция НоваяЗаявка(Знач ВидОперации, Знач Основание = Неопределено)

	ОписаниеОбъекта = ОписаниеОбъектаКонтрагенты();
	Если ОписаниеОбъекта = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Описание объекта обмена «Контрагенты» текущей базы не найдено'");
	КонецЕсли;

	Заявка = Документы.бит_мдм_ЗаявкаНаИзменение.СоздатьДокумент();
	Если Основание <> Неопределено Тогда
		Заявка.Заполнить(Основание);
	КонецЕсли;
	Заявка.ВидОперации = ВидОперации;
	Заявка.sd_ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Заявка.ОписаниеОбъекта = ОписаниеОбъекта;
	Заявка.Ответственный = Пользователи.ТекущийПользователь();
	Заявка.сд_Инициатор = Пользователи.ТекущийПользователь();

	Возврат Заявка;

КонецФункции

Функция ОписаниеОбъектаКонтрагенты()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Описания.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_мдм_ОписанияОбъектовОбмена КАК Описания
		|ГДЕ
		|	Описания.Наименование = ""Контрагенты""
		|	И Описания.Владелец = ЗНАЧЕНИЕ(Справочник.бит_мпд_ВидыИнформационныхБаз.ТекущаяИнформационнаяБаза)";
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Процедура ПрисоединитьФайлы(Знач Заявка, Знач Файлы)

	Если Файлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеФайла Из Файлы Цикл
		ИмяФайла = ОписаниеФайла.Получить("name");
		Части = СтрРазделить(ИмяФайла, ".", Ложь);
		Расширение = Части[Части.ВГраница()];
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов = Заявка;
		ПараметрыФайла.ИмяБезРасширения = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(Расширение) - 1);
		ПараметрыФайла.РасширениеБезТочки = Расширение;
		ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
		Адрес = ПоместитьВоВременноеХранилище(ПолучитьОбщийМакет(ОписаниеФайла.Получить("template")));
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес);
	КонецЦикла;

КонецПроцедуры

// Строки дополнительных реквизитов модели: номер счёта и БИК (ПВХ-свойства по имени).
Функция СтрокиБанковскогоСчета(Знач Создание)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Свойства.Ссылка КАК Ссылка,
		|	Свойства.Имя КАК Имя
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ГДЕ
		|	Свойства.Имя В (""НомерБанковскогоСчета"", ""БИКБанка"")
		|	И НЕ Свойства.ПометкаУдаления";
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СвойствоСчет = Выгрузка.Найти("НомерБанковскогоСчета", "Имя");
	СвойствоБИК = Выгрузка.Найти("БИКБанка", "Имя");
	Если СвойствоСчет = Неопределено Или СвойствоБИК = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Дополнительные реквизиты НомерБанковскогоСчета / БИКБанка не найдены'");
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Свойство, Значение", СвойствоСчет.Ссылка, Создание.Получить("account")));
	Строки.Добавить(Новый Структура("Свойство, Значение", СвойствоБИК.Ссылка, Создание.Получить("bik")));

	Возврат Строки;

КонецФункции

// Юридический, фактический и почтовый адрес - г. Москва (без адреса заявка не проходит проверки).
Функция АдресаМосква()

	Представление = "г. Москва, ул. Тестовая, д. 1";
	АдресXML = "<КонтактнаяИнформация xmlns=""http://www.v8.1c.ru/ssl/contactinfo"" "
		+ "xmlns:xs=""http://www.w3.org/2001/XMLSchema"" "
		+ "xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" Представление=""" + Представление + """>"
		+ "<Состав xsi:type=""Адрес"" Страна=""РОССИЯ""><Состав xsi:type=""АдресРФ""><Улица>Тестовая</Улица>"
		+ "<ДопАдрЭл><Номер Тип=""1010"" Значение=""1""/></ДопАдрЭл></Состав></Состав></КонтактнаяИнформация>";
	АдресJSON = "{""version"": 4, ""value"": """ + Представление + """, ""type"": ""Адрес"", ""country"": ""РОССИЯ"", "
		+ """addressType"": ""Муниципальный"", ""countryCode"": ""643"", ""street"": ""Тестовая"", "
		+ """houseType"": ""Дом"", "
		+ """houseNumber"": ""1"", ""admLevels"": [""street"", ""house""]}";

	Виды = СтрРазделить(НСтр("ru = 'Юридический адрес,Фактический адрес,Почтовый адрес'"), ",");
	Строки = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		Строки.Добавить(Новый Структура("Тип, Вид, Представление, ЗначенияПолей, Страна, ВидДляСписка, Значение",
			"Адрес", Вид, Представление, АдресXML, "РОССИЯ", Вид, АдресJSON));
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Контактная информация модели «стало» с заменённой (или добавленной) электронной почтой.
Функция КонтактнаяИнформацияСПочтой(Знач ТабличныеЧасти, Знач Почта)

	Строки = Неопределено;
	ТабличныеЧасти.Свойство("КонтактнаяИнформация", Строки);
	Если Строки = Неопределено Тогда
		Строки = Новый Массив;
	КонецЕсли;

	ПочтаXML = "<КонтактнаяИнформация xmlns=""http://www.v8.1c.ru/ssl/contactinfo"" "
		+ "xmlns:xs=""http://www.w3.org/2001/XMLSchema"" "
		+ "xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" Представление=""" + Почта + """>"
		+ "<Состав xsi:type=""Почта"">" + Почта + "</Состав></КонтактнаяИнформация>";
	ПочтаJSON = "{""version"": 4, ""value"": """ + Почта + """, ""type"": ""Почта""}";

	Новые = Новый Массив;
	Заменено = Ложь;
	Для Каждого СтрокаКИ Из Строки Цикл
		Если НРег(СокрЛП(Строка(СтрокаКИ.Тип))) = "почта" Тогда
			Новые.Добавить(Новый Структура("Тип, Вид, Представление, ЗначенияПолей, Страна, ВидДляСписка, Значение",
				СтрокаКИ.Тип, СтрокаКИ.Вид, Почта, ПочтаXML, СтрокаКИ.Страна, СтрокаКИ.ВидДляСписка, ПочтаJSON));
			Заменено = Истина;
		Иначе
			Новые.Добавить(СтрокаКИ);
		КонецЕсли;
	КонецЦикла;
	Если Не Заменено Тогда
		Вид = НСтр("ru = 'Электронная почта'");
		Новые.Добавить(Новый Структура("Тип, Вид, Представление, ЗначенияПолей, Страна, ВидДляСписка, Значение",
			"Почта", Вид, Почта, ПочтаXML, "", Вид, ПочтаJSON));
	КонецЕсли;

	Возврат Новые;

КонецФункции

// Образец модели (ЦУМ) ликвидирован по ЕГР: признаки ликвидации в модели блокируют
// согласование новой заявки (регламент п. 11.5) - очищаются.
Процедура ОчиститьПризнакиЛиквидации(Модель)

	Группы = Новый Массив;
	Группы.Добавить(Модель.Реквизиты);
	Группы.Добавить(Модель.СтандартныеРеквизиты);
	Для Каждого ГруппаМодели Из Группы Цикл
		Если ГруппаМодели = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Массив;
		Для Каждого КлючИЗначение Из ГруппаМодели Цикл
			Если СтрНайти(НРег(КлючИЗначение.Ключ), "ликвид") > 0 Тогда
				Имена.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Имя Из Имена Цикл
			ГруппаМодели.Вставить(Имя, ?(СтрНайти(Имя, "Дата") > 0, '00010101', Ложь));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
