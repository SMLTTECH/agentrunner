///////////////////////////////////////////////////////////////////////////////
// Расширение YAXUNIT. Общий модуль СТ_НСИСоздание.
//
// Сквозной тест процесса НСИ, набор 1 «создание» (agentrunner-226): готовит прогон
// (помечает данные прошлых прогонов на удаление) и создаёт заявки сценариев из
// макета СТ_НСИСценарии. Заявки обрабатывает агент НСИ регламентными заданиями
// стенда; итог проверяет набор СТ_НСИПроверка, ожидание между наборами ведёт
// AR (ar e2e). Сценарий с полем after (дубль) создаёт набор проверки, когда
// сценарий-предшественник завершён.
///////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("СквознойТестНСИСоздание")
		.ДобавитьСерверныйТест("ПодготовитьПрогон", НСтр("ru = 'Подготовка прогона'"));

	Для Каждого Сценарий Из СТ_НСИОбщий.Сценарии() Цикл
		Если Сценарий.Получить("after") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Набор.ДобавитьСерверныйТест("СоздатьЗаявкуСценария",
				СтрШаблон("%1: %2", Сценарий.Получить("id"), Сценарий.Получить("title")))
			.СПараметрами(Сценарий.Получить("id"));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Новый прогон: настройки стенда из макета сценариев; заявки прошлых прогонов и
// созданные ими контрагенты и счета помечаются на удаление, метка прогона - дата и
// время начала.
Процедура ПодготовитьПрогон() Экспорт

	СТ_НСИОбщий.УстановитьНастройкиСтенда();
	Состояние = СТ_НСИОбщий.СостояниеПрогона();
	Ошибки = СТ_НСИОбщий.ПометитьДанныеПрошлыхПрогонов(Состояние.История);

	Состояние.Идентификатор = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd-HHmmss");
	Состояние.Заявки = Новый Соответствие;
	Состояние.Ответы = Новый Соответствие;
	СТ_НСИОбщий.СохранитьСостояниеПрогона(Состояние);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, "; "), НСтр("ru = 'Пометка на удаление данных прошлых прогонов'"))
		.Равно("");

КонецПроцедуры

// Готовит данные сценария и создаёт его заявку; заявка запоминается в состоянии
// прогона (её найдёт набор проверки).
//
// Параметры:
//  Идентификатор - Строка - id сценария.
//
Процедура СоздатьЗаявкуСценария(Идентификатор) Экспорт

	Сценарий = СТ_НСИОбщий.Сценарий(Идентификатор);
	Состояние = СТ_НСИОбщий.СостояниеПрогона();
	ЮТест.ОжидаетЧто(Состояние.Идентификатор, НСтр("ru = 'Метка прогона (тест «Подготовка прогона»)'"))
		.Заполнено();

	СТ_НСИОбщий.ПодготовитьДанные(Сценарий);
	Заявка = СТ_НСИОбщий.СоздатьЗаявку(Сценарий, Состояние.Идентификатор);

	Состояние.Заявки.Вставить(Идентификатор, Заявка);
	Состояние.История.Добавить(Заявка);
	СТ_НСИОбщий.СохранитьСостояниеПрогона(Состояние);

	ЮТест.ОжидаетЧто(Заявка, НСтр("ru = 'Заявка сценария'")).Заполнено();

КонецПроцедуры

#КонецОбласти
