////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ЗапросыАгентам - запуск агента по команде пользователя
// (agentrunner-436).
//
// Дополнительная обработка БСП с командой «Отправить агенту» вызывает Отправить
// из серверного ВыполнитьКоманду: объекты назначения ставятся в очередь
// ar_ОчередьСобытийПодписок агентам командных подписок ar_ПодпискиАгентов
// (событие "<ПолноеИмя>.Команда"). Очередь разбирает регламентное задание
// ar_ОпросПодписокАгентов (ar_ОбработчикПодписок.ОбработатьОчередьСобытий):
// запросы - в порядке поступления, запуск с триггером "user_command", письмо
// инициатору об итоге (ar_Уведомления).
//
// Свойства модуля: Сервер, НеГлобальный, без вызова с клиента,
// Привилегированный = Ложь. Привилегированный режим - на время чтения подписок,
// захватов и записи очереди (у пользователя, нажавшего команду, может не быть
// прав на объекты AgentRunner); парный сброс, в том числе в Исключение.
// Доп. обработка, подключённая в безопасном режиме, получает отказ unsafe_mode.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Поставить объекты в очередь агентам командных подписок от имени текущего
// пользователя. Агент стартует на ближайшем тике регламентного задания
// ar_ОпросПодписокАгентов (до минуты; при длинной очереди агента - позже).
// Права «кто может отправлять» проверяет доп. обработка до вызова.
//
// Параметры:
//  Объекты   - ЛюбаяСсылка, Массив из ЛюбаяСсылка - объекты назначения команды
//              (разные типы допустимы), не больше МаксОбъектовЗаВызов().
//  Параметры - Структура, Неопределено - необязательные:
//   * Комментарий - Строка - что сделать (передаётся агенту вместе с предметом).
//   * Агент       - СправочникСсылка.ar_Агенты - ограничить одной командной подпиской
//                   (если на тип их несколько).
//
// Возвращаемое значение:
//  Массив из Структура - по строке на пару «объект, подписка» (объект без подписки - одна строка):
//   * Объект - ЛюбаяСсылка - объект.
//   * Агент  - СправочникСсылка.ar_Агенты, Неопределено - агент подписки.
//   * Итог   - Строка - "queued", "already_queued", "in_work", "no_agent",
//              "not_supported", "unsafe_mode", "error".
//   * Текст  - Строка - фраза для пользователя.
//
Функция Отправить(Знач Объекты, Знач Параметры = Неопределено) Экспорт

	СписокОбъектов = МассивОбъектов(Объекты);
	Результат = Новый Массив;

	Если СписокОбъектов.Количество() > МаксОбъектовЗаВызов() Тогда
		ТекстОтказа = СтрШаблон(НСтр("ru = 'Слишком много объектов: не больше %1 за один вызов.';
			|en = 'Too many objects: no more than %1 per call.'"), МаксОбъектовЗаВызов());
		Для Каждого ОбъектНазначения Из СписокОбъектов Цикл
			Результат.Добавить(СтрокаИтога(ОбъектНазначения, Неопределено, "error", ТекстОтказа));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если БезопасныйРежим() <> Ложь Тогда
		ТекстОтказа = НСтр("ru = 'Подключите обработку без безопасного режима: отправка агенту недоступна.';
			|en = 'Attach the data processor without safe mode: sending to an agent is unavailable.'");
		Для Каждого ОбъектНазначения Из СписокОбъектов Цикл
			Результат.Добавить(СтрокаИтога(ОбъектНазначения, Неопределено, "unsafe_mode", ТекстОтказа));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ДанныеЗапроса = ДанныеЗапросаИзПараметров(Параметры);
	Инициатор = Пользователи.ТекущийПользователь();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПоставитьВОчередь(СписокОбъектов, ДанныеЗапроса, Инициатор);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "command_enqueue_failed",
			СтрШаблон("Инициатор=%1; Объектов=%2; %3", Строка(Инициатор), СписокОбъектов.Количество(),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Ошибка");
		ТекстОтказа = СтрШаблон(НСтр("ru = 'Не удалось поставить в очередь агенту: %1';
			|en = 'Failed to queue for the agent: %1'"), ТекстОшибки);
		Результат = Новый Массив;
		Для Каждого ОбъектНазначения Из СписокОбъектов Цикл
			Результат.Добавить(СтрокаИтога(ОбъектНазначения, Неопределено, "error", ТекстОтказа));
		КонецЦикла;
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Суффикс события командной подписки ar_ПодпискиАгентов.ar_Событие1С:
// "<ПолноеИмя>.Команда".
//
// Возвращаемое значение:
//  Строка.
//
Функция СуффиксСобытияКоманды() Экспорт

	Возврат ".Команда";

КонецФункции

// События командных подписок для списка выбора формы подписки: по событию на
// тип определяемого типа ar_ПрикладнойОбъект (предмет запуска и захвата).
//
// Возвращаемое значение:
//  Массив из Строка - например "Справочник.Контрагенты.Команда".
//
Функция СобытияКоманд() Экспорт

	События = Новый Массив;
	Для Каждого ОдинТип Из Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъект.Тип.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ОдинТип);
		Если ОбъектМетаданных <> Неопределено Тогда
			События.Добавить(ОбъектМетаданных.ПолноеИмя() + СуффиксСобытияКоманды());
		КонецЕсли;
	КонецЦикла;
	Возврат События;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Постановка в очередь (вызывается в привилегированном режиме, см. Отправить):
// подписки по типам - одним запросом, активные захваты - одним запросом, запись -
// в одной транзакции под блокировкой строк очереди с перепроверкой «строки ещё нет».
//
// Параметры:
//  СписокОбъектов - Массив из ЛюбаяСсылка - объекты.
//  ДанныеЗапроса  - Структура - см. ДанныеЗапросаИзПараметров.
//  Инициатор      - СправочникСсылка.Пользователи - текущий пользователь.
//
// Возвращаемое значение:
//  Массив из Структура - см. Отправить.
//
Функция ПоставитьВОчередь(Знач СписокОбъектов, Знач ДанныеЗапроса, Знач Инициатор)

	Результат = Новый Массив;

	// Тип и событие объекта - по метаданным, без обращения к базе.
	ОбъектыСТипом = Новый Массив;
	События = Новый Массив;
	СобытиеОбъекта = Новый Соответствие;
	Для Каждого ОбъектНазначения Из СписокОбъектов Цикл
		Если Не ar_ПредметыАгентов.ТипПредметаПоддерживается(ОбъектНазначения) Тогда
			Результат.Добавить(СтрокаИтога(ОбъектНазначения, Неопределено, "not_supported",
				НСтр("ru = 'Отправка агенту для этого вида объектов не поддерживается.';
					|en = 'Sending to an agent is not supported for this kind of object.'")));
			Продолжить;
		КонецЕсли;
		Событие = ОбъектНазначения.Метаданные().ПолноеИмя() + СуффиксСобытияКоманды();
		СобытиеОбъекта.Вставить(ОбъектНазначения, Событие);
		ОбъектыСТипом.Добавить(ОбъектНазначения);
		Если События.Найти(Событие) = Неопределено Тогда
			События.Добавить(Событие);
		КонецЕсли;
	КонецЦикла;

	Если ОбъектыСТипом.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПодпискиСобытий = КомандныеПодписки(События, ДанныеЗапроса.Агент);

	// Пары «объект, подписка»; объект без подписки - итог no_agent.
	Пары = НоваяТаблицаПар();
	Для Каждого ОбъектНазначения Из ОбъектыСТипом Цикл
		ПодпискиТипа = ПодпискиСобытий.Получить(СобытиеОбъекта.Получить(ОбъектНазначения));
		Если ПодпискиТипа = Неопределено Тогда
			Результат.Добавить(СтрокаИтога(ОбъектНазначения, ДанныеЗапроса.Агент, "no_agent",
				СтрШаблон(НСтр("ru = 'Для вида «%1» не назначен агент.';
					|en = 'No agent is assigned to «%1».'"), ОбъектНазначения.Метаданные().Представление())));
			Продолжить;
		КонецЕсли;
		Для Каждого ОписаниеПодписки Из ПодпискиТипа Цикл
			СтрокаПары = Пары.Добавить();
			СтрокаПары.Подписка = ОписаниеПодписки.Подписка;
			СтрокаПары.Объект = ОбъектНазначения;
			СтрокаПары.Агент = ОписаниеПодписки.Агент;
			СтрокаПары.ИмяАгента = ОписаниеПодписки.ИмяАгента;
		КонецЦикла;
	КонецЦикла;

	Если Пары.Количество() > 0 Тогда
		ОтметитьПарыВРаботе(Пары);
		ЗаписатьПарыВОчередь(Пары, ДанныеЗапроса.Комментарий, Инициатор);
		Для Каждого СтрокаПары Из Пары Цикл
			Результат.Добавить(СтрокаИтога(СтрокаПары.Объект, СтрокаПары.Агент, СтрокаПары.Итог,
				ТекстИтога(СтрокаПары.Итог, СтрокаПары.ИмяАгента)));
		КонецЦикла;
		ЗаписатьВЛогПостановку(Пары, Инициатор);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Включённые командные подписки по событиям одним запросом.
//
// Параметры:
//  События - Массив из Строка - события "<ПолноеИмя>.Команда".
//  Агент   - СправочникСсылка.ar_Агенты, Неопределено - ограничение по агенту.
//
// Возвращаемое значение:
//  Соответствие - "Событие -> Массив из Структура {Подписка, Агент, ИмяАгента}".
//
Функция КомандныеПодписки(Знач События, Знач Агент)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Подписки.Ссылка КАК Подписка,
		|	Подписки.ar_Событие1С КАК Событие,
		|	Подписки.ar_Агент КАК Агент,
		|	ПРЕДСТАВЛЕНИЕ(Подписки.ar_Агент) КАК ИмяАгента
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК Подписки
		|ГДЕ
		|	Подписки.ar_Событие1С В (&События)
		|	И Подписки.ar_Включён
		|	И НЕ Подписки.ПометкаУдаления";
	Запрос.УстановитьПараметр("События", События);

	// Отбор по агенту - в выборке, а не условием ИЛИ в запросе: подписок на типы
	// объектов вызова - единицы.
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Агент) И Выборка.Агент <> Агент Тогда
			Продолжить;
		КонецЕсли;
		ПодпискиТипа = Результат.Получить(Выборка.Событие);
		Если ПодпискиТипа = Неопределено Тогда
			ПодпискиТипа = Новый Массив;
			Результат.Вставить(Выборка.Событие, ПодпискиТипа);
		КонецЕсли;
		ПодпискиТипа.Добавить(Новый Структура("Подписка, Агент, ИмяАгента",
			Выборка.Подписка, Выборка.Агент, Выборка.ИмяАгента));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отмечает итогом in_work пары, объект которых сейчас обрабатывает агент подписки:
// активный захват ar_ПредметыАгентов (запуск жив или ждёт автоповтора). Захваты
// пар читаются одним запросом, активность - по статусу запуска в выборке.
//
// Параметры:
//  Пары - ТаблицаЗначений - см. НоваяТаблицаПар (изменяется колонка Итог).
//
Процедура ОтметитьПарыВРаботе(Пары)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Захваты.ar_Агент КАК Агент,
		|	Захваты.ar_Предмет КАК Объект,
		|	Запуски.ar_Статус КАК Статус,
		|	Запуски.ar_ПовторитьПосле КАК ПовторитьПосле
		|ИЗ
		|	РегистрСведений.ar_ПредметыАгентов КАК Захваты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО Захваты.ar_Запуск = Запуски.ar_ИдентификаторЗапуска
		|ГДЕ
		|	Захваты.ar_Предмет В (&Объекты)
		|	И Захваты.ar_Агент В (&Агенты)";
	Запрос.УстановитьПараметр("Объекты", Пары.ВыгрузитьКолонку("Объект"));
	Запрос.УстановитьПараметр("Агенты", Пары.ВыгрузитьКолонку("Агент"));

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ФинальныеСтатусы = ФинальныеСтатусыЗапуска();
	ОбъектыВРаботе = Новый Соответствие; // Агент -> Соответствие (Объект -> Истина)
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗахватАктивен = (ФинальныеСтатусы.Найти(Выборка.Статус) = Неопределено)
			Или (Выборка.Статус = Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения
				И ЗначениеЗаполнено(Выборка.ПовторитьПосле));
		Если Не ЗахватАктивен Тогда
			Продолжить;
		КонецЕсли;
		ОбъектыАгента = ОбъектыВРаботе.Получить(Выборка.Агент);
		Если ОбъектыАгента = Неопределено Тогда
			ОбъектыАгента = Новый Соответствие;
			ОбъектыВРаботе.Вставить(Выборка.Агент, ОбъектыАгента);
		КонецЕсли;
		ОбъектыАгента.Вставить(Выборка.Объект, Истина);
	КонецЦикла;

	Для Каждого СтрокаПары Из Пары Цикл
		ОбъектыАгента = ОбъектыВРаботе.Получить(СтрокаПары.Агент);
		Если ОбъектыАгента <> Неопределено И ОбъектыАгента.Получить(СтрокаПары.Объект) <> Неопределено Тогда
			СтрокаПары.Итог = "in_work";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает в очередь пары без итога: в транзакции под исключительной блокировкой
// строк (Подписка, Объект) перечитывает очередь - уже стоящая пара получает
// already_queued и не перезаписывается (инициатор, дата и место - от первого
// запроса), прочие - queued. Порядок внутри вызова - порядок массива объектов
// (ПоставленоМс растёт на 1 от строки к строке).
//
// Параметры:
//  Пары        - ТаблицаЗначений - см. НоваяТаблицаПар (изменяется колонка Итог).
//  Комментарий - Строка - комментарий пользователя.
//  Инициатор   - СправочникСсылка.Пользователи.
//
Процедура ЗаписатьПарыВОчередь(Пары, Знач Комментарий, Знач Инициатор)

	КЗаписи = Пары.СкопироватьКолонки("Подписка, Объект");
	Для Каждого СтрокаПары Из Пары Цикл
		Если ПустаяСтрока(СтрокаПары.Итог) Тогда
			ЗаполнитьЗначенияСвойств(КЗаписи.Добавить(), СтрокаПары);
		КонецЕсли;
	КонецЦикла;
	Если КЗаписи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДатаСобытия = ТекущаяДатаСеанса();
	ПоставленоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ОчередьСобытийПодписок");
		ЭлементБлокировки.ИсточникДанных = КЗаписи;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Подписка", "Подписка");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Объект", "Объект");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		СтоящиеВОчереди = СтрокиОчереди(КЗаписи);

		Для Каждого СтрокаПары Из Пары Цикл
			Если Не ПустаяСтрока(СтрокаПары.Итог) Тогда
				Продолжить;
			КонецЕсли;
			ОбъектыПодписки = СтоящиеВОчереди.Получить(СтрокаПары.Подписка);
			Если ОбъектыПодписки <> Неопределено И ОбъектыПодписки.Получить(СтрокаПары.Объект) <> Неопределено Тогда
				СтрокаПары.Итог = "already_queued";
				Продолжить;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений.ar_ОчередьСобытийПодписок.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Подписка = СтрокаПары.Подписка;
			МенеджерЗаписи.Объект = СтрокаПары.Объект;
			МенеджерЗаписи.ДатаСобытия = ДатаСобытия;
			МенеджерЗаписи.Инициатор = Инициатор;
			МенеджерЗаписи.Комментарий = Комментарий;
			МенеджерЗаписи.ПоставленоМс = ПоставленоМс;
			МенеджерЗаписи.Записать(Истина);
			ПоставленоМс = ПоставленоМс + 1;
			СтрокаПары.Итог = "queued";
		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Строки очереди по подпискам и объектам пар (одним запросом, в транзакции
// под блокировкой - перепроверка после блокировки).
//
// Параметры:
//  КЗаписи - ТаблицаЗначений - колонки Подписка, Объект.
//
// Возвращаемое значение:
//  Соответствие - "Подписка -> Соответствие (Объект -> Истина)".
//
Функция СтрокиОчереди(Знач КЗаписи)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.Подписка КАК Подписка,
		|	Очередь.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ar_ОчередьСобытийПодписок КАК Очередь
		|ГДЕ
		|	Очередь.Подписка В (&Подписки)
		|	И Очередь.Объект В (&Объекты)";
	Запрос.УстановитьПараметр("Подписки", КЗаписи.ВыгрузитьКолонку("Подписка"));
	Запрос.УстановитьПараметр("Объекты", КЗаписи.ВыгрузитьКолонку("Объект"));

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектыПодписки = Результат.Получить(Выборка.Подписка);
		Если ОбъектыПодписки = Неопределено Тогда
			ОбъектыПодписки = Новый Соответствие;
			Результат.Вставить(Выборка.Подписка, ОбъектыПодписки);
		КонецЕсли;
		ОбъектыПодписки.Вставить(Выборка.Объект, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пишет в служебный лог итог постановки одной записью command_enqueued:
// инициатор и строка «агент; объект; итог» на пару.
//
// Параметры:
//  Пары      - ТаблицаЗначений - см. НоваяТаблицаПар.
//  Инициатор - СправочникСсылка.Пользователи.
//
Процедура ЗаписатьВЛогПостановку(Знач Пары, Знач Инициатор)

	СтрокиЛога = Новый Массив;
	СтрокиЛога.Добавить(СтрШаблон("Инициатор=%1", Строка(Инициатор)));
	Для Каждого СтрокаПары Из Пары Цикл
		СтрокиЛога.Добавить(СтрШаблон("Агент=%1; Объект=%2; Итог=%3",
			СтрокаПары.ИмяАгента, ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаПары.Объект), СтрокаПары.Итог));
	КонецЦикла;

	ОбъектЛога = ?(Пары.Количество() = 1, Пары[0].Объект, Неопределено);
	ar_СлужебныйЛог.Записать(ИмяМодуляЛога(), "command_enqueued",
		СтрСоединить(СтрокиЛога, Символы.ПС), "Информация", "", ОбъектЛога);

КонецПроцедуры

// Таблица пар «объект, подписка» постановки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Подписка, Объект, Агент, ИмяАгента, Итог.
//
Функция НоваяТаблицаПар()

	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Подписка", Новый ОписаниеТипов("СправочникСсылка.ar_ПодпискиАгентов"));
	Пары.Колонки.Добавить("Объект", Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъект.Тип);
	Пары.Колонки.Добавить("Агент", Новый ОписаниеТипов("СправочникСсылка.ar_Агенты"));
	Пары.Колонки.Добавить("ИмяАгента", Новый ОписаниеТипов("Строка"));
	Пары.Колонки.Добавить("Итог", Новый ОписаниеТипов("Строка"));
	Возврат Пары;

КонецФункции

// Комментарий и агент из параметров вызова Отправить.
//
// Параметры:
//  Параметры - Структура, Неопределено - см. Отправить.
//
// Возвращаемое значение:
//  Структура - {Комментарий: Строка, Агент: СправочникСсылка.ar_Агенты, Неопределено}.
//
Функция ДанныеЗапросаИзПараметров(Знач Параметры)

	ДанныеЗапроса = Новый Структура("Комментарий, Агент", "", Неопределено);
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Возврат ДанныеЗапроса;
	КонецЕсли;

	Комментарий = "";
	Если Параметры.Свойство("Комментарий", Комментарий) И ТипЗнч(Комментарий) = Тип("Строка") Тогда
		ДанныеЗапроса.Комментарий = СокрЛП(Комментарий);
	КонецЕсли;

	Агент = Неопределено;
	Если Параметры.Свойство("Агент", Агент)
		И ТипЗнч(Агент) = Тип("СправочникСсылка.ar_Агенты")
		И ЗначениеЗаполнено(Агент) Тогда
		ДанныеЗапроса.Агент = Агент;
	КонецЕсли;

	Возврат ДанныеЗапроса;

КонецФункции

// Объекты вызова массивом: ссылка - массив из одного элемента, повторы убираются.
//
// Параметры:
//  Объекты - ЛюбаяСсылка, Массив, ФиксированныйМассив.
//
// Возвращаемое значение:
//  Массив.
//
Функция МассивОбъектов(Знач Объекты)

	Результат = Новый Массив;
	Если ТипЗнч(Объекты) = Тип("Массив") Или ТипЗнч(Объекты) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ОбъектНазначения Из Объекты Цикл
			Если Результат.Найти(ОбъектНазначения) = Неопределено Тогда
				Результат.Добавить(ОбъектНазначения);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если Объекты <> Неопределено Тогда
			Результат.Добавить(Объекты);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Строка итога Отправить.
//
// Параметры:
//  ОбъектНазначения - ЛюбаяСсылка.
//  Агент            - СправочникСсылка.ar_Агенты, Неопределено.
//  Итог             - Строка - код итога.
//  Текст            - Строка - фраза для пользователя.
//
// Возвращаемое значение:
//  Структура - {Объект, Агент, Итог, Текст}.
//
Функция СтрокаИтога(Знач ОбъектНазначения, Знач Агент, Знач Итог, Знач Текст)

	Возврат Новый Структура("Объект, Агент, Итог, Текст", ОбъектНазначения, Агент, Итог, Текст);

КонецФункции

// Фраза для пользователя по итогу пары.
//
// Параметры:
//  Итог      - Строка - "queued", "already_queued", "in_work".
//  ИмяАгента - Строка - представление агента.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстИтога(Знач Итог, Знач ИмяАгента)

	Если Итог = "queued" Тогда
		Шаблон = НСтр("ru = 'Поставлено в очередь агенту «%1».'; en = 'Queued for agent «%1».'");
	ИначеЕсли Итог = "already_queued" Тогда
		Шаблон = НСтр("ru = 'Уже в очереди к агенту «%1».'; en = 'Already queued for agent «%1».'");
	Иначе
		Шаблон = НСтр("ru = 'Уже обрабатывается агентом «%1».'; en = 'Already being processed by agent «%1».'");
	КонецЕсли;

	Возврат СтрШаблон(Шаблон, ИмяАгента);

КонецФункции

// Финальные статусы запуска (как ar_ПредметыАгентов.ЭтоФинальныйСтатус - функция
// там не экспортная): захват по такому запуску не активен, если нет автоповтора.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ar_СтатусЗапуска.
//
Функция ФинальныеСтатусыЗапуска()

	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.Завершён);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.Отменён);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.Прерван);
	Статусы.Добавить(Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние);
	Возврат Статусы;

КонецФункции

// Не больше стольких объектов за вызов Отправить: ограничивает размер транзакции
// и блокировки.
//
// Возвращаемое значение:
//  Число.
//
Функция МаксОбъектовЗаВызов()

	Возврат 500;

КонецФункции

// Источник записей служебного лога модуля.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяМодуляЛога()

	Возврат "ar_ЗапросыАгентам";

КонецФункции

#КонецОбласти
