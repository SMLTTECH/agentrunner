////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ОбработчикПодписок (AOS Обработчик подписок на события).
//
// Реализует event-driven триггеры для агентов при записи объектов базы данных.
// Уровень 1 (горячие типы) по Plan §2.10: подписка ar_ПодпискаОбъектов на
// ПриЗаписи объектов определяемого типа ar_ПрикладнойОбъектОбъект - те же
// объекты, что в ar_ПрикладнойОбъект (предметы диалогов), только объектные
// типы. Запись прочих справочников и документов обработчик не вызывает.
//
// Горячие типы (ГорячиеТипы) - состав определяемого типа ar_ПрикладнойОбъектОбъект.
// Активные подписки читаются из справочника ar_ПодпискиАгентов (META-35) через
// кэш сеанса ar_ОбработчикПодписокПовтИсп: изменение подписки в других сеансах
// действует не позже чем через 20 минут.
//
// Запись объекта агента не запускает (agentrunner-290): ПриЗаписиОбъекта ставит
// событие в регистр ar_ОчередьСобытийПодписок в транзакции записи объекта, а
// регламентное задание ar_ОпросПодписокАгентов (раз в минуту) разбирает очередь
// (ОбработатьОчередьСобытий) и запускает агентов через ar_RuntimeЗапуск.СтартоватьВФоне.
// Фоновое задание агента работает под пользователем регламентного задания, а не
// под пользователем, записавшим объект: у того может не быть прав на объекты
// AgentRunner. Агент стартует на ближайшем тике задания - до минуты после записи.
//
// Та же очередь несёт запросы пользователей «Отправить агенту» (agentrunner-436,
// ar_ЗапросыАгентам.Отправить): командная строка - подписка с событием
// "<ПолноеИмя>.Команда", заполнены Инициатор и ПоставленоМс. Командные строки
// разбираются после строк событий записи, отдельной выборкой того же пакета
// запросов (см. ОбработатьКомандыОчереди); разбор строк событий записи не меняется.
//
// Экспортные функции ГорячиеТипы, ПроверитьФильтр, СформироватьКонтекстТриггера
// используются также в EXT-08 (регламентный опрос подписок).
//
// Свойства модуля: Серверный, НеГлобальный, Привилегированный = Ложь.
// Нет Выполнить()/Вычислить(). Привилегированный режим - только в обработчике
// ПриЗаписиОбъекта (запись объекта пользователем без прав на объекты AgentRunner)
// и в разборе очереди ОбработатьОчередьСобытий (пользователь регламентного
// задания может не иметь прав на прикладные объекты из очереди).
//
// EXT-07 / EXT-08 / Plan §2.10, §5.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик подписки ar_ПодпискаОбъектов на событие ПриЗаписи объектов
// определяемого типа ar_ПрикладнойОбъектОбъект. Сигнатура задана платформой.
//
// Ставит событие записи в очередь ar_ОчередьСобытийПодписок для каждой активной
// подписки, фильтр которой совпал с объектом. Агента не запускает - очередь
// разбирает регламентное задание (см. ОбработатьОчередьСобытий). Запись очереди
// идёт в транзакции записи объекта: отмена записи объекта отменяет и событие.
//
// Параметры:
//   Источник - ОпределяемыйТип.ar_ПрикладнойОбъектОбъект - объект, который был записан.
//   Отказ    - Булево - признак отказа (не устанавливается).
//
Процедура ПриЗаписиОбъекта(Источник, Отказ) Экспорт

	// UC-3: при загрузке из обмена данными не запускаем агентов.
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Пользователь, записывающий объект, может не иметь прав на справочник
	// ar_ПодпискиАгентов и регистр очереди: чтение подписок и запись очереди
	// выполняются в привилегированном режиме. Режим, включённый здесь, действует
	// во всех вызываемых методах и гаснет при выходе из процедуры. Попытка ловит
	// ошибки кода подписки и пишет их в журнал регистрации, Отказ не ставится (D8):
	// объект записывается. Своих транзакций код подписки не открывает (см.
	// ПоставитьСобытиеВОчередь). Ошибка СУБД внутри транзакции записи объекта
	// (таймаут блокировки очереди, сбой записи) всё равно отменит запись объекта -
	// от ошибки прав защищает привилегированный режим, а не Попытка.
	Попытка

		Если БезопасныйРежим() = Ложь Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;

		// ПриЗаписи вызывается после записи объекта в базу (до конца транзакции),
		// поэтому ссылка у нового объекта уже назначена. Проверка страхует запись
		// объекта: строка очереди с пустым измерением Объект (запрет незаполненных)
		// дала бы ошибку внутри транзакции записи, которую Попытка не нейтрализует.
		Если Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
			Возврат;
		КонецЕсли;

		ПолноеИмяОбъекта = Источник.Метаданные().ПолноеИмя();

		// Кэш сеанса: запись объектов того же типа не читает справочник подписок
		// (без подписок обработчик выходит здесь, без обращений к базе).
		АктивныеПодписки = ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта(ПолноеИмяОбъекта);
		Если АктивныеПодписки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		ПодпискиСобытия = Новый Массив;
		Для Каждого Подписка Из АктивныеПодписки Цикл
			Если ПроверитьФильтр(Подписка, Источник) Тогда
				ПодпискиСобытия.Добавить(Подписка.Ссылка);
			КонецЕсли;
		КонецЦикла;

		Если ПодпискиСобытия.Количество() > 0 Тогда
			// Известная проблема: в ПриЗаписи объект уже записан, Источник.ЭтоНовый() всегда
			// Ложь - признак нового объекта в очереди не заполняется. Запомнить его ПередЗаписью
			// одной подпиской нельзя: в источнике и документ, и справочники, событие у них разное
			// (agentrunner-299 откатана в agentrunner-301). Признак пока никто не читает.
			ПоставитьСобытиеВОчередь(Источник.Ссылка, ПодпискиСобытия, Источник.ЭтоНовый());
		КонецЕсли;

	Исключение
		СобытиеЖурнала = НСтр("ru = 'AgentRunner.Подписки: ошибка обработки записи объекта';
			|en = 'AgentRunner.Subscriptions: object write handling error'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала,
			УровеньЖурналаРегистрации.Ошибка,
			Источник.Метаданные(),
			Источник.Ссылка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Разбирает очередь событий подписок ar_ОчередьСобытийПодписок: для каждого
// события запускает агента подписки в фоне (ar_RuntimeЗапуск.СтартоватьВФоне,
// контекст - как у СформироватьКонтекстТриггера) и удаляет событие.
// Вызывается регламентным заданием ar_ОпросПодписокАгентов в начале тика, фоновое
// задание агента работает под пользователем регламентного задания; инициатор
// запуска - служебный пользователь агентов (ar_СлужебныйПользовательАгентов),
// как у запуска по расписанию.
//
// Правила разбора:
//   - подписка удалена, выключена или помечена на удаление, объект удалён -
//     событие удаляется с записью в журнал, агент не запускается;
//   - отказ «agent_already_running» / «subject_captured*» (агент или предмет
//     заняты) - событие остаётся до следующего тика, но не дольше
//     СрокОжиданияСобытияСекунд() (час) с момента последней записи объекта: затем
//     удаляется с записью в журнал;
//   - прочий отказ - событие удаляется с записью в журнал;
//   - ошибка по одному событию не прерывает разбор остальных (журнал), событие
//     остаётся до следующего тика в пределах того же срока.
// За тик разбирается не больше 100 событий записи, старые - первыми.
// Командные строки (запросы пользователей, agentrunner-436) - после событий
// записи, по своим правилам (см. ОбработатьКомандыОчереди).
//
Процедура ОбработатьОчередьСобытий() Экспорт

	Если БезопасныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	СтрокиОчереди = СтрокиОчередиТика();
	События = СтрокиОчереди.События;
	Если События.Количество() = 0 И СтрокиОчереди.Команды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ГраницаОжидания = ТекущаяДатаСеанса() - СрокОжиданияСобытияСекунд();
	СлужебныйПользователь = ar_Константы.СлужебныйПользователь();

	Для Каждого Событие Из События Цикл
		Попытка
			ОбработатьСобытиеОчереди(Событие, ГраницаОжидания, СлужебныйПользователь);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИтогРазбора = НСтр("ru = 'ошибка разбора события, повтор на следующем тике';
				|en = 'event processing error, retry on the next tick'");
			ЗаписатьВЖурналСобытиеОчереди(Событие, УровеньЖурналаРегистрации.Ошибка, ИтогРазбора, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	ОбработатьКомандыОчереди(СтрокиОчереди.Команды, СлужебныйПользователь);

КонецПроцедуры

// Возвращает массив полных имён «горячих» типов объектов - состав определяемого
// типа ar_ПрикладнойОбъектОбъект (источник подписки ar_ПодпискаОбъектов).
// Добавить горячий тип - добавить объект в ar_ПрикладнойОбъектОбъект.
// Используется EXT-08 (опрос подписок) для исключения горячих типов из polling.
//
// Возвращаемое значение:
//   Массив из Строка - полные имена типов метаданных
//                      (например, "Справочник.Контрагенты").
//
Функция ГорячиеТипы() Экспорт

	Типы = Новый Массив;
	Для Каждого ОдинТип Из Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъектОбъект.Тип.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ОдинТип);
		Если ОбъектМетаданных <> Неопределено Тогда
			Типы.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;

КонецФункции

// Проверить JSON-фильтр подписки против реальных реквизитов записанного объекта.
// При пустом фильтре или ошибке парсинга считать совпадением (пропускать все).
// Используется EXT-07 (горячие типы) и EXT-08 (опрос подписок).
//
// Параметры:
//   Подписка - ФиксированнаяСтруктура - элемент ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта;
//            - СтрокаТаблицыЗначений - строка подписки опроса (EXT-08).
//            Используются поля ar_ФильтрJSON и Ссылка.
//   Источник - ОбъектДанных          - записанный объект.
//
// Возвращаемое значение:
//   Булево - Истина, если фильтр совпадает (или фильтр пуст/невалиден).
//
Функция ПроверитьФильтр(Подписка, Источник) Экспорт

	ФильтрСтрока = Подписка.ar_ФильтрJSON;

	Если НЕ ЗначениеЗаполнено(ФильтрСтрока) Тогда
		Возврат Истина; // пустой фильтр = пропускать все
	КонецЕсли;

	// D7: ошибка парсинга - считать фильтр пустым, логировать предупреждение.
	Попытка
		ФильтрСоответствие = ar_JSON.ИзJSON(ФильтрСтрока);
	Исключение
		ОписаниеОш      = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СобытиеЖурнала  = НСтр("ru = 'AgentRunner.Подписки: невалидный JSON-фильтр подписки';
			|en = 'AgentRunner.Subscriptions: invalid JSON filter in subscription'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала,
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Подписка.Ссылка,
			ОписаниеОш);
		Возврат Истина; // при ошибке парсинга фильтр не применяется
	КонецПопытки;

	Если ФильтрСоответствие = Неопределено ИЛИ ТипЗнч(ФильтрСоответствие) <> Тип("Соответствие") Тогда
		Возврат Истина; // не соответствие, фильтр не применяется
	КонецЕсли;

	// Сопоставление каждого ключа фильтра с реквизитом объекта.
	// Условие: ВСЕ ключи фильтра должны совпасть (логическое И).
	// Значения сравниваются как строки для безопасности с разнотипными значениями.
	Для Каждого ЭлементФильтра Из ФильтрСоответствие Цикл
		ИмяРеквизита    = ЭлементФильтра.Ключ;
		ЗначениеФильтра = Строка(ЭлементФильтра.Значение);

		Попытка
			ФактическоеЗначение = Строка(Источник[ИмяРеквизита]);
		Исключение
			// Реквизит с таким именем не существует, фильтр не совпадает.
			Возврат Ложь;
		КонецПопытки;

		Если ФактическоеЗначение <> ЗначениеФильтра Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Сформировать структуру КонтекстТриггера для передачи в ar_RuntimeЗапуск.
// Используется EXT-07 (горячие типы) и EXT-08 (опрос подписок).
//
// Параметры:
//   Источник          - ОбъектДанных          - записанный объект.
//   Подписка          - СтрокаТаблицыЗначений, ФиксированнаяСтруктура - подписка (поле Ссылка).
//   ПолноеИмяОбъекта  - Строка                - полное имя типа метаданных.
//
// Возвращаемое значение:
//   Структура - контекст триггера для ar_RuntimeЗапуск.СтартоватьВФоне:
//     * Триггер     - Строка                                  - "event".
//     * ЯкорьСсылка - ЛюбаяСсылка                            - ссылка на записанный объект;
//       предметом запуска становится, только если входит в
//       ОпределяемыйТип.ar_ПрикладнойОбъект.
//     * СобытиеТип  - Строка                                  - полное имя типа + ".ПриЗаписи".
//     * ЭтоНовый    - Булево                                  - признак нового объекта;
//       при записи объекта всегда Ложь: ПриЗаписи объект уже записан
//       (agentrunner-301). Поле не читается, оставлено для контракта.
//     * ПодпискаРеф - СправочникСсылка.ar_ПодпискиАгентов   - ссылка на подписку.
//
Функция СформироватьКонтекстТриггера(Источник, Подписка, ПолноеИмяОбъекта) Экспорт

	// Известная проблема: из ПриЗаписи ЭтоНовый() всегда Ложь (см. ПриЗаписиОбъекта).
	Возврат КонтекстТриггераСобытия(Источник.Ссылка, Подписка.Ссылка, ПолноеИмяОбъекта, Источник.ЭтоНовый());

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс

// Активные подписки на событие ПриЗаписи объектов типа - чтение справочника
// ar_ПодпискиАгентов без кэша. Вызывается только из
// ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта (кэш сеанса); в правах
// вызывающего, привилегированный режим включает модуль кэша.
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//                               (например, "Справочник.Контрагенты").
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - см.
//   ar_ОбработчикПодписокПовтИсп.АктивныеПодпискиОбъекта.
//
Функция АктивныеПодпискиОбъектаБезКэша(ПолноеИмяОбъекта) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.ar_Агент КАК ar_Агент,
		|	П.ar_ФильтрJSON КАК ar_ФильтрJSON
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК П
		|ГДЕ
		|	П.ar_Событие1С = &СобытиеТип
		|	И П.ar_Включён = ИСТИНА
		|	И П.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("СобытиеТип", ПолноеИмяОбъекта + ".ПриЗаписи");

	Подписки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Подписка = Новый Структура("Ссылка, ar_Агент, ar_ФильтрJSON");
		ЗаполнитьЗначенияСвойств(Подписка, Выборка);
		Подписки.Добавить(Новый ФиксированнаяСтруктура(Подписка));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Подписки);

КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Контекст триггера запуска агента по событию записи объекта (см.
// СформироватьКонтекстТриггера) - по ссылкам, без объекта: так его строит и
// разбор очереди, где объекта в памяти нет.
//
// Параметры:
//   ОбъектСсылка     - ОпределяемыйТип.ar_ПрикладнойОбъект - записанный объект.
//   ПодпискаСсылка   - СправочникСсылка.ar_ПодпискиАгентов - подписка.
//   ПолноеИмяОбъекта - Строка - полное имя типа метаданных объекта.
//   ЭтоНовыйОбъект   - Булево - объект записан впервые.
//
// Возвращаемое значение:
//   Структура - см. СформироватьКонтекстТриггера.
//
Функция КонтекстТриггераСобытия(ОбъектСсылка, ПодпискаСсылка, ПолноеИмяОбъекта, ЭтоНовыйОбъект)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер",     "event");
	КонтекстТриггера.Вставить("ЯкорьСсылка", ОбъектСсылка);
	КонтекстТриггера.Вставить("СобытиеТип",  ПолноеИмяОбъекта + ".ПриЗаписи");
	КонтекстТриггера.Вставить("ЭтоНовый",    ЭтоНовыйОбъект);
	КонтекстТриггера.Вставить("ПодпискаРеф", ПодпискаСсылка);
	Возврат КонтекстТриггера;

КонецФункции

// Записывает событие записи объекта в очередь ar_ОчередьСобытийПодписок - по
// строке на подписку. Ключ «подписка + объект»: повторная запись объекта до
// разбора очереди обновляет дату события, а признак нового объекта не сбрасывает.
//
// Вызывается из ПриЗаписиОбъекта, то есть внутри транзакции записи объекта, и
// собственной транзакции НЕ открывает: ОтменитьТранзакцию во вложенной транзакции
// отменила бы и запись объекта, а исключение, пойманное Попыткой обработчика,
// оставило бы пользователю ошибку «В данной транзакции уже происходили ошибки».
// Без своей транзакции ошибка кода (до обращения к базе) ловится Попыткой
// обработчика, и объект записывается. Ошибку базы данных (таймаут блокировки,
// сбой записи) Попытка не нейтрализует - платформа отменит транзакцию записи
// объекта целиком; это цена записи события в той же транзакции. Поэтому всё,
// что не требует базы, вычисляется до первого обращения к ней, а обращений
// минимум: для нового объекта признак из очереди не читается и блокировка не
// ставится (строк его ссылки в очереди ещё нет).
//
// Параметры:
//   СсылкаОбъекта   - ОпределяемыйТип.ar_ПрикладнойОбъект - записанный объект.
//   ПодпискиСобытия - Массив из СправочникСсылка.ar_ПодпискиАгентов - подписки,
//                     фильтр которых совпал.
//   ЭтоНовыйОбъект  - Булево - объект записан впервые; из ПриЗаписиОбъекта всегда Ложь.
//
Процедура ПоставитьСобытиеВОчередь(СсылкаОбъекта, ПодпискиСобытия, ЭтоНовыйОбъект)

	ДатаСобытия = ТекущаяДатаСеанса();
	МенеджерРегистра = РегистрыСведений.ar_ОчередьСобытийПодписок;

	ПодпискиНовогоОбъекта = Новый Массив;
	Если Не ЭтоНовыйОбъект Тогда
		// Блокировка строк объекта до чтения признака: разбор очереди не удалит
		// строку между чтением признака и записью. Вне транзакции управляемую
		// блокировку установить нельзя; ПриЗаписи без транзакции не бывает -
		// проверка страхует от вызова из другого места.
		Если ТранзакцияАктивна() Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ОчередьСобытийПодписок");
			ЭлементБлокировки.УстановитьЗначение("Объект", СсылкаОбъекта);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
		КонецЕсли;
		ПодпискиНовогоОбъекта = ПодпискиНовогоОбъектаВОчереди(СсылкаОбъекта, ПодпискиСобытия);
	КонецЕсли;

	Для Каждого ПодпискаСсылка Из ПодпискиСобытия Цикл
		МенеджерЗаписи = МенеджерРегистра.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Подписка    = ПодпискаСсылка;
		МенеджерЗаписи.Объект      = СсылкаОбъекта;
		МенеджерЗаписи.ДатаСобытия = ДатаСобытия;
		МенеджерЗаписи.ЭтоНовый    = ЭтоНовыйОбъект
			Или ПодпискиНовогоОбъекта.Найти(ПодпискаСсылка) <> Неопределено;
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Подписки, по которым объект уже стоит в очереди с признаком нового объекта.
//
// Параметры:
//   СсылкаОбъекта   - ОпределяемыйТип.ar_ПрикладнойОбъект - объект.
//   ПодпискиСобытия - Массив из СправочникСсылка.ar_ПодпискиАгентов - подписки.
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.ar_ПодпискиАгентов.
//
Функция ПодпискиНовогоОбъектаВОчереди(СсылкаОбъекта, ПодпискиСобытия)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.Подписка КАК Подписка
		|ИЗ
		|	РегистрСведений.ar_ОчередьСобытийПодписок КАК Очередь
		|ГДЕ
		|	Очередь.Объект = &Объект
		|	И Очередь.Подписка В (&Подписки)
		|	И Очередь.ЭтоНовый";
	Запрос.УстановитьПараметр("Объект", СсылкаОбъекта);
	Запрос.УстановитьПараметр("Подписки", ПодпискиСобытия);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подписка");

КонецФункции

// Строки очереди для разбора за один тик - одним пакетом запросов (одно обращение
// к базе). Состояние подписки и существование объекта читаются тем же запросом.
//  - События записи (ПоставленоМс = 0): не больше 100, старые - первыми (как до
//    agentrunner-436).
//  - Командные строки (ПоставленоМс > 0 - заполняет только ar_ЗапросыАгентам):
//    не больше ЛимитКомандЗаТик() + 1 (лишняя строка - признак переполнения),
//    в порядке поступления: ДатаСобытия, затем ПоставленоМс.
//
// Возвращаемое значение:
//   Структура:
//   * События - ТаблицаЗначений - колонки: Подписка, Объект, ДатаСобытия, ЭтоНовый,
//     Агент (СправочникСсылка.ar_Агенты, NULL - подписки нет),
//     ПодпискаАктивна (Булево), ОбъектСуществует (Булево).
//   * Команды - ТаблицаЗначений - колонки: Подписка, Объект, ДатаСобытия, Инициатор,
//     Комментарий, Агент, ИмяАгента, Событие1С, ПредставлениеОбъекта,
//     ПодпискаАктивна, ОбъектСуществует.
//
Функция СтрокиОчередиТика()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Очередь.Подписка КАК Подписка,
		|	Очередь.Объект КАК Объект,
		|	Очередь.ДатаСобытия КАК ДатаСобытия,
		|	Очередь.ЭтоНовый КАК ЭтоНовый,
		|	Подписки.ar_Агент КАК Агент,
		|	ВЫБОР
		|		КОГДА Подписки.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		КОГДА Подписки.ar_Включён
		|				И НЕ Подписки.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПодпискаАктивна,
		|	ВЫБОР
		|		КОГДА Очередь.Объект.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ОбъектСуществует
		|ИЗ
		|	РегистрСведений.ar_ОчередьСобытийПодписок КАК Очередь
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ar_ПодпискиАгентов КАК Подписки
		|		ПО Очередь.Подписка = Подписки.Ссылка
		|ГДЕ
		|	Очередь.ПоставленоМс = 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ДатаСобытия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1001
		|	Очередь.Подписка КАК Подписка,
		|	Очередь.Объект КАК Объект,
		|	Очередь.ДатаСобытия КАК ДатаСобытия,
		|	Очередь.Инициатор КАК Инициатор,
		|	Очередь.Комментарий КАК Комментарий,
		|	Подписки.ar_Агент КАК Агент,
		|	ПРЕДСТАВЛЕНИЕ(Подписки.ar_Агент) КАК ИмяАгента,
		|	Подписки.ar_Событие1С КАК Событие1С,
		|	ПРЕДСТАВЛЕНИЕ(Очередь.Объект) КАК ПредставлениеОбъекта,
		|	ВЫБОР
		|		КОГДА Подписки.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		КОГДА Подписки.ar_Включён
		|				И НЕ Подписки.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПодпискаАктивна,
		|	ВЫБОР
		|		КОГДА Очередь.Объект.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ОбъектСуществует
		|ИЗ
		|	РегистрСведений.ar_ОчередьСобытийПодписок КАК Очередь
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ar_ПодпискиАгентов КАК Подписки
		|		ПО Очередь.Подписка = Подписки.Ссылка
		|ГДЕ
		|	Очередь.ПоставленоМс > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ДатаСобытия,
		|	Очередь.ПоставленоМс";

	Результаты = Запрос.ВыполнитьПакет();

	СтрокиОчереди = Новый Структура;
	СтрокиОчереди.Вставить("События", Результаты[0].Выгрузить());
	СтрокиОчереди.Вставить("Команды", Результаты[1].Выгрузить());
	Возврат СтрокиОчереди;

КонецФункции

// Разбирает командные строки очереди (запросы пользователей, agentrunner-436) -
// после строк событий записи, в порядке поступления:
//   - подписка выключена или удалена, объект удалён, строка старше
//     СрокОжиданияКомандыСекунд() (сутки от постановки) - строка удаляется, запись
//     в журнал, инициатору - письмо о снятии;
//   - одновременно у агента не больше его лимита запусков: отказ
//     «agent_already_running» - строка ждёт следующего тика, остальные строки этого
//     агента в текущем тике не стартуют; отказ «subject_captured*» - строка ждёт;
//     после успешного старта остальные строки этого агента тоже ждут следующего
//     тика (не больше одного старта на агента за тик: запуск в статусе «Создан»
//     лимит агента ещё не занимает);
//   - общий потолок запусков (ar_МаксСуммарныхЗапусков): активные запуски читаются
//     один раз за тик, каждый старт увеличивает счётчик; при достижении потолка
//     строки ждут следующего тика;
//   - прочий отказ запуска - строка удаляется, журнал, письмо о снятии;
//   - успешный старт - строка удаляется; письмо об итоге отправит завершение
//     запуска (ar_RuntimeЦикл.ЗавершитьЗапуск).
// Письма о снятых строках - одно на инициатора за тик (отправка синхронная).
//
// Параметры:
//  Команды               - ТаблицаЗначений - см. СтрокиОчередиТика (Команды).
//  СлужебныйПользователь - СправочникСсылка.Пользователи - инициатор запуска, если в
//                          строке он не заполнен.
//
Процедура ОбработатьКомандыОчереди(Знач Команды, Знач СлужебныйПользователь)

	Если Команды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Команды.Количество() > ЛимитКомандЗаТик() Тогда
		ЗаписатьПереполнениеОчередиКоманд();
		Команды.Удалить(Команды.Количество() - 1);
	КонецЕсли;

	СчетчикиЗапусков = ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно(Неопределено);

	Разбор = Новый Структура;
	Разбор.Вставить("ГраницаОжидания", ТекущаяДатаСеанса() - СрокОжиданияКомандыСекунд());
	Разбор.Вставить("ВсегоАктивных", СчетчикиЗапусков.ВсегоАктивных);
	Разбор.Вставить("ПотолокЗапусков", ar_Константы.МаксСуммарныхЗапусков());
	Разбор.Вставить("СлужебныйПользователь", СлужебныйПользователь);
	Разбор.Вставить("ЗанятыеАгенты", Новый Соответствие);
	Разбор.Вставить("Снятые", Новый Соответствие);

	Для Каждого Команда Из Команды Цикл
		Попытка
			ОбработатьКомандуОчереди(Команда, Разбор);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИтогРазбора = НСтр("ru = 'ошибка разбора запроса пользователя, повтор на следующем тике';
				|en = 'user request processing error, retry on the next tick'");
			ЗаписатьВЖурналСобытиеОчереди(Команда, УровеньЖурналаРегистрации.Ошибка, ИтогРазбора, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Для Каждого ОписаниеИнициатора Из Разбор.Снятые Цикл
		ar_Уведомления.УведомитьИнициатораОСнятииЗапросов(ОписаниеИнициатора.Ключ, ОписаниеИнициатора.Значение);
	КонецЦикла;

КонецПроцедуры

// Разбирает одну командную строку очереди (правила - см. ОбработатьКомандыОчереди).
//
// Параметры:
//  Команда - СтрокаТаблицыЗначений - строка Команды из СтрокиОчередиТика.
//  Разбор  - Структура - состояние разбора тика (см. ОбработатьКомандыОчереди),
//            изменяются ВсегоАктивных, ЗанятыеАгенты, Снятые.
//
Процедура ОбработатьКомандуОчереди(Команда, Разбор)

	ПричинаСнятия = ПричинаСнятияБезЗапуска(Команда, Разбор.ГраницаОжидания);
	Если Не ПустаяСтрока(ПричинаСнятия) Тогда
		СнятьКомандуОчереди(Команда, Разбор, ПричинаСнятия, "");
		Возврат;
	КонецЕсли;

	Если Разбор.ЗанятыеАгенты.Получить(Команда.Агент) <> Неопределено
		Или Разбор.ВсегоАктивных >= Разбор.ПотолокЗапусков Тогда
		Возврат; // агент занят или достигнут общий потолок - повтор на следующем тике
	КонецЕсли;

	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Команда.Агент,
		КонтекстТриггераКоманды(Команда, Разбор.СлужебныйПользователь));

	Если Результат.Успех Тогда
		Разбор.ВсегоАктивных = Разбор.ВсегоАктивных + 1;
		// Новый запуск до старта фонового задания остаётся в статусе «Создан» и в
		// подсчёт активных запусков агента (СтартоватьВФоне) не входит: следующая
		// строка этого агента в том же тике стартовала бы сверх его лимита. Поэтому
		// не больше одного старта на агента за тик, остальные строки - на следующих.
		Разбор.ЗанятыеАгенты.Вставить(Команда.Агент, Истина);
		УдалитьСобытиеОчереди(Команда);
		Возврат;
	КонецЕсли;

	Если Результат.Причина = "agent_already_running" Тогда
		Разбор.ЗанятыеАгенты.Вставить(Команда.Агент, Истина);
		Возврат;
	КонецЕсли;

	Если ЭтоОтказЗанятости(Результат.Причина) Тогда
		Возврат; // предмет занят - повтор на следующем тике
	КонецЕсли;

	СнятьКомандуОчереди(Команда, Разбор,
		НСтр("ru = 'агент не запущен'; en = 'agent not started'"), Результат.Причина);

КонецПроцедуры

// Причина снять командную строку без попытки запуска: подписка выключена или
// удалена, объект удалён, истёк срок ожидания.
//
// Параметры:
//  Команда         - СтрокаТаблицыЗначений - строка Команды из СтрокиОчередиТика.
//  ГраницаОжидания - Дата - строка с датой постановки раньше границы снимается.
//
// Возвращаемое значение:
//  Строка - причина для журнала и письма; "" - строку можно запускать.
//
Функция ПричинаСнятияБезЗапуска(Знач Команда, Знач ГраницаОжидания)

	Если Не Команда.ПодпискаАктивна Тогда
		Возврат НСтр("ru = 'подписка агента выключена или удалена'; en = 'agent subscription disabled or deleted'");
	КонецЕсли;

	Если Не Команда.ОбъектСуществует Тогда
		Возврат НСтр("ru = 'объект удален'; en = 'object deleted'");
	КонецЕсли;

	Если Команда.ДатаСобытия < ГраницаОжидания Тогда
		Возврат НСтр("ru = 'не обработан за срок ожидания (сутки)';
			|en = 'not processed within the waiting period (a day)'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Удаляет командную строку без запуска: журнал регистрации и строка в письмо
// инициатору о снятии (письма отправляются после разбора тика).
//
// Параметры:
//  Команда       - СтрокаТаблицыЗначений - строка Команды из СтрокиОчередиТика.
//  Разбор        - Структура - состояние разбора тика (изменяется Снятые).
//  ПричинаСнятия - Строка - причина для журнала и письма.
//  Подробности   - Строка - код отказа запуска ("" - нет).
//
Процедура СнятьКомандуОчереди(Команда, Разбор, Знач ПричинаСнятия, Знач Подробности)

	УдалитьСобытиеОчереди(Команда);
	ЗаписатьВЖурналСобытиеОчереди(Команда, УровеньЖурналаРегистрации.Предупреждение,
		СтрШаблон(НСтр("ru = 'запрос пользователя снят: %1'; en = 'user request removed: %1'"), ПричинаСнятия),
		Подробности);

	Если Не ЗначениеЗаполнено(Команда.Инициатор) Тогда
		Возврат;
	КонецЕсли;

	СнятыеИнициатора = Разбор.Снятые.Получить(Команда.Инициатор);
	Если СнятыеИнициатора = Неопределено Тогда
		СнятыеИнициатора = Новый Массив;
		Разбор.Снятые.Вставить(Команда.Инициатор, СнятыеИнициатора);
	КонецЕсли;

	ТекстПричины = ПричинаСнятия + ?(ПустаяСтрока(Подробности), "", " (" + Подробности + ")");
	СнятыеИнициатора.Добавить(Новый Структура("Объект, ПредставлениеОбъекта, ИмяАгента, Причина",
		Команда.Объект, Команда.ПредставлениеОбъекта, Строка(Команда.ИмяАгента), ТекстПричины));

КонецПроцедуры

// Контекст триггера запуска агента по команде пользователя.
//
// Параметры:
//  Команда               - СтрокаТаблицыЗначений - строка Команды из СтрокиОчередиТика.
//  СлужебныйПользователь - СправочникСсылка.Пользователи - инициатор, если в строке пусто.
//
// Возвращаемое значение:
//  Структура - контекст для ar_RuntimeЗапуск.СтартоватьВФоне:
//   * Триггер            - Строка - "user_command".
//   * ЯкорьСсылка        - ОпределяемыйТип.ar_ПрикладнойОбъект - объект (предмет запуска).
//   * СобытиеТип         - Строка - событие подписки "<ПолноеИмя>.Команда".
//   * ПодпискаРеф        - СправочникСсылка.ar_ПодпискиАгентов - подписка.
//   * ПользовательРеф    - СправочникСсылка.Пользователи - инициатор запроса.
//   * ЗапросПользователя - Строка - только при комментарии: предмет и комментарий
//     одним сообщением (стартовое сообщение с предметом рантайм добавляет только
//     без сообщения пользователя).
//
Функция КонтекстТриггераКоманды(Знач Команда, Знач СлужебныйПользователь)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер",     "user_command");
	КонтекстТриггера.Вставить("ЯкорьСсылка", Команда.Объект);
	КонтекстТриггера.Вставить("СобытиеТип",  Строка(Команда.Событие1С));
	КонтекстТриггера.Вставить("ПодпискаРеф", Команда.Подписка);

	ПользовательЗапуска = ?(ЗначениеЗаполнено(Команда.Инициатор), Команда.Инициатор, СлужебныйПользователь);
	Если ЗначениеЗаполнено(ПользовательЗапуска) Тогда
		КонтекстТриггера.Вставить("ПользовательРеф", ПользовательЗапуска);
	КонецЕсли;

	Комментарий = СокрЛП(Команда.Комментарий);
	Если Не ПустаяСтрока(Комментарий) Тогда
		КонтекстТриггера.Вставить("ЗапросПользователя", СтрШаблон(
			НСтр("ru = 'Выполни свою инструкцию. Предмет запуска: %1. Комментарий пользователя: %2';
				|en = 'Follow your instructions. Run subject: %1. User comment: %2'"),
			Команда.ПредставлениеОбъекта, Комментарий));
	КонецЕсли;

	Возврат КонтекстТриггера;

КонецФункции

// Предупреждение command_queue_overflow в служебный лог: командных строк больше,
// чем разбирается за тик. Не чаще раза в 30 минут: граница - по последней записи
// журнала (память модуля между тиками не сохраняется), как
// ar_ДиспетчерОчереди.ЗаписатьСбойИсточника.
//
Процедура ЗаписатьПереполнениеОчередиКоманд()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Момент КАК Момент
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Момент > &Граница
		|	И Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - ПаузаПредупрежденияПереполненияСекунд());
	Запрос.УстановитьПараметр("Источник", ИмяИсточникаЛогаОчереди());
	Запрос.УстановитьПараметр("Событие", "command_queue_overflow");

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛогаОчереди(), "command_queue_overflow",
		СтрШаблон("В очереди запросов пользователей больше %1 строк: за тик разбираются первые %1, "
			+ "остальные ждут следующих тиков", ЛимитКомандЗаТик()),
		"Предупреждение");

КонецПроцедуры

// Командных строк очереди за тик не больше.
//
// Возвращаемое значение:
//  Число.
//
Функция ЛимитКомандЗаТик()

	Возврат 1000;

КонецФункции

// Пауза между предупреждениями command_queue_overflow.
//
// Возвращаемое значение:
//  Число - секунды (30 минут).
//
Функция ПаузаПредупрежденияПереполненияСекунд()

	Возврат 1800;

КонецФункции

// Срок ожидания командной строки (запроса пользователя) от постановки в очередь.
//
// Возвращаемое значение:
//  Число - секунды (сутки).
//
Функция СрокОжиданияКомандыСекунд()

	Возврат 86400;

КонецФункции

// Источник записей служебного лога разбора очереди.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяИсточникаЛогаОчереди()

	Возврат "ar_ОбработчикПодписок.ОбработатьОчередьСобытий";

КонецФункции

// Разбирает одно событие очереди (правила - см. ОбработатьОчередьСобытий).
//
// Параметры:
//   Событие               - СтрокаТаблицыЗначений - строка из СобытияОчереди.
//   ГраницаОжидания       - Дата - событие с датой раньше границы не ждёт освобождения агента.
//   СлужебныйПользователь - СправочникСсылка.Пользователи - инициатор запуска (пусто - не задан).
//
Процедура ОбработатьСобытиеОчереди(Событие, ГраницаОжидания, СлужебныйПользователь)

	Если Не Событие.ПодпискаАктивна Тогда
		УдалитьСобытиеОчереди(Событие);
		ЗаписатьВЖурналСобытиеОчереди(Событие, УровеньЖурналаРегистрации.Информация,
			НСтр("ru = 'подписка удалена или выключена, событие удалено';
				|en = 'subscription deleted or disabled, event removed'"));
		Возврат;
	КонецЕсли;

	Если Не Событие.ОбъектСуществует Тогда
		УдалитьСобытиеОчереди(Событие);
		ЗаписатьВЖурналСобытиеОчереди(Событие, УровеньЖурналаРегистрации.Информация,
			НСтр("ru = 'объект удален, событие удалено';
				|en = 'object deleted, event removed'"));
		Возврат;
	КонецЕсли;

	Если Событие.ДатаСобытия < ГраницаОжидания Тогда
		УдалитьСобытиеОчереди(Событие);
		ЗаписатьВЖурналСобытиеОчереди(Событие, УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'агент не запущен за срок ожидания, событие удалено';
				|en = 'agent not started within the waiting period, event removed'"));
		Возврат;
	КонецЕсли;

	ПолноеИмяОбъекта = Событие.Объект.Метаданные().ПолноеИмя();
	КонтекстТриггера = КонтекстТриггераСобытия(Событие.Объект, Событие.Подписка,
		ПолноеИмяОбъекта, Событие.ЭтоНовый);
	Если ЗначениеЗаполнено(СлужебныйПользователь) Тогда
		КонтекстТриггера.Вставить("ПользовательРеф", СлужебныйПользователь);
	КонецЕсли;

	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Событие.Агент, КонтекстТриггера);
	Если Не Результат.Успех И ЭтоОтказЗанятости(Результат.Причина) Тогда
		Возврат; // агент или предмет заняты - повтор на следующем тике
	КонецЕсли;

	УдалитьСобытиеОчереди(Событие);

	Если Не Результат.Успех Тогда
		ЗаписатьВЖурналСобытиеОчереди(Событие, УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'агент не запущен, событие удалено';
				|en = 'agent not started, event removed'"),
			Результат.Причина);
	КонецЕсли;

КонецПроцедуры

// Удаляет событие из очереди, если объект не записан повторно после выборки
// очереди (дата события не изменилась): иначе новое событие остаётся до
// следующего тика.
//
// Параметры:
//   Событие - СтрокаТаблицыЗначений - строка из СобытияОчереди.
//
Процедура УдалитьСобытиеОчереди(Событие)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ОчередьСобытийПодписок");
		ЭлементБлокировки.УстановитьЗначение("Подписка", Событие.Подписка);
		ЭлементБлокировки.УстановитьЗначение("Объект", Событие.Объект);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		НаборЗаписей = РегистрыСведений.ar_ОчередьСобытийПодписок.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Подписка.Установить(Событие.Подписка);
		НаборЗаписей.Отбор.Объект.Установить(Событие.Объект);
		НаборЗаписей.Прочитать();

		Если НаборЗаписей.Количество() = 1
			И НаборЗаписей[0].ДатаСобытия = Событие.ДатаСобытия Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Отказ запуска из-за занятости агента или предмета: событие ждёт следующего тика.
// agentrunner-444 (п. 9): общий лимит запусков (global_limit_reached) - тоже
// занятость: иначе событие удалялось бы из очереди и запуск терялся.
//
// Параметры:
//   Причина - Строка - причина отказа ar_RuntimeЗапуск.СтартоватьВФоне.
//
// Возвращаемое значение:
//   Булево.
//
Функция ЭтоОтказЗанятости(Причина)

	Возврат Причина = "agent_already_running"
		Или Причина = "global_limit_reached"
		Или СтрНачинаетсяС(Причина, "subject_captured");

КонецФункции

// Срок, в течение которого событие очереди ждёт освобождения агента или
// предмета, считая от последней записи объекта.
//
// Возвращаемое значение:
//   Число - секунды (час).
//
Функция СрокОжиданияСобытияСекунд()

	Возврат 3600;

КонецФункции

// Пишет в журнал регистрации запись о событии очереди.
//
// Параметры:
//   Событие     - СтрокаТаблицыЗначений - строка из СобытияОчереди.
//   Уровень     - УровеньЖурналаРегистрации - уровень записи.
//   Итог        - Строка - что сделано с событием.
//   Подробности - Строка - причина отказа или текст ошибки.
//
Процедура ЗаписатьВЖурналСобытиеОчереди(Событие, Уровень, Итог, Подробности = "")

	ШаблонКомментария = НСтр("ru = 'Подписка: %1, агент: %2, запись объекта: %3 - %4. %5';
		|en = 'Subscription: %1, agent: %2, object written: %3 - %4. %5'");
	КомментарийЖурнала = СтрШаблон(ШаблонКомментария,
		Событие.Подписка, Событие.Агент, Событие.ДатаСобытия, Итог, Подробности);
	СобытиеЖурнала = НСтр("ru = 'AgentRunner.Подписки: очередь событий';
		|en = 'AgentRunner.Subscriptions: event queue'");
	МетаданныеОбъекта = Событие.Объект.Метаданные();

	ЗаписьЖурналаРегистрации(СобытиеЖурнала, Уровень, МетаданныеОбъекта, Событие.Объект, КомментарийЖурнала);

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
