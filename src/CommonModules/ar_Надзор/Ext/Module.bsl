////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Надзор (CONS-10: надзор за достижением цели).
//
// Проверяет, действительно ли агент достиг цели своего запуска, в момент
// завершения ReAct-цикла (ar_RuntimeЦикл.ВыполнитьАгентаВнутр, ветки
// run_completed и max_steps_reached). Единственная экспортная функция -
// ПроверитьДостижениеЦели - вызывается ПЕРЕД ЗавершитьЗапуск и НИКОГДА не
// меняет итоговый статус запуска (Completed/MaxStepsReached остаются как
// есть) - вердикт пишется отдельно в ar_Запуски.ar_ПоследнееРешениеНадзора.
//
// Включен по умолчанию, без константы-выключателя (решение 9/10) - это
// часть контракта автономной системы, а не опция.
//
// БЕЗОПАСНОСТЬ (D7): любая ошибка внутри модуля (исключение, недоступность
// LLM, мусор в JSON-ответе) перехватывается и не пробрасывается наружу -
// надзор врезан в общий путь завершения ЛЮБОГО запуска расширения.
//
// Рекурсия (D10): обращение к LLM идет напрямую через ar_LLMДиспетчер.Вызвать,
// без ar_RuntimeЦикл.ВыполнитьАгента/ar_RuntimeЗапуск.Стартовать* - надзор не
// может запустить новый агентный цикл.
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь. Запись
// событий/вердикта, а также чтение и запись счётчика потолка и отпечатка
// прохода (CONS-11) делегируются привилегированному фасаду
// ar_AuditЗащищённыйРежим, как это уже сделано в ar_RuntimeЦикл.
//
// CONS-11 (детекция отсутствия прогресса, §3.3): расширяет модуль функцией
// РешитьПродолжатьЛи - вызывается ПОСЛЕ ПроверитьДостижениеЦели, когда та
// вернула "Продолжить", и решает, можно ли физически продолжить цикл тем же
// RunId (три независимых слоя - бюджет / result-aware отпечаток прохода /
// потолок 10 продолжений) или нужно эскалировать.
//
// БЕЗОПАСНЫЙ DEFAULT ПРИ СБОЕ ДЕТЕКТОРА (D10) - в ЭТУ сторону, а НЕ как D7
// выше: при сбое слоёв 1/2 default - ПРОДОЛЖАТЬ (Продолжать = Истина), не
// эскалировать и не останавливать. Обоснование (спека, «Риски», «Какая ошибка
// дороже»): ложный стоп ТЕРМИНАЛЕН и необратим - эскалация останавливает
// агента навсегда, автопопыток больше нет (решение 8). Ложное продолжение
// ограничено потолком 10 (слой 3) и стоит только денег на лишние LLM-вызовы.
// Поэтому единственный слой, которому разрешено остановить цикл при сбое
// СВОЕЙ проверки, - слой 3 (потолок): его чтение/инкремент выполняются
// НЕЗАВИСИМО от слоёв 1/2 и ДО них (см. РешитьПродолжатьЛиВнутр) - иначе
// систематический отказ слоёв 1/2 (например, регистр ar_ДействияАгента
// стабильно недоступен) обходил бы предохранитель и давал бесконечный цикл.
//
// См. спеку: .docs/specs/CONS-10.md, .docs/specs/CONS-11.md,
// План-консоль-автономных-агентов.md §3.1, §3.2, §3.3, §3.4.
////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить, действительно ли агент достиг цели своего запуска (CONS-10,
// Plan §3.2, §3.4). Вызывается ИСКЛЮЧИТЕЛЬНО из ar_RuntimeЦикл.ВыполнитьАгентаВнутр
// в двух точках - ветка run_completed и ветка max_steps_reached, ПЕРЕД вызовом
// ЗавершитьЗапуск. Не вызывается для Cancelled/DeniedGlobally/PausedForApproval/
// PausedForInput/FailedIncompatibleState/Failed - для этих статусов нет
// финального текстового ответа, который можно классифицировать.
//
// КОНТРАКТ БЕЗОПАСНОСТИ (важнее самой логики надзора, D7): функция НЕ
// пробрасывает исключения наружу ни при каких обстоятельствах - недоступность
// LLM, некорректный JSON, любая ошибка внутри классификации перехватывается
// и превращается в вердикт "Продолжить" (безопасный default: не выдаем
// ложноположительный "ЦельДостигнута" при сбое надзора, но и не роняем
// запуск). Надзор врезан в ОБЩИЙ путь завершения цикла - любой необработанный
// сбой здесь заденет каждый штатный запуск расширения.
//
// Рекурсия: функция обращается к LLM ТОЛЬКО напрямую через
// ar_LLMДиспетчер.Вызвать - не вызывает ar_RuntimeЦикл.ВыполнитьАгента и не
// планирует новых запусков (RunId) ни в одной ветке.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения (см.
//                     ar_RuntimeЦикл, шапка модуля); читаются Результат,
//                     Сообщения, ИнструкцияДобавка.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента):
//                     Ссылка, Инструкция, LLMПровайдер, Модель.
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//  ДоступныеИнструменты - Массив, Неопределено - состав доступных инструментов
//                     запуска с уровнями риска (agentrunner-107, п.5; элементы
//                     Структура {Имя, Риск}, источник - ar_RuntimeЦикл,
//                     ИнструментыСУровнямиРиска). Неопределено - состав
//                     неизвестен, дешевая проверка ведет себя как раньше.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора ("ЦельДостигнута"/"Продолжить"/
//  "Эскалировать"). При любом внутреннем сбое - "Продолжить".
//
Функция ПроверитьДостижениеЦели(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера,
	Знач ДоступныеИнструменты = Неопределено) Экспорт

	Попытка
		Возврат ПроверитьДостижениеЦелиВнутр(RunId, Состояние, ДанныеАгента, КонтекстТриггера,
			ДоступныеИнструменты);
	Исключение
		// D7: сбой надзора не должен уронить запуск и не должен пролезть наружу.
		// Best-effort лог, best-effort событие - обе попытки в собственных Try,
		// чтобы даже ошибка логирования не сломала контракт "не бросать наружу".
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_failed",
				"Сбой надзора, вердикт по умолчанию Продолжить. " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			// Проглатываем - логирование не является критичным путем, но пишем
			// в системный журнал как последний рубеж диагностики.
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать supervisor_failed в ar_СлужебныйЛог");
		КонецПопытки;

		Возврат "Продолжить";
	КонецПопытки;

КонецФункции

// CONS-11: три слоя детекции отсутствия прогресса. Вызывается ИСКЛЮЧИТЕЛЬНО
// из ar_RuntimeЦикл.ВыполнитьАгентаВнутр, ветка run_completed, СРАЗУ после
// ПроверитьДостижениеЦели, и только если та вернула "Продолжить" (для
// max_steps_reached слои 2/3 не применяются - см. .docs/specs/CONS-11.md,
// «Точка вызова трёх слоёв»; ar_RuntimeЦикл сам решает budget-эскалацию через
// ЗафиксироватьЭскалациюБюджета в этой ветке).
//
// Порядок (дешёвое сначала): 1) бюджет (ШаговВсего/ДействийВсего накопительно
// за RunId, не продлевается) 2) result-aware отпечаток прохода (2 подряд без
// изменений → эскалация) 3) потолок 10 продолжений (предохранитель,
// независимый от 1/2).
//
// БЕЗОПАСНОСТЬ (D10) - ВАЖНО, направление default ОБРАТНОЕ по сравнению с D7
// ar_Надзор.ПроверитьДостижениеЦели: при сбое слоёв 1 (бюджет) или 2
// (отпечаток) безопасный default - ПРОДОЛЖАТЬ (Продолжать = Истина), вердикт
// НЕ переписывается на "Эскалировать". Обоснование (спека, «Риски», «Какая
// ошибка дороже»): ложный стоп терминален и необратим (эскалация = остановка
// агента навсегда, решение 8), а ложное продолжение ограничено сверху
// потолком 10 (слой 3) и стоит лишь денег на лишние LLM-вызовы - это дешевле,
// чем оборвать честный многопроходный запуск на случайном транзиентном сбое.
// Единственное исключение - сбой САМОГО слоя 3 (не удалось прочитать/
// инкрементировать счётчик потолка): это единственный случай, когда функция
// возвращает Продолжать = Ложь, потому что тогда не остаётся вообще никакой
// защиты от бесконечного цикла. Чтение и инкремент счётчика потолка выполняются
// ДО слоёв 1/2 (см. РешитьПродолжатьЛиВнутр) и в собственном защищённом блоке -
// именно поэтому потолок остаётся жёстким пределом независимо от того,
// упадёт ли остальная логика детекции. Исключение НЕ пробрасывается наружу ни
// при каких обстоятельствах.
//
// Параметры:
//  RunId        - Строка(36) - идентификатор запуска.
//  Состояние    - Структура - состояние цикла на момент run_completed (читаются
//                 ШаговВсего, ДействийВсего, ДействийВсегоНаНачалоПрохода,
//                 Результат).
//  ДанныеАгента - Структура - данные агента (МаксШагов/МаксДействий читаются
//                 из ДанныеАгента.Ссылка при непустой ссылке; для БезАгента-
//                 режима бюджет считается неограниченным - см. «Риски»).
//  Вердикт      - Строка - вердикт ar_Надзор.ПроверитьДостижениеЦели ("Продолжить"
//                 ожидается вызывающим кодом; иные значения возвращают
//                 Продолжать=Ложь без изменения ВердиктДляЗаписи).
//
// Возвращаемое значение:
//  Структура {
//    Продолжать      - Булево - Истина, если ни один из трёх слоёв не
//                       остановил цикл (в т.ч. при сбое слоёв 1/2 - см.
//                       БЕЗОПАСНОСТЬ выше, D10).
//    ВердиктДляЗаписи - Строка - Вердикт как есть, либо "Эскалировать", если
//                       сработал слой 2 или 3.
//  }
//
Функция РешитьПродолжатьЛи(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач Вердикт) Экспорт

	РезультатНеПродолжать = Новый Структура;
	РезультатНеПродолжать.Вставить("Продолжать", Ложь);
	РезультатНеПродолжать.Вставить("ВердиктДляЗаписи", Вердикт);

	Если Вердикт <> "Продолжить" Тогда
		Возврат РезультатНеПродолжать;
	КонецЕсли;

	// D10: default при сбое слоёв 1/2 - ПРОДОЛЖАТЬ (см. doc-комментарий выше и
	// шапку модуля). РезультатПриСбоеДетектора используется ТОЛЬКО катч-блоком
	// ниже - не путать с РезультатНеПродолжать (тот - для Вердикт <> "Продолжить",
	// не про сбой).
	РезультатПриСбоеДетектора = Новый Структура;
	РезультатПриСбоеДетектора.Вставить("Продолжать", Истина);
	РезультатПриСбоеДетектора.Вставить("ВердиктДляЗаписи", Вердикт);

	Попытка
		Возврат РешитьПродолжатьЛиВнутр(RunId, Состояние, ДанныеАгента, Вердикт);
	Исключение
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;
		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.РешитьПродолжатьЛи", "continuation_check_failed",
				"Сбой детекции прогресса (слой 1/2), продолжение ВЫПОЛНЯЕТСЯ "
					+ "(безопасный default D10 - ложный стоп терминален, "
					+ "ложное продолжение ограничено потолком слоя 3). " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать continuation_check_failed в ar_СлужебныйЛог");
		КонецПопытки;
		Возврат РезультатПриСбоеДетектора;
	КонецПопытки;

КонецФункции

// CONS-11: зафиксировать эскалацию по бюджету (слой 1) для ветки
// max_steps_reached, где сама достижимость этой точки уже означает
// исчерпание накопительного лимита ШаговВсего/ДействийВсего. Вызывается
// ar_RuntimeЦикл напрямую (не через РешитьПродолжатьЛи - там нет ветвления по
// причине, только Продолжать/не Продолжать для run_completed).
//
// agentrunner-54: с передачей Состояния и ДанныеАгента payload события
// НадзорРешение пополняется цифрами (steps/max_steps/actions/max_actions/limit,
// протокол - см. ЗафиксироватьЭскалацию). На этот момент ar_ШаговВсего в
// ar_Запуски ещё 0 (пишется только ЗавершитьЗапуск ниже по ветке), а письмо
// эскалации уходит раньше - поэтому цифры берутся из состояния цикла, а не из
// регистра. Оба параметра необязательны: без них payload остаётся без цифр
// (совместимость со старыми вызовами).
//
// Параметры:
//  RunId        - Строка(36) - идентификатор запуска.
//  Состояние    - Структура, Неопределено - состояние цикла (читаются
//                 ШаговВсего, ДействийВсего).
//  ДанныеАгента - Структура, Неопределено - данные агента (читаются
//                 МаксШагов, МаксДействий).
//
// Возвращаемое значение:
//  Строка - "Эскалировать" (всегда - вызывается только когда исходный вердикт
//  уже "Продолжить" и ветка max_steps_reached достигнута).
//
Функция ЗафиксироватьЭскалациюБюджета(Знач RunId, Знач Состояние = Неопределено,
	Знач ДанныеАгента = Неопределено) Экспорт

	Попытка
		// Сбор цифр - через безопасные ЗначениеЧисло/ЗначениеБюджета (проверка
		// типов, 0 при сбое чтения): исключений не даёт, при сбое - эскалация
		// без цифр (D7/D10 best-effort).
		ШаговВсего = ЗначениеЧисло(Состояние, "ШаговВсего");
		ДействийВсего = ЗначениеЧисло(Состояние, "ДействийВсего");
		МаксШагов = ЗначениеБюджета(ДанныеАгента, "МаксШагов");
		МаксДействий = ЗначениеБюджета(ДанныеАгента, "МаксДействий");
		Цифры = ЦифрыРешения(Состояние, ДанныеАгента, 0,
			ИсчерпанныйЛимитБюджета(МаксШагов, ШаговВсего, МаксДействий, ДействийВсего));
		ЗафиксироватьЭскалацию(RunId, "budget", Цифры);
	Исключение
		// Best-effort - см. D7/D10: сбой записи причины эскалации не должен
		// помешать основному статусу запуска остаться MaxStepsReached.
		ar_СлужебныйЛог.Записать("ar_Надзор.ЗафиксироватьЭскалациюБюджета", "escalation_log_failed",
			"Не удалось зафиксировать событие эскалации бюджета", "Ошибка", RunId);
	КонецПопытки;

	Возврат "Эскалировать";

КонецФункции

// Текст расширенного промпта продолжения (agentrunner-68, спека Б.4) -
// экспортно для ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора, который добавляет
// его role=user с признаком ar_СлужебноеНадзора. Вместо общей фразы «цель ещё
// не достигнута» агент получает: цель (текущий запрос), что не сделано по
// оценке надзора, выполненные действия с их итогом, план, доступные
// инструменты с отметкой неиспользованных и указание о пересмотре подхода.
//
// Каждый блок добавляется только при наличии данных; длинные блоки усекаются
// с пометкой; суммарный объем - до 4000 символов (лимит спеки).
//
// Параметры:
//  RunId                - Строка(36) - идентификатор запуска.
//  Состояние            - Структура - состояние цикла (Результат, Сообщения,
//                         План, ПоследнееНеСделано, ПредложитьСменуПодхода).
//  ДанныеАгента         - Структура - данные агента (Инструкция, Модель).
//  КонтекстТриггера     - Структура, Неопределено - контекст текущего триггера
//                         ({Триггер = "supervisor_continue"}).
//  ДоступныеИнструменты - Массив, Неопределено - имена инструментов запуска
//                         (из tool_definitions последнего шага); пусто/не
//                         Массив - блок инструментов не добавляется.
//
// Возвращаемое значение:
//  Строка - текст user-сообщения продолжения.
//
Функция ТекстПродолженияНадзора(Знач RunId, Знач Состояние, Знач ДанныеАгента,
	Знач КонтекстТриггера, Знач ДоступныеИнструменты = Неопределено) Экспорт

	Триггер = "supervisor_continue";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", Триггер);
	КонецЕсли;
	Цель = СформироватьЦель(Триггер, Состояние, ДанныеАгента);

	Блоки = Новый Массив;

	Заголовок = НСтр("ru = 'Надзор: цель ещё не достигнута'; en = 'Supervision: the goal is not achieved yet'");
	Блоки.Добавить(Заголовок + Символы.ПС + УсечьТекст(Цель, ЛимитЦелиПромпта()));

	НеСделано = ЗначениеСтрока(Состояние, "ПоследнееНеСделано");
	Если Не ПустаяСтрока(НеСделано) Тогда
		Блоки.Добавить(СтрШаблон(
			НСтр("ru = 'Не сделано по оценке надзора: %1'; en = 'Not done per supervision: %1'"),
			УсечьТекст(НеСделано, ЛимитБлокаПромпта())));
	КонецЕсли;

	Действия = ВыбратьДействияЗапуска(RunId);
	БлокДействий = БлокДействийПромпта(Действия);
	Если Не ПустаяСтрока(БлокДействий) Тогда
		Блоки.Добавить(БлокДействий);
		ВызванныеИнструменты = ИменаВызванныхИнструментов(Действия);
	Иначе
		ВызванныеИнструменты = Новый Соответствие;
	КонецЕсли;

	План = Неопределено;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("План", План);
	КонецЕсли;
	БлокПлана = БлокПланаПромпта(План);
	Если Не ПустаяСтрока(БлокПлана) Тогда
		Блоки.Добавить(БлокПлана);
	КонецЕсли;

	БлокИнструментов = БлокИнструментовПромпта(ДоступныеИнструменты, ВызванныеИнструменты);
	Если Не ПустаяСтрока(БлокИнструментов) Тогда
		Блоки.Добавить(БлокИнструментов);
	КонецЕсли;

	Если ЗначениеБулево(Состояние, "ПредложитьСменуПодхода") Тогда
		Блоки.Добавить(НСтр("ru = 'Ты повторил тот же ответ. Пересмотри цель и инструменты,
			|которые ещё не вызывал; попробуй другой подход. Если цель недостижима -
			|объясни это в итоговом ответе, сославшись на результаты вызовов.';
			|en = 'You repeated the same answer. Review the goal and the tools you
			|have not called yet; try a different approach. If the goal is
			|unachievable - explain that in your final answer, referencing the
			|call results.'"));
	КонецЕсли;

	Блоки.Добавить(НСтр("ru = 'Сверь цель, текущее состояние и инструменты; выполни
		|недостающие действия; если цель недостижима - дай итоговый ответ с
		|причиной и подтверждением фактами вызовов; не повторяй вызовы с теми же
		|аргументами.';
		|en = 'Compare the goal, the current state and the tools; perform the
		|missing actions; if the goal is unachievable - give a final answer with
		|the reason and facts of the calls; do not repeat calls with the same
		|arguments.'"));

	Возврат УсечьТекст(СтрСоединить(Блоки, Символы.ПС + Символы.ПС), ЛимитПромптаПродолжения());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика без внешнего перехвата исключений (он в ПроверитьДостижениеЦели).
//
// agentrunner-68: цель берется по текущему запросу (СформироватьЦель), ответ
// надзора несет класс/причину/missing (РазобратьОтветНадзора), payload событий
// и служебный лог пополняются деталями решения (pass/actions/source/class/
// reason/missing/model/tokens/duration/answer/messages), а при вердикте
// "Продолжить" текст missing (или причина дешевой проверки) кладется в
// Состояние.ПоследнееНеСделано - его читает ТекстПродолженияНадзора.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента).
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора.
//
Функция ПроверитьДостижениеЦелиВнутр(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера,
	Знач ДоступныеИнструменты = Неопределено)

	ФинальныйОтвет = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("Результат", ФинальныйОтвет);
	КонецЕсли;
	ФинальныйОтвет = ?(ТипЗнч(ФинальныйОтвет) = Тип("Строка"), ФинальныйОтвет, "");

	Триггер = "manual";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", Триггер);
	КонецЕсли;

	// agentrunner-68: номер прохода - продолжений сделано на момент вердикта
	// плюс один (инкремент слоя 3 происходит позже, в РешитьПродолжатьЛиВнутр);
	// действий в проходе - от границы прохода до ДействийВсего.
	ПродолженийСделано = ar_AuditЗащищённыйРежим.ПрочитатьПродолженийСделаноПривилегированно(RunId);
	Проход = ПродолженийСделано + 1;
	ДействийНаКонецПрохода = ЗначениеЧисло(Состояние, "ДействийВсего")
		- ЗначениеЧисло(Состояние, "ДействийВсегоНаНачалоПрохода");
	ДействийВПроходе = Макс(ДействийНаКонецПрохода, 0);

	PayloadInvoked = Новый Структура;
	PayloadInvoked.Вставить("code", "supervisor_invoked");
	PayloadInvoked.Вставить("trigger", Триггер);
	PayloadInvoked.Вставить("pass", Проход);
	PayloadInvoked.Вставить("actions", ДействийВПроходе);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "НадзорВызван", PayloadInvoked);

	// Список фактически выполненных действий за RunId - тот же запрос-образец,
	// что уже используется формой ar_ПросмотрЗапуска для секции «Созданные
	// объекты 1С» (см. .docs/specs/CONS-10.md, «Платформенные API и БСП»).
	Действия = ВыбратьДействияЗапуска(RunId);

	// Цель вычисляется до дешевой проверки - она нужна и служебному логу
	// (supervisor_invoked, длина цели), и сводке LLM ниже; вычисление -
	// только чтение Состояния/ДанныеАгента, без запросов.
	Цель = СформироватьЦель(Триггер, Состояние, ДанныеАгента);

	ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_invoked",
		СтрШаблон("Проход=%1; Триггер=%2; ДействийВПроходе=%3; ДлинаЦели=%4",
			Формат(Проход, "ЧН=0; ЧГ=0"), Триггер, Формат(ДействийВПроходе, "ЧН=0; ЧГ=0"),
			Формат(СтрДлина(Цель), "ЧН=0; ЧГ=0")),
		, RunId);

	// 1. Дешевая проверка без LLM (D4) - строго ДО обращения к LLM.
	// agentrunner-107 (п.5): заявление о создании/изменении ищется в ТЕКСТЕ
	// ЦЕЛИ (СформироватьЦель), а не в ответе модели (пересказ ошибки модели
	// содержал «сформирован» и ложно включал проверку, лог e5697560), и
	// дополнительно требуется наличие мутирующего инструмента среди доступных.
	ДешеваяПроверка = ПроверитьБезLLM(Цель, Действия, ДоступныеИнструменты);
	Если ДешеваяПроверка.Сработала Тогда
		Вердикт = "Продолжить";
		// agentrunner-68: причина дешевой проверки - в Состояние (для текста
		// продолжения) и в payload события НадзорРешение (source = cheap_check).
		ЗаписатьВСостояние(Состояние, "ПоследнееНеСделано", ПричинаДешевойПроверки());
		ДанныеРешения = НовоеРешениеНадзора(Вердикт, "cheap_check");
		ДанныеРешения.Причина = ПричинаДешевойПроверки();
		ЗафиксироватьРешение(RunId, ДанныеРешения);
		ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_cheap_check",
			СтрШаблон("Сработала=да; Вердикт=%1; %2", Вердикт, ПричинаДешевойПроверки()), , RunId);
		Возврат Вердикт;
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_cheap_check",
		"Сработала=нет; Вердикт=не определен (дешевая проверка пропущена)", , RunId);

	// 2. Обращение к LLM с отдельным, изолированным контекстом (D5, D6).
	План = Неопределено;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("План", План);
	КонецЕсли;
	ОтветПредыдущего = ЗначениеСтрока(Состояние, "ОтветПредыдущегоПрохода");
	Сводка = СформироватьСводку(Цель, ФинальныйОтвет, Действия, План, ОтветПредыдущего);

	Контекст = Новый Структура;
	Контекст.Вставить("Сообщения", Новый Массив);
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольSystem(), СистемныйПромптНадзора()));
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), Сводка));
	Контекст.Вставить("Провайдер", ДанныеАгента.LLMПровайдер);
	// RunId в контексте: диспетчер кладет его в параметры провайдера, служебный
	// лог вызова LLM (debug_*) привязывается к этому запуску - без него записи
	// надзора попадают в логи чужих запусков как записи без RunId.
	Контекст.Вставить("RunId", RunId);
	МодельАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Модель", МодельАгента);
	КонецЕсли;
	МодельАгентаЗадана = (ТипЗнч(МодельАгента) = Тип("Строка") И Не ПустаяСтрока(МодельАгента));
	Если МодельАгентаЗадана Тогда
		Контекст.Вставить("Модель", МодельАгента);
	КонецЕсли;

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтветLLM = ar_LLMДиспетчер.Вызвать(Контекст);
	ДлительностьМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

	// agentrunner-68: разбор ответа возвращает не только вердикт, но и класс,
	// причину и missing - все они попадают в payload события и служебный лог.
	Разбор = РазобратьОтветНадзора(ОтветLLM);
	ДанныеРешения = НовоеРешениеНадзора(Разбор.Вердикт, "llm");
	ДанныеРешения.Класс = Разбор.Класс;
	ДанныеРешения.Причина = Разбор.Причина;
	ДанныеРешения.НеСделано = Разбор.НеСделано;
	ДанныеРешения.Модель = ?(МодельАгентаЗадана, МодельАгента, "");
	ДанныеРешения.ТокеновВход = ЧислоПоКлючу(ОтветLLM, "ТокеновВход");
	ДанныеРешения.ТокеновВыход = ЧислоПоКлючу(ОтветLLM, "ТокеновВыход");
	ДанныеРешения.ДлительностьМС = ДлительностьМС;
	ДанныеРешения.Ответ = Разбор.ОтветТекст;
	ДанныеРешения.СообщенияВызова = Контекст.Сообщения;
	ЗафиксироватьРешение(RunId, ДанныеРешения);

	ТекстЛогаЛЛМ = СтрШаблон("Модель=%1; Класс=%2; Причина=%3; НеСделано=%4; ДлительностьМС=%5; ТокеныВ=%6; ТокеныИз=%7",
		ДанныеРешения.Модель, Разбор.Класс, Разбор.Причина, Разбор.НеСделано,
		Формат(ДлительностьМС, "ЧН=0; ЧГ=0"), Формат(ДанныеРешения.ТокеновВход, "ЧН=0; ЧГ=0"),
		Формат(ДанныеРешения.ТокеновВыход, "ЧН=0; ЧГ=0"));
	Если Разбор.Вердикт = "Продолжить" И ПустаяСтрока(Разбор.Класс) Тогда
		// Сбой разбора ответа (мусор вместо JSON или недоступность LLM) -
		// Предупреждение с началом сырого ответа для диагностики.
		// Сбой самого вызова - текст ошибки диспетчера (ответа модели нет).
		ОшибкаВызова = "";
		Если ТипЗнч(ОтветLLM) = Тип("Структура") Тогда
			ОтветLLM.Свойство("Ошибка", ОшибкаВызова);
		КонецЕсли;
		ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_llm",
			"Сбой разбора: " + Лев(ar_Утилиты.МаскироватьСекреты(Разбор.ОтветТекст), ЛимитСбоеЛога())
				+ "; ОшибкаВызова=" + Лев(Строка(ОшибкаВызова), ЛимитСбоеЛога()),
			"Предупреждение", RunId);
	Иначе
		ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_llm",
			ТекстЛогаЛЛМ + "; " + ar_Утилиты.МаскироватьСекреты(Разбор.ОтветТекст), , RunId);
	КонецЕсли;

	Если Разбор.Вердикт = "Продолжить" Тогда
		// agentrunner-68: что конкретно не сделано - в Состояние для текста
		// продолжения (ТекстПродолженияНадзора); пусто - продолжение без блока.
		ЗаписатьВСостояние(Состояние, "ПоследнееНеСделано", Разбор.НеСделано);
	КонецЕсли;

	Возврат Разбор.Вердикт;

КонецФункции

// Дешевая проверка без обращения к LLM (D4): отсекает очевидный случай, когда
// цель текстуально заявляет о созданном/измененном объекте, но ни одно
// действие с мутирующим RiskLevel (Draft/Write/Commit) не завершилось
// непустым ar_СсылкаНаРезультат - фактически ничего не создано/не изменено.
//
// agentrunner-107 (п.5) - проверка срабатывает только при ОБОИХ условиях:
//  (а) текст заявления содержит ключевые слова создания/изменения (та же
//      эвристика ТекстЗаявляетОСозданномОбъекте; дешевая проверка передает
//      текст цели из СформироватьЦель - цель-чтение «вызови и процитируй JSON»
//      проверку выключает);
//  (б) среди доступных инструментов запуска есть мутирующие (Черновик/
//      Запись/Фиксация). Состав не передан (Неопределено) - условие считается
//      выполненным (прежнее поведение); передан пустой список - проверка
//      выключена.
//
// Параметры:
//  ТекстЗаявления        - Строка - текст заявления (цель запуска либо ответ
//                          агента - см. точки вызова).
//  Действия              - ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef
//                          (см. ВыбратьДействияЗапуска).
//  ДоступныеИнструменты  - Массив, Неопределено - состав доступных инструментов
//                          {Имя, Риск} (agentrunner-107, п.5).
//
// Возвращаемое значение:
//  Структура {Сработала - Булево} - Истина, если дешевая проверка дала
//  однозначное «не выполнено» без обращения к LLM.
//
Функция ПроверитьБезLLM(Знач ТекстЗаявления, Знач Действия, Знач ДоступныеИнструменты = Неопределено)

	Результат = Новый Структура("Сработала", Ложь);

	Если Не ТекстЗаявляетОСозданномОбъекте(ТекстЗаявления) Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЕстьМутирующиеИнструменты(ДоступныеИнструменты) Тогда
		Возврат Результат;
	КонецЕсли;

	// Есть хотя бы одно мутирующее действие с непустым ResultRef -
	// заявление правдоподобно, дешевая проверка не отсекает без LLM.
	ЕстьМутирующийРезультат = Ложь;
	Для Каждого СтрокаДействия Из Действия Цикл
		RiskLevelИмя = "";
		Если ЗначениеЗаполнено(СтрокаДействия.RiskLevel) Тогда
			RiskLevelИмя = Строка(СтрокаДействия.RiskLevel);
		КонецЕсли;
		RiskLevelМутирующий = (RiskLevelИмя = "Черновик" ИЛИ RiskLevelИмя = "Запись" ИЛИ RiskLevelИмя = "Фиксация");
		РезультатПолучен = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		Если RiskLevelМутирующий И РезультатПолучен Тогда
			ЕстьМутирующийРезультат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьМутирующийРезультат Тогда
		Результат.Сработала = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Есть ли среди доступных инструментов запуска мутирующие (agentrunner-107,
// п.5): уровень риска Черновик/Запись/Фиксация. Состав не передан
// (Неопределено) - Истина: неизвестный состав не выключает проверку,
// вызовы без параметра сохраняют прежнее поведение (слой 2а).
//
// Параметры:
//  ДоступныеИнструменты - Массив, Неопределено - состав доступных инструментов
//                         {Имя: Строка, Риск: Строка}.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьМутирующиеИнструменты(Знач ДоступныеИнструменты)

	Если ДоступныеИнструменты = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ДоступныеИнструменты) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Инструмент Из ДоступныеИнструменты Цикл
		Если ТипЗнч(Инструмент) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Риск = "";
		Инструмент.Свойство("Риск", Риск);
		Если Риск = "Черновик" ИЛИ Риск = "Запись" ИЛИ Риск = "Фиксация" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Эвристика: содержит ли текст финального ответа ключевые слова о созданном/
// измененном объекте (§3.2 контракта завершения, D4).
//
// Параметры:
//  Текст - Строка - итоговый текст ответа агента.
//
// Возвращаемое значение:
//  Булево - Истина, если текст содержит ключевое слово о созданном объекте.
//
Функция ТекстЗаявляетОСозданномОбъекте(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстНижнийРегистр = НРег(Текст);

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("создал");
	КлючевыеСлова.Добавить("создан");
	КлючевыеСлова.Добавить("создано");
	КлючевыеСлова.Добавить("оформил");
	КлючевыеСлова.Добавить("оформлен");
	КлючевыеСлова.Добавить("записал");
	КлючевыеСлова.Добавить("записан");
	КлючевыеСлова.Добавить("сформировал");
	КлючевыеСлова.Добавить("сформирован");
	КлючевыеСлова.Добавить("добавил");
	КлючевыеСлова.Добавить("добавлен");
	КлючевыеСлова.Добавить("created");
	КлючевыеСлова.Добавить("added");
	КлючевыеСлова.Добавить("generated");
	КлючевыеСлова.Добавить("recorded");

	Для Каждого Слово Из КлючевыеСлова Цикл
		Если СтрНайти(ТекстНижнийРегистр, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Выбрать действия текущего запуска - имя tool, уровень риска, ResultRef,
// признак завершения с ошибкой (agentrunner-68: различие «результат получен /
// ошибка» в сводке и тексте продолжения).
// Паттерн запроса - CommonForms/ar_ПросмотрЗапуска/Ext/Form/Module.bsl,
// процедура ЗаполнитьСозданныеОбъекты (CONS-06 D1).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef, ЗавершенСОшибкой.
//
Функция ВыбратьДействияЗапуска(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяИнструмента КАК ИмяTool,
	|	Действия.ar_УровеньРиска КАК RiskLevel,
	|	Действия.ar_СсылкаНаРезультат КАК ResultRef,
	|	Действия.ar_ЗавершёнСОшибкой КАК ЗавершенСОшибкой
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &RunId
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Последовательность";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Источник формулировки цели (см. .docs/specs/CONS-10.md, «Источник формулировки
// цели», решение аналитика - переопределяет буквальную формулировку задачи).
//
// agentrunner-68 (спека Б.1): для ручных триггеров и продолжения надзора цель -
// ПОСЛЕДНЕЕ сообщение с признаком ar_ЗапросЗапуска в Состояние.Сообщения, а не
// первое user-сообщение: в чате первым подмешивается история сессии, т.е. самый
// старый вопрос диалога, а надзор должен оценивать ответ на текущий запрос.
// Проход продолжения (supervisor_continue) и возобновление оценивают цель по
// исходному триггеру запуска (Состояние.ИсходныйТриггер): у запусков по
// расписанию/очереди цель остается инструкцией агента (исправлено на приемке).
//
// Параметры:
//  Триггер      - Строка - код триггера запуска ("manual"/"cron"/... ).
//  Состояние    - Структура - состояние цикла (используется ИнструкцияДобавка).
//  ДанныеАгента - Структура - данные агента (используется Инструкция).
//
// Возвращаемое значение:
//  Строка - формулировка цели для надзорного вызова LLM.
//
Функция СформироватьЦель(Знач Триггер, Знач Состояние, Знач ДанныеАгента)

	ТриггерЦели = ЗначениеСтрока(Состояние, "ИсходныйТриггер");
	Если ПустаяСтрока(ТриггерЦели) Тогда
		ТриггерЦели = Триггер;
	КонецЕсли;

	Если ТриггерЦели = "manual" ИЛИ СтрНайти(ТриггерЦели, "manual_chat") = 1 Тогда

		ЦельПоЗапросу = ПоследнееСообщениеЗапросаЗапуска(Состояние);
		Если Не ПустаяСтрока(ЦельПоЗапросу) Тогда
			Возврат ЦельПоЗапросу;
		КонецЕсли;
		// Запрос с признаком не найден (старые запуски до agentrunner-65) -
		// прежнее правило: первое user-сообщение.
		Возврат ПервоеСообщениеПользователя(Состояние);
	КонецЕсли;

	// cron/schedule, subscription/webhook, mention (рутина-триггер) - та же
	// комбинация, что видел агент в промпте: инструкция агента + (если
	// непусто) добавка рутины, уже посчитанная в Состояние.ИнструкцияДобавка.
	ИнструкцияАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Инструкция", ИнструкцияАгента);
	КонецЕсли;
	ИнструкцияАгента = ?(ТипЗнч(ИнструкцияАгента) = Тип("Строка"), ИнструкцияАгента, "");

	ИнструкцияДобавка = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;
	ИнструкцияДобавка = ?(ТипЗнч(ИнструкцияДобавка) = Тип("Строка"), ИнструкцияДобавка, "");

	Цель = СокрЛП(ИнструкцияАгента);
	Если Не ПустаяСтрока(ИнструкцияДобавка) Тогда
		Цель = Цель + Символы.ПС + Символы.ПС + СокрЛП(ИнструкцияДобавка);
	КонецЕсли;

	// Данных агента нет (текст продолжения строится без них) - цель по
	// стартовому сообщению запуска.
	Если ПустаяСтрока(Цель) Тогда
		Цель = ПоследнееСообщениеЗапросаЗапуска(Состояние);
	КонецЕсли;

	Возврат Цель;

КонецФункции

// Первое сообщение role=user в Состояние.Сообщения - исходный запрос
// пользователя (manual/manual_chat*).
//
// Параметры:
//  Состояние - Структура - состояние цикла (используется Сообщения).
//
// Возвращаемое значение:
//  Строка - текст первого пользовательского сообщения либо пустая строка.
//
Функция ПервоеСообщениеПользователя(Знач Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Сообщения = Неопределено;
	Если Не Состояние.Свойство("Сообщения", Сообщения) ИЛИ ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Роль = "";
		Сообщение.Свойство("role", Роль);
		Если Роль = ar_LLMКонтракт.РольUser() Тогда
			Содержание = "";
			Сообщение.Свойство("content", Содержание);
			Возврат ?(ТипЗнч(Содержание) = Тип("Строка"), Содержание, "");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Последнее сообщение с признаком ar_ЗапросЗапуска в Состояние.Сообщения -
// текущий запрос пользователя (agentrunner-68, спека Б.1; признак ставит
// ar_RuntimeЦикл.НовоеСообщениеЗапросаЗапуска). Обход с конца: в чате после
// запроса идут служебные user-сообщения (продолжение надзора) - первое с
// конца, имеющее признак, и есть актуальный запрос.
//
// Параметры:
//  Состояние - Структура - состояние цикла (используется Сообщения).
//
// Возвращаемое значение:
//  Строка - текст запроса либо пустая строка, если сообщения с признаком нет.
//
Функция ПоследнееСообщениеЗапросаЗапуска(Знач Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Сообщения = Неопределено;
	Если Не Состояние.Свойство("Сообщения", Сообщения) ИЛИ ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Номер = Сообщения.Количество() - 1;
	Пока Номер >= 0 Цикл
		Сообщение = Сообщения[Номер];
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Номер = Номер - 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеБулево(Сообщение, "ar_ЗапросЗапуска") Тогда
			Номер = Номер - 1;
			Продолжить;
		КонецЕсли;
		Содержание = "";
		Сообщение.Свойство("content", Содержание);
		Возврат ?(ТипЗнч(Содержание) = Тип("Строка"), Содержание, "");
	КонецЦикла;

	Возврат "";

КонецФункции

// Системный промпт надзора (решение 9) - отдельный от системного промпта
// основного агента, не читается из ar_Агенты.
//
// agentrunner-68 (спека Б.2): класс "выполнено" явно включает обоснованный
// отрицательный результат (агент выполнил поиск/проверку, действия дали
// результат, ответ сообщает, что искомого нет или задачу выполнить нельзя
// по существу, с причиной); для "не_выполнено" модель обязана вернуть поле
// missing - что конкретно не сделано или не подтверждено (одно-два
// предложения). Отображение классов в вердикты - см. РазобратьОтветНадзора;
// правило «расплывчатый ответ / намерение без результата / расхождение
// заявленного и сделанного - не_выполнено» сохранено.
//
// Возвращаемое значение:
//  Строка - текст системного промпта надзорного LLM-вызова.
//
Функция СистемныйПромптНадзора()

	Возврат НСтр("ru = 'Ты - модуль надзора AgentRunner. Тебе дана цель, которую
		|должен был выполнить AI-агент, его финальный текстовый ответ, список
		|фактически выполненных действий (инструмент + признак, был ли получен
		|результат) и ответ агента на предыдущем проходе, если продолжений было
		|несколько. Классифицируй исход СТРОГО одним JSON-объектом без пояснений
		|снаружи JSON: {""class"": ""выполнено""} - цель полностью достигнута
		|фактическими действиями или ответом, В ТОМ ЧИСЛЕ обоснованный
		|отрицательный результат: агент выполнил поиск или проверку, действия
		|дали результат, а ответ сообщает, что искомого нет или задачу выполнить
		|нельзя по существу, с указанием причины; {""class"": ""нечего_делать"",
		|""reason"": ""<причина>""} - агент обоснованно определил, что действие
		|не требовалось; {""class"": ""не_выполнено"", ""missing"": ""<что не
		|сделано>""} - во всех остальных случаях, включая расплывчатый ответ,
		|отчет о намерениях без подтвержденного результата, или явное расхождение
		|между тем, что заявлено в ответе, и тем, что реально сделано. Для
		|""не_выполнено"" поле missing обязательно: одно-два предложения о том,
		|что конкретно не сделано или не подтверждено. Не выполняй никаких
		|действий сам, не предлагай продолжение - только классификация.';
		|en = 'You are the AgentRunner supervisor module. You are given the goal
		|that an AI agent was supposed to accomplish, its final text answer, the
		|list of actions it actually performed (tool name + whether a result was
		|produced), and the agent''s answer from the previous pass, if there were
		|continuations. Classify the outcome as STRICTLY one JSON object with no
		|text outside the JSON: {""class"": ""выполнено""} - the goal was fully
		|achieved by actual actions or the answer, INCLUDING a justified negative
		|result: the agent performed the search or check, the actions produced a
		|result, and the answer reports that nothing was found or the task cannot
		|be done on the merits, with the reason; {""class"": ""нечего_делать"",
		|""reason"": ""<reason>""} - the agent correctly determined no action was
		|needed; {""class"": ""не_выполнено"", ""missing"": ""<what is not done>""}
		|- all other cases, including vague answers, reports of intent without a
		|confirmed result, or a clear mismatch between what is claimed and what
		|was actually done. For ""не_выполнено"" the missing field is mandatory:
		|one or two sentences on what exactly was not done or not confirmed. Do
		|not take any action yourself, do not propose continuation -
		|classification only.'");

КонецФункции

// Сводка для user-сообщения надзорного вызова: цель, финальный ответ,
// список действий, факт прогресса плана (если план использовался, PLAN-09),
// ответ агента на предыдущем проходе (agentrunner-68, спека Б.3 - чтобы
// надзор видел, когда агент повторяет тот же ответ).
//
// Параметры:
//  Цель                  - Строка - формулировка цели (СформироватьЦель).
//  ФинальныйОтвет        - Строка - итоговый текст ответа агента.
//  Действия              - ТаблицаЗначений - колонки ИмяTool, RiskLevel,
//                          ResultRef, ЗавершенСОшибкой (см. ВыбратьДействияЗапуска).
//  План                  - Структура, Неопределено - план текущего прохода
//                          (Состояние.План, см. ar_ПланЗапуска.НовыйПлан/Применить).
//                          Не Структура/Неопределено - строка о плане не
//                          добавляется (устойчивость к древним/битым снимкам).
//  ОтветПредыдущегоПрохода - Строка - ответ агента на предыдущем проходе
//                          (Состояние.ОтветПредыдущегоПрохода); "" на первом
//                          проходе - блок не добавляется.
//
// Возвращаемое значение:
//  Строка - текст user-сообщения для надзорного LLM-вызова.
//
Функция СформироватьСводку(Знач Цель, Знач ФинальныйОтвет, Знач Действия, Знач План,
	Знач ОтветПредыдущегоПрохода = "")

	СтрокиДействий = Новый Массив;
	Для Каждого СтрокаДействия Из Действия Цикл
		ИмяTool = Строка(СтрокаДействия.ИмяTool);
		ЕстьРезультат = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		СтрокиДействий.Добавить(ИмяTool + " -> " + ?(ЕстьРезультат, "результат получен", "результата нет"));
	КонецЦикла;

	СпособДействий = ?(СтрокиДействий.Количество() = 0,
		НСтр("ru = '(действий не было)'; en = '(no actions)'"),
		СтрСоединить(СтрокиДействий, Символы.ПС));

	ЗаголовокЦель = НСтр("ru = 'Цель:'; en = 'Goal:'");
	ЗаголовокОтвет = НСтр("ru = 'Финальный ответ агента:'; en = 'Agent final answer:'");
	ЗаголовокДействия = НСтр("ru = 'Фактически выполненные действия:'; en = 'Actually performed actions:'");

	Результат = ЗаголовокЦель + Символы.ПС + Цель + Символы.ПС + Символы.ПС
		+ ЗаголовокОтвет + Символы.ПС + ФинальныйОтвет + Символы.ПС + Символы.ПС
		+ ЗаголовокДействия + Символы.ПС + СпособДействий;

	// agentrunner-68 (спека Б.3): ответ предыдущего прохода - только если он
	// есть (первый проход - "" , блок не добавляется).
	Если Не ПустаяСтрока(ОтветПредыдущегоПрохода) Тогда
		ЗаголовокПредыдущий = НСтр("ru = 'Ответ агента на предыдущем проходе:'; en = 'Agent answer on the previous pass:'");
		Результат = Результат + Символы.ПС + Символы.ПС + ЗаголовокПредыдущий
			+ Символы.ПС + ОтветПредыдущегоПрохода;
	КонецЕсли;

	// Факт прогресса плана - только если план фактически использовался
	// (Прогресс.Всего > 0). «Заявлено 0, закрыто 0» не пишем - это ввело бы
	// LLM в заблуждение, будто план есть и пуст, а не «не использовался»
	// (тот же принцип, что и в консоли Run Viewer, PLAN-04 §6/D10).
	Прогресс = ar_ПланЗапуска.Прогресс(План);
	Если Прогресс.Всего > 0 Тогда
		ЗаголовокПлан = НСтр("ru = 'План:'; en = 'Plan:'");
		СтрокаПлана = СтрШаблон(НСтр("ru = 'заявлено %1, закрыто %2'; en = '%1 declared, %2 done'"),
			Прогресс.Всего, Прогресс.Закрыто);
		Результат = Результат + Символы.ПС + Символы.ПС + ЗаголовокПлан + Символы.ПС + СтрокаПлана;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разобрать JSON-ответ LLM надзора в структуру решения (§3.2 + agentrunner-68):
// "выполнено" -> ЦельДостигнута; "нечего_делать" (с непустым reason) ->
// ЦельДостигнута; все остальное (включая ошибку разбора/недоступность LLM) ->
// Продолжить. "Эскалировать" контракт завершения не производит (см. спеку,
// «Контракт завершения»).
//
// agentrunner-68: кроме вердикта возвращаются класс, причина, missing
// (поле "missing" из ответа LLM - что не сделано, спека Б.2), сырой текст
// ответа (для payload события) и признак сбоя разбора (для уровня лога).
//
// Параметры:
//  ОтветLLM - Структура - ответ ar_LLMДиспетчер.Вызвать.
//
// Возвращаемое значение:
//  Структура - {Вердикт - Строка (имя значения ar_ВердиктНадзора);
//               Класс - Строка; Причина - Строка; НеСделано - Строка;
//               ОтветТекст - Строка; СбойРазбора - Булево}.
//
Функция РазобратьОтветНадзора(Знач ОтветLLM)

	Результат = Новый Структура;
	Результат.Вставить("Вердикт", "Продолжить");
	Результат.Вставить("Класс", "");
	Результат.Вставить("Причина", "");
	Результат.Вставить("НеСделано", "");
	Результат.Вставить("ОтветТекст", "");
	Результат.Вставить("СбойРазбора", Истина);

	Если ТипЗнч(ОтветLLM) <> Тип("Структура") ИЛИ ОтветLLM.Успех <> Истина Тогда
		Возврат Результат;
	КонецЕсли;

	СообщениеОтвета = Неопределено;
	ОтветLLM.Свойство("Сообщение", СообщениеОтвета);
	КонтентОтвета = "";
	Если ТипЗнч(СообщениеОтвета) = Тип("Структура") Тогда
		СообщениеОтвета.Свойство("content", КонтентОтвета);
	КонецЕсли;
	КонтентОтвета = ?(ТипЗнч(КонтентОтвета) = Тип("Строка"), КонтентОтвета, "");
	Результат.ОтветТекст = КонтентОтвета;

	Разобрано = ar_JSON.ИзJSON(КонтентОтвета);
	Если Разобрано = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
		Результат.Класс = Строка(Разобрано.Получить("class"));
		Результат.Причина = Строка(Разобрано.Получить("reason"));
		Результат.НеСделано = Строка(Разобрано.Получить("missing"));
	ИначеЕсли ТипЗнч(Разобрано) = Тип("Структура") Тогда
		ЗначениеКласса = "";
		Разобрано.Свойство("class", ЗначениеКласса);
		Результат.Класс = Строка(ЗначениеКласса);
		ЗначениеПричины = "";
		Разобрано.Свойство("reason", ЗначениеПричины);
		Результат.Причина = Строка(ЗначениеПричины);
		ЗначениеНеСделано = "";
		Разобрано.Свойство("missing", ЗначениеНеСделано);
		Результат.НеСделано = Строка(ЗначениеНеСделано);
	Иначе
		Возврат Результат;
	КонецЕсли;

	Результат.СбойРазбора = Ложь;

	// §3.2: "выполнено" и "нечего_делать" (с непустой причиной) - оба класса
	// приравниваются к достижению цели, остальное - "Продолжить".
	КлассВыполнено = (Результат.Класс = "выполнено");
	КлассНечегоДелатьСПричиной = (Результат.Класс = "нечего_делать" И Не ПустаяСтрока(СокрЛП(Результат.Причина)));

	Если КлассВыполнено ИЛИ КлассНечегоДелатьСПричиной Тогда
		Результат.Вердикт = "ЦельДостигнута";
	Иначе
		Результат.Вердикт = "Продолжить";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Зафиксировать событие НадзорРешение (для читаемости вызова из
// ПроверитьДостижениеЦелиВнутр и слоя повторов РешитьПродолжатьЛиВнутр).
//
// agentrunner-68 (спека Г.1): payload пополняется ключами source (cheap_check |
// llm | repeat | layers | progress - последнее для условия прогресса,
// agentrunner-107 п.5), class, reason, missing, model, tokens_in, tokens_out,
// duration_ms, answer (до 2000 символов), messages (системный промпт и сводка -
// для «Показать промпт» в ar_ПросмотрЗапуска), stop_reason (при остановке:
// answer_confirmed, а также причины эскалаций из ЗафиксироватьЭскалацию).
// Ключи с пустыми значениями не пишутся - старые потребители payload
// (ar_Уведомления.ОписаниеЭскалацииНадзора) обслуживаются как раньше.
//
// Параметры:
//  RunId         - Строка(36) - идентификатор запуска.
//  ДанныеРешения - Структура - решение (НовоеРешениеНадзора).
//
Процедура ЗафиксироватьРешение(Знач RunId, Знач ДанныеРешения)

	Payload = Новый Структура;
	Payload.Вставить("code", "supervisor_decision");
	Payload.Вставить("verdict", ДанныеРешения.Вердикт);
	Payload.Вставить("source", ДанныеРешения.Источник);

	Если Не ПустаяСтрока(ДанныеРешения.Причина) Тогда
		Payload.Вставить("reason", ДанныеРешения.Причина);
	КонецЕсли;
	Если Не ПустаяСтрока(ДанныеРешения.НеСделано) Тогда
		Payload.Вставить("missing", ДанныеРешения.НеСделано);
	КонецЕсли;
	Если ДанныеРешения.Источник = "llm" Тогда
		Payload.Вставить("class", ДанныеРешения.Класс);
		Если Не ПустаяСтрока(ДанныеРешения.Модель) Тогда
			Payload.Вставить("model", ДанныеРешения.Модель);
		КонецЕсли;
		Payload.Вставить("tokens_in", ДанныеРешения.ТокеновВход);
		Payload.Вставить("tokens_out", ДанныеРешения.ТокеновВыход);
		Payload.Вставить("duration_ms", ДанныеРешения.ДлительностьМС);
		Payload.Вставить("answer", Лев(ДанныеРешения.Ответ, ЛимитОтветаСобытия()));
		Если ТипЗнч(ДанныеРешения.СообщенияВызова) = Тип("Массив")
			И ДанныеРешения.СообщенияВызова.Количество() > 0 Тогда
			Payload.Вставить("messages", ДанныеРешения.СообщенияВызова);
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(ДанныеРешения.ПричинаОстановки) Тогда
		Payload.Вставить("stop_reason", ДанныеРешения.ПричинаОстановки);
	КонецЕсли;

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "НадзорРешение", Payload);

КонецПроцедуры

// Конструктор структуры решения надзора (см. ЗафиксироватьРешение).
//
// Параметры:
//  Вердикт  - Строка - имя значения ar_ВердиктНадзора.
//  Источник - Строка - "cheap_check" | "llm" | "repeat" | "layers".
//
// Возвращаемое значение:
//  Структура - решение с полями по умолчанию.
//
Функция НовоеРешениеНадзора(Знач Вердикт, Знач Источник)

	Решение = Новый Структура;
	Решение.Вставить("Вердикт", Вердикт);
	Решение.Вставить("Источник", Источник);
	Решение.Вставить("Класс", "");
	Решение.Вставить("Причина", "");
	Решение.Вставить("НеСделано", "");
	Решение.Вставить("Модель", "");
	Решение.Вставить("ТокеновВход", 0);
	Решение.Вставить("ТокеновВыход", 0);
	Решение.Вставить("ДлительностьМС", 0);
	Решение.Вставить("Ответ", "");
	Решение.Вставить("СообщенияВызова", Неопределено);
	Решение.Вставить("ПричинаОстановки", "");
	Возврат Решение;

КонецФункции

// Лимит сырого ответа LLM надзора в payload события НадзорРешение
// (символов, спека Г.1).
//
Функция ЛимитОтветаСобытия()
	Возврат 2000;
КонецФункции

// Лимит сырого ответа надзора в записи служебного лога при сбое разбора
// (символов, спека Д: «первые 500 символов ответа»).
//
Функция ЛимитСбоеЛога()
	Возврат 500;
КонецФункции

// ============================================================================
// CONS-11: детекция отсутствия прогресса - три слоя.
// ============================================================================

// Основная логика трёх слоёв. Порядок изменён относительно первой итерации
// (ревью 1): потолок (слой 3) проверяется и НЕЗАВИСИМО ИНКРЕМЕНТИРУЕТСЯ
// ПЕРВЫМ, в собственном защищённом блоке, ДО слоёв 1/2 - по двум причинам:
//  (1) дешевизна - одно чтение числа против запроса к ar_ДействияАгента и
//      вычисления SHA-256 по всей истории прохода (слой 2);
//  (2) ЖЁСТКОСТЬ ПРЕДОХРАНИТЕЛЯ (D6/D10, ревью 1, критичное замечание) -
//      слой 3 обязан оставаться жёстким пределом НЕЗАВИСИМО от сбоя слоёв 1/2.
//      Если бы счётчик читался/инкрементировался ТОЛЬКО в конце (как в первой
//      итерации), а слои 1/2 систематически падали бы (например, регистр
//      ar_ДействияАгента стабильно недоступен), fallback "Продолжать = Истина"
//      разрешал бы физическое продолжение БЕСКОНЕЧНО - счётчик потолка никогда
//      бы не инкрементировался и не сработал. Поэтому чтение+сравнение+запись
//      счётчика вынесены в отдельную функцию ПроверитьИИнкрементироватьПотолок,
//      которая выполняется в СВОЁМ try/catch: при успехе (счётчик прочитан и
//      обновлён) потолок гарантированно учтён на этом проходе независимо от
//      исхода слоёв 1/2 ниже; при сбое САМОГО слоя 3 (не удалось прочитать/
//      записать счётчик) - это ЕДИНСТВЕННЫЙ случай, когда функция возвращает
//      Продолжать = Ложь без эскалации (см. её doc-комментарий) - иначе не
//      остаётся вообще никакой защиты от бесконечного цикла.
//
// Слои 1 (бюджет) и 2 (отпечаток) выполняются БЕЗ внешнего перехвата здесь -
// он в РешитьПродолжатьЛи, с fallback "Продолжать = Истина" (D10, см. шапку
// модуля) - потолок уже подтверждён и инкрементирован строкой выше, поэтому
// ложное продолжение при их сбое ограничено предохранителем слоя 3.
//
// Параметры и возврат - см. РешитьПродолжатьЛи.
//
Функция РешитьПродолжатьЛиВнутр(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач Вердикт)

	// --- Слой 3 (проверяется первым - см. doc-комментарий выше, D6/D10) -----
	// Вердикт передаётся параметром - при сбое САМОГО слоя 3 функция возвращает
	// его НЕ переписанным (как пришёл от вызывающего кода, обычно "Продолжить") -
	// строковый литерал "Продолжить" внутри ПроверитьИИнкрементироватьПотолок
	// был бы семантически двусмысленным (выглядел бы как совпадение с обычным
	// успешным путём слоя 3, а не как «вердикт не менялся из-за отказа
	// детектора») - см. её doc-комментарий.
	// Состояние передаётся параметром: при срабатывании слоя 3 его цифры
	// (шаги/действия) попадают в payload эскалации safety_cap (agentrunner-54);
	// показание счётчика продолжений возвращается в РезультатПотолка.
	РезультатПотолка = ПроверитьИИнкрементироватьПотолок(RunId, Вердикт, Состояние);
	Если Не РезультатПотолка.Продолжать Тогда
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Ложь,
			"не проверялся", Ложь, РезультатПотолка.ВердиктДляЗаписи);
		Возврат НовыйРезультатРешения(Ложь, РезультатПотолка.ВердиктДляЗаписи);
	КонецЕсли;

	// --- Слой 1: бюджет (накопительно за весь RunId, D1/D2) -----------------
	// Состояние.ШаговВсего/ДействийВсего НЕ обнуляются между проходами (см.
	// ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора) - Пока Состояние.ШаговВсего <
	// МаксШагов в ar_RuntimeЦикл уже проверяет накопительный бюджет естественно.
	// Здесь - предварительная проверка ПЕРЕД тем, как разрешить ещё один
	// проход: если бюджет уже исчерпан или проход, который вот-вот начнётся,
	// не сможет сделать ни одного шага - терминально, budget. Бюджет не
	// продлевается ни при каких условиях (D2) - ни ШаговВсего, ни ДействийВсего
	// нигде в этой функции не изменяются и не игнорируются.
	МаксШагов = ЗначениеБюджета(ДанныеАгента, "МаксШагов");
	МаксДействий = ЗначениеБюджета(ДанныеАгента, "МаксДействий");

	ШаговВсего = ЗначениеЧисло(Состояние, "ШаговВсего");
	ДействийВсего = ЗначениеЧисло(Состояние, "ДействийВсего");

	БюджетИсчерпан = (МаксШагов > 0 И ШаговВсего >= МаксШагов)
		ИЛИ (МаксДействий > 0 И ДействийВсего >= МаксДействий);

	Если БюджетИсчерпан Тогда
		// agentrunner-54: цифры исчерпания - в payload события НадзорРешение
		// (письмо уходит до ЗавершитьЗапуск, ar_ШаговВсего в регистре ещё 0).
		Цифры = ЦифрыРешения(Состояние, ДанныеАгента, РезультатПотолка.ПродолженийСделано,
			ИсчерпанныйЛимитБюджета(МаксШагов, ШаговВсего, МаксДействий, ДействийВсего));
		ЗафиксироватьЭскалацию(RunId, "budget", Цифры);
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Ложь,
			"не проверялся", Ложь, "Эскалировать");
		Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
	КонецЕсли;

	// --- Слой 2а: повтор ответа (agentrunner-68, спека Б.5) ------------------
	// Нормализованный (регистр/ё/пробелы/пунктуация) ответ прохода сравнивается
	// с нормализованным ответом предыдущего прохода (Состояние.ОтветПредыдущегоПрохода,
	// пишет ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора). Первый повтор - продолжение
	// с вердиктом "СменитьПодход" (расширенный промпт с блоком повтора строит
	// ТекстПродолженияНадзора по признаку Состояние.ПредложитьСменуПодхода);
	// повтор после смены подхода - агент подтвердил вывод: продолжения нет,
	// вердикт записи "СменитьПодход", stop_reason = answer_confirmed, БЕЗ
	// эскалации и письма. Исключение - объективно ложный ответ (дешевая проверка:
	// заявлено создание/изменение без единого изменяющего результата) -
	// эскалация false_claim. Слой стоит ДО слоя отпечатка: смена подхода -
	// содержательная реакция раньше механической детекции топтания.
	ФинальныйТекст = ЗначениеСтрока(Состояние, "Результат");
	ОтветПредыдущего = ЗначениеСтрока(Состояние, "ОтветПредыдущегоПрохода");
	БылаСменаПодхода = ЗначениеБулево(Состояние, "ПредыдущийСменаПодхода");

	НормализованныйОтвет = НормализованныйОтветТекста(ФинальныйТекст);
	ПовторОтвета = (Не ПустаяСтрока(НормализованныйОтвет)
		И НормализованныйОтвет = НормализованныйОтветТекста(ОтветПредыдущего));

	Если ПовторОтвета И Не БылаСменаПодхода Тогда
		// Первый повтор: продолжение с призывом сменить подход. Признак
		// ПредложитьСменуПодхода - одноразовый (сбрасывает ПродолжитьЦиклПослеНадзора
		// после построения текста); ПредыдущийСменаПодхода - персистентный, он же
		// определяет ветку при следующем повторе.
		ЗаписатьВСостояние(Состояние, "ПредыдущийСменаПодхода", Истина);
		ЗаписатьВСостояние(Состояние, "ПредложитьСменуПодхода", Истина);
		РешениеПовтора = НовоеРешениеНадзора("СменитьПодход", "repeat");
		ЗафиксироватьРешение(RunId, РешениеПовтора);
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
			"не проверялся", Истина, "СменитьПодход");
		Возврат НовыйРезультатРешения(Истина, "СменитьПодход");
	КонецЕсли;

	Если ПовторОтвета И БылаСменаПодхода Тогда
		ДействияЗапуска = ВыбратьДействияЗапуска(RunId);
		ОтветЛожный = ПроверитьБезLLM(ФинальныйТекст, ДействияЗапуска).Сработала;
		РешениеПовтора = НовоеРешениеНадзора("СменитьПодход", "repeat");
		Если ОтветЛожный Тогда
			// Объективно ложный ответ (заявлено создание/изменение, результата
			// нет) - не принимается: эскалация false_claim, запуск «Завершён».
			Цифры = ЦифрыРешения(Состояние, ДанныеАгента, РезультатПотолка.ПродолженийСделано, "");
			ЗафиксироватьЭскалацию(RunId, "false_claim", Цифры);
			ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
				"не проверялся", Ложь, "Эскалировать");
			Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
		КонецЕсли;
		// Подтверждение после пересмотра: продолжения нет, итоговый ответ
		// принимается как окончательный (вердикт записи "СменитьПодход", не
		// "ЦельДостигнута" - надзор цель не подтвердил), stop_reason =
		// answer_confirmed, без эскалации и письма.
		РешениеПовтора.ПричинаОстановки = "answer_confirmed";
		ЗафиксироватьРешение(RunId, РешениеПовтора);
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, Истина,
			"не проверялся", Ложь, "СменитьПодход");
		Возврат НовыйРезультатРешения(Ложь, "СменитьПодход");
	КонецЕсли;

	// --- Условие прогресса (agentrunner-107, п.5) ----------------------------
	// Предыдущий проход не дал ни одного нового успешного вызова инструмента
	// (ar_ДействияАгента: ЗавершенСОшибкой = Ложь, Sequence за границей прохода)
	// - продолжение не запускается: продолжение без единого успешного вызова
	// повторяло бы топтание (лог e5697560 - четыре продолжения подряд с
	// пересказом одной ошибки). Запуск завершается штатно, итог модели остается;
	// событие НадзорРешение несет reason = no_progress. Слой 2а (выше) и слой 3
	// не меняются.
	ГраницаПрохода = ЗначениеЧисло(Состояние, "ДействийВсегоНаНачалоПрохода");

	Если НЕ ЕстьУспешныйВызовПрохода(RunId, ГраницаПрохода) Тогда
		РешениеНетПрогресса = НовоеРешениеНадзора("нет прогресса", "progress");
		РешениеНетПрогресса.Причина = "no_progress";
		ЗафиксироватьРешение(RunId, РешениеНетПрогресса);
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, ПовторОтвета,
			"не проверялся", Ложь, "нет прогресса");
		Возврат НовыйРезультатРешения(Ложь, "нет прогресса");
	КонецЕсли;

	// --- Слой 2б: result-aware отпечаток прохода (D3/D4/D5) -------------------
	// agentrunner-107 (п.5): отпечаток - хеш множества пар (инструмент,
	// канонические аргументы, код ошибки | успех); сырые тексты observation и
	// позиционное соответствие не используются.

	НовыйОтпечаток = ВычислитьОтпечатокПрохода(RunId, Состояние, ГраницаПрохода);
	// Чтение - привилегированно (SESS-06): у пользователя без права чтения
	// ar_Запуски Прочитать() молча вернул бы "не найдено" - отпечаток всегда
	// пуст, топтание не обнаружилось бы.
	ПредыдущийОтпечаток = ar_AuditЗащищённыйРежим.ПрочитатьОтпечатокШагаПривилегированно(RunId);

	// Первый проход запуска - ПредыдущийОтпечаток пуст (поле ещё не
	// заполнялось), сравнивать не с чем - топтание невозможно по определению,
	// это не тот же случай, что «пустой результат» (в) в спеке: там оба
	// прохода реально состоялись и дали одинаковый (пустой) результат.
	ЭтоПервыйПроходЗапуска = ПустаяСтрока(ПредыдущийОтпечаток);

	Если Не ЭтоПервыйПроходЗапуска И НовыйОтпечаток = ПредыдущийОтпечаток Тогда
		// Совпадение отпечатка ДВАЖДЫ ПОДРЯД (порог 2, D5 - на этом самом
		// сравнении, второй раз подряд) - топтание, эскалация немедленно.
		// Пропись отпечатка НЕ обновляется на эскалации - решение терминально,
		// следующего сравнения для этого RunId не будет.
		// agentrunner-54: шаги и продолжения - в payload события НадзорРешение.
		Цифры = ЦифрыРешения(Состояние, ДанныеАгента, РезультатПотолка.ПродолженийСделано, "");
		ЗафиксироватьЭскалацию(RunId, "stagnation", Цифры);
		ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, ПовторОтвета,
			"совпал", Ложь, "Эскалировать");
		Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
	КонецЕсли;

	// Ни один слой не остановил - разрешаем продолжение. Отпечаток текущего
	// прохода пишется ЗДЕСЬ (счётчик потолка уже записан выше, в
	// ПроверитьИИнкрементироватьПотолок, - НЕ дублируется здесь) - должен
	// попасть в ar_Запуски ДО того, как ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора
	// запустит следующий проход (иначе следующий вызов РешитьПродолжатьЛи
	// сравнил бы отпечаток сам с собой при сбое где-то посередине).
	// Ложь (записи запуска нет, гонка с удалением) НЕ останавливает цикл - это
	// сбой записи отпечатка, а не слоя 3: продолжение разрешается, следующий
	// проход сочтётся первым (ПредыдущийОтпечаток пуст) - безопасно, потолок
	// слоя 3 страхует.
	ЗаписатьОтпечатокПродолжения(RunId, НовыйОтпечаток);

	ЛогСлоёв(RunId, Состояние, РезультатПотолка.ПродолженийСделано, ПовторОтвета,
		"новый", Истина, Вердикт);
	Возврат НовыйРезультатРешения(Истина, Вердикт);

КонецФункции

// CONS-11 (ревью 1, критичное замечание): слой 3 (потолок 10 продолжений) как
// ЖЁСТКИЙ предохранитель, НЕЗАВИСИМЫЙ от сбоя слоёв 1/2. Чтение текущего
// значения счётчика, сравнение с потолком и немедленная запись
// инкрементированного значения выполняются здесь, в СОБСТВЕННОМ защищённом
// блоке, ДО вызова слоёв 1/2 в РешитьПродолжатьЛиВнутр - именно поэтому
// систематический отказ детекции прогресса (слой 2) или чтения бюджета
// (слой 1) не отменяет действие потолка: счётчик всё равно инкрементируется
// на КАЖДОМ проходе, прошедшем эту функцию, и рано или поздно (не позже
// 10-го продолжения) сработает.
//
// БЕЗОПАСНОСТЬ - направление ОБРАТНОЕ по сравнению со слоями 1/2 (D10): если
// не удалось даже прочитать или записать сам счётчик потолка - это
// ЕДИНСТВЕННЫЙ случай во всей детекции CONS-11, когда функция возвращает
// Продолжать = Ложь. Обоснование: fallback "продолжать" при сбое слоёв 1/2
// безопасен ИМЕННО ПОТОМУ, что слой 3 подстрахует патологию за конечное число
// шагов; если же ломается сам слой 3, эта страховка отсутствует, и
// единственный оставшийся барьер от бесконечного цикла - остановиться.
// Исключение НЕ пробрасывается наружу (перехватывается здесь же, не
// катч-блоком РешитьПродолжатьЛи, - иначе внешний catch применил бы к этому
// случаю fallback "продолжать", предназначенный только для слоёв 1/2).
//
// Параметры:
//  RunId     - Строка(36) - идентификатор запуска.
//  Вердикт   - Строка - вердикт, полученный вызывающим кодом (РешитьПродолжатьЛиВнутр) -
//              возвращается НЕ переписанным при сбое чтения/записи счётчика
//              (см. ниже, «Возвращаемое значение»).
//  Состояние - Структура, Неопределено - состояние цикла; используется только
//              для цифр payload при эскалации safety_cap (agentrunner-54):
//              шаги/действия; лимиты агента сюда не передаются - ключи
//              max_steps/max_actions в payload этой эскалации не пишутся.
//
// Возвращаемое значение:
//  Структура {Продолжать: Булево, ВердиктДляЗаписи: Строка,
//  ПродолженийСделано: Число} - формат НовыйРезультатРешения;
//  ВердиктДляЗаписи = "Эскалировать" при достижении потолка; = Вердикт (как
//  пришёл, не переписан) при сбое чтения/записи счётчика - это НЕ осмысленная
//  эскалация, а отказ детектора, поэтому вердикт не меняется (см.
//  РешитьПродолжатьЛиВнутр, комментарий у вызова); ПродолженийСделано -
//  показание счётчика на момент возврата (см. НовыйРезультатРешения).
//
Функция ПроверитьИИнкрементироватьПотолок(Знач RunId, Знач Вердикт, Знач Состояние = Неопределено)

	Попытка
		// Чтение - привилегированно (SESS-06): у пользователя без права чтения
		// ar_Запуски счётчик всегда читался бы как 0 и потолок не срабатывал.
		ПродолженийСделано = ar_AuditЗащищённыйРежим.ПрочитатьПродолженийСделаноПривилегированно(RunId);
		Если ПродолженийСделано >= 10 Тогда
			// agentrunner-54: продолжений и шаги/действия - в payload события
			// НадзорРешение (сбор цифр без исключений - D7/D10).
			Цифры = ЦифрыРешения(Состояние, Неопределено, ПродолженийСделано, "");
			ЗафиксироватьЭскалацию(RunId, "safety_cap", Цифры);
			Возврат НовыйРезультатРешения(Ложь, "Эскалировать", ПродолженийСделано);
		КонецЕсли;

		// Инкремент СРАЗУ, до слоёв 1/2 - см. doc-комментарий выше: потолок
		// обязан расти на каждом проходе независимо от их исхода. Ложь
		// (записи запуска нет, гонка с удалением) - сбой слоя 3: исключение
		// уходит в общий перехват ниже (запись в ar_СлужебныйЛог, продолжение
		// остановлено, вердикт не переписан).
		Если Не ЗаписатьСчётчикПотолка(RunId, ПродолженийСделано + 1) Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Счётчик потолка продолжений не записан: запись запуска %1 не найдена';
					|en = 'Continuation ceiling counter not written: run record %1 not found'"),
				RunId);
		КонецЕсли;
		Возврат НовыйРезультатРешения(Истина, Вердикт, ПродолженийСделано + 1);
	Исключение
		// Единственный случай "не продолжать" во всей детекции CONS-11 - см.
		// doc-комментарий: без работающего слоя 3 не остаётся защиты от
		// бесконечного цикла, поэтому здесь безопаснее остановиться, чем
		// продолжить. Вердикт возвращается НЕ переписанным (параметр Вердикт
		// как есть, обычно "Продолжить") - это не осмысленное решение надзора,
		// а отказ детектора, переписывать его на "Эскалировать" здесь неверно.
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;
		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьИИнкрементироватьПотолок", "safety_cap_check_failed",
				"Сбой чтения/записи счётчика потолка (слой 3) - продолжение ОСТАНОВЛЕНО "
					+ "(единственный default 'не продолжать' в детекции CONS-11, "
					+ "т.к. без слоя 3 нет защиты от бесконечного цикла). " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать safety_cap_check_failed в ar_СлужебныйЛог");
		КонецПопытки;
		Возврат НовыйРезультатРешения(Ложь, Вердикт);
	КонецПопытки;

КонецФункции

// Собрать возвращаемую структуру РешитьПродолжатьЛи.
//
// Параметры:
//  Продолжать         - Булево - разрешено ли продолжение цикла.
//  ВердиктДляЗаписи   - Строка - вердикт для ar_ПоследнееРешениеНадзора.
//  ПродолженийСделано - Число - показание счётчика продолжений
//                       (ar_Запуски.ar_ПродолженийСделано) на момент
//                       результата: после успешного инкремента слоя 3 -
//                       увеличенное значение (как в записи), при достижении
//                       потолка - прочитанное (инкремент не выполнялся);
//                       0 - счётчик не читался (сбой слоя 3). Нужно слоям 1/2
//                       для ключа continuations в payload эскалации
//                       (agentrunner-54).
//
// Возвращаемое значение:
//  Структура - {Продолжать, ВердиктДляЗаписи, ПродолженийСделано} (см. параметры).
//
Функция НовыйРезультатРешения(Знач Продолжать, Знач ВердиктДляЗаписи, Знач ПродолженийСделано = 0)
	Результат = Новый Структура;
	Результат.Вставить("Продолжать", Продолжать);
	Результат.Вставить("ВердиктДляЗаписи", ВердиктДляЗаписи);
	Результат.Вставить("ПродолженийСделано", ПродолженийСделано);
	Возврат Результат;
КонецФункции

// Прочитать МаксШагов/МаксДействий агента текущего прохода. И
// ar_RuntimeЦикл.ПрочитатьДанныеАгента (обычный агент, из ar_Агенты), и
// ДанныеАгентаБезАгента (режим «без агента», ar_Константы.МаксШагов/
// МаксДействий как дефолт) всегда несут оба поля числом - 0/отсутствие поля
// здесь означает сбой чтения структуры, а не «лимит не задан» бизнес-смыслом.
// При 0 проверка бюджета этим слоем пропускается (не проверяется) - слой 3
// (потолок 10 продолжений) всё равно остаётся жёстким пределом на этот случай.
//
// Параметры:
//  ДанныеАгента - Структура - данные агента (МаксШагов/МаксДействий - Число).
//  ИмяПоля      - Строка - "МаксШагов" или "МаксДействий".
//
// Возвращаемое значение:
//  Число - значение лимита; 0 - поле не удалось прочитать (защитный fallback).
//
Функция ЗначениеБюджета(Знач ДанныеАгента, Знач ИмяПоля)

	Если ТипЗнч(ДанныеАгента) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = 0;
	Если Не ДанныеАгента.Свойство(ИмяПоля, Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Безопасно извлечь числовое поле из Состояния (Структура).
//
Функция ЗначениеЧисло(Знач Состояние, Знач ИмяПоля)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;
	Значение = 0;
	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Безопасно извлечь строковое поле из Состояния (Структура).
//
Функция ЗначениеСтрока(Знач Состояние, Знач ИмяПоля)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Значение = "";
	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Вычислить SHA-256 (hex) отпечаток прохода (D3): хеш множества троек
// «имя tool + канонические аргументы + код ошибки | успех» по действиям
// ТЕКУЩЕГО прохода (Sequence >= ГраницаПрохода, а не всего RunId); проход
// без единого действия - фиксированный маркер "no_actions" (agentrunner-107,
// п.5: сырые тексты observation и финальный текст не входят).
//
// Хеш - тот же приём ar_ИнструментыПакеты.ХешМанифеста (та же последовательность
// ХешированиеДанных/SHA256/ПолучитьHexСтрокуИзДвоичныхДанных) - не отдельный
// хелпер (см. .docs/specs/CONS-11.md, D3).
//
// Параметры:
//  RunId          - Строка(36) - идентификатор запуска.
//  Состояние      - Структура - состояние цикла (зарезервировано; тексты
//                   observation отпечатком больше не читаются).
//  ГраницаПрохода - Число - Sequence, с которого начинается текущий проход
//                   (Состояние.ДействийВсегоНаНачалоПрохода).
//
// Возвращаемое значение:
//  Строка - hex SHA-256, 64 символа.
//
Функция ВычислитьОтпечатокПрохода(Знач RunId, Знач Состояние, Знач ГраницаПрохода)

	ДействияПрохода = ВыбратьДействияПрохода(RunId, ГраницаПрохода);

	Если ДействияПрохода.Количество() = 0 Тогда
		// Проход без единого действия - фиксированный маркер БЕЗ финального
		// текста (agentrunner-107, п.5): пересказ ответа менял бы отпечаток
		// каждый проход, слой 2б молчал бы.
		Возврат ХешСтроки("no_actions");
	КонецЕсли;

	// agentrunner-107 (п.5): хеш МНОЖЕСТВА троек (имя инструмента,
	// канонические аргументы, код ошибки | успех). Сырые тексты observation и
	// позиционное соответствие «наблюдение N = действие N» не используются -
	// наблюдения отказов ядра сдвигали позиции, пересказ модели менял текст
	// (лог e5697560). Канонизация аргументов - КаноническийJSON (порядок
	// ключей не влияет), код ошибки - КодОшибкиРезультата по ОтветИнструмента.
	// Множество: сортировка таблицы дает канонический порядок (перестановка
	// действий прохода не меняет отпечаток), дубли соседних строк схлопываются.
	ЧастиОтпечатка = Новый ТаблицаЗначений;
	ЧастиОтпечатка.Колонки.Добавить("Часть", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаДействия Из ДействияПрохода Цикл
		Имя = ?(ЗначениеЗаполнено(СтрокаДействия.ИмяTool), Строка(СтрокаДействия.ИмяTool), "");
		Аргументы = ?(ТипЗнч(СтрокаДействия.АргументыJSON) = Тип("Строка"), СтрокаДействия.АргументыJSON, "");
		Если СтрокаДействия.ЗавершенСОшибкой = Истина Тогда
			ОтветИнструмента = "";
			Если ТипЗнч(СтрокаДействия.ОтветИнструмента) = Тип("Строка") Тогда
				ОтветИнструмента = СтрокаДействия.ОтветИнструмента;
			КонецЕсли;
			ИтогДействия = "err:" + ar_RuntimeЦикл.КодОшибкиРезультата(ОтветИнструмента);
		Иначе
			ИтогДействия = "ok";
		КонецЕсли;
		СтрокаЧасти = ЧастиОтпечатка.Добавить();
		СтрокаЧасти.Часть = Имя + "|" + ar_RuntimeЦикл.КаноническийJSON(Аргументы) + "|" + ИтогДействия;
	КонецЦикла;

	ЧастиОтпечатка.Сортировать("Часть Возр");

	УникальныеЧасти = Новый Массив;
	ПредыдущаяЧасть = Неопределено;
	Для Каждого СтрокаЧасти Из ЧастиОтпечатка Цикл
		Если СтрокаЧасти.Часть = ПредыдущаяЧасть Тогда
			Продолжить;
		КонецЕсли;
		УникальныеЧасти.Добавить(СтрокаЧасти.Часть);
		ПредыдущаяЧасть = СтрокаЧасти.Часть;
	КонецЦикла;

	Возврат ХешСтроки(СтрСоединить(УникальныеЧасти, Символы.ПС));

КонецФункции

// Выбрать действия ТЕКУЩЕГО прохода (Sequence >= ГраницаПрохода) - в отличие
// от ВыбратьДействияЗапуска (CONS-10), которая берёт ВЕСЬ RunId.
// Дополнительно читает ar_АргументыJSON (канонизация отпечатка),
// ar_ОтветИнструмента (код ошибки) и ar_ЗавершёнСОшибкой (итог действия)
// - agentrunner-107, п.5.
//
// Параметры:
//  RunId          - Строка(36) - идентификатор запуска.
//  ГраницаПрохода - Число - Sequence начала текущего прохода (включительно).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, АргументыJSON, ОтветИнструмента,
//  ЗавершенСОшибкой, ResultRef, Sequence.
//
Функция ВыбратьДействияПрохода(Знач RunId, Знач ГраницаПрохода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.УстановитьПараметр("ГраницаПрохода", ГраницаПрохода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяИнструмента КАК ИмяTool,
	|	Действия.ar_АргументыJSON КАК АргументыJSON,
	|	Действия.ar_ОтветИнструмента КАК ОтветИнструмента,
	|	Действия.ar_ЗавершёнСОшибкой КАК ЗавершенСОшибкой,
	|	Действия.ar_СсылкаНаРезультат КАК ResultRef,
	|	Действия.ar_Последовательность КАК Sequence
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &RunId
	|	И Действия.ar_Последовательность >= &ГраницаПрохода
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Последовательность";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Есть ли в действиях ТЕКУЩЕГО прохода хотя бы один успешный вызов
// инструмента (agentrunner-107, п.5 - условие прогресса): ar_ДействияАгента,
// ЗавершенСОшибкой = Ложь, Sequence >= ГраницаПрохода. Один запрос
// «ВЫБРАТЬ ПЕРВЫЕ 1» - успех определяется на стороне СУБД.
//
// Параметры:
//  RunId          - Строка(36) - идентификатор запуска.
//  ГраницаПрохода - Число - Sequence начала текущего прохода (включительно).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУспешныйВызовПрохода(Знач RunId, Знач ГраницаПрохода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.УстановитьПараметр("ГраницаПрохода", ГраницаПрохода);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК ЕстьУспех
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &RunId
	|	И Действия.ar_Последовательность >= &ГраницаПрохода
	|	И НЕ Действия.ar_ЗавершёнСОшибкой";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// SHA-256 (hex) от строки в UTF-8 - тот же приём, что
// ar_ИнструментыПакеты.ХешМанифеста (см. .docs/specs/CONS-11.md, D3): не отдельный
// хелпер по существу, копия последовательности вызовов платформенного API,
// т.к. ar_ИнструментыПакеты.ХешМанифеста не экспортна и принимает Произвольный
// (сериализует сама через ar_JSON), а здесь на входе уже готовая строка.
//
Функция ХешСтроки(Знач ИсходнаяСтрока)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, КодировкаТекста.UTF8, Ложь);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Зафиксировать событие эскалации (D11) с явным признаком сработавшего слоя -
// "budget"/"stagnation"/"safety_cap" - и переписать
// ar_ПоследнееРешениеНадзора на "Эскалировать" (единственное место, где это
// значение реально записывается - см. doc-комментарий модуля).
//
// agentrunner-54: с Цифрами в payload события НадзорРешение добавляются ключи
// цифр (протокол события - латиницей, как существующие code/verdict/
// escalation_reason; читает ar_Уведомления.ОписаниеЭскалацииНадзора):
//  steps         - шагов сделано (Состояние.ШаговВсего);
//  max_steps     - лимит шагов агента (если задан и > 0);
//  actions       - действий сделано (Состояние.ДействийВсего);
//  max_actions   - лимит действий агента (если задан и > 0);
//  limit         - какой лимит исчерпан для "budget": "steps" или "actions"
//                  (оба - "steps");
//  continuations - продолжений сделано (ar_Запуски.ar_ПродолженийСделано на
//                  момент решения) - для "stagnation" и "safety_cap".
// Письмо эскалации уходит отсюда же (ar_Уведомления.Уведомить ниже) ДО
// ЗавершитьЗапуска - когда ar_ШаговВсего в регистре ещё 0, поэтому цифры идут
// в payload, а не дочитываются из регистра. Payload без новых ключей (старые
// события) ar_Уведомления обслуживает как раньше.
//
// Статус запуска (Completed/MaxStepsReached) НЕ меняется здесь - это делает
// ar_RuntimeЦикл через обычный ЗавершитьЗапуск с исходным Статус (см. спеку,
// «Эскалация»: «вердикт независим от статуса запуска»).
//
// Параметры:
//  RunId            - Строка(36) - идентификатор запуска.
//  ПричинаЭскалации - Строка - "budget"/"stagnation"/"safety_cap".
//  Цифры            - Структура, Неопределено - цифры решения (ЦифрыРешения);
//                     Неопределено - payload без цифр (старые вызовы).
//
Процедура ЗафиксироватьЭскалацию(Знач RunId, Знач ПричинаЭскалации, Знач Цифры = Неопределено)

	Payload = Новый Структура;
	Payload.Вставить("code", "supervisor_decision");
	Payload.Вставить("verdict", "Эскалировать");
	Payload.Вставить("escalation_reason", ПричинаЭскалации);
	// agentrunner-68 (спека Г.1): stop_reason несёт причины эскалаций (читается
	// ar_ПросмотрЗапуска как деталь события) - дубль escalation_reason по
	// единому протоколу остановок.
	Payload.Вставить("stop_reason", ПричинаЭскалации);
	// Цифры собраны ЦифрыРешения без исключений (безопасные ЗначениеЧисло/
	// ЗначениеБюджета, D7/D10): не Структура - payload без дополнения.
	Если ТипЗнч(Цифры) = Тип("Структура") Тогда
		Для Каждого ЭлементЦифр Из Цифры Цикл
			Payload.Вставить(ЭлементЦифр.Ключ, ЭлементЦифр.Значение);
		КонецЦикла;
	КонецЕсли;
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "НадзорРешение", Payload);

	// CONS-12: единая точка уведомлений - эскалация надзора доходит письмом
	// ответственному. ar_Уведомления сама перехватывает любые свои ошибки
	// (D9) - сбой отправки не должен ронять надзор.
	ar_Уведомления.Уведомить(RunId, "escalation");

КонецПроцедуры

// Собрать цифры решения надзора для payload события эскалации (agentrunner-54,
// протокол ключей - см. ЗафиксироватьЭскалацию). Читает только через безопасные
// ЗначениеЧисло/ЗначениеБюджета (проверка типов, 0 при сбое чтения) - исключений
// не даёт, best-effort по D7/D10: сбой чтения поля даёт отсутствие или ноль в
// ключе, но не отменяет саму эскалацию.
//
// Параметры:
//  Состояние          - Структура, Неопределено - состояние цикла (ШаговВсего,
//                       ДействийВсего).
//  ДанныеАгента       - Структура, Неопределено - данные агента (МаксШагов,
//                       МаксДействий); Неопределено - ключи лимитов не пишутся.
//  ПродолженийСделано - Число - показание счётчика продолжений на момент
//                       решения; 0 - ключ continuations не пишется.
//  ИсчерпанныйЛимит   - Строка - "steps"/"actions" - какой лимит исчерпан
//                       (ключ limit для "budget"); иное - ключ не пишется.
//
// Возвращаемое значение:
//  Структура - только заполненные ключи протокола события.
//
Функция ЦифрыРешения(Знач Состояние, Знач ДанныеАгента, Знач ПродолженийСделано, Знач ИсчерпанныйЛимит)

	Результат = Новый Структура;
	Результат.Вставить("steps", ЗначениеЧисло(Состояние, "ШаговВсего"));
	Результат.Вставить("actions", ЗначениеЧисло(Состояние, "ДействийВсего"));

	ЛимитШагов = ЗначениеБюджета(ДанныеАгента, "МаксШагов");
	Если ЛимитШагов > 0 Тогда
		Результат.Вставить("max_steps", ЛимитШагов);
	КонецЕсли;

	ЛимитДействий = ЗначениеБюджета(ДанныеАгента, "МаксДействий");
	Если ЛимитДействий > 0 Тогда
		Результат.Вставить("max_actions", ЛимитДействий);
	КонецЕсли;

	Если ПродолженийСделано > 0 Тогда
		Результат.Вставить("continuations", ПродолженийСделано);
	КонецЕсли;

	Если ИсчерпанныйЛимит = "steps" Или ИсчерпанныйЛимит = "actions" Тогда
		Результат.Вставить("limit", ИсчерпанныйЛимит);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Какой бюджетный лимит исчерпан (agentrunner-54: слой 1 и ветка
// max_steps_reached): исчерпаны оба лимита - "steps" (спека agentrunner-54).
//
// Параметры:
//  МаксШагов     - Число - лимит шагов агента (0 - не задан).
//  ШаговВсего    - Число - шагов сделано.
//  МаксДействий  - Число - лимит действий агента (0 - не задан).
//  ДействийВсего - Число - действий сделано.
//
// Возвращаемое значение:
//  Строка - "steps", если исчерпан лимит шагов (исчерпаны оба - тоже "steps");
//           "actions" - если только действий; "" - ни один (ключ limit в
//           payload не пишется).
//
Функция ИсчерпанныйЛимитБюджета(Знач МаксШагов, Знач ШаговВсего, Знач МаксДействий, Знач ДействийВсего)

	Если МаксШагов > 0 И ШаговВсего >= МаксШагов Тогда
		Возврат "steps";
	ИначеЕсли МаксДействий > 0 И ДействийВсего >= МаксДействий Тогда
		Возврат "actions";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// CONS-11 (ревью 1, критичное замечание): записать ТОЛЬКО счётчик потолка
// (слой 3), отдельно от отпечатка (слой 2) - см.
// ПроверитьИИнкрементироватьПотолок, где эта запись происходит ДО слоёв 1/2
// и должна быть независима от их успеха/сбоя. Запись - через привилегированный
// фасад ar_AuditЗащищённыйРежим.ОбновитьПоляЗапускаПривилегированно (AUD-06):
// сеанс запуска прав на запись ar_Запуски может не иметь. Whitelist ключей -
// ar_AuditЗапуски.ОбновитьПоляЗапуска: пишется только присутствующий ключ
// "ПродолженийСделано", статус/старт/триггер/пульс и прочие поля не трогаются.
//
// Параметры:
//  RunId              - Строка(36) - идентификатор запуска.
//  ПродолженийСделано - Число - обновлённое значение счётчика
//                       (ПрочитатьПродолженийСделаноПривилегированно + 1).
//
// Возвращаемое значение:
//  Булево - Истина - счётчик записан; Ложь - записи запуска нет (гонка с
//  удалением) - в ПроверитьИИнкрементироватьПотолок это сбой слоя 3
//  (продолжение остановлено).
//
Функция ЗаписатьСчётчикПотолка(Знач RunId, Знач ПродолженийСделано)

	ДанныеОбновления = Новый Структура;
	ДанныеОбновления.Вставить("ПродолженийСделано", ПродолженийСделано);
	Возврат ar_AuditЗащищённыйРежим.ОбновитьПоляЗапускаПривилегированно(RunId, ДанныеОбновления);

КонецФункции

// Записать в ar_Запуски отпечаток текущего прохода (слой 2) - отдельно от
// счётчика потолка (см. ЗаписатьСчётчикПотолка, ревью 1) - ДО того, как
// ar_RuntimeЦикл запустит следующий проход. Запись - через привилегированный
// фасад ar_AuditЗащищённыйРежим.ОбновитьПоляЗапускаПривилегированно (AUD-06).
// Whitelist ключей - ar_AuditЗапуски.ОбновитьПоляЗапуска: пишется только
// присутствующий ключ "ОтпечатокШага", прочие поля записи не трогаются.
//
// Параметры:
//  RunId     - Строка(36) - идентификатор запуска.
//  Отпечаток - Строка - hex SHA-256 текущего прохода.
//
// Возвращаемое значение:
//  Булево - Истина - отпечаток записан; Ложь - записи запуска нет (гонка с
//  удалением) - НЕ сбой слоя 3: продолжение разрешается, следующий проход
//  сочтётся первым (безопасно, потолок слоя 3 страхует).
//
Функция ЗаписатьОтпечатокПродолжения(Знач RunId, Знач Отпечаток)

	ДанныеОбновления = Новый Структура;
	ДанныеОбновления.Вставить("ОтпечатокШага", Отпечаток);
	Возврат ar_AuditЗащищённыйРежим.ОбновитьПоляЗапускаПривилегированно(RunId, ДанныеОбновления);

КонецФункции

// ============================================================================
// agentrunner-68: расширение промпта продолжения, слой повторов ответа,
// служебный лог решения.
// ============================================================================

// Лимит суммарного текста промпта продолжения (символов, спека Б.4).
//
Функция ЛимитПромптаПродолжения()
	Возврат 4000;
КонецФункции

// Лимит блока цели в промпте продолжения (символов).
//
Функция ЛимитЦелиПромпта()
	Возврат 1000;
КонецФункции

// Лимит отдельного текстового блока промпта (символов).
//
Функция ЛимитБлокаПромпта()
	Возврат 500;
КонецФункции

// Максимум действий в блоке «Выполненные действия» (последние, спека Б.4).
//
Функция ЛимитДействийПромпта()
	Возврат 20;
КонецФункции

// Лимит заголовка одного пункта плана в промпте продолжения (символов).
//
Функция ЛимитПунктаПромпта()
	Возврат 200;
КонецФункции

// Усечь текст до лимита с пометкой усечения (спека Б.4: «длинные блоки
// усекаются с пометкой»); строка короче лимита возвращается как есть.
//
// Параметры:
//  Текст - Строка - исходный текст.
//  Лимит - Число  - максимальная длина результата.
//
// Возвращаемое значение:
//  Строка
//
Функция УсечьТекст(Знач Текст, Знач Лимит)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Если СтрДлина(Текст) <= Лимит Тогда
		Возврат Текст;
	КонецЕсли;

	Пометка = НСтр("ru = '... (усечено)'; en = '... (truncated)'");
	Возврат Лев(Текст, Лимит) + Символы.ПС + Пометка;

КонецФункции

// Блок «Выполненные действия» промпта продолжения: инструмент -> результат
// получен / ошибка / результата нет - не более ЛимитДействийПромпта последних,
// без содержимого ответов (спека Б.4). Нет действий - пустая строка (блок не
// добавляется).
//
// Параметры:
//  Действия - ТаблицаЗначений - колонки ИмяTool, ResultRef, ЗавершенСОшибкой
//             (см. ВыбратьДействияЗапуска).
//
// Возвращаемое значение:
//  Строка
//
Функция БлокДействийПромпта(Знач Действия)

	Если ТипЗнч(Действия) <> Тип("ТаблицаЗначений") ИЛИ Действия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ВсегоДействий = Действия.Количество();
	НачальныйНомер = Макс(ВсегоДействий - ЛимитДействийПромпта(), 0);

	Строки = Новый Массив;
	Для НомерДействия = НачальныйНомер По ВсегоДействий - 1 Цикл
		СтрокаДействия = Действия[НомерДействия];
		ИмяTool = Строка(СтрокаДействия.ИмяTool);
		Если СтрокаДействия.ЗавершенСОшибкой = Истина Тогда
			Итог = НСтр("ru = 'ошибка'; en = 'error'");
		ИначеЕсли Не ПустаяСтрока(СтрокаДействия.ResultRef) Тогда
			Итог = НСтр("ru = 'результат получен'; en = 'result produced'");
		Иначе
			Итог = НСтр("ru = 'результата нет'; en = 'no result'");
		КонецЕсли;
		Строки.Добавить(ИмяTool + " -> " + Итог);
	КонецЦикла;

	Если Строки.Количество() < ВсегоДействий Тогда
		Строки.Вставить(0, СтрШаблон(
			НСтр("ru = '(первые %1 из %2 действий скрыты)'; en = '(first %1 of %2 actions hidden)'"),
			Формат(ВсегоДействий - Строки.Количество(), "ЧН=0; ЧГ=0"), Формат(ВсегоДействий, "ЧН=0; ЧГ=0")));
	КонецЕсли;

	Возврат НСтр("ru = 'Выполненные действия запуска:'; en = 'Actions performed in the run:'")
		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Соответствие «имя инструмента -> Истина» по таблице действий - для отметки
// вызванных инструментов в блоке инструментов промпта.
//
Функция ИменаВызванныхИнструментов(Знач Действия)

	Результат = Новый Соответствие;
	Если ТипЗнч(Действия) <> Тип("ТаблицаЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого СтрокаДействия Из Действия Цикл
		Результат.Вставить(Строка(СтрокаДействия.ИмяTool), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Блок «План» промпта продолжения: шаги и статусы (если план есть, спека Б.4).
// Удаленные (removed) пункты не выводятся; пустой план - пустая строка.
//
Функция БлокПланаПромпта(Знач План)

	Пункты = Неопределено;
	Если ТипЗнч(План) = Тип("Структура") Тогда
		План.Свойство("Пункты", Пункты);
	КонецЕсли;
	Если ТипЗнч(Пункты) <> Тип("Массив") ИЛИ Пункты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Пункт Из Пункты Цикл
		СтатусПункта = мСтатусПункта(Пункт);
		Если СтатусПункта = "" Тогда
			// removed (и неизвестные статусы) - в промпт не попадают.
			Продолжить;
		КонецЕсли;
		ЗаголовокПункта = "";
		Если ТипЗнч(Пункт) = Тип("Структура") Тогда
			Пункт.Свойство("Заголовок", ЗаголовокПункта);
		КонецЕсли;
		Строки.Добавить("- " + УсечьТекст(Строка(ЗаголовокПункта), ЛимитПунктаПромпта())
			+ " - " + СтатусПункта);
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НСтр("ru = 'План:'; en = 'Plan:'") + Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Русское представление статуса пункта плана (см. ar_ПланЗапуска.НовыйПункт);
// removed и неизвестные значения дают пустую строку (пункт скрыт).
//
Функция мСтатусПункта(Знач Пункт)

	Статус = "";
	Если ТипЗнч(Пункт) = Тип("Структура") Тогда
		Пункт.Свойство("Статус", Статус);
	КонецЕсли;
	Статус = НРег(СокрЛП(Статус));

	Если Статус = "pending" Тогда
		Возврат НСтр("ru = 'не начат'; en = 'not started'");
	ИначеЕсли Статус = "in_progress" Тогда
		Возврат НСтр("ru = 'в работе'; en = 'in progress'");
	ИначеЕсли Статус = "done" Тогда
		Возврат НСтр("ru = 'готов'; en = 'done'");
	ИначеЕсли Статус = "skipped" Тогда
		Возврат НСтр("ru = 'пропущен'; en = 'skipped'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Блок «Доступные инструменты» промпта продолжения: имена инструментов запуска
// с отметкой, какие ещё не вызывались (спека Б.4). Список не передан - пустая
// строка (блок не добавляется).
//
// Параметры:
//  ДоступныеИнструменты - Массив, Неопределено - имена инструментов запуска.
//  ВызванныеИнструменты - Соответствие - имена вызванных (ИменаВызванныхИнструментов).
//
Функция БлокИнструментовПромпта(Знач ДоступныеИнструменты, Знач ВызванныеИнструменты)

	Если ТипЗнч(ДоступныеИнструменты) <> Тип("Массив") ИЛИ ДоступныеИнструменты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ВызванныеИнструменты) <> Тип("Соответствие") Тогда
		ВызванныеИнструменты = Новый Соответствие;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого ИмяИнструмента Из ДоступныеИнструменты Цикл
		ИмяСтрокой = Строка(ИмяИнструмента);
		Если ПустаяСтрока(ИмяСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		Отметка = ?(ВызванныеИнструменты.Получить(ИмяСтрокой) = Истина,
			НСтр("ru = 'вызывался'; en = 'called'"),
			НСтр("ru = 'ещё не вызывался'; en = 'not called yet'"));
		Строки.Добавить("- " + ИмяСтрокой + " (" + Отметка + ")");
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НСтр("ru = 'Доступные инструменты:'; en = 'Available tools:'")
		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Нормализованный текст ответа для сравнения повторов (спека Б.5): нижний
// регистр, ё -> е, без пробельных символов и знаков препинания.
//
// Параметры:
//  Текст - Строка - ответ прохода (или предыдущего прохода).
//
// Возвращаемое значение:
//  Строка - нормализованный текст; пустые ответы остаются пустыми.
//
Функция НормализованныйОтветТекста(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Результат = НРег(СтрЗаменить(Текст, "ё", "е"));

	// Пробельные символы.
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символы.НПП, "");

	// Знаки препинания и прочие несмыслоразличающие символы.
	Знаки = Новый Массив;
	Знаки.Добавить(".");
	Знаки.Добавить(",");
	Знаки.Добавить("!");
	Знаки.Добавить("?");
	Знаки.Добавить(":");
	Знаки.Добавить(";");
	Знаки.Добавить("""");
	Знаки.Добавить("'");
	Знаки.Добавить("(");
	Знаки.Добавить(")");
	Знаки.Добавить("[");
	Знаки.Добавить("]");
	Знаки.Добавить("{");
	Знаки.Добавить("}");
	Знаки.Добавить("-");
	Знаки.Добавить("*");
	Знаки.Добавить("/");
	Знаки.Добавить("\");
	Знаки.Добавить("|");
	Знаки.Добавить("«");
	Знаки.Добавить("»");
	Знаки.Добавить("—");
	Знаки.Добавить("–");
	Знаки.Добавить("…");
	Знаки.Добавить("_");
	Знаки.Добавить("<");
	Знаки.Добавить(">");

	Для Каждого Знак Из Знаки Цикл
		Результат = СтрЗаменить(Результат, Знак, "");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Безопасно извлечь булево поле из Состояния (Структура); отсутствие ключа
// или другой тип - Ложь (старые снимки без ключа, ДополнитьКлючи подставит).
//
Функция ЗначениеБулево(Знач Состояние, Знач ИмяПоля)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Ложь;
	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Безопасно прочитать число по ключу структуры ответа LLM (0 при сбое).
//
Функция ЧислоПоКлючу(Знач Источник, Знач ИмяКлюча)
	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;
	Значение = 0;
	Если Не Источник.Свойство(ИмяКлюча, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Записать значение в ключ Состояния (создав ключ при его отсутствии).
//
Процедура ЗаписатьВСостояние(Состояние, Знач ИмяПоля, Знач Значение)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Состояние.Вставить(ИмяПоля, Значение);
КонецПроцедуры

// Причина срабатывания дешевой проверки (спека Б.2/Б.4) - единая формулировка
// для payload события, служебного лога и блока «не сделано» промпта.
//
Функция ПричинаДешевойПроверки()
	Возврат НСтр("ru = 'заявлено создание/изменение, но ни одно изменяющее действие
		|не дало результата';
		|en = 'creation/modification is claimed, but no mutating action produced
		|a result'");
КонецФункции

// Служебный лог решения слоёв детекции (спека Д, событие supervisor_layers):
// потолок, бюджет, повтор ответа, отпечаток, итог. Best-effort - вызывается из
// веток РешитьПродолжатьЛиВнутр перед возвратом; сам лог ошибок не бросает
// (внутренний перехват), чтобы не мешать уже принятому решению.
//
// Параметры:
//  RunId              - Строка(36) - идентификатор запуска.
//  Состояние          - Структура, Неопределено - состояние цикла (бюджет).
//  ПродолженийСделано - Число  - показание счётчика потолка (N/10).
//  ПовторОтвета       - Булево - сработал ли слой повтора ответа.
//  ОтпечатокСтатус    - Строка - "совпал" | "новый" | "не проверялся".
//  Продолжать         - Булево - итоговое решение (продолжение цикла).
//  Вердикт            - Строка - вердикт для записи.
//
Процедура ЛогСлоёв(Знач RunId, Знач Состояние, Знач ПродолженийСделано,
	Знач ПовторОтвета, Знач ОтпечатокСтатус, Знач Продолжать, Знач Вердикт)

	ar_СлужебныйЛог.Записать("ar_Надзор.РешитьПродолжатьЛи", "supervisor_layers",
		СтрШаблон("Потолок=%1/10; Бюджет: шагов=%2, действий=%3; ПовторОтвета=%4; Отпечаток=%5; Итог=%6 (%7)",
			Формат(ПродолженийСделано, "ЧН=0; ЧГ=0"),
			Формат(ЗначениеЧисло(Состояние, "ШаговВсего"), "ЧН=0; ЧГ=0"),
			Формат(ЗначениеЧисло(Состояние, "ДействийВсего"), "ЧН=0; ЧГ=0"),
			?(ПовторОтвета, "да", "нет"), ОтпечатокСтатус,
			?(Продолжать, "Продолжать", "остановить"), Вердикт),
		, RunId);

КонецПроцедуры

#КонецОбласти
