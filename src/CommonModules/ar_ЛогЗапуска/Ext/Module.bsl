////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ЛогЗапуска.
//
// Полный лог одного запуска агента для разбора в другой базе: запуск, события
// (в т.ч. промпты LLM), вызовы tools, снимок состояния (сообщения и результаты
// tools), метрики LLM, approval, диалог с пользователем, сессия, настройки агента
// и провайдера, служебный лог, ошибки из журнала регистрации за период работы.
//
// Два представления одних и тех же данных:
//   * СобратьПакет / ПакетВJSON - машинный пакет (JSON) для выгрузки в файл;
//   * ТекстовыйВид              - читаемая хронология для просмотра в форме.
//
// Выполняется в привилегированном режиме (точечно, try/finally): роли
// пользователей не имеют Read на служебные регистры и права на журнал
// регистрации. Контракт тот же, что у ar_ДиагностикаОчистка.
//
// Доступ: привилегированный сбор обходит фильтр по ответственному из
// ar_КонсольДанные, поэтому пакет собирается только для полноправного
// пользователя (Пользователи.ЭтоПолноправныйПользователь). Модуль без вызова
// с клиента: форма обращается к нему через свои серверные функции.
//
// Безопасность:
//   * ключи API не выгружаются: ar_ХранилищеСекретов не читается, у провайдера
//     выгружается только идентификатор ключа;
//   * весь итоговый текст проходит через ar_Утилиты.МаскироватьСекреты (SEC-02);
//   * ПДн не маскируются (нужны исходные данные для разбора) - файл передавать
//     осторожно.
//
// Недоступный раздел не пропускается молча: на его месте {"unavailable": "причина"}.
//
// Время во всех полях - время сервера, формат "yyyy-MM-dd HH:mm:ss".
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Собирает пакет лога запуска.
//
// Параметры:
//   RunId     - Строка - идентификатор запуска (UUID).
//   Параметры - Структура - необязательно:
//     * УровниЖурнала        - Строка - уровни записей журнала регистрации через запятую:
//                                       "Ошибка", "Предупреждение", "Информация", "Примечание";
//                                       "Все" - без отбора по уровню, весь журнал за период
//                                       работы агента (по умолчанию "Ошибка").
//     * МаксСобытийЖурнала   - Число  - лимит записей журнала регистрации (по умолчанию 2000).
//     * МаксДочернихЗапусков - Число  - лимит дочерних запусков (по умолчанию 20).
//
// Возвращаемое значение:
//   Структура - пакет; значения приведены к JSON-совместимым типам.
//
Функция СобратьПакет(Знач RunId, Знач Параметры = Неопределено) Экспорт

	Если Не ar_Утилиты.ЭтоUUID(RunId) Тогда
		ВызватьИсключение НСтр("ru = 'ar_ЛогЗапуска: RunId должен быть UUID';
			|en = 'ar_ЛогЗапуска: RunId must be a UUID'");
	КонецЕсли;

	Настройки = НастройкиСбора(Параметры);

	// Проверка ДО повышения привилегий: в привилегированном режиме любой
	// пользователь считался бы полноправным.
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав: лог запуска доступен полноправному пользователю.';
			|en = 'Insufficient rights: the run log is available to full-rights users only.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Пакет = СобратьПакетПривилегированно(RunId, Настройки);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Пакет;

КонецФункции

// Пакет лога запуска в виде JSON-текста (с отступами, секреты замаскированы).
//
// Параметры:
//   RunId     - Строка - идентификатор запуска (UUID).
//   Параметры - Структура - см. СобратьПакет.
//
// Возвращаемое значение:
//   Строка
//
Функция ПакетВJSON(Знач RunId, Знач Параметры = Неопределено) Экспорт

	Пакет = СобратьПакет(RunId, Параметры);

	ТекстJSON = ar_JSON.КрасивыйФорматJSON(Пакет);
	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение НСтр("ru = 'ar_ЛогЗапуска: не удалось сериализовать пакет в JSON (см. журнал регистрации)';
			|en = 'ar_ЛогЗапуска: failed to serialize the package to JSON (see the event log)'");
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(ТекстJSON);

КонецФункции

// Читаемый текстовый вид лога запуска: единая хронология (события, диалог,
// служебный лог, журнал регистрации), затем вызовы tools, метрики, approval,
// сообщения из снимка состояния.
//
// Параметры:
//   RunId     - Строка - идентификатор запуска (UUID).
//   Параметры - Структура - см. СобратьПакет.
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстовыйВид(Знач RunId, Знач Параметры = Неопределено) Экспорт

	Пакет = СобратьПакет(RunId, Параметры);

	Строки = Новый Массив;
	Мета = Пакет.meta;
	Строки.Добавить("AgentRunner - лог запуска " + RunId);
	Строки.Добавить("Версия расширения: " + Мета.extension_version);
	Строки.Добавить("Сформирован: " + Мета.generated_at + ", пользователь: " + Мета.generated_by);
	Строки.Добавить("Время - серверное. Полные данные - в JSON-выгрузке.");
	Строки.Добавить("");

	ДобавитьЗаголовок(Строки, "СРЕДА");
	ДобавитьСреду(Строки, Пакет.environment);

	ДобавитьЗаголовок(Строки, "ЗАПУСК");
	ДобавитьСтруктуру(Строки, Пакет.run);

	Если Пакет.Свойство("agent") И ТипЗнч(Пакет.agent) = Тип("Структура") Тогда
		ДобавитьЗаголовок(Строки, "АГЕНТ");
		ДобавитьСтруктуру(Строки, Пакет.agent, "ar_Инструкция");
	КонецЕсли;

	ДобавитьЗаголовок(Строки, "НАСТРОЙКИ РАСШИРЕНИЯ (константы)");
	ДобавитьСтруктуру(Строки, Пакет.settings.constants);

	ДобавитьЗаголовок(Строки, "ПРОФИЛЬ КОНФИГУРАЦИИ");
	ДобавитьМассивСтруктур(Строки, Пакет.settings.config_profile);

	ДобавитьЗаголовок(Строки, "ЗАПРЕЩЁННЫЕ ОБЪЕКТЫ");
	ДобавитьМассивСтруктур(Строки, Пакет.settings.forbidden_objects);

	ДобавитьЗаголовок(Строки, "ПЕРЕОПРЕДЕЛЕНИЯ ОБЪЕКТОВ");
	ДобавитьМассивСтруктур(Строки, Пакет.settings.object_overrides);

	ДобавитьЗаголовок(Строки, "ПРАВИЛА МАСКИРОВАНИЯ ПДН");
	ДобавитьМассивСтруктур(Строки, Пакет.settings.pii_masking_rules);

	ДобавитьЗаголовок(Строки, "РЕЕСТР TOOLS");
	ДобавитьРеестрИнструментов(Строки, Пакет.tools_registry.all);

	ДобавитьЗаголовок(Строки, "ПАМЯТЬ АГЕНТА");
	ДобавитьМассивСтруктур(Строки, Пакет.agent_memory);

	ДобавитьЗаголовок(Строки, "ХРОНОЛОГИЯ");
	ДобавитьХронологию(Строки, Пакет);

	ДобавитьЗаголовок(Строки, "ВЫЗОВЫ TOOLS");
	ДобавитьМассивСтруктур(Строки, Пакет.run_data.actions);

	ДобавитьЗаголовок(Строки, "МЕТРИКИ LLM");
	ДобавитьМассивСтруктур(Строки, Пакет.run_data.llm_metrics);

	ДобавитьЗаголовок(Строки, "APPROVAL");
	ДобавитьМассивСтруктур(Строки, Пакет.run_data.approvals);

	ДобавитьЗаголовок(Строки, "СООБЩЕНИЯ ИЗ СНИМКА СОСТОЯНИЯ");
	ДобавитьСообщенияСнимка(Строки, Пакет.run_data.state_snapshot);

	Если Пакет.child_runs.Количество() > 0 Тогда
		ДобавитьЗаголовок(Строки, "ДОЧЕРНИЕ ЗАПУСКИ (краткая сводка, детали - в JSON)");
		Для Каждого Дочерний Из Пакет.child_runs Цикл
			ДобавитьСтруктуру(Строки, Дочерний.run);
			Строки.Добавить("  событий: " + ЧислоЭлементов(Дочерний.events)
				+ ", вызовов tools: " + ЧислоЭлементов(Дочерний.actions));
			Строки.Добавить("");
		КонецЦикла;
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Имя файла для выгрузки лога запуска.
//
// Параметры:
//   RunId - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяФайлаВыгрузки(Знач RunId) Экспорт

	Возврат "ar_log_" + RunId + "_" + ar_Утилиты.ВерсияРасширения() + ".json";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СборПакета

Функция НастройкиСбора(Знач Параметры)

	Настройки = Новый Структура;
	Настройки.Вставить("УровниЖурнала", "Ошибка");
	Настройки.Вставить("МаксСобытийЖурнала", 2000);
	Настройки.Вставить("МаксДочернихЗапусков", 20);

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Параметры);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция СобратьПакетПривилегированно(Знач RunId, Знач Настройки)

	Шапка = ШапкаЗапуска(RunId);
	Если Шапка = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'ar_ЛогЗапуска: запуск %1 не найден';
			|en = 'ar_ЛогЗапуска: run %1 not found'"), RunId);
	КонецЕсли;

	Пакет = Новый Структура;

	Мета = Новый Структура;
	Мета.Вставить("format", "agentrunner-run-log/1");
	Мета.Вставить("run_id", RunId);
	Мета.Вставить("extension_version", ar_Утилиты.ВерсияРасширения());
	Мета.Вставить("generated_at", ДатаВСтроку(ТекущаяДатаСеанса()));
	Мета.Вставить("generated_by", ИмяТекущегоПользователя());
	Мета.Вставить("times", "server local time; ar_МоментВремени converted from UTC, original in ar_МоментВремени_utc");
	Пакет.Вставить("meta", Мета);
	Пакет.Вставить("environment", СредаВыполнения());
	Пакет.Вставить("settings", НастройкиРасширения());

	Пакет.Вставить("run", СтрокаЗапуска(RunId));
	Пакет.Вставить("run_data", ДанныеЗапуска(RunId));

	ДочерниеИдентификаторы = ДочерниеЗапуски(RunId, Настройки.МаксДочернихЗапусков);
	ДочерниеДанные = Новый Массив;
	Для Каждого ДочернийId Из ДочерниеИдентификаторы Цикл
		Данные = ДанныеЗапуска(ДочернийId);
		Данные.Вставить("run", СтрокаЗапуска(ДочернийId));
		ДочерниеДанные.Добавить(Данные);
	КонецЦикла;

	Диалог = Шапка.Диалог;
	Пакет.Вставить("dialog", ЛентаДиалога(RunId, Диалог));
	Пакет.Вставить("dialog_catalog_item", ?(ЗначениеЗаполнено(Диалог),
		ОбъектВСтруктуру(Диалог), Недоступно(НСтр("ru = 'у запуска нет диалога'; en = 'the run has no dialog'"))));
	Пакет.Вставить("session", СессияЗапуска(RunId, Диалог));
	Пакет.Вставить("agent", ?(ЗначениеЗаполнено(Шапка.Агент),
		ОбъектВСтруктуру(Шапка.Агент), Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"))));
	Пакет.Вставить("llm_provider", ПровайдерАгента(Шапка.Агент));
	Пакет.Вставить("agent_memory", ПамятьАгента(Шапка.Агент));
	Пакет.Вставить("tools_registry", РеестрИнструментов(Шапка.Агент, ИменаИспользованныхИнструментов(Пакет.run_data, ДочерниеДанные)));

	Период = ПериодРаботы(Шапка, ДочерниеИдентификаторы);
	Если ТипЗнч(Период) = Тип("Структура") И Период.Свойство("Начало") Тогда
		Пакет.Вставить("period", Новый Структура("from, to", ДатаВСтроку(Период.Начало), ДатаВСтроку(Период.Конец)));
	Иначе
		Пакет.Вставить("period", Период);
	КонецЕсли;
	Пакет.Вставить("service_log", СлужебныйЛог(RunId, Период));
	Пакет.Вставить("event_log", ЖурналРегистрацииЗаПериод(Период, Настройки));
	Пакет.Вставить("child_runs", ДочерниеДанные);

	Возврат Пакет;

КонецФункции

// Версии платформы, конфигурации и расширений: по ним в другой базе видно,
// воспроизводится ли ошибка в той же среде.
Функция СредаВыполнения()

	СисИнфо = Новый СистемнаяИнформация;

	Конфигурация = Новый Структура;
	Конфигурация.Вставить("name", Метаданные.Имя);
	Конфигурация.Вставить("synonym", ВЗаписываемое(Метаданные.Синоним));
	Конфигурация.Вставить("version", Метаданные.Версия);
	Конфигурация.Вставить("vendor", ВЗаписываемое(Метаданные.Поставщик));

	Расширения = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name", Расширение.Имя);
		Элемент.Вставить("version", Расширение.Версия);
		Элемент.Вставить("active", Расширение.Активно);
		Расширения.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("platform_version", СисИнфо.ВерсияПриложения);
	Результат.Вставить("configuration", Конфигурация);
	Результат.Вставить("extensions", Расширения);
	Результат.Вставить("session_time_zone", ЧасовойПоясСеанса());
	Результат.Вставить("server_time_offset_sec", ЖурналРегистрации.СмещениеВремениСервера());
	Возврат Результат;

КонецФункции

// Настройки и справочная конфигурация расширения, влияющие на поведение агента.
// ar_ХранилищеСекретов не читается.
Функция НастройкиРасширения()

	Пустые = Новый Структура;

	Результат = Новый Структура;
	Результат.Вставить("constants", КонстантыРасширения());
	Результат.Вставить("config_profile",
		ТаблицаРегистра("ar_ПрофильКонфигурации", "ИСТИНА", Пустые, "Р.ar_Ключ"));
	Результат.Вставить("forbidden_objects",
		ТаблицаРегистра("ar_ЗапрещённыеОбъекты", "ИСТИНА", Пустые, "Р.ТипОбъекта"));
	Результат.Вставить("object_overrides",
		ТаблицаРегистра("ar_ПереопределенияОбъектов", "ИСТИНА", Пустые, "Р.ar_ЛогическоеИмя"));
	Результат.Вставить("pii_masking_rules",
		ТаблицаРегистра("ar_ПравилаМаскированияПДн", "ИСТИНА", Пустые, "Р.Объект, Р.ИмяПоля"));
	Результат.Вставить("additional_settings", ДополнительныеНастройки());
	Возврат Результат;

КонецФункции

Функция КонстантыРасширения()

	Результат = Новый Структура;
	Для Каждого Константа Из Метаданные.Константы Цикл
		Если СтрНачинаетсяС(Константа.Имя, "ar_") Тогда
			Результат.Вставить(Константа.Имя, ВЗаписываемое(Константы[Константа.Имя].Получить()));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ДополнительныеНастройки()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|УПОРЯДОЧИТЬ ПО
		|	Настройки.Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ОбъектВСтруктуру(Выборка.Ссылка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записи памяти агента (ar_ПамятьАгента) - то, что агент "помнил" в этом запуске.
Функция ПамятьАгента(Знач Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;

	Возврат ЭлементыСправочника("ar_ПамятьАгента", "Р.ar_Агент = &Агент",
		Новый Структура("Агент", Агент), "Р.ar_Создано УБЫВ", 500);

КонецФункции

// Реестр tools (ar_Инструменты): версия, доступность и причина недоступности
// объясняют отказы вида "tool не найден".
//   all  - все tools кратко (без манифеста и кода реализации): доступность агенту
//          определяется правилами, а не только таблицей tools агента;
//   used - полные записи (с манифестом) для вызванных в запуске tools и tools из таблицы агента.
Функция РеестрИнструментов(Знач Агент, Знач Имена)

	Ссылки = Новый Массив;
	Если ЗначениеЗаполнено(Агент) Тогда
		ОбъектАгента = Агент.ПолучитьОбъект();
		Если ОбъектАгента <> Неопределено Тогда
			Для Каждого СтрокаТЧ Из ОбъектАгента.ar_ДоступныеИнструменты Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.ar_Инструмент) Тогда
					Ссылки.Добавить(СтрокаТЧ.ar_Инструмент);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("all", ЭлементыСправочника("ar_Инструменты", "ИСТИНА", Новый Структура,
		"Р.ar_Имя", 1000, "ar_КодРеализации, ar_JSONManifest"));

	Если Имена.Количество() = 0 И Ссылки.Количество() = 0 Тогда
		Результат.Вставить("used", Новый Массив);
	Иначе
		Результат.Вставить("used", ЭлементыСправочника("ar_Инструменты",
			"Р.ar_Имя В (&Имена) ИЛИ Р.Ссылка В (&Ссылки)",
			Новый Структура("Имена, Ссылки", Имена, Ссылки), "Р.ar_Имя", 500, "ar_КодРеализации"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имена tools, вызванных в запуске и его дочерних запусках (по ar_ДействияАгента).
Функция ИменаИспользованныхИнструментов(Знач ДанныеКорня, Знач ДочерниеДанные)

	Имена = Новый Массив;
	ДобавитьИменаИнструментов(Имена, ДанныеКорня.actions);
	Для Каждого Данные Из ДочерниеДанные Цикл
		ДобавитьИменаИнструментов(Имена, Данные.actions);
	КонецЦикла;

	Возврат Имена;

КонецФункции

Процедура ДобавитьИменаИнструментов(Имена, Знач Действия)

	Для Каждого Действие Из Действия Цикл
		Имя = ЗначениеПоКлючу(Действие, "ar_ИмяИнструмента");
		Если ЗначениеЗаполнено(Имя) И Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Данные запуска без самой строки ar_Запуски: события, действия, метрики,
// approval, снимок состояния.
Функция ДанныеЗапуска(Знач RunId)

	Параметры = Новый Структура("RunId", RunId);

	Данные = Новый Структура;
	Данные.Вставить("events", РазвернутьPayload(
		ТаблицаРегистра("ar_СобытияЗапуска", "Р.ar_RunId = &RunId", Параметры, "Р.ar_Sequence",
			0, "", "ar_МоментВремени")));
	Данные.Вставить("actions",
		ТаблицаРегистра("ar_ДействияАгента", "Р.ar_ИдентификаторЗапуска = &RunId", Параметры, "Р.ar_Последовательность"));
	Данные.Вставить("llm_metrics",
		ТаблицаРегистра("ar_МетрикиLLM", "Р.ar_RunId = &RunId", Параметры, "Р.ar_Sequence"));
	Данные.Вставить("approvals",
		ТаблицаРегистра("ar_ОчередьApproval", "Р.ar_RunId = &RunId", Параметры, "Р.ar_Sequence"));
	Данные.Вставить("state_snapshot", СнимокЗапуска(RunId));

	Возврат Данные;

КонецФункции

Функция ШапкаЗапуска(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_АгентРеф КАК Агент,
		|	Запуски.ar_Диалог КАК Диалог,
		|	Запуски.ar_СтартовалВ КАК СтартовалВ,
		|	Запуски.ar_ЗавершенВ КАК ЗавершенВ
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Шапка = Новый Структура("Агент, Диалог, СтартовалВ, ЗавершенВ");
	ЗаполнитьЗначенияСвойств(Шапка, Выборка);
	Возврат Шапка;

КонецФункции

Функция СтрокаЗапуска(Знач RunId)

	Строки = ТаблицаРегистра("ar_Запуски", "Р.ar_ИдентификаторЗапуска = &RunId",
		Новый Структура("RunId", RunId), "Р.ar_ИдентификаторЗапуска", 1, "ar_StateSnapshot");

	Если Строки.Количество() = 0 Тогда
		Возврат Недоступно(НСтр("ru = 'запись запуска не найдена'; en = 'run record not found'"));
	КонецЕсли;

	Возврат Строки[0];

КонецФункции

// Идентификаторы дочерних запусков (обход в ширину, глубина до 3).
Функция ДочерниеЗапуски(Знач RunId, Знач Лимит)

	Результат = Новый Массив;
	Текущий = Новый Массив;
	Текущий.Добавить(RunId);

	Для Уровень = 1 По 3 Цикл
		Если Текущий.Количество() = 0 Или Результат.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Запуски.ar_ИдентификаторЗапуска КАК RunId
			|ИЗ
			|	РегистрСведений.ar_Запуски КАК Запуски
			|ГДЕ
			|	Запуски.ar_РодительскийИдентификаторЗапуска В (&Родители)
			|УПОРЯДОЧИТЬ ПО
			|	Запуски.ar_СтартовалВ";
		Запрос.УстановитьПараметр("Родители", Текущий);

		Следующий = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() И Результат.Количество() < Лимит Цикл
			Результат.Добавить(Выборка.RunId);
			Следующий.Добавить(Выборка.RunId);
		КонецЦикла;
		Текущий = Следующий;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛентаДиалога(Знач RunId, Знач Диалог)

	Параметры = Новый Структура("RunId, Диалог", RunId, Диалог);
	Если ЗначениеЗаполнено(Диалог) Тогда
		Условие = "Р.ar_Диалог = &Диалог ИЛИ Р.ar_Запуск = &RunId";
	Иначе
		Условие = "Р.ar_Запуск = &RunId";
	КонецЕсли;

	Лента = ТаблицаРегистра("ar_ЛентаДиалога", Условие, Параметры, "Р.ar_Диалог, Р.ar_Номер", 5000);
	Для Каждого Сообщение Из Лента Цикл
		Сообщение.Вставить("belongs_to_run", Сообщение.ar_Запуск = RunId);
	КонецЦикла;

	Возврат Лента;

КонецФункции

Функция СессияЗапуска(Знач RunId, Знач Диалог)

	Агент = Неопределено;
	Якорь = Неопределено;
	Если ЗначениеЗаполнено(Диалог) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Диалог, "ar_Агент, ar_Якорь");
		Агент = Реквизиты.ar_Агент;
		Якорь = Реквизиты.ar_Якорь;
	КонецЕсли;

	Параметры = Новый Структура("RunId, Агент, Якорь", RunId, Агент, Якорь);
	Условие = "Р.ar_ПоследнийИдентификаторЗапуска = &RunId";
	Если ЗначениеЗаполнено(Агент) И ЗначениеЗаполнено(Якорь) Тогда
		Условие = Условие + " ИЛИ (Р.ar_Агент = &Агент И Р.ar_Якорь = &Якорь)";
	КонецЕсли;

	Сессии = ТаблицаРегистра("ar_Сессии", Условие, Параметры, "Р.ar_Обновлена УБЫВ");
	Если Сессии.Количество() = 0 Тогда
		Возврат Недоступно(НСтр("ru = 'сессия запуска не найдена (запуск без сессии или сессия удалена)';
			|en = 'run session not found (a run without a session, or the session was deleted)'"));
	КонецЕсли;

	Возврат Сессии;

КонецФункции

Функция ПровайдерАгента(Знач Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;

	Провайдер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "ar_LLMПровайдер");
	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Возврат Недоступно(НСтр("ru = 'у агента не задан провайдер'; en = 'the agent has no provider'"));
	КонецЕсли;

	Возврат ОбъектВСтруктуру(Провайдер);

КонецФункции

// Снимок состояния цикла как он хранится (без миграции версии формата).
// Миграцию и запись в журнал регистрации делает ar_AuditЗапуски.ПрочитатьСнимок,
// а при несовместимом формате она возвращает Неопределено - именно тот случай,
// когда снимок нужен для разбора. Поэтому читаем значение напрямую.
Функция СнимокЗапуска(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_StateSnapshot КАК Снимок
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Недоступно(НСтр("ru = 'запись запуска не найдена'; en = 'run record not found'"));
	КонецЕсли;

	Если ТипЗнч(Выборка.Снимок) <> Тип("ХранилищеЗначения") Тогда
		Возврат Недоступно(НСтр("ru = 'снимок не сохранён'; en = 'snapshot is not stored'"));
	КонецЕсли;

	Попытка
		Значение = Выборка.Снимок.Получить();
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Значение = Неопределено Тогда
		Возврат Недоступно(НСтр("ru = 'снимок пуст'; en = 'snapshot is empty'"));
	КонецЕсли;

	Версия = ЗначениеПоКлючу(Значение, "v");
	Состояние = ЗначениеПоКлючу(Значение, "state");

	Результат = Новый Структура;
	Если Состояние = Неопределено Тогда
		// Нестандартный формат - отдаём содержимое целиком.
		Результат.Вставить("raw", ВЗаписываемое(Значение));
	Иначе
		Результат.Вставить("version", Версия);
		Результат.Вставить("state", ВЗаписываемое(Состояние));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение по ключу из Структуры или Соответствия; иначе Неопределено.
Функция ЗначениеПоКлючу(Знач Коллекция, Знач Ключ)

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция СлужебныйЛог(Знач RunId, Знач Период)

	Параметры = Новый Структура("RunId", RunId);
	Условие = "Р.ar_RunId = &RunId";
	Если Период.Свойство("Начало") Тогда
		Условие = Условие + " ИЛИ (Р.ar_RunId = """" И Р.ar_Момент МЕЖДУ &Начало И &Конец)";
		Параметры.Вставить("Начало", Период.Начало);
		Параметры.Вставить("Конец", Период.Конец);
	КонецЕсли;

	Возврат ТаблицаРегистра("ar_СлужебныйЛог", Условие, Параметры, "Р.ar_Момент", 5000);

КонецФункции

// Период работы агента: от старта первого до завершения последнего запуска
// (незавершённый - до текущего момента), с запасом по краям.
Функция ПериодРаботы(Знач Шапка, Знач ДочерниеИдентификаторы)

	Начала = Новый Массив;
	Концы = Новый Массив;
	ДобавитьГраницыПериода(Шапка, Начала, Концы);
	Для Каждого ДочернийId Из ДочерниеИдентификаторы Цикл
		ДобавитьГраницыПериода(ШапкаЗапуска(ДочернийId), Начала, Концы);
	КонецЦикла;

	Если Начала.Количество() = 0 Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска не заполнено время старта'; en = 'run start time is empty'"));
	КонецЕсли;

	Запас = 5;
	Начало = Начала[0];
	Конец = Концы[0];
	Для Каждого Значение Из Начала Цикл
		Начало = Мин(Начало, Значение);
	КонецЦикла;
	Для Каждого Значение Из Концы Цикл
		Конец = Макс(Конец, Значение);
	КонецЦикла;

	Возврат Новый Структура("Начало, Конец", Начало - Запас, Конец + Запас);

КонецФункции

Процедура ДобавитьГраницыПериода(Знач Шапка, Начала, Концы)

	Если Шапка = Неопределено Или Не ЗначениеЗаполнено(Шапка.СтартовалВ) Тогда
		Возврат;
	КонецЕсли;

	Начала.Добавить(Шапка.СтартовалВ);
	Концы.Добавить(?(ЗначениеЗаполнено(Шапка.ЗавершенВ), Шапка.ЗавершенВ, ТекущаяДатаСеанса()));

КонецПроцедуры

// Записи журнала регистрации за период работы агента (по умолчанию только
// ошибки, см. параметр УровниЖурнала). Привилегированный режим включён вызывающим.
// Отбор - по периоду и уровню, не по пользователю: у записей журнала нет признака
// агента, а ошибки платформы и фоновых заданий нужны так же, как сеанса пользователя.
Функция ЖурналРегистрацииЗаПериод(Знач Период, Знач Настройки)

	Если Не Период.Свойство("Начало") Тогда
		Возврат Период; // {unavailable: причина} из ПериодРаботы
	КонецЕсли;

	Уровни = УровниОтбораЖурнала(Настройки.УровниЖурнала);

	// Даты журнала - по часам компьютера сервера (см. ЖурналРегистрации.СмещениеВремениСервера).
	Смещение = ЖурналРегистрации.СмещениеВремениСервера();

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", Период.Начало + Смещение);
	Отбор.Вставить("ДатаОкончания", Период.Конец + Смещение);
	Если Уровни <> Неопределено Тогда
		Отбор.Вставить("Уровень", Уровни);
	КонецЕсли;

	Колонки = "Дата, Уровень, Событие, Пользователь, ИмяПользователя, ИмяПриложения,
		|Компьютер, Сеанс, Метаданные, Данные, ПредставлениеДанных, Комментарий";

	События = Новый ТаблицаЗначений;
	Попытка
		ВыгрузитьЖурналРегистрации(События, Отбор, Колонки, , Настройки.МаксСобытийЖурнала);
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Записи = Новый Массив;
	Для Каждого Событие Из События Цикл
		Запись = Новый Структура;
		Запись.Вставить("Дата", ДатаВСтроку(Событие.Дата - Смещение));
		Запись.Вставить("Уровень", Строка(Событие.Уровень));
		Запись.Вставить("Событие", ВЗаписываемое(Событие.Событие));
		Запись.Вставить("Пользователь", ВЗаписываемое(Событие.ИмяПользователя));
		Запись.Вставить("ИмяПриложения", ВЗаписываемое(Событие.ИмяПриложения));
		Запись.Вставить("Компьютер", ВЗаписываемое(Событие.Компьютер));
		Запись.Вставить("Сеанс", ВЗаписываемое(Событие.Сеанс));
		Запись.Вставить("Метаданные", ИмяМетаданных(Событие.Метаданные));
		Запись.Вставить("Данные", ВЗаписываемое(Событие.Данные));
		Запись.Вставить("ПредставлениеДанных", ВЗаписываемое(Событие.ПредставлениеДанных));
		Запись.Вставить("Комментарий", ВЗаписываемое(Событие.Комментарий));
		Записи.Добавить(Запись);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("levels", ?(Уровни = Неопределено, "all", Настройки.УровниЖурнала));
	Результат.Вставить("limit", Настройки.МаксСобытийЖурнала);
	Результат.Вставить("server_time_offset_sec", Смещение);
	Результат.Вставить("filter_from_server_time", ДатаВСтроку(Отбор.ДатаНачала));
	Результат.Вставить("filter_to_server_time", ДатаВСтроку(Отбор.ДатаОкончания));
	Результат.Вставить("rows_exported", События.Количество());
	Результат.Вставить("truncated", Записи.Количество() >= Настройки.МаксСобытийЖурнала);
	Результат.Вставить("entries", Записи);
	Возврат Результат;

КонецФункции

// Значения отбора по уровню записей журнала регистрации.
//
// Параметры:
//   Уровни - Строка - имена уровней через запятую либо "Все".
//
// Возвращаемое значение:
//   Массив из УровеньЖурналаРегистрации - значения для ключа отбора "Уровень";
//   Неопределено - отбор по уровню не нужен.
//
Функция УровниОтбораЖурнала(Знач Уровни)

	Если ПустаяСтрока(Уровни) Или НРег(СокрЛП(Уровни)) = "все" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ошибка", УровеньЖурналаРегистрации.Ошибка);
	Соответствие.Вставить("предупреждение", УровеньЖурналаРегистрации.Предупреждение);
	Соответствие.Вставить("информация", УровеньЖурналаРегистрации.Информация);
	Соответствие.Вставить("примечание", УровеньЖурналаРегистрации.Примечание);

	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Уровни, ",", Ложь) Цикл
		Уровень = Соответствие.Получить(НРег(СокрЛП(Имя)));
		Если Уровень = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ar_ЛогЗапуска: неизвестный уровень журнала регистрации ""%1""';
				|en = 'ar_ЛогЗапуска: unknown event log level ""%1""'"), СокрЛП(Имя));
		КонецЕсли;
		Результат.Добавить(Уровень);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяМетаданных(Знач ОбъектМетаданных)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ОбъектМетаданных.ПолноеИмя();
	Исключение
		Возврат ВЗаписываемое(ОбъектМетаданных);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ЧтениеДанных

// Все поля записей регистра сведений (измерения, ресурсы, реквизиты) по условию.
// Поля берутся из метаданных - выгрузка не теряет реквизиты, добавленные позже.
//
// Параметры:
//   ИмяРегистра - Строка - имя регистра сведений без префикса.
//   Условие     - Строка - текст условия запроса; регистр доступен как "Р".
//   Параметры   - Структура - параметры запроса.
//   Порядок     - Строка - текст упорядочивания.
//   Лимит       - Число  - максимум записей (0 - 20000).
//   Пропустить  - Строка - имена полей через запятую, которые не выгружать.
//   ПоляUTC     - Строка - имена полей-дат в UTC через запятую: в записи они приводятся
//                          к серверному времени, исходное значение - в поле "<имя>_utc".
//
// Возвращаемое значение:
//   Массив из Структура - записи; значения приведены к JSON-совместимым типам.
//
Функция ТаблицаРегистра(Знач ИмяРегистра, Знач Условие, Знач Параметры, Знач Порядок,
	Знач Лимит = 0, Знач Пропустить = "", Знач ПоляUTC = "")

	МетаРегистр = Метаданные.РегистрыСведений[ИмяРегистра];
	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);
	ПоляВремениUTC = СтрРазделить(ПоляUTC, ",", Ложь);

	ПоляЗапроса = Новый Массив;
	Для Каждого Коллекция Из СоставПолейРегистра(МетаРегистр) Цикл
		Для Каждого Поле Из Коллекция Цикл
			Если Исключаемые.Найти(Поле.Имя) = Неопределено Тогда
				ПоляЗапроса.Добавить("Р." + Поле.Имя + " КАК " + Поле.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Лимит = 0 Тогда
		Лимит = 20000;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(ПоляЗапроса, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ РегистрСведений." + ИмяРегистра + " КАК Р" + Символы.ПС
		+ "ГДЕ " + Условие + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО " + Порядок;
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Для Каждого Коллекция Из СоставПолейРегистра(МетаРегистр) Цикл
			Для Каждого Поле Из Коллекция Цикл
				Если Исключаемые.Найти(Поле.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Значение = Выборка[Поле.Имя];
				Если ПоляВремениUTC.Найти(Поле.Имя) <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
					Запись.Вставить(Поле.Имя + "_utc", ДатаВСтроку(Значение));
					Значение = МестноеВремя(Значение, ЧасовойПоясСеанса());
				КонецЕсли;
				Запись.Вставить(Поле.Имя, ВЗаписываемое(Значение));
			КонецЦикла;
		КонецЦикла;
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоставПолейРегистра(Знач МетаРегистр)

	Состав = Новый Массив;
	Состав.Добавить(МетаРегистр.Измерения);
	Состав.Добавить(МетаРегистр.Ресурсы);
	Состав.Добавить(МетаРегистр.Реквизиты);
	Возврат Состав;

КонецФункции

// Все реквизиты элементов справочника (без табличных частей) по условию.
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника без префикса "Справочник.".
//   Условие        - Строка - текст условия запроса; справочник доступен как "Р".
//   Параметры      - Структура - параметры запроса.
//   Порядок        - Строка - текст упорядочивания.
//   Лимит          - Число  - максимум элементов.
//   Пропустить     - Строка - имена реквизитов через запятую, которые не выгружать.
//
// Возвращаемое значение:
//   Массив из Структура - элементы; значения приведены к JSON-совместимым типам.
//
Функция ЭлементыСправочника(Знач ИмяСправочника, Знач Условие, Знач Параметры, Знач Порядок,
	Знач Лимит, Знач Пропустить = "")

	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);

	ИменаРеквизитов = Новый Массив;
	ПоляЗапроса = Новый Массив;
	ПоляЗапроса.Добавить("Р.Ссылка КАК Ссылка");
	Для Каждого Реквизит Из Метаданные.Справочники[ИмяСправочника].Реквизиты Цикл
		Если Исключаемые.Найти(Реквизит.Имя) = Неопределено Тогда
			ИменаРеквизитов.Добавить(Реквизит.Имя);
			ПоляЗапроса.Добавить("Р." + Реквизит.Имя + " КАК " + Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(ПоляЗапроса, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ Справочник." + ИмяСправочника + " КАК Р" + Символы.ПС
		+ "ГДЕ " + Условие + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО " + Порядок;
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("ref", Строка(Выборка.Ссылка));
		Запись.Вставить("uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			Запись.Вставить(ИмяРеквизита, ВЗаписываемое(Выборка[ИмяРеквизита]));
		КонецЦикла;
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Реквизиты и табличные части элемента справочника.
Функция ОбъектВСтруктуру(Знач Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Недоступно(НСтр("ru = 'ссылка пуста'; en = 'empty reference'"));
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат Недоступно(НСтр("ru = 'объект удалён'; en = 'object was deleted'"));
		КонецЕсли;
		МетаОбъект = Ссылка.Метаданные();

		Результат = Новый Структура;
		Результат.Вставить("ref", Строка(Ссылка));
		Результат.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
		Результат.Вставить("metadata", МетаОбъект.ПолноеИмя());
		Результат.Вставить("Наименование", ВЗаписываемое(Объект.Наименование));
		Результат.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);

		Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
			Результат.Вставить(Реквизит.Имя, ВЗаписываемое(Объект[Реквизит.Имя]));
		КонецЦикла;

		Для Каждого ТабличнаяЧасть Из МетаОбъект.ТабличныеЧасти Цикл
			Строки = Новый Массив;
			Для Каждого СтрокаТЧ Из Объект[ТабличнаяЧасть.Имя] Цикл
				СтрокаСтруктура = Новый Структура;
				Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
					СтрокаСтруктура.Вставить(Реквизит.Имя, ВЗаписываемое(СтрокаТЧ[Реквизит.Имя]));
				КонецЦикла;
				Строки.Добавить(СтрокаСтруктура);
			КонецЦикла;
			Результат.Вставить(ТабличнаяЧасть.Имя, Строки);
		КонецЦикла;
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// PayloadJSON событий - в объект, чтобы промпты и аргументы читались без
// двойного экранирования. Если разобрать не удалось - остаётся строка.
Функция РазвернутьPayload(Знач События)

	Для Каждого Событие Из События Цикл
		Если Не Событие.Свойство("ar_PayloadJSON") Или ПустаяСтрока(Событие.ar_PayloadJSON) Тогда
			Продолжить;
		КонецЕсли;
		Payload = ar_JSON.ИзJSON(Событие.ar_PayloadJSON);
		Если Payload <> Неопределено Тогда
			Событие.Удалить("ar_PayloadJSON");
			Событие.Вставить("payload", ВЗаписываемое(Payload));
		КонецЕсли;
	КонецЦикла;

	Возврат События;

КонецФункции

Функция Недоступно(Знач Причина)

	Возврат Новый Структура("unavailable", Причина);

КонецФункции

#КонецОбласти

#Область ПриведениеЗначений

// Приводит значение к типам, которые принимает ar_JSON: ссылки и прочие
// платформенные объекты - в строковое представление, даты - в строку,
// ХранилищеЗначения - в его содержимое, строки - с маскированием секретов.
Функция ВЗаписываемое(Знач Значение, Знач Глубина = 0)

	Если Глубина > МаксГлубинаВложенности() Тогда
		Возврат "<depth limit>";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено Или ТипЗначения = Тип("Null") Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат ar_Утилиты.МаскироватьСекреты(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ДатаВСтроку(Значение);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат ВЗаписываемое(Значение.Получить(), Глубина + 1);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Возврат СтруктуруВЗаписываемое(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат СоответствиеВЗаписываемое(Значение, Глубина);
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат МассивВЗаписываемое(Значение, Глубина);
	Иначе
		Возврат ЗначениеСтрокой(Значение, ТипЗначения);
	КонецЕсли;

КонецФункции

Функция МаксГлубинаВложенности()

	Возврат 15;

КонецФункции

Функция СтруктуруВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Структура;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Элемент.Ключ, ВЗаписываемое(Элемент.Значение, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоответствиеВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Строка(Элемент.Ключ), ВЗаписываемое(Элемент.Значение, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МассивВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Результат.Добавить(ВЗаписываемое(Элемент, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ссылки и прочие платформенные значения - строковое представление
// (с маскированием секретов); если представление получить нельзя - имя типа.
Функция ЗначениеСтрокой(Знач Значение, Знач ТипЗначения)

	Попытка
		Возврат ar_Утилиты.МаскироватьСекреты(Строка(Значение));
	Исключение
		Возврат "<" + Строка(ТипЗначения) + ">";
	КонецПопытки;

КонецФункции

Функция ДатаВСтроку(Знач Дата)

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Дата, "ДФ='yyyy-MM-dd HH:mm:ss'");

КонецФункции

Функция ИмяТекущегоПользователя()

	Попытка
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ТекстовыйВид

Процедура ДобавитьЗаголовок(Строки, Знач Заголовок)

	Строки.Добавить("");
	Строки.Добавить("=== " + Заголовок + " ===");

КонецПроцедуры

Функция ЧислоЭлементов(Знач Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение.Количество(), 0);

КонецФункции

// Усечение длинных значений в читаемом виде; полные данные - в JSON.
Функция ОграничитьТекст(Знач Текст, Знач Лимит)

	Если СтрДлина(Текст) > Лимит Тогда
		Возврат Лев(Текст, Лимит) + "... (полностью - в JSON)";
	КонецЕсли;

	Возврат Текст;

КонецФункции

Процедура ДобавитьСтруктуру(Строки, Знач Данные, Знач Пропустить = "")

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Строки.Добавить(Строка(Данные));
		Возврат;
	КонецЕсли;

	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);
	Для Каждого Элемент Из Данные Цикл
		Если Исключаемые.Найти(Элемент.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Элемент.Значение;
		Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Структура")
			Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Значение = "<" + Строка(ТипЗнч(Значение)) + ", см. JSON>";
		КонецЕсли;
		Строки.Добавить("  " + Элемент.Ключ + ": " + ОграничитьТекст(Строка(Значение), 2000));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМассивСтруктур(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ДобавитьСтруктуру(Строки, Данные);
		Возврат;
	КонецЕсли;

	Если Данные.Количество() = 0 Тогда
		Строки.Добавить("(нет записей)");
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		Для Каждого Поле Из Элемент Цикл
			Значение = Поле.Значение;
			Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Структура")
				Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
				Значение = ar_JSON.ВЗначениеJSON(Значение);
			КонецЕсли;
			Строки.Добавить("  " + Поле.Ключ + ": " + ОграничитьТекст(Строка(Значение), 2000));
		КонецЦикла;
		Строки.Добавить("");
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСреду(Строки, Знач Среда)

	Строки.Добавить("  platform_version: " + Среда.platform_version);
	Строки.Добавить("  configuration: " + Среда.configuration.name + " " + Среда.configuration.version);
	Строки.Добавить("  session_time_zone: " + Среда.session_time_zone
		+ ", server_time_offset_sec: " + Формат(Среда.server_time_offset_sec, "ЧН=0; ЧГ=0"));
	Для Каждого Расширение Из Среда.extensions Цикл
		Строки.Добавить("  extension: " + Расширение.name + " " + Расширение.version
			+ ?(Расширение.active, "", " (отключено)"));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРеестрИнструментов(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Массив") Или Данные.Количество() = 0 Тогда
		Строки.Добавить("(нет записей)");
		Возврат;
	КонецЕсли;

	Для Каждого Инструмент Из Данные Цикл
		Строки.Добавить(СтрШаблон("  %1 v%2: доступен=%3, включён=%4, причина недоступности: %5",
			Инструмент.ar_Имя, Инструмент.ar_Версия, Инструмент.ar_Доступен, Инструмент.ar_Включён,
			Инструмент.ar_ПричинаНедоступности));
	КонецЦикла;

КонецПроцедуры

// Единая хронология: события запуска, диалог, служебный лог, журнал регистрации.
Процедура ДобавитьХронологию(Строки, Знач Пакет)

	Хронология = Новый ТаблицаЗначений;
	Хронология.Колонки.Добавить("Момент");
	Хронология.Колонки.Добавить("Порядок");
	Хронология.Колонки.Добавить("Текст");

	Порядок = 0;

	Для Каждого Событие Из Пакет.run_data.events Цикл
		Порядок = Порядок + 1;
		Payload = ?(Событие.Свойство("payload"), ar_JSON.ВЗначениеJSON(Событие.payload), "");
		Payload = ОграничитьТекст(Payload, 1500);
		ДобавитьВХронологию(Хронология, Порядок, Событие.ar_МоментВремени,
			СтрШаблон("СОБЫТИЕ #%1 %2 %3", Событие.ar_Sequence, Событие.ar_ТипСобытия, Payload));
	КонецЦикла;

	Если ТипЗнч(Пакет.dialog) = Тип("Массив") Тогда
		Для Каждого Сообщение Из Пакет.dialog Цикл
			Порядок = Порядок + 1;
			ДобавитьВХронологию(Хронология, Порядок, Сообщение.ar_Момент,
				СтрШаблон("ДИАЛОГ [%1/%2]%3 %4", Сообщение.ar_Автор, Сообщение.ar_ВидСообщения,
					?(Сообщение.belongs_to_run, "", " (другой запуск)"), Сообщение.ar_Текст));
		КонецЦикла;
	КонецЕсли;

	Если ТипЗнч(Пакет.service_log) = Тип("Массив") Тогда
		Для Каждого Запись Из Пакет.service_log Цикл
			Порядок = Порядок + 1;
			ДобавитьВХронологию(Хронология, Порядок, Запись.ar_Момент,
				СтрШаблон("СЛУЖЕБНЫЙ ЛОГ [%1] %2/%3: %4", Запись.ar_Уровень, Запись.ar_Источник,
					Запись.ar_Событие, Запись.ar_Текст));
		КонецЦикла;
	КонецЕсли;

	Если Пакет.event_log.Свойство("entries") Тогда
		Для Каждого Запись Из Пакет.event_log.entries Цикл
			Порядок = Порядок + 1;
			ДобавитьВХронологию(Хронология, Порядок, Запись.Дата,
				СтрШаблон("ЖУРНАЛ РЕГИСТРАЦИИ [%1] %2, пользователь %3, сеанс %4: %5",
					Запись.Уровень, Запись.Событие, Запись.Пользователь, Запись.Сеанс, Запись.Комментарий));
		КонецЦикла;
	ИначеЕсли Пакет.event_log.Свойство("unavailable") Тогда
		Строки.Добавить("(журнал регистрации недоступен: " + Пакет.event_log.unavailable + ")");
	КонецЕсли;

	Хронология.Сортировать("Момент, Порядок");
	Для Каждого Запись Из Хронология Цикл
		Строки.Добавить(Запись.Момент + "  " + Запись.Текст);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВХронологию(Хронология, Знач Порядок, Знач Момент, Знач Текст)

	Запись = Хронология.Добавить();
	Запись.Момент = Строка(Момент);
	Запись.Порядок = Порядок;
	Запись.Текст = Текст;

КонецПроцедуры

Процедура ДобавитьСообщенияСнимка(Строки, Знач Снимок)

	Сообщения = ЗначениеПоКлючу(ЗначениеПоКлючу(Снимок, "state"), "Сообщения");

	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Причина = ЗначениеПоКлючу(Снимок, "unavailable");
		Если Причина <> Неопределено Тогда
			Строки.Добавить("(снимок недоступен: " + Причина + ")");
		ИначеЕсли ЗначениеПоКлючу(Снимок, "raw") <> Неопределено Тогда
			Строки.Добавить("(нестандартный формат снимка, содержимое - в JSON)");
		Иначе
			Строки.Добавить("(в снимке нет списка сообщений)");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Номер = Номер + 1;
		Текст = ?(ТипЗнч(Сообщение) = Тип("Строка"), Сообщение, ar_JSON.ВЗначениеJSON(Сообщение));
		Строки.Добавить("#" + Номер + " " + ОграничитьТекст(Текст, 3000));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
