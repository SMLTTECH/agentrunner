////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ЛогЗапуска (agentrunner-57, на базе PR GitHub #1 detroru).
//
// Полный лог одного запуска агента для разбора в другой базе: запуск, события
// (в т.ч. промпты LLM), вызовы инструментов (с ответами, agentrunner-55), снимок
// состояния (сообщения и результаты инструментов), метрики LLM, подтверждения,
// диалог с пользователем, сессия, предмет запуска и захват (agentrunner-32/35),
// план агента и выполнение плана (agentrunner-48), настройки агента и провайдера,
// служебный лог, ошибки из журнала регистрации за период работы.
//
// Два представления одних и тех же данных:
//   * СобратьПакет / ПакетВJSON - машинный пакет (JSON) для выгрузки в файл;
//   * ТекстовыйВид              - читаемая хронология для просмотра в форме.
//
// Выполняется в привилегированном режиме (точечно, Попытка/Исключение): роли
// пользователей не имеют Read на служебные регистры и права на журнал
// регистрации. Контракт тот же, что у ar_ДиагностикаОчистка.
//
// Доступ: привилегированный сбор обходит фильтр по ответственному из
// ar_КонсольДанные, поэтому пакет собирается только для полноправного
// пользователя (Пользователи.ЭтоПолноправныйПользователь). Модуль без вызова
// с клиента: форма обращается к нему через свои серверные функции.
//
// Безопасность:
//   * ключи API не выгружаются: ar_ХранилищеСекретов не читается, у провайдера
//     выгружается только явно перечисленный набор реквизитов (спека 2.5),
//     включая идентификатор ключа;
//   * значения дополнительных настроек, чьё наименование или ключ содержит
//     подстроку про секрет, заменяются на "***";
//   * весь итоговый текст проходит через ar_Утилиты.МаскироватьСекреты (SEC-02);
//   * ПДн по умолчанию не маскируются (нужны исходные данные для разбора) -
//     файл передавать только по защищенному каналу (предупреждение в форме
//     выгрузки). Режим "без ПДн" (ключ МаскироватьПДн в Параметрах, agentrunner-244)
//     маскирует ПДн в строковых значениях пакета, а поля с чувствительными
//     именами скрывает целиком - см. #Область МаскированиеПДн.
//
// Недоступный раздел не пропускается молча: на его месте {"unavailable": "причина"}.
//
// Время (спека 2.3, проверено по коду ядра и дампу метаданных, см. mcp.md):
//   * ar_СобытияЗапуска.ar_МоментВремени пишется ядром в UTC - при выгрузке
//     пересчитывается в пояс сеанса, исходное значение сохраняется в поле
//     "<имя>_utc";
//   * ar_Запуски.ar_СтартовалВ/ar_ЗавершенВ/ar_ПоследнийПульс, ar_ЛентаДиалога.ar_Момент,
//     ar_СлужебныйЛог.ar_Момент, ar_ОчередьApproval - пишутся ТекущаяДатаСеанса(),
//     т.е. уже серверное локальное время;
//   * отбор журнала регистрации приводится к времени сервера смещением
//     ЖурналРегистрации.СмещениеВремениСервера() и обратно.
// Формат всех дат в пакете - "yyyy-MM-dd HH:mm:ss"; meta.times описывает состав.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Собирает пакет лога запуска.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска: UUID либо служебный
//                          запуск SCHED-09 ("s09_...", признак - см.
//                          ar_Планировщик.ЭтоИдентификаторСлужебногоЗапуска).
//   Параметры            - Структура - необязательно:
//     * УровниЖурнала        - Строка - уровни записей журнала регистрации через запятую:
//                                       "Ошибка", "Предупреждение", "Информация", "Примечание";
//                                       "Все" - без отбора по уровню, весь журнал за период
//                                       работы агента (по умолчанию "Ошибка").
//     * МаксСобытийЖурнала   - Число  - лимит записей журнала регистрации (по умолчанию 2000).
//     * МаксДочернихЗапусков - Число  - лимит дочерних запусков (по умолчанию 20).
//     * МаскироватьПДн       - Булево - режим "без ПДн": ПДн в строковых значениях пакета
//                                       заменяются метками, поля с чувствительными именами
//                                       скрываются целиком (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Структура - пакет; значения приведены к JSON-совместимым типам.
//
Функция СобратьПакет(Знач ИдентификаторЗапуска, Знач Параметры = Неопределено) Экспорт

	Если Не ar_Утилиты.ЭтоUUID(ИдентификаторЗапуска)
		И Не ar_Планировщик.ЭтоИдентификаторСлужебногоЗапуска(ИдентификаторЗапуска) Тогда
		ВызватьИсключение НСтр(
			"ru = 'ar_ЛогЗапуска: ИдентификаторЗапуска должен быть UUID или идентификатором служебного запуска';
			|en = 'ar_ЛогЗапуска: run id must be a UUID or a service run id'");
	КонецЕсли;

	ПараметрыСбора = НастройкиСбора(Параметры);

	// Проверка ДО повышения привилегий: в привилегированном режиме любой
	// пользователь считался бы полноправным.
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав: лог запуска доступен полноправному пользователю.';
			|en = 'Insufficient rights: the run log is available to full-rights users only.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Пакет = СобратьПакетПривилегированно(ИдентификаторЗапуска, ПараметрыСбора);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ПараметрыСбора.МаскироватьПДн Тогда
		// Режим "без ПДн" (agentrunner-244): маскирование выполняется после снятия
		// привилегированного режима - правила регистра читаются обычными правами,
		// само маскирование прав не требует. Правила читаются одним запросом здесь,
		// на начале маскирования, и дальше передаются по рекурсии (не в цикле).
		ПрименитьМаскированиеПДн(Пакет, 0, ПравилаПолногоСокрытияПакета());
	КонецЕсли;

	Возврат Пакет;

КонецФункции

// Пакет лога запуска в виде JSON-текста (с отступами, секреты замаскированы).
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID или служебный
//                          запуск, см. СобратьПакет).
//   Параметры            - Структура - см. СобратьПакет.
//
// Возвращаемое значение:
//   Строка
//
Функция ПакетВJSON(Знач ИдентификаторЗапуска, Знач Параметры = Неопределено) Экспорт

	Пакет = СобратьПакет(ИдентификаторЗапуска, Параметры);

	ТекстJSON = ar_JSON.КрасивыйФорматJSON(Пакет);
	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение НСтр(
			"ru = 'ar_ЛогЗапуска: не удалось сериализовать пакет в JSON (см. журнал регистрации)';
			|en = 'ar_ЛогЗапуска: failed to serialize the package to JSON (see the event log)'");
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(ТекстJSON);

КонецФункции

// Читаемый текстовый вид лога запуска: единая хронология (события, вызовы
// инструментов, диалог, служебный лог, журнал регистрации), затем вызовы
// инструментов, метрики, подтверждения, сообщения из снимка состояния.
// В режиме "без ПДн" (МаскироватьПДн) текст показывает уже замаскированный
// пакет (маскирование - в СобратьПакет), в шапку добавляется пометка режима.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID или служебный
//                          запуск, см. СобратьПакет).
//   Параметры            - Структура - см. СобратьПакет.
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстовыйВид(Знач ИдентификаторЗапуска, Знач Параметры = Неопределено) Экспорт

	ПараметрыСбора = НастройкиСбора(Параметры);
	Пакет = СобратьПакет(ИдентификаторЗапуска, Параметры);

	Строки = Новый Массив;
	Мета = Пакет.meta;
	Строки.Добавить(НСтр("ru = 'AgentRunner - лог запуска'; en = 'AgentRunner - run log'") + " "
		+ ИдентификаторЗапуска);
	Строки.Добавить(НСтр("ru = 'Версия расширения'; en = 'Extension version'") + ": " + Мета.extension_version);
	Если ПараметрыСбора.МаскироватьПДн Тогда
		// Пометка режима в шапке текста: текст может быть скопирован без окна,
		// в заголовке которого форма показывает " (без ПДн)".
		Строки.Добавить(НСтр("ru = 'Персональные данные замаскированы'; en = 'Personal data masked'"));
	КонецЕсли;
	Строки.Добавить(НСтр("ru = 'Сформирован'; en = 'Generated'") + ": " + Мета.generated_at + ", "
		+ НСтр("ru = 'пользователь'; en = 'user'") + ": " + Мета.generated_by);
	Строки.Добавить(НСтр("ru = 'Время - серверное. Полные данные - в JSON-выгрузке.';
		|en = 'Times are server-local. Full data is in the JSON export.'"));
	Строки.Добавить("");

	ДобавитьЗаголовок(Строки, НСтр("ru = 'СРЕДА'; en = 'ENVIRONMENT'"));
	ДобавитьСреду(Строки, Пакет.environment);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ЗАПУСК'; en = 'RUN'"));
	ДобавитьСтруктуру(Строки, Пакет.run);
	Если ТипЗнч(Пакет.run) = Тип("Структура") И Пакет.run.Свойство("ar_Триггер") Тогда
		// Решение человека 2026-10-08: триггер выводится общей функцией представления
		// ar_КонсольДанные.ПредставлениеТриггера (введена agentrunner-53), своей копии не заводим.
		Строки.Добавить("  " + НСтр("ru = 'Триггер (представление)'; en = 'Trigger (presentation)'")
			+ ": " + ar_КонсольДанные.ПредставлениеТриггера(Пакет.run.ar_Триггер));
	КонецЕсли;

	Если Пакет.Свойство("agent") И ТипЗнч(Пакет.agent) = Тип("Структура") Тогда
		ДобавитьЗаголовок(Строки, НСтр("ru = 'АГЕНТ'; en = 'AGENT'"));
		ДобавитьСтруктуру(Строки, Пакет.agent, "ar_Инструкция");
	КонецЕсли;

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПРЕДМЕТ'; en = 'SUBJECT'"));
	ДобавитьПредмет(Строки, Пакет.subject);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПЛАН'; en = 'PLAN'"));
	ДобавитьПлан(Строки, Пакет.plan);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'НАСТРОЙКИ РАСШИРЕНИЯ (константы)'; en = 'EXTENSION SETTINGS (constants)'"));
	ДобавитьСтруктуру(Строки, Пакет.settings.constants);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПРОФИЛЬ КОНФИГУРАЦИИ'; en = 'CONFIG PROFILE'"));
	ДобавитьМассивСтруктур(Строки, Пакет.settings.config_profile);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ЗАПРЕЩЁННЫЕ ОБЪЕКТЫ'; en = 'FORBIDDEN OBJECTS'"));
	ДобавитьМассивСтруктур(Строки, Пакет.settings.forbidden_objects);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПЕРЕОПРЕДЕЛЕНИЯ ОБЪЕКТОВ'; en = 'OBJECT OVERRIDES'"));
	ДобавитьМассивСтруктур(Строки, Пакет.settings.object_overrides);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПРАВИЛА МАСКИРОВАНИЯ ПДН'; en = 'PII MASKING RULES'"));
	ДобавитьМассивСтруктур(Строки, Пакет.settings.pii_masking_rules);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ'; en = 'ADDITIONAL SETTINGS'"));
	ДобавитьМассивСтруктур(Строки, Пакет.settings.additional_settings);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'РЕЕСТР ИНСТРУМЕНТОВ'; en = 'TOOLS REGISTRY'"));
	ДобавитьРеестрИнструментов(Строки, Пакет.tools_registry.all);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПАМЯТЬ АГЕНТА'; en = 'AGENT MEMORY'"));
	ДобавитьМассивСтруктур(Строки, Пакет.agent_memory);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ХРОНОЛОГИЯ'; en = 'CHRONOLOGY'"));
	ДобавитьХронологию(Строки, Пакет);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ВЫЗОВЫ ИНСТРУМЕНТОВ'; en = 'TOOL CALLS'"));
	ДобавитьВызовыИнструментов(Строки, Пакет.run_data.actions);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'МЕТРИКИ LLM'; en = 'LLM METRICS'"));
	ДобавитьМассивСтруктур(Строки, Пакет.run_data.llm_metrics);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'ПОДТВЕРЖДЕНИЯ'; en = 'APPROVALS'"));
	ДобавитьМассивСтруктур(Строки, Пакет.run_data.approvals);

	ДобавитьЗаголовок(Строки, НСтр("ru = 'СООБЩЕНИЯ ИЗ СНИМКА СОСТОЯНИЯ'; en = 'MESSAGES FROM STATE SNAPSHOT'"));
	// agentrunner-371: устаревший снимок (запуск продолжался после паузы) -
	// примечание перед сообщениями.
	ПримечаниеСнимка = ЗначениеПоКлючу(ЗначениеПоКлючу(Пакет.plan, "snapshot"), "примечание");
	Если ЗначениеЗаполнено(ПримечаниеСнимка) Тогда
		Строки.Добавить("(" + ПримечаниеСнимка + ")");
	КонецЕсли;
	ДобавитьСообщенияСнимка(Строки, Пакет.run_data.state_snapshot);

	Если Пакет.child_runs.Количество() > 0 Тогда
		ДобавитьЗаголовок(Строки, НСтр("ru = 'ДОЧЕРНИЕ ЗАПУСКИ (краткая сводка, детали - в JSON)';
			|en = 'CHILD RUNS (brief summary, details in JSON)'"));
		Для Каждого Дочерний Из Пакет.child_runs Цикл
			ДобавитьСтруктуру(Строки, Дочерний.run);
			Строки.Добавить("  " + НСтр("ru = 'событий'; en = 'events'") + ": " + ЧислоЭлементов(Дочерний.events)
				+ ", " + НСтр("ru = 'вызовов инструментов'; en = 'tool calls'") + ": "
				+ ЧислоЭлементов(Дочерний.actions));
			Строки.Добавить("");
		КонецЦикла;
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Имя файла для выгрузки лога запуска. В режиме "без ПДн" - с суффиксом
// "_masked", чтобы файлы двух режимов не перепутать на диске (содержимое
// различается и меткой meta.pii_masked).
//
// Параметры:
//   ИдентификаторЗапуска - Строка  - идентификатор запуска.
//   МаскироватьПДн       - Булево - режим "без ПДн" (по умолчанию Ложь).
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяФайлаВыгрузки(Знач ИдентификаторЗапуска, Знач МаскироватьПДн = Ложь) Экспорт

	Суффикс = ?(МаскироватьПДн, "_masked", "");
	Возврат "ar_log_" + ИдентификаторЗапуска + "_" + ar_Утилиты.ВерсияРасширения() + Суффикс + ".json";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СборПакета

Функция НастройкиСбора(Знач Параметры)

	Настройки = Новый Структура;
	Настройки.Вставить("УровниЖурнала", "Ошибка");
	Настройки.Вставить("МаксСобытийЖурнала", 2000);
	Настройки.Вставить("МаксДочернихЗапусков", 20);
	// Режим "без ПДн" (agentrunner-244): по умолчанию выключен; ЗаполнитьЗначенияСвойств
	// ниже подхватывает ключ из Параметров вызывающего - старые вызовы не меняются.
	Настройки.Вставить("МаскироватьПДн", Ложь);

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Параметры);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция СобратьПакетПривилегированно(Знач ИдентификаторЗапуска, Знач ПараметрыСбора)

	Шапка = ШапкаЗапуска(ИдентификаторЗапуска);
	Если Шапка = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'ar_ЛогЗапуска: запуск %1 не найден';
			|en = 'ar_ЛогЗапуска: run %1 not found'"), ИдентификаторЗапуска);
	КонецЕсли;

	Пакет = Новый Структура;

	Мета = Новый Структура;
	Мета.Вставить("format", "agentrunner-run-log/1");
	Мета.Вставить("run_id", ИдентификаторЗапуска);
	Мета.Вставить("extension_version", ar_Утилиты.ВерсияРасширения());
	Мета.Вставить("generated_at", ДатаВСтроку(ТекущаяДатаСеанса()));
	Мета.Вставить("generated_by", ИмяТекущегоПользователя());
	Мета.Вставить("times", НСтр("ru = 'пояс сеанса, формат yyyy-MM-dd HH:mm:ss; у событий ar_МоментВремени
		|исходный пояс UTC (исходное значение - в поле <имя>_utc), остальные поля пишутся серверным локальным временем';
		|en = 'session time zone, yyyy-MM-dd HH:mm:ss; event ar_МоментВремени originates in UTC (raw value kept in
		|<field>_utc); other fields are written in server-local time'"));
	// Метки режима "без ПДн" (agentrunner-244): ставятся до обхода маскирования -
	// сами булево/строка, маскерами не трогаются. pii_masking_version - версия
	// эвристик, для сравнения файлов разных выгрузок.
	Мета.Вставить("pii_masked", ПараметрыСбора.МаскироватьПДн);
	Мета.Вставить("pii_masking_version", "1");
	Пакет.Вставить("meta", Мета);
	Пакет.Вставить("environment", СредаВыполнения());
	Пакет.Вставить("settings", НастройкиРасширения());

	Пакет.Вставить("run", СтрокаЗапуска(ИдентификаторЗапуска));
	Пакет.Вставить("run_data", ДанныеЗапуска(ИдентификаторЗапуска));

	ДочерниеИдентификаторы = ДочерниеЗапуски(ИдентификаторЗапуска, ПараметрыСбора.МаксДочернихЗапусков);
	ДочерниеДанные = Новый Массив;
	ИдентификаторыРаботы = Новый Массив;
	ИдентификаторыРаботы.Добавить(ИдентификаторЗапуска);
	Для Каждого ИдентификаторДочернего Из ДочерниеИдентификаторы Цикл
		ИдентификаторыРаботы.Добавить(ИдентификаторДочернего);
		Данные = ДанныеЗапуска(ИдентификаторДочернего);
		Данные.Вставить("run", СтрокаЗапуска(ИдентификаторДочернего));
		ДочерниеДанные.Добавить(Данные);
	КонецЦикла;

	Диалог = Шапка.Диалог;
	Пакет.Вставить("dialog", ЛентаДиалога(ИдентификаторЗапуска, Диалог));
	Пакет.Вставить("dialog_catalog_item", ?(ЗначениеЗаполнено(Диалог),
		ОбъектВСтруктуру(Диалог), Недоступно(НСтр("ru = 'у запуска нет диалога'; en = 'the run has no dialog'"))));
	Пакет.Вставить("session", СессияЗапуска(ИдентификаторЗапуска, Диалог));
	Пакет.Вставить("agent", ?(ЗначениеЗаполнено(Шапка.Агент),
		ОбъектВСтруктуру(Шапка.Агент), Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"))));
	Пакет.Вставить("llm_provider", ПровайдерАгента(Шапка.Агент));
	Пакет.Вставить("agent_memory", ПамятьАгента(Шапка.Агент));
	Пакет.Вставить("tools_registry", РеестрИнструментов(Шапка.Агент,
		ИменаИспользованныхИнструментов(Пакет.run_data, ДочерниеДанные)));

	// Спека 3.2: предмет запуска и запись захвата (agentrunner-32/35/46).
	// Сырая ссылка из шапки: значение в Пакет.run прошло ВЗаписываемое - после
	// него Метаданные()/СсылкаСуществует() предмет считают битым (agentrunner-106).
	Пакет.Вставить("subject", РазделПредмет(Шапка.Агент, Шапка.Предмет));

	// Спека 3.3: план агента (настройка) и выполнение плана в запуске (agentrunner-48).
	Пакет.Вставить("plan", РазделПлан(Шапка.Агент, Пакет.run_data, Пакет.run));

	Период = ПериодРаботы(ИдентификаторыРаботы);
	Если ТипЗнч(Период) = Тип("Структура") И Период.Свойство("Начало") Тогда
		Пакет.Вставить("period", Новый Структура("from, to",
			ДатаВСтроку(Период.Начало), ДатаВСтроку(Период.Конец)));
	Иначе
		Пакет.Вставить("period", Период);
	КонецЕсли;
	Пакет.Вставить("service_log", СлужебныйЛог(ИдентификаторЗапуска, Период));
	Пакет.Вставить("event_log", ЖурналРегистрацииЗаПериод(Период, ПараметрыСбора));
	Пакет.Вставить("child_runs", ДочерниеДанные);

	Возврат Пакет;

КонецФункции

// Версии платформы, конфигурации и расширений: по ним в другой базе видно,
// воспроизводится ли ошибка в той же среде.
Функция СредаВыполнения()

	СведенияОСистеме = Новый СистемнаяИнформация;

	ДанныеКонфигурации = Новый Структура;
	ДанныеКонфигурации.Вставить("name", Метаданные.Имя);
	ДанныеКонфигурации.Вставить("synonym", ВЗаписываемое(Метаданные.Синоним));
	ДанныеКонфигурации.Вставить("version", Метаданные.Версия);
	ДанныеКонфигурации.Вставить("vendor", ВЗаписываемое(Метаданные.Поставщик));

	Расширения = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name", Расширение.Имя);
		Элемент.Вставить("version", Расширение.Версия);
		Элемент.Вставить("active", Расширение.Активно);
		Расширения.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("platform_version", СведенияОСистеме.ВерсияПриложения);
	Результат.Вставить("configuration", ДанныеКонфигурации);
	Результат.Вставить("extensions", Расширения);
	Результат.Вставить("session_time_zone", ЧасовойПоясСеанса());
	Результат.Вставить("server_time_offset_sec", ЖурналРегистрации.СмещениеВремениСервера());
	Возврат Результат;

КонецФункции

// Настройки и справочная конфигурация расширения, влияющие на поведение агента.
// ar_ХранилищеСекретов не читается.
Функция НастройкиРасширения()

	Пустые = Новый Структура;
	ВсеЗаписи = "ИСТИНА";

	Результат = Новый Структура;
	Результат.Вставить("constants", КонстантыРасширения());
	Результат.Вставить("config_profile",
		ТаблицаРегистра("ar_ПрофильКонфигурации", ВсеЗаписи, Пустые, "Р.ar_Ключ"));
	Результат.Вставить("forbidden_objects",
		ТаблицаРегистра("ar_ЗапрещённыеОбъекты", ВсеЗаписи, Пустые, "Р.ТипОбъекта"));
	Результат.Вставить("object_overrides",
		ТаблицаРегистра("ar_ПереопределенияОбъектов", ВсеЗаписи, Пустые, "Р.ar_ЛогическоеИмя"));
	Результат.Вставить("pii_masking_rules",
		ТаблицаРегистра("ar_ПравилаМаскированияПДн", ВсеЗаписи, Пустые, "Р.Объект, Р.ИмяПоля"));
	Результат.Вставить("additional_settings", ДополнительныеНастройки());
	Возврат Результат;

КонецФункции

// Значения констант ar_*. Спека 2.5: исключающий список явный - при появлении
// константы с секретом ее имя добавляется в Исключить, и она не выгружается.
// ar_ОбщийСистемныйPrompt выгружается намеренно (нужен для разбора промптов).
Функция КонстантыРасширения()

	Исключить = Новый Массив;

	Результат = Новый Структура;
	Для Каждого Константа Из Метаданные.Константы Цикл
		Если СтрНачинаетсяС(Константа.Имя, "ar_") И Исключить.Найти(Константа.Имя) = Неопределено Тогда
			Результат.Вставить(Константа.Имя, ВЗаписываемое(Константы[Константа.Имя].Получить()));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Дополнительные настройки одним пакетом запросов (спека 2.2: без ПолучитьОбъект
// на каждый элемент): реквизиты + обе табличные части. uuid элементов не
// выгружается - он требовал бы отдельного обращения к базе на каждый элемент.
// Значения, чьё наименование или ключ содержит подстроку про секрет, заменяются
// на "***" (спека 2.5).
Функция ДополнительныеНастройки()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	Настройки.Ссылка КАК Ссылка,
		|	Настройки.Наименование КАК Наименование,
		|	Настройки.ПометкаУдаления КАК ПометкаУдаления,
		|	Настройки.ar_Значение КАК ar_Значение,
		|	Настройки.ar_ЗначениеСтрока КАК ar_ЗначениеСтрока,
		|	Настройки.ar_Включено КАК ar_Включено,
		|	Настройки.ar_Описание КАК ar_Описание,
		|	Настройки.ar_Ответственный КАК ar_Ответственный,
		|	Настройки.ar_ДатаИзменения КАК ar_ДатаИзменения
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|ВЫБРАТЬ
		|	ЗначенияТЧ.Ссылка КАК Ссылка,
		|	ЗначенияТЧ.НомерСтроки КАК НомерСтроки,
		|	ЗначенияТЧ.ar_Значение КАК ar_Значение,
		|	ЗначенияТЧ.ar_ЗначениеСтрока КАК ar_ЗначениеСтрока,
		|	ЗначенияТЧ.ar_Включено КАК ar_Включено
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки.ar_Значения КАК ЗначенияТЧ
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка, НомерСтроки
		|;
		|ВЫБРАТЬ
		|	СоответствиеТЧ.Ссылка КАК Ссылка,
		|	СоответствиеТЧ.НомерСтроки КАК НомерСтроки,
		|	СоответствиеТЧ.ar_Ключ КАК ar_Ключ,
		|	СоответствиеТЧ.ar_Значение КАК ar_Значение,
		|	СоответствиеТЧ.ar_ЗначениеСтрока КАК ar_ЗначениеСтрока
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки.ar_Соответствие КАК СоответствиеТЧ
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка, НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	НастройкиПоСсылке = Новый Соответствие;
	ЗаполнитьНастройкиИзШапок(Результаты[0], НастройкиПоСсылке);
	ДополнитьНастройкиЗначениями(Результаты[1], НастройкиПоСсылке);
	ДополнитьНастройкиСоответствиями(Результаты[2], НастройкиПоСсылке);

	Возврат МассивЗначенийСоответствия(НастройкиПоСсылке);

КонецФункции

// Литерал маски секретa (спека 2.5) - единая точка, чтобы не дублировать строку.
//
// Возвращаемое значение:
//   Строка - "***".
//
Функция МаскаСекрета()

	Возврат "***";

КонецФункции

// Собирает выгрузку элементов по первому набору пакета (реквизиты шапки).
//
// Параметры:
//   Результат          - РезультатЗапроса - первый набор пакета.
//   НастройкиПоСсылке  - Соответствие     - заполняемый каталог "ссылка - структура элемента".
//
Процедура ЗаполнитьНастройкиИзШапок(Знач Результат, НастройкиПоСсылке)

	Маска = МаскаСекрета();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СекретВНаименовании = НаименованиеСодержитСекрет(Выборка.Наименование);
		Элемент = Новый Структура;
		Элемент.Вставить("ref", Строка(Выборка.Ссылка));
		Элемент.Вставить("metadata", "Справочник.ar_ДополнительныеНастройки");
		Элемент.Вставить("Наименование", ВЗаписываемое(Выборка.Наименование));
		Элемент.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		Элемент.Вставить("ar_Значение", ?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_Значение)));
		Элемент.Вставить("ar_ЗначениеСтрока",
			?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_ЗначениеСтрока)));
		Элемент.Вставить("ar_Включено", Выборка.ar_Включено);
		Элемент.Вставить("ar_Описание", ВЗаписываемое(Выборка.ar_Описание));
		Элемент.Вставить("ar_Ответственный", ВЗаписываемое(Выборка.ar_Ответственный));
		Элемент.Вставить("ar_ДатаИзменения", ВЗаписываемое(Выборка.ar_ДатаИзменения));
		Элемент.Вставить("ar_Значения", Новый Массив);
		Элемент.Вставить("ar_Соответствие", Новый Массив);
		НастройкиПоСсылке.Вставить(Выборка.Ссылка, Элемент);
	КонецЦикла;

КонецПроцедуры

// Дополняет элементы строками ТЧ ar_Значения (второй набор пакета).
//
// Параметры:
//   Результат          - РезультатЗапроса - второй набор пакета.
//   НастройкиПоСсылке  - Соответствие     - каталог из ЗаполнитьНастройкиИзШапок.
//
Процедура ДополнитьНастройкиЗначениями(Знач Результат, НастройкиПоСсылке)

	Маска = МаскаСекрета();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = НастройкиПоСсылке.Получить(Выборка.Ссылка);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СекретВНаименовании = НаименованиеСодержитСекрет(Элемент.Наименование);
		СтрокаТЧ = Новый Структура;
		СтрокаТЧ.Вставить("НомерСтроки", Выборка.НомерСтроки);
		СтрокаТЧ.Вставить("ar_Значение", ?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_Значение)));
		СтрокаТЧ.Вставить("ar_ЗначениеСтрока",
			?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_ЗначениеСтрока)));
		СтрокаТЧ.Вставить("ar_Включено", Выборка.ar_Включено);
		Элемент.ar_Значения.Добавить(СтрокаТЧ);
	КонецЦикла;

КонецПроцедуры

// Дополняет элементы строками ТЧ ar_Соответствие (третий набор пакета).
//
// Параметры:
//   Результат          - РезультатЗапроса - третий набор пакета.
//   НастройкиПоСсылке  - Соответствие     - каталог из ЗаполнитьНастройкиИзШапок.
//
Процедура ДополнитьНастройкиСоответствиями(Знач Результат, НастройкиПоСсылке)

	Маска = МаскаСекрета();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = НастройкиПоСсылке.Получить(Выборка.Ссылка);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Ключ соответствия сам может называться "токен"/"ключ" (спека 2.5).
		СекретВНаименовании = НаименованиеСодержитСекрет(Элемент.Наименование)
			Или НаименованиеСодержитСекрет(Строка(Выборка.ar_Ключ));
		СтрокаТЧ = Новый Структура;
		СтрокаТЧ.Вставить("НомерСтроки", Выборка.НомерСтроки);
		СтрокаТЧ.Вставить("ar_Ключ", ВЗаписываемое(Выборка.ar_Ключ));
		СтрокаТЧ.Вставить("ar_Значение", ?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_Значение)));
		СтрокаТЧ.Вставить("ar_ЗначениеСтрока",
			?(СекретВНаименовании, Маска, ВЗаписываемое(Выборка.ar_ЗначениеСтрока)));
		Элемент.ar_Соответствие.Добавить(СтрокаТЧ);
	КонецЦикла;

КонецПроцедуры

// Значения соответствия списком (без ключей).
//
// Параметры:
//   Коллекция - Соответствие - источник.
//
// Возвращаемое значение:
//   Массив - значения в порядке обхода.
//
Функция МассивЗначенийСоответствия(Знач Коллекция)

	Результат = Новый Массив;
	Для Каждого Пара Из Коллекция Цикл
		Результат.Добавить(Пара.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Наименование или ключ содержит подстроку, говорящую о секрете (спека 2.5).
Функция НаименованиеСодержитСекрет(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Подстроки = Новый Массив;
	Подстроки.Добавить("ключ");
	Подстроки.Добавить("токен");
	Подстроки.Добавить("пароль");
	Подстроки.Добавить("секрет");
	Подстроки.Добавить("token");
	Подстроки.Добавить("key");
	Подстроки.Добавить("secret");
	Подстроки.Добавить("password");

	ТекстБезРегистра = НРег(Текст);
	Для Каждого Подстрока Из Подстроки Цикл
		Если СтрНайти(ТекстБезРегистра, Подстрока) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Записи памяти агента (ar_ПамятьАгента) - то, что агент "помнил" в этом запуске.
//
// Параметры:
//   Агент - СправочникСсылка.ar_Агенты - агент запуска (может быть пустой ссылкой).
//
// Возвращаемое значение:
//   Массив из Структура | Структура - элементы памяти или {unavailable}.
//
Функция ПамятьАгента(Знач Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;

	Возврат ЭлементыСправочника("ar_ПамятьАгента", "Р.ar_Агент = &Агент",
		Новый Структура("Агент", Агент), "Р.ar_Создано УБЫВ", 500);

КонецФункции

// Реестр инструментов (ar_Инструменты): версия, доступность и причина недоступности
// объясняют отказы вида "tool не найден".
//   all  - все инструменты кратко (без манифеста и кода реализации): доступность агенту
//          определяется правилами, а не только таблицей инструментов агента;
//   used - полные записи (с манифестом) для вызванных в запуске инструментов
//          и инструментов из таблицы агента.
//
// Параметры:
//   Агент - СправочникСсылка.ar_Агенты - агент запуска.
//   Имена - Массив из Строка            - имена вызванных инструментов.
//
// Возвращаемое значение:
//   Структура - {all, used}: массивы выгруженных элементов.
//
Функция РеестрИнструментов(Знач Агент, Знач Имена)

	Ссылки = Новый Массив;
	Если ЗначениеЗаполнено(Агент) Тогда
		ОбъектАгента = Агент.ПолучитьОбъект();
		Если ОбъектАгента <> Неопределено Тогда
			Для Каждого СтрокаТЧ Из ОбъектАгента.ar_ДоступныеИнструменты Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.ar_Инструмент) Тогда
					Ссылки.Добавить(СтрокаТЧ.ar_Инструмент);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("all", ЭлементыСправочника("ar_Инструменты", "ИСТИНА", Новый Структура,
		"Р.ar_Имя", 1000, "ar_КодРеализации, ar_JSONManifest"));

	Если Имена.Количество() = 0 И Ссылки.Количество() = 0 Тогда
		Результат.Вставить("used", Новый Массив);
	Иначе
		Результат.Вставить("used", ЭлементыСправочника("ar_Инструменты",
			"Р.ar_Имя В (&Имена) ИЛИ Р.Ссылка В (&Ссылки)",
			Новый Структура("Имена, Ссылки", Имена, Ссылки), "Р.ar_Имя", 500, "ar_КодРеализации"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имена инструментов, вызванных в запуске и его дочерних запусках (по ar_ДействияАгента).
//
// Параметры:
//   ДанныеКорня     - Структура - run_data корневой записи.
//   ДочерниеДанные  - Массив    - run_data дочерних запусков.
//
// Возвращаемое значение:
//   Массив из Строка - уникальные имена инструментов в порядке первого вызова.
//
Функция ИменаИспользованныхИнструментов(Знач ДанныеКорня, Знач ДочерниеДанные)

	Имена = Новый Массив;
	ДобавитьИменаИнструментов(Имена, ДанныеКорня.actions);
	Для Каждого Данные Из ДочерниеДанные Цикл
		ДобавитьИменаИнструментов(Имена, Данные.actions);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Дописывает уникальные имена инструментов действия в коллекцию.
//
// Параметры:
//   Имена    - Массив - накапливаемый список.
//   Действия - Массив - выгруженные записи ar_ДействияАгента.
//
Процедура ДобавитьИменаИнструментов(Имена, Знач Действия)

	Для Каждого Действие Из Действия Цикл
		Имя = ЗначениеПоКлючу(Действие, "ar_ИмяИнструмента");
		Если ЗначениеЗаполнено(Имя) И Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Данные запуска без самой строки ar_Запуски: события, действия, метрики,
// подтверждения, снимок состояния.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//   Структура - {events, actions, llm_metrics, approvals, state_snapshot}.
//
Функция ДанныеЗапуска(Знач ИдентификаторЗапуска)

	Параметры = Новый Структура("ИдентификаторЗапуска", ИдентификаторЗапуска);
	УсловиеПоRunId = "Р.ar_RunId = &ИдентификаторЗапуска";
	ПорядокПоSequence = "Р.ar_Sequence";

	Данные = Новый Структура;
	Данные.Вставить("events", РазвернутьПолезнуюНагрузку(
		ТаблицаРегистра("ar_СобытияЗапуска", УсловиеПоRunId, Параметры, ПорядокПоSequence,
			0, "", "ar_МоментВремени")));
	Данные.Вставить("actions",
		ТаблицаРегистра("ar_ДействияАгента", "Р.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска",
			Параметры, "Р.ar_Последовательность"));
	Данные.Вставить("llm_metrics",
		ТаблицаРегистра("ar_МетрикиLLM", УсловиеПоRunId, Параметры, ПорядокПоSequence));
	Данные.Вставить("approvals",
		ТаблицаРегистра("ar_ОчередьApproval", УсловиеПоRunId, Параметры, ПорядокПоSequence));
	Данные.Вставить("state_snapshot", СнимокЗапуска(ИдентификаторЗапуска));

	Возврат Данные;

КонецФункции

// Агент и диалог запуска - по ним читаются карточки, сессия, лента диалога;
// предмет - сырой ссылкой: РазделПредмет проверяет существование объекта,
// значение, прошедшее ВЗаписываемое (строка выгрузки), для этого непригодно.
// Время старта/завершения берётся запросом ПериодРаботы, здесь не читается.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//   Структура | Неопределено - {Агент, Диалог, Предмет} или Неопределено, если записи нет.
//
Функция ШапкаЗапуска(Знач ИдентификаторЗапуска)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_АгентРеф КАК Агент,
		|	Запуски.ar_Диалог КАК Диалог,
		|	Запуски.ar_Предмет КАК Предмет
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска";
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Шапка = Новый Структура("Агент, Диалог, Предмет");
	ЗаполнитьЗначенияСвойств(Шапка, Выборка);
	Возврат Шапка;

КонецФункции

// Строка запуска для выгрузки: все поля, кроме громоздкого снимка состояния
// (он выходит отдельным разделом run_data.state_snapshot).
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//   Структура | Структура - строка ar_Запуски для выгрузки или {unavailable}.
//
Функция СтрокаЗапуска(Знач ИдентификаторЗапуска)

	Строки = ТаблицаРегистра("ar_Запуски", "Р.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска",
		Новый Структура("ИдентификаторЗапуска", ИдентификаторЗапуска), "Р.ar_ИдентификаторЗапуска",
		1, "ar_StateSnapshot");

	Если Строки.Количество() = 0 Тогда
		Возврат Недоступно(НСтр("ru = 'запись запуска не найдена'; en = 'run record not found'"));
	КонецЕсли;

	Возврат Строки[0];

КонецФункции

// Идентификаторы дочерних запусков (обход в ширину, глубина до 3).
// Запрос на уровень вложенности - обоснование спеки 2.2: глубина ограничена
// тремя уровнями, на каждом уровне запрос один, итог не более Лимит строк
// (JUSTIFIED - в mcp.md [P5]).
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор корневого запуска (UUID).
//   Лимит                - Число  - максимум дочерних идентификаторов.
//
// Возвращаемое значение:
//   Массив из Строка - идентификаторы дочерних запусков в порядке обхода.
//
Функция ДочерниеЗапуски(Знач ИдентификаторЗапуска, Знач Лимит)

	Результат = Новый Массив;
	Текущий = Новый Массив;
	Текущий.Добавить(ИдентификаторЗапуска);

	Для СчётУровней = 1 По 3 Цикл
		Если Текущий.Количество() = 0 Или Результат.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Запуски.ar_ИдентификаторЗапуска КАК ИдентификаторЗапуска
			|ИЗ
			|	РегистрСведений.ar_Запуски КАК Запуски
			|ГДЕ
			|	Запуски.ar_РодительскийИдентификаторЗапуска В (&ИдентификаторыРодителей)
			|УПОРЯДОЧИТЬ ПО
			|	Запуски.ar_СтартовалВ";
		Запрос.УстановитьПараметр("ИдентификаторыРодителей", Текущий);

		Следующий = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() И Результат.Количество() < Лимит Цикл
			Результат.Добавить(Выборка.ИдентификаторЗапуска);
			Следующий.Добавить(Выборка.ИдентификаторЗапуска);
		КонецЦикла;
		Текущий = Следующий;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сообщения диалога запуска: лента своего диалога (полная переписка) плюс
// сообщения, записанные напрямую в запуск.
//
// Параметры:
//   ИдентификаторЗапуска - Строка                - идентификатор запуска (UUID).
//   Диалог               - СправочникСсылка.ar_Диалоги - диалог запуска (может быть пустым).
//
// Возвращаемое значение:
//   Массив из Структура - сообщения с признаком belongs_to_run.
//
Функция ЛентаДиалога(Знач ИдентификаторЗапуска, Знач Диалог)

	Параметры = Новый Структура("ИдентификаторЗапуска, Диалог", ИдентификаторЗапуска, Диалог);
	Если ЗначениеЗаполнено(Диалог) Тогда
		Условие = "Р.ar_Диалог = &Диалог ИЛИ Р.ar_Запуск = &ИдентификаторЗапуска";
	Иначе
		Условие = "Р.ar_Запуск = &ИдентификаторЗапуска";
	КонецЕсли;

	Лента = ТаблицаРегистра("ar_ЛентаДиалога", Условие, Параметры, "Р.ar_Диалог, Р.ar_Номер", 5000);
	Для Каждого Сообщение Из Лента Цикл
		Сообщение.Вставить("belongs_to_run", Сообщение.ar_Запуск = ИдентификаторЗапуска);
	КонецЦикла;

	Возврат Лента;

КонецФункции

// Сессия запуска (ar_Сессии): по последней связке "сессия - запуск" либо по
// паре (агент, якорь) диалога.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID).
//   Диалог               - СправочникСсылка.ar_Диалоги | Неопределено - диалог запуска.
//
// Возвращаемое значение:
//   Массив из Структура | Структура - записи сессий или {unavailable}.
//
Функция СессияЗапуска(Знач ИдентификаторЗапуска, Знач Диалог)

	Агент = Неопределено;
	Якорь = Неопределено;
	Если ЗначениеЗаполнено(Диалог) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Диалог, "ar_Агент, ar_Якорь");
		Агент = Реквизиты.ar_Агент;
		Якорь = Реквизиты.ar_Якорь;
	КонецЕсли;

	Параметры = Новый Структура("ИдентификаторЗапуска, Агент, Якорь", ИдентификаторЗапуска, Агент, Якорь);
	Условие = "Р.ar_ПоследнийИдентификаторЗапуска = &ИдентификаторЗапуска";
	Если ЗначениеЗаполнено(Агент) И ЗначениеЗаполнено(Якорь) Тогда
		Условие = Условие + " ИЛИ (Р.ar_Агент = &Агент И Р.ar_Якорь = &Якорь)";
	КонецЕсли;

	Сессии = ТаблицаРегистра("ar_Сессии", Условие, Параметры, "Р.ar_Обновлена УБЫВ");
	Если Сессии.Количество() = 0 Тогда
		Возврат Недоступно(НСтр("ru = 'сессия запуска не найдена (запуск без сессии или сессия удалена)';
			|en = 'run session not found (a run without a session, or the session was deleted)'"));
	КонецЕсли;

	Возврат Сессии;

КонецФункции

// Реквизиты провайдера для выгрузки - явный список (спека 2.5): новые реквизиты
// справочника сами в выгрузку не попадают; сам ключ API в ar_ХранилищеСекретов
// не читается, выгружается только ar_APIKeyИдентификатор.
//
// Возвращаемое значение:
//   Массив из Строка - имена выгружаемых реквизитов справочника.
//
Функция РеквизитыПровайдераДляВыгрузки()

	Имена = Новый Массив;
	Имена.Добавить("ar_Тип");
	Имена.Добавить("ar_BaseURL");
	Имена.Добавить("ar_APIKeyИдентификатор");
	Имена.Добавить("ar_DefaultModel");
	Имена.Добавить("ar_ПоддерживаетВызовыИнструментов");
	Имена.Добавить("ar_Таймаут");
	Имена.Добавить("ar_ИспользоватьПрокси");
	Имена.Добавить("ar_Включён");
	Имена.Добавить("ar_MaxContext");
	Возврат Имена;

КонецФункции

// Провайдер языковой модели агента для выгрузки (только список из
// РеквизитыПровайдераДляВыгрузки, спека 2.5).
//
// Параметры:
//   Агент - СправочникСсылка.ar_Агенты - агент запуска (может быть пустой ссылкой).
//
// Возвращаемое значение:
//   Структура - запись провайдера или {unavailable}.
//
Функция ПровайдерАгента(Знач Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;

	Провайдер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Агент, "ar_LLMПровайдер");
	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Возврат Недоступно(НСтр("ru = 'у агента не задан провайдер'; en = 'the agent has no provider'"));
	КонецЕсли;

	Имена = РеквизитыПровайдераДляВыгрузки();
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Провайдер, СтрСоединить(Имена, ","));

	Результат = Новый Структура;
	Результат.Вставить("ref", Строка(Провайдер));
	Результат.Вставить("metadata", "Справочник.ar_LLMПровайдеры");
	Результат.Вставить("Наименование",
		ВЗаписываемое(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Провайдер, "Наименование")));
	Для Каждого Имя Из Имена Цикл
		Результат.Вставить(Имя, ВЗаписываемое(Реквизиты[Имя]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимок состояния цикла как он хранится (без миграции версии формата).
// Миграцию и запись в журнал регистрации делает ar_AuditЗапуски.ПрочитатьСнимок,
// а при несовместимом формате она возвращает Неопределено - именно тот случай,
// когда снимок нужен для разбора. Поэтому читаем значение напрямую.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//   Структура - {version, state} | {raw} | {unavailable}.
//
Функция СнимокЗапуска(Знач ИдентификаторЗапуска)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_StateSnapshot КАК Снимок
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска";
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Недоступно(НСтр("ru = 'запись запуска не найдена'; en = 'run record not found'"));
	КонецЕсли;

	Если ТипЗнч(Выборка.Снимок) <> Тип("ХранилищеЗначения") Тогда
		Возврат Недоступно(НСтр("ru = 'снимок не сохранён'; en = 'snapshot is not stored'"));
	КонецЕсли;

	Попытка
		Значение = Выборка.Снимок.Получить();
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Значение = Неопределено Тогда
		Возврат Недоступно(НСтр("ru = 'снимок пуст'; en = 'snapshot is empty'"));
	КонецЕсли;

	Версия = ЗначениеПоКлючу(Значение, "v");
	Состояние = ЗначениеПоКлючу(Значение, "state");

	Результат = Новый Структура;
	Если Состояние = Неопределено Тогда
		// Нестандартный формат - отдаём содержимое целиком.
		Результат.Вставить("raw", ВЗаписываемое(Значение));
	Иначе
		Результат.Вставить("version", Версия);
		// Структуры/массивы остаются структурами/массивами (ВЗаписываемое), поэтому
		// раздел ПЛАН читает план из state без отдельного чтения сырого снимка.
		Результат.Вставить("state", ВЗаписываемое(Состояние));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение по ключу из Структуры или Соответствия; иначе Неопределено.
//
// Параметры:
//   Коллекция - Произвольный - Структура, Соответствие или иное значение.
//   Ключ       - Строка       - имя ключа.
//
// Возвращаемое значение:
//   Произвольный - найденное значение или Неопределено.
//
Функция ЗначениеПоКлючу(Знач Коллекция, Знач Ключ)

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Ключ);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Записи ar_СлужебныйЛог запуска; если известен период работы - добавляются
// записи без привязки к запуску из того же периода (диагностика вне запуска).
//
// Параметры:
//   ИдентификаторЗапуска - Строка    - идентификатор запуска (UUID).
//   Период               - Структура - результат ПериодРаботы (или {unavailable}).
//
// Возвращаемое значение:
//   Массив из Структура - записи служебного лога всех уровней (спека 3.4);
//   записи без RunId помечены run_id_missing = Истина.
//
Функция СлужебныйЛог(Знач ИдентификаторЗапуска, Знач Период)

	Параметры = Новый Структура("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Условие = "Р.ar_RunId = &ИдентификаторЗапуска";
	Если ТипЗнч(Период) = Тип("Структура") И Период.Свойство("Начало") Тогда
		Условие = Условие + " ИЛИ (Р.ar_RunId = """" И Р.ar_Момент МЕЖДУ &Начало И &Конец)";
		Параметры.Вставить("Начало", Период.Начало);
		Параметры.Вставить("Конец", Период.Конец);
	КонецЕсли;

	// Спека 3.4: все уровни, включая "Отладка" (уровень debug_* из agentrunner-53) -
	// фильтр по уровню не применяется.
	Записи = ТаблицаРегистра("ar_СлужебныйЛог", Условие, Параметры, "Р.ar_Момент", 5000);

	// Записи без RunId за период работы - не записи запуска; признак (по образцу
	// belongs_to_run ленты диалога), чтобы их не принимали за записи запуска.
	Для Каждого Запись Из Записи Цикл
		Если ПустаяСтрока(Запись.ar_RunId) Тогда
			Запись.Вставить("run_id_missing", Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Записи;

КонецФункции

// Период работы агента: от старта корня до завершения/последнего пульса самой
// поздней записи (корень + дочерние), с запасом по краям. Спека 2.2: один запрос
// МИНИМУМ/МАКСИМУМ по всем идентификаторам вместо чтения строки на каждый запуск.
Функция ПериодРаботы(Знач Идентификаторы)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МИНИМУМ(Запуски.ar_СтартовалВ) КАК Начало,
		|	МАКСИМУМ(Запуски.ar_ЗавершенВ) КАК Завершение,
		|	МАКСИМУМ(Запуски.ar_ПоследнийПульс) КАК Пульс
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_ИдентификаторЗапуска В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.Начало) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска не заполнено время старта'; en = 'run start time is empty'"));
	КонецЕсли;

	Конец = Неопределено;
	Если ЗначениеЗаполнено(Выборка.Завершение) Тогда
		Конец = Выборка.Завершение;
	ИначеЕсли ЗначениеЗаполнено(Выборка.Пульс) Тогда
		Конец = Выборка.Пульс;
	Иначе
		// Ни завершения, ни пульса - Конец остаётся Неопределено, ниже ставится
		// текущий момент.
	КонецЕсли;
	Если Конец = Неопределено Или Конец < Выборка.Начало Тогда
		// Незавершённый запуск без пульса (или со сбитыми датами) - до текущего момента.
		Конец = ТекущаяДатаСеанса();
	КонецЕсли;

	ЗапасСек = 5;
	Возврат Новый Структура("Начало, Конец", Выборка.Начало - ЗапасСек, Конец + ЗапасСек);

КонецФункции

// Записи журнала регистрации за период работы агента (по умолчанию только
// ошибки, см. параметр УровниЖурнала). Привилегированный режим включён вызывающим.
// Отбор - по периоду и уровню, не по пользователю: у записей журнала нет признака
// агента, а ошибки платформы и фоновых заданий нужны так же, как ошибки сеанса
// пользователя.
Функция ЖурналРегистрацииЗаПериод(Знач Период, Знач ПараметрыСбора)

	Если Не Период.Свойство("Начало") Тогда
		Возврат Период; // {unavailable: причина} из ПериодРаботы
	КонецЕсли;

	Уровни = УровниОтбораЖурнала(ПараметрыСбора.УровниЖурнала);

	// Даты журнала - по часам компьютера сервера (см. СмещениеВремениСервера общего
	// модуля БСП ЖурналРегистрации; спека 2.3: приводим отбор к поясу журнала).
	Смещение = ЖурналРегистрации.СмещениеВремениСервера();

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", Период.Начало + Смещение);
	Отбор.Вставить("ДатаОкончания", Период.Конец + Смещение);
	Если Уровни <> Неопределено Тогда
		Отбор.Вставить("Уровень", Уровни);
	КонецЕсли;

	Колонки = "Дата, Уровень, Событие, ИмяПользователя, ИмяПриложения,
		|Компьютер, Сеанс, Метаданные, Данные, ПредставлениеДанных, Комментарий";

	События = Новый ТаблицаЗначений;
	Попытка
		ВыгрузитьЖурналРегистрации(События, Отбор, Колонки, , ПараметрыСбора.МаксСобытийЖурнала);
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Записи = Новый Массив;
	Для Каждого Событие Из События Цикл
		Запись = Новый Структура;
		Запись.Вставить("Дата", ДатаВСтроку(Событие.Дата - Смещение));
		Запись.Вставить("Уровень", Строка(Событие.Уровень));
		Запись.Вставить("Событие", ВЗаписываемое(Событие.Событие));
		Запись.Вставить("Пользователь", ВЗаписываемое(Событие.ИмяПользователя));
		Запись.Вставить("ИмяПриложения", ВЗаписываемое(Событие.ИмяПриложения));
		Запись.Вставить("Компьютер", ВЗаписываемое(Событие.Компьютер));
		Запись.Вставить("Сеанс", ВЗаписываемое(Событие.Сеанс));
		Запись.Вставить("Метаданные", ИмяМетаданных(Событие.Метаданные));
		Запись.Вставить("Данные", ВЗаписываемое(Событие.Данные));
		Запись.Вставить("ПредставлениеДанных", ВЗаписываемое(Событие.ПредставлениеДанных));
		Запись.Вставить("Комментарий", ВЗаписываемое(Событие.Комментарий));
		Записи.Добавить(Запись);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("levels", ?(Уровни = Неопределено, "all", ПараметрыСбора.УровниЖурнала));
	Результат.Вставить("limit", ПараметрыСбора.МаксСобытийЖурнала);
	Результат.Вставить("server_time_offset_sec", Смещение);
	Результат.Вставить("filter_from_server_time", ДатаВСтроку(Отбор.ДатаНачала));
	Результат.Вставить("filter_to_server_time", ДатаВСтроку(Отбор.ДатаОкончания));
	Результат.Вставить("rows_exported", События.Количество());
	Результат.Вставить("truncated", Записи.Количество() >= ПараметрыСбора.МаксСобытийЖурнала);
	Результат.Вставить("entries", Записи);
	Возврат Результат;

КонецФункции

// Значения отбора по уровню записей журнала регистрации.
//
// Параметры:
//   Уровни - Строка - имена уровней через запятую либо "Все".
//
// Возвращаемое значение:
//   Массив из УровеньЖурналаРегистрации - значения для ключа отбора "Уровень";
//   Неопределено - отбор по уровню не нужен.
//
Функция УровниОтбораЖурнала(Знач Уровни)

	Если ПустаяСтрока(Уровни) Или НРег(СокрЛП(Уровни)) = "все" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ошибка", УровеньЖурналаРегистрации.Ошибка);
	Соответствие.Вставить("предупреждение", УровеньЖурналаРегистрации.Предупреждение);
	Соответствие.Вставить("информация", УровеньЖурналаРегистрации.Информация);
	Соответствие.Вставить("примечание", УровеньЖурналаРегистрации.Примечание);

	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Уровни, ",", Ложь) Цикл
		Уровень = Соответствие.Получить(НРег(СокрЛП(Имя)));
		Если Уровень = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'ar_ЛогЗапуска: неизвестный уровень журнала регистрации ""%1""';
					|en = 'ar_ЛогЗапуска: unknown event log level ""%1""'"), СокрЛП(Имя));
		КонецЕсли;
		Результат.Добавить(Уровень);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяМетаданных(Знач ОбъектМетаданных)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ОбъектМетаданных.ПолноеИмя();
	Исключение
		Возврат ВЗаписываемое(ОбъектМетаданных);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ПредметИЗахват

// Раздел subject (спека 3.2): предмет запуска (тип, представление, навигационная
// ссылка) и запись регистра ar_ПредметыАгентов по паре (агент, предмет).
// Тип предмета - DefinedType.ar_ПрикладнойОбъект (справочники и документы).
//
// Параметры:
//   Агент   - СправочникСсылка.ar_Агенты | Неопределено - агент запуска.
//   Предмет - ЛюбаяСсылка | Неопределено - реквизит ar_Запуски.ar_Предмет.
//
// Возвращаемое значение:
//   Структура - {subject, capture} или {unavailable}.
//
Функция РазделПредмет(Знач Агент, Знач Предмет)

	Если Не ЗначениеЗаполнено(Предмет) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет предмета'; en = 'the run has no subject'"));
	КонецЕсли;

	ПредметВыгрузки = Новый Структура;
	// Метаданные() у ссылки с типом, удалённым из конфигурации (данные прошлых
	// версий базы), бросает "не является значением объектного типа" - тип тогда
	// неопределим, пишем пустой.
	Попытка
		ПредметВыгрузки.Вставить("тип", ИмяМетаданных(Предмет.Метаданные()));
	Исключение
		ПредметВыгрузки.Вставить("тип", "");
	КонецПопытки;
	ПредметВыгрузки.Вставить("ref", Строка(Предмет));
	Попытка
		ПредметВыгрузки.Вставить("uuid", Строка(Предмет.УникальныйИдентификатор()));
	Исключение
		ПредметВыгрузки.Вставить("uuid", "");
	КонецПопытки;

	// СсылкаСуществует строит запрос по имени таблицы через Метаданные() - для
	// ссылки с неразрешимым типом падает той же ошибкой (verify 09.10, стек:
	// ОбщегоНазначения(3714)); такая ссылка трактуется как битая.
	ЭтоБитаяСсылка = Истина;
	Попытка
		ЭтоБитаяСсылка = НЕ ОбщегоНазначения.СсылкаСуществует(Предмет);
	Исключение
		ЭтоБитаяСсылка = Истина;
	КонецПопытки;
	Если НЕ ЭтоБитаяСсылка Тогда
		ПредметВыгрузки.Вставить("битаяСсылка", Ложь);
		ПредметВыгрузки.Вставить("представление", ПредставлениеПредмета(Предмет));
	Иначе
		// Битая ссылка: объект удалён из базы (спека 3.2).
		ПредметВыгрузки.Вставить("битаяСсылка", Истина);
		ПредметВыгрузки.Вставить("представление",
			НСтр("ru = '<объект удалён>'; en = '<object deleted>'"));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("subject", ПредметВыгрузки);

	Если ЗначениеЗаполнено(Агент) Тогда
		Захваты = ТаблицаРегистра("ar_ПредметыАгентов",
			"Р.ar_Агент = &Агент И Р.ar_Предмет = &Предмет",
			Новый Структура("Агент, Предмет", Агент, Предмет), "Р.ar_Агент", 1);
		Если Захваты.Количество() = 0 Тогда
			Захват = Недоступно(НСтр("ru = 'запись захвата предмета не найдена';
				|en = 'subject capture record not found'"));
		Иначе
			// Держатель-запуск, захвачен, триггер, пакет-источник, сбоев подряд,
			// исключён, последняя причина снятия, отложен (agentrunner-32/35/46).
			Захват = Захваты[0];
		КонецЕсли;
	Иначе
		Захват = Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;
	Результат.Вставить("capture", Захват);

	Возврат Результат;

КонецФункции

// Представление произвольного предмета запуска: справочник - наименование,
// документ - номер и дата (у платформы нет единого метода представления для
// составных ссылочных типов, вид определяем через БСП ОбщегоНазначения).
//
// Параметры:
//   Предмет - ЛюбаяСсылка - предмет запуска (ссылка существует).
//
// Возвращаемое значение:
//   Строка - наименование справочника или "Документ <имя> №... от ...".
//
Функция ПредставлениеПредмета(Знач Предмет)

	Вид = ОбщегоНазначения.ВидОбъектаПоСсылке(Предмет);

	Если Вид = "Справочник" Тогда
		Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предмет, "Наименование");
		Возврат ВЗаписываемое(?(Наименование = Неопределено, "", Строка(Наименование)));
	КонецЕсли;

	Если Вид = "Документ" Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Предмет, "Номер, Дата");
		Возврат ВЗаписываемое(СтрШаблон("%1 %2 №%3 от %4", Вид, ИмяМетаданных(Предмет.Метаданные()),
			Строка(Реквизиты.Номер), Формат(Реквизиты.Дата, "ДФ=dd.MM.yyyy HH:mm:ss")));
	КонецЕсли;

	Возврат ВЗаписываемое(Строка(Предмет));

КонецФункции

#КонецОбласти

#Область ПланАгента

// Раздел plan (спека 3.3): настройка плана агента (шаблон, режим), состояние
// выполнения в запуске (снимок состояния, поля прогресса записи запуска,
// последнее событие ПланОбновлён), счётчики и список отказов плана, история
// изменений плана.
//
// Параметры:
//   Агент                 - СправочникСсылка.ar_Агенты | Неопределено - агент запуска.
//   ДанныеЗапуска         - Структура                - run_data корневого запуска.
//   СтрокаВыгрузкиЗапуска - Структура                - run-раздел пакета.
//
// Возвращаемое значение:
//   Структура - {template, state, snapshot, counters, refusals, history};
//   snapshot - сведения о снимке состояния (СведенияОСнимке, agentrunner-371).
//
Функция РазделПлан(Знач Агент, Знач ДанныеЗапуска, Знач СтрокаВыгрузкиЗапуска)

	СведенияСнимка = СведенияОСнимке(ДанныеЗапуска, СтрокаВыгрузкиЗапуска);
	Счетчики = СчетчикиОтказовПлана(ДанныеЗапуска);
	// agentrunner-371: счетчики берутся из снимка - из устаревшего помечаются.
	Счетчики.Вставить("устарели", СведенияСнимка.есть И Не СведенияСнимка.актуален);

	Результат = Новый Структура;
	Результат.Вставить("template", ПланИзНастройкиАгента(Агент));
	Результат.Вставить("state", СостояниеПлана(ДанныеЗапуска, СтрокаВыгрузкиЗапуска));
	Результат.Вставить("snapshot", СведенияСнимка);
	Результат.Вставить("counters", Счетчики);
	Результат.Вставить("refusals", ОтказыПлана(ДанныеЗапуска));
	Результат.Вставить("history", ИсторияИзмененийПлана(ДанныеЗапуска));
	Возврат Результат;

КонецФункции

// Настройка плана агента: флаг "Планировать работу", шаблон плана исходной
// строкой и разобранным по пунктам общей функцией ar_ПланЗапуска.
// РазобратьСтрокуШаблона (не своей копией, спека 3.3), режим: обязательный
// (есть пункты с условием закрытия) / подсказка / без плана.
//
// Параметры:
//   Агент - СправочникСсылка.ar_Агенты | Неопределено - агент запуска.
//
// Возвращаемое значение:
//   Структура - {планироватьРаботу, шаблонТекст, пункты, режим} или {unavailable}.
//
Функция ПланИзНастройкиАгента(Знач Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Недоступно(НСтр("ru = 'у запуска нет агента'; en = 'the run has no agent'"));
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Агент,
		"ar_ПланироватьРаботу, ar_ШаблонПлана");
	ПланироватьРаботу = Реквизиты.ar_ПланироватьРаботу = Истина;
	ШаблонСтрока = ?(Реквизиты.ar_ШаблонПлана = Неопределено, "", Строка(Реквизиты.ar_ШаблонПлана));

	ПунктыШаблона = Новый Массив;
	Если Не ПустаяСтрока(ШаблонСтрока) Тогда
		Для Каждого СтрокаПункта Из СтрРазделить(ШаблонСтрока, Символы.ПС, Ложь) Цикл
			Если ПустаяСтрока(СокрЛП(СтрокаПункта)) Тогда
				Продолжить;
			КонецЕсли;
			ПунктыШаблона.Добавить(ar_ПланЗапуска.РазобратьСтрокуШаблона(СокрЛП(СтрокаПункта)));
		КонецЦикла;
	КонецЕсли;

	Пункты = Новый Массив;
	Для Каждого Разобранная Из ПунктыШаблона Цикл
		Пункт = Новый Структура;
		Пункт.Вставить("заголовок", ВЗаписываемое(Разобранная.Заголовок));
		Пункт.Вставить("закрывающиеИнструменты", ВЗаписываемое(Разобранная.ЗакрывающиеИнструменты));
		Пункт.Вставить("инструкция", ВЗаписываемое(Разобранная.Инструкция));
		Пункт.Вставить("обязательный", Разобранная.Обязательный = Истина);
		Пункты.Добавить(Пункт);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("планироватьРаботу", ПланироватьРаботу);
	Результат.Вставить("шаблонТекст", ВЗаписываемое(ШаблонСтрока));
	Результат.Вставить("пункты", Пункты);

	Если Не ПланироватьРаботу Тогда
		Режим = "без плана";
	Иначе
		ЕстьОбязательные = ar_ПланЗапуска.ЕстьОбязательныеПункты(
			ar_ПланЗапуска.ПланИзПунктовШаблона(ПунктыШаблона));
		Режим = ?(ЕстьОбязательные, "обязательный", "подсказка");
	КонецЕсли;
	Результат.Вставить("режим", Режим);

	Возврат Результат;

КонецФункции

// Состояние выполнения плана (agentrunner-371). Снимок состояния (state.План)
// пишется на паузах и после возобновления не обновляется, поэтому:
//  - запуск на паузе - источник snapshot (снимок записан этой паузой);
//  - иначе - events: пункты из payload последнего события ПланОбновлён (его
//    пишет каждое изменение плана, включая закрытие ядром), обязательность и
//    закрывающие инструменты - из пунктов снимка с тем же заголовком (это
//    конфигурация шага, после паузы она не меняется);
//  - событий нет - снимок (snapshot), снимка нет - run_record (поля прогресса
//    записи запуска, их пишет ДополнитьДаннымиПлана /
//    ЗаписатьПрогрессПланаПривилегированно).
//
// Параметры:
//   ДанныеЗапуска         - Структура - run_data корневого запуска.
//   СтрокаВыгрузкиЗапуска - Структура - run-раздел пакета.
//
// Возвращаемое значение:
//   Структура - {источник, всего, закрыто, текущийОбязательный, пункты}.
//
Функция СостояниеПлана(Знач ДанныеЗапуска, Знач СтрокаВыгрузкиЗапуска)

	ПланСнимка = ЗначениеПоКлючу(ЗначениеПоКлючу(ДанныеЗапуска.state_snapshot, "state"), "План");
	Если ТипЗнч(ПланСнимка) <> Тип("Структура") Тогда
		ПланСнимка = Неопределено;
	КонецЕсли;
	ПунктыСобытия = ПунктыИзПоследнегоПланаОбновлён(ДанныеЗапуска);

	Если ПланСнимка <> Неопределено
		И (СнимокАктуален(СтрокаВыгрузкиЗапуска) Или ПунктыСобытия.Количество() = 0) Тогда
		Источник = "snapshot";
		План = ПланСнимка;
	ИначеЕсли ПланСнимка <> Неопределено Тогда
		Источник = "events";
		ДополнитьПунктыКонфигурациейСнимка(ПунктыСобытия, ПланСнимка);
		План = Новый Структура("Пункты", ПунктыСобытия);
	Иначе
		Источник = "run_record";
		// Пункты из payload последнего ПланОбновлён; поля плана там не полные
		// (обязательность и инструменты в событие не пишутся) - как есть.
		План = Новый Структура("Пункты", ПунктыСобытия);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("источник", Источник);
	ЗаполнитьПрогрессПлана(Результат, План, СтрокаВыгрузкиЗапуска);
	ЗаполнитьТекущийШагПлана(Результат, План, Источник, СтрокаВыгрузкиЗапуска);
	Результат.Вставить("пункты", ПунктыПланаКВыгрузке(План));

	Возврат Результат;

КонецФункции

// Прогресс плана через общую ar_ПланЗапуска.Прогресс; Неопределено - если
// пунктов плана нет (снимка нет и событий ПланОбновлён не было) - тогда итог
// берётся из полей записи запуска (спека 3.3).
//
// Параметры:
//   План - Структура - план (из снимка или из последнего события).
//
// Возвращаемое значение:
//   Структура - {Всего, Закрыто} | Неопределено.
//
Функция ПрогрессПлана(Знач План)

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив")
		Или План.Пункты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ar_ПланЗапуска.Прогресс(План);

КонецФункции

// Итог плана: X/Y из ar_ПланЗапуска.Прогресс, при его недоступности - поля
// прогресса записи запуска, иначе нули.
//
// Параметры:
//   Результат             - Структура - заполняемый раздел state.
//   План                  - Структура - план (из снимка или из последнего события).
//   СтрокаВыгрузкиЗапуска - Структура - run-раздел пакета.
//
Процедура ЗаполнитьПрогрессПлана(Результат, Знач План, Знач СтрокаВыгрузкиЗапуска)

	Прогресс = ПрогрессПлана(План);
	Если Прогресс <> Неопределено Тогда
		Результат.Вставить("всего", Прогресс.Всего);
		Результат.Вставить("закрыто", Прогресс.Закрыто);
	ИначеЕсли ТипЗнч(СтрокаВыгрузкиЗапуска) = Тип("Структура") Тогда
		Результат.Вставить("всего", ЗначениеПоКлючу(СтрокаВыгрузкиЗапуска, "ar_ЭтаповВсего"));
		Результат.Вставить("закрыто", ЗначениеПоКлючу(СтрокаВыгрузкиЗапуска, "ar_ЭтаповЗакрыто"));
	Иначе
		Результат.Вставить("всего", 0);
		Результат.Вставить("закрыто", 0);
	КонецЕсли;

КонецПроцедуры

// Текущий обязательный шаг: по снимку - через ar_ПланЗапуска.ТекущийОбязательныйПункт;
// снимка нет - строка ar_ТекущийЭтап из записи запуска; иначе метка.
//
// Параметры:
//   Результат             - Структура - заполняемый раздел state.
//   План                  - Структура - план для анализа.
//   Источник              - Строка    - "snapshot" | "events" | "run_record".
//   СтрокаВыгрузкиЗапуска - Структура - run-раздел пакета.
//
Процедура ЗаполнитьТекущийШагПлана(Результат, Знач План, Знач Источник, Знач СтрокаВыгрузкиЗапуска)

	ТекущийОбязательный = Неопределено;
	Попытка
		ТекущийОбязательный = ar_ПланЗапуска.ТекущийОбязательныйПункт(План);
	Исключение
		ТекущийОбязательный = Неопределено;
	КонецПопытки;

	Если ТекущийОбязательный <> Неопределено Тогда
		ПунктВыгрузки = Новый Структура;
		ПунктВыгрузки.Вставить("номер", ТекущийОбязательный.Номер);
		ПунктВыгрузки.Вставить("заголовок",
			ВЗаписываемое(ЗначениеПоКлючу(ТекущийОбязательный.Пункт, "Заголовок")));
		Результат.Вставить("текущийОбязательный", ПунктВыгрузки);
	ИначеЕсли ТипЗнч(СтрокаВыгрузкиЗапуска) = Тип("Структура")
		И ЗначениеЗаполнено(ЗначениеПоКлючу(СтрокаВыгрузкиЗапуска, "ar_ТекущийЭтап")) Тогда
		// Поля записи запуска: текущий этап строкой (заголовок пункта).
		Результат.Вставить("текущийОбязательный",
			ВЗаписываемое(ЗначениеПоКлючу(СтрокаВыгрузкиЗапуска, "ar_ТекущийЭтап")));
	Иначе
		Если Источник = "run_record" Тогда
			ТекущийШаг = НСтр("ru = 'нет данных'; en = 'no data'");
		Иначе
			ТекущийШаг = НСтр("ru = 'все обязательные шаги закрыты'; en = 'all mandatory steps are done'");
		КонецЕсли;
		Результат.Вставить("текущийОбязательный", ТекущийШаг);
	КонецЕсли;

КонецПроцедуры

// Пункты плана для выгрузки: номер, заголовок, статус, обязательность, закрывающие
// инструменты, инструмент закрытия, причина пропуска; removed не нумеруются.
//
// Параметры:
//   План - Структура - план (из снимка или из последнего события).
//
// Возвращаемое значение:
//   Массив из Структура - выгруженные пункты.
//
Функция ПунктыПланаКВыгрузке(Знач План)

	Пункты = Новый Массив;
	Если ТипЗнч(ЗначениеПоКлючу(План, "Пункты")) <> Тип("Массив") Тогда
		Возврат Пункты;
	КонецЕсли;

	Номер = 0;
	Для Каждого Пункт Из План.Пункты Цикл
		Если Строка(ЗначениеПоКлючу(Пункт, "Статус")) = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		ПунктВыгрузки = Новый Структура;
		ПунктВыгрузки.Вставить("номер", Номер);
		ПунктВыгрузки.Вставить("заголовок", ВЗаписываемое(ЗначениеПоКлючу(Пункт, "Заголовок")));
		ПунктВыгрузки.Вставить("статус", Строка(ЗначениеПоКлючу(Пункт, "Статус")));
		ПунктВыгрузки.Вставить("обязательный", ЗначениеПоКлючу(Пункт, "Обязательный") = Истина);
		ПунктВыгрузки.Вставить("закрывающиеИнструменты",
			ВЗаписываемое(ЗначениеПоКлючу(Пункт, "ЗакрывающиеИнструменты")));
		ПунктВыгрузки.Вставить("закрытИнструментом",
			ВЗаписываемое(ЗначениеПоКлючу(Пункт, "ЗакрытИнструментом")));
		ПунктВыгрузки.Вставить("причинаПропуска",
			ВЗаписываемое(ЗначениеПоКлючу(Пункт, "ПричинаПропуска")));
		Пункты.Добавить(ПунктВыгрузки);
	КонецЦикла;
	Возврат Пункты;

КонецФункции

// Пункты плана из payload последнего события ПланОбновлён: steps [{title,status}].
//
// Параметры:
//   ДанныеЗапуска - Структура - run_data корневого запуска.
//
// Возвращаемое значение:
//   Массив из Структура - пункты {Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты}.
//
Функция ПунктыИзПоследнегоПланаОбновлён(Знач ДанныеЗапуска)

	Результат = Новый Массив;
	Последний = Неопределено;
	Для Каждого Событие Из ДанныеЗапуска.events Цикл
		Если ЭтоПланОбновлён(Событие) Тогда
			Последний = Событие;
		КонецЕсли;
	КонецЦикла;
	Если Последний = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ПолезнаяНагрузка = ЗначениеПоКлючу(Последний, "payload");
	Шаги = ЗначениеПоКлючу(ПолезнаяНагрузка, "steps");
	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Шаг Из Шаги Цикл
		Результат.Добавить(Новый Структура(
			"Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты",
			ЗначениеПоКлючу(Шаг, "title"), ЗначениеПоКлючу(Шаг, "status"), Ложь, Новый Массив));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Снимок состояния актуален (agentrunner-371): запуск сейчас на паузе -
// подтверждение, ввод или событие; снимок записан этой паузой. У запуска в
// другом статусе (завершен, ошибка, прерван, выполняется) снимок остался от
// последней паузы, а работа после нее продолжалась.
//
// Параметры:
//   СтрокаВыгрузкиЗапуска - Структура - run-раздел пакета (ar_Статус - представление).
//
// Возвращаемое значение:
//   Булево.
//
Функция СнимокАктуален(Знач СтрокаВыгрузкиЗапуска)

	Статус = Строка(ЗначениеПоКлючу(СтрокаВыгрузкиЗапуска, "ar_Статус"));

	Возврат Статус = Строка(Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения)
		Или Статус = Строка(Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода)
		Или Статус = Строка(Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия);

КонецФункции

// Сведения о снимке состояния для выгрузки (agentrunner-371): есть ли снимок
// и актуален ли он (см. СнимокАктуален); устаревший - с примечанием.
//
// Параметры:
//   ДанныеЗапуска         - Структура - run_data корневого запуска.
//   СтрокаВыгрузкиЗапуска - Структура - run-раздел пакета.
//
// Возвращаемое значение:
//   Структура - {есть, актуален, примечание}.
//
Функция СведенияОСнимке(Знач ДанныеЗапуска, Знач СтрокаВыгрузкиЗапуска)

	ЕстьСнимок = ТипЗнч(ЗначениеПоКлючу(ДанныеЗапуска.state_snapshot, "state")) = Тип("Структура");
	Актуален = ЕстьСнимок И СнимокАктуален(СтрокаВыгрузкиЗапуска);

	Примечание = "";
	Если ЕстьСнимок И Не Актуален Тогда
		Примечание = НСтр("ru = 'снимок последней паузы: запуск после нее продолжался, сообщения и счетчики отказов плана - на момент паузы';
			|en = 'snapshot of the last pause: the run continued after it, messages and plan refusal counters are as of the pause'");
	КонецЕсли;

	Возврат Новый Структура("есть, актуален, примечание", ЕстьСнимок, Актуален, Примечание);

КонецФункции

// Дополняет пункты из события ПланОбновлён конфигурацией шагов из снимка
// (agentrunner-371): обязательность и закрывающие инструменты - по совпадению
// заголовка, каждый пункт снимка - не более одного раза. Факты (статус,
// инструмент закрытия, причина пропуска) берутся только из события: в снимке
// они на момент паузы.
//
// Параметры:
//   ПунктыСобытия - Массив    - пункты ПунктыИзПоследнегоПланаОбновлён (мутируются).
//   ПланСнимка    - Структура - план из снимка состояния.
//
Процедура ДополнитьПунктыКонфигурациейСнимка(ПунктыСобытия, Знач ПланСнимка)

	ПунктыСнимка = ЗначениеПоКлючу(ПланСнимка, "Пункты");
	Если ТипЗнч(ПунктыСнимка) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Использованные = Новый Соответствие;
	Для Каждого Пункт Из ПунктыСобытия Цикл
		Заголовок = Строка(Пункт.Заголовок);
		Для Индекс = 0 По ПунктыСнимка.ВГраница() Цикл
			ПунктСнимка = ПунктыСнимка[Индекс];
			Если Использованные.Получить(Индекс) <> Неопределено
				Или Строка(ЗначениеПоКлючу(ПунктСнимка, "Заголовок")) <> Заголовок Тогда
				Продолжить;
			КонецЕсли;
			Использованные.Вставить(Индекс, Истина);
			Пункт.Обязательный = (ЗначениеПоКлючу(ПунктСнимка, "Обязательный") = Истина);
			ИнструментыСнимка = ЗначениеПоКлючу(ПунктСнимка, "ЗакрывающиеИнструменты");
			Если ТипЗнч(ИнструментыСнимка) = Тип("Массив") Тогда
				Пункт.ЗакрывающиеИнструменты = ИнструментыСнимка;
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Событие "ПланОбновлён" (имя значения перечисления - из метаданных).
//
// Параметры:
//   Событие - Структура | Неопределено - выгруженная запись ar_СобытияЗапуска.
//
// Возвращаемое значение:
//   Булево - признак события обновления плана.
//
Функция ЭтоПланОбновлён(Знач Событие)

	Возврат ТипЗнч(Событие) = Тип("Структура")
		И НРег(СокрЛП(Строка(ЗначениеПоКлючу(Событие, "ar_ТипСобытия")))) = НРег("ПланОбновлён");

КонецФункции

// Счётчики отказов плана из снимка (Состояние.ОтказовИтогаПлана /
// ОтказовПланаПодряд, agentrunner-48); снимка нет - поля не заполнены.
//
// Параметры:
//   ДанныеЗапуска - Структура - run_data корневого запуска.
//
// Возвращаемое значение:
//   Структура - {отказовИтогаПлана, отказовПланаПодряд}.
//
Функция СчетчикиОтказовПлана(Знач ДанныеЗапуска)

	Состояние = ЗначениеПоКлючу(ДанныеЗапуска.state_snapshot, "state");

	Результат = Новый Структура;
	Результат.Вставить("отказовИтогаПлана", ЗначениеПоКлючу(Состояние, "ОтказовИтогаПлана"));
	Результат.Вставить("отказовПланаПодряд", ЗначениеПоКлючу(Состояние, "ОтказовПланаПодряд"));
	Возврат Результат;

КонецФункции

// Список отказов плана по событиям Запрещён/Ошибка с кодами plan_* (спека 3.3):
// время, код, номер шага, инструмент, заголовок.
//
// Параметры:
//   ДанныеЗапуска - Структура - run_data корневого запуска.
//
// Возвращаемое значение:
//   Массив из Структура - отказы плана в хронологическом порядке.
//
Функция ОтказыПлана(Знач ДанныеЗапуска)

	КодыОтказа = Новый Массив;
	КодыОтказа.Добавить("plan_step_not_done");
	КодыОтказа.Добавить("plan_final_answer_denied");
	КодыОтказа.Добавить("plan_skip_reason_required");
	КодыОтказа.Добавить("plan_not_completed");

	ТипыОтказа = Новый Массив;
	ТипыОтказа.Добавить(НРег("Запрещён"));
	ТипыОтказа.Добавить(НРег("Ошибка"));

	Результат = Новый Массив;
	Для Каждого Событие Из ДанныеЗапуска.events Цикл
		Если ТипЗнч(Событие) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ТипСобытия = НРег(СокрЛП(Строка(ЗначениеПоКлючу(Событие, "ar_ТипСобытия"))));
		Если ТипыОтказа.Найти(ТипСобытия) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолезнаяНагрузка = ЗначениеПоКлючу(Событие, "payload");
		Код = Строка(ЗначениеПоКлючу(ПолезнаяНагрузка, "code"));
		Если КодыОтказа.Найти(Код) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("время", ЗначениеПоКлючу(Событие, "ar_МоментВремени"));
		Запись.Вставить("код", Код);
		Запись.Вставить("шаг", ЗначениеПоКлючу(ПолезнаяНагрузка, "step"));
		Запись.Вставить("инструмент", ВЗаписываемое(ЗначениеПоКлючу(ПолезнаяНагрузка, "tool")));
		Запись.Вставить("заголовок", ВЗаписываемое(ЗначениеПоКлючу(ПолезнаяНагрузка, "title")));
		Результат.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// История изменений плана: события ПланОбновлён по порядку - время, источник,
// итог, закрытый шаг/инструмент, причина пропуска и сжатым списком - какие
// пункты сменили статус относительно предыдущего события (из payload).
//
// Параметры:
//   ДанныеЗапуска - Структура - run_data корневого запуска.
//
// Возвращаемое значение:
//   Массив из Структура - события ПланОбновлён в хронологическом порядке.
//
Функция ИсторияИзмененийПлана(Знач ДанныеЗапуска)

	Результат = Новый Массив;
	ПредыдущиеСтатусы = Новый Соответствие;

	Для Каждого Событие Из ДанныеЗапуска.events Цикл
		Если Не ЭтоПланОбновлён(Событие) Тогда
			Продолжить;
		КонецЕсли;
		ПолезнаяНагрузка = ЗначениеПоКлючу(Событие, "payload");

		Запись = Новый Структура;
		Запись.Вставить("время", ЗначениеПоКлючу(Событие, "ar_МоментВремени"));
		Источник = ЗначениеПоКлючу(ПолезнаяНагрузка, "source");
		Запись.Вставить("источник", ?(Источник = Неопределено, "", Строка(Источник)));
		Запись.Вставить("шаговВсего", ЗначениеПоКлючу(ПолезнаяНагрузка, "steps_total"));
		Запись.Вставить("шаговЗакрыто", ЗначениеПоКлючу(ПолезнаяНагрузка, "steps_done"));
		Запись.Вставить("закрытШаг", ЗначениеПоКлючу(ПолезнаяНагрузка, "closed_step"));
		Запись.Вставить("закрытИнструментом",
			ВЗаписываемое(ЗначениеПоКлючу(ПолезнаяНагрузка, "closed_by")));
		Запись.Вставить("причинаПропуска", ВЗаписываемое(ЗначениеПоКлючу(ПолезнаяНагрузка, "note")));

		Сменились = Новый Массив;
		НовыеСтатусы = Новый Соответствие;
		Шаги = ЗначениеПоКлючу(ПолезнаяНагрузка, "steps");
		Если ТипЗнч(Шаги) = Тип("Массив") Тогда
			Для Каждого Шаг Из Шаги Цикл
				Заголовок = Строка(ЗначениеПоКлючу(Шаг, "title"));
				Статус = Строка(ЗначениеПоКлючу(Шаг, "status"));
				НовыеСтатусы.Вставить(Заголовок, Статус);
				Если ПредыдущиеСтатусы.Получить(Заголовок) <> Статус Тогда
					Сменились.Добавить(Новый Структура("заголовок, статус", Заголовок, Статус));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Запись.Вставить("сменилисьПункты", Сменились);
		ПредыдущиеСтатусы = НовыеСтатусы;

		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЧтениеДанных

// Все поля записей регистра сведений (измерения, ресурсы, реквизиты) по условию.
// Поля берутся из метаданных - выгрузка не теряет реквизиты, добавленные позже.
//
// Параметры:
//   ИмяРегистра    - Строка - имя регистра сведений без префикса.
//   Условие        - Строка - текст условия запроса; регистр доступен как "Р".
//   Параметры      - Структура - параметры запроса.
//   Порядок        - Строка - текст упорядочивания.
//   Лимит          - Число  - максимум записей (0 - 20000).
//   Пропустить     - Строка - имена полей через запятую, которые не выгружать.
//   ПоляВремениUTC - Строка - имена полей-дат в UTC через запятую: в записи они
//                             приводятся к поясу сеанса, исходное значение - в поле "<имя>_utc".
//
// Возвращаемое значение:
//   Массив из Структура - записи; значения приведены к JSON-совместимым типам.
//
Функция ТаблицаРегистра(Знач ИмяРегистра, Знач Условие, Знач Параметры, Знач Порядок,
	Знач Лимит = 0, Знач Пропустить = "", Знач ПоляВремениUTC = "")

	МетаРегистр = Метаданные.РегистрыСведений[ИмяРегистра];
	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);
	СписокПолейUTC = СтрРазделить(ПоляВремениUTC, ",", Ложь);

	ИменаПолей = Новый Массив;
	ПоляЗапроса = Новый Массив;
	Для Каждого Коллекция Из СоставПолейРегистра(МетаРегистр) Цикл
		Для Каждого Поле Из Коллекция Цикл
			Если Исключаемые.Найти(Поле.Имя) = Неопределено Тогда
				ИменаПолей.Добавить(Поле.Имя);
				ПоляЗапроса.Добавить("Р." + Поле.Имя + " КАК " + Поле.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Лимит = 0 Тогда
		Лимит = 20000;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(ПоляЗапроса, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ РегистрСведений." + ИмяРегистра + " КАК Р" + Символы.ПС
		+ "ГДЕ " + Условие + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО " + Порядок;
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Значение = Выборка[ИмяПоля];
			Если СписокПолейUTC.Найти(ИмяПоля) <> Неопределено И ЗначениеЗаполнено(Значение) Тогда
				Запись.Вставить(ИмяПоля + "_utc", ДатаВСтроку(Значение));
				Значение = МестноеВремя(Значение, ЧасовойПоясСеанса());
			КонецЕсли;
			Запись.Вставить(ИмяПоля, ВЗаписываемое(Значение));
		КонецЦикла;
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поля записей регистра: измерения, ресурсы, реквизиты (в этом порядке).
//
// Параметры:
//   МетаРегистр - МетаданныеСведенийРегистрСведений - метаданные регистра.
//
// Возвращаемое значение:
//   Массив - три коллекции полей метаданных.
//
Функция СоставПолейРегистра(Знач МетаРегистр)

	Состав = Новый Массив;
	Состав.Добавить(МетаРегистр.Измерения);
	Состав.Добавить(МетаРегистр.Ресурсы);
	Состав.Добавить(МетаРегистр.Реквизиты);
	Возврат Состав;

КонецФункции

// Все реквизиты элементов справочника (без табличных частей) по условию.
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника без префикса "Справочник.".
//   Условие        - Строка - текст условия запроса; справочник доступен как "Р".
//   Параметры      - Структура - параметры запроса.
//   Порядок        - Строка - текст упорядочивания.
//   Лимит          - Число  - максимум элементов.
//   Пропустить     - Строка - имена реквизитов через запятую, которые не выгружать.
//
// Возвращаемое значение:
//   Массив из Структура - элементы; значения приведены к JSON-совместимым типам.
//
Функция ЭлементыСправочника(Знач ИмяСправочника, Знач Условие, Знач Параметры, Знач Порядок,
	Знач Лимит, Знач Пропустить = "")

	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);

	ИменаРеквизитов = Новый Массив;
	ПоляЗапроса = Новый Массив;
	ПоляЗапроса.Добавить("Р.Ссылка КАК Ссылка");
	Для Каждого Реквизит Из Метаданные.Справочники[ИмяСправочника].Реквизиты Цикл
		Если Исключаемые.Найти(Реквизит.Имя) = Неопределено Тогда
			ИменаРеквизитов.Добавить(Реквизит.Имя);
			ПоляЗапроса.Добавить("Р." + Реквизит.Имя + " КАК " + Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(ПоляЗапроса, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ Справочник." + ИмяСправочника + " КАК Р" + Символы.ПС
		+ "ГДЕ " + Условие + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО " + Порядок;
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("ref", Строка(Выборка.Ссылка));
		Запись.Вставить("uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			Запись.Вставить(ИмяРеквизита, ВЗаписываемое(Выборка[ИмяРеквизита]));
		КонецЦикла;
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Реквизиты и табличные части элемента справочника. Спека 2.2: допустимо для
// единичных объектов (агент, диалог); для коллекций - запросы выше.
//
// Параметры:
//   Ссылка - ЛюбаяСсылка | Неопределено - ссылка на объект справочника.
//
// Возвращаемое значение:
//   Структура - реквизиты и ТЧ элемента или {unavailable}.
//
Функция ОбъектВСтруктуру(Знач Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Недоступно(НСтр("ru = 'ссылка пуста'; en = 'empty reference'"));
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат Недоступно(НСтр("ru = 'объект удалён'; en = 'object was deleted'"));
		КонецЕсли;
		МетаОбъект = Ссылка.Метаданные();

		Результат = Новый Структура;
		Результат.Вставить("ref", Строка(Ссылка));
		Результат.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
		Результат.Вставить("metadata", МетаОбъект.ПолноеИмя());
		Результат.Вставить("Наименование", ВЗаписываемое(Объект.Наименование));
		Результат.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);

		Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
			Результат.Вставить(Реквизит.Имя, ВЗаписываемое(Объект[Реквизит.Имя]));
		КонецЦикла;

		Для Каждого ТабличнаяЧасть Из МетаОбъект.ТабличныеЧасти Цикл
			СтрокиТЧ = Новый Массив;
			Для Каждого СтрокаТЧ Из Объект[ТабличнаяЧасть.Имя] Цикл
				СтрокаСтруктура = Новый Структура;
				Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
					СтрокаСтруктура.Вставить(Реквизит.Имя, ВЗаписываемое(СтрокаТЧ[Реквизит.Имя]));
				КонецЦикла;
				СтрокиТЧ.Добавить(СтрокаСтруктура);
			КонецЦикла;
			Результат.Вставить(ТабличнаяЧасть.Имя, СтрокиТЧ);
		КонецЦикла;
	Исключение
		Возврат Недоступно(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Полезная нагрузка событий (ar_PayloadJSON) - в объект, чтобы промпты и аргументы
// читались без двойного экранирования. Если разобрать не удалось - остаётся строка.
//
// Параметры:
//   События - Массив из Структура - выгруженные записи ar_СобытияЗапуска.
//
// Возвращаемое значение:
//   Массив из Структура - тот же массив, payload заменён на разобранный.
//
Функция РазвернутьПолезнуюНагрузку(Знач События)

	Для Каждого Событие Из События Цикл
		Если Не Событие.Свойство("ar_PayloadJSON") Или ПустаяСтрока(Событие.ar_PayloadJSON) Тогда
			Продолжить;
		КонецЕсли;
		ПолезнаяНагрузка = ar_JSON.ИзJSON(Событие.ar_PayloadJSON);
		Если ПолезнаяНагрузка <> Неопределено Тогда
			Событие.Удалить("ar_PayloadJSON");
			Событие.Вставить("payload", ВЗаписываемое(ПолезнаяНагрузка));
		КонецЕсли;
	КонецЦикла;

	Возврат События;

КонецФункции

// Раздел, недоступный для выгрузки: {"unavailable": "<причина>"} (спека 1).
//
// Параметры:
//   Причина - Строка - текст причины.
//
// Возвращаемое значение:
//   Структура - служебная разметка недоступного раздела.
//
Функция Недоступно(Знач Причина)

	Возврат Новый Структура("unavailable", Причина);

КонецФункции

#КонецОбласти

#Область ПриведениеЗначений

// Приводит значение к типам, которые принимает ar_JSON: ссылки и прочие
// платформенные объекты - в строковое представление, даты - в строку,
// ХранилищеЗначения - в его содержимое, строки - с маскированием секретов.
//
// Параметры:
//   Значение - Произвольный - исходное значение.
//   Глубина  - Число        - текущая глубина вложения (для рекурсии).
//
// Возвращаемое значение:
//   Произвольный - значение из Строка/Число/Булево/Дата(Строка)/Структура/
//   Соответствие/Массив или Неопределено.
//
Функция ВЗаписываемое(Знач Значение, Знач Глубина = 0)

	Если Глубина > МаксГлубинаВложенности() Тогда
		Возврат "<depth limit>";
	КонецЕсли;

	// Фиксированные коллекции приводятся к обычным именам типов: обработчики те же,
	// неизменяемость источника не теряется (копируются значения).
	ТипЗначения = ТипЗнч(Значение);
	ИмяТипа = Строка(ТипЗначения);
	ИмяТипа = СтрЗаменить(ИмяТипа, "Фиксированная", "");
	ИмяТипа = СтрЗаменить(ИмяТипа, "Фиксированное", "");
	ИмяТипа = СтрЗаменить(ИмяТипа, "Фиксированный", "");

	Если Значение = Неопределено Или ИмяТипа = "Null" Тогда
		Возврат Неопределено;
	ИначеЕсли ИмяТипа = "Строка" Тогда
		Возврат ar_Утилиты.МаскироватьСекреты(Значение);
	ИначеЕсли ИмяТипа = "Число" Или ИмяТипа = "Булево" Тогда
		Возврат Значение;
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат ДатаВСтроку(Значение);
	ИначеЕсли ИмяТипа = "ХранилищеЗначения" Тогда
		Возврат ВЗаписываемое(Значение.Получить(), Глубина + 1);
	ИначеЕсли ИмяТипа = "Структура" Тогда
		Возврат СтруктуруВЗаписываемое(Значение, Глубина);
	ИначеЕсли ИмяТипа = "Соответствие" Тогда
		Возврат СоответствиеВЗаписываемое(Значение, Глубина);
	ИначеЕсли ИмяТипа = "Массив" Тогда
		Возврат МассивВЗаписываемое(Значение, Глубина);
	Иначе
		Возврат ЗначениеСтрокой(Значение, ТипЗначения);
	КонецЕсли;

КонецФункции

// Максимальная глубина рекурсии ВЗаписываемое (защита от циклов в данных).
//
// Возвращаемое значение:
//   Число - предельная глубина.
//
Функция МаксГлубинаВложенности()

	Возврат 15;

КонецФункции

// Перевод структуры в JSON-совместимую структуру.
//
// Параметры:
//   Значение - Структура|ФиксированнаяСтруктура - источник.
//   Глубина  - Число                             - текущая глубина вложения.
//
// Возвращаемое значение:
//   Структура - выгружаемые свойства.
//
Функция СтруктуруВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Структура;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Элемент.Ключ, ВЗаписываемое(Элемент.Значение, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Перевод соответствия в JSON-совместимое соответствие (ключи - строки:
// в JSON ключи числовых/датских значений соответствуют строковым, коллизии
// ключей в источниках модуля невозможны - см. mcp.md [P5]).
//
// Параметры:
//   Значение - Соответствие|ФиксированноеСоответствие - источник.
//   Глубина  - Число                                  - текущая глубина вложения.
//
// Возвращаемое значение:
//   Соответствие - выгружаемые пары.
//
Функция СоответствиеВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Строка(Элемент.Ключ), ВЗаписываемое(Элемент.Значение, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Перевод массива в JSON-совместимый массив.
//
// Параметры:
//   Значение - Массив|ФиксированныйМассив - источник.
//   Глубина  - Число                       - текущая глубина вложения.
//
// Возвращаемое значение:
//   Массив - выгружаемые элементы.
//
Функция МассивВЗаписываемое(Знач Значение, Знач Глубина)

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Результат.Добавить(ВЗаписываемое(Элемент, Глубина + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ссылки и прочие платформенные значения - строковое представление
// (с маскированием секретов); если представление получить нельзя - имя типа.
//
// Параметры:
//   Значение    - Произвольный - приводимое значение.
//   ТипЗначения - Тип           - его тип (для имени в аварийном тексте).
//
// Возвращаемое значение:
//   Строка - представление или "<имя типа>".
//
Функция ЗначениеСтрокой(Знач Значение, Знач ТипЗначения)

	Попытка
		Возврат ar_Утилиты.МаскироватьСекреты(Строка(Значение));
	Исключение
		Возврат "<" + Строка(ТипЗначения) + ">";
	КонецПопытки;

КонецФункции

// Дата в строку формата выгрузки; не заполнена - пустая строка.
//
// Параметры:
//   Дата - Дата - приводимое значение.
//
// Возвращаемое значение:
//   Строка - "yyyy-MM-dd HH:mm:ss" или "".
//
Функция ДатаВСтроку(Знач Дата)

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Дата, "ДФ='yyyy-MM-dd HH:mm:ss'");

КонецФункции

// Имя текущего пользователя ИБ (в пустом сеансе - пустая строка).
//
// Возвращаемое значение:
//   Строка - имя пользователя.
//
Функция ИмяТекущегоПользователя()

	Попытка
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область МаскированиеПДн

// Рекурсивно маскирует ПДн в собранном пакете (режим "без ПДн", agentrunner-244):
// строки значений - текстовыми маскерами, поля с чувствительными именами
// скрываются целиком. Обходчик вызывается в СобратьПакет после снятия
// привилегированного режима: маскирование прав не требует, wildcard-правила
// регистра читаются обычными правами.
//
// Пакет уже приведен ВЗаписываемое к JSON-совместимым типам (Строка/Число/
// Булево/Структура/Соответствие/Массив), других типов здесь не встречается.
// Числа, булевы и ключи коллекций не трогаются - JSON остается валидным при
// любых эвристиках. Строки маскируются в ветке той коллекции, где встретились:
// рекурсия по "голой" строке ничего не делает (делегирование строковых значений
// структур оставило бы их без текстовых маскеров).
//
// Параметры:
//   Значение               - Структура|Соответствие|Массив - обходимая коллекция
//                            (верхний вызов - сам пакет).
//   Глубина                - Число  - текущая глубина вложения (для рекурсии).
//   ПравилаПолногоСокрытия - Массив - wildcard-правила регистра; читается одним
//                            запросом вызывающим (СобратьПакет) на верхнем вызове
//                            и передается по рекурсии - не в цикле.
//
Процедура ПрименитьМаскированиеПДн(Знач Значение, Знач Глубина, Знач ПравилаПолногоСокрытия)

	Если Глубина > МаксГлубинаВложенности() Тогда
		Возврат;
	КонецЕсли;

	ТипСтроки = Тип("Строка");

	// Три независимых проверки без ветвной цепочки: не-коллекции (после
	// ВЗаписываемое в пакете их нет) просто не проходят ни в одну ветку.
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		МаскироватьСтруктуруПакета(Значение, ТипСтроки, Глубина, ПравилаПолногоСокрытия);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		МаскироватьСоответствиеПакета(Значение, ТипСтроки, Глубина, ПравилаПолногоСокрытия);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		МаскироватьМассивПакета(Значение, ТипСтроки, Глубина, ПравилаПолногоСокрытия);
	КонецЕсли;

КонецПроцедуры

// Маскирование строковых значений структуры пакета; нестроковые значения -
// рекурсия. Значение существующего ключа заменяется через Вставить: состав
// коллекции не меняется, обход остается корректным (записи по индексу
// у структуры нет).
//
// Параметры:
//   СтруктураПакета        - Структура - обходимая структура.
//   ТипСтроки              - Тип       - Тип("Строка") (без дублей литерала).
//   Глубина                - Число     - текущая глубина вложения.
//   ПравилаПолногоСокрытия - Массив    - wildcard-правила регистра.
//
Процедура МаскироватьСтруктуруПакета(Знач СтруктураПакета, Знач ТипСтроки, Знач Глубина, Знач ПравилаПолногоСокрытия)

	Для Каждого Элемент Из СтруктураПакета Цикл
		Если ТипЗнч(Элемент.Значение) = ТипСтроки Тогда
			СтруктураПакета.Вставить(Элемент.Ключ,
				ЗамаскированноеЗначениеПоляВыгрузки(
					Элемент.Ключ, Элемент.Значение, ПравилаПолногоСокрытия));
		Иначе
			ПрименитьМаскированиеПДн(Элемент.Значение, Глубина + 1, ПравилаПолногоСокрытия);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Маскирование строковых значений соответствия пакета; нестроковые значения -
// рекурсия. Ключи соответствий (разобранные JSON-payload: "title", "tool") на
// чувствительность не проверяются - это не имена полей объектов.
//
// Параметры:
//   СоответствиеПакета     - Соответствие - обходимое соответствие.
//   ТипСтроки              - Тип          - Тип("Строка").
//   Глубина                - Число        - текущая глубина вложения.
//   ПравилаПолногоСокрытия - Массив       - wildcard-правила регистра.
//
Процедура МаскироватьСоответствиеПакета(Знач СоответствиеПакета, Знач ТипСтроки, Знач Глубина, Знач ПравилаПолногоСокрытия)

	Для Каждого Элемент Из СоответствиеПакета Цикл
		Если ТипЗнч(Элемент.Значение) = ТипСтроки Тогда
			СоответствиеПакета.Вставить(Элемент.Ключ, МаскироватьСтрокуВыгрузки(Элемент.Значение));
		Иначе
			ПрименитьМаскированиеПДн(Элемент.Значение, Глубина + 1, ПравилаПолногоСокрытия);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Маскирование строковых элементов массива пакета; нестроковые элементы -
// рекурсия.
//
// Параметры:
//   МассивПакета           - Массив - обходимый массив.
//   ТипСтроки              - Тип    - Тип("Строка").
//   Глубина                - Число  - текущая глубина вложения.
//   ПравилаПолногоСокрытия - Массив - wildcard-правила регистра.
//
Процедура МаскироватьМассивПакета(Знач МассивПакета, Знач ТипСтроки, Знач Глубина, Знач ПравилаПолногоСокрытия)

	Для Индекс = 0 По МассивПакета.Количество() - 1 Цикл
		Если ТипЗнч(МассивПакета[Индекс]) = ТипСтроки Тогда
			МассивПакета[Индекс] = МаскироватьСтрокуВыгрузки(МассивПакета[Индекс]);
		Иначе
			ПрименитьМаскированиеПДн(МассивПакета[Индекс], Глубина + 1, ПравилаПолногоСокрытия);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Значение строкового поля выгрузки: чувствительное имя ключа - "[REDACTED]"
// целиком (без текстовых эвристик), иначе - текстовые маскеры по значению.
//
// Параметры:
//   Ключ                   - Строка - имя поля (ключ структуры).
//   Строка                 - Строка - строковое значение поля.
//   ПравилаПолногоСокрытия - Массив - wildcard-правила регистра.
//
// Возвращаемое значение:
//   Строка
//
Функция ЗамаскированноеЗначениеПоляВыгрузки(Знач Ключ, Знач Строка, Знач ПравилаПолногоСокрытия)

	Если ЭтоЧувствительноеИмяПоляВыгрузки(Ключ, ПравилаПолногоСокрытия) Тогда
		Возврат "[REDACTED]";
	КонецЕсли;

	Возврат МаскироватьСтрокуВыгрузки(Строка);

КонецФункции

// Имя ключа структуры пакета признается чувствительным при любом из условий:
//   1) совпадение с 18 паттернами ar_Утилиты (обертка ЭтоЧувствительноеИмяПоля);
//   2) совпадение с локальными адресными паттернами ar_ЛогЗапуска ("адрес",
//      "address", "индекс", "почтовый") - список ar_Утилиты не расширяется
//      (решение человека): адресные поля LLM-контекста не трогаем;
//   3) совпадение с wildcard-правилами регистра ar_ПравилаМаскированияПДн
//      (Объект = "*"). Правила с конкретным объектом не применяются: обход не
//      знает объект-владелец поля (ограничение первой итерации).
// Исключение: ключи с префиксом "ar_" не проверяются - служебные реквизиты
// расширения ("ar_Имя", "ar_ИмяИнструмента") - идентификаторы, не данные;
// их строковое содержимое все равно проходит текстовые маскеры.
//
// Параметры:
//   Ключ                   - Строка - имя поля (ключ структуры).
//   ПравилаПолногоСокрытия - Массив - wildcard-правила регистра (в нижнем регистре).
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЧувствительноеИмяПоляВыгрузки(Знач Ключ, Знач ПравилаПолногоСокрытия)

	Если СтрНачинаетсяС(Ключ, "ar_") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ar_Утилиты.ЭтоЧувствительноеИмяПоля(Ключ) Или ЭтоАдресноеИмяПоля(Ключ) Тогда
		Возврат Истина;
	КонецЕсли;

	НижнийКлюч = НРег(Ключ);
	Для Каждого Паттерн Из ПравилаПолногоСокрытия Цикл
		Если СтрНайти(НижнийКлюч, Паттерн) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Локальные адресные паттерны имени поля (см. ЭтоЧувствительноеИмяПоляВыгрузки).
//
// Параметры:
//   Ключ - Строка - имя поля (ключ структуры).
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоАдресноеИмяПоля(Знач Ключ)

	НижнийКлюч = НРег(Ключ);
	Возврат СтрНайти(НижнийКлюч, "адрес") > 0
		Или СтрНайти(НижнийКлюч, "address") > 0
		Или СтрНайти(НижнийКлюч, "индекс") > 0
		Или СтрНайти(НижнийКлюч, "почтовый") > 0;

КонецФункции

// Wildcard-правила полного сокрытия: имена полей включенных записей регистра
// ar_ПравилаМаскированияПДн с Объект = "*" ("все объекты"). Один запрос на все
// маскирование (не в цикле); регистр читается обычными правами - у полноправного
// пользователя, прошедшего проверку СобратьПакет, право Read есть
// (Roles/ar_РольАдмин/Ext/Rights.xml).
//
// Возвращаемое значение:
//   Массив из Строка - имена полей в нижнем регистре.
//
Функция ПравилаПолногоСокрытияПакета()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Правила.ИмяПоля КАК ИмяПоля
		|ИЗ
		|	РегистрСведений.ar_ПравилаМаскированияПДн КАК Правила
		|ГДЕ
		|	Правила.Объект = &Объект
		|	И Правила.Включён";
	Запрос.УстановитьПараметр("Объект", "*");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(НРег(СокрЛП(Выборка.ИмяПоля)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Композиция текстовых маскеров для строкового значения пакета (режим
// "без ПДн"): порядок "длинные и контекстные" форматы раньше коротких цифровых,
// телефон до СНИЛС/ИНН (порядок отработан в ar_Утилиты.МаскироватьПДнВТексте):
//   счет (20 цифр) -> паспорт -> телефон -> СНИЛС -> email -> адрес ->
//   организация -> секреты -> ИНН/ОГРН -> КПП/БИК.
// Готовая ar_Утилиты.МаскироватьПДнВТексте не переиспользуется и не меняется:
// в ней нет КПП/счета/адреса/организации, а ее расширение изменило бы
// "последний рубеж" LLM-контекста (ar_LLMДиспетчер). Числовые (не строковые)
// значения пакета маскерами не затрагиваются - JSON не ломается.
//
// Параметры:
//   Текст - Строка - строковое значение пакета.
//
// Возвращаемое значение:
//   Строка - текст с замаскированными ПДн; идемпотентно (повторный прогон по
//   уже замаскированному тексту ничего не меняет).
//
Функция МаскироватьСтрокуВыгрузки(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	// Префильтр: цифровые маскеры запускаются только при наличии цифры в строке.
	ЕстьЦифра = СодержитЦифру(Текст);

	Результат = Текст;
	Если ЕстьЦифра Тогда
		Результат = МаскироватьБанковскийСчет(Результат);
		Результат = ar_Утилиты.МаскироватьПаспорт(Результат);
		Результат = ar_Утилиты.МаскироватьТелефон(Результат);
		Результат = ar_Утилиты.МаскироватьСНИЛС(Результат);
	КонецЕсли;

	Если СтрНайти(Результат, "@") > 0 Тогда
		Результат = ar_Утилиты.МаскироватьEmail(Результат);
	КонецЕсли;

	Результат = МаскироватьАдрес(Результат);
	Результат = МаскироватьОрганизацию(Результат);
	Результат = ar_Утилиты.МаскироватьСекреты(Результат);

	Если ЕстьЦифра Тогда
		Результат = ar_Утилиты.МаскироватьINN(Результат);
		Результат = МаскироватьКПП(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Маскирует непрерывные цепочки ровно 9 цифр ("***КПП***"). БИК (тоже 9 цифр,
// в свободном тексте неотличим) покрывается той же меткой. Ложные срабатывания
// на 9-значных номерах - принятый компромисс (как у ar_Утилиты.МаскироватьINN);
// числовые (не строковые) значения пакета не затрагиваются.
//
// Параметры:
//   Текст - Строка - строковое значение пакета.
//
// Возвращаемое значение:
//   Строка - текст с замаскированными КПП/БИК.
//
Функция МаскироватьКПП(Знач Текст)

	Возврат МаскироватьЦепочкуЦифрДлины(Текст, 9, "***КПП***");

КонецФункции

// Маскирует непрерывные цепочки ровно 20 цифр ("***СЧЕТ***") - расчетный
// и корреспондентский банковский счет (формат одинаковый).
//
// Параметры:
//   Текст - Строка - строковое значение пакета.
//
// Возвращаемое значение:
//   Строка - текст с замаскированными банковскими счетами.
//
Функция МаскироватьБанковскийСчет(Знач Текст)

	Возврат МаскироватьЦепочкуЦифрДлины(Текст, 20, "***СЧЕТ***");

КонецФункции

// Сканер непрерывных цифровых цепочек точной длины (стиль
// ar_Утилиты.МаскироватьINN): цепочка нужной длины заменяется меткой, прочие
// остаются как есть. Запускается только после дешевого префильтра.
// Разложение в массив символов - один проход до цикла, результат собирается
// сегментами через СтрСоединить: посимвольной конкатенации в цикле нет.
//
// Параметры:
//   Текст       - Строка - исходный текст.
//   НужнаяДлина - Число  - требуемая длина цепочки цифр.
//   Метка       - Строка - замена цепочки ("***КПП***", "***СЧЕТ***").
//
// Возвращаемое значение:
//   Строка
//
Функция МаскироватьЦепочкуЦифрДлины(Знач Текст, Знач НужнаяДлина, Знач Метка)

	Если ПустаяСтрока(Текст) Или Не СодержитЦифру(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	СимволыСтроки = СимволыСтроки(Текст);
	Части = Новый Массив;
	Позиция = 1;
	НачалоСегмента = 1;
	ДлинаТекста = СимволыСтроки.Количество();

	Пока Позиция <= ДлинаТекста Цикл
		Если Не ЭтоЦифраСимвол(СимволыСтроки[Позиция - 1]) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Непрерывная цепочка цифр.
		НачалоЦепочки = Позиция;
		Пока Позиция <= ДлинаТекста И ЭтоЦифраСимвол(СимволыСтроки[Позиция - 1]) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;

		Если Позиция - НачалоЦепочки = НужнаяДлина Тогда
			// Нетронутый текст до цепочки и метка вместо цепочки.
			Части.Добавить(Сред(Текст, НачалоСегмента, НачалоЦепочки - НачалоСегмента));
			Части.Добавить(Метка);
			НачалоСегмента = Позиция;
		КонецЕсли;
	КонецЦикла;

	Если НачалоСегмента <= ДлинаТекста Тогда
		Части.Добавить(Сред(Текст, НачалоСегмента));
	КонецЕсли;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Разложение строки в массив символов одним линейным проходом. Выполняется
// через Сред(Текст, Позиция, 1): та же семантика по суррогатным парам UTF-16,
// что и у заменяемого посимвольного доступа. БСП-аналога нет
// (РазложитьСтрокуВМассивПодстрок требует разделитель минимум 1 символ).
//
// Параметры:
//   Текст - Строка - исходная строка.
//
// Возвращаемое значение:
//   Массив из Строка - один символ на элемент.
//
Функция СимволыСтроки(Знач Текст)

	СимволыМассив = Новый Массив;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		СимволыМассив.Добавить(Сред(Текст, Позиция, 1));
	КонецЦикла;

	Возврат СимволыМассив;

КонецФункции

// Маскирует адресную часть строки ("***АДРЕС***"): от найденного маркера
// адреса до конца значения, участок ограничен МаксДлинаАдресногоУчастка -
// защита от маскирования остатка огромной строки при ложном срабатывании.
// Переводы строк в значениях пакета реальные - до конца значения. Требование
// "цифра/заглавная после маркера" отсекает частые не-адреса: "и т. д."
// ("д." без цифры), "1 г." (после "г." строчная буква, не заглавная).
//
// Параметры:
//   Текст - Строка - строковое значение пакета.
//
// Возвращаемое значение:
//   Строка - текст с замаскированными адресными участками.
//
Функция МаскироватьАдрес(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	Маркеры = МаркерыАдресныхУчастков();
	Если Не ЕстьМаркерАдреса(Текст, Маркеры) Тогда
		Возврат Текст;
	КонецЕсли;

	Части = Новый Массив;
	ПозицияПоиска = 1;
	ДлинаТекста = СтрДлина(Текст);

	Пока Истина Цикл
		// Предыдущий участок мог дойти до конца значения - СтрНайти с начальной
		// позицией за пределами строки дает ошибку "Неверное значение параметра".
		Если ПозицияПоиска > ДлинаТекста Тогда
			Прервать;
		КонецЕсли;
		Маркер = НайтиМаркерАдреса(Текст, Маркеры, ПозицияПоиска);
		Если Маркер = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Части.Добавить(Сред(Текст, ПозицияПоиска, Маркер.Позиция - ПозицияПоиска));
		Части.Добавить("***АДРЕС***");
		ПозицияПоиска = Мин(ДлинаТекста, Маркер.Позиция + МаксДлинаАдресногоУчастка() - 1) + 1;
	КонецЦикла;

	Части.Добавить(Сред(Текст, ПозицияПоиска));

	Возврат СтрСоединить(Части, "");

КонецФункции

// Таблица маркеров адресной части (план agentrunner-244, §5.4): маркер -
// требование к символу после маркера (после пропуска пробелов): "Заглавная" -
// населенный пункт, "ЗаглавнаяИлиЦифра" - улица/площадь, "Цифра" - короткие
// дом/квартирные сокращения (самые ложнопатогенные).
//
// Возвращаемое значение:
//   Соответствие - КлючСоответствия - Строка - маркер;
//                  Значение         - Строка - требование к следующему символу.
//
Функция МаркерыАдресныхУчастков()

	Заглавная = "Заглавная";
	Цифра = "Цифра";
	ЗаглавнаяИлиЦифра = "ЗаглавнаяИлиЦифра";

	Маркеры = Новый Соответствие;

	// Населенный пункт: заглавная буква после маркера.
	Маркеры.Вставить("г.", Заглавная);
	Маркеры.Вставить("гор.", Заглавная);
	Маркеры.Вставить("пос.", Заглавная);
	Маркеры.Вставить("рп.", Заглавная);
	Маркеры.Вставить("с.", Заглавная);
	Маркеры.Вставить("обл.", Заглавная);
	Маркеры.Вставить("тер.", Заглавная);

	// Улица/площадь: цифра или заглавная буква после маркера.
	Маркеры.Вставить("ул.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("улица", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("пр.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("пр-т", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("пр-кт", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("просп.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("проспект", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("ш.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("шоссе", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("пер.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("переулок", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("наб.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("набережная", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("бул.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("бульвар", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("пл.", ЗаглавнаяИлиЦифра);
	Маркеры.Вставить("площадь", ЗаглавнаяИлиЦифра);

	// Дом/квартира: строго цифра после маркера.
	Маркеры.Вставить("д.", Цифра);
	Маркеры.Вставить("дом", Цифра);
	Маркеры.Вставить("к.", Цифра);
	Маркеры.Вставить("корп.", Цифра);
	Маркеры.Вставить("корпус", Цифра);
	Маркеры.Вставить("стр.", Цифра);
	Маркеры.Вставить("строение", Цифра);
	Маркеры.Вставить("лит.", Цифра);
	Маркеры.Вставить("оф.", Цифра);
	Маркеры.Вставить("офис", Цифра);
	Маркеры.Вставить("кв.", Цифра);
	Маркеры.Вставить("квартира", Цифра);
	Маркеры.Вставить("пом.", Цифра);
	Маркеры.Вставить("помещение", Цифра);
	Маркеры.Вставить("эт.", Цифра);
	Маркеры.Вставить("этаж", Цифра);

	Возврат Маркеры;

КонецФункции

// Префильтр МаскироватьАдрес: хотя бы один маркер присутствует в тексте.
//
// Параметры:
//   Текст   - Строка        - исходный текст.
//   Маркеры - Соответствие  - таблица маркеров (см. МаркерыАдресныхУчастков).
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьМаркерАдреса(Знач Текст, Знач Маркеры)

	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(Текст, Маркер.Ключ) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Первое валидное вхождение маркера адреса не раньше От: маркер на границе
// слова и с требуемым символом после. Если первое вхождение маркера не
// валидно, ищется следующее.
//
// Параметры:
//   Текст   - Строка       - исходный текст.
//   Маркеры - Соответствие - таблица маркеров.
//   От      - Число        - позиция, с которой искать.
//
// Возвращаемое значение:
//   Структура "Позиция, Длина", Неопределено - маркер не найден.
//
Функция НайтиМаркерАдреса(Знач Текст, Знач Маркеры, Знач От)

	НайденнаяПозиция = 0;
	НайденнаяДлина = 0;

	Для Каждого Маркер Из Маркеры Цикл
		ДлинаМаркера = СтрДлина(Маркер.Ключ);
		Позиция = СтрНайти(Текст, Маркер.Ключ, НаправлениеПоиска.СНачала, От);
		Пока Позиция > 0 Цикл
			Если МаркерАдресаНаГранице(Текст, Позиция, ДлинаМаркера, Маркер.Значение) Тогда
				Если НайденнаяПозиция = 0 Или Позиция < НайденнаяПозиция Тогда
					НайденнаяПозиция = Позиция;
					НайденнаяДлина = ДлинаМаркера;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			Позиция = СтрНайти(Текст, Маркер.Ключ, НаправлениеПоиска.СНачала, Позиция + 1);
		КонецЦикла;
	КонецЦикла;

	Если НайденнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Позиция, Длина", НайденнаяПозиция, НайденнаяДлина);

КонецФункции

// Маркер адреса на границе слова: перед маркером - начало строки или не буква,
// после маркера (после пробелов) - символ по требованию маркера.
//
// Параметры:
//   Текст        - Строка - исходный текст.
//   Позиция      - Число  - позиция маркера (с 1).
//   ДлинаМаркера - Число  - длина маркера.
//   Требование   - Строка - "Заглавная", "Цифра" или "ЗаглавнаяИлиЦифра".
//
// Возвращаемое значение:
//   Булево
//
Функция МаркерАдресаНаГранице(Знач Текст, Знач Позиция, Знач ДлинаМаркера, Знач Требование)

	Если Позиция > 1 И ЭтоБуква(Сред(Текст, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияПослеМаркера = Позиция + ДлинаМаркера;
	ДлинаТекста = СтрДлина(Текст);
	Пока ПозицияПослеМаркера <= ДлинаТекста Цикл
		Символ = Сред(Текст, ПозицияПослеМаркера, 1);
		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		ПозицияПослеМаркера = ПозицияПослеМаркера + 1;
	КонецЦикла;

	Если ПозицияПослеМаркера > ДлинаТекста Тогда
		Возврат Ложь;
	КонецЕсли;

	Символ = Сред(Текст, ПозицияПослеМаркера, 1);
	Если Требование = "Заглавная" Тогда
		Возврат ЭтоЗаглавнаяБуква(Символ);
	КонецЕсли;
	Если Требование = "Цифра" Тогда
		Возврат ЭтоЦифраСимвол(Символ);
	КонецЕсли;

	Возврат ЭтоЗаглавнаяБуква(Символ) Или ЭтоЦифраСимвол(Символ);

КонецФункции

// Предельная длина маскируемого адресного участка (от начала маркера).
//
// Возвращаемое значение:
//   Число - символов.
//
Функция МаксДлинаАдресногоУчастка()

	Возврат 120;

КонецФункции

// Маскирует названия организаций ("***ОРГ***") по маркеру правоформы
// (ООО, ПАО, ИП и т.д., сравнение по границам слова - "САО" не содержит "АО").
// Правоформа остается в тексте (диагностика), маскируется имя: за кавычкой
// "«"/""" - до парной закрывающей ("ООО «Ромашка»" -> "ООО «***ОРГ***»");
// иначе - до 5 подряд слов с заглавной буквы ("ПАО Сбербанк" ->
// "ПАО ***ОРГ***"). Идемпотентно: повторный прогон ничего не меняет.
//
// Параметры:
//   Текст - Строка - строковое значение пакета.
//
// Возвращаемое значение:
//   Строка - текст с замаскированными названиями организаций.
//
Функция МаскироватьОрганизацию(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	ПравоФормы = ПравоФормыОрганизаций();
	Если Не ЕстьПравоФормаОрганизации(Текст, ПравоФормы) Тогда
		Возврат Текст;
	КонецЕсли;

	Части = Новый Массив;
	ПозицияПоиска = 1;
	ДлинаТекста = СтрДлина(Текст);

	Пока Истина Цикл
		// Имя или правоформа могли закончиться в конце значения - СтрНайти с начальной
		// позицией за пределами строки дает ошибку "Неверное значение параметра".
		Если ПозицияПоиска > ДлинаТекста Тогда
			Прервать;
		КонецЕсли;
		ПравоФорма = НайтиПравоФорму(Текст, ПравоФормы, ПозицияПоиска);
		Если ПравоФорма = Неопределено Тогда
			Прервать;
		КонецЕсли;

		ИмяОрганизации = ИмяОрганизацииПослеПравоФормы(Текст, ПравоФорма.Позиция + ПравоФорма.Длина);
		Если ИмяОрганизации = Неопределено Тогда
			// Правоформа без узнаваемого имени ("ИП" в конце строки) - как есть.
			Части.Добавить(Сред(Текст, ПозицияПоиска, ПравоФорма.Позиция + ПравоФорма.Длина - ПозицияПоиска));
			ПозицияПоиска = ПравоФорма.Позиция + ПравоФорма.Длина;
			Продолжить;
		КонецЕсли;

		Части.Добавить(Сред(Текст, ПозицияПоиска, ИмяОрганизации.Начало - ПозицияПоиска));
		Части.Добавить("***ОРГ***");
		ПозицияПоиска = ИмяОрганизации.Начало + ИмяОрганизации.Длина;
	КонецЦикла;

	Части.Добавить(Сред(Текст, ПозицияПоиска));

	Возврат СтрСоединить(Части, "");

КонецФункции

// Маркеры правоформ организаций (план agentrunner-244, §5.4).
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ПравоФормыОрганизаций()

	ПравоФормы = Новый Массив;
	ПравоФормы.Добавить("ООО");
	ПравоФормы.Добавить("ОАО");
	ПравоФормы.Добавить("ЗАО");
	ПравоФормы.Добавить("ПАО");
	ПравоФормы.Добавить("АО");
	ПравоФормы.Добавить("АНО");
	ПравоФормы.Добавить("НКО");
	ПравоФормы.Добавить("ФГУП");
	ПравоФормы.Добавить("ФГБОУ");
	ПравоФормы.Добавить("ГУП");
	ПравоФормы.Добавить("МУП");
	ПравоФормы.Добавить("ИП");
	ПравоФормы.Добавить("КФХ");
	ПравоФормы.Добавить("СНТ");
	ПравоФормы.Добавить("ТСЖ");
	ПравоФормы.Добавить("ЖСК");
	ПравоФормы.Добавить("ПК");
	Возврат ПравоФормы;

КонецФункции

// Префильтр МаскироватьОрганизацию: хотя бы одна правоформа присутствует
// в тексте (необходимое условие; границы проверяет НайтиПравоФорму).
//
// Параметры:
//   Текст      - Строка       - исходный текст.
//   ПравоФормы - Массив из Строка - маркеры правоформ.
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьПравоФормаОрганизации(Знач Текст, Знач ПравоФормы)

	Для Каждого ПравоФорма Из ПравоФормы Цикл
		Если СтрНайти(Текст, ПравоФорма) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Первое валидное (на границе слова) вхождение правоформы не раньше От.
//
// Параметры:
//   Текст      - Строка       - исходный текст.
//   ПравоФормы - Массив из Строка - маркеры правоформ.
//   От         - Число        - позиция, с которой искать.
//
// Возвращаемое значение:
//   Структура "Позиция, Длина", Неопределено - правоформа не найдена.
//
Функция НайтиПравоФорму(Знач Текст, Знач ПравоФормы, Знач От)

	НайденнаяПозиция = 0;
	НайденнаяДлина = 0;

	Для Каждого ПравоФорма Из ПравоФормы Цикл
		ДлинаФормы = СтрДлина(ПравоФорма);
		Позиция = СтрНайти(Текст, ПравоФорма, НаправлениеПоиска.СНачала, От);
		Пока Позиция > 0 Цикл
			Если ПравоФормаНаГранице(Текст, Позиция, ДлинаФормы) Тогда
				Если НайденнаяПозиция = 0 Или Позиция < НайденнаяПозиция Тогда
					НайденнаяПозиция = Позиция;
					НайденнаяДлина = ДлинаФормы;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			Позиция = СтрНайти(Текст, ПравоФорма, НаправлениеПоиска.СНачала, Позиция + 1);
		КонецЦикла;
	КонецЦикла;

	Если НайденнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Позиция, Длина", НайденнаяПозиция, НайденнаяДлина);

КонецФункции

// Правоформа на границе слова: перед и после правоформы - начало/конец строки
// или не буква.
//
// Параметры:
//   Текст       - Строка - исходный текст.
//   Позиция     - Число  - позиция правоформы (с 1).
//   ДлинаФормы  - Число  - длина правоформы.
//
// Возвращаемое значение:
//   Булево
//
Функция ПравоФормаНаГранице(Знач Текст, Знач Позиция, Знач ДлинаФормы)

	Если Позиция > 1 И ЭтоБуква(Сред(Текст, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияПослеФормы = Позиция + ДлинаФормы;
	Если ПозицияПослеФормы <= СтрДлина(Текст) И ЭтоБуква(Сред(Текст, ПозицияПослеФормы, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Имя организации после правоформы: в кавычках ("«Ромашка»" / """Ромашка""")
// - участок между парными кавычками; без кавычек - до 5 подряд слов с заглавной
// буквы, стоп на первом не-заглавном слове или пунктуации.
//
// Параметры:
//   Текст             - Строка - исходный текст.
//   ПозицияПослеФормы - Число  - позиция сразу после правоформы.
//
// Возвращаемое значение:
//   Структура "Начало, Длина" - участок имени; Неопределено - имени не найдено.
//
Функция ИмяОрганизацииПослеПравоФормы(Знач Текст, Знач ПозицияПослеФормы)

	Позиция = ПерваяНепустаяПозиция(Текст, ПозицияПослеФормы);

	Если Позиция <= СтрДлина(Текст) Тогда
		ИмяВКавычках = ИмяОрганизацииВКавычках(Текст, Позиция);
		Если ИмяВКавычках <> Неопределено Тогда
			Возврат ИмяВКавычках;
		КонецЕсли;
	КонецЕсли;

	Возврат ИмяОрганизацииСловами(Текст, Позиция);

КонецФункции

// Имя организации в кавычках ("«Ромашка»" / """Ромашка"""): участок между
// парными кавычками. Без открывающей кавычки или без парной закрывающей -
// Неопределено.
//
// Параметры:
//   Текст              - Строка - исходный текст.
//   ПозицияОткрывающей - Число  - позиция первого символа после правоформы.
//
// Возвращаемое значение:
//   Структура "Начало, Длина" - участок имени; Неопределено - не кавычная форма.
//
Функция ИмяОрганизацииВКавычках(Знач Текст, Знач ПозицияОткрывающей)

	Открывающая = Сред(Текст, ПозицияОткрывающей, 1);
	// Кавычка последним символом: парной закрывающей нет, а СтрНайти с позицией
	// за концом строки дает ошибку.
	Если (Открывающая <> "«" И Открывающая <> """") Или ПозицияОткрывающей >= СтрДлина(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Закрывающая = ?(Открывающая = "«", "»", """");
	ПозицияЗакрывающей = СтрНайти(Текст, Закрывающая, НаправлениеПоиска.СНачала, ПозицияОткрывающей + 1);
	Если ПозицияЗакрывающей = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Начало, Длина", ПозицияОткрывающей + 1,
		ПозицияЗакрывающей - ПозицияОткрывающей - 1);

КонецФункции

// Имя организации без кавычек: до МаксСловИмениОрганизации() подряд слов
// с заглавной буквы, стоп на первом не-заглавном слове или пунктуации
// ("ПАО Сбербанк" -> "ПАО ***ОРГ***").
//
// Параметры:
//   Текст          - Строка - исходный текст.
//   ПозицияНачала  - Число  - позиция первого символа после правоформы.
//
// Возвращаемое значение:
//   Структура "Начало, Длина" - участок имени; Неопределено - слов с заглавной нет.
//
Функция ИмяОрганизацииСловами(Знач Текст, Знач ПозицияНачала)

	ДлинаТекста = СтрДлина(Текст);
	НачалоИмени = 0;
	КонецИмени = 0;
	ЧислоСлов = 0;
	Позиция = ПозицияНачала;
	Пока ЧислоСлов < МаксСловИмениОрганизации() Цикл
		Позиция = ПерваяНепустаяПозиция(Текст, Позиция);
		Если Позиция > ДлинаТекста Тогда
			Прервать;
		КонецЕсли;
		ДлинаСлова = ДлинаСловаСПозиции(Текст, Позиция);
		Если ДлинаСлова = 0 Или Не ЭтоЗаглавнаяБуква(Сред(Текст, Позиция, 1)) Тогда
			Прервать;
		КонецЕсли;
		Если НачалоИмени = 0 Тогда
			НачалоИмени = Позиция;
		КонецЕсли;
		КонецИмени = Позиция + ДлинаСлова;
		ЧислоСлов = ЧислоСлов + 1;
		Позиция = КонецИмени;
	КонецЦикла;

	Если НачалоИмени = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Начало, Длина", НачалоИмени, КонецИмени - НачалоИмени);

КонецФункции

// Первая позиция с символа, отличного от пробела и табуляции (конец строки -
// длина + 1).
//
// Параметры:
//   Текст - Строка - исходный текст.
//   От    - Число  - позиция, с которой пропускать пробелы.
//
// Возвращаемое значение:
//   Число
//
Функция ПерваяНепустаяПозиция(Знач Текст, Знач От)

	Позиция = От;
	ДлинаТекста = СтрДлина(Текст);
	Пока Позиция <= ДлинаТекста Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

// Предельное число подряд идущих слов с заглавной буквы в имени организации
// без кавычек (план agentrunner-244, §5.4).
//
// Возвращаемое значение:
//   Число
//
Функция МаксСловИмениОрганизации()

	Возврат 5;

КонецФункции

// Слово с позиции: последовательность букв, цифр и дефисов
// ("Ростов-на-Дону"); пустая последовательность - 0.
//
// Параметры:
//   Текст   - Строка - исходный текст.
//   Позиция - Число  - позиция начала слова (с 1).
//
// Возвращаемое значение:
//   Число - длина слова в символах.
//
Функция ДлинаСловаСПозиции(Знач Текст, Знач Позиция)

	ДлинаТекста = СтрДлина(Текст);
	КонецСлова = Позиция;
	Пока КонецСлова <= ДлинаТекста Цикл
		Символ = Сред(Текст, КонецСлова, 1);
		Если Не ЭтоБуква(Символ) И Не ЭтоЦифраСимвол(Символ) И Символ <> "-" Тогда
			Прервать;
		КонецЕсли;
		КонецСлова = КонецСлова + 1;
	КонецЦикла;

	Возврат КонецСлова - Позиция;

КонецФункции

// Дешевый префильтр цифровых маскеров: в тексте есть хоть одна цифра
// (несколько СтрНайти, нативный поиск подстроки - не посимвольный цикл).
//
// Параметры:
//   Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//   Булево
//
Функция СодержитЦифру(Знач Текст)

	Цифры = "0123456789";
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти(Текст, Сред(Цифры, Позиция, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Буква (кириллица или латиница, любой регистр) - для границ слов маркеров.
//
// Параметры:
//   Символ - Строка - один символ.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоБуква(Знач Символ)

	Возврат СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz", НРег(Символ)) > 0;

КонецФункции

// Заглавная буква (кириллица или латиница).
//
// Параметры:
//   Символ - Строка - один символ.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЗаглавнаяБуква(Знач Символ)

	Возврат ЭтоБуква(Символ) И Символ = ВРег(Символ);

КонецФункции

// Цифра "0".."9".
//
// Параметры:
//   Символ - Строка - один символ.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЦифраСимвол(Знач Символ)

	Возврат СтрНайти("0123456789", Символ) > 0;

КонецФункции

#КонецОбласти

#Область ТекстовыйВид

Процедура ДобавитьЗаголовок(Строки, Знач Заголовок)

	Строки.Добавить("");
	Строки.Добавить("=== " + Заголовок + " ===");

КонецПроцедуры

// Количество элементов массива (не массив - 0).
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Число - количество элементов.
//
Функция ЧислоЭлементов(Знач Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение.Количество(), 0);

КонецФункции

// Усечение длинных значений в читаемом виде; полные данные - в JSON-выгрузке.
//
// Параметры:
//   Текст - Строка - исходный текст.
//   Лимит - Число  - максимальная длина.
//
// Возвращаемое значение:
//   Строка - текст целиком или первые Лимит символов с пометкой об усечении.
//
Функция ОграничитьТекст(Знач Текст, Знач Лимит)

	Если СтрДлина(Текст) > Лимит Тогда
		Возврат Лев(Текст, Лимит) + " "
			+ НСтр("ru = '... (полностью - в JSON-выгрузке)'; en = '... (full text in the JSON export)'");
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция НетЗаписейТекст()

	Возврат "(" + НСтр("ru = 'нет записей'; en = 'no records'") + ")";

КонецФункции

Процедура ДобавитьСтруктуру(Строки, Знач Данные, Знач Пропустить = "")

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Строки.Добавить(Строка(Данные));
		Возврат;
	КонецЕсли;

	Исключаемые = СтрРазделить(Пропустить, ",", Ложь);
	Для Каждого Элемент Из Данные Цикл
		Если Исключаемые.Найти(Элемент.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Элемент.Значение;
		Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Структура")
			Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Значение = "<" + Строка(ТипЗнч(Значение)) + ", см. JSON>";
		КонецЕсли;
		Строки.Добавить("  " + Элемент.Ключ + ": " + ОграничитьТекст(Строка(Значение), 2000));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьМассивСтруктур(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ДобавитьСтруктуру(Строки, Данные);
		Возврат;
	КонецЕсли;

	Если Данные.Количество() = 0 Тогда
		Строки.Добавить(НетЗаписейТекст());
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		Для Каждого Поле Из Элемент Цикл
			Значение = Поле.Значение;
			Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Структура")
				Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
				Значение = ar_JSON.ВЗначениеJSON(Значение);
			КонецЕсли;
			Строки.Добавить("  " + Поле.Ключ + ": " + ОграничитьТекст(Строка(Значение), 2000));
		КонецЦикла;
		Строки.Добавить("");
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСреду(Строки, Знач Среда)

	Строки.Добавить("  platform_version: " + Среда.platform_version);
	Строки.Добавить("  configuration: " + Среда.configuration.name + " " + Среда.configuration.version);
	Строки.Добавить("  session_time_zone: " + Среда.session_time_zone
		+ ", server_time_offset_sec: " + Формат(Среда.server_time_offset_sec, "ЧН=0; ЧГ=0"));
	Для Каждого Расширение Из Среда.extensions Цикл
		Строки.Добавить("  extension: " + Расширение.name + " " + Расширение.version
			+ ?(Расширение.active, "", " " + НСтр("ru = '(отключено)'; en = '(disabled)'")));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРеестрИнструментов(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Массив") Или Данные.Количество() = 0 Тогда
		Строки.Добавить(НетЗаписейТекст());
		Возврат;
	КонецЕсли;

	Для Каждого Инструмент Из Данные Цикл
		Строки.Добавить(СтрШаблон("  %1 v%2: %3=%4, %5=%6, %7: %8",
			Инструмент.ar_Имя, Инструмент.ar_Версия,
			НСтр("ru = 'доступен'; en = 'available'"), Инструмент.ar_Доступен,
			НСтр("ru = 'включён'; en = 'enabled'"), Инструмент.ar_Включён,
			НСтр("ru = 'причина недоступности'; en = 'unavailability reason'"),
			Инструмент.ar_ПричинаНедоступности));
	КонецЦикла;

КонецПроцедуры

// Спека 3.1: по каждому вызову инструмента - номер, инструмент, уровень риска,
// длительность, ошибка, аргументы (до 1 500 символов) и ответ (до 2 000 символов)
// с отметкой о полной версии в JSON; не все поля записи подряд.
//
// Параметры:
//   Строки   - Массив - накапливаемые строки текста.
//   Действия - Массив - выгруженные записи ar_ДействияАгента.
//
Процедура ДобавитьВызовыИнструментов(Строки, Знач Действия)

	Если ТипЗнч(Действия) <> Тип("Массив") Или Действия.Количество() = 0 Тогда
		Строки.Добавить(НетЗаписейТекст());
		Возврат;
	КонецЕсли;

	ТекстДа = НСтр("ru = 'да'; en = 'yes'");
	ТекстНет = НСтр("ru = 'нет'; en = 'no'");
	Для Каждого Действие Из Действия Цикл
		ТекстОшибки = ?(Действие.ar_ЗавершёнСОшибкой, ТекстДа, ТекстНет);
		Строки.Добавить(СтрШаблон("  №%1 %2, %3: %4, %5: %6, %7: %8",
			Действие.ar_Последовательность,
			Действие.ar_ИмяИнструмента,
			НСтр("ru = 'риск'; en = 'risk'"), Действие.ar_УровеньРиска,
			НСтр("ru = 'длительность, мс'; en = 'duration, ms'"), Действие.ar_ДлительностьМС,
			НСтр("ru = 'ошибка'; en = 'error'"),
			ТекстОшибки));
		Строки.Добавить("    " + НСтр("ru = 'аргументы'; en = 'arguments'") + ": "
			+ ОграничитьТекст(Строка(Действие.ar_АргументыJSON), 1500));
		Ответ = Строка(Действие.ar_ОтветИнструмента);
		Если Не ПустаяСтрока(Ответ) Тогда
			Строки.Добавить("    " + НСтр("ru = 'ответ'; en = 'response'") + ": "
				+ ОграничитьТекст(Ответ, 2000));
		КонецЕсли;
		Строки.Добавить("");
	КонецЦикла;

КонецПроцедуры

// Раздел ПРЕДМЕТ (спека 3.2): предмет запуска и запись захвата.
//
// Параметры:
//   Строки - Массив   - накапливаемые строки текста.
//   Данные - Структура - subject-раздел пакета.
//
Процедура ДобавитьПредмет(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") Или Данные.Свойство("unavailable") Тогда
		Строки.Добавить(Строка(Данные));
		Возврат;
	КонецЕсли;

	ДобавитьСтруктуру(Строки, Данные.subject);
	Строки.Добавить("");
	Строки.Добавить("  " + НСтр("ru = 'Захват (ar_ПредметыАгентов)'; en = 'Capture (ar_ПредметыАгентов)'") + ":");
	ДобавитьСтруктуру(Строки, Данные.capture);

КонецПроцедуры

// Раздел ПЛАН (спека 3.3): шаблон и режим, итог, текущий шаг, статусы пунктов,
// счётчики и отказы, сжатая история изменений.
//
// Параметры:
//   Строки - Массив   - накапливаемые строки текста.
//   Данные - Структура - plan-раздел пакета.
//
Процедура ДобавитьПлан(Строки, Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Строки.Добавить(Строка(Данные));
		Возврат;
	КонецЕсли;

	ДобавитьПланШаблона(Строки, Данные.template);
	ДобавитьПланСостояния(Строки, Данные.state);
	ДобавитьПланОтказов(Строки, Данные);

КонецПроцедуры

Процедура ДобавитьПланШаблона(Строки, Знач Шаблон)

	Строки.Добавить("  " + НСтр("ru = 'Шаблон плана агента'; en = 'Agent plan template'") + ":");
	Если ТипЗнч(Шаблон) <> Тип("Структура") Или Шаблон.Свойство("unavailable") Тогда
		Строки.Добавить("    " + Строка(Шаблон));
		Возврат;
	КонецЕсли;

	Строки.Добавить("    " + НСтр("ru = 'режим'; en = 'mode'") + ": " + Шаблон.режим
		+ ", " + НСтр("ru = 'планировать работу'; en = 'plan work'") + ": " + Шаблон.планироватьРаботу);
	Если ЧислоЭлементов(Шаблон.пункты) = 0 Тогда
		Строки.Добавить("    " + НетЗаписейТекст());
	КонецЕсли;
	Для Каждого Пункт Из Шаблон.пункты Цикл
		Строки.Добавить(СтрШаблон("    - %1%2 [%3]%4",
			Пункт.заголовок,
			?(Пункт.обязательный, " " + НСтр("ru = '(обязательный)'; en = '(mandatory)'"), ""),
			СтрСоединить(Пункт.закрывающиеИнструменты, ", "),
			?(ПустаяСтрока(Строка(Пункт.инструкция)), "", " - " + Пункт.инструкция)));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПланСостояния(Строки, Знач Состояние)

	Строки.Добавить("  " + НСтр("ru = 'Выполнение плана'; en = 'Plan progress'") + ":");
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Строки.Добавить("    " + Строка(Состояние));
		Возврат;
	КонецЕсли;

	Строки.Добавить("    " + НСтр("ru = 'закрыто'; en = 'closed'") + ": " + Состояние.закрыто
		+ " " + НСтр("ru = 'из'; en = 'of'") + " " + Состояние.всего
		+ " (" + НСтр("ru = 'источник'; en = 'source'") + ": " + Состояние.источник + ")");
	Если ТипЗнч(Состояние.текущийОбязательный) = Тип("Структура") Тогда
		Строки.Добавить("    " + НСтр("ru = 'текущий обязательный шаг'; en = 'current mandatory step'")
			+ ": №" + Состояние.текущийОбязательный.номер + " " + Состояние.текущийОбязательный.заголовок);
	Иначе
		Строки.Добавить("    " + НСтр("ru = 'текущий шаг'; en = 'current step'") + ": "
			+ Строка(Состояние.текущийОбязательный));
	КонецЕсли;

	Если ЧислоЭлементов(Состояние.пункты) = 0 Тогда
		Строки.Добавить("    " + НетЗаписейТекст());
	КонецЕсли;
	Для Каждого Пункт Из Состояние.пункты Цикл
		Дополнительно = "";
		Если Не ПустаяСтрока(Строка(Пункт.закрытИнструментом)) Тогда
			Дополнительно = ", " + НСтр("ru = 'закрыт'; en = 'closed by'") + ": " + Пункт.закрытИнструментом;
		КонецЕсли;
		Если Не ПустаяСтрока(Строка(Пункт.причинаПропуска)) Тогда
			Дополнительно = Дополнительно + ", " + НСтр("ru = 'причина пропуска'; en = 'skip reason'")
				+ ": " + Пункт.причинаПропуска;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("    №%1 %2 - %3%4%5",
			Пункт.номер, Пункт.заголовок, Пункт.статус,
			?(Пункт.обязательный, " (" + НСтр("ru = 'обязательный'; en = 'mandatory'") + ")", ""),
			Дополнительно));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПланОтказов(Строки, Знач Данные)

	Счетчики = Данные.counters;
	Строки.Добавить("  " + НСтр("ru = 'Отказы плана'; en = 'Plan refusals'") + ":"
		+ " " + НСтр("ru = 'итог'; en = 'final'") + "=" + Строка(Счетчики.отказовИтогаПлана)
		+ ", " + НСтр("ru = 'подряд'; en = 'consecutive'") + "=" + Строка(Счетчики.отказовПланаПодряд)
		+ ?(Счетчики.устарели,
			" (" + НСтр("ru = 'из снимка последней паузы'; en = 'from the last pause snapshot'") + ")", ""));

	Для Каждого Отказ Из Данные.refusals Цикл
		Строки.Добавить(СтрШаблон("    %1 %2%3%4",
			Отказ.время, Отказ.код,
			?(ЗначениеЗаполнено(Отказ.шаг), ", шаг " + Отказ.шаг, ""),
			?(ПустаяСтрока(Строка(Отказ.инструмент)), "", ", инструмент " + Отказ.инструмент)));
	КонецЦикла;

	ДобавитьПланИстории(Строки, Данные.history);

КонецПроцедуры

// Сжатая история изменений плана (текстовый вид): по событию ПланОбновлён -
// строка "время [источник] закрыто/всего | сменившиеся пункты | пропуск".
//
// Параметры:
//   Строки  - Массив - накапливаемые строки текста.
//   История - Массив - history-раздел plan.
//
Процедура ДобавитьПланИстории(Строки, Знач История)

	Если ЧислоЭлементов(История) = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("  " + НСтр("ru = 'История изменений плана'; en = 'Plan history'") + ":");
	Для Каждого Событие Из История Цикл
		Сжато = "";
		Для Каждого Пункт Из Событие.сменилисьПункты Цикл
			Сжато = Сжато + ?(ПустаяСтрока(Сжато), "", "; ")
				+ Пункт.заголовок + " -> " + Пункт.статус;
		КонецЦикла;
		ТекстПропуска = "";
		Если Не ПустаяСтрока(Строка(Событие.причинаПропуска)) Тогда
			ТекстПропуска = " | " + НСтр("ru = 'пропуск'; en = 'skip'")
				+ ": " + Событие.причинаПропуска;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("    %1 [%2] %3/%4%5%6",
			Событие.время,
			?(ПустаяСтрока(Событие.источник), "model", Событие.источник),
			Событие.шаговЗакрыто, Событие.шаговВсего,
			?(ПустаяСтрока(Сжато), "", " | " + Сжато),
			ТекстПропуска));
	КонецЦикла;

КонецПроцедуры

// Единая хронология: события запуска, диалог, служебный лог, журнал регистрации.
// Строка вызова инструмента (событие ВызванИнструмент) дополняется кратким
// ответом до 300 символов (спека 3.1).
//
// Параметры:
//   Строки - Массив    - накапливаемые строки текста.
//   Пакет  - Структура - пакет лога (СобратьПакет).
//
Процедура ДобавитьХронологию(Строки, Знач Пакет)

	Хронология = Новый ТаблицаЗначений;
	Хронология.Колонки.Добавить("Момент");
	Хронология.Колонки.Добавить("Порядок");
	Хронология.Колонки.Добавить("Текст");

	Порядок = 0;
	ОчередьОтветов = ОчередьОтветовИнструментов(Пакет.run_data.actions);

	ДобавитьСобытияВХронологию(Хронология, Пакет, ОчередьОтветов, Порядок);
	ДобавитьДиалогВХронологию(Хронология, Пакет, Порядок);
	ДобавитьСлужебныйЛогВХронологию(Хронология, Пакет, Порядок);
	ДобавитьЖурналРегистрацииВХронологию(Строки, Хронология, Пакет, Порядок);

	Хронология.Сортировать("Момент, Порядок");
	Для Каждого Запись Из Хронология Цикл
		Строки.Добавить(Запись.Момент + "  " + Запись.Текст);
	КонецЦикла;

КонецПроцедуры

// События ar_СобытияЗапуска в хронологию; строка вызова инструмента дополняется
// кратким ответом из очереди (спека 3.1).
//
// Параметры:
//   Хронология   - ТаблицаЗначений - таблица "Момент, Порядок, Текст".
//   Пакет        - Структура       - пакет лога.
//   ОчередьОтветов - Соответствие  - очереди ответов инструментов.
//   Порядок      - Число           - сквозной счетчик (передается по ссылке).
//
Процедура ДобавитьСобытияВХронологию(Хронология, Знач Пакет, Знач ОчередьОтветов, Порядок)

	Для Каждого Событие Из Пакет.run_data.events Цикл
		Порядок = Порядок + 1;
		ТекстНагрузки = "";
		Если Событие.Свойство("payload") Тогда
			ТекстНагрузки = ОграничитьТекст(ar_JSON.ВЗначениеJSON(Событие.payload), 1500);
		КонецЕсли;
		СтрокаСобытия = СтрШаблон("%1 #%2 %3 %4",
			НСтр("ru = 'СОБЫТИЕ'; en = 'EVENT'"), Событие.ar_Sequence, Событие.ar_ТипСобытия, ТекстНагрузки);
		Если ЭтоВызовИнструмента(Событие) Тогда
			Ответ = СледующийОтветИнструмента(ОчередьОтветов,
				Строка(ЗначениеПоКлючу(Событие.payload, "tool")));
			Если Не ПустаяСтрока(Ответ) Тогда
				СтрокаСобытия = СтрокаСобытия + " => " + ОграничитьТекст(Ответ, 300);
			КонецЕсли;
		КонецЕсли;
		ДобавитьВХронологию(Хронология, Порядок, Событие.ar_МоментВремени, СтрокаСобытия);
	КонецЦикла;

КонецПроцедуры

// Сообщения ленты диалога в хронологию.
//
// Параметры:
//   Хронология - ТаблицаЗначений - таблица "Момент, Порядок, Текст".
//   Пакет      - Структура       - пакет лога.
//   Порядок    - Число           - сквозной счетчик (передается по ссылке).
//
Процедура ДобавитьДиалогВХронологию(Хронология, Знач Пакет, Порядок)

	Если ТипЗнч(Пакет.dialog) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Сообщение Из Пакет.dialog Цикл
		Порядок = Порядок + 1;
		ДобавитьВХронологию(Хронология, Порядок, Сообщение.ar_Момент,
			СтрШаблон("%1 [%2/%3]%4 %5",
				НСтр("ru = 'ДИАЛОГ'; en = 'DIALOG'"), Сообщение.ar_Автор, Сообщение.ar_ВидСообщения,
				?(Сообщение.belongs_to_run, "", " " + НСтр("ru = '(другой запуск)'; en = '(other run)'")),
				Сообщение.ar_Текст));
	КонецЦикла;

КонецПроцедуры

// Записи ar_СлужебныйЛог в хронологию.
//
// Параметры:
//   Хронология - ТаблицаЗначений - таблица "Момент, Порядок, Текст".
//   Пакет      - Структура       - пакет лога.
//   Порядок    - Число           - сквозной счетчик (передается по ссылке).
//
Процедура ДобавитьСлужебныйЛогВХронологию(Хронология, Знач Пакет, Порядок)

	Если ТипЗнч(Пакет.service_log) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Пакет.service_log Цикл
		Порядок = Порядок + 1;
		// Запись без RunId - из периода работы, не запуска: префикс-предупреждение.
		ДобавитьВХронологию(Хронология, Порядок, Запись.ar_Момент,
			СтрШаблон("%1%2 [%3] %4/%5: %6",
				НСтр("ru = 'СЛУЖЕБНЫЙ ЛОГ'; en = 'SERVICE LOG'"),
				?(ПустаяСтрока(Запись.ar_RunId), " " + НСтр("ru = '[без RunId]'; en = '[no RunId]'"), ""),
				Запись.ar_Уровень, Запись.ar_Источник, Запись.ar_Событие, Запись.ar_Текст));
	КонецЦикла;

КонецПроцедуры

// Записи журнала регистрации в хронологию; недоступный журнал - строкой в текст.
//
// Параметры:
//   Строки     - Массив          - накапливаемые строки текста.
//   Хронология - ТаблицаЗначений - таблица "Момент, Порядок, Текст".
//   Пакет      - Структура       - пакет лога.
//   Порядок    - Число           - сквозной счетчик (передается по ссылке).
//
Процедура ДобавитьЖурналРегистрацииВХронологию(Строки, Хронология, Знач Пакет, Порядок)

	Если Пакет.event_log.Свойство("entries") Тогда
		Для Каждого Запись Из Пакет.event_log.entries Цикл
			Порядок = Порядок + 1;
			ДобавитьВХронологию(Хронология, Порядок, Запись.Дата,
				СтрШаблон("%1 [%2] %3, %4 %5, %6 %7: %8",
					НСтр("ru = 'ЖУРНАЛ РЕГИСТРАЦИИ'; en = 'EVENT LOG (server)'"),
					Запись.Уровень, Запись.Событие,
					НСтр("ru = 'пользователь'; en = 'user'"), Запись.Пользователь,
					НСтр("ru = 'сеанс'; en = 'session'"), Запись.Сеанс, Запись.Комментарий));
		КонецЦикла;
	ИначеЕсли Пакет.event_log.Свойство("unavailable") Тогда
		Строки.Добавить("(" + НСтр("ru = 'журнал регистрации недоступен'; en = 'event log unavailable'")
			+ ": " + Пакет.event_log.unavailable + ")");
	Иначе
		// Нестандартная форма раздела - как пустой журнал.
		Строки.Добавить(НетЗаписейТекст());
	КонецЕсли;

КонецПроцедуры

// Событие вызова инструмента (полезная нагрузка tool_called).
//
// Параметры:
//   Событие - Структура - выгруженная запись события.
//
// Возвращаемое значение:
//   Булево - признак вызова инструмента.
//
Функция ЭтоВызовИнструмента(Знач Событие)

	Если Не Событие.Свойство("payload") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Строка(ЗначениеПоКлючу(Событие.payload, "code")) = "tool_called";

КонецФункции

// Очередь ответов инструментов по записям ar_ДействияАгента: имя -> массив
// ответов в порядке вызовов. Сопоставление с событиями tool_called по порядку:
// и события, и действия одного запуска упорядочены по времени.
//
// Параметры:
//   Действия - Массив - выгруженные записи ar_ДействияАгента.
//
// Возвращаемое значение:
//   Соответствие - "имя инструмента" - Массив ответов.
//
Функция ОчередьОтветовИнструментов(Знач Действия)

	Очередь = Новый Соответствие;
	Для Каждого Действие Из Действия Цикл
		Имя = Строка(Действие.ar_ИмяИнструмента);
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Список = Очередь.Получить(Имя);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Очередь.Вставить(Имя, Список);
		КонецЕсли;
		Список.Добавить(Строка(Действие.ar_ОтветИнструмента));
	КонецЦикла;
	Возврат Очередь;

КонецФункции

// Ответ следующего вызова инструмента; пустая строка, если ответа нет.
//
// Параметры:
//   Очередь - Соответствие - queues из ОчередьОтветовИнструментов (mutates позиция).
//   Имя     - Строка       - имя инструмента.
//
// Возвращаемое значение:
//   Строка - следующий ответ или "".
//
Функция СледующийОтветИнструмента(Очередь, Знач Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Список = Очередь.Получить(Имя);
	Если Список = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Позиция = Очередь.Получить("позиция:" + Имя);
	Если Позиция = Неопределено Тогда
		Позиция = 0;
	КонецЕсли;
	Если Позиция >= Список.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Очередь.Вставить("позиция:" + Имя, Позиция + 1);
	Возврат Список[Позиция];

КонецФункции

// Строка хронологии.
//
// Параметры:
//   Хронология - ТаблицаЗначений - таблица "Момент, Порядок, Текст".
//   Порядок    - Число           - порядковый номер при равных моментах.
//   Момент     - Произвольный    - время строки (Строка после ВЗаписываемое).
//   Текст      - Строка          - текст строки хронологии.
//
Процедура ДобавитьВХронологию(Хронология, Знач Порядок, Знач Момент, Знач Текст)

	Запись = Хронология.Добавить();
	Запись.Момент = Строка(Момент);
	Запись.Порядок = Порядок;
	Запись.Текст = Текст;

КонецПроцедуры

// Сообщения диалога из снимка состояния (Состояние.Сообщения).
//
// Параметры:
//   Строки - Массив   - накапливаемые строки текста.
//   Снимок - Структура - state_snapshot-раздел пакета.
//
Процедура ДобавитьСообщенияСнимка(Строки, Знач Снимок)

	Сообщения = ЗначениеПоКлючу(ЗначениеПоКлючу(Снимок, "state"), "Сообщения");

	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Причина = ЗначениеПоКлючу(Снимок, "unavailable");
		Если Причина <> Неопределено Тогда
			Строки.Добавить("(" + НСтр("ru = 'снимок недоступен'; en = 'snapshot unavailable'")
				+ ": " + Причина + ")");
		ИначеЕсли ЗначениеПоКлючу(Снимок, "raw") <> Неопределено Тогда
			Строки.Добавить("(" + НСтр("ru = 'нестандартный формат снимка, содержимое - в JSON';
				|en = 'non-standard snapshot format, content in JSON'") + ")");
		Иначе
			Строки.Добавить("(" + НСтр("ru = 'в снимке нет списка сообщений';
				|en = 'snapshot has no message list'") + ")");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Номер = Номер + 1;
		ТекстСообщения = ?(ТипЗнч(Сообщение) = Тип("Строка"), Сообщение, ar_JSON.ВЗначениеJSON(Сообщение));
		Строки.Добавить("#" + Номер + " " + ОграничитьТекст(ТекстСообщения, 3000));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
