////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_AuditДействия (Аудит действий агента).
//
// Единственная точка записи журнала выполненных tool-действий агента в
// независимый регистр сведений ar_ДействияАгента. Запись делает диспетчер
// ar_ИнструментыДиспетчер после каждого вызова tool (успешного или ошибочного).
//
// Измерения регистра: ar_ИдентификаторЗапуска (UUID-строка 36) + ar_Последовательность (порядковый
// номер действия внутри запуска). Ресурсы: ar_ИмяИнструмента, ar_АргументыJSON,
// ar_ОтветИнструмента (ответ инструмента - observation, agentrunner-55),
// ar_УровеньРиска (EnumRef.ar_УровеньРиска), ar_СсылкаНаРезультат (навигационная ссылка),
// ar_КемПодтверждено (CatalogRef.Пользователи), ar_ДатаПодтверждения (Дата).
//
// Свойства модуля: Сервер, Привилегированный = Ложь (AUD-06: платформа
// запрещает Privileged=true в общих модулях расширений - "Cannot use
// privileged common modules in extensions", проверено при загрузке .cfe в
// реальную ИБ). Привилегии поднимает вызывающий код точечно -
// УстановитьПривилегированныйРежим(Истина)/Попытка...Исключение...(Ложь)/
// КонецПопытки/(Ложь) - через фасад ar_AuditЗащищённыйРежим
// (ЗаписатьДействиеПривилегированно) там, где он подключён, либо локально в
// вызывающем модуле. Ранее (AUD-03/AUD-04/AUD-05) привилегия выставлялась
// в манифесте - см. AUD-06 для истории смены механизма. Аналогично
// ar_AuditЗапуски / ar_AuditСобытия.
//
// Модуль не выбрасывает исключений наружу: сбой записи журнала действий не
// должен валить runtime-цикл агента. При ошибке пишется запись в журнал
// регистрации и возвращается Ложь.
//
// См. спеку: .docs/specs/DISP-01.md (вариант A), AUD-03, Plan §2.8, §3.1.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Записать выполненное действие агента в регистр ar_ДействияАгента.
//
// Идемпотентна по ключу (RunId, Sequence): повторный вызов с тем же ключом
// перезаписывает запись (независимый регистр, набор по измерениям).
//
// Параметры:
//  RunId          - Строка    - идентификатор запуска (UUID, длина 36). Обязателен.
//  Sequence       - Число     - порядковый номер действия внутри запуска (>= 0).
//  ИмяИнструмента - Строка    - имя инструмента (значение реквизита ar_Имя). Обрезается до 128.
//  АргументыJSON  - Строка    - JSON-аргументы вызова (для трассировки).
//  RiskLevel      - ПеречислениеСсылка.ar_УровеньРиска, Строка - уровень риска.
//                                Строка трактуется как имя значения перечисления.
//  ResultRef      - Строка, Произвольный - навигационная ссылка результата либо
//                                ссылочное значение (приводится через ar_Утилиты).
//                                Может быть пустой.
//  ДополнительныеДанные - Структура - опционально: {ApprovedBy, ApprovedAt}
//                                для commit-действий, прошедших approval, и/или
//                                {ДлительностьМС, ЗавершёнСОшибкой} (PERF-04), и/или
//                                {Ответ} - ответ инструмента (observation) для ресурса
//                                ar_ОтветИнструмента (agentrunner-55).
//                                Может быть Неопределено.
//
// Возвращаемое значение:
//  Булево - Истина, если запись выполнена; Ложь при ошибке валидации/записи.
//
Функция Записать(Знач RunId, Знач Sequence, Знач ИмяИнструмента, Знач АргументыJSON,
		Знач RiskLevel, Знач ResultRef = "", Знач ДополнительныеДанные = Неопределено) Экспорт

	Попытка

		Если ТипЗнч(RunId) <> Тип("Строка") Или ПустаяСтрока(RunId) Тогда
			ЗаписатьПредупреждение(
				НСтр("ru = 'Действие не записано: пустой RunId';
					|en = 'Action not recorded: empty RunId'"));
			Возврат Ложь;
		КонецЕсли;

		НомерДействия = ?(ТипЗнч(Sequence) = Тип("Число"), Макс(0, Цел(Sequence)), 0);

		МенеджерЗаписи = РегистрыСведений.ar_ДействияАгента.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_ИдентификаторЗапуска    = Лев(RunId, 36);
		МенеджерЗаписи.ar_Последовательность = НомерДействия;

		МенеджерЗаписи.ar_ИмяИнструмента = ar_Утилиты.ОбрезатьДо(СтрокаЗначения(ИмяИнструмента), 128);
		МенеджерЗаписи.ar_АргументыJSON  = СтрокаЗначения(АргументыJSON);
		МенеджерЗаписи.ar_УровеньРиска     = ЗначениеRiskLevel(RiskLevel);
		МенеджерЗаписи.ar_СсылкаНаРезультат     = ar_Утилиты.ОбрезатьДо(
			ar_Утилиты.НавигационнаяСсылкаОбъекта(ResultRef), 300);

		ЗаполнитьДанныеApproval(МенеджерЗаписи, ДополнительныеДанные);
		ЗаполнитьДанныеPERF(МенеджерЗаписи, ДополнительныеДанные);
		ЗаполнитьОтветИнструмента(МенеджерЗаписи, ДополнительныеДанные);

		МенеджерЗаписи.Записать(Истина);
		Возврат Истина;

	Исключение
		ЗаписатьОшибку(
			НСтр("ru = 'Ошибка записи действия агента в ar_ДействияАгента';
				|en = 'Failed to record agent action into ar_ДействияАгента'"),
			ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить ресурсы approval (ApprovedBy / ApprovedAt) из дополнительных данных.
//
// Параметры:
//  МенеджерЗаписи        - РегистрСведенийМенеджерЗаписи.ar_ДействияАгента - менеджер
//                          записи, ресурсы которого заполняются данными approval.
//  ДополнительныеДанные  - Структура - {ApprovedBy, ApprovedAt} для commit-действий;
//                          может быть Неопределено или иного типа (тогда без действий).
//
Процедура ЗаполнитьДанныеApproval(МенеджерЗаписи, Знач ДополнительныеДанные)

	Если ТипЗнч(ДополнительныеДанные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ApprovedBy = Неопределено;
	Если ДополнительныеДанные.Свойство("ApprovedBy", ApprovedBy)
		И ТипЗнч(ApprovedBy) = Тип("СправочникСсылка.Пользователи") Тогда
		МенеджерЗаписи.ar_КемПодтверждено = ApprovedBy;
	КонецЕсли;

	ApprovedAt = Неопределено;
	Если ДополнительныеДанные.Свойство("ApprovedAt", ApprovedAt)
		И ТипЗнч(ApprovedAt) = Тип("Дата") Тогда
		МенеджерЗаписи.ar_ДатаПодтверждения = ApprovedAt;
	КонецЕсли;

КонецПроцедуры

// Заполнить ресурсы длительности вызова (ar_ДлительностьМС / ar_ЗавершёнСОшибкой)
// из дополнительных данных (PERF-04). Отсутствие ключей - штатная ситуация
// (регистр читается 0/Ложь по умолчанию, см. FillValue ресурсов) - без действий.
//
// Параметры:
//  МенеджерЗаписи        - РегистрСведенийМенеджерЗаписи.ar_ДействияАгента - менеджер
//                          записи, ресурсы которого заполняются данными длительности.
//  ДополнительныеДанные  - Структура - {ДлительностьМС, ЗавершёнСОшибкой}; может быть
//                          Неопределено, иного типа или без этих ключей (тогда без действий).
//
Процедура ЗаполнитьДанныеPERF(МенеджерЗаписи, Знач ДополнительныеДанные)

	Если ТипЗнч(ДополнительныеДанные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ДлительностьМС = Неопределено;
	Если ДополнительныеДанные.Свойство("ДлительностьМС", ДлительностьМС)
		И ТипЗнч(ДлительностьМС) = Тип("Число") Тогда
		МенеджерЗаписи.ar_ДлительностьМС = Макс(0, Цел(ДлительностьМС));
	КонецЕсли;

	ЗавершёнСОшибкой = Неопределено;
	Если ДополнительныеДанные.Свойство("ЗавершёнСОшибкой", ЗавершёнСОшибкой)
		И ТипЗнч(ЗавершёнСОшибкой) = Тип("Булево") Тогда
		МенеджерЗаписи.ar_ЗавершёнСОшибкой = ЗавершёнСОшибкой;
	КонецЕсли;

КонецПроцедуры

// Заполнить ресурс ответа инструмента (ar_ОтветИнструмента) из дополнительных
// данных (agentrunner-55). Ответ маскируется при записи (SEC-02: в аудите
// секреты не хранятся) и обрезается по лимиту ЛимитОтветаИнструмента() с
// признаком усечения в конце. Отсутствие ключа Ответ - штатная ситуация
// (запись approval-обновления, вызовы без ответа): менеджер записи пишет
// дефолт - пустую строку, контракт "записать целиком" сохраняется.
//
// Параметры:
//  МенеджерЗаписи        - РегистрСведенийМенеджерЗаписи.ar_ДействияАгента - менеджер
//                          записи, ресурс которого заполняется ответом.
//  ДополнительныеДанные  - Структура - {Ответ} - ответ инструмента (то, что
//                          получила модель); может быть Неопределено, иного типа
//                          или без ключа Ответ (тогда без действий).
//
Процедура ЗаполнитьОтветИнструмента(МенеджерЗаписи, Знач ДополнительныеДанные)

	Если ТипЗнч(ДополнительныеДанные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Ответ = Неопределено;
	Если Не ДополнительныеДанные.Свойство("Ответ", Ответ)
		Или ТипЗнч(Ответ) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Ответ) Тогда
		Возврат;
	КонецЕсли;

	Маскированный = ar_Утилиты.МаскироватьСекреты(Ответ);
	ДлинаОтвета = СтрДлина(Маскированный);
	Лимит = ЛимитОтветаИнструмента();

	Если ДлинаОтвета <= Лимит Тогда
		МенеджерЗаписи.ar_ОтветИнструмента = Маскированный;
		Возврат;
	КонецЕсли;

	ЛимитСтрокой = Формат(Лимит, "ЧГ=0");
	ДлинаСтрокой = Формат(ДлинаОтвета, "ЧГ=0");
	ПризнакУсечения = СтрШаблон(
		НСтр("ru = '[ответ обрезан: сохранено %1 из %2 символов]';
			|en = '[response truncated: saved %1 of %2 characters]'"),
		ЛимитСтрокой, ДлинаСтрокой);
	МенеджерЗаписи.ar_ОтветИнструмента = Лев(Маскированный, Лимит) + ПризнакУсечения;

КонецПроцедуры

// Лимит размера сохраняемого ответа инструмента (символов) для ресурса
// ar_ОтветИнструмента. Совпадает с лимитом аргументов вызова
// (ar_JSON.ПроверитьРазмерАргументов): при превышении ответ обрезается
// с признаком усечения в конце (см. ЗаполнитьОтветИнструмента).
//
// Возвращаемое значение:
//  Число - максимальная длина ответа при записи (без признака усечения).
//
Функция ЛимитОтветаИнструмента()
	Возврат 65536;
КонецФункции

// Привести RiskLevel к ПеречислениеСсылка.ar_УровеньРиска.
// Строка трактуется как имя значения (Чтение/Черновик/Запись/Фиксация); неизвестное
// значение и пустота → Чтение (безопасный дефолт).
//
// Параметры:
//  RiskLevel - ПеречислениеСсылка.ar_УровеньРиска, Строка - уровень риска либо имя
//              значения перечисления (Чтение/Черновик/Запись/Фиксация).
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_УровеньРиска - распознанное значение либо Чтение по умолчанию.
//
Функция ЗначениеRiskLevel(Знач RiskLevel)

	Если ТипЗнч(RiskLevel) = Тип("ПеречислениеСсылка.ar_УровеньРиска") Тогда
		Возврат RiskLevel;
	КонецЕсли;

	Если ТипЗнч(RiskLevel) = Тип("Строка") И Не ПустаяСтрока(RiskLevel) Тогда
		ЗначениеМД = Метаданные.Перечисления.ar_УровеньРиска.ЗначенияПеречисления.Найти(СокрЛП(RiskLevel));
		Если ЗначениеМД <> Неопределено Тогда
			Возврат Перечисления.ar_УровеньРиска[ЗначениеМД.Имя];
		КонецЕсли;
	КонецЕсли;

	Возврат Перечисления.ar_УровеньРиска.Чтение;

КонецФункции

// Безопасно привести значение к строке (Неопределено → "").
//
// Параметры:
//  Значение - Произвольный - значение любого типа для приведения к строке.
//
// Возвращаемое значение:
//  Строка - строковое представление значения; пустая строка при Неопределено.
//
Функция СтрокаЗначения(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Запись ошибки в журнал регистрации с маскировкой секретов.
// Best-effort: собственный сбой логирования подавляется и не пробрасывается
// наружу, чтобы не нарушить контракт «модуль не выбрасывает исключений».
//
// Параметры:
//  Заголовок            - Строка - заголовок сообщения об ошибке для журнала.
//  ИнформацияОбОшибке   - ИнформацияОбОшибке - сведения об исключении из блока
//                         Исключение (результат ИнформацияОбОшибке()).
//
Процедура ЗаписатьОшибку(Знач Заголовок, Знач ИнформацияОбОшибке)
	Попытка
		Текст = Заголовок + ": "
			+ ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ar_AuditДействия'; en = 'aosAuditActions'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Текст);
	Исключение
		// Логирование - best-effort: сбой самого логирования намеренно подавляем,
		// чтобы не нарушить контракт "модуль не выбрасывает исключений наружу".
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Запись предупреждения в журнал регистрации.
//
// Параметры:
//  Текст - Строка - текст предупреждения; секреты маскируются перед записью.
//
Процедура ЗаписатьПредупреждение(Знач Текст)
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ar_AuditДействия'; en = 'aosAuditActions'"),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		ar_Утилиты.МаскироватьСекреты(Текст));
КонецПроцедуры

#КонецОбласти
