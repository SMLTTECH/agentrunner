////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Уведомления (CONS-12: единая точка уведомлений об эскалации).
//
// Единственная публичная точка - Уведомить(RunId, ТипСобытия) - вызывается
// ровно из трёх мест (см. DoD D2, .docs/specs/CONS-12.md):
//  1. ar_Надзор.ЗафиксироватьЭскалацию               -> "escalation"
//  2. ar_Подтверждение.Поставить                          -> "approval_pending"
//  3. ar_RuntimeЦикл.ЗапланироватьТехповторЕслиНужно  -> "retry_exhausted"
// Успешное завершение (Completed) и промежуточные ошибки (Failed с
// оставшимися повторами) - молча, без вызова этой функции вовсе.
//
// ТипСобытия здесь - локальная строковая классификация ("escalation" /
// "approval_pending" / "retry_exhausted"), НЕ Перечисление.ar_ТипСобытия
// аудита (см. «Контракт функции» спеки).
//
// РЕШЕНИЕ ПОЛЬЗОВАТЕЛЯ (зафиксировано в .docs/specs/CONS-12.md, «Реализация»):
// email отправляется РЕАЛЬНО и СИНХРОННО внутри вызова Уведомить - Вариант Б
// из спеки: прямой вызов БСП РаботаСПочтовымиСообщениями.ОтправитьПисьмо,
// без создания документа Взаимодействия.ЭлектронноеПисьмоИсходящее. Это
// сознательный отказ от переиспользования ar_ИнструментыКоммуникации: тот модуль
// (ИсполнитьПодготовкуПисьма/ИсполнитьПодготовкуПисьмаНапоминания) вызывает
// Взаимодействия.СоздатьПисьмо(..., ОтправитьСразу=Ложь) - создаёт только
// черновик, который реально уходит лишь регламентным заданием БСП
// ПолучениеИОтправкаЭлектронныхПисем или интерактивной отправкой оператором.
// Для системного уведомления об эскалации такая задержка недопустима (DoD D7
// требует, чтобы письмо не оставалось черновиком). Если учётная запись
// электронной почты не настроена (или отправка иначе не удалась) - функция
// НЕ делает вид, что письмо ушло: пишет явную ошибку в ar_СлужебныйЛог с
// прямым указанием причины и возвращает Отправлено=Ложь. Молчаливого
// проглатывания эскалации нет.
//
// Цепочка адресатов (см. «Реализация», п.1) - первый непустой результат:
//  1. ТЧ ar_Ответственные профиля запуска (ar_ПрофилиЗапуска.Ответственные).
//  2. ar_Агенты.ar_Пользователь (если профиль пуст/без строк).
//  3. Администраторы (ПолныеПрава) + Предупреждение в ar_СлужебныйЛог о
//     «беспризорном» агенте (ни профиля, ни ar_Пользователь).
// Каждый email разыменовывается через КИ (УправлениеКонтактнойИнформацией),
// тот же вызов, что уже использует ar_ИнструментыКоммуникации.EmailКонтрагента.
//
// Канал - только Email реализован. Оповещение1С/Задача/Telegram возвращают
// честную заглушку {status: "not_implemented"} и пишут Предупреждение в
// ar_СлужебныйЛог - без попытки создать документ/оповещение/задачу (см. DoD D6).
//
// Дедупликация (см. «Реализация», п.4) - по RunId + повод (ТипСобытия),
// маркер - новое значение Перечисление.ar_ТипСобытия.NotificationSent с
// payload {reason: "escalation"|"approval_pending"|"retry_exhausted"}.
// Гонка TOCTOU (два параллельных прохода одновременно решают отправить)
// закрывается тем же приёмом, что уже применяет ar_AuditСобытия.ЗаписатьСобытие
// для этого же регистра: БлокировкаДанных по РегистрСведений.ar_СобытияЗапуска
// с измерением ar_RunId внутри ЯВНОЙ транзакции, охватывающей проверку
// дедупликации + резервирующую запись NotificationSent. Блокировка 1С по
// одному и тому же ключу реентерабельна в пределах одной транзакции/сеанса -
// вложенный вызов ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно
// (который сам блокирует тот же регистр по тому же RunId при физической
// записи NotificationSent) не создаёт взаимоблокировку. Второй параллельный
// вызов Уведомить для того же RunId+повода ждёт снятия блокировки первым,
// затем видит уже записанный NotificationSent и не отправляет письмо
// повторно (idempotent no-op) - см. DoD D8.
//
// SMTP - защита от зависания (см. «Риски» спеки, «SMTP - внешний синхронный
// вызов»): платформенного асинхронного API отправки почты не найдено;
// ограничение таймаута фактически задаётся в настройках самой учётной
// записи (Справочник.УчетныеЗаписиЭлектроннойПочты, профиль SMTP -
// параметр ТаймаутОжидания).
//
// Учётная запись для отправки - УчетнаяЗаписьДляУведомлений(): в приоритете
// типовая настройка ПочтаУчетнаяЗаписьУведомлений (agentrunner-85, ссылка
// на Справочник.УчетныеЗаписиЭлектроннойПочты, читается без кэша и
// привилегированно); иначе - в конфигурациях с подсистемой Взаимодействий -
// запись по умолчанию (модуль УправлениеЭлектроннойПочтой берётся через
// ОбщегоНазначения.ОбщийМодуль - в БП подсистемы и модуля нет),
// в БП - из ДоступныеУчетныеЗаписи для отправки (системная запись в приоритете).
// Модуль не блокирует общий путь навечно -
// вся сетевая часть обёрнута в Попытка/Исключение (см. D9) и оборачивается
// только вокруг ОДНОГО вызова ОтправитьПисьмо; при недоступности SMTP
// платформа сама вернёт исключение по таймауту профиля, тот же принцип,
// что уже действует для любой другой синхронной отправки почты в БСП.
// Решение НЕ переносить отправку в фоновое задание объясняется в
// .docs/specs/CONS-12.md, «Реализация» (обоснование: письмо равнозначно
// самой эскалации/approval-уведомлению, задержка в очереди фонового задания
// противоречила бы цели «эскалация доходит письмом сейчас же»; риск
// зависания синхронного вызова смягчается таймаутом профиля SMTP учётной
// записи и тройной защитой Попытка/Исключение по образцу
// ar_Надзор.ПроверитьДостижениеЦели).
//
// БЕЗОПАСНОСТЬ (D9, тот же принцип, что и ar_Надзор/ar_RuntimeЦикл): любая
// ошибка внутри Уведомить (недоступность SMTP, отсутствие учётной записи,
// сбой БСП-вызова, сбой чтения адресатов) перехватывается ВНУТРИ модуля и
// НЕ пробрасывается наружу - ни один из трёх вызывающих путей не должен
// упасть или изменить свой основной результат из-за сбоя уведомления.
//
// D10: функция не обращается к ar_Подтверждение (не ставит и не читает очередь
// подтверждений) - уведомление системы идёт в обход approval, это сообщение
// runtime, а не действие агента.
//
// D11: текст любой ошибки перед записью в ar_СлужебныйЛог прогоняется через
// ar_Утилиты.МаскироватьСекреты - на случай, если исключение БСП/платформы
// от SMTP-подключения содержит логин/пароль/токен учётной записи в тексте.
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь (AUD-06 -
// расширениям запрещён Privileged=true в общих модулях). Привилегии
// поднимаются точечно там, где это уже принято в проекте: чтение
// ar_СобытияЗапуска для дедупликации и запись NotificationSent (через
// ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно) - т.к. функция
// вызывается в том числе из регламентного задания (ar_RuntimeЦикл), где нет
// гарантии интерактивного пользователя с ролью на audit-регистры. Сама
// отправка письма выполняется в правах текущего сеанса (не привилегированно) -
// БСП УправлениеЭлектроннойПочтой/РаботаСПочтовымиСообщениями сами поднимают
// привилегии там, где это нужно им.
//
// Запрещено: Выполнить(), Вычислить().
//
// См. спеку: .docs/specs/CONS-12.md, План-консоль-автономных-агентов.md §3Б.4.
////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Единая точка уведомления об эскалации/approval-действии/исчерпанных
// повторах. Читает весь необходимый контекст сама по RunId - принимает
// только RunId и повод (см. doc-комментарий модуля, «Контракт функции»).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска. Обязателен.
//  ТипСобытия - Строка - один из трёх поводов:
//               "escalation" / "approval_pending" / "retry_exhausted".
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Канал: Строка, Причина: Строка}.
//  Отправлено=Истина только при реальной успешной синхронной отправке
//  письма. Причина - код диагностики ("ok" / "not_implemented" /
//  "duplicate" / "no_recipients" / "no_email_account" / "send_failed" /
//  "internal_error" / "invalid_arguments"). Вызывающий код НЕ обязан
//  анализировать результат - используется только для диагностики/тестов.
//
// Исключения: не пробрасываются (D9) - любая ошибка внутри перехватывается,
//  фиксируется в ar_СлужебныйЛог уровня "Ошибка", функция возвращает
//  Отправлено=Ложь.
//
Функция Уведомить(Знач RunId, Знач ТипСобытия) Экспорт

	Результат = Новый Структура("Отправлено, Канал, Причина", Ложь, "", "internal_error");

	Попытка

		Если ТипЗнч(RunId) <> Тип("Строка") Или ПустаяСтрока(RunId) Тогда
			Результат.Причина = "invalid_arguments";
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_bad_args",
				"RunId пуст или не строка", "Ошибка");
			Возврат Результат;
		КонецЕсли;

		Если ТипЗнч(ТипСобытия) <> Тип("Строка") Или ПустаяСтрока(ТипСобытия) Тогда
			Результат.Причина = "invalid_arguments";
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_bad_args",
				"ТипСобытия пуст или не строка (RunId=" + RunId + ")", "Ошибка", RunId);
			Возврат Результат;
		КонецЕсли;

		Возврат УведомитьВнутр(СокрЛП(RunId), СокрЛП(ТипСобытия));

	Исключение
		// Последний защитный барьер (D9): даже неожиданная ошибка внутри
		// самой обвязки не должна пробрасываться в ar_Надзор/ar_Подтверждение/
		// ar_RuntimeЦикл - тот же принцип, что ar_Надзор.ПроверитьДостижениеЦели.
		// Сам катч тоже не имеет права выбросить исключение: и МаскироватьСекреты,
		// и запись в ar_СлужебныйЛог - внешние вызовы, способные упасть (недоступна
		// таблица лога, неожиданный тип в тексте ошибки). Без этих вложенных
		// Попытка исключение улетело бы в ar_Надзор/ar_Подтверждение/ar_RuntimeЦикл,
		// где вызов Уведомить намеренно стоит без обёртки. Эталон - ar_Надзор.
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_internal_error",
				ТекстОшибки, "Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Notifications.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Уведомления: не удалось записать notify_internal_error в ar_СлужебныйЛог");
		КонецПопытки;

		Результат.Причина = "internal_error";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Уведомить участников диалога о вопросе агента (agentrunner-26 п.10, повод
// "input_pending"). Вызывается из ar_ИнструментыВзаимодействие ПОСЛЕ фиксации
// транзакции вопроса. Адресаты - все участники диалога с заполненным адресом
// почты, одним письмом. Сбой отправки или отсутствие адресов вопрос не отменяет
// (перехвачено, запись в ar_СлужебныйЛог). Повтор по тому же вопросу отсекается
// резервом отправки (ключ дополняется идентификатором вопроса).
//
// Параметры:
//  ИдентификаторВопроса - Строка - ApprovalId записи очереди (awaiting_input).
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка} - только для диагностики.
//
Функция УведомитьОВопросе(Знач ИдентификаторВопроса) Экспорт

	Результат = Новый Структура("Отправлено, Причина", Ложь, "internal_error");

	Если ТипЗнч(ИдентификаторВопроса) <> Тип("Строка") Или ПустаяСтрока(ИдентификаторВопроса) Тогда
		Результат.Причина = "invalid_arguments";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Возврат УведомитьОВопросеВнутр(СокрЛП(ИдентификаторВопроса));
	Исключение
		// D9: сбой уведомления не должен ломать постановку вопроса.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьОВопросе", "notify_question_failed",
			СтрШаблон("ApprovalId=%1: %2", ИдентификаторВопроса, ТекстОшибки), "Ошибка");
		Результат.Причина = "internal_error";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Письмо по диалогу пакета (agentrunner-89, спека п. 2): адресатам - участникам
// диалога с адресом почты - отправляется письмо с заданной темой и текстом,
// дополненное ссылками на диалог и предмет (как в письме о вопросе). Учётная
// запись, отправка и запись в лог - общий путь модуля (УчетнаяЗаписьДляУведомлений,
// повод dialog_message, notify_sent / notify_send_failed). Без RunId: письмо
// не привязано к запуску. Исключения не выходят наружу - результатом служит
// структура с причиной (сбой письма не прерывает работу вызывающего кода).
// Письмо - HTML с оформлением (ТекстПисьмаПоДиалогуHTML): карточка с цветной
// полосой по виду письма, абзацы текста, ссылки кнопками «Открыть».
//
// Параметры:
//  Диалог     - СправочникСсылка.ar_Диалоги - диалог ожидания пакета.
//  Тема       - Строка - тема письма.
//  Текст      - Строка - основной текст письма (текст сообщения диалога).
//  Оформление - Структура, Неопределено - необязательное оформление письма:
//   * Вид    - Строка - цвет полосы карточки: "успех" (зелёный), "внимание"
//              (жёлтый), "ошибка" (красный); прочее - синий (сведения).
//   * Ссылки - Массив из Структура {Представление: Строка, Ссылка: ЛюбаяСсылка} -
//              дополнительные объекты в блоке ссылок после диалога и предмета.
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка}.
//
Функция ОтправитьПисьмоПоДиалогу(Знач Диалог, Знач Тема, Знач Текст, Знач Оформление = Неопределено) Экспорт

	Результат = Новый Структура("Отправлено, Причина", Ложь, "send_failed");

	Повод = "dialog_message";
	// Письмо, отклонённые получатели, адресаты и строка учётной записи объявлены
	// до Попытки - как в ОтправитьEmail и ОтправитьПисьмоОВопросе.
	Письмо = Неопределено;
	Адресаты = Новый Массив;
	ОшибочныеПолучатели = Новый Массив;
	ОписаниеУчетнойЗаписи = "";

	Попытка

		Если Метаданные.ОбщиеМодули.Найти("РаботаСПочтовымиСообщениями") = Неопределено Тогда
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоПоДиалогу", "notify_no_mail_subsystem",
				"Ошибка", "", Повод,
				"Подсистема БСП электронной почты не подключена - письмо по диалогу не отправлено",
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		// Чтение адресатов и шапки диалога - привилегированно: письмо строится
		// и из регламентной команды пакета, у пользователя задания прав на
		// диалоги может не быть. Парный сброс, в том числе в Исключение.
		Шапка = Неопределено;
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			Адресаты = АдресатыВопроса(Диалог);
			Шапка = ar_ДиалогиСервер.ШапкаДиалога(Диалог);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);

		Если Адресаты.Количество() = 0 Тогда
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоПоДиалогу", "notify_no_recipients",
				СтрШаблон("У участников диалога %1 нет адресов почты - письмо не отправлено",
					Строка(Диалог)), "Предупреждение", "", Диалог);
			Результат.Причина = "no_recipients";
			Возврат Результат;
		КонецЕсли;

		ВыборЗаписи = УчетнаяЗаписьДляУведомлений();
		Если Не ЗначениеЗаполнено(ВыборЗаписи.Ссылка) Тогда
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоПоДиалогу", "notify_no_email_account",
				"Ошибка", "", Повод,
				СтрШаблон("Нет настроенной учётной записи для системных уведомлений "
					+ "(повод=%1) - письмо НЕ отправлено", Повод),
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		ОписаниеУчетнойЗаписи = СтрокаУчетнойЗаписиЛога(ВыборЗаписи.Ссылка,
			ВыборЗаписи.Адрес, ВыборЗаписи.Источник);

		ТекстHTML = ТекстПисьмаПоДиалогуHTML(Тема, Текст, Диалог, Шапка, Оформление);

		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Отправитель = ВыборЗаписи.Адрес;
		Письмо.ИмяОтправителя = "AgentRunner";
		Письмо.Тема = Лев(СокрЛП(Тема), 250);
		Письмо.Тексты.Добавить(ТекстHTML, ТипТекстаПочтовогоСообщения.HTML);

		Для Каждого Адресат Из Адресаты Цикл
			Письмо.Получатели.Добавить(Адресат.Email, Адресат.Представление);
		КонецЦикла;

		// Отправка с явно заданной записью - в привилегированном режиме
		// (реквизиты записи под RLS; как в ОтправитьEmail). Парный сброс.
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ВыборЗаписи.Ссылка, Письмо);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		ОшибочныеПолучатели = ОтклоненныеПолучателиИзРезультата(РезультатSMTP);

		Если ОшибочныеПолучатели.Количество() = Адресаты.Количество() Тогда
			// Все получатели отклонены сервером - это тоже неуспех отправки.
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоПоДиалогу",
				"notify_all_recipients_rejected", "Ошибка", "", Повод, "", Письмо, Адресаты,
				ОшибочныеПолучатели, "SMTP отклонил всех получателей", ОписаниеУчетнойЗаписи);
			Результат.Причина = "send_failed";
			Возврат Результат;
		КонецЕсли;

		УровеньЗаписи = ?(ОшибочныеПолучатели.Количество() > 0, "Предупреждение", "Информация");
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоПоДиалогу", "notify_sent",
			УровеньЗаписи, "", Повод, "", Письмо, Адресаты, ОшибочныеПолучатели,
			"", ОписаниеУчетнойЗаписи);

		Результат.Отправлено = Истина;
		Результат.Причина = "ok";
		Возврат Результат;

	Исключение
		// D11: текст исключения БСП/платформы может содержать логин/пароль
		// учётной записи SMTP - маскируется перед записью в лог.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоПоДиалогу", "notify_send_failed",
			"Ошибка", "", Повод,
			СтрШаблон("Не удалось отправить письмо по диалогу %1: %2", Строка(Диалог), ТекстОшибки),
			Письмо, Адресаты, ОшибочныеПолучатели, ТекстОшибки, ОписаниеУчетнойЗаписи);
		Результат.Причина = "send_failed";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Ссылки справочника Пользователи для полноправных пользователей ИБ
// (agentrunner-85; замена несуществующему Пользователи.НайтиПоИдентификатору).
// Пользователи ИБ читаются в привилегированном режиме: из фонового задания
// служебного пользователя без права администрирования
// ПользователиИнформационнойБазы.ПолучитьПользователей() бросает исключение
// (спека agentrunner-85). Ссылки сопоставляются ОДНИМ запросом по
// ИдентификаторПользователяИБ (без запросов в цикле и без зависимости от
// имени входа); чтение справочника тоже привилегированно (RLS).
//
// Вызывается из АдресатыАдминистраторов (email-адресаты) и ar_ДиалогиСервер
// (участники-администраторы диалогов).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Пользователи - непомеченные на удаление
//  пользователи с ролью "Полные права". Ошибка поиска - пустой массив и запись
//  notify_admin_lookup_failed ("Ошибка") в ar_СлужебныйЛог.
//
Функция ПользователиАдминистраторов() Экспорт

	Результат = Новый Массив;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Идентификаторы = Новый Массив;
		РольПолныеПрава = Метаданные.Роли.ПолныеПрава;
		Для Каждого ОписаниеПользователя Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			Если Не ОписаниеПользователя.Роли.Содержит(РольПолныеПрава) Тогда
				Продолжить;
			КонецЕсли;
			Идентификаторы.Добавить(ОписаниеПользователя.УникальныйИдентификатор);
		КонецЦикла;

		// В (&ПустойМассив) всегда даёт пустой результат - запрос не запускаем.
		Если Идентификаторы.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Пользователи.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Пользователи КАК Пользователи
				|ГДЕ
				|	Пользователи.ИдентификаторПользователяИБ В (&Идентификаторы)
				|	И НЕ Пользователи.ПометкаУдаления";
			Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Результат.Добавить(Выборка.Ссылка);
			КонецЦикла;
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_Уведомления.ПользователиАдминистраторов",
			"notify_admin_lookup_failed",
			"Не удалось сопоставить пользователей ИБ со справочником Пользователи: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Ошибка");
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика Уведомить - вынесена из внешней Попытка/Исключение
// (см. doc-комментарий Уведомить).
//
Функция УведомитьВнутр(Знач RunId, Знач ТипСобытия)

	Результат = Новый Структура("Отправлено, Канал, Причина", Ложь, "Email", "");

	// 1. Дедупликация - до любой дорогой работы (чтение адресатов, КИ, SMTP).
	Если ЗарезервироватьОтправкуЕслиНеБыло(RunId, ТипСобытия) = Ложь Тогда
		Результат.Причина = "duplicate";
		Возврат Результат;
	КонецЕсли;

	// 2. Канал - только Email реализован (D6).
	Канал = ОпределитьКанал();
	Результат.Канал = Канал;
	Если Канал <> "Email" Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьВнутр", "notify_channel_not_implemented",
			СтрШаблон("Канал ""%1"" не реализован (RunId=%2, повод=%3)", Канал, RunId, ТипСобытия),
			"Предупреждение", RunId);
		Результат.Причина = "not_implemented";
		Возврат Результат;
	КонецЕсли;

	// 3. Цепочка адресатов.
	Адресаты = ОпределитьАдресатов(RunId);
	Если Адресаты.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьВнутр", "notify_no_recipients",
			СтрШаблон("Нет ни одного адресата с email для уведомления (RunId=%1, повод=%2)",
				RunId, ТипСобытия), "Ошибка", RunId);
		Результат.Причина = "no_recipients";
		Возврат Результат;
	КонецЕсли;

	// 4. Реальная синхронная отправка (Вариант Б - см. doc-комментарий модуля).
	ИтогОтправки = ОтправитьEmail(RunId, ТипСобытия, Адресаты);
	Результат.Отправлено = ИтогОтправки.Отправлено;
	Результат.Причина = ИтогОтправки.Причина;

	Возврат Результат;

КонецФункции

// Определить канал уведомления. Единственная реализованная ветка - Email
// (см. doc-комментарий модуля, «Канал»); входные условия задачи не дают
// профилю настраиваемого канала - решение зафиксировано на этапе анализа.
//
// Возвращаемое значение:
//  Строка - имя значения Перечисление.ar_КаналУведомления ("Email" и т.п.).
//
Функция ОпределитьКанал()

	Возврат "Email";

КонецФункции

// Цепочка адресатов (см. doc-комментарий модуля). Останавливается на первом
// непустом результате. Каждый адресат - Структура {Email, Представление}.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Массив из Структура {Email: Строка, Представление: Строка} - без дублей
//  по Email, только непустые адреса.
//
Функция ОпределитьАдресатов(Знач RunId)

	ШапкаЗапуска = ПрочитатьШапкуЗапуска(RunId);

	// Звено 1: ТЧ ar_Ответственные профиля запуска.
	Если ШапкаЗапуска.Профиль <> Неопределено И ЗначениеЗаполнено(ШапкаЗапуска.Профиль) Тогда
		Ответственные = ar_ПрофилиЗапуска.Ответственные(ШапкаЗапуска.Профиль);
		АдресатыПрофиля = АдресатыИзОтветственных(Ответственные);
		Если АдресатыПрофиля.Количество() > 0 Тогда
			Возврат АдресатыПрофиля;
		КонецЕсли;
	КонецЕсли;

	// Звено 2: ar_Агенты.ar_Пользователь.
	Если ШапкаЗапуска.Агент <> Неопределено И ЗначениеЗаполнено(ШапкаЗапуска.Агент) Тогда
		Попытка
			ПользовательАгента = ШапкаЗапуска.Агент.ar_Пользователь;
		Исключение
			ПользовательАгента = Неопределено;
		КонецПопытки;
		Если ПользовательАгента <> Неопределено И ЗначениеЗаполнено(ПользовательАгента) Тогда
			EmailАгента = EmailПользователя(ПользовательАгента);
			Если Не ПустаяСтрока(EmailАгента) Тогда
				АдресатыАгента = Новый Массив;
				АдресатыАгента.Добавить(Новый Структура("Email, Представление",
					EmailАгента, Строка(ПользовательАгента)));
				Возврат АдресатыАгента;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Звено 3: администраторы (беспризорный агент - профиль и ar_Пользователь
	// оба пусты/не дали email). Требование задачи: молча терять эскалацию
	// нельзя - явное предупреждение в ar_СлужебныйЛог.
	ar_СлужебныйЛог.Записать("ar_Уведомления.ОпределитьАдресатов", "notify_orphan_agent",
		СтрШаблон("Агент без профиля/ответственного пользователя с email - уведомление "
			+ "уходит администраторам (RunId=%1, Агент=%2)",
			RunId, ?(ШапкаЗапуска.Агент <> Неопределено, Строка(ШапкаЗапуска.Агент), "<нет>")),
		"Предупреждение", RunId);

	Возврат АдресатыАдминистраторов();

КонецФункции

// Прочитать шапку запуска напрямую из РегистрСведений.ar_Запуски - по образцу
// ar_AuditЗапуски.ПрочитатьОтпечатокШага/ПрочитатьПродолженийСделано (см. спеку,
// «Платформенные API»). agentrunner-51: состав расширен для информативных писем
// (предмет, диалог, статус, время, ошибка, счетчики); прежние поля Агент/Профиль
// сохранены - их читает ОпределитьАдресатов.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - {Найдено: Булево,
//               Агент: СправочникСсылка.ar_Агенты/Неопределено,
//               Профиль: СправочникСсылка.ar_ПрофилиЗапуска/Неопределено,
//               Диалог: СправочникСсылка.ar_Диалоги/Неопределено,
//               Предмет: ОпределяемыйТип.ar_ПрикладнойОбъект/Неопределено,
//               Статус: ПеречислениеСсылка.ar_СтатусЗапуска/Неопределено,
//               СтартовалВ: Дата, ЗавершенВ: Дата,
//               ОтветLLM: Строка, ПопытокВозобновления: Число,
//               ШаговВсего: Число, ПродолженийСделано: Число}.
//  Найдено=Ложь - записи ar_Запуски для RunId не найдено.
//
Функция ПрочитатьШапкуЗапуска(Знач RunId)

	Результат = Новый Структура(
		"Найдено, Агент, Профиль, Диалог, Предмет, Статус, СтартовалВ, ЗавершенВ,
		|ОтветLLM, ПопытокВозобновления, ШаговВсего, ПродолженийСделано",
		Ложь, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		'00010101000000', '00010101000000', "", 0, 0, 0);

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ИдентификаторЗапуска = RunId;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Найдено = Истина;
	Результат.Агент = МенеджерЗаписи.ar_АгентРеф;
	Результат.Профиль = МенеджерЗаписи.ar_ПрофильЗапуска;
	Результат.Диалог = МенеджерЗаписи.ar_Диалог;
	Результат.Предмет = МенеджерЗаписи.ar_Предмет;
	Результат.Статус = МенеджерЗаписи.ar_Статус;
	Результат.СтартовалВ = МенеджерЗаписи.ar_СтартовалВ;
	Результат.ЗавершенВ = МенеджерЗаписи.ar_ЗавершенВ;
	Результат.ОтветLLM = МенеджерЗаписи.ar_ОтветLLM;
	Результат.ПопытокВозобновления = МенеджерЗаписи.ar_ПопытокВозобновления;
	Результат.ШаговВсего = МенеджерЗаписи.ar_ШаговВсего;
	Результат.ПродолженийСделано = МенеджерЗаписи.ar_ПродолженийСделано;

	Возврат Результат;

КонецФункции

// Преобразовать результат ar_ПрофилиЗапуска.Ответственные в список email-
// адресатов - без фильтра по роли (все строки ТЧ уведомляются, см. спеку).
// Email строки, если заполнен, иначе email пользователя из ar_Пользователь.
//
// Параметры:
//  Ответственные - Массив из Структура {Пользователь, Роль, Email}.
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без пустых email, без дублей.
//
Функция АдресатыИзОтветственных(Знач Ответственные)

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	Для Каждого Строка Из Ответственные Цикл

		Email = "";
		Представление = "";

		Если ТипЗнч(Строка.Email) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Строка.Email)) Тогда
			Email = СокрЛП(Строка.Email);
			Представление = Email;
		ИначеЕсли Строка.Пользователь <> Неопределено И ЗначениеЗаполнено(Строка.Пользователь) Тогда
			Email = EmailПользователя(Строка.Пользователь);
			Представление = Строка(Строка.Пользователь);
		Иначе
			// Ни ar_Email строки, ни ar_Пользователь не заполнены - строка ТЧ
			// пропускается ниже проверкой ПустаяСтрока(Email).
			Email = "";
		КонецЕсли;

		Если ПустаяСтрока(Email) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Email] = Неопределено Тогда
			ВидимыеEmail[Email] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Email, Представление));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собрать список email-адресов полноправных пользователей ИБ (звено 3
// цепочки адресатов - «беспризорный» агент). Ссылки пользователей -
// ПользователиАдминистраторов (agentrunner-85), email каждого - EmailПользователя
// (чтение КИ в привилегированном режиме).
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без пустых email, без дублей.
//
Функция АдресатыАдминистраторов()

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	Для Каждого СсылкаПользователя Из ПользователиАдминистраторов() Цикл

		Email = EmailПользователя(СсылкаПользователя);
		Если ПустаяСтрока(Email) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Email] = Неопределено Тогда
			ВидимыеEmail[Email] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Email, Строка(СсылкаПользователя)));
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.АдресатыАдминистраторов", "notify_no_admin_email",
			"Ни один полноправный пользователь ИБ не имеет заполненного email - "
			+ "уведомление некому отправить", "Ошибка");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает email пользователя через подсистему БСП УправлениеКонтактнойИнформацией -
// тот же вызов, что ar_ИнструментыКоммуникации.EmailКонтрагента (см. спеку,
// «Платформенные API»), применённый к СправочникСсылка.Пользователи.
// Чтение - в привилегированном режиме: КИ пользователя может быть скрыта RLS от
// пользователя фонового задания (agentrunner-85). Ошибка чтения не глотается
// молча - запись notify_email_read_failed ("Предупреждение", пользователь и
// текст ошибки) и возврат "".
//
// Параметры:
//  СсылкаПользователя - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Строка - email или "" при отсутствии/ошибке (graceful, не бросает исключений).
//  Экспорт с agentrunner-26: адрес читает ядро диалогов для участников (спека п.9).
//
Функция EmailПользователя(Знач СсылкаПользователя) Экспорт

	Если Метаданные.ОбщиеМодули.Найти("УправлениеКонтактнойИнформацией") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипEmail = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;

	ТаблицаКИ = Неопределено;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			СсылкаПользователя, ТипEmail, Неопределено, Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_Уведомления.EmailПользователя", "notify_email_read_failed",
			СтрШаблон("Не удалось прочитать email пользователя %1: %2",
				Строка(СсылкаПользователя),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Предупреждение");
		Возврат "";
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если Не ПустаяСтрока(Представление) Тогда
			Возврат Представление;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Проверить/зарезервировать право на отправку по RunId+повод (дедупликация,
// D8, см. doc-комментарий модуля про TOCTOU). Явная транзакция с
// БлокировкаДанных по РегистрСведений.ar_СобытияЗапуска.ar_RunId -
// та же гранулярность, что уже использует ar_AuditСобытия.ЗаписатьСобытие
// для этого регистра, поэтому вложенный вызов ЗаписатьСобытиеПривилегированно
// внутри этой транзакции не создаёт взаимоблокировку (реентерабельность
// блокировки в пределах одной транзакции).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод ("escalation"/"approval_pending"/"retry_exhausted"/
//               "input_pending").
//  ИдентификаторВопроса - Строка - необязательно; для "input_pending" ключ
//               дубликации дополняется идентификатором вопроса (спека п.10:
//               повтор по тому же вопросу отсекается, новый вопрос уведомляется).
//
// Возвращаемое значение:
//  Булево - Истина, если резервирование выполнено этим вызовом (можно
//  отправлять письмо); Ложь, если уведомление для RunId+повода (+ вопроса) уже
//  было отправлено ранее (idempotent no-op, письмо отправлять не нужно).
//
Функция ЗарезервироватьОтправкуЕслиНеБыло(Знач RunId, Знач ТипСобытия,
	Знач ИдентификаторВопроса = "")

	Результат = Ложь;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_СобытияЗапуска");
		ЭлементБлокировки.УстановитьЗначение("ar_RunId", RunId);
		Блокировка.Заблокировать();

		Если УжеУведомляли(RunId, ТипСобытия, ИдентификаторВопроса) Тогда
			Результат = Ложь;
		Иначе
			Payload = Новый Структура("reason", ТипСобытия);
			Если Не ПустаяСтрока(ИдентификаторВопроса) Тогда
				Payload.Вставить("approval_id", ИдентификаторВопроса);
			КонецЕсли;
			ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "УведомлениеОтправлено", Payload);
			Результат = Истина;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверить наличие уже записанного NotificationSent для RunId+повод.
// Привилегированное чтение - функция вызывается в т.ч. из регламентного
// задания (ar_RuntimeЦикл), где нет гарантии интерактивного пользователя
// с ролью на ar_СобытияЗапуска (см. doc-комментарий модуля).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод.
//  ИдентификаторВопроса - Строка - необязательно; дополнительно сверяется
//               payload.approval_id (для "input_pending").
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одна запись NotificationSent с
//  payload.reason = ТипСобытия (и, при заданном идентификаторе вопроса, тем же
//  payload.approval_id) уже существует для этого RunId.
//
Функция УжеУведомляли(Знач RunId, Знач ТипСобытия, Знач ИдентификаторВопроса = "")

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("RunId", RunId);
		Запрос.УстановитьПараметр("ТипСобытия", Перечисления.ar_ТипСобытия.УведомлениеОтправлено);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	События.ar_PayloadJSON КАК PayloadJSON
			|ИЗ
			|	РегистрСведений.ar_СобытияЗапуска КАК События
			|ГДЕ
			|	События.ar_RunId = &RunId
			|	И События.ar_ТипСобытия = &ТипСобытия";
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Пока Выборка.Следующий() Цикл
		РазобранныйPayload = ar_JSON.ИзJSON(Выборка.PayloadJSON);
		Если ТипЗнч(РазобранныйPayload) = Тип("Соответствие") Тогда
			Причина = РазобранныйPayload["reason"];
			Если ТипЗнч(Причина) <> Тип("Строка") Или Причина <> ТипСобытия Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(ИдентификаторВопроса) Тогда
				Возврат Истина;
			КонецЕсли;
			ApprovalIdPayload = РазобранныйPayload["approval_id"];
			Если ТипЗнч(ApprovalIdPayload) = Тип("Строка")
				И ApprovalIdPayload = ИдентификаторВопроса Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Учётная запись для отправки системных уведомлений (agentrunner-85).
//
// Приоритет - типовая настройка ПочтаУчетнаяЗаписьУведомлений (ar_Настройки,
// реквизит ar_Значение хранит СправочникСсылка.УчетныеЗаписиЭлектроннойПочты
// через определяемый тип ar_ПрикладнойОбъект): ссылка заполнена и запись не
// помечена на удаление - она (см. НастроеннаяУчетнаяЗапись).
// Иначе прежний выбор без изменений: в конфигурациях с подсистемой
// Взаимодействий - запись для отправки по умолчанию из
// УправлениеЭлектроннойПочтой (модуль берётся через ОбщегоНазначения.ОбщийМодуль,
// т.к. прямое имя модуля не компилируется в конфигурациях без подсистемы, БП);
// в БП - выбор среди учётных записей, настроенных для отправки: системная,
// если она в списке, иначе первая (ДоступныеУчетныеЗаписи упорядочивает
// системную первой). Подходящих записей нет - Ссылка = Неопределено.
//
// Возвращаемое значение:
//  Структура - {Ссылка: СправочникСсылка.УчетныеЗаписиЭлектроннойПочты,
//               Адрес: Строка - адрес почты записи,
//               Источник: Строка - "настройка"/"системная"/"первая доступная"}.
//
Функция УчетнаяЗаписьДляУведомлений()

	Результат = Новый Структура("Ссылка, Адрес, Источник", Неопределено, "", "");

	Настроенная = НастроеннаяУчетнаяЗапись();
	Если Настроенная <> Неопределено Тогда
		Результат.Ссылка = Настроенная.Ссылка;
		Результат.Адрес = Настроенная.Адрес;
		Результат.Источник = "настройка";
		Возврат Результат;
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Взаимодействия") Тогда
		МодульПочты = ОбщегоНазначения.ОбщийМодуль("УправлениеЭлектроннойПочтой");
		ЗаполнитьВыборУчетнойЗаписи(Результат,
			МодульПочты.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию(), "системная");
		Возврат Результат;
	КонецЕсли;

	Записи = РаботаСПочтовымиСообщениями.ДоступныеУчетныеЗаписи(Истина, , Истина);
	Если Записи.Количество() > 0 Тогда

		СистемнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		Для Каждого Запись Из Записи Цикл
			Если Запись.Ссылка = СистемнаяЗапись Тогда
				ЗаполнитьВыборУчетнойЗаписи(Результат, Запись.Ссылка, "системная");
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;

		ЗаполнитьВыборУчетнойЗаписи(Результат, Записи[0].Ссылка, "первая доступная");

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Настроенная типовой настройкой ПочтаУчетнаяЗаписьУведомлений учётная запись.
// Чтение настройки - без кэша сеанса (ЗначениеНастройкиБезКэша): письмо должно
// уходить по АКТУАЛЬНОЙ настройке даже из долго живущего сеанса фонового
// задания (одна лёгкая выборка на отправку). Проверка пометки удаления и
// чтение адреса - в привилегированном режиме: у записи может быть владелец,
// отличный от пользователя фонового задания (RLS; спека agentrunner-85 п.3).
//
// Настройка не задана, указывает не на учётную запись или запись помечена на
// удаление - Неопределено (откат к прежнему выбору); ошибка чтения - запись
// notify_setting_account_failed ("Предупреждение") и Неопределено.
//
// Возвращаемое значение:
//  Структура - {Ссылка: СправочникСсылка.УчетныеЗаписиЭлектроннойПочты,
//               Адрес: Строка}, Неопределено.
//
Функция НастроеннаяУчетнаяЗапись()

	Настройка = ar_Настройки.ЗначениеНастройкиБезКэша("ПочтаУчетнаяЗаписьУведомлений");
	Если ТипЗнч(Настройка) <> Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты")
		Или Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Неопределено;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,
			"ПометкаУдаления, АдресЭлектроннойПочты");
		Если Не Реквизиты.ПометкаУдаления Тогда
			Результат = Новый Структура("Ссылка, Адрес", Настройка,
				СокрЛП(Строка(Реквизиты.АдресЭлектроннойПочты)));
		КонецЕсли;
	Исключение
		ar_СлужебныйЛог.Записать("ar_Уведомления.НастроеннаяУчетнаяЗапись",
			"notify_setting_account_failed",
			СтрШаблон("Настройка ПочтаУчетнаяЗаписьУведомлений недоступна (%1): %2",
				Строка(Настройка),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Предупреждение");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Заполнить результат УчетнаяЗаписьДляУведомлений ссылкой и адресом записи
// (ветки прежнего выбора). Адрес читается через
// ОбщегоНазначения.ЗначениеРеквизитаОбъекта (std: без разыменования через
// точку); ошибка чтения (запись удалена между выборкой и чтением) оставляет
// адрес пустым, выбор не отменяет.
//
// Параметры:
//  Результат    - Структура {Ссылка, Адрес, Источник} - заполняется.
//  СсылкаЗаписи - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты - выбранная запись.
//  Источник     - Строка - "системная" / "первая доступная".
//
Процедура ЗаполнитьВыборУчетнойЗаписи(Результат, Знач СсылкаЗаписи, Знач Источник)

	Результат.Ссылка = СсылкаЗаписи;
	Результат.Источник = Источник;

	Попытка
		Результат.Адрес = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СсылкаЗаписи, "АдресЭлектроннойПочты"));
	Исключение
		Результат.Адрес = "";
	КонецПопытки;

КонецПроцедуры

// Реально отправить письмо (Вариант Б - прямой БСП API, см. doc-комментарий
// модуля). Ошибка отправки (недоступность SMTP, отсутствие учётной записи)
// не пробрасывается - фиксируется в ar_СлужебныйЛог уровня "Ошибка" (D9).
// agentrunner-71: каждое письмо - запись в служебном логе (ЗаписатьПисьмоВЛог):
// успешная отправка - notify_sent, ошибки - прежние коды событий с темой,
// адресатами и текстом письма (спека agentrunner-71 п.2-5).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска (для текста темы/лога).
//  ТипСобытия - Строка - повод (для текста темы/тела письма).
//  Адресаты   - Массив из Структура {Email, Представление}.
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка}.
//
Функция ОтправитьEmail(Знач RunId, Знач ТипСобытия, Знач Адресаты)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "send_failed");

	// Письмо, отклонённые получатели и строка учётной записи объявлены до
	// Попытки: в катче видно, собрано ли письмо и какая запись выбиралась
	// (исключение до сборки - запись прежнего текста плюс строка получателей,
	// после сборки - запись по полной схеме).
	Письмо = Неопределено;
	ОшибочныеПолучатели = Новый Массив;
	ОписаниеУчетнойЗаписи = "";

	Попытка

		Если Метаданные.ОбщиеМодули.Найти("РаботаСПочтовымиСообщениями") = Неопределено Тогда
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьEmail", "notify_no_mail_subsystem",
				"Ошибка", RunId, ТипСобытия,
				"Подсистема БСП электронной почты не подключена - уведомление не отправлено",
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		ВыборЗаписи = УчетнаяЗаписьДляУведомлений();
		Если Не ЗначениеЗаполнено(ВыборЗаписи.Ссылка) Тогда
			// Требование пользователя: не проглатывать молча - явная ошибка,
			// называющая причину, чтобы администратор увидел проблему.
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьEmail", "notify_no_email_account",
				"Ошибка", RunId, ТипСобытия,
				СтрШаблон("Нет настроенной учётной записи для системных уведомлений "
					+ "(RunId=%1, повод=%2) - письмо НЕ отправлено", RunId, ТипСобытия),
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		// agentrunner-85: строка «Учётная запись: ...; источник: ...» для лога.
		ОписаниеУчетнойЗаписи = СтрокаУчетнойЗаписиЛога(ВыборЗаписи.Ссылка,
			ВыборЗаписи.Адрес, ВыборЗаписи.Источник);

		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Отправитель = ВыборЗаписи.Адрес;
		Письмо.ИмяОтправителя = "AgentRunner";

		// agentrunner-51: информативная тема и текст (описание события по
		// поводу, действие оператора, блок ссылок "Перейти в 1С"). Сборка
		// выполняется в Попытке (ТемаИТекстПисьма): при любой ошибке сборки
		// уходит прежний общий шаблон, отправка не прерывается (спека п.5).
		// Информативное письмо - HTML-карточка, прежний шаблон - простой текст.
		ТемаИТекст = ТемаИТекстПисьма(RunId, ТипСобытия);
		Письмо.Тема = ТемаИТекст.Тема;
		Письмо.Тексты.Добавить(ТемаИТекст.Текст, ?(ТемаИТекст.ЭтоHTML,
			ТипТекстаПочтовогоСообщения.HTML, ТипТекстаПочтовогоСообщения.ПростойТекст));

		Для Каждого Адресат Из Адресаты Цикл
			Письмо.Получатели.Добавить(Адресат.Email, Адресат.Представление);
		КонецЦикла;

		// agentrunner-85: отправка с явно заданной записью - в привилегированном
		// режиме: ОтправитьПисьмо открывает SMTP-соединение, читая реквизиты
		// записи (сервер, логин, пароль) под RLS, а запись может принадлежать
		// владельцу, отличному от пользователя фонового задания. Парный сброс,
		// в т. ч. в Исключение (ошибка уходит в общий катч функции).
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ВыборЗаписи.Ссылка, Письмо);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		ОшибочныеПолучатели = ОтклоненныеПолучателиИзРезультата(РезультатSMTP);

		Если ОшибочныеПолучатели.Количество() = Адресаты.Количество() Тогда
			// Все получатели отклонены сервером - это тоже неуспех отправки.
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьEmail", "notify_all_recipients_rejected",
				"Ошибка", RunId, ТипСобытия, "", Письмо, Адресаты, ОшибочныеПолучатели,
				"SMTP отклонил всех получателей", ОписаниеУчетнойЗаписи);
			Результат.Причина = "send_failed";
			Возврат Результат;
		КонецЕсли;

		// agentrunner-71: успешная отправка (принят хотя бы один получатель) -
		// запись notify_sent; отклонена часть получателей - Предупреждение.
		УровеньЗаписи = ?(ОшибочныеПолучатели.Количество() > 0, "Предупреждение", "Информация");
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьEmail", "notify_sent",
			УровеньЗаписи, RunId, ТипСобытия, "", Письмо, Адресаты, ОшибочныеПолучатели,
			"", ОписаниеУчетнойЗаписи);

		Результат.Отправлено = Истина;
		Результат.Причина = "ok";
		Возврат Результат;

	Исключение
		// D11: текст исключения БСП/платформы может содержать логин/пароль
		// учётной записи SMTP - маскируется перед записью в лог.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьEmail", "notify_send_failed",
			"Ошибка", RunId, ТипСобытия,
			СтрШаблон("Не удалось отправить письмо (RunId=%1, повод=%2): %3",
				RunId, ТипСобытия, ТекстОшибки),
			Письмо, Адресаты, ОшибочныеПолучатели, ТекстОшибки, ОписаниеУчетнойЗаписи);
		Результат.Отправлено = Ложь;
		Результат.Причина = "send_failed";
		Возврат Результат;
	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////
// agentrunner-71: запись письма-уведомления в служебный лог (ar_СлужебныйЛог).
// Одна точка записи для обоих путей отправки (ОтправитьEmail и
// ОтправитьПисьмоОВопросе): успех - notify_sent (Информация, при отклонении
// части получателей - Предупреждение и строка "Отклонены сервером"), ошибки -
// прежние коды событий с темой, адресатами и текстом письма; письмо ещё не
// собрано - прежний текст записи плюс строка получателей. Запись не меняет
// результат отправки: сборка текста - в своей Попытке, при сбое пишется
// запасной текст; сам ar_СлужебныйЛог.Записать исключений не выпускает
// (спека agentrunner-71 п.2-6).
////////////////////////////////////////////////////////////////////////////

// Записать письмо в служебный лог. Собирает текст записи (полная схема для
// собранного письма; БазовыйТекст плюс строка получателей - для ещё не
// собранного), маскирует его через ar_Утилиты.МаскироватьСекреты и вызывает
// ar_СлужебныйЛог.Записать. ОписаниеУчетнойЗаписи (agentrunner-85) добавляется
// в обе схемы, если задано.
//
// Параметры:
//  Источник            - Строка - источник записи ("ar_Уведомления.ОтправитьEmail" и т.п.).
//  Событие             - Строка - код события ("notify_sent", "notify_send_failed", ...).
//  Уровень             - Строка - "Информация" / "Предупреждение" / "Ошибка".
//  RunId               - Строка(36) - идентификатор запуска.
//  Повод               - Строка - повод письма ("escalation", "input_pending" и др.).
//  БазовыйТекст        - Строка - прежний текст записи для письма, ещё не
//                        собранного на момент записи (ошибка или исключение
//                        до сборки); при собранном письме не используется.
//  Письмо              - ИнтернетПочтовоеСообщение, Неопределено - собранное
//                        письмо (запись по полной схеме); Неопределено - запись
//                        по БазовыйТекст плюс строка получателей.
//  Адресаты            - Массив из Структура {Email, Представление}.
//  ОшибочныеПолучатели - Массив из Строка - "<адрес>: <текст ошибки>" для
//                        отклонённых сервером получателей (пустой, если нет).
//  ТекстОшибки         - Строка - текст ошибки для строки "Ошибка" ("" - без неё).
//  ОписаниеУчетнойЗаписи - Строка - строка "Учётная запись: <представление>
//                        (<адрес>); источник: ..." (СтрокаУчетнойЗаписиЛога);
//                        "" - запись, в которой учётная запись ещё не выбиралась.
//
Процедура ЗаписатьПисьмоВЛог(Знач Источник, Знач Событие, Знач Уровень, Знач RunId, Знач Повод,
	Знач БазовыйТекст, Знач Письмо, Знач Адресаты, Знач ОшибочныеПолучатели, Знач ТекстОшибки,
	Знач ОписаниеУчетнойЗаписи = "")

	ТекстЗаписи = "";
	Попытка
		Если ТипЗнч(Письмо) = Тип("ИнтернетПочтовоеСообщение") Тогда
			ТекстЗаписи = ТекстЗаписиПисьма(Повод, Письмо, Адресаты, ОшибочныеПолучатели, ТекстОшибки,
				ОписаниеУчетнойЗаписи);
		Иначе
			ТекстЗаписи = БазовыйТекст;
			Если Не ПустаяСтрока(ОписаниеУчетнойЗаписи) Тогда
				ТекстЗаписи = ТекстЗаписи + Символы.ПС + ОписаниеУчетнойЗаписи;
			КонецЕсли;
			ПереченьПолучателей = СтрокаПолучателей(Адресаты);
			Если Не ПустаяСтрока(ПереченьПолучателей) Тогда
				ТекстЗаписи = ТекстЗаписи + Символы.ПС + "Получатели: " + ПереченьПолучателей;
			КонецЕсли;
		КонецЕсли;
		// Весь итоговый текст - через маскировку секретов (D11).
		ТекстЗаписи = ar_Утилиты.МаскироватьСекреты(ТекстЗаписи);
	Исключение
		// Запись в лог не ломает отправку (спека п.6): запасной текст без письма.
		Попытка
			Детали = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстЗаписи = ar_Утилиты.МаскироватьСекреты(
				"не удалось собрать текст письма для лога: " + Детали);
		Исключение
			ТекстЗаписи = "не удалось собрать текст письма для лога";
		КонецПопытки;
	КонецПопытки;

	ar_СлужебныйЛог.Записать(Источник, Событие, ТекстЗаписи, Уровень, RunId);

КонецПроцедуры

// Строка «Учётная запись: <представление> (<адрес>); источник: <источник>»
// для записи служебного лога (спека agentrunner-85 п.4). Пустая запись или
// источник - пустая строка (строка в лог не добавляется).
//
// Параметры:
//  СсылкаЗаписи - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты - выбранная запись.
//  АдресЗаписи  - Строка - адрес почты записи (Адрес из УчетнаяЗаписьДляУведомлений).
//  Источник     - Строка - "настройка" / "системная" / "первая доступная".
//
// Возвращаемое значение:
//  Строка.
//
Функция СтрокаУчетнойЗаписиЛога(Знач СсылкаЗаписи, Знач АдресЗаписи, Знач Источник)

	Если Не ЗначениеЗаполнено(СсылкаЗаписи) Или ПустаяСтрока(Источник) Тогда
		Возврат "";
	КонецЕсли;

	Описание = "Учётная запись: " + СокрЛП(Строка(СсылкаЗаписи));
	Если Не ПустаяСтрока(СокрЛП(АдресЗаписи)) Тогда
		Описание = Описание + " (" + СокрЛП(АдресЗаписи) + ")";
	КонецЕсли;

	Возврат Описание + "; источник: " + Источник;

КонецФункции

// Текст записи по полной схеме (спека agentrunner-71 п.2): повод, отправитель,
// учётная запись (если задана, agentrunner-85), получатели, отклонённые
// получатели (если есть), ошибка (если задана), тема и полный текст письма.
// Строки соединяются Символы.ПС.
//
// Параметры:
//  Повод               - Строка - повод письма.
//  Письмо              - ИнтернетПочтовоеСообщение - собранное письмо.
//  Адресаты            - Массив из Структура {Email, Представление}.
//  ОшибочныеПолучатели - Массив из Строка - "<адрес>: <текст ошибки>".
//  ТекстОшибки         - Строка - текст ошибки ("" - без строки "Ошибка").
//  ОписаниеУчетнойЗаписи - Строка - строка учётной записи ("" - без неё).
//
// Возвращаемое значение:
//  Строка - текст записи служебного лога.
//
Функция ТекстЗаписиПисьма(Знач Повод, Знач Письмо, Знач Адресаты, Знач ОшибочныеПолучатели,
	Знач ТекстОшибки, Знач ОписаниеУчетнойЗаписи = "")

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Повод: %1 (%2)", Повод, ПредставлениеПовода(Повод)));
	Строки.Добавить("Отправитель: " + СокрЛП(Строка(Письмо.Отправитель.Адрес)));

	Если Не ПустаяСтрока(ОписаниеУчетнойЗаписи) Тогда
		Строки.Добавить(ОписаниеУчетнойЗаписи);
	КонецЕсли;

	ПереченьПолучателей = СтрокаПолучателей(Адресаты);
	Если Не ПустаяСтрока(ПереченьПолучателей) Тогда
		Строки.Добавить("Получатели: " + ПереченьПолучателей);
	КонецЕсли;

	ПереченьОтклоненных = СтрСоединить(ОшибочныеПолучатели, "; ");
	Если Не ПустаяСтрока(ПереченьОтклоненных) Тогда
		Строки.Добавить("Отклонены сервером: " + ПереченьОтклоненных);
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Строки.Добавить("Ошибка: " + ТекстОшибки);
	КонецЕсли;

	Строки.Добавить("Тема: " + Письмо.Тема);
	Строки.Добавить("");
	Строки.Добавить(ПолныйТекстПисьма(Письмо));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строка получателей для записи лога: "<email> (<представление>)" через "; ".
// Представление, совпадающее с адресом, не выводится (без дубля в скобках).
//
// Параметры:
//  Адресаты - Массив из Структура {Email, Представление}.
//
// Возвращаемое значение:
//  Строка - перечисление получателей; пустая, если адресатов нет.
//
Функция СтрокаПолучателей(Знач Адресаты)

	Части = Новый Массив;
	Для Каждого Адресат Из Адресаты Цикл
		Адрес = СокрЛП(Строка(Адресат.Email));
		Если ПустаяСтрока(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Представление = СокрЛП(Строка(Адресат.Представление));
		Если Не ПустаяСтрока(Представление) И Представление <> Адрес Тогда
			Части.Добавить(Адрес + " (" + Представление + ")");
		Иначе
			Части.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Полный текст письма: все текстовые части сообщения соединяются переводами
// строк (в письмах модуля одна часть: простой текст, у письма по диалогу - HTML,
// записывается разметкой как есть; спека требует записывать
// полный текст без обрезки - ar_Текст регистра неограниченной длины).
//
// Параметры:
//  Письмо - ИнтернетПочтовоеСообщение - собранное письмо.
//
// Возвращаемое значение:
//  Строка - полный текст письма.
//
Функция ПолныйТекстПисьма(Знач Письмо)

	Части = Новый Массив;
	Для Каждого Часть Из Письмо.Тексты Цикл
		Части.Добавить(Часть.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Отклонённые сервером получатели из результата БСП
// РаботаСПочтовымиСообщениями.ОтправитьПисьмо строками "<адрес>: <текст
// ошибки>" (структура результата - mcp.md [P2]: ОшибочныеПолучатели -
// Соответствие, Ключ - адрес, Значение - текст ошибки). Результат иного типа
// - пустой массив, как до agentrunner-71: все получатели считаются принятыми.
//
// Параметры:
//  РезультатОтправки - Структура, Произвольный - результат ОтправитьПисьмо.
//
// Возвращаемое значение:
//  Массив из Строка - по одному элементу на отклонённого получателя.
//
Функция ОтклоненныеПолучателиИзРезультата(Знач РезультатОтправки)

	Результат = Новый Массив;

	Если ТипЗнч(РезультатОтправки) <> Тип("Структура")
		Или Не РезультатОтправки.Свойство("ОшибочныеПолучатели") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Отказ Из РезультатОтправки.ОшибочныеПолучатели Цикл
		Адрес = ?(ТипЗнч(Отказ.Ключ) = Тип("Строка"), СокрЛП(Отказ.Ключ), "");
		Причина = ?(ТипЗнч(Отказ.Значение) = Тип("Строка"), СокрЛП(Отказ.Значение), "");
		Если ПустаяСтрока(Причина) Тогда
			Результат.Добавить(Адрес);
		Иначе
			Результат.Добавить(Адрес + ": " + Причина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Человекочитаемое представление повода для темы/тела письма.
//
// Параметры:
//  ТипСобытия - Строка - "escalation"/"approval_pending"/"retry_exhausted".
//
// Возвращаемое значение:
//  Строка - локализованное представление; для незнакомого повода -
//  сам код ТипСобытия (защитный default).
//
Функция ПредставлениеПовода(Знач ТипСобытия)

	Если ТипСобытия = "escalation" Тогда
		Возврат НСтр("ru = 'эскалация надзора'; en = 'supervisor escalation'");
	ИначеЕсли ТипСобытия = "approval_pending" Тогда
		Возврат НСтр("ru = 'требуется подтверждение действия'; en = 'action approval required'");
	ИначеЕсли ТипСобытия = "retry_exhausted" Тогда
		Возврат НСтр("ru = 'исчерпаны повторы после технического сбоя'; en = 'retries exhausted after transient failure'");
	ИначеЕсли ТипСобытия = "input_pending" Тогда
		Возврат НСтр("ru = 'агент ждёт ответа на вопрос'; en = 'agent awaits an answer to a question'");
	ИначеЕсли ТипСобытия = "subject_excluded" Тогда
		Возврат НСтр("ru = 'предмет исключён из очереди после сбоев';
			|en = 'subject excluded from queue after failures'");
	ИначеЕсли ТипСобытия = "dialog_message" Тогда
		Возврат НСтр("ru = 'сообщение в диалоге пакета'; en = 'package dialog message'");
	Иначе
		// Незнакомый повод (защитный default, не должен встречаться при
		// вызове из трёх точек, зарегистрированных в спеке).
		Возврат ТипСобытия;
	КонецЕсли;

КонецФункции

// Текст письма по поводам с готовым описанием из журнала (agentrunner-32):
// для subject_excluded берётся текст последней записи subject_excluded этого
// запуска в ar_СлужебныйЛог (агент, предмет, три RunId из лога). Для прочих
// поводов возвращается "" - используется общий шаблон письма.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска.
//  ТипСобытия - Строка - повод уведомления.
//
// Возвращаемое значение:
//  Строка - текст события для тела письма; "" если повод без спец-текста.
//
Функция ТекстСобытияИзЖурнала(Знач RunId, Знач ТипСобытия)

	Если ТипСобытия <> "subject_excluded" Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|	И Лог.ar_RunId = &RunId
		|УПОРЯДОЧИТЬ ПО
		|	Лог.ar_Момент УБЫВ";
	Запрос.УстановитьПараметр("Источник", "ar_ПредметыАгентов");
	Запрос.УстановитьПараметр("Событие", "subject_excluded");
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Выборка.Текст;

КонецФункции

// Поля шапки информативного письма (спека п.1): агент, предмет, статус, время
// старта/завершения запуска и время события; незаполненные поля пропускаются
// (повод - заголовок карточки письма). Время - в формате ДД.ММ.ГГГГ ЧЧ:мм.
// agentrunner-54: поле "Завершен" выводится только у терминального статуса
// (Данные.СтатусФинальный) - у идущего запуска дата от паузы вводила бы
// в заблуждение (а после правки ar_AuditЗапуски.Завершить её и не остаётся).
//
// Параметры:
//  Данные - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Массив из Структура - поля шапки, см. ТаблицаПолейПисьмаHTML.
//
Функция ПоляШапкиПисьма(Знач Данные)

	Поля = Новый Массив;

	Если Не ПустаяСтрока(Данные.Агент) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Агент'; en = 'Agent'"), Данные.Агент);
	КонецЕсли;

	Если Не ПустаяСтрока(Данные.ПредметПредставление) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Предмет'; en = 'Subject'"), Данные.ПредметПредставление);
	КонецЕсли;

	Если Не ПустаяСтрока(Данные.Статус) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Статус запуска'; en = 'Run status'"), Данные.Статус);
	КонецЕсли;

	Если ЗначениеЗаполнено(Данные.СтартовалВ) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Начат'; en = 'Started'"),
			Формат(Данные.СтартовалВ, "ДФ='dd.MM.yyyy HH:mm'"));
	КонецЕсли;

	Если Данные.СтатусФинальный И ЗначениеЗаполнено(Данные.ЗавершенВ) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Завершен'; en = 'Finished'"),
			Формат(Данные.ЗавершенВ, "ДФ='dd.MM.yyyy HH:mm'"));
	КонецЕсли;

	ДобавитьПолеПисьма(Поля, НСтр("ru = 'Время события'; en = 'Event time'"),
		Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'"));

	Возврат Поля;

КонецФункции

// Тема и текст информативного письма (agentrunner-51, спека п.2-4): HTML-карточка
// (КарточкаПисьмаHTML) - повод заголовком, цвет полосы по поводу (ВидПисьмаПоПоводу),
// поля шапки, описание события, действие оператора, ссылка на диалог текстом (если
// у запуска есть диалог) и кнопки «Открыть» на запуск, предмет и очередь
// подтверждений. Сборка выполняется ПОСЛЕ резервирования отправки
// (ЗарезервироватьОтправкуЕслиНеБыло в УведомитьВнутр), поэтому целиком обернута
// в Попытку: ни одна ошибка сборки не прерывает отправку - в ar_СлужебныйЛог
// пишется notify_build_failed, а письмо уходит по прежнему общему шаблону
// простым текстом (спека п.5, D9).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//
// Возвращаемое значение:
//  Структура - {Тема: Строка, Текст: Строка, ЭтоHTML: Булево}.
//
Функция ТемаИТекстПисьма(Знач RunId, Знач ТипСобытия)

	Попытка

		Данные = ДанныеСобытия(RunId);
		Если Не Данные.Найдено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'запись запуска %1 в ar_Запуски не найдена';
				|en = 'run record %1 not found in ar_Запуски'"), RunId);
		КонецЕсли;

		Повод = ПредставлениеПовода(ТипСобытия);
		ОписаниеИДействие = ОписаниеСобытия(RunId, ТипСобытия, Данные);
		Цвет = ЦветВидаПисьма(ВидПисьмаПоПоводу(ТипСобытия));
		ЕстьДиалог = ЗначениеЗаполнено(Данные.Диалог);

		Блоки = Новый Массив;
		Блоки.Добавить(ТаблицаПолейПисьмаHTML(ПоляШапкиПисьма(Данные)));
		Если Не ПустаяСтрока(ОписаниеИДействие.Описание) Тогда
			Блоки.Добавить(БлокСПодписьюHTML(НСтр("ru = 'Описание'; en = 'Description'"),
				ОписаниеИДействие.Описание, ""));
		КонецЕсли;
		Если Не ПустаяСтрока(ОписаниеИДействие.Действие) Тогда
			Блоки.Добавить(БлокСПодписьюHTML(НСтр("ru = 'Что сделать'; en = 'Action required'"),
				ОписаниеИДействие.Действие, Цвет));
		КонецЕсли;
		Если ЕстьДиалог Тогда
			Блоки.Добавить(БлокСсылкиНаДиалогHTML(Данные.Диалог));
		КонецЕсли;
		// Подсказка Shift+F11 при пустом адресе публикации - в блоке ссылки на
		// диалог; без диалога - под таблицей ссылок.
		Блоки.Добавить(БлокСсылокПисьмаHTML(СсылкиПисьмаЗапуска(RunId, ТипСобытия, Данные),
			Цвет, Не ЕстьДиалог, RunId));

		Подвал = ?(ЕстьДиалог, ПодвалПисьмаСДиалогом(),
			НСтр("ru = 'Письмо отправлено автоматически.'; en = 'This message was sent automatically.'"));

		Возврат Новый Структура("Тема, Текст, ЭтоHTML",
			ТемаПисьма(Повод, Данные.Агент, Данные.ПредметПредставление, RunId),
			КарточкаПисьмаHTML(ВРег(Лев(Повод, 1)) + Сред(Повод, 2), Цвет, Блоки, Подвал),
			Истина);

	Исключение
		// Сбой сборки (нет записи запуска, поврежден payload, ошибка чтения)
		// не отменяет уведомление - уходит прежний общий шаблон (спека п.5).
		// Катч не имеет права выбросить исключение: маскировка и запись в лог
		// - внешние вызовы, тоже в Попытке (эталон - Уведомить).
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Уведомления.ТемаИТекстПисьма", "notify_build_failed",
				СтрШаблон("Сборка информативного письма не удалась, уходит общий шаблон (RunId=%1, повод=%2): %3",
					RunId, ТипСобытия, ТекстОшибки), "Ошибка", RunId);
		Исключение
			// Лог недоступен - резервная запись в журнал регистрации; письмо
			// все равно уйдет по общему шаблону.
			ЗаписьЖурналаРегистрации("AgentRunner.Notifications.BuildFailed",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"ar_Уведомления: не удалось записать notify_build_failed в ar_СлужебныйЛог (RunId=" + RunId + ")");
		КонецПопытки;

		Возврат ПрежнийШаблонПисьма(RunId, ТипСобытия);
	КонецПопытки;

КонецФункции

// Прежний общий шаблон письма (тема и тело как до agentrunner-51) - резерв
// при сбое информативной сборки. Тексты повторяют прежний код ОтправитьEmail:
// для subject_excluded в тело по-прежнему добавляются подробности из журнала.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//
// Возвращаемое значение:
//  Структура - {Тема: Строка, Текст: Строка, ЭтоHTML: Булево (Ложь - простой текст)}.
//
Функция ПрежнийШаблонПисьма(Знач RunId, Знач ТипСобытия)

	Тема = СтрШаблон(НСтр("ru = 'AgentRunner: %1 (RunId %2)';
		|en = 'AgentRunner: %1 (RunId %2)'"), ПредставлениеПовода(ТипСобытия), RunId);

	ТекстИзЖурнала = ТекстСобытияИзЖурнала(RunId, ТипСобытия);
	Если Не ПустаяСтрока(ТекстИзЖурнала) Тогда
		ШаблонСобытия = НСтр("ru = 'Событие: %1%3Подробности: %2%3Требуется внимание оператора AgentRunner.';
			|en = 'Event: %1%3Details: %2%3AgentRunner operator attention required.'");
		ТекстПисьма = СтрШаблон(ШаблонСобытия, ПредставлениеПовода(ТипСобытия),
			ТекстИзЖурнала, Символы.ПС);
	Иначе
		ШаблонТекстаПисьма = НСтр("ru = 'Событие: %1%3RunId: %2%3Требуется внимание оператора AgentRunner.';
			|en = 'Event: %1%3RunId: %2%3AgentRunner operator attention required.'");
		ТекстПисьма = СтрШаблон(ШаблонТекстаПисьма, ПредставлениеПовода(ТипСобытия), RunId, Символы.ПС);
	КонецЕсли;

	Возврат Новый Структура("Тема, Текст, ЭтоHTML", Тема, ТекстПисьма, Ложь);

КонецФункции

// Данные информативного письма одним чтением записи ar_Запуски (спека п.1):
// представления агента и предмета, диалог, статус, время старта/завершения,
// текст ошибки и счетчики. Чтение - как в существующих функциях модуля.
// agentrunner-54: СтатусФинальный - признак терминального статуса
// (ar_AuditЗапуски.ЭтоТерминальныйСтатусЗапуска) для строки "Завершен" письма.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - {Найдено: Булево, Агент: Строка, Предмет: Произвольный,
//               ПредметПредставление: Строка, Диалог: Произвольный,
//               Статус: Строка, СтатусФинальный: Булево,
//               СтартовалВ: Дата, ЗавершенВ: Дата,
//               ОтветLLM: Строка, ПопытокВозобновления: Число,
//               ШаговВсего: Число, ПродолженийСделано: Число}.
//  Найдено=Ложь - записи запуска нет (остальные поля пустые).
//
Функция ДанныеСобытия(Знач RunId)

	Шапка = ПрочитатьШапкуЗапуска(RunId);

	Агент = "";
	Если ЗначениеЗаполнено(Шапка.Агент) Тогда
		Агент = Строка(Шапка.Агент);
	КонецЕсли;

	ПредметПредставление = "";
	Если ЗначениеЗаполнено(Шапка.Предмет) Тогда
		ПредметПредставление = Строка(Шапка.Предмет);
	КонецЕсли;

	Статус = "";
	СтатусФинальный = Ложь;
	Если ЗначениеЗаполнено(Шапка.Статус) Тогда
		Статус = Строка(Шапка.Статус);
		СтатусФинальный = ar_AuditЗапуски.ЭтоТерминальныйСтатусЗапуска(Шапка.Статус);
	КонецЕсли;

	Возврат Новый Структура(
		"Найдено, Агент, Предмет, ПредметПредставление, Диалог, Статус, СтатусФинальный,
		|СтартовалВ, ЗавершенВ, ОтветLLM, ПопытокВозобновления, ШаговВсего, ПродолженийСделано",
		Шапка.Найдено, Агент, Шапка.Предмет, ПредметПредставление, Шапка.Диалог,
		Статус, СтатусФинальный, Шапка.СтартовалВ, Шапка.ЗавершенВ, Шапка.ОтветLLM,
		Шапка.ПопытокВозобновления, Шапка.ШаговВсего, Шапка.ПродолженийСделано);

КонецФункции

// Описание события и действие оператора по поводам (спека п.2). Нет нужной
// записи (события, approval) - строки остаются пустыми и в письме пропускаются;
// неизвестный повод - общий текст "Требуется внимание оператора AgentRunner".
// Причина/ошибка/обоснование маскируются и обрезаются до 1000 символов.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//  Данные     - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Структура - {Описание: Строка, Действие: Строка}.
//
Функция ОписаниеСобытия(Знач RunId, Знач ТипСобытия, Знач Данные)

	Результат = Новый Структура("Описание, Действие", "", "");

	Если ТипСобытия = "escalation" Тогда
		// Два разных источника повода: надзор (событие НадзорРешение) и
		// дедлайн ожидания события (ОжиданиеСобытия/wait_expired, при котором
		// НадзорРешения нет) - см. research.md.
		ПолезнаяНагрузкаНадзора = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
			Перечисления.ar_ТипСобытия.НадзорРешение);
		Если ПолезнаяНагрузкаНадзора <> Неопределено Тогда
			Результат.Описание = ОписаниеЭскалацииНадзора(ПолезнаяНагрузкаНадзора, Данные);
			Результат.Действие = НСтр("ru = 'Откройте запуск, оцените ход работы и продолжите или отмените его';
				|en = 'Open the run, review the progress, then resume or cancel it'");
		Иначе
			ПолезнаяНагрузкаОжидания = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
				Перечисления.ar_ТипСобытия.ОжиданиеСобытия);
			Если ПолезнаяНагрузкаОжидания <> Неопределено
				И ПолезнаяНагрузкаОжидания.Получить("code") = "wait_expired" Тогда
				Результат.Описание = НСтр("ru = 'истек срок ожидания события';
					|en = 'the event wait deadline has expired'");
				Результат.Действие = НСтр("ru = 'Проверьте, наступило ли ожидаемое событие; продолжите или отмените запуск';
					|en = 'Check whether the expected event has occurred; resume or cancel the run'");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ТипСобытия = "approval_pending" Тогда
		Результат.Описание = ОписаниеОжиданияПодтверждения(RunId);
		Результат.Действие = НСтр("ru = 'Подтвердите или отклоните действие в очереди подтверждений';
			|en = 'Approve or reject the action in the approval queue'");

	ИначеЕсли ТипСобытия = "retry_exhausted" Тогда
		Результат.Описание = ОписаниеИсчерпанныхПовторов(RunId, Данные);
		Результат.Действие = НСтр("ru = 'Изучите ошибку в карточке запуска; после устранения причины запустите заново';
			|en = 'Review the error in the run card; restart the run after fixing the cause'");

	ИначеЕсли ТипСобытия = "subject_excluded" Тогда
		ТекстЖурнала = ТекстСобытияИзЖурнала(RunId, ТипСобытия);
		Если Не ПустаяСтрока(ТекстЖурнала) Тогда
			Результат.Описание = ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(ТекстЖурнала), ЛимитТекстаСобытия());
		КонецЕсли;
		Результат.Действие = НСтр("ru = 'Проверьте предмет; после исправления верните его в очередь';
			|en = 'Check the subject; return it to the queue after fixing'");

	Иначе
		// Неизвестный повод - общий текст (спека п.2). Публичный контракт
		// Уведомить принимает любую строку повода.
		Результат.Описание = НСтр("ru = 'Требуется внимание оператора AgentRunner';
			|en = 'AgentRunner operator attention required'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Текст причины эскалации надзора из payload события НадзорРешение
// (escalation_reason: budget/stagnation/safety_cap) с цифрами (agentrunner-54).
// Payload с новыми ключами (steps/max_steps/actions/max_actions/limit/
// continuations - протокол в ar_Надзор.ЗафиксироватьЭскалацию) - цифры берутся
// из payload: тот же снимок состояния, что у надзора в момент решения (письмо
// уходит до ЗавершитьЗапуска, когда ar_ШаговВсего в регистре ещё 0):
//  budget     - "исчерпан бюджет запуска: шагов 20 из 20" / "...: действий 50
//               из 50"; известны оба счётчика - исчерпанный лимит первым
//               ("шагов 20 из 20, действий 12 из 50");
//  stagnation - "застой: шаги повторяются без прогресса (шагов: N, продолжений: K)";
//  safety_cap - "достигнут потолок продолжений (продолжений: K из 10, шагов: N)".
// Payload без новых ключей (старые события) - прежний текст и цифры из регистра
// ar_Запуски, как до agentrunner-54.
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//  Данные           - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Строка - описание причины; пустая, если причина не распознана.
//
Функция ОписаниеЭскалацииНадзора(Знач ПолезнаяНагрузка, Знач Данные)

	Причина = "";
	КодПричины = "";
	ЗначениеКода = ПолезнаяНагрузка.Получить("escalation_reason");
	Если ТипЗнч(ЗначениеКода) = Тип("Строка") Тогда
		КодПричины = ЗначениеКода;
		Если КодПричины = "budget" Тогда
			Причина = НСтр("ru = 'исчерпан бюджет запуска'; en = 'run budget exhausted'");
		ИначеЕсли КодПричины = "stagnation" Тогда
			Причина = НСтр("ru = 'застой: шаги повторяются без прогресса';
				|en = 'stagnation: steps repeat without progress'");
		ИначеЕсли КодПричины = "safety_cap" Тогда
			Причина = НСтр("ru = 'достигнут потолок продолжений';
				|en = 'continuation safety cap reached'");
		Иначе
			// Незнакомый код причины - выводится как есть, с маскировкой и обрезкой.
			Причина = ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(КодПричины), ЛимитТекстаСобытия());
		КонецЕсли;
	КонецЕсли;

	Если ЕстьЦифрыВПолезнойНагрузке(ПолезнаяНагрузка) Тогда
		ЦифрыСтрокой = ЦифрыИзПолезнойНагрузки(КодПричины, ПолезнаяНагрузка);
		Если Не ПустаяСтрока(ЦифрыСтрокой) Тогда
			Возврат ПричинаСЦифрами(Причина, КодПричины, ЦифрыСтрокой);
		КонецЕсли;
	КонецЕсли;

	// Старый payload (или пары в нём неполные) - цифры из регистра, как раньше.
	Возврат ПричинаСЦифрамиИзРегистра(Причина, Данные);

КонецФункции

// Есть ли в payload новые ключи цифр (протокол agentrunner-54) - признак,
// отличающий новые события от старых (без ключей - прежнее поведение).
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы один ключ цифр.
//
Функция ЕстьЦифрыВПолезнойНагрузке(Знач ПолезнаяНагрузка)

	КлючиЦифр = Новый Массив;
	КлючиЦифр.Добавить("steps");
	КлючиЦифр.Добавить("max_steps");
	КлючиЦифр.Добавить("actions");
	КлючиЦифр.Добавить("max_actions");
	КлючиЦифр.Добавить("limit");
	КлючиЦифр.Добавить("continuations");

	Для Каждого Ключ Из КлючиЦифр Цикл
		Если ПолезнаяНагрузка.Получить(Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Число из payload по ключу; значение не-числа (повреждённый payload) -
// Неопределено: фрагмент с ним не выводится.
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//  Ключ             - Строка - ключ цифры протокола ("steps", "max_steps", ...).
//
// Возвращаемое значение:
//  Число, Неопределено - значение ключа; Неопределено - ключа нет или не число.
//
Функция ЧислоИзПолезнойНагрузки(Знач ПолезнаяНагрузка, Знач Ключ)

	Значение = ПолезнаяНагрузка.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Цифры из payload для известных причин (agentrunner-54):
//  budget     - пары "шагов S из M" / "действий A из X";
//  safety_cap - "продолжений: K из 10, шагов: N";
//  остальные  - "шагов: N, продолжений: K" (stagnation и незнакомые причины).
// Фрагмент выводится, только если оба его числа есть в payload.
//
// Параметры:
//  КодПричины       - Строка - escalation_reason из payload ("budget"/
//                     "stagnation"/"safety_cap"/иное).
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//
// Возвращаемое значение:
//  Строка - цифры через запятую; пустая, если ни одной полной пары.
//
Функция ЦифрыИзПолезнойНагрузки(Знач КодПричины, Знач ПолезнаяНагрузка)

	Если КодПричины = "budget" Тогда
		Возврат ЦифрыБюджетаСтрокой(ПолезнаяНагрузка);
	КонецЕсли;

	Если КодПричины = "safety_cap" Тогда
		Возврат ЦифрыПотолкаСтрокой(ПолезнаяНагрузка);
	КонецЕсли;

	// stagnation и незнакомые причины с цифрами - формат прежнего письма.
	Части = Новый Массив;
	Шагов = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "steps");
	Если Шагов <> Неопределено Тогда
		Части.Добавить(ФрагментШагов(Шагов));
	КонецЕсли;
	Продолжений = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "continuations");
	Если Продолжений <> Неопределено Тогда
		Части.Добавить(ФрагментПродолжений(Продолжений));
	КонецЕсли;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Цифры исчерпания бюджета (agentrunner-54): "шагов S из M" и/или
// "действий A из X"; известны обе - исчерпанный лимит (payload.limit)
// первым, оба лимита исчерпаны - шаги первыми.
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//
// Возвращаемое значение:
//  Строка - одна или две пары через запятую; пустая, если нет полных пар.
//
Функция ЦифрыБюджетаСтрокой(Знач ПолезнаяНагрузка)

	ШагиСтрокой = "";
	Шагов = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "steps");
	ЛимитШагов = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "max_steps");
	Если Шагов <> Неопределено И ЛимитШагов <> Неопределено Тогда
		ШагиСтрокой = СтрШаблон(НСтр("ru = 'шагов %1 из %2'; en = 'steps %1 of %2'"), Шагов, ЛимитШагов);
	КонецЕсли;

	ДействияСтрокой = "";
	Действий = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "actions");
	ЛимитДействий = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "max_actions");
	Если Действий <> Неопределено И ЛимитДействий <> Неопределено Тогда
		ДействияСтрокой = СтрШаблон(НСтр("ru = 'действий %1 из %2'; en = 'actions %1 of %2'"),
			Действий, ЛимитДействий);
	КонецЕсли;

	// Только одна пара - она и возвращается ("" + строка = строка).
	Если ДействияСтрокой = "" Или ШагиСтрокой = "" Тогда
		Возврат ШагиСтрокой + ДействияСтрокой;
	КонецЕсли;

	Если ПолезнаяНагрузка.Получить("limit") = "actions" Тогда
		Возврат ДействияСтрокой + ", " + ШагиСтрокой;
	КонецЕсли;

	Возврат ШагиСтрокой + ", " + ДействияСтрокой;

КонецФункции

// Цифры потолка продолжений (agentrunner-54): "продолжений: K из 10, шагов: N"
// (потолок 10 - константа слоя 3 надзора, CONS-11,
// ar_Надзор.ПроверитьИИнкрементироватьПотолок).
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//
// Возвращаемое значение:
//  Строка - фрагменты через запятую; пустая, если continuations в payload нет.
//
Функция ЦифрыПотолкаСтрокой(Знач ПолезнаяНагрузка)

	Продолжений = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "continuations");
	Если Продолжений = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПродолженийИзПотолка = СтрШаблон(
		НСтр("ru = 'продолжений: %1 из 10'; en = 'continuations: %1 of 10'"), Продолжений);
	Части = Новый Массив;
	Части.Добавить(ПродолженийИзПотолка);
	Шагов = ЧислоИзПолезнойНагрузки(ПолезнаяНагрузка, "steps");
	Если Шагов <> Неопределено Тогда
		Части.Добавить(ФрагментШагов(Шагов));
	КонецЕсли;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Соединить причину эскалации с цифрами: для budget цифры идут через двоеточие
// ("исчерпан бюджет запуска: шагов 3 из 3"), для остальных - в скобках, как в
// прежнем письме.
//
// Параметры:
//  Причина       - Строка - текст причины (может быть пустым).
//  КодПричины    - Строка - escalation_reason из payload.
//  ЦифрыСтрокой  - Строка - готовые цифры через запятую.
//
// Возвращаемое значение:
//  Строка - причина с цифрами; без причины - только цифры.
//
Функция ПричинаСЦифрами(Знач Причина, Знач КодПричины, Знач ЦифрыСтрокой)

	Если ПустаяСтрока(Причина) Тогда
		Возврат ЦифрыСтрокой;
	КонецЕсли;

	Если КодПричины = "budget" Тогда
		Возврат Причина + ": " + ЦифрыСтрокой;
	КонецЕсли;

	Возврат Причина + " (" + ЦифрыСтрокой + ")";

КонецФункции

// Прежний формат (для старых payload без новых ключей, agentrunner-54): цифры
// из записи ar_Запуски (шагов, продолжений) - "(шагов: N, продолжений: K)".
//
// Параметры:
//  Причина - Строка - текст причины (может быть пустым).
//  Данные  - Структура - результат ДанныеСобытия (ШаговВсего, ПродолженийСделано).
//
// Возвращаемое значение:
//  Строка - причина с цифрами; без причин и цифр - пустая.
//
Функция ПричинаСЦифрамиИзРегистра(Знач Причина, Знач Данные)

	Цифры = Новый Массив;
	Если Данные.ШаговВсего > 0 Тогда
		Цифры.Добавить(ФрагментШагов(Данные.ШаговВсего));
	КонецЕсли;
	Если Данные.ПродолженийСделано > 0 Тогда
		Цифры.Добавить(ФрагментПродолжений(Данные.ПродолженийСделано));
	КонецЕсли;

	Если Цифры.Количество() = 0 Тогда
		Возврат Причина;
	КонецЕсли;

	Возврат ПричинаСЦифрами(Причина, "", СтрСоединить(Цифры, ", "));

КонецФункции

// Фрагмент "шагов: N" - общий для новых payload и прежнего формата из
// регистра (agentrunner-54).
//
// Параметры:
//  Шагов - Число - шагов сделано.
//
// Возвращаемое значение:
//  Строка - фрагмент для письма.
//
Функция ФрагментШагов(Знач Шагов)

	Возврат СтрШаблон(НСтр("ru = 'шагов: %1'; en = 'steps: %1'"), Шагов);

КонецФункции

// Фрагмент "продолжений: K" - общий для новых payload и прежнего формата из
// регистра (agentrunner-54).
//
// Параметры:
//  Продолжений - Число - продолжений сделано.
//
// Возвращаемое значение:
//  Строка - фрагмент для письма.
//
Функция ФрагментПродолжений(Знач Продолжений)

	Возврат СтрШаблон(НСтр("ru = 'продолжений: %1'; en = 'continuations: %1'"), Продолжений);

КонецФункции

// Описание ожидающих подтверждений запуска (спека п.2): по каждой записи
// очереди - инструмент (payload.tool_name), уровень риска (payload.risk_level),
// срок (ar_ОтветитьДо) и обоснование модели (ar_ОбоснованиеLLM, маскированное
// и обрезанное). Аргументы инструмента не выводятся (спека, audit п.4).
// Ожидающие записи - фасад ar_AuditЗащищённыйРежим
// (НайтиОжидающиеApprovalЗапускаПривилегированно); детали - один привилегированный
// запрос по списку идентификаторов: фасад ПрочитатьЗаписьОчередиПривилегированно
// возвращает запись без ar_ОбоснованиеLLM/ar_ОтветитьДо (см. mcp.md [P3]),
// а запрос в цикле по записям запрещен стандартом проекта.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - описание по каждой ожидающей записи (переводы строк внутри);
//  пустая, если ожидающих записей нет.
//
Функция ОписаниеОжиданияПодтверждения(Знач RunId)

	Ожидающие = ar_AuditЗащищённыйРежим.НайтиОжидающиеApprovalЗапускаПривилегированно(RunId);
	Если Ожидающие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Ожидающее Из Ожидающие Цикл
		Идентификаторы.Добавить(Ожидающее.ApprovalId);
	КонецЦикла;

	// Привилегированное чтение - как в УжеУведомляли: уведомление идет в том
	// числе из регламентных заданий без гарантии роли на регистры очереди.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Очередь.ar_ApprovalId КАК ApprovalId,
			|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON,
			|	Очередь.ar_ОбоснованиеLLM КАК ОбоснованиеLLM,
			|	Очередь.ar_ОтветитьДо КАК ОтветитьДо
			|ИЗ
			|	РегистрСведений.ar_ОчередьApproval КАК Очередь
			|ГДЕ
			|	Очередь.ar_ApprovalId В (&Идентификаторы)
			|УПОРЯДОЧИТЬ ПО
			|	Очередь.ar_СозданоВ";
		Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаЗаписи = СтрокаЗаписиОчередиApproval(Выборка);
		Если Не ПустаяСтрока(СтрокаЗаписи) Тогда
			Строки.Добавить(СтрокаЗаписи);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строка описания одной записи очереди approval (спека п.2): инструмент
// (payload.tool_name), уровень риска (payload.risk_level) и срок - одной
// строкой через запятую; обоснование модели (маскированное, обрезанное) -
// отдельной строкой. Поврежденный payload записи не отменяет остальные
// строки описания: инструмент и риск просто пропускаются.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - строка выборки ОписаниеОжиданияПодтверждения
//   (поля ActionPayloadJSON, ОтветитьДо, ОбоснованиеLLM).
//
// Возвращаемое значение:
//  Строка - описание записи; пустая, если в записи нечего показать.
//
Функция СтрокаЗаписиОчередиApproval(Знач Выборка)

	Части = Новый Массив;
	ПолезнаяНагрузка = ar_JSON.ИзJSON(Выборка.ActionPayloadJSON);
	Если ТипЗнч(ПолезнаяНагрузка) = Тип("Соответствие") Тогда
		ИмяИнструмента = ПолезнаяНагрузка.Получить("tool_name");
		Если ТипЗнч(ИмяИнструмента) = Тип("Строка") И Не ПустаяСтрока(ИмяИнструмента) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'инструмент: %1'; en = 'tool: %1'"),
				ИмяИнструмента));
		КонецЕсли;
		УровеньРиска = ПолезнаяНагрузка.Получить("risk_level");
		Если ТипЗнч(УровеньРиска) = Тип("Строка") И Не ПустаяСтрока(УровеньРиска) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'риск: %1'; en = 'risk: %1'"), УровеньРиска));
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Выборка.ОтветитьДо) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'ответить до: %1'; en = 'answer before: %1'"),
			Формат(Выборка.ОтветитьДо, "ДФ='dd.MM.yyyy HH:mm'")));
	КонецЕсли;

	СтрокаЗаписи = ?(Части.Количество() > 0, СтрСоединить(Части, ", "), "");

	Если Не ПустаяСтрока(Выборка.ОбоснованиеLLM) Тогда
		Обоснование = СтрШаблон(НСтр("ru = 'Обоснование модели: %1'; en = 'Model rationale: %1'"),
			ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(Выборка.ОбоснованиеLLM), ЛимитТекстаСобытия()));
		СтрокаЗаписи = ?(ПустаяСтрока(СтрокаЗаписи), Обоснование, СтрокаЗаписи + Символы.ПС + Обоснование);
	КонецЕсли;

	Возврат СтрокаЗаписи;

КонецФункции

// Описание повода retry_exhausted (спека п.2): число автоматических повторов
// (ar_ПопытокВозобновления) и последняя ошибка - ar_ОтветLLM запуска, а если
// он пуст, payload.error последнего события Ошибка. Текст ошибки маскируется
// и обрезается до 1000 символов.
//
// Параметры:
//  RunId  - Строка(36) - идентификатор запуска.
//  Данные - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Строка - описание повода.
//
Функция ОписаниеИсчерпанныхПовторов(Знач RunId, Знач Данные)

	Описание = СтрШаблон(НСтр("ru = 'исчерпаны автоматические повторы (%1)';
		|en = 'automatic retries exhausted (%1)'"), Данные.ПопытокВозобновления);

	ТекстОшибки = СокрЛП(Данные.ОтветLLM);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ПолезнаяНагрузка = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
			Перечисления.ar_ТипСобытия.Ошибка);
		Если ПолезнаяНагрузка <> Неопределено Тогда
			ТекстИзPayload = ПолезнаяНагрузка.Получить("error");
			Если ТипЗнч(ТекстИзPayload) = Тип("Строка") Тогда
				ТекстОшибки = СокрЛП(ТекстИзPayload);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Описание = Описание + Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Последняя ошибка: %1'; en = 'Last error: %1'"),
				ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(ТекстОшибки), ЛимитТекстаСобытия()));
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Разобранный payload последнего события заданного типа по RunId; порядок -
// по ar_Sequence УБЫВ (см. mcp.md [P3]). Чтение привилегированное - как в
// УжеУведомляли: вызов идет из регламентных заданий, где нет гарантии
// интерактивного пользователя с ролью на ar_СобытияЗапуска.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор запуска.
//  ТипСобытияЗапуска - ПеречислениеСсылка.ar_ТипСобытия - тип события.
//
// Возвращаемое значение:
//  Соответствие - разобранный payload; Неопределено, если события нет.
//  Запись есть, но payload поврежден (не разбирается) - исключение: сборка
//  письма откатывается на общий шаблон (критерий 5 спеки).
//
Функция ПолезнаяНагрузкаПоследнегоСобытия(Знач RunId, Знач ТипСобытияЗапуска)

	ТекстPayload = "";
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	События.ar_PayloadJSON КАК PayloadJSON
			|ИЗ
			|	РегистрСведений.ar_СобытияЗапуска КАК События
			|ГДЕ
			|	События.ar_RunId = &RunId
			|	И События.ar_ТипСобытия = &ТипСобытия
			|УПОРЯДОЧИТЬ ПО
			|	События.ar_Sequence УБЫВ";
		Запрос.УстановитьПараметр("RunId", RunId);
		Запрос.УстановитьПараметр("ТипСобытия", ТипСобытияЗапуска);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ТекстPayload = Выборка.PayloadJSON;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ПустаяСтрока(ТекстPayload) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолезнаяНагрузка = ar_JSON.ИзJSON(ТекстPayload);
	Если ТипЗнч(ПолезнаяНагрузка) <> Тип("Соответствие") Тогда
		// Запись события есть, а payload поврежден - это сбой сборки, а не
		// отсутствие данных: письмо уходит по общему шаблону (спека п.5).
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'поврежден payload события %1 (RunId=%2)';
			|en = 'damaged payload of event %1 (RunId=%2)'"),
			Строка(ТипСобытияЗапуска), RunId);
	КонецЕсли;

	Возврат ПолезнаяНагрузка;

КонецФункции

// Ссылки информативного письма (спека п.4): запуск (ключ записи ar_Запуски, по
// нему открывается основная форма записи ar_ПросмотрЗапуска), предмет (если
// заполнен и существует), для approval_pending - очередь подтверждений. Диалог
// запуска в письме - ссылкой текстом (БлокСсылкиНаДиалогHTML), не кнопкой.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//  Данные     - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Массив из Структура - ссылки письма, см. БлокСсылокПисьмаHTML.
//
Функция СсылкиПисьмаЗапуска(Знач RunId, Знач ТипСобытия, Знач Данные)

	Ссылки = Новый Массив;
	Ссылки.Добавить(Новый Структура("Представление, Ссылка",
		НСтр("ru = 'Запуск'; en = 'Run'"), НавигационнаяСсылкаЗапуска(RunId)));

	Если ЗначениеЗаполнено(Данные.Предмет)
		И ОбщегоНазначения.СсылкаСуществует(Данные.Предмет) Тогда
		Ссылки.Добавить(Новый Структура("Представление, Ссылка",
			СтрШаблон(НСтр("ru = 'Предмет: %1'; en = 'Subject: %1'"), Данные.ПредметПредставление),
			Данные.Предмет));
	КонецЕсли;

	Если ТипСобытия = "approval_pending" Тогда
		// Формат e1cib/app/<имя формы> - как в примере БСП к АдресПубликации;
		// открытие проверяется на стенде (verify), см. спеку п.4.
		Ссылки.Добавить(Новый Структура("Представление, Ссылка",
			НСтр("ru = 'Очередь подтверждений'; en = 'Approval queue'"),
			"e1cib/app/ОбщаяФорма.ar_ОчередьПодтверждений"));
	КонецЕсли;

	Возврат Ссылки;

КонецФункции

// Вид письма о событии запуска (цвет полосы карточки, см. ЦветВидаПисьма):
// эскалация, исчерпанные повторы и исключение предмета - «ошибка»; ожидание
// подтверждения или ответа - «внимание»; прочие поводы - сведения.
//
// Параметры:
//  ТипСобытия - Строка - повод письма.
//
// Возвращаемое значение:
//  Строка - вид письма.
//
Функция ВидПисьмаПоПоводу(Знач ТипСобытия)

	Если ТипСобытия = "escalation" Или ТипСобытия = "retry_exhausted"
		Или ТипСобытия = "subject_excluded" Тогда
		Возврат "ошибка";
	ИначеЕсли ТипСобытия = "approval_pending" Или ТипСобытия = "input_pending" Тогда
		Возврат "внимание";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Навигационная ссылка на запись запуска: ключ регистра ar_Запуски (спека
// п.4, методы - mcp.md [P2]). По ссылке веб-клиент открывает основную форму
// записи - CommonForm.ar_ПросмотрЗапуска (DefaultRecordForm регистра).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - навигационная ссылка на запись регистра.
//
Функция НавигационнаяСсылкаЗапуска(Знач RunId)

	КлючЗаписи = РегистрыСведений.ar_Запуски.СоздатьКлючЗаписи(
		Новый Структура("ar_ИдентификаторЗапуска", RunId));
	Возврат ПолучитьНавигационнуюСсылку(КлючЗаписи);

КонецФункции

// Тема письма по схеме спеки п.3: "AgentRunner: <повод> - <агент>[ - <предмет,
// до 60 символов>] (RunId <uuid>)"; агента нет - без него. Тема обрезается
// до 250 символов. Разделитель - обычный дефис: специальные тире в коде
// запрещены стандартом проекта (mcp.md [ST]).
//
// Параметры:
//  Повод                - Строка - человекочитаемое представление повода.
//  Агент                - Строка - представление агента.
//  ПредметПредставление - Строка - представление предмета.
//  RunId                - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - тема письма (не длиннее 250 символов).
//
Функция ТемаПисьма(Знач Повод, Знач Агент, Знач ПредметПредставление, Знач RunId)

	Тема = "AgentRunner: " + Повод;
	Если Не ПустаяСтрока(Агент) Тогда
		Тема = Тема + " - " + Агент;
	КонецЕсли;
	Если Не ПустаяСтрока(ПредметПредставление) Тогда
		Тема = Тема + " - " + ОбрезатьСтроку(ПредметПредставление, 60);
	КонецЕсли;
	Тема = Тема + " (RunId " + RunId + ")";

	Возврат ОбрезатьСтроку(Тема, 250);

КонецФункции

// Лимит длины маскированных причины/ошибки/обоснования/текста журнала в письме
// (спека agentrunner-51 п.2: обрезка до 1000 символов с многоточием).
//
// Возвращаемое значение:
//  Число - предельная длина текста события в письме.
//
Функция ЛимитТекстаСобытия()

	Возврат 1000;

КонецФункции

// Обрезать строку до лимита символов; при усечении добавляется многоточие.
// Применяется к темам (60/250) и причинам/ошибкам/обоснованиям (1000).
//
// Параметры:
//  Текст - Строка - исходная строка.
//  Лимит - Число - предельная длина результата.
//
// Возвращаемое значение:
//  Строка - исходная строка или усеченная с многоточием на конце.
//
Функция ОбрезатьСтроку(Знач Текст, Знач Лимит)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) <= Лимит Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Лимит - 1) + "...";

КонецФункции

// Основная логика УведомитьОВопросе (см. doc-комментарий).
//
Функция УведомитьОВопросеВнутр(Знач ИдентификаторВопроса)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "");

	// 1. Запись очереди вопроса: RunId и payload (текст/подсказка/варианты).
	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ИдентификаторВопроса);
	Если ДанныеЗаписи = Неопределено Тогда
		Результат.Причина = "record_not_found";
		Возврат Результат;
	КонецЕсли;

	// 2. Диалог вопроса (для чата консоли его нет - письмо не отправляется).
	ДиалогВопроса = ar_ДиалогиСервер.ДиалогЗапуска(ДанныеЗаписи.RunId);
	Если Не ЗначениеЗаполнено(ДиалогВопроса) Тогда
		Результат.Причина = "no_dialog";
		Возврат Результат;
	КонецЕсли;

	// 3. Дедупликация: RunId + повод + идентификатор вопроса (спека п.10).
	Если ЗарезервироватьОтправкуЕслиНеБыло(ДанныеЗаписи.RunId, "input_pending",
		ИдентификаторВопроса) = Ложь Тогда
		Результат.Причина = "duplicate";
		Возврат Результат;
	КонецЕсли;

	// 4. Адресаты - участники диалога с адресом почты (записан при создании
	// участника из карточки пользователя; адрес из текста модели не принимается).
	Адресаты = АдресатыВопроса(ДиалогВопроса);
	Если Адресаты.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьОВопросеВнутр", "notify_no_recipients",
			СтрШаблон("У участников диалога %1 нет адресов почты (ApprovalId=%2)",
				Строка(ДиалогВопроса), ИдентификаторВопроса), "Ошибка", ДанныеЗаписи.RunId);
		Результат.Причина = "no_recipients";
		Возврат Результат;
	КонецЕсли;

	// 5. Письмо одним сообщением всем адресатам.
	ИтогОтправки = ОтправитьПисьмоОВопросе(ДанныеЗаписи, ДиалогВопроса, Адресаты);
	Результат.Отправлено = ИтогОтправки.Отправлено;
	Результат.Причина = ИтогОтправки.Причина;

	Возврат Результат;

КонецФункции

// Адресаты вопроса: участники диалога с адресом почты (ТЧ ar_Участники).
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без дублей по адресу.
//
Функция АдресатыВопроса(Знач ДиалогВопроса)

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Участники.ar_Пользователь КАК Пользователь,
		|	Участники.ar_АдресПочты КАК АдресПочты
		|ИЗ
		|	Справочник.ar_Диалоги.ar_Участники КАК Участники
		|ГДЕ
		|	Участники.Ссылка = &Диалог";
	Запрос.УстановитьПараметр("Диалог", ДиалогВопроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Адрес = "";
		Представление = "";

		Если ТипЗнч(Выборка.АдресПочты) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Выборка.АдресПочты)) Тогда
			Адрес = СокрЛП(Выборка.АдресПочты);
			Представление = ?(ЗначениеЗаполнено(Выборка.Пользователь),
				Строка(Выборка.Пользователь), Адрес);
		КонецЕсли;

		Если ПустаяСтрока(Адрес) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Адрес] = Неопределено Тогда
			ВидимыеEmail[Адрес] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Адрес, Представление));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// HTML письма о вопросе агента (КарточкаПисьмаHTML, вид «внимание»): заголовок
// «Агент ждёт вашего ответа», вопрос, поля (подсказка, варианты ответа, срок
// ответа, предмет), ссылка на диалог текстом и кнопки «Открыть» на запуск и
// предмет (если заполнен и существует).
//
// Параметры:
//  ДанныеВопроса - Структура - результат ДанныеВопросаИзPayload.
//  ДиалогВопроса - СправочникСсылка.ar_Диалоги - диалог вопроса.
//  RunId         - Строка(36) - идентификатор запуска.
//  ШапкаДиалога  - Структура - результат ar_ДиалогиСервер.ШапкаДиалога.
//
// Возвращаемое значение:
//  Строка - HTML письма.
//
Функция ТекстПисьмаОВопросеHTML(Знач ДанныеВопроса, Знач ДиалогВопроса, Знач RunId, Знач ШапкаДиалога)

	Цвет = ЦветВидаПисьма("внимание");

	Поля = Новый Массив;
	Если Не ПустаяСтрока(ДанныеВопроса.Подсказка) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Подсказка'; en = 'Hint'"), ДанныеВопроса.Подсказка);
	КонецЕсли;
	Если Не ПустаяСтрока(ДанныеВопроса.Варианты) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Варианты ответа'; en = 'Answer choices'"), ДанныеВопроса.Варианты);
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДиалога.ОтветитьДо) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Ответить до'; en = 'Answer before'"),
			Формат(ШапкаДиалога.ОтветитьДо, "ДФ='dd.MM.yyyy HH:mm'"));
	КонецЕсли;
	Если Не ПустаяСтрока(ШапкаДиалога.ПредставлениеПредмета) Тогда
		ДобавитьПолеПисьма(Поля, НСтр("ru = 'Предмет'; en = 'Subject'"), ШапкаДиалога.ПредставлениеПредмета);
	КонецЕсли;

	Ссылки = Новый Массив;
	Ссылки.Добавить(Новый Структура("Представление, Ссылка",
		НСтр("ru = 'Запуск'; en = 'Run'"), НавигационнаяСсылкаЗапуска(RunId)));
	Если ЗначениеЗаполнено(ШапкаДиалога.Предмет)
		И ОбщегоНазначения.СсылкаСуществует(ШапкаДиалога.Предмет) Тогда
		Ссылки.Добавить(Новый Структура("Представление, Ссылка",
			СтрШаблон(НСтр("ru = 'Предмет: %1'; en = 'Subject: %1'"), Строка(ШапкаДиалога.Предмет)),
			ШапкаДиалога.Предмет));
	КонецЕсли;

	Блоки = Новый Массив;
	Блоки.Добавить(БлокСПодписьюHTML(НСтр("ru = 'Вопрос'; en = 'Question'"), ДанныеВопроса.Текст, Цвет));
	Если Поля.Количество() > 0 Тогда
		Блоки.Добавить(ТаблицаПолейПисьмаHTML(Поля));
	КонецЕсли;
	Блоки.Добавить(БлокСсылкиНаДиалогHTML(ДиалогВопроса));
	Блоки.Добавить(БлокСсылокПисьмаHTML(Ссылки, Цвет, Ложь, RunId));

	Возврат КарточкаПисьмаHTML(НСтр("ru = 'Агент ждёт вашего ответа'; en = 'The agent is waiting for your reply'"),
		Цвет, Блоки, ПодвалПисьмаСДиалогом());

КонецФункции

// Карточка HTML-письма AgentRunner - общий вид писем модуля: карточка шириной
// 600 пикселей с цветной полосой, подписью «AgentRunner», заголовком, блоками
// содержимого и подвалом. Стили - только встроенные: почтовые клиенты блок
// <style> не применяют.
//
// Параметры:
//  Заголовок - Строка - заголовок карточки (экранируется).
//  Цвет      - Строка - цвет полосы карточки (ЦветВидаПисьма).
//  Блоки     - Массив из Строка - готовые фрагменты HTML содержимого, по строке
//              карточки на фрагмент; пустые фрагменты пропускаются.
//  Подвал    - Строка - текст подвала (экранируется).
//
// Возвращаемое значение:
//  Строка - HTML письма.
//
Функция КарточкаПисьмаHTML(Знач Заголовок, Знач Цвет, Знач Блоки, Знач Подвал)

	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"" /></head>"
		+ "<body style=""margin:0;padding:0;background:#f3f5f7;"">");
	Строки.Добавить("<table role=""presentation"" width=""100%"" cellpadding=""0"" cellspacing=""0"""
		+ " style=""background:#f3f5f7;padding:24px 8px;""><tr><td align=""center"">");
	Строки.Добавить("<table role=""presentation"" width=""600"" cellpadding=""0"" cellspacing=""0"""
		+ " style=""max-width:600px;width:100%;background:#ffffff;border:1px solid #d8dee4;"
		+ "border-radius:8px;font-family:'Segoe UI',Arial,sans-serif;color:#1f2328;"">");
	Строки.Добавить("<tr><td style=""background:" + Цвет + ";height:6px;font-size:0;line-height:0;"
		+ "border-radius:8px 8px 0 0;"">&nbsp;</td></tr>");
	Строки.Добавить("<tr><td style=""padding:20px 28px 2px 28px;font-size:12px;color:#57606a;"
		+ "letter-spacing:0.5px;"">AgentRunner</td></tr>");
	Строки.Добавить("<tr><td style=""padding:0 28px 14px 28px;font-size:20px;font-weight:600;"
		+ "line-height:1.3;"">" + ar_ПодтверждениеПредставление.ЭкранироватьHTML(СокрЛП(Заголовок))
		+ "</td></tr>");
	Для Каждого Блок Из Блоки Цикл
		Если Не ПустаяСтрока(Блок) Тогда
			Строки.Добавить("<tr><td style=""padding:0 28px 14px 28px;font-size:14px;line-height:1.55;"">"
				+ Блок + "</td></tr>");
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("<tr><td style=""padding:14px 28px;border-top:1px solid #d8dee4;font-size:12px;"
		+ "line-height:1.5;color:#57606a;"">" + ar_ПодтверждениеПредставление.ЭкранироватьHTML(Подвал)
		+ "</td></tr>");
	Строки.Добавить("</table></td></tr></table></body></html>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Подвал письма, на которое отвечают в диалоге 1С.
//
// Возвращаемое значение:
//  Строка - текст подвала.
//
Функция ПодвалПисьмаСДиалогом()

	Возврат НСтр("ru = 'Письмо отправлено автоматически. Ответить можно в диалоге в 1С.';
		|en = 'This message was sent automatically. You can reply in the dialog in 1C.'");

КонецФункции

// Добавляет поле «имя - значение» в массив полей письма (ТаблицаПолейПисьмаHTML).
//
// Параметры:
//  Поля     - Массив из Структура - поля письма (дополняется).
//  Имя      - Строка - подпись поля.
//  Значение - Строка - значение поля.
//
Процедура ДобавитьПолеПисьма(Поля, Знач Имя, Знач Значение)

	Поля.Добавить(Новый Структура("Имя, Значение", Имя, Строка(Значение)));

КонецПроцедуры

// Таблица полей письма: подпись серым слева, значение справа (переносы строк
// значения сохраняются). Текст экранируется.
//
// Параметры:
//  Поля - Массив из Структура - поля письма:
//   * Имя      - Строка - подпись поля.
//   * Значение - Строка - значение поля.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML; полей нет - пустая строка.
//
Функция ТаблицаПолейПисьмаHTML(Знач Поля)

	Если Поля.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table role=""presentation"" width=""100%"" cellpadding=""0"" cellspacing=""0"">");
	Для Каждого Поле Из Поля Цикл
		Строки.Добавить("<tr><td style=""padding:4px 12px 4px 0;font-size:13px;color:#57606a;"
			+ "vertical-align:top;white-space:nowrap;width:1%;"">"
			+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(Поле.Имя)
			+ "</td><td style=""padding:4px 0;font-size:14px;vertical-align:top;"">"
			+ ТекстСПереносамиHTML(Поле.Значение) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Блок текста с подписью: подпись серым мелким шрифтом, под ней текст (переносы
// строк сохраняются); с цветом - текст в рамке с полосой этого цвета слева.
// Текст экранируется.
//
// Параметры:
//  Подпись - Строка - подпись блока.
//  Текст   - Строка - текст блока.
//  Цвет    - Строка - цвет полосы слева; "" - без рамки.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
Функция БлокСПодписьюHTML(Знач Подпись, Знач Текст, Знач Цвет)

	СтильТекста = "font-size:14px;line-height:1.55;";
	Если Не ПустаяСтрока(Цвет) Тогда
		СтильТекста = СтильТекста + "padding:8px 12px;background:#f6f8fa;border-left:3px solid " + Цвет
			+ ";border-radius:0 4px 4px 0;";
	КонецЕсли;

	Возврат "<div style=""margin:0 0 4px 0;font-size:12px;color:#57606a;"">"
		+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(Подпись) + "</div>"
		+ "<div style=""" + СтильТекста + """>" + ТекстСПереносамиHTML(Текст) + "</div>";

КонецФункции

// Экранированный текст с переносами строк в виде <br />.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
Функция ТекстСПереносамиHTML(Знач Текст)

	Возврат СтрЗаменить(ar_ПодтверждениеПредставление.ЭкранироватьHTML(СокрЛП(Текст)),
		Символы.ПС, "<br />");

КонецФункции

// HTML письма по диалогу пакета (КарточкаПисьмаHTML): цвет полосы по виду
// письма, тема заголовком, текст сообщения (АбзацыПисьмаHTML), ссылка на диалог
// текстом для копирования (БлокСсылкиНаДиалогHTML) и таблица ссылок на предмет
// (если заполнен и существует) и дополнительные объекты оформления.
//
// Параметры:
//  Тема         - Строка - тема письма (заголовок карточки).
//  Текст        - Строка - текст сообщения диалога.
//  Диалог       - СправочникСсылка.ar_Диалоги - диалог письма.
//  ШапкаДиалога - Структура - результат ar_ДиалогиСервер.ШапкаДиалога (Предмет).
//  Оформление   - Структура, Неопределено - см. ОтправитьПисьмоПоДиалогу.
//
// Возвращаемое значение:
//  Строка - HTML письма.
//
Функция ТекстПисьмаПоДиалогуHTML(Знач Тема, Знач Текст, Знач Диалог, Знач ШапкаДиалога, Знач Оформление)

	ВидПисьма = "";
	ДополнительныеСсылки = Неопределено;
	Если ТипЗнч(Оформление) = Тип("Структура") Тогда
		Оформление.Свойство("Вид", ВидПисьма);
		Оформление.Свойство("Ссылки", ДополнительныеСсылки);
	КонецЕсли;
	Цвет = ЦветВидаПисьма(ВидПисьма);

	Ссылки = Новый Массив;
	Если ЗначениеЗаполнено(ШапкаДиалога.Предмет)
		И ОбщегоНазначения.СсылкаСуществует(ШапкаДиалога.Предмет) Тогда
		Ссылки.Добавить(Новый Структура("Представление, Ссылка",
			Строка(ШапкаДиалога.Предмет), ШапкаДиалога.Предмет));
	КонецЕсли;
	Если ТипЗнч(ДополнительныеСсылки) = Тип("Массив") Тогда
		Для Каждого ОписаниеСсылки Из ДополнительныеСсылки Цикл
			Если ТипЗнч(ОписаниеСсылки) = Тип("Структура")
				И ОписаниеСсылки.Свойство("Представление")
				И ОписаниеСсылки.Свойство("Ссылка")
				И ЗначениеЗаполнено(ОписаниеСсылки.Ссылка) Тогда
				Ссылки.Добавить(ОписаниеСсылки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Блоки = Новый Массив;
	Блоки.Добавить(АбзацыПисьмаHTML(Текст));
	Блоки.Добавить(БлокСсылкиНаДиалогHTML(Диалог));
	Блоки.Добавить(БлокСсылокПисьмаHTML(Ссылки, Цвет, Ложь, ""));

	Возврат КарточкаПисьмаHTML(Тема, Цвет, Блоки, ПодвалПисьмаСДиалогом());

КонецФункции

// Цвет полосы карточки письма по виду письма (см. ОтправитьПисьмоПоДиалогу).
//
// Параметры:
//  ВидПисьма - Строка, Неопределено - "успех" / "внимание" / "ошибка".
//
// Возвращаемое значение:
//  Строка - цвет CSS.
//
Функция ЦветВидаПисьма(Знач ВидПисьма)

	Если ВидПисьма = "успех" Тогда
		Цвет = "#1a7f37";
	ИначеЕсли ВидПисьма = "внимание" Тогда
		Цвет = "#bf8700";
	ИначеЕсли ВидПисьма = "ошибка" Тогда
		Цвет = "#cf222e";
	Иначе
		Цвет = "#0969da";
	КонецЕсли;

	Возврат Цвет;

КонецФункции

// Абзацы текста сообщения в HTML. Строки подряд соединяются в один абзац
// (переносы строк внутри НСтр пакетов - не конец мысли), пустая строка
// закрывает абзац, строка «N. ...» - отдельный пункт замечаний с полосой слева.
// Текст экранируется.
//
// Параметры:
//  Текст - Строка - текст сообщения диалога.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
Функция АбзацыПисьмаHTML(Знач Текст)

	Фрагменты = Новый Массив;
	Абзац = Новый Массив;
	Для Каждого Подстрока Из СтрРазделить(Строка(Текст), Символы.ПС, Истина) Цикл
		СтрокаТекста = СокрЛП(Подстрока);
		Если ПустаяСтрока(СтрокаТекста) Тогда
			ДобавитьАбзацПисьмаHTML(Фрагменты, Абзац);
		ИначеЕсли ЭтоПунктСпискаПисьма(СтрокаТекста) Тогда
			ДобавитьАбзацПисьмаHTML(Фрагменты, Абзац);
			Фрагменты.Добавить("<div style=""margin:0 0 6px 0;padding:6px 10px;background:#f6f8fa;"
				+ "border-left:3px solid #d0d7de;border-radius:0 4px 4px 0;"">"
				+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(СтрокаТекста) + "</div>");
		Иначе
			Абзац.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;
	ДобавитьАбзацПисьмаHTML(Фрагменты, Абзац);

	Возврат СтрСоединить(Фрагменты, Символы.ПС);

КонецФункции

// Добавляет накопленные строки абзаца во фрагменты HTML и очищает абзац.
//
// Параметры:
//  Фрагменты - Массив из Строка - фрагменты HTML (дополняется).
//  Абзац     - Массив из Строка - строки текущего абзаца (очищается).
//
Процедура ДобавитьАбзацПисьмаHTML(Фрагменты, Абзац)

	Если Абзац.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Фрагменты.Добавить("<p style=""margin:0 0 10px 0;"">"
		+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(СтрСоединить(Абзац, " ")) + "</p>");
	Абзац.Очистить();

КонецПроцедуры

// Строка - пункт нумерованного списка вида «N. текст» (номер до трёх цифр).
//
// Параметры:
//  СтрокаТекста - Строка - строка текста без ведущих пробелов.
//
// Возвращаемое значение:
//  Булево - Истина, если строка начинается с номера пункта и точки с пробелом.
//
Функция ЭтоПунктСпискаПисьма(Знач СтрокаТекста)

	Позиция = СтрНайти(СтрокаТекста, ". ");
	Возврат Позиция > 1 И Позиция <= 4
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(СтрокаТекста, Позиция - 1));

КонецФункции

// Ссылка на диалог в письме: навигационная ссылка текстом (без кнопки
// «Открыть») в рамке и подсказка «скопируйте, Shift+F11, вставьте». Кнопка
// «Скопировать» в письме невозможна - почтовые клиенты не выполняют скрипты;
// вместо неё user-select:all - в клиентах, которые поддерживают стиль, щелчок
// выделяет ссылку целиком.
//
// Параметры:
//  Диалог - СправочникСсылка.ar_Диалоги - диалог письма.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
Функция БлокСсылкиНаДиалогHTML(Знач Диалог)

	Строки = Новый Массив;
	Строки.Добавить("<div style=""margin:0 0 4px 0;font-size:12px;color:#57606a;"">"
		+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(
			НСтр("ru = 'Ссылка на диалог'; en = 'Link to the dialog'")) + "</div>");
	Строки.Добавить("<div style=""padding:8px 10px;background:#f6f8fa;border:1px solid #d0d7de;"
		+ "border-radius:6px;font-family:Consolas,'Courier New',monospace;font-size:13px;color:#1f2328;"
		+ "word-break:break-all;user-select:all;-webkit-user-select:all;"">"
		+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(ПолучитьНавигационнуюСсылку(Диалог)) + "</div>");
	Строки.Добавить("<div style=""margin:4px 0 0 0;font-size:12px;color:#57606a;"">"
		+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(
			НСтр("ru = 'Скопируйте ссылку, в 1С нажмите Shift+F11 и вставьте её.';
			|en = 'Copy the link, press Shift+F11 in 1C and paste it.'")) + "</div>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Таблица ссылок письма: строка на объект - представление и кнопка «Открыть»
// (адрес публикации ИБ в локальной сети задан: <публикация>/#<навссылка>) либо
// навигационная ссылка текстом (адрес не задан - предупреждение
// notify_publication_address_empty в лог, одна запись на письмо).
//
// Параметры:
//  Ссылки - Массив из Структура - объекты блока ссылок:
//   * Представление - Строка - подпись строки таблицы.
//   * Ссылка        - ЛюбаяСсылка, КлючЗаписиРегистраСведений, Строка - объект для
//                     навигационной ссылки или готовая навигационная ссылка.
//  Цвет   - Строка - цвет кнопок (цвет вида письма).
//  ПодсказкаБезПубликации - Булево - при незаданном адресе публикации добавить
//                     под таблицей подсказку Shift+F11 (Ложь - она уже есть в
//                     блоке ссылки на диалог).
//  RunId  - Строка - идентификатор запуска для записи лога ("" - без запуска).
//
// Возвращаемое значение:
//  Строка - фрагмент HTML; ссылок нет - пустая строка.
//
Функция БлокСсылокПисьмаHTML(Знач Ссылки, Знач Цвет, Знач ПодсказкаБезПубликации, Знач RunId)

	Если Ссылки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	АдресПубликации = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	ЕстьПубликация = ТипЗнч(АдресПубликации) = Тип("Строка") И Не ПустаяСтрока(АдресПубликации);
	Если ЕстьПубликация Тогда
		// Веб-клиент открывает ссылку вида <публикация>/#e1cib/data/...
		Если СтрЗаканчиваетсяНа(АдресПубликации, "/") Тогда
			АдресПубликации = Лев(АдресПубликации, СтрДлина(АдресПубликации) - 1);
		КонецЕсли;
	Иначе
		ar_СлужебныйЛог.Записать("ar_Уведомления.БлокСсылокПисьмаHTML",
			"notify_publication_address_empty",
			"Адрес публикации ИБ не задан - в письме навигационные ссылки текстом",
			"Предупреждение", RunId);
	КонецЕсли;

	СтильЯчейки = "padding:9px 0;border-top:1px solid #eaeef2;font-size:14px;vertical-align:middle;";
	Строки = Новый Массив;
	Строки.Добавить("<table role=""presentation"" width=""100%"" cellpadding=""0"" cellspacing=""0"">");
	Для Каждого ОписаниеСсылки Из Ссылки Цикл
		Если ТипЗнч(ОписаниеСсылки.Ссылка) = Тип("Строка") Тогда
			НавигационнаяСсылка = ОписаниеСсылки.Ссылка;
		Иначе
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ОписаниеСсылки.Ссылка);
		КонецЕсли;
		Если ЕстьПубликация Тогда
			ЯчейкаСсылки = "<a href=""" + ar_ПодтверждениеПредставление.ЭкранироватьHTML(
				АдресПубликации + "/#" + НавигационнаяСсылка) + """ style=""display:inline-block;"
				+ "padding:7px 16px;background:" + Цвет + ";color:#ffffff;text-decoration:none;"
				+ "border-radius:6px;font-size:13px;font-weight:600;white-space:nowrap;"">"
				+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(НСтр("ru = 'Открыть'; en = 'Open'"))
				+ "</a>";
		Иначе
			ЯчейкаСсылки = "<span style=""font-family:Consolas,'Courier New',monospace;font-size:12px;"
				+ "color:#57606a;word-break:break-all;"">"
				+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(НавигационнаяСсылка) + "</span>";
		КонецЕсли;
		Строки.Добавить("<tr><td style=""" + СтильЯчейки + "padding-right:12px;"">"
			+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(ОписаниеСсылки.Представление)
			+ "</td><td align=""right"" style=""" + СтильЯчейки + """>" + ЯчейкаСсылки + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");
	Если Не ЕстьПубликация И ПодсказкаБезПубликации Тогда
		Строки.Добавить("<div style=""margin:4px 0 0 0;font-size:12px;color:#57606a;"">"
			+ ar_ПодтверждениеПредставление.ЭкранироватьHTML(
				НСтр("ru = 'Скопируйте ссылку, в 1С нажмите Shift+F11 и вставьте её.';
				|en = 'Copy the link, press Shift+F11 in 1C and paste it.'")) + "</div>");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Отправить письмо о вопросе (Вариант Б - прямой БСП API, как ОтправитьEmail).
// Письмо - HTML-карточка (ТекстПисьмаОВопросеHTML): вопрос, подсказка, варианты,
// «ответить до», предмет, ссылка на диалог текстом, кнопки на запуск и предмет
// (без адреса публикации - навигационные ссылки текстом).
// agentrunner-71: письмо - запись в служебном логе (ЗаписатьПисьмоВЛог):
// успех - notify_sent, ошибки - прежние коды с темой, адресатами и текстом.
//
// Параметры:
//  ДанныеЗаписи  - Структура - запись очереди вопроса (RunId, ActionPayloadJSON)
//                  - результат ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно.
//  ДиалогВопроса - СправочникСсылка.ar_Диалоги - диалог вопроса.
//  Адресаты      - Массив из Структура {Email, Представление}.
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка}.
//
Функция ОтправитьПисьмоОВопросе(Знач ДанныеЗаписи, Знач ДиалогВопроса, Знач Адресаты)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "send_failed");

	// Письмо, отклонённые получатели и строка учётной записи объявлены до
	// Попытки: в катче видно, собрано ли письмо и какая запись выбиралась
	// (как в ОтправитьEmail). Повод письма всегда input_pending, RunId - из записи.
	Письмо = Неопределено;
	ОшибочныеПолучатели = Новый Массив;
	ОписаниеУчетнойЗаписи = "";

	Попытка

		Если Метаданные.ОбщиеМодули.Найти("РаботаСПочтовымиСообщениями") = Неопределено Тогда
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_no_mail_subsystem",
				"Ошибка", ДанныеЗаписи.RunId, "input_pending",
				"Подсистема БСП электронной почты не подключена - письмо о вопросе не отправлено",
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		ВыборЗаписи = УчетнаяЗаписьДляУведомлений();
		Если Не ЗначениеЗаполнено(ВыборЗаписи.Ссылка) Тогда
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_no_email_account",
				"Ошибка", ДанныеЗаписи.RunId, "input_pending",
				СтрШаблон("Нет настроенной учётной записи для системных уведомлений "
					+ "(RunId=%1, повод=input_pending) - письмо НЕ отправлено", ДанныеЗаписи.RunId),
				Неопределено, Адресаты, ОшибочныеПолучатели, "");
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		ОписаниеУчетнойЗаписи = СтрокаУчетнойЗаписиЛога(ВыборЗаписи.Ссылка,
			ВыборЗаписи.Адрес, ВыборЗаписи.Источник);

		ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(ДиалогВопроса);
		ДанныеВопроса = ДанныеВопросаИзPayload(ДанныеЗаписи.ActionPayloadJSON);
		ТекстHTML = ТекстПисьмаОВопросеHTML(ДанныеВопроса, ДиалогВопроса, ДанныеЗаписи.RunId, ШапкаДиалога);

		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Отправитель = ВыборЗаписи.Адрес;
		Письмо.ИмяОтправителя = "AgentRunner";
		// agentrunner-51: тема по общей схеме (повод, агент, предмет, RunId) -
		// как в общем пути ОтправитьEmail.
		Письмо.Тема = ТемаПисьма(ПредставлениеПовода("input_pending"),
			Строка(ШапкаДиалога.Агент), ШапкаДиалога.ПредставлениеПредмета, ДанныеЗаписи.RunId);

		Письмо.Тексты.Добавить(ТекстHTML, ТипТекстаПочтовогоСообщения.HTML);

		Для Каждого Адресат Из Адресаты Цикл
			Письмо.Получатели.Добавить(Адресат.Email, Адресат.Представление);
		КонецЦикла;

		// agentrunner-85: отправка с явно заданной записью - в привилегированном
		// режиме (читаются реквизиты записи под RLS, владелец записи может
		// отличаться от пользователя фонового задания; как в ОтправитьEmail).
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ВыборЗаписи.Ссылка, Письмо);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		ОшибочныеПолучатели = ОтклоненныеПолучателиИзРезультата(РезультатSMTP);

		Если ОшибочныеПолучатели.Количество() = Адресаты.Количество() Тогда
			// Все получатели отклонены сервером - это тоже неуспех отправки.
			ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_all_recipients_rejected",
				"Ошибка", ДанныеЗаписи.RunId, "input_pending", "", Письмо, Адресаты,
				ОшибочныеПолучатели, "SMTP отклонил всех получателей", ОписаниеУчетнойЗаписи);
			Результат.Причина = "send_failed";
			Возврат Результат;
		КонецЕсли;

		// agentrunner-71: успешная отправка - запись notify_sent; отклонена
		// часть получателей - Предупреждение.
		УровеньЗаписи = ?(ОшибочныеПолучатели.Количество() > 0, "Предупреждение", "Информация");
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_sent",
			УровеньЗаписи, ДанныеЗаписи.RunId, "input_pending", "", Письмо, Адресаты,
			ОшибочныеПолучатели, "", ОписаниеУчетнойЗаписи);

		Результат.Отправлено = Истина;
		Результат.Причина = "ok";
		Возврат Результат;

	Исключение
		// D11: маскировка секрета SMTP в тексте исключения.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьПисьмоВЛог("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_send_failed",
			"Ошибка", ДанныеЗаписи.RunId, "input_pending",
			СтрШаблон("Не удалось отправить письмо о вопросе (RunId=%1): %2",
				ДанныеЗаписи.RunId, ТекстОшибки),
			Письмо, Адресаты, ОшибочныеПолучатели, ТекстОшибки, ОписаниеУчетнойЗаписи);
		Результат.Причина = "send_failed";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Текст, подсказка и варианты вопроса из ActionPayloadJSON (как в ar_Подтверждение).
//
Функция ДанныеВопросаИзPayload(Знач ActionPayloadJSON)

	Результат = Новый Структура("Текст, Подсказка, Варианты", "", "", "");

	Попытка
		Payload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = Payload.Получить("question");
	Если ТипЗнч(Текст) = Тип("Строка") Тогда
		Результат.Текст = Текст;
	КонецЕсли;

	Подсказка = Payload.Получить("hint");
	Если ТипЗнч(Подсказка) = Тип("Строка") Тогда
		Результат.Подсказка = Подсказка;
	КонецЕсли;

	Варианты = Payload.Получить("choices");
	Если ТипЗнч(Варианты) = Тип("Массив") И Варианты.Количество() > 0 Тогда
		Представления = Новый Массив;
		Для Каждого Вариант Из Варианты Цикл
			Представления.Добавить("«" + СокрЛП(Строка(Вариант)) + "»");
		КонецЦикла;
		Результат.Варианты = СтрСоединить(Представления, ", ");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
