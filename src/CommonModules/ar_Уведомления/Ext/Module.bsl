////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Уведомления (CONS-12: единая точка уведомлений об эскалации).
//
// Единственная публичная точка - Уведомить(RunId, ТипСобытия) - вызывается
// ровно из трёх мест (см. DoD D2, .docs/specs/CONS-12.md):
//  1. ar_Надзор.ЗафиксироватьЭскалацию               -> "escalation"
//  2. ar_Подтверждение.Поставить                          -> "approval_pending"
//  3. ar_RuntimeЦикл.ЗапланироватьТехповторЕслиНужно  -> "retry_exhausted"
// Успешное завершение (Completed) и промежуточные ошибки (Failed с
// оставшимися повторами) - молча, без вызова этой функции вовсе.
//
// ТипСобытия здесь - локальная строковая классификация ("escalation" /
// "approval_pending" / "retry_exhausted"), НЕ Перечисление.ar_ТипСобытия
// аудита (см. «Контракт функции» спеки).
//
// РЕШЕНИЕ ПОЛЬЗОВАТЕЛЯ (зафиксировано в .docs/specs/CONS-12.md, «Реализация»):
// email отправляется РЕАЛЬНО и СИНХРОННО внутри вызова Уведомить - Вариант Б
// из спеки: прямой вызов БСП РаботаСПочтовымиСообщениями.ОтправитьПисьмо,
// без создания документа Взаимодействия.ЭлектронноеПисьмоИсходящее. Это
// сознательный отказ от переиспользования ar_ИнструментыКоммуникации: тот модуль
// (ИсполнитьПодготовкуПисьма/ИсполнитьПодготовкуПисьмаНапоминания) вызывает
// Взаимодействия.СоздатьПисьмо(..., ОтправитьСразу=Ложь) - создаёт только
// черновик, который реально уходит лишь регламентным заданием БСП
// ПолучениеИОтправкаЭлектронныхПисем или интерактивной отправкой оператором.
// Для системного уведомления об эскалации такая задержка недопустима (DoD D7
// требует, чтобы письмо не оставалось черновиком). Если учётная запись
// электронной почты не настроена (или отправка иначе не удалась) - функция
// НЕ делает вид, что письмо ушло: пишет явную ошибку в ar_СлужебныйЛог с
// прямым указанием причины и возвращает Отправлено=Ложь. Молчаливого
// проглатывания эскалации нет.
//
// Цепочка адресатов (см. «Реализация», п.1) - первый непустой результат:
//  1. ТЧ ar_Ответственные профиля запуска (ar_ПрофилиЗапуска.Ответственные).
//  2. ar_Агенты.ar_Пользователь (если профиль пуст/без строк).
//  3. Администраторы (ПолныеПрава) + Предупреждение в ar_СлужебныйЛог о
//     «беспризорном» агенте (ни профиля, ни ar_Пользователь).
// Каждый email разыменовывается через КИ (УправлениеКонтактнойИнформацией),
// тот же вызов, что уже использует ar_ИнструментыКоммуникации.EmailКонтрагента.
//
// Канал - только Email реализован. Оповещение1С/Задача/Telegram возвращают
// честную заглушку {status: "not_implemented"} и пишут Предупреждение в
// ar_СлужебныйЛог - без попытки создать документ/оповещение/задачу (см. DoD D6).
//
// Дедупликация (см. «Реализация», п.4) - по RunId + повод (ТипСобытия),
// маркер - новое значение Перечисление.ar_ТипСобытия.NotificationSent с
// payload {reason: "escalation"|"approval_pending"|"retry_exhausted"}.
// Гонка TOCTOU (два параллельных прохода одновременно решают отправить)
// закрывается тем же приёмом, что уже применяет ar_AuditСобытия.ЗаписатьСобытие
// для этого же регистра: БлокировкаДанных по РегистрСведений.ar_СобытияЗапуска
// с измерением ar_RunId внутри ЯВНОЙ транзакции, охватывающей проверку
// дедупликации + резервирующую запись NotificationSent. Блокировка 1С по
// одному и тому же ключу реентерабельна в пределах одной транзакции/сеанса -
// вложенный вызов ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно
// (который сам блокирует тот же регистр по тому же RunId при физической
// записи NotificationSent) не создаёт взаимоблокировку. Второй параллельный
// вызов Уведомить для того же RunId+повода ждёт снятия блокировки первым,
// затем видит уже записанный NotificationSent и не отправляет письмо
// повторно (idempotent no-op) - см. DoD D8.
//
// SMTP - защита от зависания (см. «Риски» спеки, «SMTP - внешний синхронный
// вызов»): платформенного асинхронного API отправки почты не найдено;
// ограничение таймаута фактически задаётся в настройках самой учётной
// записи (Справочник.УчетныеЗаписиЭлектроннойПочты, профиль SMTP -
// параметр ТаймаутОжидания).
//
// Учётная запись для отправки - УчетнаяЗаписьДляУведомлений(): в конфигурациях
// с подсистемой Взаимодействий - запись по умолчанию (модуль УправлениеЭлектроннойПочтой
// берётся через ОбщегоНазначения.ОбщийМодуль - в БП подсистемы и модуля нет),
// в БП - из ДоступныеУчетныеЗаписи для отправки (системная запись в приоритете).
// Модуль не блокирует общий путь навечно -
// вся сетевая часть обёрнута в Попытка/Исключение (см. D9) и оборачивается
// только вокруг ОДНОГО вызова ОтправитьПисьмо; при недоступности SMTP
// платформа сама вернёт исключение по таймауту профиля, тот же принцип,
// что уже действует для любой другой синхронной отправки почты в БСП.
// Решение НЕ переносить отправку в фоновое задание объясняется в
// .docs/specs/CONS-12.md, «Реализация» (обоснование: письмо равнозначно
// самой эскалации/approval-уведомлению, задержка в очереди фонового задания
// противоречила бы цели «эскалация доходит письмом сейчас же»; риск
// зависания синхронного вызова смягчается таймаутом профиля SMTP учётной
// записи и тройной защитой Попытка/Исключение по образцу
// ar_Надзор.ПроверитьДостижениеЦели).
//
// БЕЗОПАСНОСТЬ (D9, тот же принцип, что и ar_Надзор/ar_RuntimeЦикл): любая
// ошибка внутри Уведомить (недоступность SMTP, отсутствие учётной записи,
// сбой БСП-вызова, сбой чтения адресатов) перехватывается ВНУТРИ модуля и
// НЕ пробрасывается наружу - ни один из трёх вызывающих путей не должен
// упасть или изменить свой основной результат из-за сбоя уведомления.
//
// D10: функция не обращается к ar_Подтверждение (не ставит и не читает очередь
// подтверждений) - уведомление системы идёт в обход approval, это сообщение
// runtime, а не действие агента.
//
// D11: текст любой ошибки перед записью в ar_СлужебныйЛог прогоняется через
// ar_Утилиты.МаскироватьСекреты - на случай, если исключение БСП/платформы
// от SMTP-подключения содержит логин/пароль/токен учётной записи в тексте.
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь (AUD-06 -
// расширениям запрещён Privileged=true в общих модулях). Привилегии
// поднимаются точечно там, где это уже принято в проекте: чтение
// ar_СобытияЗапуска для дедупликации и запись NotificationSent (через
// ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно) - т.к. функция
// вызывается в том числе из регламентного задания (ar_RuntimeЦикл), где нет
// гарантии интерактивного пользователя с ролью на audit-регистры. Сама
// отправка письма выполняется в правах текущего сеанса (не привилегированно) -
// БСП УправлениеЭлектроннойПочтой/РаботаСПочтовымиСообщениями сами поднимают
// привилегии там, где это нужно им.
//
// Запрещено: Выполнить(), Вычислить().
//
// См. спеку: .docs/specs/CONS-12.md, План-консоль-автономных-агентов.md §3Б.4.
////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Единая точка уведомления об эскалации/approval-действии/исчерпанных
// повторах. Читает весь необходимый контекст сама по RunId - принимает
// только RunId и повод (см. doc-комментарий модуля, «Контракт функции»).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска. Обязателен.
//  ТипСобытия - Строка - один из трёх поводов:
//               "escalation" / "approval_pending" / "retry_exhausted".
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Канал: Строка, Причина: Строка}.
//  Отправлено=Истина только при реальной успешной синхронной отправке
//  письма. Причина - код диагностики ("ok" / "not_implemented" /
//  "duplicate" / "no_recipients" / "no_email_account" / "send_failed" /
//  "internal_error" / "invalid_arguments"). Вызывающий код НЕ обязан
//  анализировать результат - используется только для диагностики/тестов.
//
// Исключения: не пробрасываются (D9) - любая ошибка внутри перехватывается,
//  фиксируется в ar_СлужебныйЛог уровня "Ошибка", функция возвращает
//  Отправлено=Ложь.
//
Функция Уведомить(Знач RunId, Знач ТипСобытия) Экспорт

	Результат = Новый Структура("Отправлено, Канал, Причина", Ложь, "", "internal_error");

	Попытка

		Если ТипЗнч(RunId) <> Тип("Строка") Или ПустаяСтрока(RunId) Тогда
			Результат.Причина = "invalid_arguments";
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_bad_args",
				"RunId пуст или не строка", "Ошибка");
			Возврат Результат;
		КонецЕсли;

		Если ТипЗнч(ТипСобытия) <> Тип("Строка") Или ПустаяСтрока(ТипСобытия) Тогда
			Результат.Причина = "invalid_arguments";
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_bad_args",
				"ТипСобытия пуст или не строка (RunId=" + RunId + ")", "Ошибка", RunId);
			Возврат Результат;
		КонецЕсли;

		Возврат УведомитьВнутр(СокрЛП(RunId), СокрЛП(ТипСобытия));

	Исключение
		// Последний защитный барьер (D9): даже неожиданная ошибка внутри
		// самой обвязки не должна пробрасываться в ar_Надзор/ar_Подтверждение/
		// ar_RuntimeЦикл - тот же принцип, что ar_Надзор.ПроверитьДостижениеЦели.
		// Сам катч тоже не имеет права выбросить исключение: и МаскироватьСекреты,
		// и запись в ar_СлужебныйЛог - внешние вызовы, способные упасть (недоступна
		// таблица лога, неожиданный тип в тексте ошибки). Без этих вложенных
		// Попытка исключение улетело бы в ar_Надзор/ar_Подтверждение/ar_RuntimeЦикл,
		// где вызов Уведомить намеренно стоит без обёртки. Эталон - ar_Надзор.
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Уведомления.Уведомить", "notify_internal_error",
				ТекстОшибки, "Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Notifications.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Уведомления: не удалось записать notify_internal_error в ar_СлужебныйЛог");
		КонецПопытки;

		Результат.Причина = "internal_error";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Уведомить участников диалога о вопросе агента (agentrunner-26 п.10, повод
// "input_pending"). Вызывается из ar_ИнструментыВзаимодействие ПОСЛЕ фиксации
// транзакции вопроса. Адресаты - все участники диалога с заполненным адресом
// почты, одним письмом. Сбой отправки или отсутствие адресов вопрос не отменяет
// (перехвачено, запись в ar_СлужебныйЛог). Повтор по тому же вопросу отсекается
// резервом отправки (ключ дополняется идентификатором вопроса).
//
// Параметры:
//  ИдентификаторВопроса - Строка - ApprovalId записи очереди (awaiting_input).
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка} - только для диагностики.
//
Функция УведомитьОВопросе(Знач ИдентификаторВопроса) Экспорт

	Результат = Новый Структура("Отправлено, Причина", Ложь, "internal_error");

	Если ТипЗнч(ИдентификаторВопроса) <> Тип("Строка") Или ПустаяСтрока(ИдентификаторВопроса) Тогда
		Результат.Причина = "invalid_arguments";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Возврат УведомитьОВопросеВнутр(СокрЛП(ИдентификаторВопроса));
	Исключение
		// D9: сбой уведомления не должен ломать постановку вопроса.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьОВопросе", "notify_question_failed",
			СтрШаблон("ApprovalId=%1: %2", ИдентификаторВопроса, ТекстОшибки), "Ошибка");
		Результат.Причина = "internal_error";
		Возврат Результат;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика Уведомить - вынесена из внешней Попытка/Исключение
// (см. doc-комментарий Уведомить).
//
Функция УведомитьВнутр(Знач RunId, Знач ТипСобытия)

	Результат = Новый Структура("Отправлено, Канал, Причина", Ложь, "Email", "");

	// 1. Дедупликация - до любой дорогой работы (чтение адресатов, КИ, SMTP).
	Если ЗарезервироватьОтправкуЕслиНеБыло(RunId, ТипСобытия) = Ложь Тогда
		Результат.Причина = "duplicate";
		Возврат Результат;
	КонецЕсли;

	// 2. Канал - только Email реализован (D6).
	Канал = ОпределитьКанал();
	Результат.Канал = Канал;
	Если Канал <> "Email" Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьВнутр", "notify_channel_not_implemented",
			СтрШаблон("Канал ""%1"" не реализован (RunId=%2, повод=%3)", Канал, RunId, ТипСобытия),
			"Предупреждение", RunId);
		Результат.Причина = "not_implemented";
		Возврат Результат;
	КонецЕсли;

	// 3. Цепочка адресатов.
	Адресаты = ОпределитьАдресатов(RunId);
	Если Адресаты.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьВнутр", "notify_no_recipients",
			СтрШаблон("Нет ни одного адресата с email для уведомления (RunId=%1, повод=%2)",
				RunId, ТипСобытия), "Ошибка", RunId);
		Результат.Причина = "no_recipients";
		Возврат Результат;
	КонецЕсли;

	// 4. Реальная синхронная отправка (Вариант Б - см. doc-комментарий модуля).
	ИтогОтправки = ОтправитьEmail(RunId, ТипСобытия, Адресаты);
	Результат.Отправлено = ИтогОтправки.Отправлено;
	Результат.Причина = ИтогОтправки.Причина;

	Возврат Результат;

КонецФункции

// Определить канал уведомления. Единственная реализованная ветка - Email
// (см. doc-комментарий модуля, «Канал»); входные условия задачи не дают
// профилю настраиваемого канала - решение зафиксировано на этапе анализа.
//
// Возвращаемое значение:
//  Строка - имя значения Перечисление.ar_КаналУведомления ("Email" и т.п.).
//
Функция ОпределитьКанал()

	Возврат "Email";

КонецФункции

// Цепочка адресатов (см. doc-комментарий модуля). Останавливается на первом
// непустом результате. Каждый адресат - Структура {Email, Представление}.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Массив из Структура {Email: Строка, Представление: Строка} - без дублей
//  по Email, только непустые адреса.
//
Функция ОпределитьАдресатов(Знач RunId)

	ШапкаЗапуска = ПрочитатьШапкуЗапуска(RunId);

	// Звено 1: ТЧ ar_Ответственные профиля запуска.
	Если ШапкаЗапуска.Профиль <> Неопределено И ЗначениеЗаполнено(ШапкаЗапуска.Профиль) Тогда
		Ответственные = ar_ПрофилиЗапуска.Ответственные(ШапкаЗапуска.Профиль);
		АдресатыПрофиля = АдресатыИзОтветственных(Ответственные);
		Если АдресатыПрофиля.Количество() > 0 Тогда
			Возврат АдресатыПрофиля;
		КонецЕсли;
	КонецЕсли;

	// Звено 2: ar_Агенты.ar_Пользователь.
	Если ШапкаЗапуска.Агент <> Неопределено И ЗначениеЗаполнено(ШапкаЗапуска.Агент) Тогда
		Попытка
			ПользовательАгента = ШапкаЗапуска.Агент.ar_Пользователь;
		Исключение
			ПользовательАгента = Неопределено;
		КонецПопытки;
		Если ПользовательАгента <> Неопределено И ЗначениеЗаполнено(ПользовательАгента) Тогда
			EmailАгента = EmailПользователя(ПользовательАгента);
			Если Не ПустаяСтрока(EmailАгента) Тогда
				АдресатыАгента = Новый Массив;
				АдресатыАгента.Добавить(Новый Структура("Email, Представление",
					EmailАгента, Строка(ПользовательАгента)));
				Возврат АдресатыАгента;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Звено 3: администраторы (беспризорный агент - профиль и ar_Пользователь
	// оба пусты/не дали email). Требование задачи: молча терять эскалацию
	// нельзя - явное предупреждение в ar_СлужебныйЛог.
	ar_СлужебныйЛог.Записать("ar_Уведомления.ОпределитьАдресатов", "notify_orphan_agent",
		СтрШаблон("Агент без профиля/ответственного пользователя с email - уведомление "
			+ "уходит администраторам (RunId=%1, Агент=%2)",
			RunId, ?(ШапкаЗапуска.Агент <> Неопределено, Строка(ШапкаЗапуска.Агент), "<нет>")),
		"Предупреждение", RunId);

	Возврат АдресатыАдминистраторов();

КонецФункции

// Прочитать шапку запуска напрямую из РегистрСведений.ar_Запуски - по образцу
// ar_AuditЗапуски.ПрочитатьОтпечатокШага/ПрочитатьПродолженийСделано (см. спеку,
// «Платформенные API»). agentrunner-51: состав расширен для информативных писем
// (предмет, диалог, статус, время, ошибка, счетчики); прежние поля Агент/Профиль
// сохранены - их читает ОпределитьАдресатов.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - {Найдено: Булево,
//               Агент: СправочникСсылка.ar_Агенты/Неопределено,
//               Профиль: СправочникСсылка.ar_ПрофилиЗапуска/Неопределено,
//               Диалог: СправочникСсылка.ar_Диалоги/Неопределено,
//               Предмет: ОпределяемыйТип.ar_ПрикладнойОбъект/Неопределено,
//               Статус: ПеречислениеСсылка.ar_СтатусЗапуска/Неопределено,
//               СтартовалВ: Дата, ЗавершенВ: Дата,
//               ОтветLLM: Строка, ПопытокВозобновления: Число,
//               ШаговВсего: Число, ПродолженийСделано: Число}.
//  Найдено=Ложь - записи ar_Запуски для RunId не найдено.
//
Функция ПрочитатьШапкуЗапуска(Знач RunId)

	Результат = Новый Структура(
		"Найдено, Агент, Профиль, Диалог, Предмет, Статус, СтартовалВ, ЗавершенВ,
		|ОтветLLM, ПопытокВозобновления, ШаговВсего, ПродолженийСделано",
		Ложь, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		'00010101000000', '00010101000000', "", 0, 0, 0);

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ИдентификаторЗапуска = RunId;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Найдено = Истина;
	Результат.Агент = МенеджерЗаписи.ar_АгентРеф;
	Результат.Профиль = МенеджерЗаписи.ar_ПрофильЗапуска;
	Результат.Диалог = МенеджерЗаписи.ar_Диалог;
	Результат.Предмет = МенеджерЗаписи.ar_Предмет;
	Результат.Статус = МенеджерЗаписи.ar_Статус;
	Результат.СтартовалВ = МенеджерЗаписи.ar_СтартовалВ;
	Результат.ЗавершенВ = МенеджерЗаписи.ar_ЗавершенВ;
	Результат.ОтветLLM = МенеджерЗаписи.ar_ОтветLLM;
	Результат.ПопытокВозобновления = МенеджерЗаписи.ar_ПопытокВозобновления;
	Результат.ШаговВсего = МенеджерЗаписи.ar_ШаговВсего;
	Результат.ПродолженийСделано = МенеджерЗаписи.ar_ПродолженийСделано;

	Возврат Результат;

КонецФункции

// Преобразовать результат ar_ПрофилиЗапуска.Ответственные в список email-
// адресатов - без фильтра по роли (все строки ТЧ уведомляются, см. спеку).
// Email строки, если заполнен, иначе email пользователя из ar_Пользователь.
//
// Параметры:
//  Ответственные - Массив из Структура {Пользователь, Роль, Email}.
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без пустых email, без дублей.
//
Функция АдресатыИзОтветственных(Знач Ответственные)

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	Для Каждого Строка Из Ответственные Цикл

		Email = "";
		Представление = "";

		Если ТипЗнч(Строка.Email) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Строка.Email)) Тогда
			Email = СокрЛП(Строка.Email);
			Представление = Email;
		ИначеЕсли Строка.Пользователь <> Неопределено И ЗначениеЗаполнено(Строка.Пользователь) Тогда
			Email = EmailПользователя(Строка.Пользователь);
			Представление = Строка(Строка.Пользователь);
		Иначе
			// Ни ar_Email строки, ни ar_Пользователь не заполнены - строка ТЧ
			// пропускается ниже проверкой ПустаяСтрока(Email).
			Email = "";
		КонецЕсли;

		Если ПустаяСтрока(Email) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Email] = Неопределено Тогда
			ВидимыеEmail[Email] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Email, Представление));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собрать список email-адресов полноправных пользователей ИБ (звено 3
// цепочки адресатов - «беспризорный» агент). Готовой функции «список
// полноправных» нет ни в БСП, ни в проекте (см. спеку, «Платформенные API») -
// собирается вручную: ПользователиИнформационнойБазы.ПолучитьПользователей()
// + проверка роли ПолныеПрава + Пользователи.НайтиПоИдентификатору для
// получения СправочникСсылка.Пользователи (для последующего чтения КИ).
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без пустых email, без дублей.
//
Функция АдресатыАдминистраторов()

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	РольПолныеПрава = Метаданные.Роли.ПолныеПрава;

	Для Каждого ОписаниеПользователя Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл

		Если Не ОписаниеПользователя.Роли.Содержит(РольПолныеПрава) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			СсылкаПользователя = Пользователи.НайтиПоИдентификатору(
				ОписаниеПользователя.УникальныйИдентификатор);
		Исключение
			Продолжить;
		КонецПопытки;

		Если СсылкаПользователя = Неопределено Или Не ЗначениеЗаполнено(СсылкаПользователя) Тогда
			Продолжить;
		КонецЕсли;

		Email = EmailПользователя(СсылкаПользователя);
		Если ПустаяСтрока(Email) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Email] = Неопределено Тогда
			ВидимыеEmail[Email] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Email, Строка(СсылкаПользователя)));
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.АдресатыАдминистраторов", "notify_no_admin_email",
			"Ни один полноправный пользователь ИБ не имеет заполненного email - "
			+ "уведомление некому отправить", "Ошибка");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает email пользователя через подсистему БСП УправлениеКонтактнойИнформацией -
// тот же вызов, что ar_ИнструментыКоммуникации.EmailКонтрагента (см. спеку,
// «Платформенные API»), применённый к СправочникСсылка.Пользователи.
//
// Параметры:
//  СсылкаПользователя - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Строка - email или "" при отсутствии/ошибке (graceful, не бросает исключений).
//  Экспорт с agentrunner-26: адрес читает ядро диалогов для участников (спека п.9).
//
Функция EmailПользователя(Знач СсылкаПользователя) Экспорт

	Если Метаданные.ОбщиеМодули.Найти("УправлениеКонтактнойИнформацией") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипEmail = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;

	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			СсылкаПользователя, ТипEmail, Неопределено, Ложь);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если Не ПустаяСтрока(Представление) Тогда
			Возврат Представление;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Проверить/зарезервировать право на отправку по RunId+повод (дедупликация,
// D8, см. doc-комментарий модуля про TOCTOU). Явная транзакция с
// БлокировкаДанных по РегистрСведений.ar_СобытияЗапуска.ar_RunId -
// та же гранулярность, что уже использует ar_AuditСобытия.ЗаписатьСобытие
// для этого регистра, поэтому вложенный вызов ЗаписатьСобытиеПривилегированно
// внутри этой транзакции не создаёт взаимоблокировку (реентерабельность
// блокировки в пределах одной транзакции).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод ("escalation"/"approval_pending"/"retry_exhausted"/
//               "input_pending").
//  ИдентификаторВопроса - Строка - необязательно; для "input_pending" ключ
//               дубликации дополняется идентификатором вопроса (спека п.10:
//               повтор по тому же вопросу отсекается, новый вопрос уведомляется).
//
// Возвращаемое значение:
//  Булево - Истина, если резервирование выполнено этим вызовом (можно
//  отправлять письмо); Ложь, если уведомление для RunId+повода (+ вопроса) уже
//  было отправлено ранее (idempotent no-op, письмо отправлять не нужно).
//
Функция ЗарезервироватьОтправкуЕслиНеБыло(Знач RunId, Знач ТипСобытия,
	Знач ИдентификаторВопроса = "")

	Результат = Ложь;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_СобытияЗапуска");
		ЭлементБлокировки.УстановитьЗначение("ar_RunId", RunId);
		Блокировка.Заблокировать();

		Если УжеУведомляли(RunId, ТипСобытия, ИдентификаторВопроса) Тогда
			Результат = Ложь;
		Иначе
			Payload = Новый Структура("reason", ТипСобытия);
			Если Не ПустаяСтрока(ИдентификаторВопроса) Тогда
				Payload.Вставить("approval_id", ИдентификаторВопроса);
			КонецЕсли;
			ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "УведомлениеОтправлено", Payload);
			Результат = Истина;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверить наличие уже записанного NotificationSent для RunId+повод.
// Привилегированное чтение - функция вызывается в т.ч. из регламентного
// задания (ar_RuntimeЦикл), где нет гарантии интерактивного пользователя
// с ролью на ar_СобытияЗапуска (см. doc-комментарий модуля).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод.
//  ИдентификаторВопроса - Строка - необязательно; дополнительно сверяется
//               payload.approval_id (для "input_pending").
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одна запись NotificationSent с
//  payload.reason = ТипСобытия (и, при заданном идентификаторе вопроса, тем же
//  payload.approval_id) уже существует для этого RunId.
//
Функция УжеУведомляли(Знач RunId, Знач ТипСобытия, Знач ИдентификаторВопроса = "")

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("RunId", RunId);
		Запрос.УстановитьПараметр("ТипСобытия", Перечисления.ar_ТипСобытия.УведомлениеОтправлено);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	События.ar_PayloadJSON КАК PayloadJSON
			|ИЗ
			|	РегистрСведений.ar_СобытияЗапуска КАК События
			|ГДЕ
			|	События.ar_RunId = &RunId
			|	И События.ar_ТипСобытия = &ТипСобытия";
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Пока Выборка.Следующий() Цикл
		РазобранныйPayload = ar_JSON.ИзJSON(Выборка.PayloadJSON);
		Если ТипЗнч(РазобранныйPayload) = Тип("Соответствие") Тогда
			Причина = РазобранныйPayload["reason"];
			Если ТипЗнч(Причина) <> Тип("Строка") Или Причина <> ТипСобытия Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(ИдентификаторВопроса) Тогда
				Возврат Истина;
			КонецЕсли;
			ApprovalIdPayload = РазобранныйPayload["approval_id"];
			Если ТипЗнч(ApprovalIdPayload) = Тип("Строка")
				И ApprovalIdPayload = ИдентификаторВопроса Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Учётная запись для отправки системных уведомлений.
//
// В конфигурациях с подсистемой Взаимодействий - запись для отправки
// по умолчанию из УправлениеЭлектроннойПочтой; модуль берётся через
// ОбщегоНазначения.ОбщийМодуль, т.к. прямое имя модуля не компилируется
// в конфигурациях без подсистемы (БП).
// В БП - выбор среди учётных записей, настроенных для отправки: системная,
// если она в списке, иначе первая (ДоступныеУчетныеЗаписи упорядочивает
// системную первой). Подходящих записей нет - Неопределено.
//
// Возвращаемое значение:
//  СправочникСсылка.УчетныеЗаписиЭлектроннойПочты, Неопределено - учётная
//  запись для отправки.
//
Функция УчетнаяЗаписьДляУведомлений()

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Взаимодействия") Тогда
		МодульПочты = ОбщегоНазначения.ОбщийМодуль("УправлениеЭлектроннойПочтой");
		Возврат МодульПочты.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	КонецЕсли;

	Записи = РаботаСПочтовымиСообщениями.ДоступныеУчетныеЗаписи(Истина, , Истина);
	Если Записи.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СистемнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ссылка = СистемнаяЗапись Тогда
			Возврат Запись.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Записи[0].Ссылка;

КонецФункции

// Реально отправить письмо (Вариант Б - прямой БСП API, см. doc-комментарий
// модуля). Ошибка отправки (недоступность SMTP, отсутствие учётной записи)
// не пробрасывается - фиксируется в ar_СлужебныйЛог уровня "Ошибка" (D9).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска (для текста темы/лога).
//  ТипСобытия - Строка - повод (для текста темы/тела письма).
//  Адресаты   - Массив из Структура {Email, Представление}.
//
// Возвращаемое значение:
//  Структура - {Отправлено: Булево, Причина: Строка}.
//
Функция ОтправитьEmail(Знач RunId, Знач ТипСобытия, Знач Адресаты)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "send_failed");

	Попытка

		Если Метаданные.ОбщиеМодули.Найти("РаботаСПочтовымиСообщениями") = Неопределено Тогда
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьEmail", "notify_no_mail_subsystem",
				"Подсистема БСП электронной почты не подключена - уведомление не отправлено",
				"Ошибка", RunId);
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		УчетнаяЗапись = УчетнаяЗаписьДляУведомлений();
		Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			// Требование пользователя: не проглатывать молча - явная ошибка,
			// называющая причину, чтобы администратор увидел проблему.
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьEmail", "notify_no_email_account",
				СтрШаблон("Нет настроенной учётной записи для системных уведомлений "
					+ "(RunId=%1, повод=%2) - письмо НЕ отправлено", RunId, ТипСобытия),
				"Ошибка", RunId);
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Отправитель = СокрЛП(УчетнаяЗапись.АдресЭлектроннойПочты);
		Письмо.ИмяОтправителя = "AgentRunner";

		// agentrunner-51: информативная тема и текст (описание события по
		// поводу, действие оператора, блок ссылок "Перейти в 1С"). Сборка
		// выполняется в Попытке (ТемаИТекстПисьма): при любой ошибке сборки
		// уходит прежний общий шаблон, отправка не прерывается (спека п.5).
		ТемаИТекст = ТемаИТекстПисьма(RunId, ТипСобытия);
		Письмо.Тема = ТемаИТекст.Тема;
		Письмо.Тексты.Добавить(ТемаИТекст.Текст, ТипТекстаПочтовогоСообщения.ПростойТекст);

		Для Каждого Адресат Из Адресаты Цикл
			Письмо.Получатели.Добавить(Адресат.Email, Адресат.Представление);
		КонецЦикла;

		РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);

		Если ТипЗнч(РезультатSMTP) = Тип("Структура")
			И РезультатSMTP.Свойство("ОшибочныеПолучатели")
			И РезультатSMTP.ОшибочныеПолучатели.Количество() = Адресаты.Количество() Тогда
			// Все получатели отклонены сервером - это тоже неуспех отправки.
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьEmail", "notify_all_recipients_rejected",
				СтрШаблон("SMTP отклонил всех получателей (RunId=%1, повод=%2)", RunId, ТипСобытия),
				"Ошибка", RunId);
			Результат.Причина = "send_failed";
			Возврат Результат;
		КонецЕсли;

		Результат.Отправлено = Истина;
		Результат.Причина = "ok";
		Возврат Результат;

	Исключение
		// D11: текст исключения БСП/платформы может содержать логин/пароль
		// учётной записи SMTP - маскируется перед записью в лог.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьEmail", "notify_send_failed",
			СтрШаблон("Не удалось отправить письмо (RunId=%1, повод=%2): %3",
				RunId, ТипСобытия, ТекстОшибки), "Ошибка", RunId);
		Результат.Отправлено = Ложь;
		Результат.Причина = "send_failed";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Человекочитаемое представление повода для темы/тела письма.
//
// Параметры:
//  ТипСобытия - Строка - "escalation"/"approval_pending"/"retry_exhausted".
//
// Возвращаемое значение:
//  Строка - локализованное представление; для незнакомого повода -
//  сам код ТипСобытия (защитный default).
//
Функция ПредставлениеПовода(Знач ТипСобытия)

	Если ТипСобытия = "escalation" Тогда
		Возврат НСтр("ru = 'эскалация надзора'; en = 'supervisor escalation'");
	ИначеЕсли ТипСобытия = "approval_pending" Тогда
		Возврат НСтр("ru = 'требуется подтверждение действия'; en = 'action approval required'");
	ИначеЕсли ТипСобытия = "retry_exhausted" Тогда
		Возврат НСтр("ru = 'исчерпаны повторы после технического сбоя'; en = 'retries exhausted after transient failure'");
	ИначеЕсли ТипСобытия = "input_pending" Тогда
		Возврат НСтр("ru = 'агент ждёт ответа на вопрос'; en = 'agent awaits an answer to a question'");
	ИначеЕсли ТипСобытия = "subject_excluded" Тогда
		Возврат НСтр("ru = 'предмет исключён из очереди после сбоев';
			|en = 'subject excluded from queue after failures'");
	Иначе
		// Незнакомый повод (защитный default, не должен встречаться при
		// вызове из трёх точек, зарегистрированных в спеке).
		Возврат ТипСобытия;
	КонецЕсли;

КонецФункции

// Текст письма по поводам с готовым описанием из журнала (agentrunner-32):
// для subject_excluded берётся текст последней записи subject_excluded этого
// запуска в ar_СлужебныйЛог (агент, предмет, три RunId из лога). Для прочих
// поводов возвращается "" - используется общий шаблон письма.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска.
//  ТипСобытия - Строка - повод уведомления.
//
// Возвращаемое значение:
//  Строка - текст события для тела письма; "" если повод без спец-текста.
//
Функция ТекстСобытияИзЖурнала(Знач RunId, Знач ТипСобытия)

	Если ТипСобытия <> "subject_excluded" Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|	И Лог.ar_RunId = &RunId
		|УПОРЯДОЧИТЬ ПО
		|	Лог.ar_Момент УБЫВ";
	Запрос.УстановитьПараметр("Источник", "ar_ПредметыАгентов");
	Запрос.УстановитьПараметр("Событие", "subject_excluded");
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Выборка.Текст;

КонецФункции

// Тема и текст информативного письма (agentrunner-51, спека п.2-4): описание
// события по поводу, действие оператора, блок ссылок "Перейти в 1С". Сборка
// выполняется ПОСЛЕ резервирования отправки (ЗарезервироватьОтправкуЕслиНеБыло
// в УведомитьВнутр), поэтому целиком обернута в Попытку: ни одна ошибка сборки
// не прерывает отправку - в ar_СлужебныйЛог пишется notify_build_failed, а
// письмо уходит по прежнему общему шаблону (спека п.5, D9).
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//
// Возвращаемое значение:
//  Структура - {Тема: Строка, Текст: Строка}.
//
Функция ТемаИТекстПисьма(Знач RunId, Знач ТипСобытия)

	Попытка

		Данные = ДанныеСобытия(RunId);
		Если Не Данные.Найдено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'запись запуска %1 в ar_Запуски не найдена';
				|en = 'run record %1 not found in ar_Запуски'"), RunId);
		КонецЕсли;

		Повод = ПредставлениеПовода(ТипСобытия);
		ОписаниеИДействие = ОписаниеСобытия(RunId, ТипСобытия, Данные);
		СтрокиСсылок = СтрокиБлокаСсылок(RunId, ТипСобытия, Данные);

		СтрокиПисьма = Новый Массив;
		СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Событие: %1'; en = 'Event: %1'"), Повод));

		Если Не ПустаяСтрока(Данные.Агент) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Агент: %1'; en = 'Agent: %1'"), Данные.Агент));
		КонецЕсли;

		Если Не ПустаяСтрока(Данные.ПредметПредставление) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Предмет: %1'; en = 'Subject: %1'"),
				Данные.ПредметПредставление));
		КонецЕсли;

		Если Не ПустаяСтрока(Данные.Статус) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Статус запуска: %1'; en = 'Run status: %1'"),
				Данные.Статус));
		КонецЕсли;

		Если ЗначениеЗаполнено(Данные.СтартовалВ) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Начат: %1'; en = 'Started: %1'"),
				Формат(Данные.СтартовалВ, "ДФ='dd.MM.yyyy HH:mm'")));
		КонецЕсли;

		Если ЗначениеЗаполнено(Данные.ЗавершенВ) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Завершен: %1'; en = 'Finished: %1'"),
				Формат(Данные.ЗавершенВ, "ДФ='dd.MM.yyyy HH:mm'")));
		КонецЕсли;

		СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Время события: %1'; en = 'Event time: %1'"),
			Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")));

		Если Не ПустаяСтрока(ОписаниеИДействие.Описание) Тогда
			СтрокиПисьма.Добавить("");
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Описание: %1'; en = 'Description: %1'"),
				ОписаниеИДействие.Описание));
		КонецЕсли;

		Если Не ПустаяСтрока(ОписаниеИДействие.Действие) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Что сделать: %1'; en = 'Action required: %1'"),
				ОписаниеИДействие.Действие));
		КонецЕсли;

		Если СтрокиСсылок.Количество() > 0 Тогда
			СтрокиПисьма.Добавить("");
			СтрокиПисьма.Добавить(НСтр("ru = 'Перейти в 1С:'; en = 'Open in 1C:'"));
			Для Каждого СтрокаСсылки Из СтрокиСсылок Цикл
				СтрокиПисьма.Добавить(СтрокаСсылки);
			КонецЦикла;
		КонецЕсли;

		Возврат Новый Структура("Тема, Текст",
			ТемаПисьма(Повод, Данные.Агент, Данные.ПредметПредставление, RunId),
			СтрСоединить(СтрокиПисьма, Символы.ПС));

	Исключение
		// Сбой сборки (нет записи запуска, поврежден payload, ошибка чтения)
		// не отменяет уведомление - уходит прежний общий шаблон (спека п.5).
		// Катч не имеет права выбросить исключение: маскировка и запись в лог
		// - внешние вызовы, тоже в Попытке (эталон - Уведомить).
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Уведомления.ТемаИТекстПисьма", "notify_build_failed",
				СтрШаблон("Сборка информативного письма не удалась, уходит общий шаблон (RunId=%1, повод=%2): %3",
					RunId, ТипСобытия, ТекстОшибки), "Ошибка", RunId);
		Исключение
			// Без записи в лог письмо все равно уйдет по общему шаблону.
		КонецПопытки;

		Возврат ПрежнийШаблонПисьма(RunId, ТипСобытия);
	КонецПопытки;

КонецФункции

// Прежний общий шаблон письма (тема и тело как до agentrunner-51) - резерв
// при сбое информативной сборки. Тексты повторяют прежний код ОтправитьEmail:
// для subject_excluded в тело по-прежнему добавляются подробности из журнала.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//
// Возвращаемое значение:
//  Структура - {Тема: Строка, Текст: Строка}.
//
Функция ПрежнийШаблонПисьма(Знач RunId, Знач ТипСобытия)

	Тема = СтрШаблон(НСтр("ru = 'AgentRunner: %1 (RunId %2)';
		|en = 'AgentRunner: %1 (RunId %2)'"), ПредставлениеПовода(ТипСобытия), RunId);

	ТекстИзЖурнала = ТекстСобытияИзЖурнала(RunId, ТипСобытия);
	Если Не ПустаяСтрока(ТекстИзЖурнала) Тогда
		ШаблонСобытия = НСтр("ru = 'Событие: %1%3Подробности: %2%3Требуется внимание оператора AgentRunner.';
			|en = 'Event: %1%3Details: %2%3AgentRunner operator attention required.'");
		ТекстПисьма = СтрШаблон(ШаблонСобытия, ПредставлениеПовода(ТипСобытия),
			ТекстИзЖурнала, Символы.ПС);
	Иначе
		ШаблонТекстаПисьма = НСтр("ru = 'Событие: %1%3RunId: %2%3Требуется внимание оператора AgentRunner.';
			|en = 'Event: %1%3RunId: %2%3AgentRunner operator attention required.'");
		ТекстПисьма = СтрШаблон(ШаблонТекстаПисьма, ПредставлениеПовода(ТипСобытия), RunId, Символы.ПС);
	КонецЕсли;

	Возврат Новый Структура("Тема, Текст", Тема, ТекстПисьма);

КонецФункции

// Данные информативного письма одним чтением записи ar_Запуски (спека п.1):
// представления агента и предмета, диалог, статус, время старта/завершения,
// текст ошибки и счетчики. Чтение - как в существующих функциях модуля.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Структура - {Найдено: Булево, Агент: Строка, Предмет: Произвольный,
//               ПредметПредставление: Строка, Диалог: Произвольный,
//               Статус: Строка, СтартовалВ: Дата, ЗавершенВ: Дата,
//               ОтветLLM: Строка, ПопытокВозобновления: Число,
//               ШаговВсего: Число, ПродолженийСделано: Число}.
//  Найдено=Ложь - записи запуска нет (остальные поля пустые).
//
Функция ДанныеСобытия(Знач RunId)

	Шапка = ПрочитатьШапкуЗапуска(RunId);

	Агент = "";
	Если ЗначениеЗаполнено(Шапка.Агент) Тогда
		Агент = Строка(Шапка.Агент);
	КонецЕсли;

	ПредметПредставление = "";
	Если ЗначениеЗаполнено(Шапка.Предмет) Тогда
		ПредметПредставление = Строка(Шапка.Предмет);
	КонецЕсли;

	Статус = "";
	Если ЗначениеЗаполнено(Шапка.Статус) Тогда
		Статус = Строка(Шапка.Статус);
	КонецЕсли;

	Возврат Новый Структура(
		"Найдено, Агент, Предмет, ПредметПредставление, Диалог, Статус, СтартовалВ,
		|ЗавершенВ, ОтветLLM, ПопытокВозобновления, ШаговВсего, ПродолженийСделано",
		Шапка.Найдено, Агент, Шапка.Предмет, ПредметПредставление, Шапка.Диалог,
		Статус, Шапка.СтартовалВ, Шапка.ЗавершенВ, Шапка.ОтветLLM,
		Шапка.ПопытокВозобновления, Шапка.ШаговВсего, Шапка.ПродолженийСделано);

КонецФункции

// Описание события и действие оператора по поводам (спека п.2). Нет нужной
// записи (события, approval) - строки остаются пустыми и в письме пропускаются;
// неизвестный повод - общий текст "Требуется внимание оператора AgentRunner".
// Причина/ошибка/обоснование маскируются и обрезаются до 1000 символов.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//  Данные     - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Структура - {Описание: Строка, Действие: Строка}.
//
Функция ОписаниеСобытия(Знач RunId, Знач ТипСобытия, Знач Данные)

	Результат = Новый Структура("Описание, Действие", "", "");

	Если ТипСобытия = "escalation" Тогда
		// Два разных источника повода: надзор (событие НадзорРешение) и
		// дедлайн ожидания события (ОжиданиеСобытия/wait_expired, при котором
		// НадзорРешения нет) - см. research.md.
		ПолезнаяНагрузкаНадзора = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
			Перечисления.ar_ТипСобытия.НадзорРешение);
		Если ПолезнаяНагрузкаНадзора <> Неопределено Тогда
			Результат.Описание = ОписаниеЭскалацииНадзора(ПолезнаяНагрузкаНадзора, Данные);
			Результат.Действие = НСтр("ru = 'Откройте запуск, оцените ход работы и продолжите или отмените его';
				|en = 'Open the run, review the progress, then resume or cancel it'");
		Иначе
			ПолезнаяНагрузкаОжидания = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
				Перечисления.ar_ТипСобытия.ОжиданиеСобытия);
			Если ПолезнаяНагрузкаОжидания <> Неопределено
				И ПолезнаяНагрузкаОжидания.Получить("code") = "wait_expired" Тогда
				Результат.Описание = НСтр("ru = 'истек срок ожидания события';
					|en = 'the event wait deadline has expired'");
				Результат.Действие = НСтр("ru = 'Проверьте, наступило ли ожидаемое событие; продолжите или отмените запуск';
					|en = 'Check whether the expected event has occurred; resume or cancel the run'");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ТипСобытия = "approval_pending" Тогда
		Результат.Описание = ОписаниеОжиданияПодтверждения(RunId);
		Результат.Действие = НСтр("ru = 'Подтвердите или отклоните действие в очереди подтверждений';
			|en = 'Approve or reject the action in the approval queue'");

	ИначеЕсли ТипСобытия = "retry_exhausted" Тогда
		Результат.Описание = ОписаниеИсчерпанныхПовторов(RunId, Данные);
		Результат.Действие = НСтр("ru = 'Изучите ошибку в карточке запуска; после устранения причины запустите заново';
			|en = 'Review the error in the run card; restart the run after fixing the cause'");

	ИначеЕсли ТипСобытия = "subject_excluded" Тогда
		ТекстЖурнала = ТекстСобытияИзЖурнала(RunId, ТипСобытия);
		Если Не ПустаяСтрока(ТекстЖурнала) Тогда
			Результат.Описание = ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(ТекстЖурнала), 1000);
		КонецЕсли;
		Результат.Действие = НСтр("ru = 'Проверьте предмет; после исправления верните его в очередь';
			|en = 'Check the subject; return it to the queue after fixing'");

	Иначе
		// Неизвестный повод - общий текст (спека п.2). Публичный контракт
		// Уведомить принимает любую строку повода.
		Результат.Описание = НСтр("ru = 'Требуется внимание оператора AgentRunner';
			|en = 'AgentRunner operator attention required'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Текст причины эскалации надзора из payload события НадзорРешение
// (escalation_reason: budget/stagnation/safety_cap) плюс цифры запуска, если
// заполнены (шагов, продолжений). Лимиты из payload не выводятся: их ключи
// в протоколе событий не зафиксированы (см. mcp.md [P3]).
//
// Параметры:
//  ПолезнаяНагрузка - Соответствие - разобранный payload НадзорРешение.
//  Данные           - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Строка - описание причины; пустая, если причина не распознана.
//
Функция ОписаниеЭскалацииНадзора(Знач ПолезнаяНагрузка, Знач Данные)

	Причина = "";
	КодПричины = ПолезнаяНагрузка.Получить("escalation_reason");
	Если ТипЗнч(КодПричины) = Тип("Строка") Тогда
		Если КодПричины = "budget" Тогда
			Причина = НСтр("ru = 'исчерпан бюджет запуска'; en = 'run budget exhausted'");
		ИначеЕсли КодПричины = "stagnation" Тогда
			Причина = НСтр("ru = 'застой: шаги повторяются без прогресса';
				|en = 'stagnation: steps repeat without progress'");
		ИначеЕсли КодПричины = "safety_cap" Тогда
			Причина = НСтр("ru = 'достигнут потолок продолжений';
				|en = 'continuation safety cap reached'");
		Иначе
			// Незнакомый код причины - выводится как есть, с маскировкой и обрезкой.
			Причина = ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(КодПричины), 1000);
		КонецЕсли;
	КонецЕсли;

	Цифры = Новый Массив;
	Если Данные.ШаговВсего > 0 Тогда
		Цифры.Добавить(СтрШаблон(НСтр("ru = 'шагов: %1'; en = 'steps: %1'"), Данные.ШаговВсего));
	КонецЕсли;
	Если Данные.ПродолженийСделано > 0 Тогда
		Цифры.Добавить(СтрШаблон(НСтр("ru = 'продолжений: %1'; en = 'continuations: %1'"),
			Данные.ПродолженийСделано));
	КонецЕсли;

	Если Цифры.Количество() = 0 Тогда
		Возврат Причина;
	КонецЕсли;

	ЦифрыСтрокой = СтрСоединить(Цифры, ", ");
	Если ПустаяСтрока(Причина) Тогда
		Возврат ЦифрыСтрокой;
	КонецЕсли;

	Возврат Причина + " (" + ЦифрыСтрокой + ")";

КонецФункции

// Описание ожидающих подтверждений запуска (спека п.2): по каждой записи
// очереди - инструмент (payload.tool_name), уровень риска (payload.risk_level),
// срок (ar_ОтветитьДо) и обоснование модели (ar_ОбоснованиеLLM, маскированное
// и обрезанное). Аргументы инструмента не выводятся (спека, audit п.4).
// Ожидающие записи - фасад ar_AuditЗащищённыйРежим
// (НайтиОжидающиеApprovalЗапускаПривилегированно); детали - один привилегированный
// запрос по списку идентификаторов: фасад ПрочитатьЗаписьОчередиПривилегированно
// возвращает запись без ar_ОбоснованиеLLM/ar_ОтветитьДо (см. mcp.md [P3]),
// а запрос в цикле по записям запрещен стандартом проекта.
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - описание по каждой ожидающей записи (переводы строк внутри);
//  пустая, если ожидающих записей нет.
//
Функция ОписаниеОжиданияПодтверждения(Знач RunId)

	Ожидающие = ar_AuditЗащищённыйРежим.НайтиОжидающиеApprovalЗапускаПривилегированно(RunId);
	Если Ожидающие.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Ожидающее Из Ожидающие Цикл
		Идентификаторы.Добавить(Ожидающее.ApprovalId);
	КонецЦикла;

	// Привилегированное чтение - как в УжеУведомляли: уведомление идет в том
	// числе из регламентных заданий без гарантии роли на регистры очереди.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Очередь.ar_ApprovalId КАК ApprovalId,
			|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON,
			|	Очередь.ar_ОбоснованиеLLM КАК ОбоснованиеLLM,
			|	Очередь.ar_ОтветитьДо КАК ОтветитьДо
			|ИЗ
			|	РегистрСведений.ar_ОчередьApproval КАК Очередь
			|ГДЕ
			|	Очередь.ar_ApprovalId В (&Идентификаторы)
			|УПОРЯДОЧИТЬ ПО
			|	Очередь.ar_СозданоВ";
		Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл

		Части = Новый Массив;
		ПолезнаяНагрузка = ar_JSON.ИзJSON(Выборка.ActionPayloadJSON);
		Если ТипЗнч(ПолезнаяНагрузка) = Тип("Соответствие") Тогда
			// Поврежденный payload записи очереди не отменяет остальные строки:
			// инструмент и риск просто пропускаются (спека п.2).
			ИмяИнструмента = ПолезнаяНагрузка.Получить("tool_name");
			Если ТипЗнч(ИмяИнструмента) = Тип("Строка") И Не ПустаяСтрока(ИмяИнструмента) Тогда
				Части.Добавить(СтрШаблон(НСтр("ru = 'инструмент: %1'; en = 'tool: %1'"),
					ИмяИнструмента));
			КонецЕсли;
			УровеньРиска = ПолезнаяНагрузка.Получить("risk_level");
			Если ТипЗнч(УровеньРиска) = Тип("Строка") И Не ПустаяСтрока(УровеньРиска) Тогда
				Части.Добавить(СтрШаблон(НСтр("ru = 'риск: %1'; en = 'risk: %1'"), УровеньРиска));
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.ОтветитьДо) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'ответить до: %1'; en = 'answer before: %1'"),
				Формат(Выборка.ОтветитьДо, "ДФ='dd.MM.yyyy HH:mm'")));
		КонецЕсли;

		Если Части.Количество() > 0 Тогда
			Строки.Добавить(СтрСоединить(Части, ", "));
		КонецЕсли;

		Если Не ПустаяСтрока(Выборка.ОбоснованиеLLM) Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Обоснование модели: %1'; en = 'Model rationale: %1'"),
				ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(Выборка.ОбоснованиеLLM), 1000)));
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Описание повода retry_exhausted (спека п.2): число автоматических повторов
// (ar_ПопытокВозобновления) и последняя ошибка - ar_ОтветLLM запуска, а если
// он пуст, payload.error последнего события Ошибка. Текст ошибки маскируется
// и обрезается до 1000 символов.
//
// Параметры:
//  RunId  - Строка(36) - идентификатор запуска.
//  Данные - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Строка - описание повода.
//
Функция ОписаниеИсчерпанныхПовторов(Знач RunId, Знач Данные)

	Описание = СтрШаблон(НСтр("ru = 'исчерпаны автоматические повторы (%1)';
		|en = 'automatic retries exhausted (%1)'"), Данные.ПопытокВозобновления);

	ТекстОшибки = СокрЛП(Данные.ОтветLLM);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ПолезнаяНагрузка = ПолезнаяНагрузкаПоследнегоСобытия(RunId,
			Перечисления.ar_ТипСобытия.Ошибка);
		Если ПолезнаяНагрузка <> Неопределено Тогда
			ТекстИзPayload = ПолезнаяНагрузка.Получить("error");
			Если ТипЗнч(ТекстИзPayload) = Тип("Строка") Тогда
				ТекстОшибки = СокрЛП(ТекстИзPayload);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Описание = Описание + Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Последняя ошибка: %1'; en = 'Last error: %1'"),
				ОбрезатьСтроку(ar_Утилиты.МаскироватьСекреты(ТекстОшибки), 1000));
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Разобранный payload последнего события заданного типа по RunId; порядок -
// по ar_Sequence УБЫВ (см. mcp.md [P3]). Чтение привилегированное - как в
// УжеУведомляли: вызов идет из регламентных заданий, где нет гарантии
// интерактивного пользователя с ролью на ar_СобытияЗапуска.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор запуска.
//  ТипСобытияЗапуска - ПеречислениеСсылка.ar_ТипСобытия - тип события.
//
// Возвращаемое значение:
//  Соответствие - разобранный payload; Неопределено, если события нет.
//  Запись есть, но payload поврежден (не разбирается) - исключение: сборка
//  письма откатывается на общий шаблон (критерий 5 спеки).
//
Функция ПолезнаяНагрузкаПоследнегоСобытия(Знач RunId, Знач ТипСобытияЗапуска)

	ТекстPayload = "";
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	События.ar_PayloadJSON КАК PayloadJSON
			|ИЗ
			|	РегистрСведений.ar_СобытияЗапуска КАК События
			|ГДЕ
			|	События.ar_RunId = &RunId
			|	И События.ar_ТипСобытия = &ТипСобытия
			|УПОРЯДОЧИТЬ ПО
			|	События.ar_Sequence УБЫВ";
		Запрос.УстановитьПараметр("RunId", RunId);
		Запрос.УстановитьПараметр("ТипСобытия", ТипСобытияЗапуска);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ТекстPayload = Выборка.PayloadJSON;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ПустаяСтрока(ТекстPayload) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолезнаяНагрузка = ar_JSON.ИзJSON(ТекстPayload);
	Если ТипЗнч(ПолезнаяНагрузка) <> Тип("Соответствие") Тогда
		// Запись события есть, а payload поврежден - это сбой сборки, а не
		// отсутствие данных: письмо уходит по общему шаблону (спека п.5).
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'поврежден payload события %1 (RunId=%2)';
			|en = 'damaged payload of event %1 (RunId=%2)'"),
			Строка(ТипСобытияЗапуска), RunId);
	КонецЕсли;

	Возврат ПолезнаяНагрузка;

КонецФункции

// Строки блока "Перейти в 1С" (спека п.4): запуск (ключ записи ar_Запуски,
// по нему открывается основная форма записи ar_ПросмотрЗапуска), предмет
// (если заполнен и существует), диалог (для чата консоли его нет), для
// approval_pending - очередь подтверждений. При заданном адресе публикации
// каждая ссылка - полный URL <адрес без завершающего "/">/#<навигационная
// ссылка>; не задан - навигационные ссылки текстом, подсказка Shift+F11 и
// предупреждение notify_publication_address_empty в лог (одна запись на
// письмо), письмо уходит.
//
// Параметры:
//  RunId      - Строка(36) - идентификатор запуска.
//  ТипСобытия - Строка - повод письма.
//  Данные     - Структура - результат ДанныеСобытия.
//
// Возвращаемое значение:
//  Массив из Строка - строки блока ссылок.
//
Функция СтрокиБлокаСсылок(Знач RunId, Знач ТипСобытия, Знач Данные)

	Ссылки = Новый Массив;
	Ссылки.Добавить(Новый Структура("Имя, Адрес",
		НСтр("ru = 'Запуск'; en = 'Run'"), НавигационнаяСсылкаЗапуска(RunId)));

	Если ЗначениеЗаполнено(Данные.Предмет)
		И ОбщегоНазначения.СсылкаСуществует(Данные.Предмет) Тогда
		Ссылки.Добавить(Новый Структура("Имя, Адрес",
			НСтр("ru = 'Предмет'; en = 'Subject'"),
			ПолучитьНавигационнуюСсылку(Данные.Предмет)));
	КонецЕсли;

	Если ЗначениеЗаполнено(Данные.Диалог) Тогда
		Ссылки.Добавить(Новый Структура("Имя, Адрес",
			НСтр("ru = 'Диалог'; en = 'Dialog'"),
			ПолучитьНавигационнуюСсылку(Данные.Диалог)));
	КонецЕсли;

	Если ТипСобытия = "approval_pending" Тогда
		// Формат e1cib/app/<имя формы> - как в примере БСП к АдресПубликации;
		// открытие проверяется на стенде (verify), см. спеку п.4.
		Ссылки.Добавить(Новый Структура("Имя, Адрес",
			НСтр("ru = 'Очередь подтверждений'; en = 'Approval queue'"),
			"e1cib/app/ОбщаяФорма.ar_ОчередьПодтверждений"));
	КонецЕсли;

	АдресПубликации = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	Если ТипЗнч(АдресПубликации) <> Тип("Строка") Тогда
		АдресПубликации = "";
	КонецЕсли;

	Результат = Новый Массив;
	Если Не ПустаяСтрока(АдресПубликации) Тогда
		Если СтрЗаканчиваетсяНа(АдресПубликации, "/") Тогда
			АдресПубликации = Лев(АдресПубликации, СтрДлина(АдресПубликации) - 1);
		КонецЕсли;
		Для Каждого Ссылка Из Ссылки Цикл
			Результат.Добавить(Ссылка.Имя + ": " + АдресПубликации + "/#" + Ссылка.Адрес);
		КонецЦикла;
	Иначе
		Для Каждого Ссылка Из Ссылки Цикл
			Результат.Добавить(Ссылка.Имя + ": " + Ссылка.Адрес);
		КонецЦикла;
		Результат.Добавить(НСтр("ru = 'Откройте 1С, нажмите Shift+F11 и вставьте ссылку.';
			|en = 'Open 1C, press Shift+F11 and paste the link.'"));
		ar_СлужебныйЛог.Записать("ar_Уведомления.СтрокиБлокаСсылок",
			"notify_publication_address_empty",
			СтрШаблон("Адрес публикации ИБ не задан - в письме навигационные ссылки текстом "
				+ "(RunId=%1, повод=%2)", RunId, ТипСобытия), "Предупреждение", RunId);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Навигационная ссылка на запись запуска: ключ регистра ar_Запуски (спека
// п.4, методы - mcp.md [P2]). По ссылке веб-клиент открывает основную форму
// записи - CommonForm.ar_ПросмотрЗапуска (DefaultRecordForm регистра).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - навигационная ссылка на запись регистра.
//
Функция НавигационнаяСсылкаЗапуска(Знач RunId)

	КлючЗаписи = РегистрыСведений.ar_Запуски.СоздатьКлючЗаписи(
		Новый Структура("ar_ИдентификаторЗапуска", RunId));
	Возврат ПолучитьНавигационнуюСсылку(КлючЗаписи);

КонецФункции

// Тема письма по схеме спеки п.3: "AgentRunner: <повод> - <агент>[ - <предмет,
// до 60 символов>] (RunId <uuid>)"; агента нет - без него. Тема обрезается
// до 250 символов. Разделитель - обычный дефис: специальные тире в коде
// запрещены стандартом проекта (mcp.md [ST]).
//
// Параметры:
//  Повод                - Строка - человекочитаемое представление повода.
//  Агент                - Строка - представление агента.
//  ПредметПредставление - Строка - представление предмета.
//  RunId                - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - тема письма (не длиннее 250 символов).
//
Функция ТемаПисьма(Знач Повод, Знач Агент, Знач ПредметПредставление, Знач RunId)

	Тема = "AgentRunner: " + Повод;
	Если Не ПустаяСтрока(Агент) Тогда
		Тема = Тема + " - " + Агент;
	КонецЕсли;
	Если Не ПустаяСтрока(ПредметПредставление) Тогда
		Тема = Тема + " - " + ОбрезатьСтроку(ПредметПредставление, 60);
	КонецЕсли;
	Тема = Тема + " (RunId " + RunId + ")";

	Возврат ОбрезатьСтроку(Тема, 250);

КонецФункции

// Обрезать строку до лимита символов; при усечении добавляется многоточие.
// Применяется к темам (60/250) и причинам/ошибкам/обоснованиям (1000).
//
// Параметры:
//  Текст - Строка - исходная строка.
//  Лимит - Число - предельная длина результата.
//
// Возвращаемое значение:
//  Строка - исходная строка или усеченная с многоточием на конце.
//
Функция ОбрезатьСтроку(Знач Текст, Знач Лимит)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) <= Лимит Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Лимит - 1) + "...";

КонецФункции

// Основная логика УведомитьОВопросе (см. doc-комментарий).
//
Функция УведомитьОВопросеВнутр(Знач ИдентификаторВопроса)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "");

	// 1. Запись очереди вопроса: RunId и payload (текст/подсказка/варианты).
	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ИдентификаторВопроса);
	Если ДанныеЗаписи = Неопределено Тогда
		Результат.Причина = "record_not_found";
		Возврат Результат;
	КонецЕсли;

	// 2. Диалог вопроса (для чата консоли его нет - письмо не отправляется).
	ДиалогВопроса = ar_ДиалогиСервер.ДиалогЗапуска(ДанныеЗаписи.RunId);
	Если Не ЗначениеЗаполнено(ДиалогВопроса) Тогда
		Результат.Причина = "no_dialog";
		Возврат Результат;
	КонецЕсли;

	// 3. Дедупликация: RunId + повод + идентификатор вопроса (спека п.10).
	Если ЗарезервироватьОтправкуЕслиНеБыло(ДанныеЗаписи.RunId, "input_pending",
		ИдентификаторВопроса) = Ложь Тогда
		Результат.Причина = "duplicate";
		Возврат Результат;
	КонецЕсли;

	// 4. Адресаты - участники диалога с адресом почты (записан при создании
	// участника из карточки пользователя; адрес из текста модели не принимается).
	Адресаты = АдресатыВопроса(ДиалогВопроса);
	Если Адресаты.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Уведомления.УведомитьОВопросеВнутр", "notify_no_recipients",
			СтрШаблон("У участников диалога %1 нет адресов почты (ApprovalId=%2)",
				Строка(ДиалогВопроса), ИдентификаторВопроса), "Ошибка", ДанныеЗаписи.RunId);
		Результат.Причина = "no_recipients";
		Возврат Результат;
	КонецЕсли;

	// 5. Письмо одним сообщением всем адресатам.
	ИтогОтправки = ОтправитьПисьмоОВопросе(ДанныеЗаписи, ДиалогВопроса, Адресаты);
	Результат.Отправлено = ИтогОтправки.Отправлено;
	Результат.Причина = ИтогОтправки.Причина;

	Возврат Результат;

КонецФункции

// Адресаты вопроса: участники диалога с адресом почты (ТЧ ar_Участники).
//
// Возвращаемое значение:
//  Массив из Структура {Email, Представление} - без дублей по адресу.
//
Функция АдресатыВопроса(Знач ДиалогВопроса)

	Результат = Новый Массив;
	ВидимыеEmail = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Участники.ar_Пользователь КАК Пользователь,
		|	Участники.ar_АдресПочты КАК АдресПочты
		|ИЗ
		|	Справочник.ar_Диалоги.ar_Участники КАК Участники
		|ГДЕ
		|	Участники.Ссылка = &Диалог";
	Запрос.УстановитьПараметр("Диалог", ДиалогВопроса);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Адрес = "";
		Представление = "";

		Если ТипЗнч(Выборка.АдресПочты) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Выборка.АдресПочты)) Тогда
			Адрес = СокрЛП(Выборка.АдресПочты);
			Представление = ?(ЗначениеЗаполнено(Выборка.Пользователь),
				Строка(Выборка.Пользователь), Адрес);
		КонецЕсли;

		Если ПустаяСтрока(Адрес) Тогда
			Продолжить;
		КонецЕсли;

		Если ВидимыеEmail[Адрес] = Неопределено Тогда
			ВидимыеEmail[Адрес] = Истина;
			Результат.Добавить(Новый Структура("Email, Представление", Адрес, Представление));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отправить письмо о вопросе (Вариант Б - прямой БСП API, как ОтправитьEmail).
// Состав: вопрос, подсказка, варианты, «ответить до», подпись предмета,
// навигационные ссылки на диалог и предмет с подсказкой Shift+F11; полная
// ссылка - только если адрес публикации в локальной сети заполнен.
//
Функция ОтправитьПисьмоОВопросе(Знач ДанныеЗаписи, Знач ДиалогВопроса, Знач Адресаты)

	Результат = Новый Структура("Отправлено, Причина", Ложь, "send_failed");

	Попытка

		Если Метаданные.ОбщиеМодули.Найти("РаботаСПочтовымиСообщениями") = Неопределено Тогда
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_no_mail_subsystem",
				"Подсистема БСП электронной почты не подключена - письмо о вопросе не отправлено",
				"Ошибка", ДанныеЗаписи.RunId);
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		УчетнаяЗапись = УчетнаяЗаписьДляУведомлений();
		Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_no_email_account",
				СтрШаблон("Нет настроенной учётной записи для системных уведомлений "
					+ "(RunId=%1, повод=input_pending) - письмо НЕ отправлено", ДанныеЗаписи.RunId),
				"Ошибка", ДанныеЗаписи.RunId);
			Результат.Причина = "no_email_account";
			Возврат Результат;
		КонецЕсли;

		ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(ДиалогВопроса);
		ДанныеВопроса = ДанныеВопросаИзPayload(ДанныеЗаписи.ActionPayloadJSON);

		СтрокиПисьма = Новый Массив;
		СтрокиПисьма.Добавить(НСтр("ru = 'Агент ждёт вашего ответа.';
			|en = 'The agent is waiting for your reply.'"));
		СтрокиПисьма.Добавить("");
		СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Вопрос: %1'; en = 'Question: %1'"),
			ДанныеВопроса.Текст));

		Если Не ПустаяСтрока(ДанныеВопроса.Подсказка) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Подсказка: %1'; en = 'Hint: %1'"),
				ДанныеВопроса.Подсказка));
		КонецЕсли;

		Если Не ПустаяСтрока(ДанныеВопроса.Варианты) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Варианты ответа: %1'; en = 'Answer choices: %1'"),
				ДанныеВопроса.Варианты));
		КонецЕсли;

		Если ЗначениеЗаполнено(ШапкаДиалога.ОтветитьДо) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Ответить до: %1'; en = 'Answer before: %1'"),
				Формат(ШапкаДиалога.ОтветитьДо, "ДФ='dd.MM.yyyy HH:mm'")));
		КонецЕсли;

		Если Не ПустаяСтрока(ШапкаДиалога.ПредставлениеПредмета) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Предмет: %1'; en = 'Subject: %1'"),
				ШапкаДиалога.ПредставлениеПредмета));
		КонецЕсли;

		СтрокиПисьма.Добавить("");
		СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Диалог: %1'; en = 'Dialog: %1'"),
			ПолучитьНавигационнуюСсылку(ДиалогВопроса)));

		// agentrunner-51: ссылка на запуск (ключ записи ar_Запуски) в том же блоке.
		СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Запуск: %1'; en = 'Run: %1'"),
			НавигационнаяСсылкаЗапуска(ДанныеЗаписи.RunId)));

		Если ЗначениеЗаполнено(ШапкаДиалога.Предмет)
			И ОбщегоНазначения.СсылкаСуществует(ШапкаДиалога.Предмет) Тогда
			СтрокиПисьма.Добавить(СтрШаблон(НСтр("ru = 'Предмет: %1'; en = 'Subject: %1'"),
				ПолучитьНавигационнуюСсылку(ШапкаДиалога.Предмет)));
		КонецЕсли;

		СтрокиПисьма.Добавить(НСтр("ru = 'Откройте 1С, нажмите Shift+F11 и вставьте ссылку.';
			|en = 'Open 1C, press Shift+F11 and paste the link.'"));

		АдресПубликации = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
		Если ТипЗнч(АдресПубликации) = Тип("Строка") И Не ПустаяСтрока(АдресПубликации) Тогда
			СтрокиПисьма.Добавить("");
			// Веб-клиент открывает ссылку вида <публикация>/#e1cib/data/...
			Если СтрЗаканчиваетсяНа(АдресПубликации, "/") Тогда
				АдресПубликации = Лев(АдресПубликации, СтрДлина(АдресПубликации) - 1);
			КонецЕсли;
			СтрокиПисьма.Добавить(АдресПубликации + "/#" + ПолучитьНавигационнуюСсылку(ДиалогВопроса));
			// agentrunner-51: полная ссылка на запуск рядом с диалогом.
			СтрокиПисьма.Добавить(АдресПубликации + "/#"
				+ НавигационнаяСсылкаЗапуска(ДанныеЗаписи.RunId));
		Иначе
			// agentrunner-51: адрес публикации не задан - предупреждение в лог
			// (одна запись на письмо), письмо уходит с навигационными ссылками.
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоОВопросе",
				"notify_publication_address_empty",
				СтрШаблон("Адрес публикации ИБ не задан - в письме навигационные ссылки текстом (RunId=%1)",
					ДанныеЗаписи.RunId), "Предупреждение", ДанныеЗаписи.RunId);
		КонецЕсли;

		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Отправитель = СокрЛП(УчетнаяЗапись.АдресЭлектроннойПочты);
		Письмо.ИмяОтправителя = "AgentRunner";
		// agentrunner-51: тема по общей схеме (повод, агент, предмет, RunId) -
		// как в общем пути ОтправитьEmail.
		Письмо.Тема = ТемаПисьма(ПредставлениеПовода("input_pending"),
			Строка(ШапкаДиалога.Агент), ШапкаДиалога.ПредставлениеПредмета, ДанныеЗаписи.RunId);

		Письмо.Тексты.Добавить(СтрСоединить(СтрокиПисьма, Символы.ПС),
			ТипТекстаПочтовогоСообщения.ПростойТекст);

		Для Каждого Адресат Из Адресаты Цикл
			Письмо.Получатели.Добавить(Адресат.Email, Адресат.Представление);
		КонецЦикла;

		РезультатSMTP = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);

		Если ТипЗнч(РезультатSMTP) = Тип("Структура")
			И РезультатSMTP.Свойство("ОшибочныеПолучатели")
			И РезультатSMTP.ОшибочныеПолучатели.Количество() = Адресаты.Количество() Тогда
			ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_all_recipients_rejected",
				СтрШаблон("SMTP отклонил всех получателей (RunId=%1, повод=input_pending)",
					ДанныеЗаписи.RunId), "Ошибка", ДанныеЗаписи.RunId);
			Результат.Причина = "send_failed";
			Возврат Результат;
		КонецЕсли;

		Результат.Отправлено = Истина;
		Результат.Причина = "ok";
		Возврат Результат;

	Исключение
		// D11: маскировка секрета SMTP в тексте исключения.
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_Уведомления.ОтправитьПисьмоОВопросе", "notify_send_failed",
			СтрШаблон("Не удалось отправить письмо о вопросе (RunId=%1): %2",
				ДанныеЗаписи.RunId, ТекстОшибки), "Ошибка", ДанныеЗаписи.RunId);
		Результат.Причина = "send_failed";
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Текст, подсказка и варианты вопроса из ActionPayloadJSON (как в ar_Подтверждение).
//
Функция ДанныеВопросаИзPayload(Знач ActionPayloadJSON)

	Результат = Новый Структура("Текст, Подсказка, Варианты", "", "", "");

	Попытка
		Payload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = Payload.Получить("question");
	Если ТипЗнч(Текст) = Тип("Строка") Тогда
		Результат.Текст = Текст;
	КонецЕсли;

	Подсказка = Payload.Получить("hint");
	Если ТипЗнч(Подсказка) = Тип("Строка") Тогда
		Результат.Подсказка = Подсказка;
	КонецЕсли;

	Варианты = Payload.Получить("choices");
	Если ТипЗнч(Варианты) = Тип("Массив") И Варианты.Количество() > 0 Тогда
		Представления = Новый Массив;
		Для Каждого Вариант Из Варианты Цикл
			Представления.Добавить("«" + СокрЛП(Строка(Вариант)) + "»");
		КонецЦикла;
		Результат.Варианты = СтрСоединить(Представления, ", ");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
