////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПланЗапуска (План запуска).
//
// Чистый вычислительный слой между tool update_plan (PLAN-03) и циклом рантайма
// (ar_RuntimeЦикл, PLAN-04): формат внутреннего представления плана, слияние
// пунктов, присланных LLM, с ранее сохранённым состоянием и подсчёт прогресса.
//
// Модуль чистый: не читает и не пишет ИБ (нет Запрос, нет обращений к
// Справочники./Документы./РегистрыСведений.), не устанавливает привилегированный
// режим, не делает HTTP, не вызывает Выполнить/Вычислить, не вызывает ar_JSON —
// работает только с уже десериализованными платформенными типами (Структура,
// Массив), сериализация в JSON и обратно — ответственность вызывающих модулей
// (PLAN-03, PLAN-04).
//
// Контракт «План» (Структура):
//   Пункты  - Массив из Структур - не более 12 элементов (см. НовыйПункт).
//   Усечено - Булево - признак усечения списка пунктов и/или текста заголовка.
//
// Пункт плана (Структура, agentrunner-48):
//   Заголовок            - Строка          - до 150 символов.
//   Статус               - Строка          - pending | in_progress | done |
//                                            skipped | removed.
//   Обязательный          - Булево          - шаг закрывается только вызовом
//                                            одного из ЗакрывающиеИнструменты
//                                            или явным пропуском с причиной.
//   ЗакрывающиеИнструменты - Массив из Строка - имена tools, успешный вызов
//                                            которых закрывает шаг.
//   Инструкция            - Строка          - "мини-промпт" шага, до 500 символов.
//   ПричинаПропуска       - Строка          - причина skipped обязательного шага.
//   ЗакрытИнструментом    - Строка          - имя tool, закрывшего шаг (done).
//
// Пункты старых состояний и снимков без новых ключей читаются через Свойство
// со значениями по умолчанию (необязательный, пусто) - resume старого снимка
// не падает (см. мПунктПоле).
//
// Статус пункта - Строка, одно из: pending | in_progress | done | skipped |
// removed. Значение removed присваивается только функцией Применить пунктам,
// исчезнувшим из нового списка LLM (обязательные пункты не снимаются - см.
// СтатусПриСлиянии). Неизвестное/пустое значение статуса от LLM трактуется как
// pending - модуль не бросает исключений на плохом входе, это
// ответственность вызывающей стороны (PLAN-03) интерпретировать invalid_steps.
//
// См. спеку: .docs/specs/PLAN-02.md, .docs/specs/PLAN-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создаёт пустой План.
//
// Отправная точка при первом вызове update_plan в рамках запуска (когда в
// Состояние ещё нет ключа План).
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив, пустой), Усечено (Булево, Ложь).
//
Функция НовыйПлан() Экспорт

	Возврат Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

КонецФункции

// Сливает предыдущий План с новым списком пунктов от LLM.
//
// Основная функция модуля: применяет нормализацию входа, защиту от
// «раззакрытия» и лимиты к результату слияния.
//
// Закрытые (done) пункты не «раззакрываются» повторным вызовом с более ранним
// статусом от LLM - защита от того, что LLM прислала план заново, забыв
// прогресс. Пункты, пропавшие из нового списка LLM, не удаляются молча, а
// помечаются статусом removed. Мусорные элементы входа пропускаются без
// исключения (по образцу устойчивого разбора
// ar_RuntimeЦикл.ЗапомнитьОписанныеTools).
//
// Параметры:
//  ПредыдущийПлан - Структура - текущий План (см. НовыйПлан). Любой другой тип
//                    трактуется как отсутствие плана (используется пустой).
//  ПунктыИзLLM    - Массив    - сырые структуры {title, status}, уже
//                    десериализованные из JSON вызывающей стороной. Любой
//                    другой тип (Неопределено и т.п.) трактуется как пустой
//                    список.
//
// Возвращаемое значение:
//  Структура - новый План: поля Пункты (Массив), Усечено (Булево).
//
Функция Применить(Знач ПредыдущийПлан, Знач ПунктыИзLLM) Экспорт

	Возврат ПрименитьВнутр(ПредыдущийПлан, ПунктыИзLLM, Ложь);

КонецФункции

// Общий механизм Применить с управлением пропуском обязательных пунктов
// (agentrunner-48): РазрешитьПропускОбязательных = Истина разрешает статус
// skipped от LLM для обязательных пунктов (вызывается только из
// ПрименитьСПричиной, где у вызова подтверждён непустой note).
//
Функция ПрименитьВнутр(Знач ПредыдущийПлан, Знач ПунктыИзLLM, Знач РазрешитьПропускОбязательных)

	ПредыдущиеПункты = ПунктыПредыдущегоПлана(ПредыдущийПлан);

	// Шаг 1. Нормализация входа LLM: фильтрация мусора, обрезка заголовка,
	// нормализация статуса, ограничение количества.
	НормализацияВхода = НормализоватьПунктыLLM(ПунктыИзLLM);
	НормализованныеПункты = НормализацияВхода.Пункты;
	Усечено = НормализацияВхода.Усечено;

	// Если после фильтрации мусора не осталось ни одного валидного пункта -
	// предыдущий план возвращается как есть, Усечено не взводится по этой
	// причине (мусор - не усечение).
	Если НормализованныеПункты.Количество() = 0 Тогда
		Возврат Новый Структура("Пункты, Усечено", ПредыдущиеПункты, Ложь);
	КонецЕсли;

	// Шаг 2-3. Слияние нормализованных пунктов LLM с предыдущим планом и
	// перенос пропавших пунктов в removed.
	СлитыеПункты = СлитьСПредыдущимПланом(НормализованныеПункты, ПредыдущиеПункты, РазрешитьПропускОбязательных);

	// Шаг 4. Лимит в 12 пунктов применяется к результату целиком.
	ОбрезкаРезультата = ОбрезатьДоЛимита(СлитыеПункты);
	Если ОбрезкаРезультата.Усечено Тогда
		Усечено = Истина;
	КонецЕсли;

	Возврат Новый Структура("Пункты, Усечено", ОбрезкаРезультата.Пункты, Усечено);

КонецФункции

// Возвращает текущий выполняемый пункт плана.
//
// Используется для отображения этапа выполнения оператору (PLAN-06, PLAN-07).
//
// Приоритет: первый пункт со статусом in_progress, при отсутствии - первый
// pending, при отсутствии обоих - Неопределено (план пуст, либо все пункты в
// done/skipped/removed).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура, Неопределено - пункт {Заголовок, Статус} или Неопределено.
//
Функция ТекущийПункт(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПервыйPending = Неопределено;

	// Прочие статусы (done, skipped, removed) на выбор текущего пункта не
	// влияют - пропускаются: ни одно из двух условий ниже для них не
	// срабатывает.
	Для Каждого Пункт Из План.Пункты Цикл

		Если Пункт.Статус = "in_progress" Тогда
			Возврат Пункт;
		КонецЕсли;

		Если Пункт.Статус = "pending" И ПервыйPending = Неопределено Тогда
			ПервыйPending = Пункт;
		КонецЕсли;

	КонецЦикла;

	Возврат ПервыйPending;

КонецФункции

// Считает прогресс плана.
//
// Результат - прямой источник для ресурсов ar_ЭтаповВсего/ar_ЭтаповЗакрыто в
// ar_Запуски (запись делает вызывающая сторона, PLAN-04).
//
// Всего  - количество пунктов, статус которых не removed (снятые пункты не
//          входят в знаменатель, иначе прогресс визуально «откатывается
//          назад» при снятии пункта).
// Закрыто - количество пунктов со статусом done среди них же.
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура - поля: Всего (Число), Закрыто (Число).
//
Функция Прогресс(Знач План) Экспорт

	Всего  = 0;
	Закрыто = 0;

	Если ТипЗнч(План) = Тип("Структура")
		И План.Свойство("Пункты")
		И ТипЗнч(План.Пункты) = Тип("Массив") Тогда

		Для Каждого Пункт Из План.Пункты Цикл
			Если Пункт.Статус = "removed" Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если Пункт.Статус = мСтатусЗакрыт() Тогда
				Закрыто = Закрыто + 1;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура("Всего, Закрыто", Всего, Закрыто);

КонецФункции

// Разбирает одну строку шаблона плана в пункт плана (agentrunner-48, п. 1.1).
//
// Формат: "Заголовок | инструмент1, инструмент2 | Инструкция шага".
// Разделитель - "|"; вторая и третья части необязательны. Ведущие маркеры
// списка ("- ", "* ", "• ", "N. ", "N) ") перед заголовком снимаются, как и
// раньше. Имена инструментов: СокрЛП, пустые отбрасываются, регистр не
// меняется. Инструкция - СокрЛП, обрезается до мМаксДлинаИнструкции().
// Пункт с непустым списком инструментов - обязательный.
//
// Общая функция разбора для ядра (ar_RuntimeЦикл) и импорта пресетов
// (ar_ПресетыИмпорт) - чтобы разбор не дублировался (спека п. 1.9).
//
// Параметры:
//  СтрокаПункта - Строка - одна строка реквизита ar_Агенты.ar_ШаблонПлана.
//
// Возвращаемое значение:
//  Структура - поля: Заголовок (Строка, СокрЛП, без маркера), Обязательный
//  (Булево), ЗакрывающиеИнструменты (Массив из Строка), Инструкция (Строка).
//
Функция РазобратьСтрокуШаблона(Знач СтрокаПункта) Экспорт

	Части = СтрРазделить(СтрокаПункта, "|", Ложь);

	Заголовок = СнятьМаркерЗаголовка(
		?(Части.Количество() > 0, Части[0], ""));

	ЗакрывающиеИнструменты = Новый Массив;
	Если Части.Количество() > 1 Тогда
		Для Каждого ИмяTool Из СтрРазделить(Части[1], ",", Ложь) Цикл
			ИмяTool = СокрЛП(ИмяTool);
			Если Не ПустаяСтрока(ИмяTool) Тогда
				ЗакрывающиеИнструменты.Добавить(ИмяTool);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Инструкция = "";
	Если Части.Количество() > 2 Тогда
		Инструкция = СокрЛП(Части[2]);
		Если СтрДлина(Инструкция) > мМаксДлинаИнструкции() Тогда
			Инструкция = Лев(Инструкция, мМаксДлинаИнструкции());
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Заголовок, Обязательный, ЗакрывающиеИнструменты, Инструкция",
		Заголовок,
		(ЗакрывающиеИнструменты.Количество() > 0),
		ЗакрывающиеИнструменты,
		Инструкция);

КонецФункции

// Строит план из разобранных пунктов шаблона карточки агента (agentrunner-48,
// п. 1.3). Лимиты применяет сам (12 пунктов, 150 символов заголовка) - единый
// источник правил с планом модели; при посеве первый незакрытый обязательный
// пункт получает статус in_progress.
//
// Параметры:
//  ПунктыШаблона - Массив из Структура - элементы РазобратьСтрокуШаблона
//                  (Заголовок, Обязательный, ЗакрывающиеИнструменты,
//                  Инструкция).
//
// Возвращаемое значение:
//  Структура - см. НовыйПлан; Усечено = Истина, если пунктов шаблона было
//  больше лимита или заголовок обрезан.
//
Функция ПланИзПунктовШаблона(Знач ПунктыШаблона) Экспорт

	Пункты = Новый Массив;
	Усечено = Ложь;

	Если ТипЗнч(ПунктыШаблона) <> Тип("Массив") Тогда
		Возврат Новый Структура("Пункты, Усечено", Пункты, Ложь);
	КонецЕсли;

	Для Каждого ПунктШаблона Из ПунктыШаблона Цикл

		Если Пункты.Количество() >= мМаксПунктов() Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;

		Заголовок = СокрЛП(Строка(мПунктПоле(ПунктШаблона, "Заголовок", "")));
		Если ПустаяСтрока(Заголовок) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДлина(Заголовок) > мМаксДлинаЗаголовка() Тогда
			Заголовок = Лев(Заголовок, мМаксДлинаЗаголовка());
			Усечено = Истина;
		КонецЕсли;

		Пункты.Добавить(НовыйПункт(Заголовок, "pending",
			(мПунктПоле(ПунктШаблона, "Обязательный", Ложь) = Истина),
			ИнструментыИзПоля(мПунктПоле(ПунктШаблона, "ЗакрывающиеИнструменты", Неопределено)),
			Строка(мПунктПоле(ПунктШаблона, "Инструкция", ""))));

	КонецЦикла;

	План = Новый Структура("Пункты, Усечено", Пункты, Усечено);
	ОткрытьПервыйОбязательный(План);
	Возврат План;

КонецФункции

// Первый незакрытый обязательный пункт плана (agentrunner-48, п. 1.4/1.6).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура - поля: Пункт (Структура), Номер (Число, 1-based по порядку
//  пунктов плана, removed не нумеруются); Неопределено, если незакрытого
//  обязательного пункта нет (все закрыты либо план без обязательных).
//
Функция ТекущийОбязательныйПункт(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номер = 0;
	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
			И (Статус = "pending" Или Статус = "in_progress") Тогда
			Возврат Новый Структура("Пункт, Номер", Пункт, Номер);
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Есть ли в плане хотя бы один обязательный пункт (agentrunner-48, п. 1.1 -
// признак обязательного режима). Незакрытость не важна: режим определяется
// конфигурацией плана, а не прогрессом.
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОбязательныеПункты(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Пункт Из План.Пункты Цикл
		Если мПунктПоле(Пункт, "Обязательный", Ложь) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Закрывает первый незакрытый обязательный пункт, в списке закрывающих
// инструментов которого есть ИмяИнструмента (agentrunner-48, п. 1.4): пункт
// получает done и ЗакрытИнструментом, следующий незакрытый обязательный -
// in_progress. Мутирует План.
//
// Параметры:
//  План           - Структура - план (изменяется на месте).
//  ИмяИнструмента - Строка    - имя успешно вызванной tool.
//
// Возвращаемое значение:
//  Структура - поля: Закрыт (Булево), Номер (Число, 1-based), Заголовок
//  (Строка); при Закрыт = Ложь Номер = 0, Заголовок = "".
//
Функция ЗакрытьШагИнструментом(План, Знач ИмяИнструмента) Экспорт

	Результат = Новый Структура("Закрыт, Номер, Заголовок", Ложь, 0, "");

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
			И (Статус = "pending" Или Статус = "in_progress")
			И ИнструментыИзПоля(мПунктПоле(Пункт, "ЗакрывающиеИнструменты", Неопределено)).Найти(
				ИмяИнструмента) <> Неопределено Тогда

			Пункт.Статус = "done";
			Пункт.Вставить("ЗакрытИнструментом", ИмяИнструмента);
			Результат.Закрыт = Истина;
			Результат.Номер = Номер;
			Результат.Заголовок = Строка(мПунктПоле(Пункт, "Заголовок", ""));
			Прервать;

		КонецЕсли;

	КонецЦикла;

	Если Результат.Закрыт Тогда
		ОткрытьПервыйОбязательный(План);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет гейт инструментов обязательного плана (agentrunner-48, п. 1.5):
// инструмент, входящий в список закрывающих хотя бы одного обязательного
// пункта, разрешён, только если для пункта S с этим инструментом все
// предыдущие обязательные пункты закрыты (done/skipped). Повторный вызов
// инструмента уже закрытого шага разрешён (все предыдущие закрыты).
//
// Параметры:
//  План           - Структура - см. НовыйПлан/Применить.
//  ИмяИнструмента - Строка    - имя вызываемой tool.
//
// Возвращаемое значение:
//  Структура - поля: Разрешено (Булево), Номер (Число - номер первого
//  незакрытого обязательного шага при Разрешено = Ложь, иначе 0), Заголовок
//  (Строка), Инструкция (Строка), ЗакрывающиеИнструменты (Массив - список
//  инструментов шага отказа; при Разрешено = Истина пустой).
//
Функция ГейтРазрешитИнструмент(Знач План, Знач ИмяИнструмента) Экспорт

	Результат = Новый Структура("Разрешено, Номер, Заголовок, Инструкция, ЗакрывающиеИнструменты",
		Истина, 0, "", "", Новый Массив);

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Номер = 0;
	ПервыйНезакрытый = Неопределено;

	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если мПунктПоле(Пункт, "Обязательный", Ложь) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Если Статус = "pending" Или Статус = "in_progress" Тогда
			Если ПервыйНезакрытый = Неопределено Тогда
				ПервыйНезакрытый = Новый Структура("Номер, Пункт", Номер, Пункт);
			КонецЕсли;
		КонецЕсли;

		Если ИнструментыИзПоля(мПунктПоле(Пункт, "ЗакрывающиеИнструменты", Неопределено)).Найти(
			ИмяИнструмента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Инструмент принадлежит этому шагу: разрешён, только если все
		// предыдущие обязательные пункты закрыты - незакрытых до этого шага
		// нет, а сам шаг либо первый незакрытый (свой шаг), либо закрытый
		// (повторный вызов инструмента закрытого шага, п. 1.5).
		Если ПервыйНезакрытый = Неопределено Или ПервыйНезакрытый.Номер = Номер Тогда
			Возврат Результат;
		КонецЕсли;

	КонецЦикла;

	Если ПервыйНезакрытый <> Неопределено Тогда
		Результат.Разрешено = Ложь;
		Результат.Номер = ПервыйНезакрытый.Номер;
		Результат.Заголовок = Строка(мПунктПоле(ПервыйНезакрытый.Пункт, "Заголовок", ""));
		Результат.Инструкция = Строка(мПунктПоле(ПервыйНезакрытый.Пункт, "Инструкция", ""));
		Результат.ЗакрывающиеИнструменты = ИнструментыИзПоля(
			мПунктПоле(ПервыйНезакрытый.Пункт, "ЗакрывающиеИнструменты", Неопределено));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сливает предыдущий план с новым списком пунктов от LLM, разрешая пропуск
// обязательных пунктов с причиной (agentrunner-48, п. 1.7). Вызывается циклом
// вместо Применить, когда в аргументах update_plan был непустой note: пункты
// обязательных шагов, присланные со статусом skipped, применяются, а
// ПричинаПропуска пустых заполненных skipped - заполняется причиной.
//
// Параметры:
//  ПредыдущийПлан  - Структура - текущий План (см. НовыйПлан).
//  ПунктыИзLLM     - Массив    - сырые структуры {title, status}.
//  ПричинаПропуска - Строка    - непустой note вызова update_plan.
//
// Возвращаемое значение:
//  Структура - новый План: поля Пункты (Массив), Усечено (Булево).
//
Функция ПрименитьСПричиной(Знач ПредыдущийПлан, Знач ПунктыИзLLM, Знач ПричинаПропуска) Экспорт

	План = ПрименитьВнутр(ПредыдущийПлан, ПунктыИзLLM, Истина);

	Если ПустаяСтрока(ПричинаПропуска) Тогда
		Возврат План;
	КонецЕсли;

	Для Каждого Пункт Из План.Пункты Цикл
		Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
			И Пункт.Статус = "skipped"
			И ПустаяСтрока(Строка(мПунктПоле(Пункт, "ПричинаПропуска", ""))) Тогда
			Пункт.Вставить("ПричинаПропуска", ПричинаПропуска);
		КонецЕсли;
	КонецЦикла;

	Возврат План;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Максимальное количество пунктов в плане (вход LLM и результат слияния).
//
// Возвращаемое значение:
//  Число - лимит пунктов (12).
//
Функция мМаксПунктов()
	Возврат 12;
КонецФункции

// Максимальная длина заголовка пункта плана в символах.
//
// Возвращаемое значение:
//  Число - лимит символов (150).
//
Функция мМаксДлинаЗаголовка()
	Возврат 150;
КонецФункции

// Максимальная длина инструкции шага ("мини-промпта") в символах
// (agentrunner-48, п. 1.1).
//
// Возвращаемое значение:
//  Число - лимит символов (500).
//
Функция мМаксДлинаИнструкции()
	Возврат 500;
КонецФункции

// Значение статуса "пункт закрыт" - используется в нескольких местах модуля
// (защита от «раззакрытия», подсчёт прогресса, нормализация входа).
//
// Возвращаемое значение:
//  Строка - "done".
//
Функция мСтатусЗакрыт()
	Возврат "done";
КонецФункции

// Конструктор пункта плана с полным набором ключей (agentrunner-48).
//
// Параметры:
//  Заголовок              - Строка  - заголовок пункта.
//  Статус                 - Строка  - pending | in_progress | done | skipped | removed.
//  Обязательный           - Булево  - признак обязательного шага.
//  ЗакрывающиеИнструменты - Массив  - имена закрывающих tools.
//  Инструкция             - Строка  - "мини-промпт" шага.
//
// Возвращаемое значение:
//  Структура - пункт плана (см. шапку модуля).
//
Функция НовыйПункт(Знач Заголовок, Знач Статус, Знач Обязательный,
	Знач ЗакрывающиеИнструменты, Знач Инструкция)

	Возврат Новый Структура(
		"Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты, Инструкция, ПричинаПропуска, ЗакрытИнструментом",
		Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты, Инструкция, "", "");

КонецФункции

// Поле пункта плана с защитой от старых снимков: пункт без ключа (или пункт не
// Структура) даёт дефолт, исключения нет (agentrunner-48, п. 1.2).
//
// Параметры:
//  Пункт   - Структура, Произвольный - пункт плана.
//  Имя     - Строка    - имя ключа.
//  Дефолт  - Произвольный - значение при отсутствии ключа/некорректном типе.
//
// Возвращаемое значение:
//  Произвольный.
//
Функция мПунктПоле(Знач Пункт, Знач Имя, Знач Дефолт)

	Если ТипЗнч(Пункт) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;

	Значение = Неопределено;
	Если Не Пункт.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Копия списка закрывающих инструментов пункта: массив строк; не массив,
// мусорные элементы и пустые имена отбрасываются. Копия обязательна - поле
// старого снимка может переиспользоваться в новом пункте.
//
// Параметры:
//  ЗначениеПоля - Массив, Произвольный - поле ЗакрывающиеИнструменты.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ИнструментыИзПоля(Знач ЗначениеПоля)

	Результат = Новый Массив;
	Если ТипЗнч(ЗначениеПоля) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИмяTool Из ЗначениеПоля Цикл
		Если ТипЗнч(ИмяTool) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(ИмяTool)) Тогда
			Результат.Добавить(СокрЛП(ИмяTool));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переводит первый незакрытый обязательный пункт плана в in_progress
// (agentrunner-48, п. 1.3/1.4); прочие незакрытые обязательные остаются в
// pending. Закрытые статусы (done/skipped) не трогаются.
//
// Параметры:
//  План - Структура - план (изменяется на месте).
//
Процедура ОткрытьПервыйОбязательный(Знач План)

	Открыт = Ложь;

	Для Каждого Пункт Из План.Пункты Цикл

		Если мПунктПоле(Пункт, "Обязательный", Ложь) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус <> "pending" И Статус <> "in_progress" Тогда
			Продолжить;
		КонецЕсли;

		Если Не Открыт Тогда
			Пункт.Статус = "in_progress";
			Открыт = Истина;
		ИначеЕсли Пункт.Статус = "in_progress" Тогда
			Пункт.Статус = "pending";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Снимает ведущий маркер списка с заголовка пункта шаблона ("- ", "* ", "• ",
// "N. ", "N) ") - прежняя логика ПунктыИзШаблонаПлана ar_RuntimeЦикл, перенесена
// сюда, чтобы разбор строки шаблона был общим для ядра и импорта пресетов.
//
// Параметры:
//  СыройЗаголовок - Строка - первая часть строки шаблона до "|".
//
// Возвращаемое значение:
//  Строка - заголовок без маркера, СокрЛП.
//
Функция СнятьМаркерЗаголовка(Знач СыройЗаголовок)

	Заголовок = СокрЛП(СыройЗаголовок);

	// Маркерные: "- ", "* ", "• " (маркер и следующий за ним пробел).
	Если СтрНачинаетсяС(Заголовок, "- ")
		Или СтрНачинаетсяС(Заголовок, "* ")
		Или СтрНачинаетсяС(Заголовок, "• ") Тогда
		Возврат СокрЛП(Сред(Заголовок, 3));
	КонецЕсли;

	// Нумерованные: цифры, затем "." или ")" и пробел. Без пробела
	// после маркера строка не трогается - это просто число (например
	// год "2026") или текст, начинающийся с числа.
	Позиция = 1;
	Пока Позиция <= СтрДлина(Заголовок)
		И КодСимвола(Заголовок, Позиция) >= КодСимвола("0")
		И КодСимвола(Заголовок, Позиция) <= КодСимвола("9") Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция > 1 И Позиция < СтрДлина(Заголовок)
		И (Сред(Заголовок, Позиция, 1) = "." Или Сред(Заголовок, Позиция, 1) = ")")
		И Сред(Заголовок, Позиция + 1, 1) = " " Тогда
		Возврат СокрЛП(Сред(Заголовок, Позиция + 1));
	КонецЕсли;

	Возврат Заголовок;

КонецФункции

// Возвращает массив пунктов предыдущего плана, устойчиво к некорректному
// или отсутствующему входу (План отсутствует, не Структура, без ключа
// Пункты или Пункты не Массив трактуются как пустой список).
//
// Параметры:
//  ПредыдущийПлан - Структура, Произвольный - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Массив - пункты предыдущего плана (может быть пустым).
//
Функция ПунктыПредыдущегоПлана(Знач ПредыдущийПлан)

	Если ТипЗнч(ПредыдущийПлан) <> Тип("Структура")
		Или Не ПредыдущийПлан.Свойство("Пункты")
		Или ТипЗнч(ПредыдущийПлан.Пункты) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ПредыдущийПлан.Пункты;

КонецФункции

// Нормализует сырой список пунктов от LLM: отбрасывает мусорные элементы,
// обрезает заголовок и ограничивает количество пунктов лимитом
// мМаксПунктов().
//
// Параметры:
//  ПунктыИзLLM - Массив, Произвольный - сырые структуры {title, status}.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив нормализованных {Заголовок, Статус}),
//  Усечено (Булево).
//
Функция НормализоватьПунктыLLM(Знач ПунктыИзLLM)

	Результат = Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

	Если ТипЗнч(ПунктыИзLLM) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементLLM Из ПунктыИзLLM Цикл

		Если Результат.Пункты.Количество() >= мМаксПунктов() Тогда
			Результат.Усечено = Истина;
			Продолжить;
		КонецЕсли;

		НормализованныйПункт = НормализоватьПунктLLM(ЭлементLLM);
		Если НормализованныйПункт = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НормализованныйПункт.Усечено Тогда
			Результат.Усечено = Истина;
		КонецЕсли;

		Результат.Пункты.Добавить(НормализованныйПункт.Пункт);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует один элемент входного массива LLM. Возвращает Неопределено,
// если элемент - мусор (не Структура, без title, title не строка или пуст).
//
// Параметры:
//  ЭлементLLM - Произвольный - один элемент массива ПунктыИзLLM.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля: Пункт {Заголовок, Статус}, Усечено
//  (Булево, признак обрезки заголовка), либо Неопределено для мусора.
//
Функция НормализоватьПунктLLM(Знач ЭлементLLM)

	Если ТипЗнч(ЭлементLLM) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЭлементLLM.Свойство("title") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначениеЗаголовка = ЭлементLLM.title;
	Если ТипЗнч(ЗначениеЗаголовка) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = СокрЛП(ЗначениеЗаголовка);
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УсеченоЗаголовок = Ложь;
	Если СтрДлина(Заголовок) > мМаксДлинаЗаголовка() Тогда
		Заголовок = Лев(Заголовок, мМаксДлинаЗаголовка());
		УсеченоЗаголовок = Истина;
	КонецЕсли;

	ЗначениеСтатуса = Неопределено;
	Если ЭлементLLM.Свойство("status") Тогда
		ЗначениеСтатуса = ЭлементLLM.status;
	КонецЕсли;
	Статус = НормализоватьСтатус(ЗначениеСтатуса);

	Пункт = Новый Структура("Заголовок, Статус", Заголовок, Статус);

	Возврат Новый Структура("Пункт, Усечено", Пункт, УсеченоЗаголовок);

КонецФункции

// Сливает нормализованные пункты LLM с предыдущим планом: закрытые (done)
// пункты не раззакрываются, пропавшие пункты переносятся в конец со
// статусом removed (не дублируются, если уже были removed).
//
// Правила обязательных пунктов (agentrunner-48, п. 1.7):
//  * обязательный пункт, пропавший из списка LLM, не удаляется - остаётся
//    как есть (removed не присваивается);
//  * done от модели для незакрытого обязательного пункта игнорируется -
//    статус прежний (шаг закрывается только инструментом);
//  * skipped обязательного пункта применяется только при
//    РазрешитьПропускОбязательных = Истина (иначе статус прежний);
//  * условие закрытия (Обязательный, ЗакрывающиеИнструменты, Инструкция)
//    переносится из предыдущего пункта - статус меняет модель, конфигурацию
//    шага модель менять не может.
//
// Параметры:
//  НормализованныеПункты          - Массив - результат НормализоватьПунктыLLM.Пункты.
//  ПредыдущиеПункты               - Массив - результат ПунктыПредыдущегоПлана.
//  РазрешитьПропускОбязательных   - Булево - Истина разрешает skipped
//                                   обязательных пунктов (ПрименитьСПричиной).
//
// Возвращаемое значение:
//  Массив - результирующие пункты {Заголовок, Статус, ...}, снятые
//  необязательные пункты - в конце.
//
Функция СлитьСПредыдущимПланом(Знач НормализованныеПункты, Знач ПредыдущиеПункты,
	Знач РазрешитьПропускОбязательных)

	// Индекс предыдущих пунктов по нормализованному заголовку для поиска O(1).
	ПредыдущиеПоЗаголовку = Новый Соответствие;
	Для Каждого ПредыдущийПункт Из ПредыдущиеПункты Цикл
		Ключ = НРег(СокрЛП(ПредыдущийПункт.Заголовок));
		Если ПредыдущиеПоЗаголовку.Получить(Ключ) = Неопределено Тогда
			ПредыдущиеПоЗаголовку.Вставить(Ключ, ПредыдущийПункт);
		КонецЕсли;
	КонецЦикла;

	ВстреченныеЗаголовки = Новый Соответствие;
	РезультирующиеПункты = Новый Массив;

	Для Каждого Пункт Из НормализованныеПункты Цикл

		Ключ = НРег(Пункт.Заголовок);
		ВстреченныеЗаголовки.Вставить(Ключ, Истина);

		Найденный = ПредыдущиеПоЗаголовку.Получить(Ключ);
		ИтоговыйСтатус = СтатусПриСлиянии(Найденный, Пункт.Статус, РазрешитьПропускОбязательных);

		РезультирующиеПункты.Добавить(ПунктПриСлиянии(Пункт.Заголовок, ИтоговыйСтатус, Найденный));

	КонецЦикла;

	Для Каждого ПредыдущийПункт Из ПредыдущиеПункты Цикл
		Ключ = НРег(СокрЛП(ПредыдущийПункт.Заголовок));
		Если ВстреченныеЗаголовки.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Обязательный пункт не удаляется пропуском в присланном списке -
		// остаётся как есть (agentrunner-48, п. 1.7).
		Если мПунктПоле(ПредыдущийПункт, "Обязательный", Ложь) = Истина Тогда
			РезультирующиеПункты.Добавить(ПунктПриСлиянии(
				ПредыдущийПункт.Заголовок, ПредыдущийПункт.Статус, ПредыдущийПункт));
			Продолжить;
		КонецЕсли;

		РезультирующиеПункты.Добавить(ПунктПриСлиянии(ПредыдущийПункт.Заголовок, "removed", ПредыдущийПункт));
	КонецЦикла;

	Возврат РезультирующиеПункты;

КонецФункции

// Пункт результата слияния: заголовок и статус от слияния, конфигурация шага
// (Обязательный, ЗакрывающиеИнструменты, Инструкция, ПричинаПропуска,
// ЗакрытИнструментом) - от найденного предыдущего пункта, если он был
// (agentrunner-48, п. 1.2). Новые пункты модели - необязательные.
//
// Параметры:
//  Заголовок       - Строка    - заголовок пункта результата.
//  Статус          - Строка    - статус пункта результата.
//  ПредыдущийПункт - Структура, Неопределено - пункт предыдущего плана с тем
//                    же заголовком.
//
// Возвращаемое значение:
//  Структура - пункт плана (см. шапку модуля).
//
Функция ПунктПриСлиянии(Знач Заголовок, Знач Статус, Знач ПредыдущийПункт)

	Если ПредыдущийПункт = Неопределено Тогда
		Возврат НовыйПункт(Заголовок, Статус, Ложь, Новый Массив, "");
	КонецЕсли;

	Пункт = НовыйПункт(Заголовок, Статус,
		(мПунктПоле(ПредыдущийПункт, "Обязательный", Ложь) = Истина),
		ИнструментыИзПоля(мПунктПоле(ПредыдущийПункт, "ЗакрывающиеИнструменты", Неопределено)),
		Строка(мПунктПоле(ПредыдущийПункт, "Инструкция", "")));

	// Факты закрытия сохраняются: причина пропуска skipped и инструмент
	// закрытия done - не конфигурация шага, модель их не задаёт (п. 1.2/1.7).
	Пункт.ПричинаПропуска = Строка(мПунктПоле(ПредыдущийПункт, "ПричинаПропуска", ""));
	Пункт.ЗакрытИнструментом = Строка(мПунктПоле(ПредыдущийПункт, "ЗакрытИнструментом", ""));
	Возврат Пункт;

КонецФункции

// Решает итоговый статус пункта при слиянии одного пункта LLM с найденным
// (или не найденным) пунктом предыдущего плана. Защита от «раззакрытия»:
// если найденный пункт уже done, а новый статус LLM - не done и не skipped,
// статус сохраняется done.
//
// Правила обязательных пунктов (agentrunner-48, п. 1.7): done от модели для
// незакрытого обязательного пункта игнорируется (шаг закрывается только
// инструментом); skipped обязательного пункта применяется только при
// РазрешитьПропускОбязательных = Истина.
//
// Параметры:
//  НайденныйПредыдущийПункт     - Структура, Неопределено - пункт предыдущего
//                                 плана с тем же заголовком, либо Неопределено.
//  СтатусLLM                    - Строка - нормализованный статус от LLM.
//  РазрешитьПропускОбязательных - Булево - Истина разрешает skipped
//                                 обязательных пунктов (ПрименитьСПричиной).
//
// Возвращаемое значение:
//  Строка - итоговый статус пункта.
//
Функция СтатусПриСлиянии(Знач НайденныйПредыдущийПункт, Знач СтатусLLM, Знач РазрешитьПропускОбязательных)

	Если НайденныйПредыдущийПункт = Неопределено Тогда
		Возврат СтатусLLM;
	КонецЕсли;

	Обязательный = (мПунктПоле(НайденныйПредыдущийПункт, "Обязательный", Ложь) = Истина);

	Если Обязательный Тогда
		СтатусПредыдущий = Строка(мПунктПоле(НайденныйПредыдущийПункт, "Статус", "pending"));
		Незакрыт = (СтатусПредыдущий = "pending" Или СтатусПредыдущий = "in_progress");

		// done обязательного шага от модели игнорируется.
		Если Незакрыт И СтатусLLM = мСтатусЗакрыт() Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		// skipped обязательного шага - только с причиной (ПрименитьСПричиной).
		Если Незакрыт И СтатусLLM = "skipped" И Не РазрешитьПропускОбязательных Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		// Закрытый (done/skipped) обязательный пункт не раззакрывается.
		Если Не Незакрыт И СтатусLLM <> мСтатусЗакрыт() И СтатусLLM <> "skipped" Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		Возврат СтатусLLM;
	КонецЕсли;

	НайденЗакрытым = НайденныйПредыдущийПункт.Статус = мСтатусЗакрыт();
	ПопыткаОткатаНазад = СтатусLLM <> мСтатусЗакрыт() И СтатусLLM <> "skipped";

	Если НайденЗакрытым И ПопыткаОткатаНазад Тогда
		Возврат мСтатусЗакрыт();
	КонецЕсли;

	Возврат СтатусLLM;

КонецФункции

// Обрезает список пунктов до лимита мМаксПунктов(). Не мутирует вход,
// возвращает новый список.
//
// Сначала обрезаются лишние removed-пункты (с конца списка, как наименее
// ценная информация для оператора), затем, если лимит всё ещё превышен, -
// остаток списка с конца целиком. Порядок оставшихся пунктов сохраняется
// таким же, как во входном списке.
//
// Параметры:
//  Пункты - Массив - список пунктов {Заголовок, Статус} до обрезки.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив, не длиннее мМаксПунктов()), Усечено
//  (Булево, Истина, если вход превышал лимит).
//
Функция ОбрезатьДоЛимита(Знач Пункты)

	Если Пункты.Количество() <= мМаксПунктов() Тогда
		Возврат Новый Структура("Пункты, Усечено", Пункты, Ложь);
	КонецЕсли;

	Избыток = Пункты.Количество() - мМаксПунктов();
	ИсключитьНомер = НомераДляИсключения(Пункты, Избыток);

	Оставшиеся = Новый Массив;
	Для Номер = 0 По Пункты.Количество() - 1 Цикл
		Если ИсключитьНомер.Получить(Номер) = Неопределено Тогда
			Оставшиеся.Добавить(Пункты[Номер]);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Пункты, Усечено", Оставшиеся, Истина);

КонецФункции

// Определяет порядковые номера (0-based, от начала списка) пунктов, которые
// нужно исключить, чтобы убрать Избыток штук: сначала removed-пункты с
// конца списка (наименее ценная информация), затем, если removed не
// хватило, - любые оставшиеся пункты, тоже с конца.
//
// Параметры:
//  Пункты  - Массив - список пунктов {Заголовок, Статус}.
//  Избыток - Число  - сколько пунктов нужно исключить.
//
// Возвращаемое значение:
//  Соответствие - ключи: номера пунктов для исключения (значение - Истина).
//
Функция НомераДляИсключения(Знач Пункты, Знач Избыток)

	ИсключитьНомер = Новый Соответствие;
	Оставшийся = Избыток;

	// Проход 1: removed-пункты с конца.
	Для Каждого НомерИПункт Из НумерованныеСКонца(Пункты) Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если НомерИПункт.Пункт.Статус = "removed" Тогда
			ИсключитьНомер.Вставить(НомерИПункт.Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	// Проход 2: если removed не хватило - добираем любыми пунктами с конца.
	Для Каждого НомерИПункт Из НумерованныеСКонца(Пункты) Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ИсключитьНомер.Получить(НомерИПункт.Номер) = Неопределено Тогда
			ИсключитьНомер.Вставить(НомерИПункт.Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат ИсключитьНомер;

КонецФункции

// Возвращает элементы списка вместе с их порядковыми номерами (0-based, от
// начала списка), но в порядке обхода от конца списка к началу.
//
// Параметры:
//  Пункты - Массив - исходный список.
//
// Возвращаемое значение:
//  Массив - структур {Номер (Число), Пункт (Структура)}, в порядке от
//  последнего элемента исходного списка к первому.
//
Функция НумерованныеСКонца(Знач Пункты)

	Результат = Новый Массив;
	Всего = Пункты.Количество();

	Для Смещение = 1 По Всего Цикл
		Номер = Всего - Смещение;
		Результат.Добавить(Новый Структура("Номер, Пункт", Номер, Пункты[Номер]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует значение статуса пункта, пришедшее от LLM, к одному из четырёх
// допустимых значений входа (pending, in_progress, done, skipped). Неизвестное
// или пустое значение (включая любой тип, кроме Строка) трактуется как pending
// - мусор не должен ронять обработку.
//
// Параметры:
//  ЗначениеСтатуса - Произвольный - сырое значение ключа "status".
//
// Возвращаемое значение:
//  Строка - pending | in_progress | done | skipped.
//
Функция НормализоватьСтатус(Знач ЗначениеСтатуса)

	Если ТипЗнч(ЗначениеСтатуса) <> Тип("Строка") Тогда
		Возврат "pending";
	КонецЕсли;

	Статус = НРег(СокрЛП(ЗначениеСтатуса));

	Если Статус = "in_progress"
		Или Статус = мСтатусЗакрыт()
		Или Статус = "skipped" Тогда
		Возврат Статус;
	КонецЕсли;

	Возврат "pending";

КонецФункции

#КонецОбласти
