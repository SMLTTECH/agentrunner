////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПланЗапуска (План запуска).
//
// Чистый вычислительный слой между tool update_plan (PLAN-03) и циклом рантайма
// (ar_RuntimeЦикл, PLAN-04): формат внутреннего представления плана, слияние
// пунктов, присланных LLM, с ранее сохраненным состоянием и подсчет прогресса.
//
// Модуль чистый: не читает и не пишет ИБ (нет Запрос, нет обращений к
// Справочники./Документы./РегистрыСведений.), не устанавливает привилегированный
// режим, не делает HTTP, не вызывает Выполнить/Вычислить, не вызывает ar_JSON —
// работает только с уже десериализованными платформенными типами (Структура,
// Массив), сериализация в JSON и обратно — ответственность вызывающих модулей
// (PLAN-03, PLAN-04).
//
// Контракт «План» (Структура):
//   Пункты  - Массив из Структур - не более 12 элементов (см. НовыйПункт).
//   Усечено - Булево - признак усечения списка пунктов и/или текста заголовка.
//
// Пункт плана (Структура, agentrunner-48):
//   Заголовок            - Строка          - до 150 символов.
//   Статус               - Строка          - pending | in_progress | done |
//                                            skipped | removed.
//   Обязательный          - Булево          - шаг закрывается только вызовом
//                                            одного из ЗакрывающиеИнструменты
//                                            или явным пропуском с причиной.
//   ЗакрывающиеИнструменты - Массив из Строка - имена tools, успешный вызов
//                                            которых закрывает шаг.
//   Инструкция            - Строка          - "мини-промпт" шага, до 500 символов.
//   ПричинаПропуска       - Строка          - причина skipped обязательного шага.
//   ЗакрытИнструментом    - Строка          - имя tool, закрывшего шаг (done).
//   Шаблонный             - Булево          - пункт из шаблона пресета (agentrunner-107):
//                                            не удаляется слиянием и не обрезается
//                                            лимитом. Ключ отсутствует у пунктов
//                                            планов до agentrunner-107 - такой пункт
//                                            читается как шаблонный (см. ШаблонныйПункт).
//
// Пункты старых состояний и снимков без новых ключей читаются через Свойство
// со значениями по умолчанию (необязательный, пусто) - resume старого снимка
// не падает (см. мПунктПоле).
//
// Статус пункта - Строка, одно из: pending | in_progress | done | skipped |
// removed. Значение removed присваивается только функцией Применить пунктам,
// исчезнувшим из нового списка LLM (обязательные пункты не снимаются - см.
// СтатусПриСлиянии). Неизвестное/пустое значение статуса от LLM трактуется как
// pending - модуль не бросает исключений на плохом входе, это
// ответственность вызывающей стороны (PLAN-03) интерпретировать invalid_steps.
//
// См. спеку: .docs/specs/PLAN-02.md, .docs/specs/PLAN-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создает пустой План.
//
// Отправная точка при первом вызове update_plan в рамках запуска (когда в
// Состояние еще нет ключа План).
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив, пустой), Усечено (Булево, Ложь).
//
Функция НовыйПлан() Экспорт

	Возврат Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

КонецФункции

// Сливает предыдущий План с новым списком пунктов от LLM.
//
// Основная функция модуля: применяет нормализацию входа, защиту от
// «раззакрытия» и лимиты к результату слияния.
//
// Закрытые (done) пункты не «раззакрываются» повторным вызовом с более ранним
// статусом от LLM - защита от того, что LLM прислала план заново, забыв
// прогресс. Пункты, пропавшие из нового списка LLM, не удаляются молча, а
// помечаются статусом removed. Мусорные элементы входа пропускаются без
// исключения (по образцу устойчивого разбора
// ar_RuntimeЦикл.ЗапомнитьОписанныеTools).
//
// Параметры:
//  ПредыдущийПлан - Структура - текущий План (см. НовыйПлан). Любой другой тип
//                    трактуется как отсутствие плана (используется пустой).
//  ПунктыИзLLM    - Массив    - сырые структуры {title, status}, уже
//                    десериализованные из JSON вызывающей стороной. Любой
//                    другой тип (Неопределено и т.п.) трактуется как пустой
//                    список.
//
// Возвращаемое значение:
//  Структура - новый План: поля Пункты (Массив), Усечено (Булево).
//
Функция Применить(Знач ПредыдущийПлан, Знач ПунктыИзLLM) Экспорт

	Предупреждения = Новый Массив;
	Результат = ПрименитьВнутр(ПредыдущийПлан, ПунктыИзLLM, Ложь, Предупреждения);
	Возврат Новый Структура("Пункты, Усечено", Результат.Пункты, Результат.Усечено);

КонецФункции

// Применяет пункты LLM к плану и возвращает отчет о непримененных пунктах
// (agentrunner-66, спека Б.2): Предупреждения - пункты модели со статусом
// skipped/done, не примененные к незакрытым обязательным шагам (для warnings
// в ответе update_plan).
//
// Параметры:
//  ПредыдущийПлан  - Структура - текущий План (см. НовыйПлан).
//  ПунктыИзLLM     - Массив    - сырые структуры {title, status}.
//  ПричинаПропуска - Строка    - непустой note вызова update_plan; пустой note
//                    пропуск обязательных шагов не разрешает (спека Б.1 -
//                    критерий 5: без note шаг не изменен, в ответе warnings).
//
// Возвращаемое значение:
//  Структура {План - Структура ("Пункты, Усечено"), Предупреждения - Массив из
//  Структура {Номер, Заголовок, Инструменты, СтатусМодели, Текст}}; Текст - готовая
//  строка предупреждения (обрезка плана; пункт модели вне шаблона, agentrunner-366),
//  пусто - предупреждение о непримененном статусе шага.
//
Функция ПрименитьСОтчетом(Знач ПредыдущийПлан, Знач ПунктыИзLLM, Знач ПричинаПропуска) Экспорт

	Предупреждения = Новый Массив;
	Результат = ПрименитьВнутр(ПредыдущийПлан, ПунктыИзLLM,
		НЕ ПустаяСтрока(ПричинаПропуска), Предупреждения);

	План = Новый Структура("Пункты, Усечено", Результат.Пункты, Результат.Усечено);

	Если НЕ ПустаяСтрока(ПричинаПропуска) Тогда
		Для Каждого Пункт Из План.Пункты Цикл
			Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
				И Пункт.Статус = "skipped"
				И ПустаяСтрока(Строка(мПунктПоле(Пункт, "ПричинаПропуска", ""))) Тогда
				Пункт.Вставить("ПричинаПропуска", ПричинаПропуска);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("План, Предупреждения", План, Предупреждения);

КонецФункции

// Общий механизм Применить с управлением пропуском обязательных пунктов
// (agentrunner-48): РазрешитьПропускОбязательных = Истина разрешает статус
// skipped от LLM для обязательных пунктов. Предупреждения - выходной параметр
// (Массив): непримененные skipped/done обязательных шагов (agentrunner-66,
// спека Б.2).
//
Функция ПрименитьВнутр(Знач ПредыдущийПлан, Знач ПунктыИзLLM, Знач РазрешитьПропускОбязательных,
	Предупреждения)

	Если Предупреждения = Неопределено Тогда
		Предупреждения = Новый Массив;
	КонецЕсли;

	ПредыдущиеПункты = ПунктыПредыдущегоПлана(ПредыдущийПлан);

	// Шаг 1. Нормализация входа LLM: фильтрация мусора, обрезка заголовка,
	// нормализация статуса, ограничение количества.
	НормализацияВхода = НормализоватьПунктыLLM(ПунктыИзLLM);
	НормализованныеПункты = НормализацияВхода.Пункты;
	Усечено = НормализацияВхода.Усечено;

	// Если после фильтрации мусора не осталось ни одного валидного пункта -
	// предыдущий план возвращается как есть, Усечено не взводится по этой
	// причине (мусор - не усечение).
	Если НормализованныеПункты.Количество() = 0 Тогда
		Возврат Новый Структура("Пункты, Усечено", ПредыдущиеПункты, Ложь);
	КонецЕсли;

	// Шаг 2-3. Слияние нормализованных пунктов LLM с предыдущим планом и
	// перенос пропавших пунктов в removed.
	СлитыеПункты = СлитьСПредыдущимПланом(НормализованныеПункты, ПредыдущиеПункты,
		РазрешитьПропускОбязательных, Предупреждения);

	// Шаг 4. Лимит в 12 пунктов применяется к результату целиком; обрезка
	// никогда не затрагивает шаблонные пункты - невозможность уложиться в
	// лимит уходит в предупреждение (agentrunner-107, п.2).
	ОбрезкаРезультата = ОбрезатьДоЛимита(СлитыеПункты, Предупреждения);
	Если ОбрезкаРезультата.Усечено Тогда
		Усечено = Истина;
	КонецЕсли;

	Возврат Новый Структура("Пункты, Усечено", ОбрезкаРезультата.Пункты, Усечено);

КонецФункции

// Возвращает текущий выполняемый пункт плана.
//
// Используется для отображения этапа выполнения оператору (PLAN-06, PLAN-07).
//
// Приоритет: первый пункт со статусом in_progress, при отсутствии - первый
// pending, при отсутствии обоих - Неопределено (план пуст, либо все пункты в
// done/skipped/removed).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура, Неопределено - пункт {Заголовок, Статус} или Неопределено.
//
Функция ТекущийПункт(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПервыйPending = Неопределено;

	// Прочие статусы (done, skipped, removed) на выбор текущего пункта не
	// влияют - пропускаются: ни одно из двух условий ниже для них не
	// срабатывает.
	Для Каждого Пункт Из План.Пункты Цикл

		Если Пункт.Статус = "in_progress" Тогда
			Возврат Пункт;
		КонецЕсли;

		Если Пункт.Статус = "pending" И ПервыйPending = Неопределено Тогда
			ПервыйPending = Пункт;
		КонецЕсли;

	КонецЦикла;

	Возврат ПервыйPending;

КонецФункции

// Считает прогресс плана.
//
// Результат - прямой источник для ресурсов ar_ЭтаповВсего/ar_ЭтаповЗакрыто в
// ar_Запуски (запись делает вызывающая сторона, PLAN-04).
//
// Всего  - количество пунктов, статус которых не removed (снятые пункты не
//          входят в знаменатель, иначе прогресс визуально «откатывается
//          назад» при снятии пункта).
// Закрыто - количество закрытых пунктов среди них же: done и skipped (пункт,
//          пропущенный моделью или закрытый ядром пропуском при терминальном
//          исходе, тоже пройден - иначе выполненный запуск показывал «6/9»).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура - поля: Всего (Число), Закрыто (Число).
//
Функция Прогресс(Знач План) Экспорт

	Всего  = 0;
	Закрыто = 0;

	Если ТипЗнч(План) = Тип("Структура")
		И План.Свойство("Пункты")
		И ТипЗнч(План.Пункты) = Тип("Массив") Тогда

		Для Каждого Пункт Из План.Пункты Цикл
			Если Пункт.Статус = "removed" Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если Пункт.Статус = мСтатусЗакрыт() Или Пункт.Статус = "skipped" Тогда
				Закрыто = Закрыто + 1;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура("Всего, Закрыто", Всего, Закрыто);

КонецФункции

// Разбирает одну строку шаблона плана в пункт плана (agentrunner-48, п. 1.1).
//
// Формат: "Заголовок | инструмент1, инструмент2 | Инструкция шага".
// Разделитель - "|"; вторая и третья части необязательны. Ведущие маркеры
// списка ("- ", "* ", "• ", "N. ", "N) ") перед заголовком снимаются, как и
// раньше. Имена инструментов: СокрЛП, пустые отбрасываются, регистр не
// меняется. Инструкция - СокрЛП, обрезается до мМаксДлинаИнструкции().
// Пункт с непустым списком инструментов - обязательный.
//
// Общая функция разбора для ядра (ar_RuntimeЦикл) и импорта пресетов
// (ar_ПресетыИмпорт) - чтобы разбор не дублировался (спека п. 1.9).
//
// Параметры:
//  СтрокаПункта - Строка - одна строка реквизита ar_Агенты.ar_ШаблонПлана.
//
// Возвращаемое значение:
//  Структура - поля: Заголовок (Строка, СокрЛП, без маркера), Обязательный
//  (Булево), ЗакрывающиеИнструменты (Массив из Строка), Инструкция (Строка).
//
Функция РазобратьСтрокуШаблона(Знач СтрокаПункта) Экспорт

	Части = СтрРазделить(СтрокаПункта, "|", Ложь);

	Заголовок = СнятьМаркерЗаголовка(
		?(Части.Количество() > 0, Части[0], ""));

	ЗакрывающиеИнструменты = Новый Массив;
	Если Части.Количество() > 1 Тогда
		Для Каждого ИмяИнструмента Из СтрРазделить(Части[1], ",", Ложь) Цикл
			ИмяИнструмента = СокрЛП(ИмяИнструмента);
			Если Не ПустаяСтрока(ИмяИнструмента) Тогда
				ЗакрывающиеИнструменты.Добавить(ИмяИнструмента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Инструкция = "";
	Если Части.Количество() > 2 Тогда
		Инструкция = СокрЛП(Части[2]);
		Если СтрДлина(Инструкция) > мМаксДлинаИнструкции() Тогда
			Инструкция = Лев(Инструкция, мМаксДлинаИнструкции());
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Заголовок, Обязательный, ЗакрывающиеИнструменты, Инструкция",
		Заголовок,
		(ЗакрывающиеИнструменты.Количество() > 0),
		ЗакрывающиеИнструменты,
		Инструкция);

КонецФункции

// Строит план из разобранных пунктов шаблона карточки агента (agentrunner-48,
// п. 1.3). Лимиты применяет сам (12 пунктов, 150 символов заголовка) - единый
// источник правил с планом модели; при посеве первый незакрытый обязательный
// пункт получает статус in_progress.
//
// Параметры:
//  ПунктыШаблона - Массив из Структура - элементы РазобратьСтрокуШаблона
//                  (Заголовок, Обязательный, ЗакрывающиеИнструменты,
//                  Инструкция).
//
// Возвращаемое значение:
//  Структура - см. НовыйПлан; Усечено = Истина, если пунктов шаблона было
//  больше лимита или заголовок обрезан.
//
Функция ПланИзПунктовШаблона(Знач ПунктыШаблона) Экспорт

	Пункты = Новый Массив;
	Усечено = Ложь;

	Если ТипЗнч(ПунктыШаблона) <> Тип("Массив") Тогда
		Возврат Новый Структура("Пункты, Усечено", Пункты, Ложь);
	КонецЕсли;

	Для Каждого ПунктШаблона Из ПунктыШаблона Цикл

		Если Пункты.Количество() >= мМаксПунктов() Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;

		Заголовок = СокрЛП(Строка(мПунктПоле(ПунктШаблона, "Заголовок", "")));
		Если ПустаяСтрока(Заголовок) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДлина(Заголовок) > мМаксДлинаЗаголовка() Тогда
			Заголовок = Лев(Заголовок, мМаксДлинаЗаголовка());
			Усечено = Истина;
		КонецЕсли;

		ПунктШага = НовыйПункт(Заголовок, "pending",
			(мПунктПоле(ПунктШаблона, "Обязательный", Ложь) = Истина),
			ИнструментыИзПоля(мПунктПоле(ПунктШаблона, "ЗакрывающиеИнструменты", Неопределено)),
			Строка(мПунктПоле(ПунктШаблона, "Инструкция", "")));
		// agentrunner-107 (п.2): пункты шаблона пресета защищены от удаления
		// слиянием и от обрезки лимитом.
		ПунктШага.Шаблонный = Истина;
		Пункты.Добавить(ПунктШага);

	КонецЦикла;

	План = Новый Структура("Пункты, Усечено", Пункты, Усечено);
	ОткрытьПервыйОбязательный(План);
	Возврат План;

КонецФункции

// Первый незакрытый обязательный пункт плана (agentrunner-48, п. 1.4/1.6).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура - поля: Пункт (Структура), Номер (Число, 1-based по порядку
//  пунктов плана, removed не нумеруются); Неопределено, если незакрытого
//  обязательного пункта нет (все закрыты либо план без обязательных).
//
Функция ТекущийОбязательныйПункт(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номер = 0;
	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
			И (Статус = "pending" Или Статус = "in_progress") Тогда
			Возврат Новый Структура("Пункт, Номер", Пункт, Номер);
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Есть ли в плане хотя бы один обязательный пункт (agentrunner-48, п. 1.1 -
// признак обязательного режима). Незакрытость не важна: режим определяется
// конфигурацией плана, а не прогрессом.
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОбязательныеПункты(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Пункт Из План.Пункты Цикл
		Если мПунктПоле(Пункт, "Обязательный", Ложь) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Закрыт ли план полностью (agentrunner-211, п. 2): среди пунктов есть хотя бы
// один обязательный и нет ни одного незакрытого (pending/in_progress) - все
// пункты done/skipped/removed. Такой план означает: работа запуска по шаблону
// сделана, продолжение было бы новой работой под чужим планом.
//
// План без обязательных пунктов (составленный моделью) и планы некорректного
// вида (не Структура, без Массива Пункты, пустые) дают Ложь - правило надзора
// «план закрыт» на них не действует.
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПланЗакрытПолностью(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	ЕстьОбязательный = Ложь;
	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "pending" Или Статус = "in_progress" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если мПунктПоле(Пункт, "Обязательный", Ложь) = Истина Тогда
			ЕстьОбязательный = Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат ЕстьОбязательный;

КонецФункции

// Закрывает первый незакрытый обязательный пункт, в списке закрывающих
// инструментов которого есть ИмяИнструмента (agentrunner-48, п. 1.4): пункт
// получает done и ЗакрытИнструментом, следующий незакрытый обязательный -
// in_progress. Мутирует План.
//
// Параметры:
//  План           - Структура - план (изменяется на месте).
//  ИмяИнструмента - Строка    - имя успешно вызванной tool.
//
// Возвращаемое значение:
//  Структура - поля: Закрыт (Булево), Номер (Число, 1-based), Заголовок
//  (Строка); при Закрыт = Ложь Номер = 0, Заголовок = "".
//
Функция ЗакрытьШагИнструментом(План, Знач ИмяИнструмента) Экспорт

	Результат = Новый Структура("Закрыт, Номер, Заголовок", Ложь, 0, "");

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Пункт Из План.Пункты Цикл

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
			И (Статус = "pending" Или Статус = "in_progress")
			И ИнструментыИзПоля(мПунктПоле(Пункт, "ЗакрывающиеИнструменты", Неопределено)).Найти(
				ИмяИнструмента) <> Неопределено Тогда

			Пункт.Статус = "done";
			Пункт.Вставить("ЗакрытИнструментом", ИмяИнструмента);
			Результат.Закрыт = Истина;
			Результат.Номер = Номер;
			Результат.Заголовок = Строка(мПунктПоле(Пункт, "Заголовок", ""));
			Прервать;

		КонецЕсли;

	КонецЦикла;

	Если Результат.Закрыт Тогда
		ОткрытьПервыйОбязательный(План);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет гейт инструментов обязательного плана (agentrunner-48, п. 1.5):
// ограничиваются только инструменты, входящие в списки закрывающих
// обязательных пунктов; инструмент вне всех списков (update_plan, ask_user,
// nsi_pending_visas, files_get_text, ...) разрешен всегда. Инструмент шага S
// разрешен, если сам S - первый незакрытый обязательный пункт (очередь шага)
// либо закрыт (повторный вызов); если у шага есть незакрытые предыдущие -
// отказ с данными первого незакрытого шага.
//
// Параметры:
//  План           - Структура - см. НовыйПлан/Применить.
//  ИмяИнструмента - Строка    - имя вызываемой tool.
//
// Возвращаемое значение:
//  Структура - поля: Разрешено (Булево), Номер (Число - номер первого
//  незакрытого обязательного шага при Разрешено = Ложь, иначе 0), Заголовок
//  (Строка), Инструкция (Строка), ЗакрывающиеИнструменты (Массив - список
//  инструментов шага отказа; при Разрешено = Истина пустой).
//
Функция ГейтРазрешитИнструмент(Знач План, Знач ИмяИнструмента) Экспорт

	Результат = Новый Структура("Разрешено, Номер, Заголовок, Инструкция, ЗакрывающиеИнструменты",
		Истина, 0, "", "", Новый Массив);

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	// Первый незакрытый обязательный пункт (очередь шагов) - общая функция
	// плана; Неопределено, когда все обязательные закрыты.
	Очередь = ТекущийОбязательныйПункт(План);

	Номер = 0;
	ОчередьШагаНеПришла = Ложь;

	Для Каждого Пункт Из План.Пункты Цикл

		Если Строка(мПунктПоле(Пункт, "Статус", "pending")) = "removed" Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;

		Если мПунктПоле(Пункт, "Обязательный", Ложь) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Если ИнструментыИзПоля(мПунктПоле(Пункт, "ЗакрывающиеИнструменты", Неопределено)).Найти(
			ИмяИнструмента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Инструмент принадлежит этому шагу: его шаг закрыт (повторный вызов,
		// п. 1.5 - очередь позже шага) либо сам первый незакрытый - разрешено.
		// Незакрытый шаг раньше очереди - отказ; отказ откладывается до конца
		// цикла: шаг с тем же инструментом ниже может разрешить вызов.
		Если Очередь = Неопределено Или Очередь.Номер >= Номер Тогда
			Возврат Результат;
		КонецЕсли;
		ОчередьШагаНеПришла = Истина;

	КонецЦикла;

	// Отказ - только инструменту шага, до которого очередь не дошла
	// (ОчередьШагаНеПришла возможна лишь при незакрытых обязательных шагах:
	// Очередь здесь заведомо заполнена).
	Если ОчередьШагаНеПришла Тогда
		Результат.Разрешено = Ложь;
		Результат.Номер = Очередь.Номер;
		Результат.Заголовок = Строка(мПунктПоле(Очередь.Пункт, "Заголовок", ""));
		Результат.Инструкция = Строка(мПунктПоле(Очередь.Пункт, "Инструкция", ""));
		Результат.ЗакрывающиеИнструменты = ИнструментыИзПоля(
			мПунктПоле(Очередь.Пункт, "ЗакрывающиеИнструменты", Неопределено));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сливает предыдущий план с новым списком пунктов от LLM, разрешая пропуск
// обязательных пунктов с причиной (agentrunner-48, п. 1.7; agentrunner-66,
// спека Б.1): пропуск обязательного шага разрешен только при непустом
// ПричинаПропуска; пункты обязательных шагов со статусом skipped применяются
// с заполнением ПричинаПропуска.
//
// Параметры:
//  ПредыдущийПлан  - Структура - текущий План (см. НовыйПлан).
//  ПунктыИзLLM     - Массив    - сырые структуры {title, status}.
//  ПричинаПропуска - Строка    - note вызова update_plan.
//
// Возвращаемое значение:
//  Структура - новый План: поля Пункты (Массив), Усечено (Булево).
//
Функция ПрименитьСПричиной(Знач ПредыдущийПлан, Знач ПунктыИзLLM, Знач ПричинаПропуска) Экспорт

	Возврат ПрименитьСОтчетом(ПредыдущийПлан, ПунктыИзLLM, ПричинаПропуска).План;

КонецФункции

// Закрывает все незакрытые обязательные пункты плана статусом skipped с общей
// причиной (agentrunner-107, п.1 - терминальный исход инструмента): после
// возвращения инструментом terminal = true модель не может закрыть шаги сама,
// ядро закрывает их пропуском; ТекущийОбязательныйПункт после этого вернет
// Неопределено, гейт итога пропускает финальный ответ. Пункты done не
// затрагиваются. Мутирует План.
//
// Параметры:
//  План            - Структура - план (изменяется на месте).
//  ПричинаПропуска - Строка    - причина пропуска (terminal_reason инструмента);
//                    пустая допустима - причина шага останется пустой.
//
// Возвращаемое значение:
//  Структура - поля: Закрыто (Число - сколько незакрытых обязательных пунктов
//  переведено в skipped).
//
Функция ЗакрытьНезакрытыеОбязательныеПропуском(План, Знач ПричинаПропуска) Экспорт

	Результат = Новый Структура("Закрыто", 0);

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пункт Из План.Пункты Цикл

		Если НЕ НезакрытыйОбязательныйПункт(Пункт) Тогда
			Продолжить;
		КонецЕсли;

		Пункт.Статус = "skipped";
		Пункт.Вставить("ПричинаПропуска", ПричинаПропуска);
		Результат.Закрыто = Результат.Закрыто + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Закрывает план при принятом итоговом ответе (agentrunner-363): пункт
// in_progress - done (модель вела его и завершила работу итоговым ответом),
// пункт pending - skipped с причиной (шаг не понадобился, например «Разобрать
// спорные пункты» без спорных пунктов). Обязательные пункты к этому моменту
// уже закрыты гейтом итога, поэтому функция закрывает необязательные: без
// неё завершенный запуск показывал прогресс «10/12» и первый pending-пункт
// как текущий этап. Пункты done, skipped, removed не затрагиваются. Мутирует План.
//
// Параметры:
//  План            - Структура - план (изменяется на месте).
//  ПричинаПропуска - Строка    - причина для пунктов, переведенных в skipped.
//
// Возвращаемое значение:
//  Структура - поля: Выполнено (Число - in_progress переведено в done),
//  Пропущено (Число - pending переведено в skipped).
//
Функция ЗакрытьНезакрытыеПриЗавершении(План, Знач ПричинаПропуска) Экспорт

	Результат = Новый Структура("Выполнено, Пропущено", 0, 0);

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пункт Из План.Пункты Цикл

		Если ТипЗнч(Пункт) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус = "in_progress" Тогда
			Пункт.Вставить("Статус", мСтатусЗакрыт());
			Результат.Выполнено = Результат.Выполнено + 1;
		ИначеЕсли Статус = "pending" Тогда
			Пункт.Вставить("Статус", "skipped");
			Пункт.Вставить("ПричинаПропуска", ПричинаПропуска);
			Результат.Пропущено = Результат.Пропущено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Максимальное количество пунктов в плане (вход LLM и результат слияния).
//
// Возвращаемое значение:
//  Число - лимит пунктов (12).
//
Функция мМаксПунктов()
	Возврат 12;
КонецФункции

// Максимальная длина заголовка пункта плана в символах.
//
// Возвращаемое значение:
//  Число - лимит символов (150).
//
Функция мМаксДлинаЗаголовка()
	Возврат 150;
КонецФункции

// Максимальная длина инструкции шага ("мини-промпта") в символах
// (agentrunner-48, п. 1.1).
//
// Возвращаемое значение:
//  Число - лимит символов (500).
//
Функция мМаксДлинаИнструкции()
	Возврат 500;
КонецФункции

// Значение статуса "пункт закрыт" - используется в нескольких местах модуля
// (защита от «раззакрытия», подсчет прогресса, нормализация входа).
//
// Возвращаемое значение:
//  Строка - "done".
//
Функция мСтатусЗакрыт()
	Возврат "done";
КонецФункции

// Конструктор пункта плана с полным набором ключей (agentrunner-48).
//
// Параметры:
//  Заголовок              - Строка  - заголовок пункта.
//  Статус                 - Строка  - pending | in_progress | done | skipped | removed.
//  Обязательный           - Булево  - признак обязательного шага.
//  ЗакрывающиеИнструменты - Массив  - имена закрывающих tools.
//  Инструкция             - Строка  - "мини-промпт" шага.
//
// Возвращаемое значение:
//  Структура - пункт плана (см. шапку модуля); Шаблонный = Ложь - шаблонные
//  пункты помечает ПланИзПунктовШаблона, слияние наследует флаг.
//
Функция НовыйПункт(Знач Заголовок, Знач Статус, Знач Обязательный,
	Знач ЗакрывающиеИнструменты, Знач Инструкция)

	Возврат Новый Структура(
		"Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты, Инструкция, ПричинаПропуска, ЗакрытИнструментом, Шаблонный",
		Заголовок, Статус, Обязательный, ЗакрывающиеИнструменты, Инструкция, "", "", Ложь);

КонецФункции

// Поле пункта плана с защитой от старых снимков: пункт без ключа (или пункт не
// Структура) дает дефолт, исключения нет (agentrunner-48, п. 1.2).
//
// Параметры:
//  Пункт   - Структура, Произвольный - пункт плана.
//  Имя     - Строка    - имя ключа.
//  Дефолт  - Произвольный - значение при отсутствии ключа/некорректном типе.
//
// Возвращаемое значение:
//  Произвольный.
//
Функция мПунктПоле(Знач Пункт, Знач Имя, Знач Дефолт)

	Если ТипЗнч(Пункт) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;

	Значение = Неопределено;
	Если Не Пункт.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Копия списка закрывающих инструментов пункта: массив строк; не массив,
// мусорные элементы и пустые имена отбрасываются. Копия обязательна - поле
// старого снимка может переиспользоваться в новом пункте.
//
// Параметры:
//  ЗначениеПоля - Массив, Произвольный - поле ЗакрывающиеИнструменты.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ИнструментыИзПоля(Знач ЗначениеПоля)

	Результат = Новый Массив;
	Если ТипЗнч(ЗначениеПоля) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИмяИнструмента Из ЗначениеПоля Цикл
		Если ТипЗнч(ИмяИнструмента) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(ИмяИнструмента)) Тогда
			Результат.Добавить(СокрЛП(ИмяИнструмента));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переводит первый незакрытый обязательный пункт плана в in_progress
// (agentrunner-48, п. 1.3/1.4); прочие незакрытые обязательные остаются в
// pending. Закрытые статусы (done/skipped) не трогаются.
//
// Параметры:
//  План - Структура - план (изменяется на месте).
//
Процедура ОткрытьПервыйОбязательный(Знач План)

	Открыт = Ложь;

	Для Каждого Пункт Из План.Пункты Цикл

		Если мПунктПоле(Пункт, "Обязательный", Ложь) <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Статус = Строка(мПунктПоле(Пункт, "Статус", "pending"));
		Если Статус <> "pending" И Статус <> "in_progress" Тогда
			Продолжить;
		КонецЕсли;

		Если Не Открыт Тогда
			Пункт.Статус = "in_progress";
			Открыт = Истина;
		ИначеЕсли Пункт.Статус = "in_progress" Тогда
			Пункт.Статус = "pending";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Снимает ведущий маркер списка с заголовка пункта шаблона ("- ", "* ", "• ",
// "N. ", "N) ") - прежняя логика ПунктыИзШаблонаПлана ar_RuntimeЦикл, перенесена
// сюда, чтобы разбор строки шаблона был общим для ядра и импорта пресетов.
//
// Параметры:
//  СыройЗаголовок - Строка - первая часть строки шаблона до "|".
//
// Возвращаемое значение:
//  Строка - заголовок без маркера, СокрЛП.
//
Функция СнятьМаркерЗаголовка(Знач СыройЗаголовок)

	Заголовок = СокрЛП(СыройЗаголовок);

	// Маркерные: "- ", "* ", "• " (маркер и следующий за ним пробел).
	Если СтрНачинаетсяС(Заголовок, "- ")
		Или СтрНачинаетсяС(Заголовок, "* ")
		Или СтрНачинаетсяС(Заголовок, "• ") Тогда
		Возврат СокрЛП(Сред(Заголовок, 3));
	КонецЕсли;

	// Нумерованные: цифры, затем "." или ")" и пробел. Без пробела
	// после маркера строка не трогается - это просто число (например
	// год "2026") или текст, начинающийся с числа.
	Позиция = 1;
	Пока Позиция <= СтрДлина(Заголовок)
		И КодСимвола(Заголовок, Позиция) >= КодСимвола("0")
		И КодСимвола(Заголовок, Позиция) <= КодСимвола("9") Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция > 1 И Позиция < СтрДлина(Заголовок)
		И (Сред(Заголовок, Позиция, 1) = "." Или Сред(Заголовок, Позиция, 1) = ")")
		И Сред(Заголовок, Позиция + 1, 1) = " " Тогда
		Возврат СокрЛП(Сред(Заголовок, Позиция + 1));
	КонецЕсли;

	Возврат Заголовок;

КонецФункции

// Возвращает массив пунктов предыдущего плана, устойчиво к некорректному
// или отсутствующему входу (План отсутствует, не Структура, без ключа
// Пункты или Пункты не Массив трактуются как пустой список).
//
// Параметры:
//  ПредыдущийПлан - Структура, Произвольный - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Массив - пункты предыдущего плана (может быть пустым).
//
Функция ПунктыПредыдущегоПлана(Знач ПредыдущийПлан)

	Если ТипЗнч(ПредыдущийПлан) <> Тип("Структура")
		Или Не ПредыдущийПлан.Свойство("Пункты")
		Или ТипЗнч(ПредыдущийПлан.Пункты) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ПредыдущийПлан.Пункты;

КонецФункции

// Нормализует сырой список пунктов от LLM: отбрасывает мусорные элементы,
// обрезает заголовок и ограничивает количество пунктов лимитом
// мМаксПунктов().
//
// Параметры:
//  ПунктыИзLLM - Массив, Произвольный - сырые структуры {title, status}.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив нормализованных {Заголовок, Статус}),
//  Усечено (Булево).
//
Функция НормализоватьПунктыLLM(Знач ПунктыИзLLM)

	Результат = Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

	Если ТипЗнч(ПунктыИзLLM) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементLLM Из ПунктыИзLLM Цикл

		Если Результат.Пункты.Количество() >= мМаксПунктов() Тогда
			Результат.Усечено = Истина;
			Продолжить;
		КонецЕсли;

		НормализованныйПункт = НормализоватьПунктLLM(ЭлементLLM);
		Если НормализованныйПункт = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НормализованныйПункт.Усечено Тогда
			Результат.Усечено = Истина;
		КонецЕсли;

		Результат.Пункты.Добавить(НормализованныйПункт.Пункт);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует один элемент входного массива LLM. Возвращает Неопределено,
// если элемент - мусор (не Структура, без title, title не строка или пуст).
//
// Параметры:
//  ЭлементLLM - Произвольный - один элемент массива ПунктыИзLLM.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля: Пункт {Заголовок, Статус}, Усечено
//  (Булево, признак обрезки заголовка), либо Неопределено для мусора.
//
Функция НормализоватьПунктLLM(Знач ЭлементLLM)

	Если ТипЗнч(ЭлементLLM) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЭлементLLM.Свойство("title") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначениеЗаголовка = ЭлементLLM.title;
	Если ТипЗнч(ЗначениеЗаголовка) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = СокрЛП(ЗначениеЗаголовка);
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УсеченоЗаголовок = Ложь;
	Если СтрДлина(Заголовок) > мМаксДлинаЗаголовка() Тогда
		Заголовок = Лев(Заголовок, мМаксДлинаЗаголовка());
		УсеченоЗаголовок = Истина;
	КонецЕсли;

	ЗначениеСтатуса = Неопределено;
	Если ЭлементLLM.Свойство("status") Тогда
		ЗначениеСтатуса = ЭлементLLM.status;
	КонецЕсли;
	Статус = НормализоватьСтатус(ЗначениеСтатуса);

	Пункт = Новый Структура("Заголовок, Статус", Заголовок, Статус);

	Возврат Новый Структура("Пункт, Усечено", Пункт, УсеченоЗаголовок);

КонецФункции

// Сливает нормализованные пункты LLM с предыдущим планом: закрытые (done)
// пункты не раззакрываются, пропавшие пункты помечаются removed.
//
// Скелет результата - предыдущие пункты в их порядке (agentrunner-107, п.2):
// модель может дополнять план, но не переписывать порядок шаблона. Сопоставленные
// пункты обновляются на своих местах; неназванные моделью шаблонные пункты
// (обязательные и необязательные) остаются на своих местах; removed от слияния
// получают только пункты, созданные моделью. Новые пункты модели вставляются
// единой группой после последнего сопоставленного пункта предыдущего плана
// (в порядке модели); если сопоставлений нет - в конец плана (после последнего
// пункта шаблона).
//
// Сопоставление пункта модели с предыдущим пунктом (agentrunner-66, спека
// Б.1) - по порядку правил, первое совпадение:
//  1) точный заголовок без учета регистра;
//  2) нормализованный заголовок (регистр, е/е, без пробелов, пунктуации,
//     тире, слешей и скобок);
//  3) все обязательные шаги, включая закрытые (agentrunner-107, п.2):
//     нормализованный заголовок модели содержит нормализованный заголовок
//     шага или наоборот (короче 10 знаков правило не применяется);
//  4) все обязательные, включая закрытые: заголовок модели содержит имя
//     закрывающего инструмента ровно одного такого шага.
// Один предыдущий пункт сопоставляется не более чем с одному пункту модели.
// Сопоставленный пункт сохраняет заголовок шага шаблона (не модели) и его
// конфигурацию; несопоставленный пункт модели - новый необязательный, а в
// плане из шаблона пресета не добавляется - только предупреждение
// (agentrunner-366, см. ПланИзШаблона).
//
// Правила обязательных пунктов (agentrunner-48, п. 1.7):
//  * обязательный пункт, пропавший из списка LLM, не удаляется - остается
//    как есть (removed не присваивается);
//  * done от модели для незакрытого обязательного пункта игнорируется -
//    статус прежний (шаг закрывается только инструментом);
//  * skipped обязательного пункта применяется только при
//    РазрешитьПропускОбязательных = Истина (иначе статус прежний);
//  * условие закрытия (Обязательный, ЗакрывающиеИнструменты, Инструкция)
//    переносится из предыдущего пункта - статус меняет модель, конфигурацию
//    шага модель менять не может.
//
// Параметры:
//  НормализованныеПункты          - Массив - результат НормализоватьПунктыLLM.Пункты.
//  ПредыдущиеПункты               - Массив - результат ПунктыПредыдущегоПлана.
//  РазрешитьПропускОбязательных   - Булево - Истина разрешает skipped
//                                   обязательных пунктов (ПрименитьСПричиной).
//  Предупреждения                 - Массив - выходной: непримененные
//                                   skipped/done пунктов модели к незакрытым
//                                   обязательным шагам (agentrunner-66, Б.2).
//
// Возвращаемое значение:
//  Массив - результирующие пункты {Заголовок, Статус, ...} в порядке
//  предыдущего плана; группа новых пунктов модели - после последнего
//  сопоставленного.
//
Функция СлитьСПредыдущимПланом(Знач НормализованныеПункты, Знач ПредыдущиеПункты,
	Знач РазрешитьПропускОбязательных, Предупреждения)

	// Сопоставимые записи предыдущих пунктов с их номерами (1-based по
	// порядку не-removed пунктов - как нумерует ТекущийОбязательныйПункт).
	// Снятые (removed) пункты участвуют в сопоставлении и, если модель их не
	// вернула, остаются на своих местах removed (как до agentrunner-66), но не
	// нумеруются (Номер = 0).
	ЗаписиПредыдущих = Новый Массив;
	Номер = 0;
	Для Каждого ПредыдущийПункт Из ПредыдущиеПункты Цикл
		НомерПункта = 0;
		Если Строка(мПунктПоле(ПредыдущийПункт, "Статус", "pending")) <> "removed" Тогда
			Номер = Номер + 1;
			НомерПункта = Номер;
		КонецЕсли;
		ЗаписиПредыдущих.Добавить(Новый Структура("Пункт, Нормализованный, Номер, Сопоставлен, ИтоговыйСтатус",
			ПредыдущийПункт,
			мНормализованныйЗаголовок(Строка(мПунктПоле(ПредыдущийПункт, "Заголовок", ""))),
			НомерПункта, Ложь, ""));
	КонецЦикла;

	// Фаза 1: сопоставление всех пунктов модели; несопоставленные запоминаются
	// отдельно и вставляются единой группой (в порядке модели) - по позиции,
	// вычисленной ниже.
	НовыеПунктыМодели = Новый Массив;
	СопоставитьПунктыМодели(НормализованныеПункты, ЗаписиПредыдущих,
		РазрешитьПропускОбязательных, НовыеПунктыМодели, Предупреждения);

	// agentrunner-366: план из шаблона пресета задает состав шагов - пункты
	// модели без пары в шаблоне не добавляются (иначе копии шагов шаблона под
	// своими заголовками раздували план до лимита); модель получает
	// предупреждение с заголовком непринятого пункта. План без шаблона модель
	// пополняет как раньше.
	Если НовыеПунктыМодели.Количество() > 0 И ПланИзШаблона(ПредыдущиеПункты) Тогда
		Для Каждого Пункт Из НовыеПунктыМодели Цикл
			Предупреждения.Добавить(НовоеПредупреждениеПунктаВнеШаблона(Пункт.Заголовок));
		КонецЦикла;
		НовыеПунктыМодели = Новый Массив;
	КонецЕсли;

	// Фаза 2: скелет результата - предыдущие пункты в их порядке. Позиция
	// вставки новых пунктов модели - сразу после последнего сопоставленного
	// предыдущего пункта; сопоставлений нет - в конец плана.
	ПозицияВставки = ЗаписиПредыдущих.Количество();
	Для Индекс = 0 По ЗаписиПредыдущих.ВГраница() Цикл
		Если ЗаписиПредыдущих[Индекс].Сопоставлен Тогда
			ПозицияВставки = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	РезультирующиеПункты = Новый Массив;

	Для Индекс = 0 По ЗаписиПредыдущих.ВГраница() Цикл

		Если Индекс = ПозицияВставки Тогда
			ДобавитьНовыеПунктыМодели(РезультирующиеПункты, НовыеПунктыМодели);
		КонецЕсли;

		ДобавитьЗаписьПредыдущегоВРезультат(РезультирующиеПункты, ЗаписиПредыдущих[Индекс]);

	КонецЦикла;

	Если ПозицияВставки >= ЗаписиПредыдущих.Количество() Тогда
		ДобавитьНовыеПунктыМодели(РезультирующиеПункты, НовыеПунктыМодели);
	КонецЕсли;

	Возврат РезультирующиеПункты;

КонецФункции

// Фаза 1 слияния: сопоставляет каждый пункт модели правилам 1-4
// (ИндексПоПравиламСопоставления) и записывает итоговый статус в свою запись
// ЗаписиПредыдущих; несопоставленные пункты модели собираются в НовыеПунктыМодели
// в порядке модели. Предупреждения о непримененных done/skipped - в Предупреждения.
//
// Параметры:
//  НормализованныеПункты        - Массив - пункты модели (НормализоватьПунктыLLM).
//  ЗаписиПредыдущих             - Массив - записи предыдущих пунктов (мутируются:
//                                 Сопоставлен, ИтоговыйСтатус).
//  РазрешитьПропускОбязательных - Булево - пропуск обязательных с причиной.
//  НовыеПунктыМодели            - Массив - выходной: несопоставленные пункты.
//  Предупреждения               - Массив - выходной: непримененные статусы.
//
Процедура СопоставитьПунктыМодели(Знач НормализованныеПункты, ЗаписиПредыдущих,
	Знач РазрешитьПропускОбязательных, НовыеПунктыМодели, Предупреждения)

	Для Каждого Пункт Из НормализованныеПункты Цикл

		Индекс = ИндексПоПравиламСопоставления(Пункт, ЗаписиПредыдущих);

		Если Индекс < 0 Тогда
			// Несопоставленный пункт модели - новый необязательный пункт.
			НовыеПунктыМодели.Добавить(Пункт);
			Продолжить;
		КонецЕсли;

		Запись = ЗаписиПредыдущих[Индекс];
		Запись.Сопоставлен = Истина;
		Запись.ИтоговыйСтатус = СтатусПриСлиянии(Запись.Пункт, Пункт.Статус, РазрешитьПропускОбязательных);

		Если Пункт.Статус <> Запись.ИтоговыйСтатус
			И (Пункт.Статус = мСтатусЗакрыт() Или Пункт.Статус = "skipped") Тогда
			Предупреждения.Добавить(НовоеПредупреждениеШага(Запись, Пункт.Статус));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Добавляет несопоставленные пункты модели в результат слияния как новые
// необязательные пункты (общий хвост двух точек вставки СлитьСПредыдущимПланом;
// за один вызов слияния срабатывает ровно одна из двух точек вставки).
//
// Параметры:
//  РезультирующиеПункты - Массив - результат слияния (мутируется).
//  НовыеПунктыМодели    - Массив - нормализованные пункты модели без сопоставления.
//
Процедура ДобавитьНовыеПунктыМодели(РезультирующиеПункты, Знач НовыеПунктыМодели)

	Для Каждого Пункт Из НовыеПунктыМодели Цикл
		РезультирующиеПункты.Добавить(ПунктПриСлиянии(Пункт.Заголовок, Пункт.Статус, Неопределено));
	КонецЦикла;

КонецПроцедуры

// Один пункт предыдущего плана - в результат слияния (общая функция фазы 2
// СлитьСПредыдущимПланом): сопоставленный обновляется итоговым статусом,
// несопоставленный обязательный и несопоставленный шаблонный остаются как есть,
// несопоставленный пункт модели помечается removed (agentrunner-107, п.2).
//
// Параметры:
//  РезультирующиеПункты - Массив - результат слияния (мутируется).
//  Запись               - Структура - запись ЗаписиПредыдущих {Пункт,
//                         Нормализованный, Номер, Сопоставлен, ИтоговыйСтатус}.
//
Процедура ДобавитьЗаписьПредыдущегоВРезультат(РезультирующиеПункты, Знач Запись)

	ЗаголовокШага = Строка(мПунктПоле(Запись.Пункт, "Заголовок", ""));

	Если Запись.Сопоставлен Тогда
		// Сопоставленный пункт сохраняет заголовок шага шаблона (не модели).
		РезультирующиеПункты.Добавить(ПунктПриСлиянии(ЗаголовокШага, Запись.ИтоговыйСтатус, Запись.Пункт));
		Возврат;
	КонецЕсли;

	// Несопоставленный предыдущий пункт остается на своем месте:
	//  - обязательный - всегда (защита от удаления, agentrunner-48 п. 1.7);
	//  - необязательный - только шаблонный (agentrunner-107, п.2); пункты,
	//    созданные моделью, помечаются removed.
	Если (мПунктПоле(Запись.Пункт, "Обязательный", Ложь) = Истина)
		Или ШаблонныйПункт(Запись.Пункт) Тогда
		РезультирующиеПункты.Добавить(ПунктПриСлиянии(ЗаголовокШага,
			Строка(мПунктПоле(Запись.Пункт, "Статус", "pending")), Запись.Пункт));
	Иначе
		РезультирующиеПункты.Добавить(ПунктПриСлиянии(ЗаголовокШага, "removed", Запись.Пункт));
	КонецЕсли;

КонецПроцедуры

// Индекс записи предыдущего пункта, сопоставленного пункту модели, по порядку
// правил Б.1 (см. СлитьСПредыдущимПланом); -1 - сопоставления нет.
//
// Параметры:
//  Пункт            - Структура - нормализованный пункт модели {Заголовок, Статус}.
//  ЗаписиПредыдущих - Массив    - записи предыдущих пунктов (см.
//                     СлитьСПредыдущимПланом).
//
// Возвращаемое значение:
//  Число - индекс в ЗаписиПредыдущих; -1, если сопоставления нет.
//
Функция ИндексПоПравиламСопоставления(Знач Пункт, Знач ЗаписиПредыдущих)

	ТочныйКлюч = НРег(СокрЛП(Строка(Пункт.Заголовок)));
	НормМодели = мНормализованныйЗаголовок(Строка(Пункт.Заголовок));
	ВерхняяГраница = ЗаписиПредыдущих.Количество() - 1;

	// Правило 1: точный заголовок без учета регистра.
	Для Индекс = 0 По ВерхняяГраница Цикл
		Запись = ЗаписиПредыдущих[Индекс];
		Если НЕ Запись.Сопоставлен
			И НРег(СокрЛП(Строка(мПунктПоле(Запись.Пункт, "Заголовок", "")))) = ТочныйКлюч Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	// Правило 2: нормализованный заголовок.
	Если НЕ ПустаяСтрока(НормМодели) Тогда
		Для Индекс = 0 По ВерхняяГраница Цикл
			Запись = ЗаписиПредыдущих[Индекс];
			Если НЕ Запись.Сопоставлен И Запись.Нормализованный = НормМодели Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Правила 3-4 применяются ко всем обязательным шагам, включая закрытые
	// (agentrunner-107, п.2: дубль вида «При необходимости - ...» к закрытому
	// обязательному не создает новый пункт, а сопоставляется ему).
	Для Индекс = 0 По ВерхняяГраница Цикл
		Запись = ЗаписиПредыдущих[Индекс];
		Если Запись.Сопоставлен Или НЕ ОбязательныйПунктСопоставления(Запись.Пункт) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаголовкиСовпадаютПодстрокой(НормМодели, Запись.Нормализованный) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	// Правило 4: инструмент в заголовке модели должен указывать ровно на
	// один обязательный шаг - иначе сопоставление двусмысленно.
	// Счёт шагов с инструментом в заголовке не зависит от кандидата - один
	// раз до цикла (иначе O(N^2)).
	Если ШаговСИнструментомВЗаголовке(Строка(Пункт.Заголовок), ЗаписиПредыдущих) <> 1 Тогда
		Возврат -1;
	КонецЕсли;
	ЗаголовокМоделиНиж = НРег(Строка(Пункт.Заголовок));
	Для Индекс = 0 По ВерхняяГраница Цикл
		Запись = ЗаписиПредыдущих[Индекс];
		Если Запись.Сопоставлен Или НЕ ОбязательныйПунктСопоставления(Запись.Пункт) Тогда
			Продолжить;
		КонецЕсли;
		Если ИнструментВЗаголовке(ЗаголовокМоделиНиж, Запись.Пункт) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Обязательный пункт, пригодный для сопоставления по правилам 3-4
// (agentrunner-107, п.2): все обязательные, включая закрытые; removed
// исключаются - снятый пункт не должен перехватывать сопоставление.
//
// Параметры:
//  Пункт - Структура, Произвольный - пункт плана.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОбязательныйПунктСопоставления(Знач Пункт)

	Возврат (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
		И Строка(мПунктПоле(Пункт, "Статус", "pending")) <> "removed";

КонецФункции

// Признак «пункт из шаблона пресета» (agentrunner-107, п.2): защита от
// удаления (removed) и обрезки лимитом. Ключ отсутствует у пунктов планов,
// построенных до agentrunner-107, - такой пункт считается шаблонным: он
// присутствовал в плане до первого update_plan модели. Побочный эффект -
// пункты моделей старых снимков тоже защищены; безопасное направление:
// лишнее удаление пункта дороже лишнего пункта в плане (лимит страхует
// предупреждение об обрезке).
//
// Параметры:
//  Пункт - Структура, Произвольный - пункт плана.
//
// Возвращаемое значение:
//  Булево.
//
Функция ШаблонныйПункт(Знач Пункт)

	Возврат мПунктПоле(Пункт, "Шаблонный", Истина) = Истина;

КонецФункции

// План построен из шаблона пресета (agentrunner-366): есть пункт с явным
// признаком Шаблонный = Истина (ПланИзПунктовШаблона). В отличие от
// ШаблонныйПункт отсутствие ключа здесь шаблоном не считается: планы снимков
// до agentrunner-107 и планы, объявленные моделью, пополняются как раньше.
//
// Параметры:
//  Пункты - Массив - пункты плана.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПланИзШаблона(Знач Пункты)

	Для Каждого Пункт Из Пункты Цикл
		Если ТипЗнч(Пункт) = Тип("Структура")
			И Пункт.Свойство("Шаблонный")
			И Пункт.Шаблонный = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Нормализованный заголовок для сопоставления (спека Б.1.2): нижний регистр,
// е -> е, без пробелов, знаков препинания, тире, слешей и скобок. Тире и
// неразрывный пробел задаются кодами - спецсимволы в литералах не используются.
//
// Параметры:
//  Заголовок - Строка - исходный заголовок пункта.
//
// Возвращаемое значение:
//  Строка - нормализованный заголовок.
//
Функция мНормализованныйЗаголовок(Знач Заголовок)

	Норм = НРег(СокрЛП(Заголовок));
	// код буквы ё: литерал с буквой ё в тексте модуля запрещён (YoLetterUsage)
	Норм = СтрЗаменить(Норм, Символ(1105), "е");

	СтрокаШума = " .,;:!?/\()[]{}«»""|*_-'" + Символ(8211) + Символ(8212) + Символ(8722)
		+ Символы.НПП + Символы.Таб;
	Для Позиция = 1 По СтрДлина(СтрокаШума) Цикл
		Норм = СтрЗаменить(Норм, Сред(СтрокаШума, Позиция, 1), "");
	КонецЦикла;

	Возврат Норм;

КонецФункции

// Совпадают ли нормализованные заголовки подстрокой (правило Б.1.3): одно
// содержит другое; строки короче 10 знаков правило не применяют.
//
// Параметры:
//  НормМодели - Строка - нормализованный заголовок пункта модели.
//  НормШага   - Строка - нормализованный заголовок шага.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаголовкиСовпадаютПодстрокой(Знач НормМодели, Знач НормШага)

	Если СтрДлина(НормМодели) < 10 Или СтрДлина(НормШага) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НормМодели, НормШага) > 0
		Или СтрНайти(НормШага, НормМодели) > 0;

КонецФункции

// Сколько обязательных шагов указывает на себя закрывающим
// инструментом в заголовке модели (для однозначности правила Б.1.4;
// agentrunner-107, п.2 - считаются все обязательные, включая закрытые).
//
// Параметры:
//  ЗаголовокМодели  - Строка - заголовок модели как есть.
//  ЗаписиПредыдущих - Массив - записи предыдущих пунктов.
//
// Возвращаемое значение:
//  Число.
//
Функция ШаговСИнструментомВЗаголовке(Знач ЗаголовокМодели, Знач ЗаписиПредыдущих)

	ЗаголовокНиж = НРег(ЗаголовокМодели);
	Совпадений = 0;

	Для Каждого Запись Из ЗаписиПредыдущих Цикл
		Если НЕ Запись.Сопоставлен И ОбязательныйПунктСопоставления(Запись.Пункт)
			И ИнструментВЗаголовке(ЗаголовокНиж, Запись.Пункт) Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Совпадений;

КонецФункции

// Содержит ли заголовок модели (без учета регистра) имя одного из закрывающих
// инструментов шага.
//
// Параметры:
//  ЗаголовокНиж - Строка    - заголовок модели в нижнем регистре.
//  Пункт        - Структура - пункт предыдущего плана.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИнструментВЗаголовке(Знач ЗаголовокНиж, Знач Пункт)

	Для Каждого ИмяИнструмента Из ИнструментыИзПоля(
		мПунктПоле(Пункт, "ЗакрывающиеИнструменты", Неопределено)) Цикл

		Если СтрНайти(ЗаголовокНиж, НРег(СокрЛП(ИмяИнструмента))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Незакрытый обязательный пункт плана (pending или in_progress); пункты
// старых снимков без ключей трактуются как необязательные.
//
// Параметры:
//  Пункт - Структура, Произвольный - пункт плана.
//
// Возвращаемое значение:
//  Булево.
//
Функция НезакрытыйОбязательныйПункт(Знач Пункт)

	Если ТипЗнч(Пункт) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (мПунктПоле(Пункт, "Обязательный", Ложь) = Истина)
		И (Строка(мПунктПоле(Пункт, "Статус", "pending")) = "pending"
			Или Строка(мПунктПоле(Пункт, "Статус", "pending")) = "in_progress");

КонецФункции

// Запись предупреждения о непримененном пункте модели (agentrunner-66, спека
// Б.2): номер шага, заголовок шаблона, закрывающие инструменты, статус модели.
// Ключ Текст (agentrunner-107, п.2) - готовая строка предупреждения обрезки;
// для предупреждений слияния пустая - форматировщик вызывающей стороны строит
// текст из полей, при непустом Текст выводит его как есть.
//
// Параметры:
//  Запись       - Структура - запись предыдущего пункта (Сопоставлен = Истина).
//  СтатусМодели - Строка    - непримененный статус пункта модели.
//
// Возвращаемое значение:
//  Структура {Номер, Заголовок, Инструменты, СтатусМодели, Текст}.
//
Функция НовоеПредупреждениеШага(Знач Запись, Знач СтатусМодели)

	Возврат Новый Структура("Номер, Заголовок, Инструменты, СтатусМодели, Текст",
		Запись.Номер,
		Строка(мПунктПоле(Запись.Пункт, "Заголовок", "")),
		ИнструментыИзПоля(мПунктПоле(Запись.Пункт, "ЗакрывающиеИнструменты", Неопределено)),
		СтатусМодели, "");

КонецФункции

// Запись предупреждения о невозможности обрезки плана до лимита
// (agentrunner-107, п.2): шаблонные пункты не обрезаются никогда, поэтому
// план с большим числом обязательных/шаблонных пунктов может остаться выше
// лимита - модель получает предупреждение вместо молчаливой потери пунктов.
//
// Параметры:
//  Избыток - Число - на сколько пунктов план превышает лимит.
//
// Возвращаемое значение:
//  Структура {Номер, Заголовок, Инструменты, СтатусМодели, Текст}.
//
Функция НовоеПредупреждениеОбрезки(Знач Избыток)

	Возврат Новый Структура("Номер, Заголовок, Инструменты, СтатусМодели, Текст",
		0, "", Новый Массив, "",
		СтрШаблон(НСтр("ru = 'план превышает лимит %1 пунктов на %2, обрезка не выполнена: пункты шаблона не удаляются';
			|en = 'plan exceeds the limit of %1 items by %2, trimming skipped: template items are never removed'"),
			мМаксПунктов(), Избыток));

КонецФункции

// Запись предупреждения о непринятом пункте модели (agentrunner-366): план
// задан шаблоном пресета, пункт без пары в шаблоне в план не добавлен.
//
// Параметры:
//  ЗаголовокМодели - Строка - заголовок пункта модели.
//
// Возвращаемое значение:
//  Структура {Номер, Заголовок, Инструменты, СтатусМодели, Текст}.
//
Функция НовоеПредупреждениеПунктаВнеШаблона(Знач ЗаголовокМодели)

	Возврат Новый Структура("Номер, Заголовок, Инструменты, СтатусМодели, Текст",
		0, ЗаголовокМодели, Новый Массив, "",
		СтрШаблон(НСтр("ru = 'пункт «%1» не добавлен: план задан шаблоном агента - отмечай статусы его шагов, повторяя их заголовки дословно';
			|en = 'item ""%1"" was not added: the plan is set by the agent template - update the statuses of its steps, repeating their titles verbatim'"),
			ЗаголовокМодели));

КонецФункции

// Пункт результата слияния: заголовок и статус от слияния, конфигурация шага
// (Обязательный, ЗакрывающиеИнструменты, Инструкция, ПричинаПропуска,
// ЗакрытИнструментом, Шаблонный) - от найденного предыдущего пункта, если он
// был (agentrunner-48, п. 1.2). Новые пункты модели - необязательные,
// не шаблонные (Шаблонный = Ложь).
//
// Параметры:
//  Заголовок       - Строка    - заголовок пункта результата.
//  Статус          - Строка    - статус пункта результата.
//  ПредыдущийПункт - Структура, Неопределено - пункт предыдущего плана с тем
//                    же заголовком.
//
// Возвращаемое значение:
//  Структура - пункт плана (см. шапку модуля).
//
Функция ПунктПриСлиянии(Знач Заголовок, Знач Статус, Знач ПредыдущийПункт)

	Если ПредыдущийПункт = Неопределено Тогда
		Возврат НовыйПункт(Заголовок, Статус, Ложь, Новый Массив, "");
	КонецЕсли;

	Пункт = НовыйПункт(Заголовок, Статус,
		(мПунктПоле(ПредыдущийПункт, "Обязательный", Ложь) = Истина),
		ИнструментыИзПоля(мПунктПоле(ПредыдущийПункт, "ЗакрывающиеИнструменты", Неопределено)),
		Строка(мПунктПоле(ПредыдущийПункт, "Инструкция", "")));

	// Факты закрытия и происхождение пункта сохраняются: причина пропуска
	// skipped, инструмент закрытия done и признак «из шаблона пресета» -
	// не конфигурация шага, модель их не задает (п. 1.2/1.7; agentrunner-107,
	// п.2). Дефолт по ключу - как в ШаблонныйПункт (старые планы - шаблонные).
	Пункт.ПричинаПропуска = Строка(мПунктПоле(ПредыдущийПункт, "ПричинаПропуска", ""));
	Пункт.ЗакрытИнструментом = Строка(мПунктПоле(ПредыдущийПункт, "ЗакрытИнструментом", ""));
	Пункт.Шаблонный = ШаблонныйПункт(ПредыдущийПункт);
	Возврат Пункт;

КонецФункции

// Решает итоговый статус пункта при слиянии одного пункта LLM с найденным
// (или не найденным) пунктом предыдущего плана. Защита от «раззакрытия»:
// если найденный пункт уже done, а новый статус LLM - не done и не skipped,
// статус сохраняется done.
//
// Правила обязательных пунктов (agentrunner-48, п. 1.7): done от модели для
// незакрытого обязательного пункта игнорируется (шаг закрывается только
// инструментом); skipped обязательного пункта применяется только при
// РазрешитьПропускОбязательных = Истина.
//
// Параметры:
//  НайденныйПредыдущийПункт     - Структура, Неопределено - пункт предыдущего
//                                 плана с тем же заголовком, либо Неопределено.
//  СтатусLLM                    - Строка - нормализованный статус от LLM.
//  РазрешитьПропускОбязательных - Булево - Истина разрешает skipped
//                                 обязательных пунктов (ПрименитьСПричиной).
//
// Возвращаемое значение:
//  Строка - итоговый статус пункта.
//
Функция СтатусПриСлиянии(Знач НайденныйПредыдущийПункт, Знач СтатусLLM, Знач РазрешитьПропускОбязательных)

	Если НайденныйПредыдущийПункт = Неопределено Тогда
		Возврат СтатусLLM;
	КонецЕсли;

	Обязательный = (мПунктПоле(НайденныйПредыдущийПункт, "Обязательный", Ложь) = Истина);

	Если Обязательный Тогда
		СтатусПредыдущий = Строка(мПунктПоле(НайденныйПредыдущийПункт, "Статус", "pending"));
		Незакрыт = (СтатусПредыдущий = "pending" Или СтатусПредыдущий = "in_progress");

		// done обязательного шага от модели игнорируется.
		Если Незакрыт И СтатусLLM = мСтатусЗакрыт() Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		// skipped обязательного шага - только с причиной (ПрименитьСПричиной).
		Если Незакрыт И СтатусLLM = "skipped" И Не РазрешитьПропускОбязательных Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		// Закрытый (done/skipped) обязательный пункт не раззакрывается.
		Если Не Незакрыт И СтатусLLM <> мСтатусЗакрыт() И СтатусLLM <> "skipped" Тогда
			Возврат СтатусПредыдущий;
		КонецЕсли;

		Возврат СтатусLLM;
	КонецЕсли;

	НайденЗакрытым = НайденныйПредыдущийПункт.Статус = мСтатусЗакрыт();
	ПопыткаОткатаНазад = СтатусLLM <> мСтатусЗакрыт() И СтатусLLM <> "skipped";

	Если НайденЗакрытым И ПопыткаОткатаНазад Тогда
		Возврат мСтатусЗакрыт();
	КонецЕсли;

	Возврат СтатусLLM;

КонецФункции

// Обрезает список пунктов до лимита мМаксПунктов(). Не мутирует вход,
// возвращает новый список.
//
// Сначала исключаются removed-пункты (в любой позиции), затем, если лимит
// все еще превышен, - пункты модели с конца (последние добавленные).
// Шаблонные пункты не обрезаются никогда (agentrunner-107, п.2): если и
// после исключения removed и пунктов модели план выше лимита - обрезка не
// выполняется, превышение уходит в Предупреждения. Порядок оставшихся
// пунктов сохраняется таким же, как во входном списке.
//
// Параметры:
//  Пункты         - Массив - список пунктов {Заголовок, Статус} до обрезки.
//  Предупреждения - Массив - выходной: предупреждение об обрезке (см.
//                   НовоеПредупреждениеОбрезки), если обрезка невозможна.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив), Усечено (Булево, Истина, если вход
//  превышал лимит).
//
Функция ОбрезатьДоЛимита(Знач Пункты, Предупреждения)

	Если Пункты.Количество() <= мМаксПунктов() Тогда
		Возврат Новый Структура("Пункты, Усечено", Пункты, Ложь);
	КонецЕсли;

	Избыток = Пункты.Количество() - мМаксПунктов();
	ИсключитьНомер = НомераДляИсключения(Пункты, Избыток, Предупреждения);

	Оставшиеся = Новый Массив;
	Для Номер = 0 По Пункты.ВГраница() Цикл
		Если ИсключитьНомер.Получить(Номер) = Неопределено Тогда
			Оставшиеся.Добавить(Пункты[Номер]);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Пункты, Усечено", Оставшиеся, Истина);

КонецФункции

// Определяет порядковые номера (0-based, от начала списка) пунктов, которые
// нужно исключить, чтобы убрать Избыток штук: сначала removed-пункты в любой
// позиции, затем пункты модели (не шаблонные) с конца - последние добавленные.
// Если removed и пунктов модели не хватило (шаблонные не трогаются) -
// предупреждение в Предупреждения и пустой результат: ни один пункт не
// исключается (agentrunner-107, п.2).
//
// Параметры:
//  Пункты         - Массив - список пунктов {Заголовок, Статус}.
//  Избыток        - Число  - сколько пунктов нужно исключить.
//  Предупреждения - Массив - выходной: предупреждение при невозможности обрезки.
//
// Возвращаемое значение:
//  Соответствие - ключи: номера пунктов для исключения (значение - Истина).
//
Функция НомераДляИсключения(Знач Пункты, Знач Избыток, Предупреждения)

	ИсключитьНомер = Новый Соответствие;
	Оставшийся = Избыток;

	// Проход 1: removed-пункты в любой позиции (порядок шаблона фиксируется,
	// поэтому removed больше не скапливаются в хвосте списка).
	Для Номер = 0 По Пункты.ВГраница() Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Строка(мПунктПоле(Пункты[Номер], "Статус", "pending")) = "removed" Тогда
			ИсключитьНомер.Вставить(Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	// Проход 2: пункты модели с конца; шаблонные пункты не исключаются.
	Для Каждого НомерИПункт Из НумерованныеСКонца(Пункты) Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ИсключитьНомер.Получить(НомерИПункт.Номер) = Неопределено
			И Не ШаблонныйПункт(НомерИПункт.Пункт) Тогда
			ИсключитьНомер.Вставить(НомерИПункт.Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	Если Оставшийся > 0 Тогда
		Предупреждения.Добавить(НовоеПредупреждениеОбрезки(Избыток));
		Возврат Новый Соответствие;
	КонецЕсли;

	Возврат ИсключитьНомер;

КонецФункции

// Возвращает элементы списка вместе с их порядковыми номерами (0-based, от
// начала списка), но в порядке обхода от конца списка к началу.
//
// Параметры:
//  Пункты - Массив - исходный список.
//
// Возвращаемое значение:
//  Массив - структур {Номер (Число), Пункт (Структура)}, в порядке от
//  последнего элемента исходного списка к первому.
//
Функция НумерованныеСКонца(Знач Пункты)

	Результат = Новый Массив;
	Всего = Пункты.Количество();

	Для Смещение = 1 По Всего Цикл
		Номер = Всего - Смещение;
		Результат.Добавить(Новый Структура("Номер, Пункт", Номер, Пункты[Номер]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует значение статуса пункта, пришедшее от LLM, к одному из четырех
// допустимых значений входа (pending, in_progress, done, skipped). Неизвестное
// или пустое значение (включая любой тип, кроме Строка) трактуется как pending
// - мусор не должен ронять обработку.
//
// Параметры:
//  ЗначениеСтатуса - Произвольный - сырое значение ключа "status".
//
// Возвращаемое значение:
//  Строка - pending | in_progress | done | skipped.
//
Функция НормализоватьСтатус(Знач ЗначениеСтатуса)

	Если ТипЗнч(ЗначениеСтатуса) <> Тип("Строка") Тогда
		Возврат "pending";
	КонецЕсли;

	Статус = НРег(СокрЛП(ЗначениеСтатуса));

	Если Статус = "in_progress"
		Или Статус = мСтатусЗакрыт()
		Или Статус = "skipped" Тогда
		Возврат Статус;
	КонецЕсли;

	Возврат "pending";

КонецФункции

#КонецОбласти
