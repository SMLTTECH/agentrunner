////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ОчередьРаспознаванияФон (agentrunner-111).
//
// Мост фонового задания-воркера отправки очереди распознавания: из
// ФоновыеЗадания.Выполнить платформа вызывает только экспортные методы общих
// модулей (паттерн ядра ar_RuntimeЗапуск), а логика отправки живет во внешнем
// пакете ar_ПакетПрисоединённыеФайлы. Мост находит зарегистрированный пакет в
// регистре ar_ПакетыИнструментов, создает его объект БСП-методом
// ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки (образец - модуль
// ar_ИнструментыПлагинВызов) и вызывает экспорт ОсушитьОчередьОтправки.
//
// Метод ВыполнитьОтправку - без параметров: токен и адрес RAGU не
// сериализуются в журнал заданий, воркер читает настройки сам (внутри
// ОсушитьОчередьОтправки пакета). Падение моста не меняет строки очереди:
// queued-строки подбирает следующий такт (существующие предохранители -
// 23 ч и порог попыток).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь
// (AUD-06: расширениям запрещен Privileged=true в общих модулях); режим
// поднимается точечно вокруг запроса пакета, создания объекта и вызова и
// сбрасывается парным вызовом (Ложь), по паттерну ar_AuditЗащищённыйРежим.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Точка входа фонового задания-воркера отправки очереди распознавания
// (agentrunner-111): найти пакет, создать объект, осушить отправку. События
// ocr_worker_start / ocr_worker_done (длительность, счетчики возврата) /
// ocr_worker_error - в ar_СлужебныйЛог. Пакет не найден либо объект не
// создан - очередь не трогается, следующий такт повторит.
Процедура ВыполнитьОтправку() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ar_СлужебныйЛог.Записать("ar_ОчередьРаспознаванияФон.ВыполнитьОтправку", "ocr_worker_start", "");

	ИдентификаторПакета = ИдентификаторПакетаФайлов();
	Если ПустаяСтрока(ИдентификаторПакета) Тогда
		ar_СлужебныйЛог.Записать("ar_ОчередьРаспознаванияФон.ВыполнитьОтправку", "ocr_worker_error",
			"Пакет ar_ПакетПрисоединённыеФайлы не найден в регистре ar_ПакетыИнструментов"
				+ " со статусом ""Зарегистрирован""", "Предупреждение");
		Возврат;
	КонецЕсли;

	ОбъектПакета = ОбъектПакетаФайлов(ИдентификаторПакета);
	Если ОбъектПакета = Неопределено Тогда
		ar_СлужебныйЛог.Записать("ar_ОчередьРаспознаванияФон.ВыполнитьОтправку", "ocr_worker_error",
			"Создание объекта пакета ar_ПакетПрисоединённыеФайлы не удалось", "Ошибка");
		Возврат;
	КонецЕсли;

	Счётчики = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Счётчики = ОбъектПакета.ОсушитьОчередьОтправки();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ОчередьРаспознаванияФон.ВыполнитьОтправку", "ocr_worker_error",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), "Ошибка");
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Части = Новый Массив;
	Части.Добавить("ms=" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧН=0; ЧГ=0"));
	Части.Добавить("submitted=" + Формат(Счётчики.Отправлено, "ЧН=0; ЧГ=0"));
	Части.Добавить("done=" + Формат(Счётчики.Готово, "ЧН=0; ЧГ=0"));
	Части.Добавить("errors=" + Формат(Счётчики.Ошибок, "ЧН=0; ЧГ=0"));
	Части.Добавить("sdocster=" + Формат(Счётчики.SDocster, "ЧН=0; ЧГ=0"));
	Части.Добавить("skipped=" + Формат(Счётчики.Пропущено, "ЧН=0; ЧГ=0"));
	Части.Добавить("unauthorized=" + ?(Счётчики.Отменено, "1", "0"));
	ar_СлужебныйЛог.Записать("ar_ОчередьРаспознаванияФон.ВыполнитьОтправку", "ocr_worker_done",
		СтрСоединить(Части, "; "));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Идентификатор зарегистрированного пакета файлов: запрос к регистру
// ar_ПакетыИнструментов (образец - ar_ИнструментыПлагинВызов
// .СтатусПакетаПоРегистру) в привилегированном режиме: регистр пакетов
// общий для всех агентов, пользователь фонового задания БСП не обязан
// видеть его строки.
//
// Возвращаемое значение:
//  Строка - UUID элемента справочника ДополнительныеОтчетыИОбработки;
//  пустая строка - пакет не найден.
//
Функция ИдентификаторПакетаФайлов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_ИмяОбъектаОбработки = &ИмяОбъекта
		|	И Пакеты.ar_Статус = &Статус";
	Запрос.УстановитьПараметр("ИмяОбъекта", "ar_ПакетПрисоединённыеФайлы");
	Запрос.УстановитьПараметр("Статус", "Зарегистрирован");

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Найдено = Выборка.Следующий();
		Идентификатор = ?(Найдено, СокрЛП(Выборка.ИдентификаторОбработки), "");
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Идентификатор;

КонецФункции

// Объект пакета по UUID (образец - ar_ИнструментыПлагинВызов
// .СоздатьОбъектПакета): создание БСП-методом ОбъектВнешнейОбработки через
// ОбщийМодуль (справочник не заимствован в расширение). Привилегированный
// режим - точечно вокруг создания, парный сброс.
//
// Параметры:
//  ИдентификаторПакета - Строка - UUID элемента ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  ДанныеОбработки.ar_ПакетПрисоединённыеФайлы - объект пакета;
//  Неопределено - ссылка не существует либо создание не удалось.
//
Функция ОбъектПакетаФайлов(Знач ИдентификаторПакета)

	СсылкаОбработки = СсылкаНаОбработку(ИдентификаторПакета);
	Если СсылкаОбработки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МодульДопОбработки = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
		ОбъектПакета = МодульДопОбработки.ОбъектВнешнейОбработки(СсылкаОбработки);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ОбъектПакета;

КонецФункции

// Ссылка на элемент справочника ДополнительныеОтчетыИОбработки по UUID
// (справочник не заимствован в расширение - разыменование через коллекцию
// Справочники). ПолучитьСсылку - конструктор ссылки: для несуществующего
// UUID возвращает заполненную «битую» ссылку, существование проверяется
// явно (образец - ar_ИнструментыПлагинВызов.СсылкаНаОбработкуПоИдентификатору).
//
// Параметры:
//  ИдентификаторПакета - Строка - UUID элемента справочника.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки, Неопределено.
//
Функция СсылкаНаОбработку(Знач ИдентификаторПакета)

	Попытка
		UUID = Новый УникальныйИдентификатор(ИдентификаторПакета);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Ссылка = Справочники["ДополнительныеОтчетыИОбработки"].ПолучитьСсылку(UUID);
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
