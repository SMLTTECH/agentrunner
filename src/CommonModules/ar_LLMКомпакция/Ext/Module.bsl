////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ar_LLMКомпакция".
//
// Двухуровневая компакция массива сообщений чат-формата перед отправкой в LLM
// (см. Plan §3.13, спека .docs/specs/LLM-08.md):
//   * Мягкая компакция (soft): при оценке > 0.7 * MaxContext — попарно удалять
//     наиболее старые сообщения (кроме system и последних N), пока оценка не
//     опустится ниже 0.65 * MaxContext.
//   * Жёсткий cut (hard): при оценке > 0.9 * MaxContext — оставить все
//     сообщения с role = "system" + последние N сообщений диалога.
// Оба уровня не удаляют первое и последнее сообщение пользователя (исходная
// задача и текущий запрос) и заменяют удалённое одним сообщением-сводкой
// (role = "user", признак ar_СводкаКомпакции): число удалённых сообщений,
// вызванные инструменты, короткие выдержки. Повторная компакция дополняет
// ту же сводку (agentrunner-65).
//
// Чистая трансформация: модуль не читает ИБ, не делает HTTP, не пишет в
// регистры. MaxContext поступает аргументом от вызывающего (RT-04). Зависит
// только от ar_Токены (оценка длины) и ar_LLMКонтракт (строковые роли).
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, Client = false, ServerCall = false,
//   Privileged = false, ReturnValuesReuse = DontUse.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Применить компакцию к массиву сообщений с учётом порогов MaxContext.
//
// Точка входа: RT-04 вызывает её перед передачей контекста в ar_LLMДиспетчер.
// Возвращает структуру с признаком, была ли компакция, и каким типом.
//
// Параметры:
//   Сообщения  - Массив, Неопределено - элементы Структура чат-формата с
//                                       ключами role, content, опц. tool_calls.
//   MaxContext - Число - максимальный размер окна контекста модели (в токенах).
//                        0 = «не ограничено» — компакция отключена.
//   Модель     - Строка - имя модели; передаётся в ar_Токены (зарезервировано).
//
// Возвращаемое значение:
//   Структура - {
//     Сообщения        - Массив - обновлённый (или исходный) массив.
//     БылаКомпакция    - Булево - применялась ли какая-либо компакция.
//     ТипКомпакции     - Строка - "none" | "soft" | "hard".
//     УдаленоСообщений - Число  - сколько сообщений удалено.
//     ОценкаДо         - Число  - оценка токенов до компакции.
//     ОценкаПосле      - Число  - оценка токенов после компакции.
//   }
//
Функция Применить(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Результат = НовыйРезультат();

	// Защитные ветки: некорректный или пустой вход — graceful return.
	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Результат.Сообщения = НовыйПустойМассив();
		Возврат Результат;
	КонецЕсли;

	// MaxContext = 0 (или отрицательный/невалидный) → компакция отключена.
	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Результат.Сообщения = КопияМассива(Сообщения);
		Возврат Результат;
	КонецЕсли;

	ОценкаТекущая = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Результат.ОценкаДо = ОценкаТекущая;
	Результат.ОценкаПосле = ОценкаТекущая;
	Результат.Сообщения = КопияМассива(Сообщения);

	ПорогHard = ПорогЖёсткогоCut() * MaxContext;
	ПорогSoft = ПорогМягкойКомпакции() * MaxContext;

	Если ОценкаТекущая > ПорогHard Тогда
		ВыполнитьЖёсткийCut(Результат, MaxContext, Модель);
	ИначеЕсли ОценкаТекущая > ПорогSoft Тогда
		ВыполнитьМягкуюКомпакцию(Результат, MaxContext, Модель);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Быстрая проверка: нужна ли компакция (оценка > 0.7 * MaxContext).
//
// Параметры:
//   Сообщения  - Массив - чат-сообщения.
//   MaxContext - Число  - окно контекста модели; 0 → всегда Ложь.
//   Модель     - Строка - имя модели (передаётся в ar_Токены).
//
// Возвращаемое значение:
//   Булево - Истина, если требуется хотя бы soft-компакция.
//
Функция НужнаКомпакция(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Оценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Возврат Оценка > ПорогМягкойКомпакции() * MaxContext;

КонецФункции

// Вернуть долю заполнения окна контекста: оценка / MaxContext.
//
// Полезно для логов и UI (например, прогресс-бар «79% контекста»).
//
// Параметры:
//   Сообщения  - Массив - чат-сообщения.
//   MaxContext - Число  - окно контекста; 0 → возвращается 0 (нет ограничения).
//   Модель     - Строка - имя модели.
//
// Возвращаемое значение:
//   Число - доля в диапазоне [0..1+]. 0 — для пустого массива или MaxContext=0.
//
Функция ОценкаЗаполненности(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Оценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Возврат Оценка / MaxContext;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор пустого результата компакции (см. Применить).
Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Сообщения", Неопределено);
	Результат.Вставить("БылаКомпакция", Ложь);
	Результат.Вставить("ТипКомпакции", ТипКомпакцииНет());
	Результат.Вставить("УдаленоСообщений", 0);
	Результат.Вставить("ОценкаДо", 0);
	Результат.Вставить("ОценкаПосле", 0);
	Возврат Результат;

КонецФункции

// Выполняет мягкую компакцию: удаляет наиболее старые ходы диалога вне
// защищённых сообщений, пока оценка не опустится ниже ЗапасПорогом.
// Защищены: system в начале, первое и последнее сообщение пользователя
// (исходная задача и текущий запрос), хвост из последних N сообщений.
// Удалённое пересказывается одним сообщением-сводкой (см. ВставитьСводку).
// Модифицирует поля Результата по месту.
//
// Параметры:
//   Результат  - Структура - см. НовыйРезультат(); поле Сообщения уже
//                            содержит копию исходного массива.
//   MaxContext - Число     - окно контекста модели.
//   Модель     - Строка    - имя модели.
//
Процедура ВыполнитьМягкуюКомпакцию(Результат, Знач MaxContext, Знач Модель)

	Сообщения = Результат.Сообщения;
	ДанныеСводки = ИзвлечьСводку(Сообщения);
	ПорогЗапаса = ЗапасПорогом() * MaxContext;

	// Граница начала защищённого "хвоста" — последние N сообщений нельзя трогать.
	НижняяГраницаХвоста = НачалоЗащищенногоХвоста(Сообщения);

	// Позиция, начиная с которой можно удалять (пропускаем все системные
	// сообщения в начале массива — обычно одно, но допускается несколько).
	Позиция = ПозицияПервогоНеSystem(Сообщения);

	УдаленоВсего = 0;
	ТекущаяОценка = ar_Токены.ОценитьМассив(Сообщения, Модель);

	// Удаляем "ходами" слева: один user/assistant + связанные tool-сообщения.
	// Защищённые сообщения пропускаются. Останавливаемся, как только оценка
	// опустилась ниже ЗапасПорогом или удалять больше нечего.
	Пока ТекущаяОценка > ПорогЗапаса И Позиция < НижняяГраницаХвоста Цикл

		Если ЭтоЗащищенноеСообщениеПользователя(Сообщения, Позиция) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Количество = РазмерХодаДляУдаления(Сообщения, Позиция, НижняяГраницаХвоста);
		Для Сч = 1 По Количество Цикл
			УчестьУдаленноеВСводке(ДанныеСводки, Сообщения[Позиция]);
			Сообщения.Удалить(Позиция);
		КонецЦикла;

		УдаленоВсего = УдаленоВсего + Количество;
		НижняяГраницаХвоста = НижняяГраницаХвоста - Количество;
		// Пересчёт после удаления.
		ТекущаяОценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	КонецЦикла;

	ВставитьСводку(Сообщения, ДанныеСводки);

	Если УдаленоВсего > 0 Тогда
		Результат.БылаКомпакция = Истина;
		Результат.ТипКомпакции = ТипКомпакцииSoft();
		Результат.УдаленоСообщений = УдаленоВсего;
		Результат.ОценкаПосле = ar_Токены.ОценитьМассив(Сообщения, Модель);
	КонецЕсли;

КонецПроцедуры

// Выполняет жёсткий cut: оставляет системные сообщения в начале, первое и
// последнее сообщение пользователя и последние N сообщений из конца; всё
// остальное пересказывается одним сообщением-сводкой (см. ВставитьСводку).
// Модифицирует поля Результата по месту.
//
// Параметры:
//   Результат  - Структура - см. НовыйРезультат(); поле Сообщения уже
//                            содержит копию исходного массива.
//   MaxContext - Число     - окно контекста модели.
//   Модель     - Строка    - имя модели.
//
Процедура ВыполнитьЖёсткийCut(Результат, Знач MaxContext, Знач Модель)

	Сообщения = Результат.Сообщения;
	ДанныеСводки = ИзвлечьСводку(Сообщения);
	КоличествоПоследних = КоличествоПоследнихХодовHard();

	// Префикс — все подряд идущие system-сообщения с начала массива.
	ПозицияПослеSystem = ПозицияПервогоНеSystem(Сообщения);

	НачалоХвоста = Макс(ПозицияПослеSystem, Сообщения.Количество() - КоличествоПоследних);

	// Защита: первое сообщение хвоста не должно быть role = "tool" без
	// предшествующего assistant[tool_calls] — иначе провайдер вернёт ошибку.
	Пока НачалоХвоста < Сообщения.Количество()
		И ЯвляетсяРольюTool(Сообщения[НачалоХвоста]) Цикл
		НачалоХвоста = НачалоХвоста + 1;
	КонецЦикла;

	ИндексПервого = ИндексСообщенияПользователя(Сообщения, Истина);
	ИндексПоследнего = ИндексСообщенияПользователя(Сообщения, Ложь);

	НовыйМассив = Новый Массив;
	Для Сч = 0 По Сообщения.Количество() - 1 Цикл
		Если Сч < ПозицияПослеSystem
			Или Сч >= НачалоХвоста
			Или Сч = ИндексПервого
			Или Сч = ИндексПоследнего Тогда
			НовыйМассив.Добавить(Сообщения[Сч]);
		Иначе
			УчестьУдаленноеВСводке(ДанныеСводки, Сообщения[Сч]);
		КонецЕсли;
	КонецЦикла;

	УдаленоВсего = Сообщения.Количество() - НовыйМассив.Количество();
	ВставитьСводку(НовыйМассив, ДанныеСводки);
	Результат.Сообщения = НовыйМассив;

	Если УдаленоВсего > 0 Тогда
		Результат.БылаКомпакция = Истина;
		Результат.ТипКомпакции = ТипКомпакцииHard();
		Результат.УдаленоСообщений = УдаленоВсего;
		Результат.ОценкаПосле = ar_Токены.ОценитьМассив(НовыйМассив, Модель);

		ЗаписьВЖурнал(УдаленоВсего, MaxContext, Результат.ОценкаДо, Результат.ОценкаПосле);
	КонецЕсли;

КонецПроцедуры

// Найти позицию первого сообщения с role != "system" (начиная с 0).
// Если все сообщения системные — вернёт Сообщения.Количество().
Функция ПозицияПервогоНеSystem(Знач Сообщения)

	Для Сч = 0 По Сообщения.Количество() - 1 Цикл
		Если Не ЯвляетсяРольюSystem(Сообщения[Сч]) Тогда
			Возврат Сч;
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения.Количество();

КонецФункции

// Начало защищённого хвоста мягкой компакции: последние N сообщений. Если
// хвост начинается с role = "tool", граница сдвигается влево до его
// assistant[tool_calls] — ход не разрывается между удаляемой частью и хвостом.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//
// Возвращаемое значение:
//   Число - индекс первого сообщения хвоста.
//
Функция НачалоЗащищенногоХвоста(Знач Сообщения)

	ПозицияПослеSystem = ПозицияПервогоНеSystem(Сообщения);
	Граница = Макс(ПозицияПослеSystem, Сообщения.Количество() - КоличествоПоследнихХодовHard());

	Пока Граница > ПозицияПослеSystem
		И Граница < Сообщения.Количество()
		И ЯвляетсяРольюTool(Сообщения[Граница]) Цикл
		Граница = Граница - 1;
	КонецЦикла;

	Возврат Граница;

КонецФункции

// Число сообщений одного хода, удаляемого мягкой компакцией с позиции Позиция.
//
// Алгоритм: если это assistant[tool_calls] — захватить также все следующие за
// ним сообщения с role = "tool" (это один логический ход). Если user — захватить
// пару user + следующий assistant (если есть и без tool_calls). Иначе —
// удалить одиночное сообщение, не блокируя цикл. Защищённое сообщение
// пользователя сюда не попадает (пропускается вызывающим).
//
// Параметры:
//   Сообщения           - Массив - чат-сообщения.
//   Позиция             - Число  - начало хода.
//   НижняяГраницаХвоста - Число  - индекс начала защищённого хвоста.
//
// Возвращаемое значение:
//   Число - сколько сообщений удалить, начиная с Позиция (0 — нечего).
//
Функция РазмерХодаДляУдаления(Знач Сообщения, Знач Позиция, Знач НижняяГраницаХвоста)

	Если Позиция >= НижняяГраницаХвоста Тогда
		Возврат 0;
	КонецЕсли;

	Сообщение = Сообщения[Позиция];
	Роль = ПолучитьРоль(Сообщение);

	Если Роль = ar_LLMКонтракт.РольAssistant() И ИмеетToolCalls(Сообщение) Тогда
		// Удаляем assistant + все следующие tool-сообщения.
		КонецДиапазона = Позиция + 1;
		Пока КонецДиапазона < НижняяГраницаХвоста
			И ПолучитьРоль(Сообщения[КонецДиапазона]) = ar_LLMКонтракт.РольTool() Цикл
			КонецДиапазона = КонецДиапазона + 1;
		КонецЦикла;
		Возврат КонецДиапазона - Позиция;
	ИначеЕсли Роль = ar_LLMКонтракт.РольUser()
		И Позиция + 1 < НижняяГраницаХвоста
		И ПолучитьРоль(Сообщения[Позиция + 1]) = ar_LLMКонтракт.РольAssistant()
		И Не ИмеетToolCalls(Сообщения[Позиция + 1]) Тогда
		// Удаляем user + следующий assistant без tool_calls (иначе assistant
		// удалится на следующей итерации отдельным ходом).
		Возврат 2;
	КонецЕсли;

	// Одиночный user/assistant, "висячий" tool или неизвестная роль —
	// удаляем одиночно, не блокируя цикл.
	Возврат 1;

КонецФункции

// Истина, если на позиции стоит защищённое сообщение пользователя: первое
// (исходная задача) или последнее (текущий запрос), сводка не считается.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//   Позиция   - Число  - проверяемый индекс.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЗащищенноеСообщениеПользователя(Знач Сообщения, Знач Позиция)

	Возврат Позиция = ИндексСообщенияПользователя(Сообщения, Истина)
		Или Позиция = ИндексСообщенияПользователя(Сообщения, Ложь);

КонецФункции

// Индекс первого или последнего сообщения role = "user", не являющегося
// сводкой компакции.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения.
//   Первое    - Булево - Истина — первое сообщение, Ложь — последнее.
//
// Возвращаемое значение:
//   Число - индекс сообщения; -1, если сообщений пользователя нет.
//
Функция ИндексСообщенияПользователя(Знач Сообщения, Знач Первое)

	Количество = Сообщения.Количество();
	Для Сч = 0 По Количество - 1 Цикл
		Индекс = ?(Первое, Сч, Количество - 1 - Сч);
		Сообщение = Сообщения[Индекс];
		Если ПолучитьРоль(Сообщение) = ar_LLMКонтракт.РольUser() И Не ЭтоСводка(Сообщение) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

// Истина, если сообщение — сводка прошлой компакции (признак ar_СводкаКомпакции).
//
// Параметры:
//   Сообщение - Структура - чат-сообщение.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоСводка(Знач Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Признак = Ложь;
	Сообщение.Свойство("ar_СводкаКомпакции", Признак);
	Возврат Признак = Истина;

КонецФункции

// Убирает из массива сообщения-сводки прошлых компакций и возвращает их
// накопленные данные (копию — сообщения исходного массива не меняются), чтобы
// новая компакция дополнила одну сводку, а не добавила вторую.
//
// Параметры:
//   Сообщения - Массив - чат-сообщения (меняется по месту).
//
// Возвращаемое значение:
//   Структура - см. НовыеДанныеСводки.
//
Функция ИзвлечьСводку(Сообщения)

	Данные = НовыеДанныеСводки();
	Сч = Сообщения.Количество() - 1;
	Пока Сч >= 0 Цикл
		Если ЭтоСводка(Сообщения[Сч]) Тогда
			ДополнитьДанныеСводки(Данные, Сообщения[Сч]);
			Сообщения.Удалить(Сч);
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;
	Возврат Данные;

КонецФункции

// Переносит накопленные данные сводки из сообщения-сводки в Данные.
//
// Параметры:
//   Данные    - Структура - см. НовыеДанныеСводки (дополняется).
//   Сообщение - Структура - сообщение-сводка.
//
Процедура ДополнитьДанныеСводки(Данные, Знач Сообщение)

	Прежние = Неопределено;
	Сообщение.Свойство("ar_ДанныеСводки", Прежние);
	Если ТипЗнч(Прежние) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Удалено = 0;
	Если Прежние.Свойство("Удалено", Удалено) И ТипЗнч(Удалено) = Тип("Число") Тогда
		Данные.Удалено = Данные.Удалено + Удалено;
	КонецЕсли;

	Инструменты = Неопределено;
	Если Прежние.Свойство("Инструменты", Инструменты) И ТипЗнч(Инструменты) = Тип("Массив") Тогда
		Для Каждого Элемент Из Инструменты Цикл
			Если ТипЗнч(Элемент) = Тип("Структура")
				И Элемент.Свойство("Имя")
				И Элемент.Свойство("Количество") Тогда
				УчестьВызовИнструмента(Данные, Элемент.Имя, Элемент.Количество);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Выдержки = Неопределено;
	Если Прежние.Свойство("Выдержки", Выдержки) И ТипЗнч(Выдержки) = Тип("Массив") Тогда
		Для Каждого Выдержка Из Выдержки Цикл
			ДобавитьВыдержку(Данные, Выдержка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Конструктор накопленных данных сводки компакции. Только примитивы и
// массивы структур — данные переживают снимок состояния и сессию.
//
// Возвращаемое значение:
//   Структура - {Удалено: Число, Инструменты: Массив из Структура{Имя, Количество},
//               Выдержки: Массив из Строка}.
//
Функция НовыеДанныеСводки()

	Данные = Новый Структура;
	Данные.Вставить("Удалено", 0);
	Данные.Вставить("Инструменты", Новый Массив);
	Данные.Вставить("Выдержки", Новый Массив);
	Возврат Данные;

КонецФункции

// Учитывает удаляемое сообщение в данных сводки: счётчик, вызовы
// инструментов, короткая выдержка текста.
//
// Параметры:
//   Данные    - Структура - см. НовыеДанныеСводки (дополняется).
//   Сообщение - Структура - удаляемое чат-сообщение.
//
Процедура УчестьУдаленноеВСводке(Данные, Знач Сообщение)

	Данные.Удалено = Данные.Удалено + 1;
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Роль = ПолучитьРоль(Сообщение);
	Если ИмеетToolCalls(Сообщение) Тогда
		Для Каждого Вызов Из Сообщение.tool_calls Цикл
			УчестьВызовИнструмента(Данные, ИмяИнструментаВызова(Вызов), 1);
		КонецЦикла;
	КонецЕсли;

	Содержимое = "";
	Сообщение.Свойство("content", Содержимое);
	Если ТипЗнч(Содержимое) <> Тип("Строка") Или ПустаяСтрока(Содержимое) Тогда
		Возврат;
	КонецЕсли;

	Метка = Роль;
	Если Роль = ar_LLMКонтракт.РольTool() Тогда
		ИмяИнструмента = "";
		Сообщение.Свойство("name", ИмяИнструмента);
		Метка = ?(ТипЗнч(ИмяИнструмента) = Тип("Строка") И Не ПустаяСтрока(ИмяИнструмента),
			ИмяИнструмента, Роль);
	КонецЕсли;

	ТекстВыдержки = СтрЗаменить(СокрЛП(Содержимое), Символы.ПС, " ");
	Если СтрДлина(ТекстВыдержки) > МаксДлинаВыдержки() Тогда
		ТекстВыдержки = Лев(ТекстВыдержки, МаксДлинаВыдержки()) + "...";
	КонецЕсли;
	ДобавитьВыдержку(Данные, Метка + ": " + ТекстВыдержки);

КонецПроцедуры

// Увеличивает счётчик вызовов инструмента в данных сводки.
//
// Параметры:
//   Данные     - Структура - см. НовыеДанныеСводки (дополняется).
//   Имя        - Строка    - имя инструмента.
//   Количество - Число     - на сколько увеличить.
//
Процедура УчестьВызовИнструмента(Данные, Знач Имя, Знач Количество)

	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Или ТипЗнч(Количество) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Данные.Инструменты Цикл
		Если Элемент.Имя = Имя Тогда
			Элемент.Количество = Элемент.Количество + Количество;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Данные.Инструменты.Добавить(Новый Структура("Имя, Количество", Имя, Количество));

КонецПроцедуры

// Добавляет выдержку в данные сводки, оставляя только последние МаксВыдержек.
//
// Параметры:
//   Данные   - Структура - см. НовыеДанныеСводки (дополняется).
//   Выдержка - Строка    - текст выдержки.
//
Процедура ДобавитьВыдержку(Данные, Знач Выдержка)

	Если ТипЗнч(Выдержка) <> Тип("Строка") Или ПустаяСтрока(Выдержка) Тогда
		Возврат;
	КонецЕсли;
	Данные.Выдержки.Добавить(Выдержка);
	Пока Данные.Выдержки.Количество() > МаксВыдержек() Цикл
		Данные.Выдержки.Удалить(0);
	КонецЦикла;

КонецПроцедуры

// Имя инструмента из элемента tool_calls (Структура или Соответствие после
// разбора JSON): function.name, иначе name.
//
// Параметры:
//   Вызов - Структура, Соответствие - элемент tool_calls.
//
// Возвращаемое значение:
//   Строка - имя инструмента или пустая строка.
//
Функция ИмяИнструментаВызова(Знач Вызов)

	ОписаниеФункции = ЗначениеПоКлючу(Вызов, "function");
	Имя = ЗначениеПоКлючу(ОписаниеФункции, "name");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		Имя = ЗначениеПоКлючу(Вызов, "name");
	КонецЕсли;
	Возврат ?(ТипЗнч(Имя) = Тип("Строка"), Имя, "");

КонецФункции

// Значение по ключу из Структуры или Соответствия.
//
// Параметры:
//   Источник - Структура, Соответствие, Произвольный - коллекция.
//   Ключ     - Строка - ключ.
//
// Возвращаемое значение:
//   Произвольный - значение или Неопределено.
//
Функция ЗначениеПоКлючу(Знач Источник, Знач Ключ)

	Значение = Неопределено;
	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Источник.Свойство(Ключ, Значение);
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Ключ);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Вставляет сообщение-сводку сразу после первого сообщения пользователя (или
// после system-префикса, если сообщений пользователя нет). Позиция — всегда
// граница хода: между assistant[tool_calls] и его tool сводка не попадает.
//
// Параметры:
//   Сообщения    - Массив    - чат-сообщения (меняется по месту).
//   ДанныеСводки - Структура - см. НовыеДанныеСводки; при Удалено = 0 не вставляется.
//
Процедура ВставитьСводку(Сообщения, Знач ДанныеСводки)

	Если ДанныеСводки.Удалено = 0 Тогда
		Возврат;
	КонецЕсли;

	ИндексПервого = ИндексСообщенияПользователя(Сообщения, Истина);
	Позиция = ?(ИндексПервого >= 0, ИндексПервого + 1, ПозицияПервогоНеSystem(Сообщения));

	Сводка = ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстСводки(ДанныеСводки));
	Сводка.Вставить("ar_СводкаКомпакции", Истина);
	Сводка.Вставить("ar_ДанныеСводки", ДанныеСводки);
	Сообщения.Вставить(Позиция, Сводка);

КонецПроцедуры

// Текст сообщения-сводки для модели (не длиннее МаксДлинаСводки).
//
// Параметры:
//   ДанныеСводки - Структура - см. НовыеДанныеСводки.
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстСводки(Знач ДанныеСводки)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = '[Сводка сокращенной истории] Чтобы уместиться в окно контекста,
		|из истории удалено сообщений: %1. Исходная задача и текущий запрос пользователя сохранены.';
		|en = '[Summary of the shortened history] To fit the context window, %1 messages were removed
		|from the history. The original task and the current user request are kept.'"),
		ДанныеСводки.Удалено));

	Если ДанныеСводки.Инструменты.Количество() > 0 Тогда
		Вызовы = Новый Массив;
		Для Каждого Элемент Из ДанныеСводки.Инструменты Цикл
			Вызовы.Добавить(СтрШаблон("%1 (%2)", Элемент.Имя, Формат(Элемент.Количество, "ЧГ=0")));
		КонецЦикла;
		Строки.Добавить(НСтр("ru = 'Вызванные инструменты (число вызовов):'; en = 'Tools called (number of calls):'")
			+ " " + СтрСоединить(Вызовы, ", ") + ".");
	КонецЕсли;

	Если ДанныеСводки.Выдержки.Количество() > 0 Тогда
		Строки.Добавить(НСтр("ru = 'Последние удаленные фрагменты:'; en = 'Last removed fragments:'"));
		Для Каждого Выдержка Из ДанныеСводки.Выдержки Цикл
			Строки.Добавить("- " + Выдержка);
		КонецЦикла;
	КонецЕсли;

	Возврат Лев(СтрСоединить(Строки, Символы.ПС), МаксДлинаСводки());

КонецФункции

// Безопасное чтение поля role из структуры сообщения.
Функция ПолучитьРоль(Знач Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Роль = "";
	Если Сообщение.Свойство("role", Роль) И Роль <> Неопределено Тогда
		Возврат Строка(Роль);
	КонецЕсли;
	Возврат "";

КонецФункции

// Истина, если сообщение имеет непустой массив tool_calls.
Функция ИмеетToolCalls(Знач Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	ToolCalls = Неопределено;
	Если Сообщение.Свойство("tool_calls", ToolCalls)
		И ToolCalls <> Неопределено
		И ТипЗнч(ToolCalls) = Тип("Массив")
		И ToolCalls.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Истина, если role сообщения = "system".
Функция ЯвляетсяРольюSystem(Знач Сообщение)
	Возврат ПолучитьРоль(Сообщение) = ar_LLMКонтракт.РольSystem();
КонецФункции

// Истина, если role сообщения = "tool".
Функция ЯвляетсяРольюTool(Знач Сообщение)
	Возврат ПолучитьРоль(Сообщение) = ar_LLMКонтракт.РольTool();
КонецФункции

// Пустой массив-результат.
Функция НовыйПустойМассив()
	Возврат Новый Массив;
КонецФункции

// Вернуть неглубокую копию массива (элементы не клонируются, только сам
// массив). У типа Массив в BSL нет метода Скопировать() - в отличие от
// ТаблицаЗначений/СписокЗначений.
//
// Параметры:
//   Источник - Массив.
//
// Возвращаемое значение:
//   Массив - новый массив с теми же элементами в том же порядке.
//
Функция КопияМассива(Знач Источник)
	Копия = Новый Массив;
	Для Каждого Элемент Из Источник Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Запись в журнал регистрации факта жёсткого cut (метаданные, без тел).
Процедура ЗаписьВЖурнал(Знач Удалено, Знач MaxContext, Знач ОценкаДо, Знач ОценкаПосле)

	Сообщение = СтрШаблон(
		НСтр("ru = 'Жёсткий cut контекста: удалено сообщений %1, MaxContext %2, оценка %3 -> %4.';
			|en = 'Hard context cut: %1 messages removed, MaxContext %2, estimate %3 -> %4.'"),
		Удалено, MaxContext, ОценкаДо, ОценкаПосле);

	Попытка
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'AgentRunner.Компакция'; en = 'AgentRunner.Compaction'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			Сообщение);
	Исключение
		// Журнал — best-effort, не маскируем основные ошибки вызывающего.
	КонецПопытки;

КонецПроцедуры

// === Константы порогов и идентификаторов типов ===

// Доля MaxContext, при которой включается soft-компакция.
Функция ПорогМягкойКомпакции()
	Возврат 0.7;
КонецФункции

// Доля MaxContext, при которой включается hard cut.
Функция ПорогЖёсткогоCut()
	Возврат 0.9;
КонецФункции

// Целевая заполненность после soft-компакции (запас по умолчанию 0.65).
Функция ЗапасПорогом()
	Возврат 0.65;
КонецФункции

// Число последних сообщений (не ходов), сохраняемых при жёстком cut и soft.
Функция КоличествоПоследнихХодовHard()
	Возврат 4;
КонецФункции

// Максимальная длина одной выдержки в сводке компакции (символов).
Функция МаксДлинаВыдержки()
	Возврат 300;
КонецФункции

// Сколько последних выдержек хранит сводка компакции.
Функция МаксВыдержек()
	Возврат 6;
КонецФункции

// Максимальная длина текста сводки компакции (символов).
Функция МаксДлинаСводки()
	Возврат 2000;
КонецФункции

// Идентификатор "компакция не применялась".
Функция ТипКомпакцииНет()
	Возврат "none";
КонецФункции

// Идентификатор мягкой компакции.
Функция ТипКомпакцииSoft()
	Возврат "soft";
КонецФункции

// Идентификатор жёсткого cut.
Функция ТипКомпакцииHard()
	Возврат "hard";
КонецФункции

#КонецОбласти
