////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ИнструментыПакеты (PKG-03).
//
// Единственное место, где ядро AgentRunner ЧИТАЕТ внешний пакет tools
// (доп. обработку БСП "Дополнительные отчёты и обработки"): находит
// кандидатов, загружает манифест, валидирует его и заводит записи в
// Справочник.ar_Инструменты / РегистрСведений.ar_ПакетыИнструментов.
//
// Решение (см. .docs/specs/PKG-03.md): пакеты регистрируются ТОЛЬКО явным
// действием администратора - через ЗарегистрироватьПакет по команде из формы
// настроек (PKG-06). ar_ИнструментыДиспетчер.АвтоЗаполнитьРеестрToolsПриЗапуске НЕ
// вызывает ничего из этого модуля - см. комментарий в её шапке. Загрузка
// внешнего кода при старте системы без ведома администратора недопустима:
// ВнешниеОбработки.Создать() - это исполнение чужого кода.
//
// Предусловие доступности механизма - ОБА условия:
//   1. ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки")
//   2. ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки")
// Пункт 2 - прямое требование БСП (см. описание
// ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки: "проверка функциональной
// опции должна выполняться вызывающим кодом"). Обращение к модулю БСП -
// ТОЛЬКО через ОбщегоНазначения.ОбщийМодуль(...), без прямой ссылки в тексте
// модуля - иначе расширение не загрузится в конфигурацию без подсистемы
// (тот же приём для ВерсионированиеОбъектов - см. ar_ИнструментыУниверсальный).
//
// НайтиКандидатов() отбирает потенциальные пакеты ЗАПРОСОМ по ТЧ Команды
// справочника ДополнительныеОтчетыИОбработки (маркер "ar_ToolPack") - без
// единого вызова ВнешниеОбработки.Создать(). Загрузка бинарника происходит
// только для отобранных кандидатов и только по явной команде
// (ПрочитатьМанифестКандидата / ЗарегистрироватьПакет).
//
// Свойства модуля: Сервер, без вызова с клиента, без привилегированного
// режима по умолчанию (поднимается точечно там, где требует запись аудита -
// парой Истина/Ложь через try/finally).
//
// Запрещено: Выполнить(), Вычислить().
//
// См. спеку: .docs/specs/PKG-03.md, .docs/План-гибкие-tools.md §2.3, §2.6,
// Часть 4 блок A, Часть 5 решения 2-3.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет доступность механизма пакетов tools: наличие подсистемы БСП
// "Дополнительные отчёты и обработки" в конфигурации и включённость
// одноимённой функциональной опции.
//
// Возвращаемое значение:
//  Структура:
//   * Доступен - Булево - Истина, если механизм можно использовать.
//   * Причина  - Строка - код причины недоступности ("" при Доступен = Истина):
//                "subsystem_missing" / "functional_option_disabled".
//
Функция МеханизмПакетовДоступен() Экспорт

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки") Тогда
		Возврат НовыйРезультатДоступности(Ложь, "subsystem_missing");
	КонецЕсли;

	ОпцияВключена = Ложь;
	Попытка
		ОпцияВключена = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки");
	Исключение
		// Функциональная опция отсутствует в конфигурации либо иная ошибка
		// платформы при обращении к ней - трактуем как недоступность механизма,
		// а не как падение ядра.
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.МеханизмПакетовДоступен", "functional_option_check_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
		Возврат НовыйРезультатДоступности(Ложь, "functional_option_disabled");
	КонецПопытки;

	Если Не ОпцияВключена Тогда
		Возврат НовыйРезультатДоступности(Ложь, "functional_option_disabled");
	КонецЕсли;

	Возврат НовыйРезультатДоступности(Истина, "");

КонецФункции

// Находит кандидатов на регистрацию как пакет tools - ЗАПРОСОМ по ТЧ Команды
// справочника ДополнительныеОтчетыИОбработки, БЕЗ загрузки бинарников
// (ВнешниеОбработки.Создать() здесь не вызывается ни разу).
//
// Отбор идёт по маркерной команде с Идентификатор = "ar_ToolPack" (контракт
// PKG-01, см. examples/ar_ПакетПример) - исключены обработки с пометкой
// удаления и с Публикация = Отключена.
//
// Текст запроса обращается к справочнику ДополнительныеОтчетыИОбработки,
// которого нет в конфигурации без соответствующей подсистемы БСП - поэтому
// вызов ГАРАНТИРОВАННО предваряется проверкой МеханизмПакетовДоступен(), а
// Выполнить() запроса дополнительно обёрнут в Попытка на случай, если
// проверка предусловия и фактическое состояние метаданных разошлись.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка / ИмяОбъекта / БезопасныйРежим / Версия.
//  Пустая таблица, если механизм недоступен или запрос завершился ошибкой.
//
Функция НайтиКандидатов() Экспорт

	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Ссылка");
	ПустаяТаблица.Колонки.Добавить("ИмяОбъекта");
	ПустаяТаблица.Колонки.Добавить("БезопасныйРежим");
	ПустаяТаблица.Колонки.Добавить("Версия");

	Доступность = МеханизмПакетовДоступен();
	Если Не Доступность.Доступен Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаркерПакета", МаркерПакетаToolPack());
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Команды.Ссылка.Ссылка КАК Ссылка,
		|	Команды.Ссылка.ИмяОбъекта КАК ИмяОбъекта,
		|	Команды.Ссылка.БезопасныйРежим КАК БезопасныйРежим,
		|	Команды.Ссылка.Версия КАК Версия
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК Команды
		|ГДЕ
		|	Команды.Идентификатор = &МаркерПакета
		|	И НЕ Команды.Ссылка.ПометкаУдаления
		|	И Команды.Ссылка.Публикация <> ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)";

	Попытка
		Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.НайтиКандидатов", "candidates_query_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат ПустаяТаблица;
	КонецПопытки;

КонецФункции

// Загружает манифест пакета у ОТОБРАННОГО кандидата: поднимает объект внешней
// обработки через БСП и вызывает её контрактный метод ar_ОписаниеИнструментов().
// Единственная точка, где для пакета вызывается загрузка бинарника
// (МодульДопОбработки.ОбъектВнешнейОбработки) - вызывается только явно, не из
// НайтиКандидатов().
//
// Изолирована в Попытка целиком: отсутствие метода в пакете, исключение
// внутри пакета, возврат не-Структуры - всё это не должно ронять ядро.
//
// Параметры:
//  ИдентификаторОбработки - Строка - строковое представление UUID ссылки на
//                           элемент справочника ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Структура:
//   * Успех    - Булево  - Истина, если манифест получен и это Структура.
//   * Манифест - Структура - манифест пакета (см. контракт PKG-01), либо
//                Неопределено при Успех = Ложь.
//   * Причина  - Строка - код причины отказа при Успех = Ложь:
//                "package_contract_violation:ar_ОписаниеИнструментов" /
//                "manifest_read_error" / "manifest_not_structure" /
//                "mechanism_unavailable" / "reference_not_found".
//
Функция ПрочитатьМанифестКандидата(Знач ИдентификаторОбработки) Экспорт

	Доступность = МеханизмПакетовДоступен();
	Если Не Доступность.Доступен Тогда
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "mechanism_unavailable");
	КонецЕсли;

	СсылкаОбработки = СсылкаПоИдентификатору(ИдентификаторОбработки);
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "reference_not_found");
	КонецЕсли;

	Попытка
		МодульДопОбработки = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
		ВнешнийОбъект = МодульДопОбработки.ОбъектВнешнейОбработки(СсылкаОбработки);
	Исключение
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ПрочитатьМанифестКандидата", "manifest_read_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_read_error");
	КонецПопытки;

	Если ВнешнийОбъект = Неопределено Тогда
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ПрочитатьМанифестКандидата", "manifest_read_error",
			ИдентификаторОбработки + ": " + НСтр("ru = 'ссылка не разыменована в объект внешней обработки'"), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_read_error");
	КонецЕсли;

	Попытка
		Манифест = ВнешнийОбъект.ar_ОписаниеИнструментов();
	Исключение
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ПрочитатьМанифестКандидата", "package_contract_violation",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "package_contract_violation:ar_ОписаниеИнструментов");
	КонецПопытки;

	Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ПрочитатьМанифестКандидата", "manifest_not_structure",
			ИдентификаторОбработки, "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_not_structure");
	КонецЕсли;

	Возврат НовыйРезультатЧтенияМанифеста(Истина, Манифест, "");

КонецФункции

// Валидирует манифест пакета по полному набору проверок контракта (схема 2,
// см. .docs/Контракт-пакета-tools.md): ВерсияСхемы, ПространствоИмён, версия
// пакета, настройки пакета (Настройки), состав Инструменты, namespacing имён,
// коллизии с реестром ar_Инструменты, структура OpenAI tool-format каждой
// СхемаАргументовJSON, УровеньРиска, ТребуетПодтверждения для рискованных
// операций, форматы ТребуемыеОбъекты/ТребуемыеПодсистемы.
//
// Возвращает ВСЕ найденные ошибки массивом, а не первую - администратор
// должен увидеть полный список несоответствий, а не чинить их по одной.
//
// Параметры:
//  Манифест               - Структура - манифест пакета (см.
//                            ПрочитатьМанифестКандидата).
//  ИдентификаторОбработки - Строка - идентификатор пакета, который
//                            проверяется - используется для правила
//                            "повторная регистрация того же пакета не
//                            считается коллизией со своими же именами".
//
// Возвращаемое значение:
//  Структура:
//   * Корректно - Булево - Истина, если ошибок нет.
//   * Ошибки    - Массив строк - коды причин отказа (см. таблицу в §3 спеки).
//
Функция ВалидироватьМанифест(Знач Манифест, Знач ИдентификаторОбработки) Экспорт

	Ошибки = Новый Массив;

	Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
		Ошибки.Добавить("manifest_not_structure");
		Возврат РезультатВалидации(Ложь, Ошибки);
	КонецЕсли;

	// 1. ВерсияСхемы. Манифест принимается только с текущей версией схемы,
	// обратная совместимость со старыми латинскими ключами не делается
	// (решение человека 2026-10-01, спека agentrunner-21 п.В.2): пакет со
	// старым ключом schema_version получает отдельный код legacy_manifest_keys,
	// а не невнятное "unsupported_schema_version:undefined".
	ВерсияСхемы = Неопределено;
	Манифест.Свойство("ВерсияСхемы", ВерсияСхемы);
	Если Не ЭтоЧисло(ВерсияСхемы) Тогда
		СтараяВерсияСхемы = Неопределено;
		Манифест.Свойство("schema_version", СтараяВерсияСхемы);
		Если СтараяВерсияСхемы <> Неопределено Тогда
			Ошибки.Добавить("legacy_manifest_keys");
		Иначе
			Ошибки.Добавить("unsupported_schema_version:" + ПредставлениеЗначенияПакета(ВерсияСхемы));
		КонецЕсли;
	ИначеЕсли ВерсияСхемы <> ПоддерживаемаяВерсияСхемы() Тогда
		Ошибки.Добавить("unsupported_schema_version:" + Формат(ВерсияСхемы, "ЧГ=0"));
	Иначе
		// ВерсияСхемы корректна - ошибок нет.
	КонецЕсли;

	// 2-3. ПространствоИмён: формат + коллизия с другим пакетом.
	ПространствоИмён = Неопределено;
	Манифест.Свойство("ПространствоИмён", ПространствоИмён);
	Если ТипЗнч(ПространствоИмён) <> Тип("Строка") Или Не СоответствуетФорматуПространстваИмён(ПространствоИмён) Тогда
		Ошибки.Добавить("invalid_namespace:" + ПредставлениеЗначенияПакета(ПространствоИмён));
	ИначеЕсли ПространствоИмёнЗанятДругимПакетом(ПространствоИмён, ИдентификаторОбработки) Тогда
		Ошибки.Добавить("namespace_collision:" + ПространствоИмён);
	Иначе
		// ПространствоИмён корректно и свободно - ошибок нет.
	КонецЕсли;

	// 4. Версия пакета.
	ВерсияПакета = Неопределено;
	Манифест.Свойство("Версия", ВерсияПакета);
	Если ТипЗнч(ВерсияПакета) <> Тип("Строка") Или ПустаяСтрока(ВерсияПакета) Тогда
		Ошибки.Добавить("invalid_package_version");
	КонецЕсли;

	// 4а. Настройки пакета - необязательный ключ: массив структур {Ключ,
	// Наименование, Описание, ЗначениеПоУмолчанию} (спека agentrunner-21 п.Б.5).
	// Проверяется до Инструментов, чтобы ошибки настроек и инструментов
	// показывались администратору вместе, а не по одному исправлению за раз.
	Если Не НастройкиПакетаКорректны(Манифест) Тогда
		Ошибки.Добавить("invalid_package_settings");
	КонецЕсли;

	// 5. Инструменты - непустой массив.
	Инструменты = Неопределено;
	Манифест.Свойство("Инструменты", Инструменты);
	Если ТипЗнч(Инструменты) <> Тип("Массив") Или Инструменты.Количество() = 0 Тогда
		Ошибки.Добавить("package_has_no_tools");
		// Дальше по манифесту (проверки 6-11) нечего валидировать без Инструментов.
		Возврат РезультатВалидации(Ошибки.Количество() = 0, Ошибки);
	КонецЕсли;

	ПространствоИмёнДляПроверки = ?(ТипЗнч(ПространствоИмён) = Тип("Строка"), ПространствоИмён, "");

	Для Каждого ОписаниеTool Из Инструменты Цикл
		ВалидироватьОдинTool(ОписаниеTool, ПространствоИмёнДляПроверки, ИдентификаторОбработки, Ошибки);
	КонецЦикла;

	Возврат РезультатВалидации(Ошибки.Количество() = 0, Ошибки);

КонецФункции

// Проверяет необязательный ключ Настройки манифеста пакета (спека
// agentrunner-21 п.Б.5): ключ отсутствует ЛИБО массив структур с непустым
// строковым Ключ и строковым Наименование; ЗначениеПоУмолчанию, если задано, -
// Строка, Число или Булево (иначе запись в составной реквизит
// ar_Значение справочника настроек потеряла бы смысл).
//
// Возвращаемое значение:
//  Булево - Истина, если ключ Настройки корректен или отсутствует.
//
Функция НастройкиПакетаКорректны(Знач Манифест)

	ОписанияНастроек = Неопределено;
	Манифест.Свойство("Настройки", ОписанияНастроек);

	Если ОписанияНастроек = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ОписанияНастроек) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ОписаниеНастройки Из ОписанияНастроек Цикл

		Если ТипЗнч(ОписаниеНастройки) <> Тип("Структура") Тогда
			Возврат Ложь;
		КонецЕсли;

		Ключ = Неопределено;
		ОписаниеНастройки.Свойство("Ключ", Ключ);
		Если ТипЗнч(Ключ) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Ключ)) Тогда
			Возврат Ложь;
		КонецЕсли;

		Наименование = Неопределено;
		ОписаниеНастройки.Свойство("Наименование", Наименование);
		Если ТипЗнч(Наименование) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;

		ЗначениеПоУмолчанию = Неопределено;
		ОписаниеНастройки.Свойство("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию);
		Если ЗначениеПоУмолчанию <> Неопределено
			И ТипЗнч(ЗначениеПоУмолчанию) <> Тип("Строка")
			И ТипЗнч(ЗначениеПоУмолчанию) <> Тип("Число")
			И ТипЗнч(ЗначениеПоУмолчанию) <> Тип("Булево") Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Полный цикл регистрации пакета: чтение манифеста -> валидация -> запись
// РегистрСведений.ar_ПакетыИнструментов + Справочник.ar_Инструменты -> пересчёт
// доступности всех tools. Транзакционно: полурегистрация пакета хуже отказа.
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор кандидата (см.
//                           НайтиКандидатов).
//
// Возвращаемое значение:
//  Структура:
//   * Успех         - Булево - Истина при успешной регистрации.
//   * Статус        - Строка - "Зарегистрирован" / "Отклонён".
//   * ПричинаОтказа - Строка - при Статус = "Отклонён": первая или сводная
//                     причина (полный список - в ar_СлужебныйЛог).
//   * КоличествоTools - Число - число зарегистрированных tools пакета.
//   * СозданоНастроек - Число - сколько настроек пакета создано при
//                     регистрации (0 - в манифесте нет ключа Настройки,
//                     они уже были или создание упало, см. ar_СлужебныйЛог).
//
Функция ЗарегистрироватьПакет(Знач ИдентификаторОбработки) Экспорт

	ЧтениеМанифеста = ПрочитатьМанифестКандидата(ИдентификаторОбработки);
	Если Не ЧтениеМанифеста.Успех Тогда
		ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ЧтениеМанифеста.Причина);
		Возврат РезультатРегистрации(Ложь, "Отклонён", ЧтениеМанифеста.Причина, 0);
	КонецЕсли;

	Валидация = ВалидироватьМанифест(ЧтениеМанифеста.Манифест, ИдентификаторОбработки);
	Если Не Валидация.Корректно Тогда
		ПричинаСводная = СтрСоединить(Валидация.Ошибки, "; ");
		ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ПричинаСводная);
		Возврат РезультатРегистрации(Ложь, "Отклонён", ПричинаСводная, 0);
	КонецЕсли;

	Кандидат = СведенияОКандидате(ИдентификаторОбработки);

	НачатьТранзакцию();
	Попытка
		КоличествоTools = ЗаписатьПакетИTools(ИдентификаторОбработки, ЧтениеМанифеста.Манифест, Кандидат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗарегистрироватьПакет", "package_registration_write_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат РезультатРегистрации(Ложь, "Отклонён", "registration_write_error", 0);
	КонецПопытки;

	// Пересчёт доступности выполняется ПОСЛЕ фиксации транзакции регистрации
	// намеренно (см. спеку §5): транзакция покрывает только запись
	// ar_ПакетыИнструментов + ar_Инструменты пакета, пересчёт по всему реестру - отдельная,
	// более широкая операция без прямого отношения к атомарности регистрации
	// одного пакета; если он упадёт, пакет уже зарегистрирован корректно, а
	// доступность будет пересчитана при следующем изменении реестра.
	ar_ИнструментыДиспетчер.ПересчитатьДоступностьВсехTools();

	// Свойство() вместо доступа через точку - на этом шаге манифест уже прошёл
	// ВалидироватьМанифест (пространство имён гарантированно есть), но безопасный
	// доступ дешевле, чем риск падения в строке лога после успешной записи.
	ПространствоИмёнДляЛога = "";
	ЧтениеМанифеста.Манифест.Свойство("ПространствоИмён", ПространствоИмёнДляЛога);
	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗарегистрироватьПакет", "package_registered",
		ИдентификаторОбработки + " (namespace=" + ПространствоИмёнДляЛога + ")", "Информация");

	Если Не Кандидат.БезопасныйРежим Тогда
		// PKG-05 §3: регистрация пакета с БезопасныйРежим = Ложь ПРОХОДИТ
		// (решение 2 Части 5 - барьерной константы нет), но фиксируется двумя
		// независимыми механизмами - служебный лог для оперативной диагностики
		// и отдельное событие аудита package_registered_unsafe (администратор
		// сознательно допустил пакет с доступом к файловой системе/сети/внешним
		// компонентам).
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗарегистрироватьПакет", "package_registered_unsafe_mode",
			ИдентификаторОбработки, "Предупреждение");

		ВерсияПакетаДляАудита = "";
		ЧтениеМанифеста.Манифест.Свойство("Версия", ВерсияПакетаДляАудита);
		ПолезнаяНагрузкаНебезопасно = Новый Структура;
		ПолезнаяНагрузкаНебезопасно.Вставить("package", ИдентификаторОбработки);
		ПолезнаяНагрузкаНебезопасно.Вставить("namespace", ПространствоИмёнДляЛога);
		ПолезнаяНагрузкаНебезопасно.Вставить("version", ВерсияПакетаДляАудита);
		ПолезнаяНагрузкаНебезопасно.Вставить("tools_count", КоличествоTools);
		ПолезнаяНагрузкаНебезопасно.Вставить("actor", ИмяТекущегоПользователяПакетов());
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "package_registered_unsafe",
			ПолезнаяНагрузкаНебезопасно);
	КонецЕсли;

	// Настройки пакета (спека agentrunner-21 п.Б.7) создаются ПОСЛЕ фиксации
	// транзакции и пересчёта доступности: сбой создания настроек не откатывает
	// регистрацию (пакет остаётся рабочим, вводимые значения - прерогатива
	// администратора), ошибка фиксируется в служебном логе. Привилегированный
	// режим - как у записи самого пакета: регистрацию запускает администратор.
	СозданоНастроек = СоздатьНастройкиПакета(ЧтениеМанифеста.Манифест, ИдентификаторОбработки);

	Возврат РезультатРегистрации(Истина, "Зарегистрирован", "", КоличествоTools, СозданоНастроек);

КонецФункции

// Создаёт недостающие настройки пакета из ключа Настройки манифеста
// (спека agentrunner-21 п.Б.7) - в привилегированном режиме, как запись
// самого пакета: регистрацию запускает администратор. Совпадение ключей
// между пакетами не проверяется: существующий ключ считается общим и не
// трогается (попадает в "БылоРанее").
//
// Исключение создание настроек НЕ распространяет: регистрация уже зафиксирована
// и не откатывается - ошибка пишется в ar_СлужебныйЛог (package_settings_error).
//
// Параметры:
//  Манифест               - Структура - манифест пакета, прошедший ВалидироватьМанифест.
//  ИдентификаторОбработки - Строка - идентификатор пакета (для лога).
//
// Возвращаемое значение:
//  Число - сколько настроек создано (0 - в манифесте нет ключа Настройки,
//          они уже были или создание упало).
//
Функция СоздатьНастройкиПакета(Знач Манифест, Знач ИдентификаторОбработки)

	ОписанияНастроек = Неопределено;
	Манифест.Свойство("Настройки", ОписанияНастроек);

	Если ТипЗнч(ОписанияНастроек) <> Тип("Массив") Или ОписанияНастроек.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ИтогНастроек = Неопределено;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ИтогНастроек = ar_Настройки.ДобавитьНедостающиеНастройки(ОписанияНастроек);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.СоздатьНастройкиПакета", "package_settings_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат 0;
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.СоздатьНастройкиПакета", "package_settings_created",
		СтрШаблон("%1: Создано=%2; БылоРанее=%3", ИдентификаторОбработки,
			ИтогНастроек.Создано, ИтогНастроек.БылоРанее), "Информация");

	Возврат ИтогНастроек.Создано;

КонецФункции

// Отключает зарегистрированный пакет: статус -> "Отключён", все tools пакета
// -> ar_Включён = Ложь. Запись ar_ПакетыИнструментов остаётся (история), записи
// ar_Инструменты не удаляются - на них ссылается история вызовов ar_ДействияАгента.
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если запись пакета найдена и отключена.
//
Функция ОтключитьПакет(Знач ИдентификаторОбработки) Экспорт

	НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись = НаборЗаписей[0];
		Запись.ar_Статус = "Отключён";
		НаборЗаписей.Записать(Истина);

		ОтключитьToolsПакета(ИдентификаторОбработки);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ОтключитьПакет", "package_disable_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Ложь;
	КонецПопытки;

	ar_ИнструментыДиспетчер.ПересчитатьДоступностьВсехTools();

	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ОтключитьПакет", "package_disabled", ИдентификаторОбработки, "Информация");

	Возврат Истина;

КонецФункции

// Обходит все зарегистрированные пакеты (статус "Зарегистрирован" или
// "ТребуетПереподтверждения") и сверяет хеш их текущего манифеста с
// сохранённым в ar_ПакетыИнструментов.ar_ХешМанифеста. Дорогая операция (грузит
// бинарник каждого пакета) - вызывается только из формы настроек (PKG-06),
// не из горячего пути вызова tool.
//
// Расхождение хеша -> статус "ТребуетПереподтверждения", tools пакета
// получают ar_Доступен = Ложь (не ar_Включён - доступность вычисляемая, воля
// администратора не трогается, см. разделение полей в UNIV-03).
//
// Возвращаемое значение:
//  Структура:
//   * Проверено   - Число - количество проверенных пакетов.
//   * Изменилось  - Число - количество пакетов, у которых обнаружено
//                   расхождение хеша.
//
Функция ПроверитьХешиПакетов() Экспорт

	Проверено = 0;
	Изменилось = 0;

	Для Каждого ИдентификаторОбработки Из СписокЗарегистрированныхПакетов() Цикл

		Проверено = Проверено + 1;

		ЧтениеМанифеста = ПрочитатьМанифестКандидата(ИдентификаторОбработки);
		Если Не ЧтениеМанифеста.Успех Тогда
			// Пакет, который перестал читаться (удалён/сломан) - фиксируем
			// отклонение, но не удаляем историю регистрации.
			ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ЧтениеМанифеста.Причина);
			Изменилось = Изменилось + 1;
			Продолжить;
		КонецЕсли;

		НовыйХеш = ХешМанифеста(ЧтениеМанифеста.Манифест);
		ТекущийХеш = ХешПакетаИзРегистра(ИдентификаторОбработки);

		Если НовыйХеш <> ТекущийХеш Тогда
			ЗафиксироватьТребуетПереподтверждения(ИдентификаторОбработки, НовыйХеш);
			Изменилось = Изменилось + 1;
		КонецЕсли;

	КонецЦикла;

	Если Изменилось > 0 Тогда
		ar_ИнструментыДиспетчер.ПересчитатьДоступностьВсехTools();
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ПроверитьХешиПакетов", "packages_hash_checked",
		"Проверено: " + Проверено + ", изменилось: " + Изменилось, "Информация");

	Результат = Новый Структура;
	Результат.Вставить("Проверено", Проверено);
	Результат.Вставить("Изменилось", Изменилось);
	Возврат Результат;

КонецФункции

// Список tools, зарегистрированных из указанного пакета - для UI (PKG-06).
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор пакета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка / Имя / RiskLevel / Включён / Доступен.
//
Функция ToolsПакета(Знач ИдентификаторОбработки) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_Доступен КАК Доступен
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает ВСЕ известные реестру namespace пакетов (независимо от текущего
// статуса - "Зарегистрирован"/"ТребуетПереподтверждения"/"Отключён"/"Отклонён")
// вместе с признаком активности. PKG-05 §6: guard импорта пресетов
// (ar_ПресетыИмпорт.ЗаполнитьTools) отличает "имя похоже на tool ИЗВЕСТНОГО,
// но сейчас неактивного пакета" (диагностируемый отказ
// package_not_installed:<ns>) от "имя вообще не относится ни к одному
// известному пакету" (обычный tool_not_found, как и раньше).
//
// Возвращаемое значение:
//  Соответствие - Namespace (Строка) -> Активен (Булево, Истина для статусов
//  "Зарегистрирован"/"ТребуетПереподтверждения"). Namespace, встречающийся в
//  нескольких записях реестра, считается активным, если активна хотя бы одна.
//
Функция ВсеИзвестныеNamespace() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_Namespace КАК Namespace,
		|	Пакеты.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace <> """"";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Активен = (Выборка.Статус = "Зарегистрирован" Или Выборка.Статус = "ТребуетПереподтверждения");
		ТекущееЗначение = Результат.Получить(Выборка.Namespace);
		Если ТекущееЗначение = Неопределено Тогда
			Результат.Вставить(Выборка.Namespace, Активен);
		ИначеЕсли Активен И Не ТекущееЗначение Тогда
			Результат.Вставить(Выборка.Namespace, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Маркерное значение реквизита Идентификатор ТЧ Команды - контракт PKG-01
// (см. examples/ar_ПакетПример). Регистрозависимое и фиксированное.
Функция МаркерПакетаToolPack()
	Возврат "ar_ToolPack";
КонецФункции

// Версия схемы контракта манифеста, поддерживаемая текущим ядром. Схема 2 -
// русские ключи манифеста и русские значения уровня риска (решение человека
// 2026-10-01, спека agentrunner-21 п.В.2); манифесты схемы 1 (латинские ключи)
// не принимаются - см. legacy_manifest_keys в ВалидироватьМанифест.
Функция ПоддерживаемаяВерсияСхемы()
	Возврат 2;
КонецФункции

// Конструктор результата МеханизмПакетовДоступен().
Функция НовыйРезультатДоступности(Знач Доступен, Знач Причина)
	Возврат Новый Структура("Доступен, Причина", Доступен, Причина);
КонецФункции

// Конструктор результата ПрочитатьМанифестКандидата().
Функция НовыйРезультатЧтенияМанифеста(Знач Успех, Знач Манифест, Знач Причина)
	Возврат Новый Структура("Успех, Манифест, Причина", Успех, Манифест, Причина);
