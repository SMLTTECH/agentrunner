// Конструктор результата ВалидироватьМанифест().
Функция РезультатВалидации(Знач Корректно, Знач Ошибки)
	Возврат Новый Структура("Корректно, Ошибки", Корректно, Ошибки);
КонецФункции

// Конструктор результата ЗарегистрироватьПакет().
Функция РезультатРегистрации(Знач Успех, Знач Статус, Знач ПричинаОтказа, Знач КоличествоTools, Знач СозданоНастроек = 0)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("ПричинаОтказа", ПричинаОтказа);
	Результат.Вставить("КоличествоTools", КоличествоTools);
	Результат.Вставить("СозданоНастроек", СозданоНастроек);
	Возврат Результат;
КонецФункции

// Возвращает ссылку на элемент справочника ДополнительныеОтчетыИОбработки по
// строковому идентификатору (UUID). Справочник НЕ заимствован в расширение
// (см. PKG-02) - разыменование через универсальную коллекцию Справочники по
// имени, а не через типизированное свойство Справочники.ДополнительныеОтчетыИОбработки,
// чтобы модуль оставался компилируемым в конфигурации без подсистемы БСП.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка, либо
//  Неопределено при некорректном UUID.
//
Функция СсылкаПоИдентификатору(Знач ИдентификаторОбработки)

	Попытка
		UUID = Новый УникальныйИдентификатор(ИдентификаторОбработки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		МенеджерСправочника = Справочники["ДополнительныеОтчетыИОбработки"];
		Ссылка = МенеджерСправочника.ПолучитьСсылку(UUID);
		// ПолучитьСсылку - конструктор ссылки, а не поиск: для несуществующего
		// UUID он возвращает заполненную "битую" ссылку, которую ЗначениеЗаполнено
		// у вызывающего кода пропускает (reference_not_found не срабатывал бы
		// никогда). Проверяем существование объекта явно.
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Проверяет тип "число" без привязки к конкретному числовому подтипу JSON
// (schema_version может прийти как Число из ar_JSON.ИзJSON).
Функция ЭтоЧисло(Знач Значение)
	Возврат ТипЗнч(Значение) = Тип("Число");
КонецФункции

// Формат пространства имён: [a-z][a-z0-9_]{1,30} - латиница в нижнем регистре,
// первый символ - буква, длина 2-31 символ. Без РегулярныеВыражения (нет в 1С
// глобальном контексте) - посимвольная проверка.
Функция СоответствуетФорматуПространстваИмён(Знач ПространствоИмён)

	Длина = СтрДлина(ПространствоИмён);
	Если Длина < 2 Или Длина > 31 Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрочныеБуквы = "abcdefghijklmnopqrstuvwxyz";
	Цифры = "0123456789";

	ПервыйСимвол = Сред(ПространствоИмён, 1, 1);
	Если СтрНайти(СтрочныеБуквы, ПервыйСимвол) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 2 По Длина Цикл
		Символ = Сред(ПространствоИмён, Позиция, 1);
		Если СтрНайти(СтрочныеБуквы, Символ) = 0 И СтрНайти(Цифры, Символ) = 0 И Символ <> "_" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, занято ли пространство имён ДРУГИМ зарегистрированным пакетом.
// Повторная регистрация того же пакета (тот же ИдентификаторОбработки)
// коллизией не считается - иначе обновление пакета стало бы невозможным.
Функция ПространствоИмёнЗанятДругимПакетом(Знач ПространствоИмён, Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПространствоИмён", ПространствоИмён);
	Запрос.УстановитьПараметр("ИдентификаторОбработки", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace = &ПространствоИмён
		|	И Пакеты.ar_ИдентификаторОбработки <> &ИдентификаторОбработки
		|	И Пакеты.ar_Статус <> ""Отклонён""";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

// Проверяет один элемент массива Tools манифеста - проверки 6-11 из §3
// спеки. Найденные ошибки добавляются в МассивОшибок (передан по ссылке).
Процедура ВалидироватьОдинTool(Знач ОписаниеTool, Знач Namespace, Знач ИдентификаторОбработки, МассивОшибок)

	Если ТипЗнч(ОписаниеTool) <> Тип("Структура") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest::not_a_structure");
		Возврат;
	КонецЕсли;

	Имя = Неопределено;
	ОписаниеTool.Свойство("Имя", Имя);
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest::Имя");
		Возврат;
	КонецЕсли;

	// 4а. Описание tool - обязательное поле контракта PKG-01 (§1.5, строка 167):
	// "Описание - Строка(до 500 симв.), да". Без этой проверки манифест без
	// Описания проходил бы валидацию и падал уже в ЗаписатьПакетИTools при
	// прямом обращении ОписаниеTool.Описание.
	Описание = Неопределено;
	ОписаниеTool.Свойство("Описание", Описание);
	Если ТипЗнч(Описание) <> Тип("Строка") Или ПустаяСтрока(Описание) Тогда
		МассивОшибок.Добавить("invalid_tool_description:" + Имя);
	КонецЕсли;

	// 4б. Версия tool - обязательное поле контракта PKG-01 (§1.5, строка 172):
	// "Версия - Строка, да" (SemVer, версионируется независимо от Версии пакета).
	ВерсияTool = Неопределено;
	ОписаниеTool.Свойство("Версия", ВерсияTool);
	Если ТипЗнч(ВерсияTool) <> Тип("Строка") Или ПустаяСтрока(ВерсияTool) Тогда
		МассивОшибок.Добавить("invalid_tool_version:" + Имя);
	КонецЕсли;

	// 6. namespacing имени.
	ПрефиксОжидаемый = Namespace + "_";
	Если Лев(Имя, СтрДлина(ПрефиксОжидаемый)) <> ПрефиксОжидаемый Тогда
		МассивОшибок.Добавить("name_not_namespaced:" + Имя);
	КонецЕсли;

	// 7. коллизия имени с существующим tool другого источника.
	Если ИмяЗанятоДругимИсточником(Имя, ИдентификаторОбработки) Тогда
		МассивОшибок.Добавить("name_collision:" + Имя);
	КонецЕсли;

	// 8/8а. СхемаАргументовJSON: разбор, соответствие function.name, структура OpenAI tool-format.
	СхемаАргументов = Неопределено;
	ОписаниеTool.Свойство("СхемаАргументовJSON", СхемаАргументов);
	ВалидироватьJSONManifest(СхемаАргументов, Имя, МассивОшибок);

	// 9. УровеньРиска - русские имена значений (решение человека 2026-10-01,
	// спека agentrunner-21 п.В.1), совпадают с именами значений
	// Перечисление.ar_УровеньРиска.
	УровеньРиска = Неопределено;
	ОписаниеTool.Свойство("УровеньРиска", УровеньРиска);
	Если Не РискУровеньДопустим(УровеньРиска) Тогда
		МассивОшибок.Добавить("invalid_risk_level:" + Имя);
	Иначе
		// 10. УровеньРиска Запись/Фиксация требует ТребуетПодтверждения = Истина.
		Если (УровеньРиска = "Запись" Или УровеньРиска = "Фиксация") Тогда
			ТребуетПодтверждения = Неопределено;
			ОписаниеTool.Свойство("ТребуетПодтверждения", ТребуетПодтверждения);
			Если ТребуетПодтверждения <> Истина Тогда
				// Осознанное отклонение от правила: инструмент записывает данные
				// без подтверждения даже в ручном режиме. Допускается ТОЛЬКО при
				// явной декларации в манифесте пакета - ключ
				// ОбоснованиеЗаписиБезПодтверждения с непустым текстом обоснования
				// (ссылка на спеку/решение). Так поведение остаётся заявленным и
				// проверяемым, а не молча протащенным мимо правила: без
				// обоснования ошибка прежняя.
				// Живой случай: buh_create_reconciliation_act (RECON-01,
				// решение от 2026-07-21 - акт сверки пишется сразу).
				// Фиксация сюда НЕ попадает: фиксация - высший уровень риска,
				// для него отклонение запрещено (см. ниже).
				ОбоснованиеЗаписи = Неопределено;
				ОписаниеTool.Свойство("ОбоснованиеЗаписиБезПодтверждения", ОбоснованиеЗаписи);
				ЕстьОбоснование = (ТипЗнч(ОбоснованиеЗаписи) = Тип("Строка"))
					И Не ПустаяСтрока(СокрЛП(ОбоснованиеЗаписи));

				Если УровеньРиска = "Фиксация" Тогда
					МассивОшибок.Добавить("approval_required_for_risk:" + Имя);
				ИначеЕсли Не ЕстьОбоснование Тогда
					МассивОшибок.Добавить("approval_required_for_risk:" + Имя);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли УровеньРиска = "Чтение" Тогда
			// УровеньРиска = Чтение с ТребуетПодтверждения = Истина -
			// противоречивая декларация (read-only инструмент не должен
			// требовать подтверждения). Черновик сюда не попадает - для него
			// ТребуетПодтверждения = Истина осознанно допустим (PKG-03, проверка 9).
			ТребуетПодтвержденияЧтение = Неопределено;
			ОписаниеTool.Свойство("ТребуетПодтверждения", ТребуетПодтвержденияЧтение);
			Если ТребуетПодтвержденияЧтение = Истина Тогда
				МассивОшибок.Добавить("contradictory_risk_declaration:" + Имя);
			КонецЕсли;
		Иначе
			// УровеньРиска = Черновик - ТребуетПодтверждения любой (Истина/Ложь)
			// допустим, проверка не применяется (PKG-03, проверка 9).
		КонецЕсли;
	КонецЕсли;

	// 11. ТребуемыеОбъекты / ТребуемыеПодсистемы - массивы строк либо отсутствуют.
	Если Не МассивСтрокИлиОтсутствует(ОписаниеTool, "ТребуемыеОбъекты") Тогда
		МассивОшибок.Добавить("invalid_required_objects:" + Имя);
	КонецЕсли;
	Если Не МассивСтрокИлиОтсутствует(ОписаниеTool, "ТребуемыеПодсистемы") Тогда
		МассивОшибок.Добавить("invalid_required_objects:" + Имя);
	КонецЕсли;

КонецПроцедуры

// Проверяет структуру OpenAI tool-format JSONManifest (шаг 8/8а спеки):
// {"type":"function","function":{"name","description","parameters":{"type":"object","properties":{...},"required":[...]}}}.
Процедура ВалидироватьJSONManifest(Знач СхемаАргументов, Знач Имя, МассивОшибок)

	Если ТипЗнч(СхемаАргументов) <> Тип("Строка") Или ПустаяСтрока(СхемаАргументов) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":JSONManifest");
		Возврат;
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(СхемаАргументов);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":parse_error");
		Возврат;
	КонецЕсли;

	ЗначениеТипа = Разобрано.Получить("type");
	Если ЗначениеТипа <> "function" Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":type");
	КонецЕсли;

	ОписаниеФункции = Разобрано.Получить("function");
	Если ТипЗнч(ОписаниеФункции) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function");
		Возврат;
	КонецЕсли;

	FunctionName = ОписаниеФункции.Получить("name");
	Если ТипЗнч(FunctionName) <> Тип("Строка") Или ПустаяСтрока(FunctionName) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.name");
	ИначеЕсли FunctionName <> Имя Тогда
		МассивОшибок.Добавить("manifest_name_mismatch:" + Имя);
	Иначе
		// function.name совпадает с Имя - ошибок нет.
	КонецЕсли;

	Description = ОписаниеФункции.Получить("description");
	Если ТипЗнч(Description) <> Тип("Строка") Или ПустаяСтрока(Description) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.description");
	КонецЕсли;

	Параметры = ОписаниеФункции.Получить("parameters");
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.parameters");
		Возврат;
	КонецЕсли;

	ТипПараметров = Параметры.Получить("type");
	Свойства = Параметры.Получить("properties");
	Если ТипПараметров <> "object" Или ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.parameters");
		Возврат;
	КонецЕсли;

	// Каждое свойство в properties имеет type.
	Для Каждого ЭлементСвойства Из Свойства Цикл
		ОписаниеСвойства = ЭлементСвойства.Значение;
		Если ТипЗнч(ОписаниеСвойства) <> Тип("Соответствие") Или ОписаниеСвойства.Получить("type") = Неопределено Тогда
			МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":properties." + ЭлементСвойства.Ключ);
		КонецЕсли;
	КонецЦикла;

	// required, если есть, - массив строк, каждая присутствует в properties.
	Обязательные = Параметры.Получить("required");
	Если Обязательные <> Неопределено Тогда
		Если ТипЗнч(Обязательные) <> Тип("Массив") Тогда
			МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":required");
		Иначе
			Для Каждого ИмяОбязательного Из Обязательные Цикл
				Если ТипЗнч(ИмяОбязательного) <> Тип("Строка") Или Свойства.Получить(ИмяОбязательного) = Неопределено Тогда
					МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":required");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Допустимые значения УровеньРиска манифеста - русские имена значений
// Перечисление.ar_УровеньРиска (Чтение/Черновик/Запись/Фиксация), манифест
// схемы 2 объявляет уровень риска сразу именем значения перечисления
// (решение человека 2026-10-01, спека agentrunner-21 п.В.1).
Функция РискУровеньДопустим(Знач УровеньРиска)
	Возврат УровеньРиска = "Чтение" Или УровеньРиска = "Черновик"
		Или УровеньРиска = "Запись" Или УровеньРиска = "Фиксация";
КонецФункции

// Проверяет, что реквизит структуры ИмяРеквизита - массив строк, либо
// отсутствует/Неопределено.
Функция МассивСтрокИлиОтсутствует(Знач Структура, Знач ИмяРеквизита)

	Значение = Неопределено;
	Структура.Свойство(ИмяРеквизита, Значение);

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, занято ли имя tool ДРУГИМ источником (ядровым модулем или другим
// пакетом), включая ядровые имена (query, ask_user и т.п.). Повторная
// регистрация того же пакета своими же именами коллизией не считается.
Функция ИмяЗанятоДругимИсточником(Знач Имя, Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИдентификаторОбработки", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления
		|	И (Tools.ar_ИсточникТип <> ""Пакет""
		|		ИЛИ Tools.ar_ИдентификаторПакета <> &ИдентификаторОбработки)";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

// Собирает сведения о кандидате (БезопасныйРежим, ИмяОбъекта, Версия) из
// НайтиКандидатов() по ИдентификаторОбработки - используется при регистрации
// для заполнения РегистрСведений.ar_ПакетыИнструментов.
Функция СведенияОКандидате(Знач ИдентификаторОбработки)

	Кандидаты = НайтиКандидатов();
	Для Каждого СтрокаКандидата Из Кандидаты Цикл
		Если Строка(СтрокаКандидата.Ссылка.УникальныйИдентификатор()) = ИдентификаторОбработки Тогда
			Результат = Новый Структура;
			Результат.Вставить("ИмяОбъекта", СтрокаКандидата.ИмяОбъекта);
			Результат.Вставить("БезопасныйРежим", СтрокаКандидата.БезопасныйРежим);
			Результат.Вставить("Версия", СтрокаКандидата.Версия);
			Результат.Вставить("НайденВНайтиКандидатов", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	// Кандидат уже не проходит фильтр НайтиКандидатов (например, снят с
	// публикации между чтением манифеста и записью) - используем значения по
	// умолчанию, регистрация продолжается на основе уже прочитанного манифеста.
	Результат = Новый Структура;
	Результат.Вставить("ИмяОбъекта", "");
	Результат.Вставить("БезопасныйРежим", Истина);
	Результат.Вставить("Версия", "");
	Результат.Вставить("НайденВНайтиКандидатов", Ложь);
	Возврат Результат;

КонецФункции

// Записывает РегистрСведений.ar_ПакетыИнструментов и все tools пакета в
// Справочник.ar_Инструменты. Вызывается внутри уже открытой транзакции
// (ЗарегистрироватьПакет) - без собственного НачатьТранзакцию.
//
// Возвращаемое значение:
//  Число - количество записанных tools.
//
Функция ЗаписатьПакетИTools(Знач ИдентификаторОбработки, Знач Манифест, Знач Кандидат)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Запись = НаборЗаписей.Добавить();
		Запись.ar_ИдентификаторОбработки = ИдентификаторОбработки;
		Запись.ar_Namespace = Манифест.ПространствоИмён;
		Запись.ar_ВерсияПакета = Манифест.Версия;
		Запись.ar_SchemaVersion = Манифест.ВерсияСхемы;
		Запись.ar_ХешМанифеста = ХешМанифеста(Манифест);
		Запись.ar_Статус = "Зарегистрирован";
		Запись.ar_ПричинаОтказа = "";
		Запись.ar_КоличествоИнструментов = Манифест.Инструменты.Количество();
		Запись.ar_БезопасныйРежим = Кандидат.БезопасныйРежим;
		Запись.ar_ИмяОбъектаОбработки = Кандидат.ИмяОбъекта;
		Запись.ar_ДатаРегистрации = ТекущаяДатаСеанса();
		Запись.ar_Пользователь = ИмяТекущегоПользователяПакетов();
		НаборЗаписей.Записать(Истина);

		Для Каждого ОписаниеTool Из Манифест.Инструменты Цикл
			ЗарегистрироватьОдинToolПакета(ОписаниеTool, ИдентификаторОбработки, Манифест.ПространствоИмён, Манифест);
		КонецЦикла;

		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Манифест.Инструменты.Количество();

КонецФункции

// Идемпотентно создаёт/обновляет запись Справочник.ar_Инструменты для одного tool
// пакета - тот же паттерн, что и ar_ToolCRM.ЗарегистрироватьОдинTool.
// Выполняется в уже поднятом привилегированном режиме (см. ЗаписатьПакетИTools).
//
// CMPT-02: перед записью вызывает ПрименитьНаследованиеСовместимости - если
// tool расширяет совместимость, унаследованную от манифеста пакета (§1.4/§1.5
// контракта), запись НЕ создаётся и НЕ обновляется (см. НЕ входит в реестр
// вовсе, а не создаётся недоступной с причиной widens_compatibility -
// обоснование: это нарушение контракта автором пакета, тот же класс отказа,
// что invalid_tool_manifest/name_not_namespaced в ВалидироватьОдинTool, где
// невалидный tool тоже не попадает в ar_Инструменты; отдельный код причины
// недоступности здесь не нужен, Факт 4 Уточнения 1 спеки CMPT-02).
// Исключений не бросает - только собирает причину и возвращает управление,
// чтобы не сорвать транзакцию ЗарегистрироватьПакет (Уточнение 1 спеки,
// Факт 2).
Процедура ЗарегистрироватьОдинToolПакета(Знач ОписаниеTool, Знач ИдентификаторОбработки, Знач Namespace, Знач Манифест)

	// Безопасный доступ через Свойство() везде, а не через точку: манифест на
	// этом шаге уже прошёл ВалидироватьМанифест (обязательные поля проверены
	// в ВалидироватьОдинTool), но защитный доступ здесь дешевле, чем риск
	// падения платформенным исключением "Поле объекта не обнаружено" уже
	// внутри открытой транзакции регистрации.
	Имя = "";
	ОписаниеTool.Свойство("Имя", Имя);

	Наследование = ПрименитьНаследованиеСовместимости(Манифест, ОписаниеTool);
	Если Не Наследование.Корректно Тогда
		Для Каждого ПричинаОтказа Из Наследование.Ошибки Цикл
			ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗарегистрироватьОдинToolПакета", "tool_widens_package_compatibility",
				ИдентификаторОбработки + " / " + Имя + ": " + ПричинаОтказа, "Предупреждение");
		КонецЦикла;
		// Расширяющий tool не создаётся и не обновляется в ar_Инструменты - остальные
		// tools пакета обрабатываются циклом ЗаписатьПакетИTools дальше как ни
		// в чём не бывало (см. Уточнение 1 спеки CMPT-02, Факт 2).
		Возврат;
	КонецЕсли;

	СсылкаTool = НайтиСсылкуToolПоИмениПакета(Имя);

	Если ЗначениеЗаполнено(СсылкаTool) Тогда
		Объект = СсылкаTool.ПолучитьОбъект();
	Иначе
		Объект = Справочники.ar_Инструменты.СоздатьЭлемент();
	КонецЕсли;

	КраткоеОписание = "";
	ОписаниеTool.Свойство("КраткоеОписание", КраткоеОписание);

	Описание = "";
	ОписаниеTool.Свойство("Описание", Описание);
	СхемаАргументов = "";
	ОписаниеTool.Свойство("СхемаАргументовJSON", СхемаАргументов);
	УровеньРиска = "";
	ОписаниеTool.Свойство("УровеньРиска", УровеньРиска);
	ТребуетПодтверждения = Ложь;
	ОписаниеTool.Свойство("ТребуетПодтверждения", ТребуетПодтверждения);
	ВерсияTool = "";
	ОписаниеTool.Свойство("Версия", ВерсияTool);

	Объект.Наименование = Имя;
	Объект.ar_Имя = Имя;
	Объект.ar_Описание = Описание;
	Объект.ar_JSONManifest = СхемаАргументов;
	// Схема 2: имя уровня риска в манифесте совпадает с именем значения
	// перечисления (ВалидироватьОдинTool уже гарантировал допустимость) -
	// значение берётся из менеджера перечисления по имени. Защитный дефолт
	// "Чтение" - на случай рассинхронизации вызовов (раньше её давала
	// ЗначениеУровняРискаПоИмениМанифеста).
	Объект.ar_RiskLevel = Перечисления.ar_УровеньРиска[
		?(РискУровеньДопустим(УровеньРиска), УровеньРиска, "Чтение")];
	Объект.ar_ОбщийМодуль = "";
	Объект.ar_ИмяПроцедуры = "";
	Объект.ar_ТребуетApproval = ТребуетПодтверждения;
	Объект.ar_Версия = ВерсияTool;
	Объект.ar_ИсточникРасширение = "";
	Объект.ar_Включён = Истина;
	Объект.ar_ИсточникТип = "Пакет";
	Объект.ar_ИдентификаторПакета = ИдентификаторОбработки;
	Объект.ar_Namespace = Namespace;
	Объект.ar_КраткоеОписание = КраткоеОписание;

	// CMPT-02: итоговые (унаследованные/суженные) значения четырёх полей
	// совместимости + объединённые ТребуемыеОбъекты/ТребуемыеПодсистемы -
	// результат ПрименитьНаследованиеСовместимости выше, а не сырые поля
	// ОписаниеTool. Это единственное место, где ar_Инструменты пакетных tools
	// получает эти реквизиты (до CMPT-02 они не заполнялись вовсе, см.
	// Уточнение 1 спеки, Факт 2).
	Объект.ar_ПоддерживаемыеКонфигурации = Наследование.Значения.ПоддерживаемыеКонфигурации;
	Объект.ar_МинВерсияКонфигурации = Наследование.Значения.МинВерсияКонфигурации;
	Объект.ar_МаксВерсияКонфигурации = Наследование.Значения.МаксВерсияКонфигурации;
	Объект.ar_МинВерсияAgentRunner = Наследование.Значения.МинВерсияAgentRunner;
	Объект.ar_ТребуемыеОбъекты = ar_JSON.ВЗначениеJSON(Наследование.Значения.ТребуемыеОбъекты);
	Объект.ar_ТребуемыеПодсистемы = ar_JSON.ВЗначениеJSON(Наследование.Значения.ТребуемыеПодсистемы);

	Объект.Записать();

КонецПроцедуры

// CMPT-02: вычисляет итоговые значения четырёх полей совместимости и двух
// списков зависимостей для ОДНОГО tool пакета - манифест пакета (§1.4
// контракта) плюс собственные декларации tool (§1.5 контракта, "правило
// сужения совместимости"). Не пишет ничего в ИБ и не бросает исключений -
// чистая функция над двумя структурами, тестируемая отдельно от записи (см.
// .docs/specs/CMPT-02.md "Точка врезки").
//
// Правило: МинВерсияКонфигурации/МинВерсияAgentRunner - tool может только
// ПОДНЯТЬ минимум (итог = max); МаксВерсияКонфигурации - tool может только
// ОПУСТИТЬ максимум (итог = min); ПоддерживаемыеКонфигурации - tool может
// только СУЗИТЬ множество типов (итог = tool, если tool - подмножество
// пакета либо пакет не задан = "любая"); ТребуемыеОбъекты/ТребуемыеПодсистемы -
// UNION пакета и tool (список обязательных зависимостей может только расти).
// Пустое значение с любой стороны (пакет или tool) трактуется как "нет
// ограничения" и не участвует в max/min/сужении.
//
// Манифест пакета (§1.4 контракта) сейчас НЕ содержит ключей
// ТребуемыеОбъекты/ТребуемыеПодсистемы (заведены только на уровне tool,
// §1.5) - пакетная часть union для этих двух полей поэтому всегда пустое
// множество, итог union равен просто множеству tool (см. .docs/specs/CMPT-02.md,
// Уточнение 1, Факт 1 - контракт сознательно не расширяется этой задачей).
//
// Параметры:
//  Манифест     - Структура - манифест пакета целиком (см. ar_ОписаниеИнструментов).
//  ОписаниеTool - Структура - один элемент Манифест.Инструменты.
//
// Возвращаемое значение:
//  Структура:
//   * Корректно - Булево      - Ложь, если tool расширяет совместимость пакета
//                 хотя бы по одному полю.
//   * Ошибки    - Массив строк - "tool_widens_package_compatibility:<имя
//                 поля>" на каждое расширяющее поле (без имени tool - имя
//                 добавляет вызывающий код, у которого оно уже есть).
//   * Значения  - Структура - {ПоддерживаемыеКонфигурации, МинВерсияКонфигурации,
//                 МаксВерсияКонфигурации, МинВерсияAgentRunner, ТребуемыеОбъекты
//                 (Массив строк), ТребуемыеПодсистемы (Массив строк)} - итоговые
//                 значения для записи в Объект.ar_* (актуальны, только если
//                 Корректно = Истина).
//
Функция ПрименитьНаследованиеСовместимости(Знач Манифест, Знач ОписаниеTool)

	Ошибки = Новый Массив;

	ВерсияПакетаМин = СтроковоеПолеПакета(Манифест, "МинимальнаяВерсияКонфигурации");
	ВерсияTMин = СтроковоеПолеTool(ОписаниеTool, "МинимальнаяВерсияКонфигурации");
	ИтогМин = ИтогНижнейГраницы(ВерсияПакетаМин, ВерсияTMин, "МинимальнаяВерсияКонфигурации", Ошибки);

	ВерсияПакетаМакс = СтроковоеПолеПакета(Манифест, "МаксимальнаяВерсияКонфигурации");
	ВерсияTМакс = СтроковоеПолеTool(ОписаниеTool, "МаксимальнаяВерсияКонфигурации");
	ИтогМакс = ИтогВерхнейГраницы(ВерсияПакетаМакс, ВерсияTМакс, "МаксимальнаяВерсияКонфигурации", Ошибки);

	ARМинПакета = СтроковоеПолеПакета(Манифест, "МинимальнаяВерсияAgentRunner");
	ARМинTool = СтроковоеПолеTool(ОписаниеTool, "МинимальнаяВерсияAgentRunner");
	ИтогARМин = ИтогНижнейГраницы(ARМинПакета, ARМинTool, "МинимальнаяВерсияAgentRunner", Ошибки);

	КонфигурацииПакета = СтроковоеПолеПакета(Манифест, "ПоддерживаемыеКонфигурации");
	КонфигурацииTool = СтроковоеПолеTool(ОписаниеTool, "ПоддерживаемыеКонфигурации");
	ИтогКонфигурации = ИтогПоддерживаемыхКонфигураций(КонфигурацииПакета, КонфигурацииTool, Ошибки);

	Значения = Новый Структура;
	Значения.Вставить("ПоддерживаемыеКонфигурации", ИтогКонфигурации);
	Значения.Вставить("МинВерсияКонфигурации", ИтогМин);
	Значения.Вставить("МаксВерсияКонфигурации", ИтогМакс);
	Значения.Вставить("МинВерсияAgentRunner", ИтогARМин);
	Значения.Вставить("ТребуемыеОбъекты", ОбъединённыйМассивСтрок(МассивПолеПакета(Манифест, "ТребуемыеОбъекты"), МассивПолеTool(ОписаниеTool, "ТребуемыеОбъекты")));
	Значения.Вставить("ТребуемыеПодсистемы", ОбъединённыйМассивСтрок(МассивПолеПакета(Манифест, "ТребуемыеПодсистемы"), МассивПолеTool(ОписаниеTool, "ТребуемыеПодсистемы")));

	Результат = Новый Структура;
	Результат.Вставить("Корректно", Ошибки.Количество() = 0);
	Результат.Вставить("Ошибки", Ошибки);
	Результат.Вставить("Значения", Значения);
	Возврат Результат;

КонецФункции

// Безопасно читает строковое поле манифеста ПАКЕТА (§1.4 контракта) - "" при
// отсутствии ключа или несоответствии типа (трактуется как "нет ограничения").
Функция СтроковоеПолеПакета(Знач Манифест, Знач ИмяПоля)
	Значение = Неопределено;
	Манифест.Свойство(ИмяПоля, Значение);
	Возврат СокрЛП(?(ТипЗнч(Значение) = Тип("Строка"), Значение, ""));
КонецФункции

// Безопасно читает строковое поле описания TOOL (§1.5 контракта) - "" при
// отсутствии ключа или несоответствии типа (трактуется как "не задано,
// наследуется от пакета без изменений").
Функция СтроковоеПолеTool(Знач ОписаниеTool, Знач ИмяПоля)
	Значение = Неопределено;
	ОписаниеTool.Свойство(ИмяПоля, Значение);
	Возврат СокрЛП(?(ТипЗнч(Значение) = Тип("Строка"), Значение, ""));
КонецФункции

// Безопасно читает поле-массив строк манифеста ПАКЕТА. Манифест пакета (§1.4
// контракта) сейчас не декларирует ТребуемыеОбъекты/ТребуемыеПодсистемы на
// своём уровне (см. шапку ПрименитьНаследованиеСовместимости) - функция уже
// готова к появлению такого ключа в будущем расширении контракта, сейчас
// всегда возвращает пустой массив для обоих полей.
Функция МассивПолеПакета(Знач Манифест, Знач ИмяПоля)
	Значение = Неопределено;
	Манифест.Свойство(ИмяПоля, Значение);
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Безопасно читает поле-массив строк описания TOOL (ТребуемыеОбъекты/
// ТребуемыеПодсистемы, §1.5 контракта) - пустой массив при отсутствии/
// несоответствии типа (та же проверка формата уже выполнена
// МассивСтрокИлиОтсутствует на этапе ВалидироватьОдинTool).
Функция МассивПолеTool(Знач ОписаниеTool, Знач ИмяПоля)
	Значение = Неопределено;
	ОписаниеTool.Свойство(ИмяПоля, Значение);
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Итог нижней границы (МинимальнаяВерсияКонфигурации/МинимальнаяВерсияAgentRunner):
// tool может только ПОДНЯТЬ минимум пакета - итог = max(пакет, tool). Понижение
// минимума tool'ом - расширение совместимости, добавляет
// "tool_widens_package_compatibility:<ИмяПоля>" в МассивОшибок (передан по
// ссылке) и возвращает значение ПАКЕТА (игнорируя попытку tool расшириться).
//
// Сравнение - ОбщегоНазначенияКлиентСервер.СравнитьВерсии с нормализацией
// 3->4 разряда (ar_ИнструментыДиспетчер.НормализованнаяВерсия) в Попытка: мусор в
// одном поле манифеста одного пакета не должен ронять регистрацию (см.
// .docs/specs/CMPT-02.md, "Сравнение версий").
Функция ИтогНижнейГраницы(Знач ЗначениеПакета, Знач ЗначениеTool, Знач ИмяПоля, МассивОшибок)

	Если ПустаяСтрока(ЗначениеTool) Тогда
		Возврат ЗначениеПакета;
	КонецЕсли;
	Если ПустаяСтрока(ЗначениеПакета) Тогда
		Возврат ЗначениеTool;
	КонецЕсли;

	Попытка
		Сравнение = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(
			ar_ИнструментыДиспетчер.НормализованнаяВерсия(ЗначениеTool),
			ar_ИнструментыДиспетчер.НормализованнаяВерсия(ЗначениеПакета));
	Исключение
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ИтогНижнейГраницы", "package_version_compare_error",
			ИмяПоля + ": " + ЗначениеПакета + " / " + ЗначениеTool + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
		// Мусор в версии - критерий пропускается, значение пакета остаётся как
		// безопасный дефолт (то же fail-safe решение, что и в ar_ИнструментыДиспетчер).
		Возврат ЗначениеПакета;
	КонецПопытки;

	Если Сравнение < 0 Тогда
		// tool просит МЕНЬШИЙ минимум, чем пакет - расширение, отказ.
		МассивОшибок.Добавить("tool_widens_package_compatibility:" + ИмяПоля);
		Возврат ЗначениеПакета;
	КонецЕсли;

	Возврат ЗначениеTool;

КонецФункции

// Итог верхней границы (МаксимальнаяВерсияКонфигурации): tool может только
// ОПУСТИТЬ максимум пакета - итог = min(пакет, tool). Симметрично
// ИтогНижнейГраницы, см. её комментарий про сравнение/fail-safe.
Функция ИтогВерхнейГраницы(Знач ЗначениеПакета, Знач ЗначениеTool, Знач ИмяПоля, МассивОшибок)

	Если ПустаяСтрока(ЗначениеTool) Тогда
		Возврат ЗначениеПакета;
	КонецЕсли;
	Если ПустаяСтрока(ЗначениеПакета) Тогда
		Возврат ЗначениеTool;
	КонецЕсли;

	Попытка
		Сравнение = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(
			ar_ИнструментыДиспетчер.НормализованнаяВерсия(ЗначениеTool),
			ar_ИнструментыДиспетчер.НормализованнаяВерсия(ЗначениеПакета));
	Исключение
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ИтогВерхнейГраницы", "package_version_compare_error",
			ИмяПоля + ": " + ЗначениеПакета + " / " + ЗначениеTool + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
		Возврат ЗначениеПакета;
	КонецПопытки;

	Если Сравнение > 0 Тогда
		// tool просит БОЛЬШИЙ максимум, чем пакет - расширение, отказ.
		МассивОшибок.Добавить("tool_widens_package_compatibility:" + ИмяПоля);
		Возврат ЗначениеПакета;
	КонецЕсли;

	Возврат ЗначениеTool;

КонецФункции

// Итог ПоддерживаемыеКонфигурации: сужением считается подмножество списка
// пакета (список - типы через запятую, тот же формат, что
// ar_ИнструментыДиспетчер.ПричинаЕслиКонфигурацияНеПоддерживается: без учёта
// регистра/пробелов). Пустой список пакета = "любая" - tool со своим списком
// это всегда сужение, принимается без вопросов. Непустой список пакета +
// значение tool, содержащее тип, которого нет у пакета, - расширение, отказ
// (возвращается список ПАКЕТА, попытка tool игнорируется).
Функция ИтогПоддерживаемыхКонфигураций(Знач СписокПакета, Знач СписокTool, МассивОшибок)

	Если ПустаяСтрока(СписокTool) Тогда
		Возврат СписокПакета;
	КонецЕсли;
	Если ПустаяСтрока(СписокПакета) Тогда
		Возврат СписокTool;
	КонецЕсли;

	МассивТиповПакета = МассивВВерхнемРегистре(СтрРазделить(СписокПакета, ",", Ложь));
	МассивТиповTool = СтрРазделить(СписокTool, ",", Ложь);

	Для Каждого ТипTool Из МассивТиповTool Цикл
		ТипTool = ВРег(СокрЛП(ТипTool));
		Если ПустаяСтрока(ТипTool) Тогда
			Продолжить;
		КонецЕсли;
		Если МассивТиповПакета.Найти(ТипTool) = Неопределено Тогда
			МассивОшибок.Добавить("tool_widens_package_compatibility:ПоддерживаемыеКонфигурации");
			Возврат СписокПакета;
		КонецЕсли;
	КонецЦикла;

	Возврат СписокTool;

КонецФункции

// Приводит массив строк к верхнему регистру с обрезкой пробелов - для
// сравнения элементов ПоддерживаемыеКонфигурации без учёта регистра.
Функция МассивВВерхнемРегистре(Знач Массив)
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Результат.Добавить(ВРег(СокрЛП(Элемент)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// UNION двух массивов строк без дубликатов - ТребуемыеОбъекты/ТребуемыеПодсистемы
// пакета и tool объединяются (список обязательных зависимостей может только
// расти, а не сужаться, см. .docs/specs/CMPT-02.md). Порядок - сначала
// элементы пакета, затем новые элементы tool; сравнение по точному значению
// строки (логические имена объектов метаданных и имена подсистем БСП - обе
// категории регистрозависимы по факту использования в остальном коде).
// Уникальность отслеживается через Соответствие (O(1) на проверку), а не
// Массив.Найти() в цикле - списки коротки на практике, но избегает
// квадратичной сложности без усложнения кода.
Функция ОбъединённыйМассивСтрок(Знач МассивПакета, Знач МассивTool)

	Результат = Новый Массив;
	УжеДобавлены = Новый Соответствие;

	Для Каждого Элемент Из МассивПакета Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") И Не ПустаяСтрока(Элемент) И УжеДобавлены.Получить(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
			УжеДобавлены.Вставить(Элемент, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из МассивTool Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") И Не ПустаяСтрока(Элемент) И УжеДобавлены.Получить(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
			УжеДобавлены.Вставить(Элемент, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Находит ссылку ar_Инструменты по реквизиту ar_Имя. Неопределено, если нет записи.
Функция НайтиСсылкуToolПоИмениПакета(Знач ИмяTool)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", ИмяTool);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Фиксирует отклонённый пакет в РегистрСведений.ar_ПакетыИнструментов (статус
// "Отклонён" с причиной). Повреждённый пакет НЕ роняет ядро - вызывается из
// ЗарегистрироватьПакет/ПроверитьХешиПакетов при неуспешном чтении манифеста
// или провале валидации.
Процедура ЗафиксироватьОтклонённыйПакет(Знач ИдентификаторОбработки, Знач Причина)

	ДлинаПоляПричина = 500;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Запись = НаборЗаписей.Добавить();
		Запись.ar_ИдентификаторОбработки = ИдентификаторОбработки;
		Запись.ar_Статус = "Отклонён";
		Запись.ar_ПричинаОтказа = Лев(Причина, ДлинаПоляПричина);
		Запись.ar_ДатаРегистрации = ТекущаяДатаСеанса();
		Запись.ar_Пользователь = ИмяТекущегоПользователяПакетов();
		НаборЗаписей.Записать(Истина);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗафиксироватьОтклонённыйПакет", "package_rejection_write_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗафиксироватьОтклонённыйПакет", "package_rejected",
		ИдентификаторОбработки + ": " + Причина, "Ошибка");

КонецПроцедуры

// Фиксирует расхождение хеша: статус -> "ТребуетПереподтверждения",
// сохраняет новый хеш, tools пакета -> ar_Доступен = Ложь.
Процедура ЗафиксироватьТребуетПереподтверждения(Знач ИдентификаторОбработки, Знач НовыйХеш)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Если НаборЗаписей.Количество() > 0 Тогда
			Запись = НаборЗаписей[0];
			Запись.ar_Статус = "ТребуетПереподтверждения";
			Запись.ar_ХешМанифеста = НовыйХеш;
			НаборЗаписей.Записать(Истина);
		КонецЕсли;

		СделатьToolsПакетаНедоступными(ИдентификаторОбработки);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗафиксироватьТребуетПереподтверждения", "package_hash_update_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_ИнструментыПакеты.ЗафиксироватьТребуетПереподтверждения", "package_hash_mismatch",
		ИдентификаторОбработки, "Предупреждение");

КонецПроцедуры

// Выставляет ar_Доступен = Ложь для всех tools пакета (расхождение хеша -
// доверие пакету приостановлено до переподтверждения администратором).
// Выполняется в уже поднятом привилегированном режиме вызывающей процедуры.
Процедура СделатьToolsПакетаНедоступными(Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.ar_Доступен = Ложь;
			Объект.ar_ПричинаНедоступности = "package_hash_mismatch";
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выставляет ar_Включён = Ложь для всех tools пакета (ОтключитьПакет) -
// осознанное действие администратора, в отличие от ar_Доступен.
// Выполняется в уже поднятом привилегированном режиме вызывающей процедуры.
Процедура ОтключитьToolsПакета(Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.ar_Включён = Ложь;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает набор записей регистра ar_ПакетыИнструментов по идентификатору
// обработки (отбор по измерению, набор из 0 или 1 записи - регистр
// непериодический, независимый).
Функция НаборЗаписейПакета(Знач ИдентификаторОбработки)

	НаборЗаписей = РегистрыСведений.ar_ПакетыИнструментов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ar_ИдентификаторОбработки.Установить(ИдентификаторОбработки);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;

КонецФункции

// Список идентификаторов пакетов со статусом "Зарегистрирован" или
// "ТребуетПереподтверждения" - кандидаты на проверку хеша.
Функция СписокЗарегистрированныхПакетов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")";

	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.ИдентификаторОбработки);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Текущий сохранённый хеш манифеста пакета из регистра. Пустая строка, если
// записи ещё нет.
Функция ХешПакетаИзРегистра(Знач ИдентификаторОбработки)

	НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат НаборЗаписей[0].ar_ХешМанифеста;

КонецФункции

// Вычисляет SHA-256 хеш нормализованного JSON манифеста в виде hex-строки
// (64 символа) - ar_ПакетыИнструментов.ar_ХешМанифеста (Строка(64)). Готового
// хелпера хеширования в проекте нет (grep по src/ на ХешированиеДанных пуст) -
// используется платформенный ХешированиеДанных с ХешФункция.SHA256, тот же
// приём, что и в БСП (см. ДополнительныеОтчетыИОбработки.РежимПодключенияОтчетаОбработки).
Функция ХешМанифеста(Знач Манифест)

	JSONТекст = ar_JSON.ВЗначениеJSON(Манифест);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(JSONТекст, КодировкаТекста.UTF8, Ложь);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Человекочитаемое представление значения для подстановки в код причины
// отказа (unsupported_schema_version:<N>, invalid_namespace:<значение>).
Функция ПредставлениеЗначенияПакета(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат "undefined";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Имя текущего пользователя ИБ для записей регистра ar_ПакетыИнструментов и audit
// payload package_registered_unsafe. Не Пользователи.ТекущийПользователь()
// (справочник Пользователи не заимствован в расширение) - платформенный
// ПользователиИнформационнойБазы, как в ar_ДиагностикаОчистка.ИмяТекущегоПользователя()
// (та функция не экспортная - вызвать её отсюда нельзя, поэтому копия).
Функция ИмяТекущегоПользователяПакетов()

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийПользовательИБ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТекущийПользовательИБ.Имя;

КонецФункции

#КонецОбласти
