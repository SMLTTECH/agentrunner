////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ОбработчикПодписокПовтИсп - кэширующее чтение активных подписок
// агентов (ar_ПодпискиАгентов) для обработчика записи объектов
// ar_ОбработчикПодписок.ПриЗаписиОбъекта (agentrunner-290).
//
// Свойство "Возвращаемые значения: повторное использование - на время сеанса"
// (ReturnValuesReuse=DuringSession): результат кэшируется платформой на сеанс по
// значению параметра - запись объекта того же типа в том же сеансе не читает
// справочник. Кэш сеанса живёт до 20 минут после вычисления, поэтому изменение
// подписки в других сеансах вступает в силу не позже чем через 20 минут; в сеансе,
// записавшем подписку, - сразу (модуль объекта справочника сбрасывает кэш
// методом ОбновитьПовторноИспользуемыеЗначения). Выключенную подписку по
// устаревшему кэшу агент не запустит: разбор очереди проверяет подписку заново.
//
// Возвращаемое значение - фиксированная коллекция: кэшированное значение
// передаётся вызывающему по ссылке, изменяемую коллекцию вызывающий код мог бы
// испортить для всего сеанса.
//
// Чтение выполняется в привилегированном режиме (как в ar_НастройкиПовтИсп):
// объект записывает пользователь без прав на справочник подписок; в безопасном
// режиме привилегированный не устанавливается, чтение идёт в правах вызывающего.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Активные подписки на событие ПриЗаписи объектов типа (кэш сеанса).
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//                     (например, "Справочник.Контрагенты").
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - подписки (пустой - подписок нет):
//   * Ссылка        - СправочникСсылка.ar_ПодпискиАгентов - подписка.
//   * ar_Агент      - СправочникСсылка.ar_Агенты - агент подписки.
//   * ar_ФильтрJSON - Строка - JSON-фильтр по реквизитам объекта.
//
Функция АктивныеПодпискиОбъекта(Знач ПолноеИмяОбъекта) Экспорт

	// Привилегированный режим включается в теле функции: включённый в
	// вызываемой процедуре режим гаснет при выходе из неё.
	Если БезопасныйРежим() = Ложь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Возврат ar_ОбработчикПодписок.АктивныеПодпискиОбъектаБезКэша(ПолноеИмяОбъекта);

КонецФункции

#КонецОбласти
