////////////////////////////////////////////////////////////////////////////////
// Заимствованный общий модуль ПодключаемыеКомандыПереопределяемый (БСП).
//
// agentrunner-26 п.18: команда «Диалог с AI» в формах объектов. Только два
// перехватчика &После; код «БИТ» не копируется - типовой вызов выполняется
// сам, наша команда добавляется после него.
//
// Список объектов - типовая настройка ar_Настройки «ОбъектыСДиалогомИИ»
// (строка полного имени вида «Справочник.Контрагенты»; для совместимости
// принимается и ссылка Справочник.ИдентификаторыОбъектовМетаданных). Команда
// добавляется только для объектов определяемого типа ar_ПрикладнойОбъект
// (agentrunner-46 п.5). Пустой или выключенный список - команда не
// добавляется нигде. Состав команд кэшируется БСП на сеанс
// (ПодключаемыеКомандыПовтИсп, DuringSession) - изменение списка действует
// в новых сеансах.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Определить вид подключаемых команд «Диалог с AI» (перехват &После).
//
// Параметры:
//  ВидыПодключаемыхКоманд - ТаблицаЗначений - см. БСП ПодключаемыеКомандыПереопределяемый.
//
&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура ar_ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд)

	ВидКоманды = ВидыПодключаемыхКоманд.Добавить();
	ВидКоманды.Имя         = "ar_ДиалогИИ";
	ВидКоманды.ИмяПодменю  = "ar_ПодменюДиалогИИ";
	ВидКоманды.Заголовок   = НСтр("ru = 'Диалог с AI';
		|en = 'AI dialog'");
	ВидКоманды.Отображение = ОтображениеКнопки.КартинкаИТекст;
	ВидКоманды.Порядок     = 10;

КонецПроцедуры

// Определить команды «Диалог с AI» для объектов из настройки
// «ОбъектыСДиалогомИИ» (перехват &После).
//
// Параметры:
//  НастройкиФормы - Структура - см. БСП (ИмяФормы).
//  Источники - ДеревоЗначений - объекты-поставщики команд: объект формы - строка
//              первого уровня (колонки Метаданные, ПолноеИмя, Менеджер,
//              СсылкаМетаданных, ТипСсылкиДанных).
//  ПодключенныеОтчетыИОбработки - ТаблицаЗначений - см. БСП.
//  Команды - ТаблицаЗначений - сюда записываются команды.
//
&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура ar_ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники,
	ПодключенныеОтчетыИОбработки, Команды)

	// Пустой или выключенный список - команды нет нигде (спека п.18).
	Если Не ar_Настройки.НастройкаЗаполнена("ОбъектыСДиалогомИИ") Тогда
		Возврат;
	КонецЕсли;

	СписокОбъектов = ar_Настройки.СписокЗначений("ОбъектыСДиалогомИИ");
	Если СписокОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Объект формы - строка первого уровня дерева источников.
	ТипыПредмета = Новый Массив;
	Для Каждого Источник Из Источники.Строки Цикл
		Если ОбъектВСписке(Источник, СписокОбъектов) Тогда
			ДополнитьТипыПредмета(ТипыПредмета, Источник.ТипСсылкиДанных);
		КонецЕсли;
	КонецЦикла;

	Если ТипыПредмета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Команда = Команды.Добавить();
	Команда.Вид             = "ar_ДиалогИИ";
	Команда.Идентификатор   = "ar_ДиалогИИ";
	Команда.Представление   = НСтр("ru = 'Диалог с AI';
		|en = 'AI dialog'");
	Команда.Важность        = "Обычное";
	Команда.Порядок         = 10;
	Команда.Назначение      = "ДляОбъекта";
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи     = "НеЗаписывать";
	Команда.ИмяФормы        = "Справочник.ar_Диалоги.Форма.ФормаСписка";
	Команда.ИмяПараметраФормы = "Предмет";
	// Тип параметра - тип ссылки объекта формы; иначе БСП команду удалит.
	Команда.ТипПараметра    = Новый ОписаниеТипов(ТипыПредмета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект-источник входит в список настройки: по ссылке на
// ИдентификаторыОбъектовМетаданных (колонка СсылкаМетаданных) либо по строке
// полного имени (колонка ПолноеИмя).
//
// Параметры:
//  Источник      - СтрокаДереваЗначений - объект формы (строка первого уровня).
//  СписокОбъектов - Массив - значения настройки «ОбъектыСДиалогомИИ».
//
// Возвращаемое значение:
//  Булево - Истина, если объект входит в список.
//
Функция ОбъектВСписке(Знач Источник, Знач СписокОбъектов)

	Если ЗначениеЗаполнено(Источник.СсылкаМетаданных)
		И СписокОбъектов.Найти(Источник.СсылкаМетаданных) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не ПустаяСтрока(Источник.ПолноеИмя)
		И СписокОбъектов.Найти(СокрЛП(Источник.ПолноеИмя)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Дополнить массив типов предмета типами ссылки объекта-источника
// (колонка ТипСсылкиДанных: Тип или ОписаниеТипов). В состав попадают только
// типы определяемого типа ar_ПрикладнойОбъект (спека agentrunner-46 п.5):
// объект в списке настройки, но вне состава - команды на его форме нет
// (иначе форма списка диалогов получила бы параметр Предмет недопустимого типа).
//
// Параметры:
//  ТипыПредмета    - Массив из Тип - дополняемый массив.
//  ТипСсылкиДанных - Тип, ОписаниеТипов - тип ссылки источника.
//
Процедура ДополнитьТипыПредмета(ТипыПредмета, Знач ТипСсылкиДанных)

	Если ТипЗнч(ТипСсылкиДанных) = Тип("Тип") Тогда
		Если ar_ПредметыАгентов.ТипПредметаВСоставе(ТипСсылкиДанных) Тогда
			ТипыПредмета.Добавить(ТипСсылкиДанных);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТипСсылкиДанных) = Тип("ОписаниеТипов") Тогда
		Для Каждого ОдинТип Из ТипСсылкиДанных.Типы() Цикл
			Если ar_ПредметыАгентов.ТипПредметаВСоставе(ОдинТип) Тогда
				ТипыПредмета.Добавить(ОдинТип);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
