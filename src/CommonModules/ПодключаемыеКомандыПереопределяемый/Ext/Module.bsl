////////////////////////////////////////////////////////////////////////////////
// Заимствованный общий модуль ПодключаемыеКомандыПереопределяемый (БСП).
//
// agentrunner-26 п.18: команда «Диалог с AI» в формах объектов. Только два
// перехватчика &После; код «БИТ» не копируется - типовой вызов выполняется
// сам, наша команда добавляется после него.
//
// Список объектов - типовая настройка ar_Настройки «ОбъектыСДиалогомИИ»
// (ссылка Справочник.ИдентификаторыОбъектовМетаданных либо строка полного
// имени вида «Справочник.Контрагенты»). Пустой или выключенный список -
// команда не добавляется нигде. Состав команд кэшируется БСП на сеанс
// (ПодключаемыеКомандыПовтИсп, DuringSession) - изменение списка действует
// в новых сеансах.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Определить вид подключаемых команд «Диалог с AI» (перехват &После).
//
// Параметры:
//  ВидыПодключаемыхКоманд - ТаблицаЗначений - см. БСП ПодключаемыеКомандыПереопределяемый.
//
&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура ar_ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд)

	ВидКоманды = ВидыПодключаемыхКоманд.Добавить();
	ВидКоманды.Имя         = "ar_ДиалогИИ";
	ВидКоманды.ИмяПодменю  = "ar_ПодменюДиалогИИ";
	ВидКоманды.Заголовок   = НСтр("ru = 'Диалог с AI';
		|en = 'AI dialog'");
	ВидКоманды.Отображение = ОтображениеКнопки.КартинкаИТекст;
	ВидКоманды.Порядок     = 10;

КонецПроцедуры

// Определить команды «Диалог с AI» для объектов из настройки
// «ОбъектыСДиалогомИИ» (перехват &После).
//
// Параметры:
//  НастройкиФормы - Структура - см. БСП (ИмяФормы).
//  Источники - ДеревоЗначений - объекты-поставщики команд (Метаданные,
//              ПолноеИмя, Ссылка).
//  ПодключенныеОтчетыИОбработки - ТаблицаЗначений - см. БСП.
//  Команды - ТаблицаЗначений - сюда записываются команды.
//
&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура ar_ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники,
	ПодключенныеОтчетыИОбработки, Команды)

	// Пустой или выключенный список - команды нет нигде (спека п.18).
	Если Не ar_Настройки.НастройкаЗаполнена("ОбъектыСДиалогомИИ") Тогда
		Возврат;
	КонецЕсли;

	СписокОбъектов = ar_Настройки.СписокЗначений("ОбъектыСДиалогомИИ");
	Если СписокОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаИсточников Из Источники.Строки Цикл

		Для Каждого Источник Из СтрокаИсточников.Строки Цикл

			Если Не ОбъектВСписке(Источник, СписокОбъектов) Тогда
				Продолжить;
			КонецЕсли;

			Команда = Команды.Добавить();
			Команда.Вид             = "ar_ДиалогИИ";
			Команда.Идентификатор   = "ar_ДиалогИИ";
			Команда.Представление   = НСтр("ru = 'Диалог с AI';
				|en = 'AI dialog'");
			Команда.Важность        = "Обычное";
			Команда.Порядок         = 10;
			Команда.Назначение      = "ДляОбъекта";
			Команда.ИзменяетВыбранныеОбъекты = Ложь;
			Команда.МножественныйВыбор = Ложь;
			Команда.РежимЗаписи     = "НеЗаписывать";
			Команда.ИмяФормы        = "Справочник.ar_Диалоги.Форма.ФормаСписка";
			Команда.ИмяПараметраФормы = "Предмет";

			ТипСсылки = ТипСсылкиИсточника(Источник);
			Если ТипСсылки <> Неопределено Тогда
				Команда.ТипПараметра = Новый ОписаниеТипов(ТипСсылки);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект-источник входит в список настройки: по ссылке на
// ИдентификаторыОбъектовМетаданных либо по строке полного имени.
//
Функция ОбъектВСписке(Знач Источник, Знач СписокОбъектов)

	Попытка
		СсылкаИдентификатора = Источник.Ссылка;
		ПолноеИмя = Источник.ПолноеИмя;
	Исключение
		// Строка дерева без ожидаемых колонок - источник не наш.
		Возврат Ложь;
	КонецПопытки;

	Если ЗначениеЗаполнено(СсылкаИдентификатора)
		И СписокОбъектов.Найти(СсылкаИдентификатора) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не ПустаяСтрока(ПолноеИмя)
		И СписокОбъектов.Найти(СокрЛП(ПолноеИмя)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Тип ссылки источника (для ТипПараметра команды) - ссылка на объект
// метаданных из ИдентификаторыОбъектовМетаданных.
//
Функция ТипСсылкиИсточника(Знач Источник)

	Попытка
		СсылкаИдентификатора = Источник.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ЗначениеЗаполнено(СсылкаИдентификатора) Тогда
		Возврат ТипЗнч(СсылкаИдентификатора);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
