////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПресетыИмпорт. Импорт агента из пресета в ar_Агенты.
//
// Назначение: десериализация JSON пресета -> создание нового элемента
// Справочник.ar_Агенты. Не использует привилегированный режим.
//
// Два публичных входа с общим ядром (ИмпортироватьИзТекстаJSON):
//   - ИмпортироватьПресет(СсылкаПресет) - пресет из справочника ar_Пресеты
//     (ar_Пресеты.ar_JSON), пользовательские/marketplace-пресеты (UI-17).
//   - ИмпортироватьПресетИзТекста(ТекстJSON, ИмяFallback) - пресет из готового
//     текста JSON (например, макета встроенной обработки ar_ПресетыВстроенные,
//     см. ar_МастерНастройки шаг "Пресет") - без ссылки на справочник.
//
// Контракт JSON пресета (kind = "agent_preset", ar_preset_version = 1):
//   { "kind": "agent_preset", "ar_preset_version": 1, "description": "...",
//     "compatible_configs": ["universal"] | ["ИмяКонфигурации", ...] (опц.),
//     "agent": { "name", "instruction", "llm_provider_name", "model",
//                "temperature", "max_steps", "max_actions", "max_action_sum",
//                "autonomy_mode", "tools": [{"name","enabled","required"}],
//                "skills": [{"name"}] } }
//
// Необязательные ключи блока agent (agentrunner-37), ar_preset_version = 1:
//   "plan_work" (boolean), "plan_template" (массив строк и/или объектов шага
//   {title, close_tools, instruction} - строка формата
//   "Заголовок | инструменты | инструкция" или просто "Заголовок"; строка
//   целиком - как раньше), "use_sessions" (boolean), "answer_timeout_hours"
//   (целое 0..9999), "schedule_cron" (строка cron), "queue_from_package"
//   (boolean), "queue_package" (строка, namespace пакета, до 100 символов),
//   "max_parallel_runs" (целое 1..999).
// Ключ отсутствует - реквизит агента не трогается. Неверный тип или значение -
// предупреждение в Результат.Предупреждения (агент все равно создается),
// реквизит не заполняется. Корректный "schedule_cron" создает активную рутину
// ar_Рутины (ar_ТипТриггера = "cron", ar_ПараметрыJSON = {"expression": ...})
// в транзакции импорта; ar_Агенты.ar_РасписаниеCron (устаревшее) не заполняется.
// Экспорт полного пресета агента - ПресетАгентаJSON (кнопка карточки агента
// "Сохранить как пресет агента"); повторный импорт файла дает агента с теми же
// значениями.
//
// compatible_configs - опционален, по умолчанию ["universal"]; несовпадение
// с текущей конфигурацией (Метаданные.Имя) не блокирует импорт, только
// выставляет Результат.НесовместимаяКонфигурация = Истина.
// tools[].required (опц., по умолчанию Ложь) - если tool с этим флагом не
// найден, его имя дополнительно попадает в Результат.НеНайденыОбязательныеTools.
//
// SEC-TOOL-01: ЗАПРЕЩЕНО принимать из tools[] пресета ключ
// "code_implementation" (зарезервированное имя) с непустым значением -
// ВалидироватьСтруктуруПресета отклоняет такой пресет отказом
// "tool_code_import_forbidden" (не предупреждением). Любой будущий импорт
// tools (в этом модуле или в новом) обязан отклонять непустой
// ar_КодРеализации/эквивалент; режим «Код» справочника ar_Инструменты принимается
// ТОЛЬКО через ручной ввод в карточке администратором с полными правами.
// См. .docs/Модель-угроз-режим-Код.md.
//
// Свойства: Сервер, не клиент, не привилегированный.
// См. спеку: .docs/specs/UI-17.md, .docs/specs/SEC-TOOL-01.md
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Импортирует пресет из справочника ar_Пресеты в новый элемент ar_Агенты.
//
// Читает ar_Пресеты.ar_JSON по ссылке, делегирует в ИмпортироватьИзТекстаJSON.
//
// Параметры:
//   СсылкаПресет - СправочникСсылка.ar_Пресеты - ссылка на пресет.
//
// Возвращаемое значение:
//   Структура - см. ИмпортироватьИзТекстаJSON.
//
Функция ИмпортироватьПресет(Знач СсылкаПресет) Экспорт

	ТекстJSON = ПолучитьJSONПресета(СсылкаПресет);
	ИмяFallback = "";
	Если ЗначениеЗаполнено(СсылкаПресет) Тогда
		ИмяFallback = СсылкаПресет.ar_Имя;
	КонецЕсли;

	Возврат ИмпортироватьИзТекстаJSON(ТекстJSON, ИмяFallback);

КонецФункции

// Импортирует пресет из готового текста JSON (без ссылки на справочник
// ar_Пресеты) в новый элемент ar_Агенты - используется для встроенных
// пресетов, поставляемых как макеты обработки ar_ПресетыВстроенные.
//
// Параметры:
//   ТекстJSON             - Строка - сырой текст JSON пресета.
//   ИмяFallback           - Строка - имя агента, если в JSON нет agent.name.
//   СсылкаПровайдераОверрайд - СправочникСсылка.ar_LLMПровайдеры - если
//     заполнена, заменяет llm_provider_name/model из пресета провайдером
//     и его ar_DefaultModel (мастер настройки: агент должен работать на
//     провайдере, который пользователь настроил на шаге 3, а не на том,
//     что зашит в конкретном пресете).
//
// Возвращаемое значение:
//   Структура - см. ИмпортироватьИзТекстаJSON.
//
Функция ИмпортироватьПресетИзТекста(Знач ТекстJSON, Знач ИмяFallback = "",
	Знач СсылкаПровайдераОверрайд = Неопределено) Экспорт

	Возврат ИмпортироватьИзТекстаJSON(ТекстJSON, ИмяFallback, СсылкаПровайдераОверрайд);

КонецФункции

// Собирает полный JSON-пресет агента (kind = "agent_preset", ar_preset_version = 1)
// из элемента ar_Агенты: все ключи, которые читает импорт. Провайдер и навыки -
// по имени; autonomy_mode - имя значения перечисления; plan_template - массив
// строк; schedule_cron - выражение первой активной cron-рутины агента (по
// ar_Имя), иначе непустое ar_РасписаниеCron (legacy), иначе ключ не выгружается.
// Не выгружает ar_Пользователь, резервного провайдера и коды инструментов
// (SEC-TOOL-01). Повторный импорт результата дает агента с теми же значениями.
//
// Параметры:
//   СсылкаАгент - СправочникСсылка.ar_Агенты
//
// Возвращаемое значение:
//   Строка - JSON пресета; "" если элемент не найден.
//
Функция ПресетАгентаJSON(Знач СсылкаАгент) Экспорт

	ОбъектАгента = СсылкаАгент.ПолучитьОбъект();
	Если ОбъектАгента = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	БлокАгента = Новый Структура;
	БлокАгента.Вставить("name", ОбъектАгента.Наименование);
	БлокАгента.Вставить("instruction", ОбъектАгента.ar_Инструкция);
	БлокАгента.Вставить("llm_provider_name", ИмяПровайдераАгента(ОбъектАгента.ar_LLMПровайдер));
	БлокАгента.Вставить("model", ОбъектАгента.ar_Модель);
	БлокАгента.Вставить("temperature", ОбъектАгента.ar_Температура);
	БлокАгента.Вставить("max_steps", ОбъектАгента.ar_МаксШагов);
	БлокАгента.Вставить("max_actions", ОбъектАгента.ar_МаксДействий);
	БлокАгента.Вставить("max_action_sum", ОбъектАгента.ar_МаксСуммаДействия);
	БлокАгента.Вставить("autonomy_mode", ИмяРежимаАвтономии(ОбъектАгента.ar_РежимАвтономии));
	БлокАгента.Вставить("tools", ИнструментыПресета(ОбъектАгента));
	БлокАгента.Вставить("skills", НавыкиПресета(ОбъектАгента));
	БлокАгента.Вставить("plan_work", ОбъектАгента.ar_ПланироватьРаботу);
	БлокАгента.Вставить("plan_template", ПунктыШаблонаПлана(ОбъектАгента.ar_ШаблонПлана));
	БлокАгента.Вставить("use_sessions", ОбъектАгента.ar_ИспользоватьСессии);
	БлокАгента.Вставить("answer_timeout_hours", ОбъектАгента.ar_СрокОтветаЧасов);
	БлокАгента.Вставить("queue_from_package", ОбъектАгента.ar_БратьИзОчередиПакета);
	БлокАгента.Вставить("queue_package", ОбъектАгента.ar_ПакетИсточник);
	// 0/пусто ядро трактует как 1 (agentrunner-32); импорт принимает 1..999 - ключ не выгружается,
	// иначе повторный импорт агента без заполненного реквизита давал бы ложное предупреждение.
	Если ОбъектАгента.ar_МаксПараллельныхЗапусков > 0 Тогда
		БлокАгента.Вставить("max_parallel_runs", ОбъектАгента.ar_МаксПараллельныхЗапусков);
	КонецЕсли;
	ВыражениеРасписания = ВыражениеРасписанияАгента(ОбъектАгента.Ссылка, ОбъектАгента.ar_РасписаниеCron);
	Если НЕ ПустаяСтрока(ВыражениеРасписания) Тогда
		БлокАгента.Вставить("schedule_cron", ВыражениеРасписания);
	КонецЕсли;

	Пресет = Новый Структура;
	Пресет.Вставить("kind", "agent_preset");
	Пресет.Вставить("ar_preset_version", 1);
	ОписаниеПресета = СтрШаблон(
		НСтр("ru = 'Выгружено из агента %1 %2'; en = 'Exported from agent %1 %2'"),
		ОбъектАгента.Наименование, ar_Утилиты.ФорматДата(ТекущаяДатаСеанса()));
	Пресет.Вставить("description", ОписаниеПресета);
	Пресет.Вставить("agent", БлокАгента);

	Возврат ar_JSON.КрасивыйФорматJSON(Пресет);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общее ядро импорта: десериализация, валидация, создание агента. Не
// пробрасывает исключений - все внутренние ошибки конвертируются в результат.
// Операция выполняется от имени текущего пользователя: при недостаточных
// правах запись завершится ошибкой => Успех = Ложь, Причина = "access_denied".
//
// Параметры:
//   ТекстJSON             - Строка - сырой текст JSON пресета.
//   ИмяFallback           - Строка - имя агента, если в JSON нет agent.name (не ссылка).
//   СсылкаПровайдераОверрайд - СправочникСсылка.ar_LLMПровайдеры - см.
//     ИмпортироватьПресетИзТекста; Неопределено = поведение не меняется
//     (провайдер/модель берутся из пресета, как раньше).
//
// Возвращаемое значение:
//   Структура - с ключами:
//     * Успех                     - Булево
//     * АгентСсылка               - СправочникСсылка.ar_Агенты (Неопределено при Успех=Ложь)
//     * НеНайденныеTools          - Массив строк (names не найденных tools)
//     * НеНайденыОбязательныеTools - Массив строк (подмножество НеНайденныеTools с required=true)
//     * НеНайденныеSkills         - Массив строк (names не найденных skills)
//     * НеНайденПровайдер         - Булево
//     * ИмяПровайдераПресет       - Строка (оригинальное имя из пресета, если не найден)
//     * НесовместимаяКонфигурация - Булево (compatible_configs не содержит текущую/"universal")
//     * Предупреждения             - Массив строк (ключи пресета, которые не удалось
//                                    применить из-за неверного типа/значения)
//     * Причина                   - Строка ("invalid_json","wrong_kind","unsupported_version",
//                                           "access_denied","error")
//
Функция ИмпортироватьИзТекстаJSON(Знач ТекстJSON, Знач ИмяFallback = "",
	Знач СсылкаПровайдераОверрайд = Неопределено)

	Результат = НовыйРезультатИмпорта();

	// 1. Проверяем, что текст непустой
	Если НЕ ЗначениеЗаполнено(ТекстJSON) Тогда
		Результат.Причина = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	// 2. Десериализуем
	Данные = ar_JSON.ИзJSON(ТекстJSON);
	Если Данные = Неопределено Тогда
		Результат.Причина = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	// 3. Валидируем структуру
	ОшибкаВалидации = ВалидироватьСтруктуруПресета(Данные);
	Если НЕ ПустаяСтрока(ОшибкаВалидации) Тогда
		Результат.Причина = ОшибкаВалидации;
		Возврат Результат;
	КонецЕсли;

	// 3а. Проверка совместимости конфигурации (не блокирует импорт)
	Результат.НесовместимаяКонфигурация = НЕ КонфигурацияСовместима(Данные);

	// 4. Извлекаем блок агента (уже проверен в валидаторе)
	БлокАгента = Данные.Получить("agent");

	// 5. Создаём нового агента в транзакции
	НачатьТранзакцию();
	Попытка
		НовыйАгент = Справочники.ar_Агенты.СоздатьЭлемент();
		ЗаполнитьАгентаИзПресета(НовыйАгент, БлокАгента, ИмяFallback, Результат, СсылкаПровайдераОверрайд);
		НовыйАгент.Записать();
		// Расписание из пресета - активная рутина cron, создается в той же
		// транзакции импорта после записи агента; ошибка записи рутины
		// откатывает и агента.
		СоздатьРутинуРасписания(НовыйАгент.Ссылка, БлокАгента, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		Если СтрНайти(НРег(ТекстОшибки), "доступ") > 0
			Или СтрНайти(НРег(ТекстОшибки), "право") > 0
			Или СтрНайти(НРег(ТекстОшибки), "недостаточно") > 0 Тогда
			Результат.Причина = "access_denied";
		Иначе
			Результат.Причина = "error";
		КонецЕсли;
		ЗаписатьОшибкуВЖурнал(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.АгентСсылка = НовыйАгент.Ссылка;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Проверяет совместимость пресета с текущей конфигурацией по полю
// compatible_configs (опционально; отсутствие трактуется как universal).
//
// Параметры:
//   Данные - Соответствие - разобранный JSON пресета (корень).
//
// Возвращаемое значение:
//   Булево - Истина, если пресет универсален или совместим с текущей конфигурацией.
//
Функция КонфигурацияСовместима(Знач Данные)

	СписокКонфигураций = Данные.Получить("compatible_configs");
	Если ТипЗнч(СписокКонфигураций) <> Тип("Массив") Или СписокКонфигураций.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяТекущейКонфигурации = НРег(Метаданные.Имя);

	Для Каждого Элемент Из СписокКонфигураций Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Элемент) = "universal" Или НРег(Элемент) = ИмяТекущейКонфигурации Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Создаёт заготовку результата импорта с пустыми полями.
//
// Возвращаемое значение:
//   Структура
//
Функция НовыйРезультатИмпорта()

	Рез = Новый Структура;
	Рез.Вставить("Успех", Ложь);
	Рез.Вставить("АгентСсылка", Неопределено);
	Рез.Вставить("НеНайденныеTools", Новый Массив);
	Рез.Вставить("НеНайденыОбязательныеTools", Новый Массив);
	Рез.Вставить("НеНайденныеSkills", Новый Массив);
	Рез.Вставить("НеНайденПровайдер", Ложь);
	Рез.Вставить("ИмяПровайдераПресет", "");
	Рез.Вставить("НесовместимаяКонфигурация", Ложь);
	Рез.Вставить("Предупреждения", Новый Массив);
	Рез.Вставить("Причина", "");
	Возврат Рез;

КонецФункции

// Получает строку JSON из поля ar_JSON пресета по ссылке.
//
// Параметры:
//   СсылкаПресет - СправочникСсылка.ar_Пресеты
//
// Возвращаемое значение:
//   Строка - содержимое поля ar_JSON или "" если не найден.
//
Функция ПолучитьJSONПресета(Знач СсылкаПресет)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ar_Пресеты.ar_JSON КАК JSON
	|ИЗ
	|	Справочник.ar_Пресеты КАК ar_Пресеты
	|ГДЕ
	|	ar_Пресеты.Ссылка = &Ссылка
	|	И ar_Пресеты.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Ссылка", СсылкаПресет);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.JSON;
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет структуру JSON-пресета на корректность.
//
// Параметры:
//   Данные - Соответствие - разобранный JSON
//
// Возвращаемое значение:
//   Строка - код ошибки или "" если всё ОК.
//
Функция ВалидироватьСтруктуруПресета(Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "invalid_json";
	КонецЕсли;

	// Проверяем наличие и значение ключа kind
	КлючKind = Данные.Получить("kind");
	Если КлючKind <> "agent_preset" Тогда
		Если КлючKind = Неопределено Тогда
			Возврат "invalid_json";
		КонецЕсли;
		Возврат "wrong_kind";
	КонецЕсли;

	// Проверяем версию (поддерживаемая версия = 1)
	Версия = Данные.Получить("ar_preset_version");
	Если ТипЗнч(Версия) <> Тип("Число") Тогда
		Возврат "invalid_json";
	КонецЕсли;

	Если Версия > 1 Тогда
		Возврат "unsupported_version";
	КонецЕсли;

	// Проверяем блок agent
	БлокAgent = Данные.Получить("agent");
	Если ТипЗнч(БлокAgent) <> Тип("Соответствие") Тогда
		Возврат "invalid_json";
	КонецЕсли;

	// SEC-TOOL-01: явный guard против импорта code-тулов через пресет.
	// ЗАПРЕЩЕНО: любой будущий импорт tools обязан отклонять непустой
	// ar_КодРеализации; режим «Код» принимается только через ручной ввод в
	// карточке ar_Инструменты администратором с полными правами - см. SEC-TOOL-01,
	// .docs/Модель-угроз-режим-Код.md. Прямого импорта элементов ar_Инструменты из
	// внешнего JSON сейчас не существует (пресет ссылается на tools по имени,
	// не создаёт и не переносит ar_КодРеализации) - эта проверка закрывает
	// единственную существующую точку расширения ДО появления реального
	// импортёра, а не разблокирует функциональность, которой нет.
	Если ar_ПресетСодержитЗапрещенныйКодИнструмента(БлокAgent) Тогда
		Возврат "tool_code_import_forbidden";
	КонецЕсли;

	Возврат "";

КонецФункции

// SEC-TOOL-01: проверяет, не описывает ли блок agent.tools[] пресета код
// реализации tool. Ключ "code_implementation" зарезервирован как ЗАПРЕЩЁННЫЙ
// в формате пресета - его присутствие с непустым значением у любого элемента
// tools[] является жёстким отказом (не предупреждением), независимо от того,
// существует ли сегодня реальный механизм переноса этого значения в
// ar_КодРеализации. Это превентивный контракт-guard, а не рабочая ветка
// импорта кода - см. .docs/specs/SEC-TOOL-01.md, раздел "Импорт tools -
// фактическое состояние".
//
// Параметры:
//   БлокAgent - Соответствие - блок "agent" из разобранного JSON пресета.
//
// Возвращаемое значение:
//   Булево - Истина, если хотя бы один элемент tools[] содержит непустой
//            "code_implementation".
//
Функция ar_ПресетСодержитЗапрещенныйКодИнструмента(Знач БлокAgent)

	МассивToolsJSON = БлокAgent.Получить("tools");
	Если ТипЗнч(МассивToolsJSON) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ЭлементJSON Из МассивToolsJSON Цикл
		Если ТипЗнч(ЭлементJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		КодРеализацииИзПресета = ЭлементJSON.Получить("code_implementation");
		Если ТипЗнч(КодРеализацииИзПресета) = Тип("Строка") И Не ПустаяСтрока(КодРеализацииИзПресета) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Заполняет реквизиты нового агента данными из блока "agent" пресета.
//
// Параметры:
//   НовыйАгент  - СправочникОбъект.ar_Агенты - создаваемый агент.
//   БлокАгента  - Соответствие - JSON-блок "agent".
//   ИмяFallback - Строка - имя агента, если в JSON нет agent.name.
//   Результат   - Структура - накапливает НеНайденные* и НеНайденПровайдер.
//   СсылкаПровайдераОверрайд - СправочникСсылка.ar_LLMПровайдеры - если
//     заполнена, имеет приоритет над llm_provider_name пресета; модель
//     берётся из ar_DefaultModel этого провайдера вместо "model" пресета.
//
Процедура ЗаполнитьАгентаИзПресета(НовыйАгент, Знач БлокАгента, Знач ИмяFallback, Результат,
	Знач СсылкаПровайдераОверрайд = Неопределено)

	// Наименование (fallback: имя пресета/макета => имя по умолчанию)
	ИмяИзПресета = ПолучитьСтрокуJSON(БлокАгента, "name");
	Если ПустаяСтрока(ИмяИзПресета) Тогда
		ИмяИзПресета = ИмяFallback;
	КонецЕсли;
	Если ПустаяСтрока(ИмяИзПресета) Тогда
		ИмяИзПресета = НСтр("ru = 'Агент из пресета'; en = 'Agent from preset'");
	КонецЕсли;
	НовыйАгент.Наименование = ИмяСуффиксПриДубликате(ИмяИзПресета);

	// Инструкция
	НовыйАгент.ar_Инструкция = ПолучитьСтрокуJSON(БлокАгента, "instruction");

	// LLM-провайдер (нормализованный поиск без учёта регистра). Если вызывающий
	// передал СсылкаПровайдераОверрайд (мастер настройки, шаг 3) - он побеждает
	// безусловно: агент должен работать на том, что пользователь реально
	// настроил, а не на llm_provider_name, зашитом в конкретном пресете
	// (иначе модель пресета может не существовать у выбранного провайдера -
	// см. project_agent_model_not_loaded_400).
	ИмяПровайдера = ПолучитьСтрокуJSON(БлокАгента, "llm_provider_name");
	Результат.ИмяПровайдераПресет = ИмяПровайдера;

	Если ЗначениеЗаполнено(СсылкаПровайдераОверрайд) Тогда

		НовыйАгент.ar_LLMПровайдер = СсылкаПровайдераОверрайд;

		// Модель провайдера может быть не заполнена (LocalCompatible: "имя модели
		// зависит от конкретного сервера, осмысленное умолчание подставить нельзя",
		// см. ar_МастерНастройки.МодельПоУмолчаниюДляТипа) - в этом случае пустая
		// строка стёрла бы известную рабочую модель пресета без замены. Модель
		// пресета - разумный fallback: не факт, что подойдёт новому провайдеру,
		// но лучше, чем гарантированно пустая (диспетчер LLM тогда шлёт запрос
		// вовсе без имени модели - см. project_agent_model_not_loaded_400).
		МодельПровайдера = СокрЛП(СсылкаПровайдераОверрайд.ar_DefaultModel);
		НовыйАгент.ar_Модель = ?(НЕ ПустаяСтрока(МодельПровайдера),
			МодельПровайдера, ПолучитьСтрокуJSON(БлокАгента, "model"));

	Иначе

		Если НЕ ПустаяСтрока(ИмяПровайдера) Тогда
			СсылкаПровайдера = НайтиПровайдераПоИмени(ИмяПровайдера);
			Если СсылкаПровайдера = Неопределено Тогда
				Результат.НеНайденПровайдер = Истина;
			Иначе
				НовыйАгент.ar_LLMПровайдер = СсылкаПровайдера;
			КонецЕсли;
		КонецЕсли;

		НовыйАгент.ar_Модель = ПолучитьСтрокуJSON(БлокАгента, "model");

	КонецЕсли;

	// Температура, лимиты
	НовыйАгент.ar_Температура       = ПолучитьЧислоJSON(БлокАгента, "temperature");
	НовыйАгент.ar_МаксШагов         = ПолучитьЦелоеЧислоJSON(БлокАгента, "max_steps");
	НовыйАгент.ar_МаксДействий      = ПолучитьЦелоеЧислоJSON(БлокАгента, "max_actions");
	НовыйАгент.ar_МаксСуммаДействия = ПолучитьЧислоJSON(БлокАгента, "max_action_sum");

	// Режим автономии (поиск значения перечисления по строковому имени через метаданные)
	ИмяРежима = ПолучитьСтрокуJSON(БлокАгента, "autonomy_mode");
	Если НЕ ПустаяСтрока(ИмяРежима) Тогда
		МетаЗначенияРежима = Метаданные.Перечисления.ar_РежимАвтономии.ЗначенияПеречисления;
		МетаЗначениеРежима = МетаЗначенияРежима.Найти(ИмяРежима);
		Если МетаЗначениеРежима <> Неопределено Тогда
			НовыйАгент.ar_РежимАвтономии = Перечисления.ar_РежимАвтономии[ИмяРежима];
		КонецЕсли;
	КонецЕсли;

	// План работы с шаблоном, сессии, срок ответа и очередь пакета -
	// необязательные ключи пресета (agentrunner-37), неверное значение -
	// предупреждение, а не отказ
	ЗаполнитьПланИзПресета(БлокАгента, НовыйАгент, Результат);
	ЗаполнитьСессииИзПресета(БлокАгента, НовыйАгент, Результат);
	ЗаполнитьОчередьИзПресета(БлокАгента, НовыйАгент, Результат);

	// Новый агент всегда создаётся неактивным
	НовыйАгент.ar_Активен = Ложь;

	// ТЧ ar_ДоступныеИнструменты
	ЗаполнитьTools(НовыйАгент, БлокАгента.Получить("tools"), Результат);

	// ТЧ ar_ПодключённыеSkills (условно - если META-24 реализована)
	ЗаполнитьSkills(НовыйАгент, БлокАгента.Получить("skills"), Результат);

КонецПроцедуры

// Заполняет ТЧ ar_ДоступныеИнструменты из массива tools пресета.
//
// Параметры:
//   НовыйАгент      - СправочникОбъект.ar_Агенты
//   МассивToolsJSON - Массив или Неопределено
//   Результат       - Структура - накапливает НеНайденныеTools и
//                      НеНайденыОбязательныеTools (подмножество с required=true)
//
Процедура ЗаполнитьTools(НовыйАгент, Знач МассивToolsJSON, Результат)

	Если ТипЗнч(МассивToolsJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	// Собираем все запрошенные имена
	ИменаTools = Новый Массив;
	ВключенностьПоИмени = Новый Соответствие;
	ОбязательностьПоИмени = Новый Соответствие;
	Для Каждого ЭлементJSON Из МассивToolsJSON Цикл
		Если ТипЗнч(ЭлементJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИмяTool = ПолучитьСтрокуСоответствия(ЭлементJSON, "name");
		Если ПустаяСтрока(ИмяTool) Тогда
			Продолжить;
		КонецЕсли;
		ИменаTools.Добавить(ИмяTool);
		ВключенностьПоИмени.Вставить(ИмяTool, (ЭлементJSON.Получить("enabled") = Истина));
		ОбязательностьПоИмени.Вставить(ИмяTool, (ЭлементJSON.Получить("required") = Истина));
	КонецЦикла;

	Если ИменаTools.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Пакетный запрос: ищем все tools сразу
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.ar_Имя КАК Имя
	|ИЗ
	|	Справочник.ar_Инструменты КАК т
	|ГДЕ
	|	т.ar_Имя В (&Имена)
	|	И т.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Имена", ИменаTools);
	НайденныеTools = Запрос.Выполнить().Выбрать();

	НайденныеПоИмени = Новый Соответствие;
	Пока НайденныеTools.Следующий() Цикл
		НайденныеПоИмени.Вставить(НайденныеTools.Имя, НайденныеTools.Ссылка);
	КонецЦикла;

	// PKG-05 §6: namespace всех известных реестру пакетов (в любом статусе) -
	// для отличия "имя похоже на tool известного, но сейчас неактивного пакета"
	// (диагностируемый отказ package_not_installed:<ns>) от "tool вообще не
	// относится ни к одному пакету, просто не найден" (обычный код ошибки).
	// Запрашивается один раз на весь вызов - ВсеИзвестныеNamespace() не
	// зависит от ИменаTools.
	ИзвестныеNamespace = ar_ИнструментыПакеты.ВсеИзвестныеNamespace();

	НовыйАгент.ar_ДоступныеИнструменты.Очистить();
	Для Каждого ИмяTool Из ИменаTools Цикл
		СсылкаTool = НайденныеПоИмени.Получить(ИмяTool);
		Если СсылкаTool = Неопределено Тогда
			ЗафиксироватьНенайденныйTool(ИмяTool, ИзвестныеNamespace,
				ОбязательностьПоИмени.Получить(ИмяTool) = Истина, Результат);
			Продолжить;
		КонецЕсли;
		НоваяСтрока = НовыйАгент.ar_ДоступныеИнструменты.Добавить();
		// ar_Инструмент - строковое имя tool (ar_Имя), не ссылка: тип реквизита ТЧ -
		// Строка(150), и форма карточки агента работает с ним как с именем.
		// Присваивание ссылки молча приводилось к её представлению, из-за чего
		// соединение с реестром ar_Инструменты не находило ни одной строки - агент
		// оставался без инструментов.
		НоваяСтрока.ar_Инструмент = ИмяTool;
		НоваяСтрока.ar_Включен = ВключенностьПоИмени.Получить(ИмяTool);
	КонецЦикла;

КонецПроцедуры

// Фиксирует ненайденный в ar_Инструменты элемент tools[] пресета в Результате -
// вынесено из ЗаполнитьTools отдельной функцией, чтобы снизить когнитивную
// сложность цикла (PKG-05 §6 добавил ветвление package_not_installed:<ns>
// поверх уже существовавшей логики НеНайденныеTools/НеНайденыОбязательныеTools).
//
// Параметры:
//   ИмяTool            - Строка - имя tool из пресета, не найденное в ar_Инструменты.
//   ИзвестныеNamespace - Соответствие - результат ar_ИнструментыПакеты.ВсеИзвестныеNamespace().
//   Обязателен         - Булево - required=true у этого элемента tools[] пресета.
//   Результат          - Структура - накапливает НеНайденныеTools/НеНайденыОбязательныеTools.
//
Процедура ЗафиксироватьНенайденныйTool(Знач ИмяTool, Знач ИзвестныеNamespace, Знач Обязателен, Результат)

	КодОтсутствияПакета = КодНеустановленногоПакета(ИмяTool, ИзвестныеNamespace);
	// Диагностируемый отказ package_not_installed:<ns> вместо немого попадания
	// в общий список "не найдено" - имя однозначно относится к известному
	// реестру пакету, который сейчас не активен (не установлен/отключён).
	КодДляРезультата = ?(ПустаяСтрока(КодОтсутствияПакета), ИмяTool, КодОтсутствияПакета);

	Результат.НеНайденныеTools.Добавить(КодДляРезультата);
	Если Обязателен Тогда
		Результат.НеНайденыОбязательныеTools.Добавить(КодДляРезультата);
	КонецЕсли;

КонецПроцедуры

// PKG-05 §6: определяет, относится ли ненайденное имя tool к ИЗВЕСТНОМУ
// реестру пакету, который сейчас не активен (не установлен/отключён/отклонён).
// Namespace пакета в пресете явно не указывается (контракт пресета оперирует
// только именем tool), поэтому имя сопоставляется с известными namespace по
// правилу "начинается с <namespace>_" - при нескольких совпадающих namespace
// (namespace сам может содержать "_") выбирается САМЫЙ ДЛИННЫЙ, как наиболее
// специфичное совпадение.
//
// Параметры:
//   ИмяTool            - Строка - имя tool из пресета, не найденное в ar_Инструменты.
//   ИзвестныеNamespace - Соответствие - результат ar_ИнструментыПакеты.ВсеИзвестныеNamespace()
//                        (Namespace -> Активен).
//
// Возвращаемое значение:
//   Строка - "package_not_installed:<ns>", если имя относится к известному,
//   но неактивному namespace; "" - если совпадений нет (обычный "tool не
//   найден") либо namespace активен (несостыковка не по вине пакета -
//   диагностика PKG-05 её не покрывает, tool остаётся в общем списке).
//
Функция КодНеустановленногоПакета(Знач ИмяTool, Знач ИзвестныеNamespace)

	ЛучшийNamespace = "";
	ЛучшаяАктивность = Неопределено;

	Для Каждого Элемент Из ИзвестныеNamespace Цикл
		Namespace = Элемент.Ключ;
		Префикс = Namespace + "_";
		Если Лев(ИмяTool, СтрДлина(Префикс)) = Префикс
			И СтрДлина(Namespace) > СтрДлина(ЛучшийNamespace) Тогда
			ЛучшийNamespace = Namespace;
			ЛучшаяАктивность = Элемент.Значение;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ЛучшийNamespace) Тогда
		Возврат "";
	КонецЕсли;

	Если ЛучшаяАктивность = Истина Тогда
		// Namespace активен, но конкретный tool всё равно не найден в ar_Инструменты -
		// это не "пакет не установлен" (диагностика PKG-05 не про этот случай),
		// оставляем обычным tool_not_found.
		Возврат "";
	КонецЕсли;

	Возврат "package_not_installed:" + ЛучшийNamespace;

КонецФункции

// Заполняет ТЧ ar_ПодключённыеSkills, если ТЧ существует в метаданных.
// Защита от ситуации когда META-24 ещё не реализована.
//
// Параметры:
//   НовыйАгент       - СправочникОбъект.ar_Агенты
//   МассивSkillsJSON - Массив или Неопределено
//   Результат        - Структура - накапливает НеНайденныеSkills
//
Процедура ЗаполнитьSkills(НовыйАгент, Знач МассивSkillsJSON, Результат)

	// Проверяем наличие ТЧ (META-24 может быть не реализована)
	Если Метаданные.Справочники.ar_Агенты.ТабличныеЧасти.Найти("ar_ПодключённыеSkills") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(МассивSkillsJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	// Собираем имена skills
	ИменаSkills = Новый Массив;
	Для Каждого ЭлементJSON Из МассивSkillsJSON Цикл
		Если ТипЗнч(ЭлементJSON) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИмяSkill = ПолучитьСтрокуСоответствия(ЭлементJSON, "name");
		Если НЕ ПустаяСтрока(ИмяSkill) Тогда
			ИменаSkills.Добавить(ИмяSkill);
		КонецЕсли;
	КонецЦикла;

	Если ИменаSkills.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Пакетный запрос skills по наименованию
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	с.Ссылка КАК Ссылка,
	|	с.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ar_Навыки КАК с
	|ГДЕ
	|	с.Наименование В (&Имена)
	|	И с.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Имена", ИменаSkills);
	НайденныеSkills = Запрос.Выполнить().Выбрать();

	НайденныеПоИмени = Новый Соответствие;
	Пока НайденныеSkills.Следующий() Цикл
		НайденныеПоИмени.Вставить(НайденныеSkills.Наименование, НайденныеSkills.Ссылка);
	КонецЦикла;

	НовыйАгент.ar_ПодключённыеSkills.Очистить();
	Для Каждого ИмяSkill Из ИменаSkills Цикл
		СсылкаSkill = НайденныеПоИмени.Получить(ИмяSkill);
		Если СсылкаSkill = Неопределено Тогда
			Результат.НеНайденныеSkills.Добавить(ИмяSkill);
			Продолжить;
		КонецЕсли;
		НоваяСтрока = НовыйАгент.ar_ПодключённыеSkills.Добавить();
		НоваяСтрока.ar_Skill   = СсылкаSkill;
		НоваяСтрока.ar_Включен = Истина;
	КонецЦикла;

КонецПроцедуры

// Заполняет ar_ПланироватьРаботу и ar_ШаблонПлана из ключей plan_work и
// plan_template пресета. Ключ отсутствует - реквизит не трогается; неверный
// тип/значение - предупреждение в Результат.Предупреждения. Лимиты шаблона
// (12 пунктов по 150 символов) здесь не проверяются - их применяет рантайм.
//
// Параметры:
//   БлокАгента  - Соответствие - JSON-блок "agent".
//   НовыйАгент  - СправочникОбъект.ar_Агенты
//   Результат   - Структура - накапливает Предупреждения.
//
Процедура ЗаполнитьПланИзПресета(Знач БлокАгента, НовыйАгент, Результат)

	ПланироватьРаботу = БулевоИзПресета(БлокАгента, "plan_work", Результат);
	Если ПланироватьРаботу <> Неопределено Тогда
		НовыйАгент.ar_ПланироватьРаботу = ПланироватьРаботу;
	КонецЕсли;

	ШаблонПлана = ШаблонПланаИзПресета(БлокАгента, Результат);
	Если ШаблонПлана <> Неопределено Тогда
		НовыйАгент.ar_ШаблонПлана = ШаблонПлана;
	КонецЕсли;

КонецПроцедуры

// Заполняет ar_ИспользоватьСессии и ar_СрокОтветаЧасов из ключей use_sessions
// и answer_timeout_hours пресета (см. ЗаполнитьПланИзПресета о пропусках).
//
// Параметры:
//   БлокАгента  - Соответствие - JSON-блок "agent".
//   НовыйАгент  - СправочникОбъект.ar_Агенты
//   Результат   - Структура - накапливает Предупреждения.
//
Процедура ЗаполнитьСессииИзПресета(Знач БлокАгента, НовыйАгент, Результат)

	ИспользоватьСессии = БулевоИзПресета(БлокАгента, "use_sessions", Результат);
	Если ИспользоватьСессии <> Неопределено Тогда
		НовыйАгент.ar_ИспользоватьСессии = ИспользоватьСессии;
	КонецЕсли;

	СрокОтветаЧасов = ЦелоеЧислоИзПресета(БлокАгента, "answer_timeout_hours", 0, 9999, Результат);
	Если СрокОтветаЧасов <> Неопределено Тогда
		НовыйАгент.ar_СрокОтветаЧасов = СрокОтветаЧасов;
	КонецЕсли;

КонецПроцедуры

// Заполняет реквизиты очереди пакета (agentrunner-32) из ключей
// queue_from_package, queue_package и max_parallel_runs пресета. Наличие
// пакета в реестре не проверяется - пакет может регистрироваться позже
// импорта пресета.
//
// Параметры:
//   БлокАгента  - Соответствие - JSON-блок "agent".
//   НовыйАгент  - СправочникОбъект.ar_Агенты
//   Результат   - Структура - накапливает Предупреждения.
//
Процедура ЗаполнитьОчередьИзПресета(Знач БлокАгента, НовыйАгент, Результат)

	БратьИзОчереди = БулевоИзПресета(БлокАгента, "queue_from_package", Результат);
	Если БратьИзОчереди <> Неопределено Тогда
		НовыйАгент.ar_БратьИзОчередиПакета = БратьИзОчереди;
	КонецЕсли;

	ПакетИсточник = СтрокаИзПресета(БлокАгента, "queue_package", 100, Результат);
	Если ПакетИсточник <> Неопределено Тогда
		НовыйАгент.ar_ПакетИсточник = СокрЛП(ПакетИсточник);
	КонецЕсли;

	МаксПараллельных = ЦелоеЧислоИзПресета(БлокАгента, "max_parallel_runs", 1, 999, Результат);
	Если МаксПараллельных <> Неопределено Тогда
		НовыйАгент.ar_МаксПараллельныхЗапусков = МаксПараллельных;
	КонецЕсли;

КонецПроцедуры

// Создает активную рутину cron агента из корректного ключа schedule_cron
// пресета. Вызывается после записи агента в транзакции импорта; ошибка записи
// рутины откатывает весь импорт. ar_Агенты.ar_РасписаниеCron (устаревшее
// поле, миграция ar_МиграцииРутины переносит его в рутины) не заполняется.
// У неактивного агента (импорт создает агентов неактивными) рутина не
// срабатывает - расписание начнет работать после включения агента.
//
// Параметры:
//   СсылкаАгент - СправочникСсылка.ar_Агенты - записанный агент.
//   БлокАгента  - Соответствие - JSON-блок "agent".
//   Результат   - Структура - накапливает Предупреждения.
//
Процедура СоздатьРутинуРасписания(Знач СсылкаАгент, Знач БлокАгента, Результат)

	КлючРасписания = "schedule_cron";
	ЗначениеJSON = БлокАгента.Получить(КлючРасписания);
	Если ЗначениеJSON = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ЗначениеJSON) <> Тип("Строка") Тогда
		ЗафиксироватьПредупреждение(Результат, КлючРасписания, ЗначениеJSON,
			НСтр("ru = 'ожидалась строка с выражением cron'; en = 'expected a string with a cron expression'"));
		Возврат;
	КонецЕсли;
	ВыражениеCron = СокрЛП(ЗначениеJSON);
	Если ПустаяСтрока(ВыражениеCron) Тогда
		Возврат;
	КонецЕсли;

	Разбор = ar_Расписание.РазобратьВыражение(ВыражениеCron);
	Если НЕ Разбор.ОК Тогда
		ЗафиксироватьПредупреждение(Результат, КлючРасписания, ВыражениеCron, Разбор.Ошибка);
		Возврат;
	КонецЕсли;

	Рутина = Справочники.ar_Рутины.СоздатьЭлемент();
	Рутина.ar_Имя = "Расписание из пресета";
	Рутина.ar_Агент = СсылкаАгент;
	Рутина.ar_ТипТриггера = "cron";
	Рутина.ar_ПараметрыJSON = ВыражениеРасписанияJSON(ВыражениеCron);
	Рутина.ar_ИнструкцияПереопределение = "";
	Рутина.ar_Активна = Истина;
	Рутина.Записать();

КонецПроцедуры

// Формирует ar_ПараметрыJSON рутины: {"expression": "<cron>"} - тем же
// способом, что ar_МиграцииРутины.СформироватьПараметрыJSON (платформенный
// ЗаписатьJSON, корректное экранирование).
//
// Параметры:
//   ВыражениеCron - Строка - проверенное выражение cron.
//
// Возвращаемое значение:
//   Строка - JSON параметров рутины.
//
Функция ВыражениеРасписанияJSON(Знач ВыражениеCron)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Новый Структура("expression", ВыражениеCron));
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Извлекает булево из пресета по ключу. Ключ отсутствует - Неопределено
// (реквизит не трогается); неверный тип - предупреждение и Неопределено.
//
// Параметры:
//   БлокАгента - Соответствие - JSON-блок "agent".
//   Ключ       - Строка - имя ключа пресета.
//   Результат  - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Булево, Неопределено
//
Функция БулевоИзПресета(Знач БлокАгента, Знач Ключ, Результат)

	ЗначениеJSON = БлокАгента.Получить(Ключ);
	Если ЗначениеJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЗначениеJSON) = Тип("Булево") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	ЗафиксироватьПредупреждение(Результат, Ключ, ЗначениеJSON,
		НСтр("ru = 'ожидалось булево (true/false)'; en = 'expected a boolean (true/false)'"));
	Возврат Неопределено;

КонецФункции

// Извлекает строку из пресета по ключу с контролем длины. Ключ отсутствует -
// Неопределено (реквизит не трогается); пустая строка - "" (явно очищает
// реквизит); неверный тип или длина - предупреждение и Неопределено.
//
// Параметры:
//   БлокАгента - Соответствие - JSON-блок "agent".
//   Ключ       - Строка - имя ключа пресета.
//   МаксДлина  - Число - допустимая длина строки (квалификатор реквизита).
//   Результат  - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Строка, Неопределено
//
Функция СтрокаИзПресета(Знач БлокАгента, Знач Ключ, Знач МаксДлина, Результат)

	ЗначениеJSON = БлокАгента.Получить(Ключ);
	Если ЗначениеJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоДопустимаяСтрока = ТипЗнч(ЗначениеJSON) = Тип("Строка")
		И СтрДлина(СокрЛП(ЗначениеJSON)) <= МаксДлина;
	Если ЭтоДопустимаяСтрока Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	ТекстПричины = СтрШаблон(
		НСтр("ru = 'ожидалась строка до %1 символов'; en = 'expected a string of up to %1 characters'"),
		МаксДлина);
	ЗафиксироватьПредупреждение(Результат, Ключ, ЗначениеJSON, ТекстПричины);
	Возврат Неопределено;

КонецФункции

// Извлекает целое число из пресета по ключу с проверкой диапазона. Ключ
// отсутствует - Неопределено; не число, дробное или вне диапазона -
// предупреждение и Неопределено.
//
// Параметры:
//   БлокАгента - Соответствие - JSON-блок "agent".
//   Ключ       - Строка - имя ключа пресета.
//   Минимум    - Число - нижняя граница включительно.
//   Максимум   - Число - верхняя граница включительно.
//   Результат  - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Число, Неопределено
//
Функция ЦелоеЧислоИзПресета(Знач БлокАгента, Знач Ключ, Знач Минимум, Знач Максимум, Результат)

	ЗначениеJSON = БлокАгента.Получить(Ключ);
	Если ЗначениеJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоЦелоеВДиапазоне = ТипЗнч(ЗначениеJSON) = Тип("Число")
		И ЗначениеJSON = Цел(ЗначениеJSON)
		И ЗначениеJSON >= Минимум
		И ЗначениеJSON <= Максимум;
	Если ЭтоЦелоеВДиапазоне Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	ТекстПричины = СтрШаблон(
		НСтр("ru = 'ожидалось целое число от %1 до %2'; en = 'expected an integer from %1 to %2'"),
		Минимум, Максимум);
	ЗафиксироватьПредупреждение(Результат, Ключ, ЗначениеJSON, ТекстПричины);
	Возврат Неопределено;

КонецФункции

// Извлекает шаблон плана из ключа plan_template пресета (agentrunner-48,
// п. 1.9). Формат - один из:
//   * строка            - берется как есть (как раньше);
//   * массив строк      - строка формата "Заголовок | инструменты | инструкция"
//     или просто "Заголовок" (необязательный шаг); разбор - общая
//     ar_ПланЗапуска.РазобратьСтрокуШаблона;
//   * массив объектов шага - {title, close_tools, instruction}: title обязателен
//     (до 150 символов, длиннее - обрезка с предупреждением), close_tools -
//     необязательный массив непустых строк (непустой делает шаг обязательным),
//     instruction - необязательная строка до 500 (длиннее - обрезка с
//     предупреждением); прочие ключи - предупреждение.
// Каждый элемент приводится к строке шаблона (без пустых хвостов), строки
// соединяются переводом строки. Ошибочный элемент (не строка и не объект,
// объект без title, close_tools не массив строк) - предупреждение с номером,
// пропускается только этот элемент (остальные шаги импортируются). Символ "|"
// и переводы строк внутри полей заменяются ("/" и пробел) с предупреждением.
// Инструмент из close_tools, отсутствующий в tools пресета или выключенный -
// предупреждение, шаг импортируется как есть; plan_work = false при шагах с
// close_tools - предупреждение; больше 12 шагов - предупреждение (обрезку при
// посеве применит ядро). Ключ отсутствует - Неопределено (реквизит не
// трогается); неверный тип - предупреждение и Неопределено.
//
// Параметры:
//   БлокАгента - Соответствие - JSON-блок "agent".
//   Результат  - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Строка, Неопределено
//
Функция ШаблонПланаИзПресета(Знач БлокАгента, Результат)

	КлючШаблона = "plan_template";
	ЗначениеJSON = БлокАгента.Получить(КлючШаблона);
	Если ЗначениеJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЗначениеJSON) = Тип("Строка") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;

	Если ТипЗнч(ЗначениеJSON) <> Тип("Массив") Тогда
		ЗафиксироватьПредупреждение(Результат, КлючШаблона, ЗначениеJSON,
			НСтр("ru = 'ожидался массив шагов (строки или объекты) или строка';
				|en = 'expected an array of steps (strings or objects) or a string'"));
		Возврат Неопределено;
	КонецЕсли;

	// plan_work = false при шагах с close_tools - условия закрытия действуют
	// только при включённом планировании (спека п. 1.9).
	ПланРаботы = БлокАгента.Получить("plan_work");
	ПланРаботыВключён = ?(ТипЗнч(ПланРаботы) = Тип("Булево"), ПланРаботы, Истина);

	// Имена tools пресета с признаком enabled - для предупреждения о
	// недоступном закрывающем инструменте (спека п. 1.9).
	ДоступныеИменаTools = Новый Соответствие;
	МассивTools = БлокАгента.Получить("tools");
	Если ТипЗнч(МассивTools) = Тип("Массив") Тогда
		Для Каждого ЭлементTool Из МассивTools Цикл
			Если ТипЗнч(ЭлементTool) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			ИмяTool = ПолучитьСтрокуСоответствия(ЭлементTool, "name");
			Если Не ПустаяСтрока(ИмяTool) Тогда
				ДоступныеИменаTools.Вставить(ИмяTool, (ЭлементTool.Получить("enabled") = Истина));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СтрокиШаблона = Новый Массив;
	ЕстьШагиСТулами = Ложь;
	НомерШага = 0;

	Для Каждого ЭлементJSON Из ЗначениеJSON Цикл

		Разбор = Неопределено;

		Если ТипЗнч(ЭлементJSON) = Тип("Строка") Тогда
			// Строка формата п. 1.1 - разбирается так же, как строка шаблона
			// в карточке агента.
			Разбор = ar_ПланЗапуска.РазобратьСтрокуШаблона(ЭлементJSON);
		ИначеЕсли ТипЗнч(ЭлементJSON) = Тип("Соответствие") Тогда
			Разбор = ОбъектШагаИзПресета(ЭлементJSON, НомерШага + 1, Результат);
			Если Разбор = Неопределено Тогда
				// Ошибочный элемент - предупреждение уже зафиксировано,
				// пропускается только этот элемент.
				Продолжить;
			КонецЕсли;
		Иначе
			ЗафиксироватьПредупреждение(Результат, КлючШаблона, ЭлементJSON, СтрШаблон(
				НСтр("ru = 'элемент %1 пропущен: ожидалась строка или объект шага';
					|en = 'item %1 skipped: expected a string or a step object'"),
				Строка(НомерШага + 1)));
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Разбор.Заголовок) Тогда
			Продолжить; // Пустые строки шаблона пропускаются, как и раньше.
		КонецЕсли;

		НомерШага = НомерШага + 1;

		Если Разбор.ЗакрывающиеИнструменты.Количество() > 0 Тогда
			ЕстьШагиСТулами = Истина;
			ПредупредитьОНедоступныхИнструментах(Разбор.ЗакрывающиеИнструменты,
				ДоступныеИменаTools, НомерШага, Результат);
		КонецЕсли;

		СтрокиШаблона.Добавить(СтрокаШаблонаПункта(Разбор.Заголовок,
			Разбор.ЗакрывающиеИнструменты, Разбор.Инструкция));

	КонецЦикла;

	Если СтрокиШаблона.Количество() > 12 Тогда
		ЗафиксироватьПредупреждение(Результат, КлючШаблона, СтрокиШаблона.Количество(),
			НСтр("ru = 'шагов больше 12 - при старте запуска ядро обрежет список до 12';
				|en = 'more than 12 steps - the core will cut the list to 12 at run start'"));
	КонецЕсли;

	Если ЕстьШагиСТулами И ПланРаботыВключён <> Истина Тогда
		ЗафиксироватьПредупреждение(Результат, "plan_work", ПланРаботыВключён,
			НСтр("ru = 'в шаблоне есть шаги с условиями закрытия, но plan_work = false -
				|условия закрытия действуют только при включённом планировании';
				|en = 'the template has steps with close conditions, but plan_work = false -
				|close conditions apply only when planning is enabled'"));
	КонецЕсли;

	Возврат СтрСоединить(СтрокиШаблона, Символы.ПС);

КонецФункции

// Объект шага пресета в пункт шаблона (agentrunner-48, п. 1.9). title обязателен
// (не строка/пустой - ошибка элемента, Неопределено); close_tools - массив
// непустых строк (иначе элемент ошибочен); instruction - строка до 500;
// прочие ключи - предупреждение. Символ "|" и переводы строк внутри полей
// заменяются ("/" и пробел) с предупреждением.
//
// Параметры:
//   ЭлементJSON - Соответствие - элемент массива plan_template.
//   НомерШага   - Число - предполагаемый номер шага (для текстов предупреждений).
//   Результат   - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Структура - поля РазобратьСтрокуШаблона (Заголовок, Обязательный,
//   ЗакрывающиеИнструменты, Инструкция); Неопределено - элемент ошибочен.
//
Функция ОбъектШагаИзПресета(Знач ЭлементJSON, Знач НомерШага, Результат)

	Заголовок = ЗаголовокШагаИзПресета(ЭлементJSON, НомерШага, Результат);
	Если Заголовок = Неопределено Тогда
		Возврат Неопределено; // Ошибка элемента - предупреждение уже зафиксировано.
	КонецЕсли;

	Инструменты = ИнструментыШагаИзПресета(ЭлементJSON, НомерШага, Результат);
	Если Инструменты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Инструкция = ИнструкцияШагаИзПресета(ЭлементJSON, НомерШага, Результат);

	ПредупредитьОНезнакомыхКлючахШага(ЭлементJSON, НомерШага, Результат);

	// "|" и переводы строк сломали бы строку шаблона - замена с предупреждением.
	Заголовок = ОчиститьПолеШага(Заголовок, "title", НомерШага, Результат);
	Инструкция = ОчиститьПолеШага(Инструкция, "instruction", НомерШага, Результат);
	ОчищенныеИнструменты = Новый Массив;
	Для Каждого ИмяTool Из Инструменты Цикл
		ОчищенныеИнструменты.Добавить(ОчиститьПолеШага(ИмяTool, "close_tools", НомерШага, Результат));
	КонецЦикла;

	Возврат Новый Структура("Заголовок, Обязательный, ЗакрывающиеИнструменты, Инструкция",
		Заголовок, (ОчищенныеИнструменты.Количество() > 0), ОчищенныеИнструменты, Инструкция);

КонецФункции

// Заголовок шага пресета (title): обязателен, непустая строка до 150 символов
// (длиннее - обрезка с предупреждением). Неопределено - элемент ошибочен.
//
// Параметры:
//   ЭлементJSON - Соответствие - элемент массива plan_template.
//   НомерШага   - Число - предполагаемый номер шага (для текстов предупреждений).
//   Результат   - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Строка, Неопределено.
//
Функция ЗаголовокШагаИзПресета(Знач ЭлементJSON, Знач НомерШага, Результат)

	Заголовок = ЭлементJSON.Получить("title");
	Если ТипЗнч(Заголовок) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Заголовок)) Тогда
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЭлементJSON, СтрШаблон(
			НСтр("ru = 'элемент %1 пропущен: не задан непустой title шага';
				|en = 'item %1 skipped: the step title is empty or missing'"),
			Строка(НомерШага)));
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = СокрЛП(Заголовок);
	Если СтрДлина(Заголовок) > 150 Тогда
		Заголовок = Лев(Заголовок, 150);
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЭлементJSON, СтрШаблон(
			НСтр("ru = 'шаг %1: title длиннее 150 символов - обрезан';
				|en = 'step %1: title is longer than 150 characters - truncated'"),
			Строка(НомерШага)));
	КонецЕсли;

	Возврат Заголовок;

КонецФункции

// Закрывающие инструменты шага пресета (close_tools): необязательный массив
// непустых строк (пустые отбрасываются); не массив или массив с не-строками -
// элемент ошибочен (Неопределено).
//
// Возвращаемое значение:
//   Массив из Строка, Неопределено.
//
Функция ИнструментыШагаИзПресета(Знач ЭлементJSON, Знач НомерШага, Результат)

	Инструменты = Новый Массив;

	Если ЭлементJSON.Получить("close_tools") = Неопределено Тогда
		Возврат Инструменты;
	КонецЕсли;

	ЗначениеИнструментов = ЭлементJSON.Получить("close_tools");
	Если ТипЗнч(ЗначениеИнструментов) <> Тип("Массив") Тогда
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЭлементJSON, СтрШаблон(
			НСтр("ru = 'элемент %1 пропущен: close_tools должен быть массивом строк';
				|en = 'item %1 skipped: close_tools must be an array of strings'"),
			Строка(НомерШага)));
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ИмяTool Из ЗначениеИнструментов Цикл
		Если ТипЗнч(ИмяTool) <> Тип("Строка") Тогда
			ЗафиксироватьПредупреждение(Результат, "plan_template", ЭлементJSON, СтрШаблон(
				НСтр("ru = 'элемент %1 пропущен: close_tools должен быть массивом строк';
					|en = 'item %1 skipped: close_tools must be an array of strings'"),
				Строка(НомерШага)));
			Возврат Неопределено;
		КонецЕсли;
		ИмяTool = СокрЛП(ИмяTool);
		Если Не ПустаяСтрока(ИмяTool) Тогда
			Инструменты.Добавить(ИмяTool);
		КонецЕсли;
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

// Инструкция шага пресета (instruction): необязательная строка до 500 символов
// (длиннее - обрезка с предупреждением); не строка - предупреждение, поле не
// применяется (шаг импортируется).
//
// Возвращаемое значение:
//   Строка.
//
Функция ИнструкцияШагаИзПресета(Знач ЭлементJSON, Знач НомерШага, Результат)

	Если ЭлементJSON.Получить("instruction") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ЗначениеИнструкции = ЭлементJSON.Получить("instruction");
	Если ТипЗнч(ЗначениеИнструкции) <> Тип("Строка") Тогда
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЗначениеИнструкции, СтрШаблон(
			НСтр("ru = 'шаг %1: instruction проигнорирована - ожидалась строка';
				|en = 'step %1: instruction ignored - expected a string'"),
			Строка(НомерШага)));
		Возврат "";
	КонецЕсли;

	Инструкция = СокрЛП(ЗначениеИнструкции);
	Если СтрДлина(Инструкция) > 500 Тогда
		Инструкция = Лев(Инструкция, 500);
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЭлементJSON, СтрШаблон(
			НСтр("ru = 'шаг %1: instruction длиннее 500 символов - обрезана';
				|en = 'step %1: instruction is longer than 500 characters - truncated'"),
			Строка(НомерШага)));
	КонецЕсли;

	Возврат Инструкция;

КонецФункции

// Предупреждение о ключах объекта шага вне title/close_tools/instruction
// (спека п. 1.9: прочие ключи игнорируются с предупреждением).
Процедура ПредупредитьОНезнакомыхКлючахШага(Знач ЭлементJSON, Знач НомерШага, Результат)

	ИзвестныеКлючи = Новый Соответствие;
	ИзвестныеКлючи.Вставить("title", Истина);
	ИзвестныеКлючи.Вставить("close_tools", Истина);
	ИзвестныеКлючи.Вставить("instruction", Истина);

	Для Каждого КлючЗначение Из ЭлементJSON Цикл
		Если ИзвестныеКлючи.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			ЗафиксироватьПредупреждение(Результат, "plan_template", КлючЗначение.Значение, СтрШаблон(
				НСтр("ru = 'шаг %1: ключ ""%2"" проигнорирован - допустимы title, close_tools, instruction';
					|en = 'step %1: key ""%2"" ignored - only title, close_tools, instruction are allowed'"),
				Строка(НомерШага), КлючЗначение.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заменяет в поле шага символы, недопустимые в строке шаблона: "|" -> "/",
// переводы строк -> пробел (спека п. 1.9). Замена молча возвращает новое
// значение, предупреждение фиксируется только когда были замены.
//
// Параметры:
//   ЗначениеПоля - Строка - исходное значение поля.
//   ИмяПоля      - Строка - имя поля (title/close_tools/instruction) для текста.
//   НомерШага    - Число - номер шага (для текста предупреждения).
//   Результат    - Структура - накапливает Предупреждения.
//
// Возвращаемое значение:
//   Строка - очищенное значение.
//
Функция ОчиститьПолеШага(Знач ЗначениеПоля, Знач ИмяПоля, Знач НомерШага, Результат)

	Очищенное = ЗначениеПоля;
	БылоЗаменил = Ложь;

	Если СтрНайти(Очищенное, "|") > 0 Тогда
		Очищенное = СтрЗаменить(Очищенное, "|", "/");
		БылоЗаменил = Истина;
	КонецЕсли;

	Если СтрНайти(Очищенное, Символы.ПС) > 0 Или СтрНайти(Очищенное, Символы.ВК) > 0 Тогда
		Очищенное = СтрЗаменить(Очищенное, Символы.ПС, " ");
		Очищенное = СтрЗаменить(Очищенное, Символы.ВК, " ");
		БылоЗаменил = Истина;
	КонецЕсли;

	Если БылоЗаменил Тогда
		ЗафиксироватьПредупреждение(Результат, "plan_template", ЗначениеПоля, СтрШаблон(
			НСтр("ru = 'шаг %1: в поле ""%2"" символы ""|"" и переводы строк заменены
				|(они сломали бы строку шаблона)';
				|en = 'step %1: in field ""%2"" the ""|"" characters and line breaks were replaced
				|(they would break the template line)'"),
			Строка(НомерШага), ИмяПоля));
	КонецЕсли;

	Возврат Очищенное;

КонецФункции

// Предупреждение о закрывающих инструментах шага, которых нет в tools пресета
// или которые там выключены (спека п. 1.9): шаг импортируется как есть, но
// закрыть его вызовом нельзя будет.
//
// Параметры:
//   ЗакрывающиеИнструменты - Массив - имена инструментов шага.
//   ДоступныеИменаTools    - Соответствие - имя tool из tools пресета -> enabled.
//   НомерШага              - Число - номер шага (для текста предупреждения).
//   Результат              - Структура - накапливает Предупреждения.
//
Процедура ПредупредитьОНедоступныхИнструментах(Знач ЗакрывающиеИнструменты,
	Знач ДоступныеИменаTools, Знач НомерШага, Результат)

	Для Каждого ИмяTool Из ЗакрывающиеИнструменты Цикл

		Признак = ДоступныеИменаTools.Получить(ИмяTool);
		Если Признак = Неопределено Тогда
			Причина = НСтр("ru = 'инструмента нет в tools пресета';
				|en = 'the tool is not in the preset tools list'");
		ИначеЕсли Признак <> Истина Тогда
			Причина = НСтр("ru = 'инструмент выключен в tools пресета (enabled = false)';
				|en = 'the tool is disabled in the preset tools list (enabled = false)'");
		Иначе
			Продолжить;
		КонецЕсли;

		ЗафиксироватьПредупреждение(Результат, "plan_template", ИмяTool, СтрШаблон(
			НСтр("ru = 'шаг %1: инструмент %2 недоступен агенту (%3) - шаг нельзя будет закрыть вызовом';
				|en = 'step %1: tool %2 is unavailable to the agent (%3) - the step cannot be closed by calling it'"),
			Строка(НомерШага), ИмяTool, Причина));

	КонецЦикла;

КонецПроцедуры

// Строка шаблона одного пункта без пустых хвостов (спека п. 1.9): нет
// инструкции - "Заголовок | инструменты"; нет инструментов, есть инструкция -
// "Заголовок |  | инструкция"; нет обоих - "Заголовок".
//
// Параметры:
//   Заголовок   - Строка - заголовок пункта.
//   Инструменты - Массив - имена закрывающих инструментов.
//   Инструкция  - Строка - инструкция шага.
//
// Возвращаемое значение:
//   Строка.
//
Функция СтрокаШаблонаПункта(Знач Заголовок, Знач Инструменты, Знач Инструкция)

	Если Инструменты.Количество() = 0 И ПустаяСтрока(Инструкция) Тогда
		Возврат Заголовок;
	КонецЕсли;

	СтрокаИнструментов = СтрСоединить(Инструменты, ", ");

	Если ПустаяСтрока(Инструкция) Тогда
		Возврат Заголовок + " | " + СтрокаИнструментов;
	КонецЕсли;

	Если Инструменты.Количество() = 0 Тогда
		Возврат Заголовок + " |  | " + Инструкция;
	КонецЕсли;

	Возврат Заголовок + " | " + СтрокаИнструментов + " | " + Инструкция;

КонецФункции

// Добавляет предупреждение импорта: ключ пресета, его значение из JSON и
// причина, по которой ключ не применен. Текст уже локализован - выводится
// как есть (ar_БиблиотекаПресетов.ОбработатьРезультатИмпорта).
//
// Параметры:
//   Результат    - Структура - накапливает Предупреждения.
//   Ключ         - Строка - имя ключа пресета.
//   ЗначениеJSON - Произвольный - значение ключа из разобранного JSON.
//   Причина      - Строка - причина неприменения.
//
Процедура ЗафиксироватьПредупреждение(Результат, Знач Ключ, Знач ЗначениеJSON, Знач Причина)

	ТекстПредупреждения = СтрШаблон(
		НСтр("ru = 'Пресет: ключ ""%1"" (%2) проигнорирован: %3.';
		     |en = 'Preset: key ""%1"" (%2) ignored: %3.'"),
		Ключ, ПредставлениеЗначенияJSON(ЗначениеJSON), Причина);
	Результат.Предупреждения.Добавить(ТекстПредупреждения);

КонецПроцедуры

// Представление значения из JSON для текста предупреждения: строка - как есть
// (с обрезкой), булево - в виде JSON-литерала, остальное - представление типа.
//
// Параметры:
//   ЗначениеJSON - Произвольный - значение ключа из разобранного JSON.
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеЗначенияJSON(Знач ЗначениеJSON)

	МаксДлинаПредставления = 50;

	Если ТипЗнч(ЗначениеJSON) = Тип("Строка") Тогда
		Возврат ar_Утилиты.ОбрезатьДо(СокрЛП(ЗначениеJSON), МаксДлинаПредставления);
	КонецЕсли;

	Если ТипЗнч(ЗначениеJSON) = Тип("Булево") Тогда
		Возврат ?(ЗначениеJSON, "true", "false");
	КонецЕсли;

	Возврат ar_Утилиты.ОбрезатьДо(Строка(ЗначениеJSON), МаксДлинаПредставления);

КонецФункции

// Ищет LLM-провайдера по имени (нормализованное сравнение без учёта регистра).
//
// Параметры:
//   ИмяПровайдера - Строка
//
// Возвращаемое значение:
//   СправочникСсылка.ar_LLMПровайдеры или Неопределено.
//
Функция НайтиПровайдераПоИмени(Знач ИмяПровайдера)

	// Сравнение строк в языке запросов регистронезависимо по умолчанию (в
	// отличие от BSL-кода) - отдельная функция приведения регистра не нужна.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	п.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ar_LLMПровайдеры КАК п
	|ГДЕ
	|	п.ПометкаУдаления = ЛОЖЬ
	|	И п.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Наименование", ИмяПровайдера);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Формирует имя агента с суффиксом даты если агент с таким именем уже есть.
//
// Параметры:
//   ИсходноеИмя - Строка - желаемое наименование
//
// Возвращаемое значение:
//   Строка - итоговое наименование.
//
Функция ИмяСуффиксПриДубликате(Знач ИсходноеИмя)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	а.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ar_Агенты КАК а
	|ГДЕ
	|	а.Наименование = &Наименование
	|	И а.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Наименование", ИсходноеИмя);

	Если Запрос.Выполнить().Пустой() Тогда
		Возврат ИсходноеИмя;
	КонецЕсли;

	// Добавляем суффикс с датой
	СуффиксДаты = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	Возврат ИсходноеИмя
		+ НСтр("ru = ' (из пресета '; en = ' (from preset '")
		+ СуффиксДаты + ")";

КонецФункции

// Имя LLM-провайдера для ключа llm_provider_name пресета; "" если провайдер
// не назначен. Имя, а не ссылка: пресет портируем.
//
// Параметры:
//   СсылкаПровайдера - СправочникСсылка.ar_LLMПровайдеры
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяПровайдераАгента(Знач СсылкаПровайдера)

	Если НЕ ЗначениеЗаполнено(СсылкаПровайдера) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаПровайдера, "Наименование"));

КонецФункции

// Имя значения перечисления ar_РежимАвтономии для ключа autonomy_mode пресета
// (имя из метаданных - ровно то, что ждет импорт: Найти по имени и индексация
// Перечисления.X[Имя]); "" если режим не назначен.
//
// Параметры:
//   РежимАвтономии - ПеречислениеСсылка.ar_РежимАвтономии
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяРежимаАвтономии(Знач РежимАвтономии)

	Если НЕ ЗначениеЗаполнено(РежимАвтономии) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(РежимАвтономии);

КонецФункции

// Массив tools пресета из ТЧ ar_ДоступныеИнструменты: [{"name", "enabled"}].
// Строки ТЧ уже в памяти (ОбъектАгента получен ПолучитьОбъект), обращений к
// базе в цикле нет.
//
// Параметры:
//   ОбъектАгента - СправочникОбъект.ar_Агенты
//
// Возвращаемое значение:
//   Массив из Структура ("name", "enabled")
//
Функция ИнструментыПресета(Знач ОбъектАгента)

	МассивИнструментов = Новый Массив;
	Для Каждого СтрокаИнструмента Из ОбъектАгента.ar_ДоступныеИнструменты Цикл
		Если ПустаяСтрока(СтрокаИнструмента.ar_Инструмент) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("name", СтрокаИнструмента.ar_Инструмент);
		Элемент.Вставить("enabled", СтрокаИнструмента.ar_Включен);
		МассивИнструментов.Добавить(Элемент);
	КонецЦикла;

	Возврат МассивИнструментов;

КонецФункции

// Массив skills пресета из ТЧ ar_ПодключённыеSkills: [{"name"}]. Имена
// навыков (наименования ar_Навыки - по ним ищет импорт) читаются одним
// запросом через БСП, без обращений к базе в цикле.
//
// Параметры:
//   ОбъектАгента - СправочникОбъект.ar_Агенты
//
// Возвращаемое значение:
//   Массив из Структура - элементы с ключом "name" (наименование навыка)
//
Функция НавыкиПресета(Знач ОбъектАгента)

	МассивНавыков = Новый Массив;
	СсылкиНавыков = Новый Массив;
	Для Каждого СтрокаНавыка Из ОбъектАгента.ar_ПодключённыеSkills Цикл
		Если ЗначениеЗаполнено(СтрокаНавыка.ar_Skill) Тогда
			СсылкиНавыков.Добавить(СтрокаНавыка.ar_Skill);
		КонецЕсли;
	КонецЦикла;

	Если СсылкиНавыков.Количество() = 0 Тогда
		Возврат МассивНавыков;
	КонецЕсли;

	ИменаНавыков = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СсылкиНавыков, "Наименование");
	Для Каждого СсылкаНавыка Из СсылкиНавыков Цикл
		ИмяНавыка = ИменаНавыков.Получить(СсылкаНавыка);
		Если НЕ ПустаяСтрока(ИмяНавыка) Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("name", ИмяНавыка);
			МассивНавыков.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат МассивНавыков;

КонецФункции

// Пункты шаблона плана для ключа plan_template пресета (agentrunner-48, п. 1.9).
// Шаг без инструментов и инструкции - строка "Заголовок"; иначе - объект
// {title, close_tools, instruction} (пустые ключи не выводятся). Разбор строки
// шаблона - та же ar_ПланЗапуска.РазобратьСтрокуШаблона, что в ядре и импорте
// (round-trip: повторный импорт экспортированного пресета даёт тот же
// ar_ШаблонПлана).
//
// Параметры:
//   ШаблонПлана - Строка - реквизит ar_ШаблонПлана (пункт на строку).
//
// Возвращаемое значение:
//   Массив из Строка/Структура
//
Функция ПунктыШаблонаПлана(Знач ШаблонПлана)

	Пункты = Новый Массив;
	Для Каждого СтрокаПункта Из СтрРазделить(ШаблонПлана, Символы.ПС, Ложь) Цикл

		Разбор = ar_ПланЗапуска.РазобратьСтрокуШаблона(СтрокаПункта);
		Если ПустаяСтрока(Разбор.Заголовок) Тогда
			Продолжить;
		КонецЕсли;

		Если Разбор.ЗакрывающиеИнструменты.Количество() = 0
			И ПустаяСтрока(Разбор.Инструкция) Тогда
			Пункты.Добавить(Разбор.Заголовок);
			Продолжить;
		КонецЕсли;

		ОбъектШага = Новый Структура;
		ОбъектШага.Вставить("title", Разбор.Заголовок);
		Если Разбор.ЗакрывающиеИнструменты.Количество() > 0 Тогда
			ОбъектШага.Вставить("close_tools", Разбор.ЗакрывающиеИнструменты);
		КонецЕсли;
		Если Не ПустаяСтрока(Разбор.Инструкция) Тогда
			ОбъектШага.Вставить("instruction", Разбор.Инструкция);
		КонецЕсли;
		Пункты.Добавить(ОбъектШага);

	КонецЦикла;

	Возврат Пункты;

КонецФункции

// Выражение cron для ключа schedule_cron пресета: выражение первой активной
// cron-рутины агента (по ar_Имя), иначе непустое ar_РасписаниеCron (legacy),
// иначе "". Рутина важнее legacy-поля: миграция ar_МиграцииРутины очищает
// поле после переноса.
//
// Параметры:
//   СсылкаАгент          - СправочникСсылка.ar_Агенты
//   РасписаниеCronLegacy - Строка - реквизит ar_РасписаниеCron агента.
//
// Возвращаемое значение:
//   Строка
//
Функция ВыражениеРасписанияАгента(Знач СсылкаАгент, Знач РасписаниеCronLegacy)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Рутины.ar_ПараметрыJSON КАК ПараметрыJSON
	|ИЗ
	|	Справочник.ar_Рутины КАК Рутины
	|ГДЕ
	|	Рутины.ar_Агент = &Агент
	|	И Рутины.ar_ТипТриггера = ""cron""
	|	И Рутины.ar_Активна
	|	И НЕ Рутины.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Рутины.ar_Имя";
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Выражение = ВыражениеИзПараметровРутины(Выборка.ПараметрыJSON);
		Если НЕ ПустаяСтрока(Выражение) Тогда
			Возврат Выражение;
		КонецЕсли;
	КонецЕсли;

	Возврат СокрЛП(РасписаниеCronLegacy);

КонецФункции

// Выражение cron из JSON-параметров рутины ({"expression": "..."});
// "" если JSON не разобрался или expression в нем не строка.
//
// Параметры:
//   ПараметрыJSON - Строка - реквизит ar_ПараметрыJSON рутины.
//
// Возвращаемое значение:
//   Строка
//
Функция ВыражениеИзПараметровРутины(Знач ПараметрыJSON)

	Параметры = ar_JSON.ИзJSON(ПараметрыJSON);
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Выражение = Параметры.Получить("expression");
	ИначеЕсли ТипЗнч(Параметры) = Тип("Структура") Тогда
		Выражение = Неопределено;
		Параметры.Свойство("expression", Выражение);
	Иначе
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Выражение) = Тип("Строка") Тогда
		Возврат СокрЛП(Выражение);
	КонецЕсли;

	Возврат "";

КонецФункции

// Безопасно извлекает строковое значение из Соответствия по ключу.
//
// Параметры:
//   Соответствие - Соответствие - JSON-объект
//   Ключ         - Строка
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьСтрокуСоответствия(Знач Соответствие, Знач Ключ)

	Значение = Соответствие.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

// Безопасно извлекает строковое значение из JSON-соответствия по ключу.
//
// Параметры:
//   БлокJSON - Соответствие
//   Ключ     - Строка
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьСтрокуJSON(Знач БлокJSON, Знач Ключ)

	Если ТипЗнч(БлокJSON) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьСтрокуСоответствия(БлокJSON, Ключ);

КонецФункции

// Безопасно извлекает числовое значение из JSON-соответствия по ключу.
//
// Параметры:
//   БлокJSON - Соответствие
//   Ключ     - Строка
//
// Возвращаемое значение:
//   Число
//
Функция ПолучитьЧислоJSON(Знач БлокJSON, Знач Ключ)

	Если ТипЗнч(БлокJSON) <> Тип("Соответствие") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = БлокJSON.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Безопасно извлекает целочисленное значение из JSON-соответствия по ключу.
//
// Параметры:
//   БлокJSON - Соответствие
//   Ключ     - Строка
//
// Возвращаемое значение:
//   Число (целое)
//
Функция ПолучитьЦелоеЧислоJSON(Знач БлокJSON, Знач Ключ)

	Возврат Цел(ПолучитьЧислоJSON(БлокJSON, Ключ));

КонецФункции

// Записывает ошибку в журнал регистрации.
//
// Параметры:
//   ИнфОбОшибке - ИнформацияОбОшибке
//
Процедура ЗаписатьОшибкуВЖурнал(Знач ИнфОбОшибке)

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'AgentRunner.ИмпортПресета'; en = 'AgentRunner.PresetImport'"),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Справочники.ar_Пресеты,
		,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфОбОшибке));

КонецПроцедуры

#КонецОбласти
