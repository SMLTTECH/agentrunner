////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMMock (AOS LLM Mock).
//
// Детерминированный mock-провайдер ядра AgentRunner для интеграционных и юнит-
// тестов. Возвращает заранее заданные ответы из очереди-сценария БЕЗ HTTP-
// вызовов, без чтения API-ключа и без обращения к сети. Регистрируется в
// перечислении ar_ТипПровайдера (значение Mock) и вызывается через
// ar_LLMДиспетчер.ВызватьПровайдер так же, как реальные провайдеры — runtime
// не знает, что провайдер ненастоящий.
//
// Контракт функции Чат(Сообщения, Параметры) идентичен другим провайдерам
// (см. ar_LLMКонтракт.НовыйОтвет / ВалидироватьОтвет). Сценарий задаётся
// извне до запуска теста через УстановитьСценарий и хранится в хранилище
// общих настроек; счётчик вызовов доступен через ПолучитьСчётчикВызовов для
// assert-ов.
//
// Сценарии разделяются по провайдерам (agentrunner-29): УстановитьСценарий
// с указанием провайдера (СправочникСсылка.ar_LLMПровайдеры) создает
// персональную очередь и счетчик этого провайдера (ключи настроек - от
// УникальныйИдентификатор() ссылки, длина ключа в пределах ограничения
// хранилища); без провайдера - общий сценарий (прежнее поведение). Чат берет
// очередь провайдера из Параметры.Провайдер, если для него задан персональный
// сценарий, иначе - общий. Модель последнего вызова каждой очереди доступна
// тестам через МодельПоследнегоВызова. Список провайдеров с персональными
// сценариями хранится в настройке ПровайдерыСценариев того же объекта -
// ОчиститьСценарий() без параметра очищает общий и все персональные
// сценарии разом.
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, Client = false, ServerCall = false,
//   Privileged = false, ReturnValuesReuse = DontUse.
//
// Привилегированный режим не используется. HTTP-вызовов, Выполнить()/Вычислить()
// нет. Хранилище сценария — ХранилищеОбщихНастроек (настройки текущего
// пользователя: в общем модуле нет переменных модуля). Состояние переживает
// сеанс, поэтому в teardown теста обязателен вызов ОчиститьСценарий().
//
// См. спеку: .docs/specs/LLM-09.md, Plan §3.12.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имитирует вызов LLM-провайдера: возвращает следующий ответ из очереди
// сценария. Сигнатура идентична ar_LLMOpenAI.Чат и контракту ar_LLMКонтракт.
//
// Параметры:
//   Сообщения  - Массив    - сообщения во внутреннем формате AgentRunner. Содержимое
//                            не влияет на ответ (mock детерминирован сценарием),
//                            но массив должен быть непустым — как у реальных
//                            провайдеров.
//   Параметры  - Структура - параметры запроса. Провайдер (СправочникСсылка.
//                            ar_LLMПровайдеры) выбирает очередь: персональную
//                            очередь этого провайдера, если его сценарий задан
//                            через УстановитьСценарий с провайдером, иначе -
//                            общую. Модель запоминается для тестов
//                            (МодельПоследнегоВызова). Остальное mock
//                            игнорирует (нет HTTP, нет проверки ключа).
//                            Допускается Неопределено.
//
// Возвращаемое значение:
//   Структура - контракт ar_LLMКонтракт.НовыйОтвет():
//     {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}.
//
Функция Чат(Сообщения, Параметры = Неопределено) Экспорт

	Результат = ar_LLMКонтракт.НовыйОтвет();

	// Вход проверяем так же, как реальные провайдеры: пустые сообщения —
	// ошибка БЕЗ расхода элемента сценария и БЕЗ инкремента счётчика.
	Если ТипЗнч(Сообщения) <> Тип("Массив") ИЛИ Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Сообщения не заданы';
		                        |en = 'Messages are not set'");
		Возврат Результат;
	КонецЕсли;

	// Очередь выбирается по провайдеру из параметров: персональная, если
	// его сценарий задан, иначе - общий сценарий (прежнее поведение).
	ПровайдерОчереди = ПровайдерВызова(Параметры);
	ИдентификаторОчереди = ИдентификаторПровайдера(ПровайдерОчереди);
	Очередь = ОчередьСценария(ИдентификаторОчереди);

	// Засчитываем вызов (как реальный поход в LLM состоялся).
	СчётчикВызовов = ПолучитьСчётчикВызовов(ПровайдерОчереди) + 1;
	СохранитьСчётчикВызовов(ИдентификаторОчереди, СчётчикВызовов);
	СохранитьМодельВызова(ИдентификаторОчереди, Параметры);

	Если СчётчикВызовов > Очередь.Количество() Тогда
		Результат.Ошибка = НСтр("ru = 'ar_LLMMock: сценарий исчерпан';
		                        |en = 'ar_LLMMock: scenario is exhausted'");
		Возврат Результат;
	КонецЕсли;

	Элемент = Очередь[СчётчикВызовов - 1];

	Возврат ОтветИзЭлемента(Элемент);

КонецФункции

// Задаёт очередь ответов сценария и сбрасывает счётчик вызовов.
// Вызывается в setup-методе теста (ПередЗапускомТеста).
//
// Формат одного элемента сценария — Структура с ключом ТипОтвета:
//   * "text"      - финальный текстовый ответ:
//                     {ТипОтвета: "text", Содержание: Строка}
//   * "tool_call" - промежуточный вызов инструмента:
//                     {ТипОтвета: "tool_call", ИмяTool: Строка (snake_case),
//                      АргументыJSON: Строка JSON, ToolCallId: Строка,
//                      Содержание: Строка (опционально)}
//   * "error"     - ошибка провайдера (негативный путь):
//                     {ТипОтвета: "error", КодСостояния: Число, Ошибка: Строка}
//
// Параметры:
//   НовыйСценарий - Массив - очередь структур-описаний ответов.
//   Провайдер     - СправочникСсылка.ar_LLMПровайдеры, Неопределено - провайдер
//                   персонального сценария. Без провайдера (или с пустой ссылкой/
//                   не ссылкой) сценарий общий - прежнее поведение; с провайдером
//                   - персональная очередь и счетчик этого провайдера (ключ
//                   настроек - от УникальныйИдентификатор() ссылки), провайдер
//                   регистрируется в списке ПровайдерыСценариев.
//
Процедура УстановитьСценарий(НовыйСценарий, Провайдер = Неопределено) Экспорт

	Если ТипЗнч(НовыйСценарий) = Тип("Массив") Тогда
		МассивОтветов = НовыйСценарий;
	Иначе
		МассивОтветов = Новый Массив;
	КонецЕсли;

	Идентификатор = ИдентификаторПровайдера(Провайдер);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючСценария(Идентификатор), МассивОтветов);
	СохранитьСчётчикВызовов(Идентификатор, 0);
	ЗапомнитьПровайдераСценария(Идентификатор);

КонецПроцедуры

// Сбрасывает сценарий и счетчик вызовов. Вызывается в teardown-методе
// теста (ПослеЗапускаТеста), чтобы состояние модуля не «протекало» между тестами.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - очищает
//               персональный сценарий одного провайдера. Без параметра -
//               общий сценарий и ВСЕ персональные (список ПровайдерыСценариев):
//               тест, упавший посередине, не оставит своих сценариев следующим.
//
Процедура ОчиститьСценарий(Провайдер = Неопределено) Экспорт

	Идентификатор = ИдентификаторПровайдера(Провайдер);

	Если ПустаяСтрока(Идентификатор) Тогда
		СброситьНастройкиОчереди("");
		Для Каждого ИдентификаторПров Из СписокПровайдеровСценариев() Цикл
			СброситьНастройкиОчереди(ИдентификаторПров);
		КонецЦикла;
		ХранилищеОбщихНастроек.Сохранить(
			КлючОбъектаНастроек(), КлючНастроекСпискаПровайдеров(), Новый Массив);
	Иначе
		СброситьНастройкиОчереди(Идентификатор);
		ЗабытьПровайдераСценария(Идентификатор);
	КонецЕсли;

КонецПроцедуры

// Возвращает число выполненных вызовов Чат() с момента последней
// УстановитьСценарий / ОчиститьСценарий.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - счетчик
//               персонального сценария провайдера; без параметра - общий.
//
// Возвращаемое значение:
//   Число - количество вызовов Чат() (>= 0).
//
Функция ПолучитьСчётчикВызовов(Провайдер = Неопределено) Экспорт

	Идентификатор = ИдентификаторПровайдера(Провайдер);
	СчётчикВызовов = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаНастроек(), КлючСчетчикаВызовов(Идентификатор));
	Если ТипЗнч(СчётчикВызовов) <> Тип("Число") Тогда
		СчётчикВызовов = 0;
	КонецЕсли;

	Возврат СчётчикВызовов;

КонецФункции

// Возвращает модель из параметров последнего вызова Чат() по выбранной
// очереди - для assert-ов тестов (например, что резервному провайдеру
// диспетчер передал его DefaultModel, а не модель основного).
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - модель
//               персональной очереди провайдера; без параметра - общей.
//
// Возвращаемое значение:
//   Строка - модель последнего вызова; "" - вызовов еще не было.
//
Функция МодельПоследнегоВызова(Провайдер = Неопределено) Экспорт

	Идентификатор = ИдентификаторПровайдера(Провайдер);
	Модель = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаНастроек(), КлючМоделиВызова(Идентификатор));

	Возврат ?(ТипЗнч(Модель) = Тип("Строка"), Модель, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает текущую очередь сценария из хранилища общих настроек; если
// сценарий не задан — пустой массив.
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди; "" - общая очередь.
//
// Возвращаемое значение:
//   Массив - очередь структур-описаний ответов.
//
Функция ОчередьСценария(Идентификатор)

	МассивОтветов = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), КлючСценария(Идентификатор));
	Если ТипЗнч(МассивОтветов) <> Тип("Массив") Тогда
		МассивОтветов = Новый Массив;
	КонецЕсли;

	Возврат МассивОтветов;

КонецФункции

// Сохраняет счётчик вызовов Чат() в хранилище общих настроек.
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди; "" - общая очередь.
//   Значение      - Число  - новое значение счетчика.
//
Процедура СохранитьСчётчикВызовов(Идентификатор, Значение)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючСчетчикаВызовов(Идентификатор), Значение);

КонецПроцедуры

// Запоминает модель из параметров последнего вызова Чат() очереди -
// для проверок тестов (МодельПоследнегоВызова).
//
// Параметры:
//   Идентификатор - Строка    - GUID-ключ очереди; "" - общая очередь.
//   Параметры     - Структура - параметры вызова Чат (допускается Неопределено).
//
Процедура СохранитьМодельВызова(Идентификатор, Параметры)

	Модель = "";
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Модель") Тогда
		Модель = Параметры["Модель"];
	КонецЕсли;

	ХранилищеОбщихНастроек.Сохранить(
		КлючОбъектаНастроек(), КлючМоделиВызова(Идентификатор), СокрЛП(Строка(Модель)));

КонецПроцедуры

// Сбрасывает все настройки одной очереди в чистое состояние: пустая очередь,
// нулевой счетчик, пустая модель. Сохранение значений по умолчанию вместо
// ХранилищеОбщихНастроек.Удалить: у Удалить все три параметра обязательны, а
// имя пользователя, отличное от текущего, требует права АдминистрированиеДанных;
// запись дефолтов тем же способом, что читает Загрузить, детерминирована.
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди; "" - общая очередь.
//
Процедура СброситьНастройкиОчереди(Идентификатор)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючСценария(Идентификатор), Новый Массив);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючСчетчикаВызовов(Идентификатор), 0);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючМоделиВызова(Идентификатор), "");

КонецПроцедуры

// Провайдер очереди для вызова Чат: ссылка из Параметры.Провайдер, если у
// нее задан персональный сценарий; иначе Неопределено - используется общий
// сценарий (прежнее поведение).
//
// Параметры:
//   Параметры - Структура - параметры вызова Чат (допускается Неопределено).
//
// Возвращаемое значение:
//   СправочникСсылка.ar_LLMПровайдеры, Неопределено - провайдер очереди.
//
Функция ПровайдерВызова(Параметры)

	Если ТипЗнч(Параметры) <> Тип("Структура")
		ИЛИ НЕ Параметры.Свойство("Провайдер")
		ИЛИ ТипЗнч(Параметры["Провайдер"]) <> Тип("СправочникСсылка.ar_LLMПровайдеры") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Провайдер = Параметры["Провайдер"];
	Если НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ?(ЕстьСценарийПровайдера(ИдентификаторПровайдера(Провайдер)), Провайдер, Неопределено);

КонецФункции

// GUID-ключ очереди по ссылке провайдера: Строка(УникальныйИдентификатор()) -
// длина ключа настроек в пределах ограничения хранилища (128 симв.).
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры, Неопределено - ссылка
//               произвольного типа или пустая.
//
// Возвращаемое значение:
//   Строка - GUID; "" - не ссылка ar_LLMПровайдеры или пустая.
//
Функция ИдентификаторПровайдера(Провайдер)

	Если ЗначениеЗаполнено(Провайдер)
		И ТипЗнч(Провайдер) = Тип("СправочникСсылка.ar_LLMПровайдеры") Тогда
		Возврат Строка(Провайдер.УникальныйИдентификатор());
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет, задан ли персональный сценарий провайдера (его GUID в списке).
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди провайдера.
//
// Возвращаемое значение:
//   Булево.
//
Функция ЕстьСценарийПровайдера(Идентификатор)

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СписокПровайдеровСценариев().Найти(Идентификатор) <> Неопределено;

КонецФункции

// Добавляет GUID провайдера в список персональных сценариев (если его там нет).
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди провайдера; пустая - пропуск.
//
Процедура ЗапомнитьПровайдераСценария(Идентификатор)

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Список = СписокПровайдеровСценариев();
	Если Список.Найти(Идентификатор) = Неопределено Тогда
		Список.Добавить(Идентификатор);
		СохранитьСписокПровайдеровСценариев(Список);
	КонецЕсли;

КонецПроцедуры

// Убирает GUID провайдера из списка персональных сценариев.
//
// Параметры:
//   Идентификатор - Строка - GUID-ключ очереди провайдера; пустая - пропуск.
//
Процедура ЗабытьПровайдераСценария(Идентификатор)

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Список = СписокПровайдеровСценариев();
	Индекс = Список.Найти(Идентификатор);
	Если Индекс <> Неопределено Тогда
		Список.Удалить(Индекс);
		СохранитьСписокПровайдеровСценариев(Список);
	КонецЕсли;

КонецПроцедуры

// Список GUID провайдеров с персональными сценариями из хранилища общих
// настроек; настройка не задана - пустой массив.
//
// Возвращаемое значение:
//   Массив из Строка - GUID-ключи очередей провайдеров.
//
Функция СписокПровайдеровСценариев()

	Список = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), КлючНастроекСпискаПровайдеров());
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Список = Новый Массив;
	КонецЕсли;

	Возврат Список;

КонецФункции

// Сохраняет список GUID провайдеров с персональными сценариями.
//
// Параметры:
//   Список - Массив из Строка - GUID-ключи очередей провайдеров.
//
Процедура СохранитьСписокПровайдеровСценариев(Список)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), КлючНастроекСпискаПровайдеров(), Список);

КонецПроцедуры

Функция КлючОбъектаНастроек()

	Возврат "ar_LLMMock";

КонецФункции

// Ключ настроек сценария очереди: "" - общий сценарий, иначе - с GUID-суффиксом.
//
Функция КлючСценария(Идентификатор)

	Возврат КлючОчереди("Сценарий", Идентификатор);

КонецФункции

// Ключ настроек счетчика вызовов очереди.
//
Функция КлючСчетчикаВызовов(Идентификатор)

	Возврат КлючОчереди("СчётчикВызовов", Идентификатор);

КонецФункции

// Ключ настроек модели последнего вызова очереди.
//
Функция КлючМоделиВызова(Идентификатор)

	Возврат КлючОчереди("МодельВызова", Идентификатор);

КонецФункции

Функция КлючНастроекСпискаПровайдеров()

	Возврат "ПровайдерыСценариев";

КонецФункции

// Собирает ключ настроек очереди: базовое имя + GUID-суффикс персональной
// очереди (суммарная длина ~51 символ - в пределах ограничения хранилища).
//
Функция КлючОчереди(Знач БазовоеИмя, Знач Идентификатор)

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат БазовоеИмя;
	КонецЕсли;

	Возврат БазовоеИмя + "_" + Идентификатор;

КонецФункции

// Собирает структуру-ответ контракта по одному элементу сценария.
//
// Параметры:
//   Элемент - Произвольный - элемент очереди сценария (ожидается Структура).
//
// Возвращаемое значение:
//   Структура - контракт ar_LLMКонтракт.НовыйОтвет().
//
Функция ОтветИзЭлемента(Элемент)

	Результат = ar_LLMКонтракт.НовыйОтвет();

	Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Результат.Ошибка = НСтр("ru = 'ar_LLMMock: элемент сценария не является структурой';
		                        |en = 'ar_LLMMock: scenario element is not a structure'");
		Возврат Результат;
	КонецЕсли;

	ТипОтвета = "";
	Элемент.Свойство("ТипОтвета", ТипОтвета);
	ТипОтвета = НРег(СокрЛП(Строка(ТипОтвета)));

	Если ТипОтвета = "text" Тогда
		Возврат ОтветТекст(Элемент);
	ИначеЕсли ТипОтвета = "tool_call" Тогда
		Возврат ОтветToolCall(Элемент);
	ИначеЕсли ТипОтвета = "error" Тогда
		Возврат ОтветОшибка(Элемент);
	КонецЕсли;

	ШаблонОшибки = НСтр("ru = 'ar_LLMMock: неизвестный ТипОтвета: %1';
	                    |en = 'ar_LLMMock: unknown response type: %1'");
	Результат.Ошибка = СтрШаблон(ШаблонОшибки, ТипОтвета);
	Возврат Результат;

КонецФункции

// Формирует успешный текстовый ответ (финальный шаг сценария).
//
Функция ОтветТекст(Элемент)

	Результат = ar_LLMКонтракт.НовыйОтвет();

	Содержание = "";
	Элемент.Свойство("Содержание", Содержание);

	Результат.Сообщение = ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольAssistant(), Строка(Содержание));
	ЗаполнитьUsage(Результат, Элемент);
	Результат.КодСостояния = 200;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Формирует успешный ответ с вызовом инструмента (промежуточный шаг).
//
Функция ОтветToolCall(Элемент)

	Результат = ar_LLMКонтракт.НовыйОтвет();

	ИмяTool = "";
	Элемент.Свойство("ИмяTool", ИмяTool);

	АргументыJSON = "";
	Элемент.Свойство("АргументыJSON", АргументыJSON);

	ToolCallId = "";
	Элемент.Свойство("ToolCallId", ToolCallId);

	Если ПустаяСтрока(Строка(ИмяTool)) Тогда
		Результат.Ошибка = НСтр("ru = 'ar_LLMMock: для tool_call не задан ИмяTool';
		                        |en = 'ar_LLMMock: ИмяTool is required for tool_call'");
		Возврат Результат;
	КонецЕсли;

	Содержание = "";
	Элемент.Свойство("Содержание", Содержание);

	Сообщение = ar_LLMКонтракт.НовоеСообщение(
		ar_LLMКонтракт.РольAssistant(), Строка(Содержание));

	ВызовыИнструментов = Новый Массив;
	ВызовыИнструментов.Добавить(ar_LLMКонтракт.НовыйToolCall(
		Строка(ToolCallId), Строка(ИмяTool), Строка(АргументыJSON)));
	Сообщение.Вставить("tool_calls", ВызовыИнструментов);

	Результат.Сообщение = Сообщение;
	ЗаполнитьUsage(Результат, Элемент);
	Результат.КодСостояния = 200;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Формирует ответ-ошибку (негативный путь). Успех остаётся Ложь.
//
Функция ОтветОшибка(Элемент)

	Результат = ar_LLMКонтракт.НовыйОтвет();

	КодСостояния = 0;
	Если Элемент.Свойство("КодСостояния", КодСостояния)
		И ТипЗнч(КодСостояния) = Тип("Число") Тогда
		Результат.КодСостояния = КодСостояния;
	КонецЕсли;

	Ошибка = "";
	Элемент.Свойство("Ошибка", Ошибка);
	Результат.Ошибка = ?(ПустаяСтрока(Строка(Ошибка)),
		НСтр("ru = 'ar_LLMMock: ошибка сценария';
		     |en = 'ar_LLMMock: scenario error'"),
		Строка(Ошибка));

	Возврат Результат;

КонецФункции

// Переносит usage (ТокеновВход/ТокеновВыход) из элемента сценария в результат,
// если они заданы. Приведение к неотрицательному числу — через ar_LLMКонтракт.
//
// Параметры:
//   Результат - Структура - ответ контракта (модифицируется).
//   Элемент   - Структура - элемент сценария.
//
Процедура ЗаполнитьUsage(Результат, Элемент)

	ТокеновВход = 0;
	Если Элемент.Свойство("ТокеновВход", ТокеновВход) Тогда
		Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(ТокеновВход);
	КонецЕсли;

	ТокеновВыход = 0;
	Если Элемент.Свойство("ТокеновВыход", ТокеновВыход) Тогда
		Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(ТокеновВыход);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
