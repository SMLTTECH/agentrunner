////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ОчередьРаспознавания (agentrunner-74).
//
// API очереди предварительного распознавания файлов (РегистрСведений
// .ar_ОчередьРаспознавания): чтение строк по файлам и по статусу, запись
// строки под блокировкой по файлу с проверкой ожидаемого статуса (защита
// от двойной отправки файла в RAGU), удаление закрытых строк старше N дней.
//
// Ключ очереди - файл (навигационная ссылка строкой, e1cib/data/...).
// Статусы строки: queued (поставлен в очередь), processing (отправлен в
// RAGU), done (текст записан в кэш файла), failed (отказ), skipped (текст
// уже есть в кэше файла). Пишет очередь только пакет
// ar_ПакетПрисоединённыеФайлы - команда «Предварительное распознавание»
// по расписанию БСП (спека agentrunner-74 п.Б.3).
//
// Привилегированный режим поднимается точечно внутри каждой экспортной
// функции и сбрасывается парным вызовом (Ложь), по паттерну
// ar_AuditЗащищённыйРежим: очередь общая для всех агентов, а регламентное
// задание БСП выполняется от имени пользователя задания (запись кэша текста
// в файл пакетом - отдельно, в самом пакете).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь
// (AUD-06: расширениям запрещён Privileged=true в общих модулях).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Новая строка очереди со значениями по умолчанию: единая точка знания
// состава полей - её используют и этот модуль, и пакет
// ar_ПакетПрисоединённыеФайлы.
//
// Возвращаемое значение:
//  Структура - {Файл, Владелец - Строка (навигационные ссылки);
//               Расширение - Строка; Размер - Число; ДатаМодификации - Дата
//               (отпечаток файла); ИдЗадания - Строка (id задания RAGU);
//               Статус - Строка ("queued"); Попыток - Число; ПоставленоВ,
//               ОтправленоВ, ГотовоВ - Дата; ПоследняяОшибка - Строка}.
//
Функция НоваяСтрокаОчереди() Экспорт

	Строка = Новый Структура;
	Строка.Вставить("Файл", "");
	Строка.Вставить("Владелец", "");
	Строка.Вставить("Расширение", "");
	Строка.Вставить("Размер", 0);
	Строка.Вставить("ДатаМодификации", '00010101');
	Строка.Вставить("ИдЗадания", "");
	Строка.Вставить("Статус", "queued");
	Строка.Вставить("Попыток", 0);
	Строка.Вставить("ПоставленоВ", '00010101');
	Строка.Вставить("ОтправленоВ", '00010101');
	Строка.Вставить("ГотовоВ", '00010101');
	Строка.Вставить("ПоследняяОшибка", "");
	Возврат Строка;

КонецФункции

// Строки очереди по файлам - одним запросом (спека agentrunner-74 п.А.2).
//
// Параметры:
//  Файлы - Массив из Строка - навигационные ссылки файлов (e1cib/data/...).
//
// Возвращаемое значение:
//  Соответствие - навигационная ссылка -> Структура строки очереди
//  (см. НоваяСтрокаОчереди); файлы без строки в очереди отсутствуют.
//
Функция СтрокиПоФайлам(Знач Файлы) Экспорт

	Результат = Новый Соответствие;
	Если ТипЗнч(Файлы) <> Тип("Массив") Или Файлы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ar_Файл КАК Файл,
		|	Т.ar_Владелец КАК Владелец,
		|	Т.ar_Расширение КАК Расширение,
		|	Т.ar_Размер КАК Размер,
		|	Т.ar_ДатаМодификации КАК ДатаМодификации,
		|	Т.ar_ИдЗадания КАК ИдЗадания,
		|	Т.ar_Статус КАК Статус,
		|	Т.ar_Попыток КАК Попыток,
		|	Т.ar_ПоставленоВ КАК ПоставленоВ,
		|	Т.ar_ОтправленоВ КАК ОтправленоВ,
		|	Т.ar_ГотовоВ КАК ГотовоВ,
		|	Т.ar_ПоследняяОшибка КАК ПоследняяОшибка
		|ИЗ
		|	РегистрСведений.ar_ОчередьРаспознавания КАК Т
		|ГДЕ
		|	Т.ar_Файл В (&Файлы)";
	Запрос.УстановитьПараметр("Файлы", Файлы);

	Выборка = ВыбратьПривилегированно(Запрос);
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Файл, СтрокаИзВыборки(Выборка));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строки очереди в заданном статусе - одним запросом, не более Лимит строк
// (Лимит = 0 - без ограничения).
//
// Параметры:
//  Статус - Строка - статус строк ("queued", "processing", ...).
//  Лимит  - Число  - предельное количество строк; 0 - без ограничения.
//
// Возвращаемое значение:
//  Массив из Структура - строки очереди (см. НоваяСтрокаОчереди).
//
Функция СтрокиПоСтатусу(Знач Статус, Знач Лимит = 0) Экспорт

	Строки = Новый Массив;

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т.ar_Файл КАК Файл,
		|	Т.ar_Владелец КАК Владелец,
		|	Т.ar_Расширение КАК Расширение,
		|	Т.ar_Размер КАК Размер,
		|	Т.ar_ДатаМодификации КАК ДатаМодификации,
		|	Т.ar_ИдЗадания КАК ИдЗадания,
		|	Т.ar_Статус КАК Статус,
		|	Т.ar_Попыток КАК Попыток,
		|	Т.ar_ПоставленоВ КАК ПоставленоВ,
		|	Т.ar_ОтправленоВ КАК ОтправленоВ,
		|	Т.ar_ГотовоВ КАК ГотовоВ,
		|	Т.ar_ПоследняяОшибка КАК ПоследняяОшибка
		|ИЗ
		|	РегистрСведений.ar_ОчередьРаспознавания КАК Т
		|ГДЕ
		|	Т.ar_Статус = &Статус";
	Если Лимит > 0 Тогда
		// В тексте запроса "ВЫБРАТЬ" встречается один раз - замена безопасна.
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ",
			"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧН=0; ЧГ=0"));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Статус", Статус);

	Выборка = ВыбратьПривилегированно(Запрос);
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрокаИзВыборки(Выборка));
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Запись строки очереди под блокировкой по файлу (спека agentrunner-74
// п.А.2): при заданном ОжидаемыйСтатус сначала перепроверяется статус
// существующей строки - если он другой (или строки нет), запись не
// выполняется и возвращается Ложь. Защита от двойной отправки файла в RAGU:
// переход queued -> processing проходит только у одной задачи.
//
// Параметры:
//  Данные          - Структура - поля строки (см. НоваяСтрокаОчереди);
//                    перезаписываются все поля строки.
//  ОжидаемыйСтатус - Строка, Неопределено - ожидаемый текущий статус строки;
//                    Неопределено - записать безусловно (постановка/сброс).
//
// Возвращаемое значение:
//  Булево - Истина, если строка записана.
//
Функция ЗаписатьСтроку(Знач Данные, Знач ОжидаемыйСтатус = Неопределено) Экспорт

	Записано = Ложь;

	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ar_ОчередьРаспознавания");
	ЭлементБлокировки.УстановитьЗначение("ar_Файл", Данные.Файл);

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных.Заблокировать();
		МенеджерЗаписи = РегистрыСведений.ar_ОчередьРаспознавания.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Файл = Данные.Файл;
		МенеджерЗаписи.Прочитать();
		Если ОжидаемыйСтатус = Неопределено
			Или МенеджерЗаписи.ar_Статус = ОжидаемыйСтатус Тогда
			МенеджерЗаписи.ar_Владелец = Данные.Владелец;
			МенеджерЗаписи.ar_Расширение = Данные.Расширение;
			МенеджерЗаписи.ar_Размер = Данные.Размер;
			МенеджерЗаписи.ar_ДатаМодификации = Данные.ДатаМодификации;
			МенеджерЗаписи.ar_ИдЗадания = Данные.ИдЗадания;
			МенеджерЗаписи.ar_Статус = Данные.Статус;
			МенеджерЗаписи.ar_Попыток = Данные.Попыток;
			МенеджерЗаписи.ar_ПоставленоВ = Данные.ПоставленоВ;
			МенеджерЗаписи.ar_ОтправленоВ = Данные.ОтправленоВ;
			МенеджерЗаписи.ar_ГотовоВ = Данные.ГотовоВ;
			МенеджерЗаписи.ar_ПоследняяОшибка = Данные.ПоследняяОшибка;
			МенеджерЗаписи.Записать(Истина);
			Записано = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Записано;

КонецФункции

// Удаление закрытых строк очереди (done, failed, skipped), поставленных
// ранее чем Дней суток назад (спека agentrunner-74 п.Б.10).
//
// Параметры:
//  Дней - Число - срок хранения закрытых строк, суток.
//
// Возвращаемое значение:
//  Число - количество удалённых строк.
//
Функция УдалитьЗакрытыеСтарше(Знач Дней) Экспорт

	ЗакрытыеСтатусы = Новый Массив;
	ЗакрытыеСтатусы.Добавить("done");
	ЗакрытыеСтатусы.Добавить("failed");
	ЗакрытыеСтатусы.Добавить("skipped");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ar_Файл КАК Файл
		|ИЗ
		|	РегистрСведений.ar_ОчередьРаспознавания КАК Т
		|ГДЕ
		|	Т.ar_Статус В (&ЗакрытыеСтатусы)
		|	И Т.ar_ПоставленоВ < &Грань";
	Запрос.УстановитьПараметр("ЗакрытыеСтатусы", ЗакрытыеСтатусы);
	// Сутки в секундах.
	СекундВСутках = 86400;
	Запрос.УстановитьПараметр("Грань", ТекущаяДатаСеанса() - Дней * СекундВСутках);

	Удалено = 0;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.ar_ОчередьРаспознавания.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ar_Файл = Выборка.Файл;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Записать(Ложь);
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Удалено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполнение запроса в привилегированном режиме: очередь общая для всех
// агентов, пользователь регламентного задания БСП не обязан видеть её строки.
// Режим поднимается минимальным блоком вокруг Выполнить().
//
// Параметры:
//  Запрос - Запрос - подготовленный запрос.
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса.
//
Функция ВыбратьПривилегированно(Знач Запрос)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Выборка;

КонецФункции

// Структура строки очереди из выборки запроса.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - текущая запись выборки.
//
// Возвращаемое значение:
//  Структура - см. НоваяСтрокаОчереди.
//
Функция СтрокаИзВыборки(Знач Выборка)

	Строка = НоваяСтрокаОчереди();
	Строка.Файл = Выборка.Файл;
	Строка.Владелец = Выборка.Владелец;
	Строка.Расширение = Выборка.Расширение;
	Строка.Размер = Выборка.Размер;
	Строка.ДатаМодификации = Выборка.ДатаМодификации;
	Строка.ИдЗадания = Выборка.ИдЗадания;
	Строка.Статус = Выборка.Статус;
	Строка.Попыток = Выборка.Попыток;
	Строка.ПоставленоВ = Выборка.ПоставленоВ;
	Строка.ОтправленоВ = Выборка.ОтправленоВ;
	Строка.ГотовоВ = Выборка.ГотовоВ;
	Строка.ПоследняяОшибка = Выборка.ПоследняяОшибка;
	Возврат Строка;

КонецФункции

#КонецОбласти
