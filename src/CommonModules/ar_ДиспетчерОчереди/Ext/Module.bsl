////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ДиспетчерОчереди (agentrunner-32).
//
// Диспетчер очереди пакетов: раз в минуту (блок в тике
// ar_Планировщик.ОбработатьПланировщик) обходит агентов с признаком очереди
// (ar_БратьИзОчередиПакета + заполненный ar_ПакетИсточник), запрашивает у
// пакета кандидатов по контракту ar_ОбъектыКОбработке(Агент, Лимит) и
// стартует по запуску на предмет в свободные слоты агента.
//
// Контракт пакета (спека п.7): экспортная функция ar_ОбъектыКОбработке(Агент,
// Лимит) -> Массив ссылок, в порядке приоритета, не больше Лимит. Ядро
// вызывает метод ЛЮБОГО зарегистрированного пакета; от конкретного пакета не
// зависит. Все ошибки пакета - лог queue_source_failed (не чаще раза в
// 30 минут по агенту).
//
// Захват предмета и лимит параллельности страхуются в
// ar_RuntimeЗапуск.СтартоватьВФоне - диспетчер только отсекает заведомо
// занятых кандидатов, чтобы не жечь слоты запросами впустую.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработать очереди всех агентов (вызывается из тика ar_Планировщика).
//
// Порядок: уборка сиротских захватов, затем по каждому агенту очереди -
// свободные слоты, кандидаты пакета, отсев занятых, старты до исчерпания
// слотов, итог queue_tick в журнал (только если стартован хотя бы один
// запуск). Исключения наружу не пробрасываются: по агенту логируются и не
// прерывают обход остальных.
//
Процедура ОбработатьОчереди() Экспорт

	НачалоТика = ТекущаяДатаСеанса();

	Попытка
		ar_AuditЗащищённыйРежим.УбратьСиротскиеЗахватыПривилегированно(НачалоТика);
	Исключение
		// Уборка страхует снятие захвата в фасаде; её сбой тик не ломает.
		ЗаписатьОшибкуТика("уборка сиротских захватов");
	КонецПопытки;

	Агенты = АгентыОчереди();

	Для Каждого СтрокаАгента Из Агенты Цикл
		Попытка
			ОбработатьОчередьАгента(СтрокаАгента, НачалоТика);
		Исключение
			ЗаписатьОшибкуТика(СтрШаблон("агент %1", Строка(СтрокаАгента.Агент)));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработать очередь одного агента (см. ОбработатьОчереди): слоты - кандидаты
// пакета - отсев - старты - queue_tick. Разбита на СтартоватьКандидатов и
// ЗаписатьИтогТика ради когнитивной сложности (BSL LS: CognitiveComplexity).
//
Функция ОбработатьОчередьАгента(Знач СтрокаАгента, Знач НачалоТика)

	СлужебныйПользователь = ar_Константы.СлужебныйПользователь();
	ПользовательРеф = ?(ЗначениеЗаполнено(СлужебныйПользователь),
		СлужебныйПользователь, Пользователи.ТекущийПользователь());

	// 1. Свободные слоты: per-agent потолок агента минус активные запуски;
	// суммарный лимит базы - как в ЗапуститьАгента (SCHED-05). Слотов нет -
	// агент пропускается без записи в лог (иначе шум каждую минуту).
	Счётчики = ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно(СтрокаАгента.Агент);
	СвободноСлотов = СтрокаАгента.ЛимитЗапусков - Счётчики.ПоАгенту;
	Если СвободноСлотов <= 0
		Или Счётчики.ВсегоАктивных >= ar_Константы.МаксСуммарныхЗапусков() Тогда
		Возврат Ложь;
	КонецЕсли;

	// 2. Кандидаты пакета по контракту ar_ОбъектыКОбработке.
	ЛимитВыборки = МИН(СвободноСлотов + ЗапасОтсева(), МаксимальныйЛимитВыборки());
	Кандидаты = КандидатыПакета(СтрокаАгента, ЛимитВыборки);
	Если Кандидаты = Неопределено Тогда
		Возврат Ложь; // queue_source_failed уже записан
	КонецЕсли;
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Ложь; // очередь пакета пуста - не ошибка, тик молчит
	КонецЕсли;

	// 3. Отсев занятых/исключённых одним запросом к регистру (фасад).
	Отсев = ar_AuditЗащищённыйРежим.ОтсеятьКандидатыОчередиПривилегированно(
		СтрокаАгента.Агент, СтрокаАгента.ПакетИсточник, Кандидаты);

	// 4. Старты до исчерпания слотов, в порядке пакета.
	СчётчикиСтартов = Новый Структура("Стартовано, Себе, Соседом, Исключённым", 0, 0, 0, 0);
	СтартоватьКандидатов(СтрокаАгента, Отсев, Кандидаты, СвободноСлотов,
		ПользовательРеф, СчётчикиСтартов);

	// 5. Итог по агенту - только если стартован хотя бы один запуск (спека
	// п.4.5: иначе каждую минуту писались бы одинаковые записи «всё занято»).
	Если СчётчикиСтартов.Стартовано > 0 Тогда
		ЗаписатьИтогТика(СтрокаАгента, Кандидаты, СвободноСлотов, СчётчикиСтартов, НачалоТика);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Стартовать кандидатов очереди до исчерпания свободных слотов (спека п.4.4):
// отсеянные считаются по причинам, отказ старта - лог queue_start_failed
// (отказы захвата уже залогированы в ar_RuntimeЗапуск как
// start_refused_captured) и переход к следующему кандидату.
//
// Параметры:
//  СтрокаАгента      - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  Отсев             - Структура - {Отсеянные, ПоследниеПричины}.
//  Кандидаты         - Массив - ссылки-кандидаты пакета.
//  СвободноСлотов    - Число - сколько запусков можно стартовать.
//  ПользовательРеф   - СправочникСсылка.Пользователи - инициатор (как для cron).
//  СчётчикиСтартов   - Структура - {Стартовано, Себе, Соседом, Исключённым}
//                      (заполняется).
//
Процедура СтартоватьКандидатов(Знач СтрокаАгента, Знач Отсев, Знач Кандидаты,
	Знач СвободноСлотов, Знач ПользовательРеф, СчётчикиСтартов)

	Для Каждого Предмет Из Кандидаты Цикл
		Если СчётчикиСтартов.Стартовано >= СвободноСлотов Тогда
			Прервать;
		КонецЕсли;

		ПричинаОтсева = Отсев.Отсеянные.Получить(Предмет);
		Если ПричинаОтсева <> Неопределено Тогда
			УчестьПричинуОтсева(ПричинаОтсева, СчётчикиСтартов);
			Продолжить;
		КонецЕсли;

		КонтекстТриггера = КонтекстСтарта(Отсев, Предмет, ПользовательРеф);
		Результат = ar_RuntimeЗапуск.СтартоватьВФоне(СтрокаАгента.Агент, КонтекстТриггера);
		Если Результат.Успех Тогда
			СчётчикиСтартов.Стартовано = СчётчикиСтартов.Стартовано + 1;
			ЗафиксироватьСтартПоИстекшемуСроку(КонтекстТриггера, СтрокаАгента,
				Предмет, Отсев, Результат.RunId);
		Иначе
			УчестьОтказСтарта(СтрокаАгента, Предмет, Результат, СчётчикиСтартов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Событие deadline_expired_start (спека п.8): RunId нового запуска и причина
// предыдущего снятия. Пишется после успешного старта - RunId известен только
// тогда (ar_RuntimeЗапуск.СтартоватьВФоне возвращает его при успехе).
//
// Параметры:
//  КонтекстТриггера - Структура - контекст удачного старта (Триггер и др.).
//  СтрокаАгента     - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  Предмет          - ЛюбаяСсылка - предмет удачного старта.
//  Отсев            - Структура - {Отсеянные, ПоследниеПричины}.
//  RunId            - Строка - идентификатор нового запуска.
//
Процедура ЗафиксироватьСтартПоИстекшемуСроку(Знач КонтекстТриггера, Знач СтрокаАгента,
	Знач Предмет, Знач Отсев, Знач RunId)

	Если КонтекстТриггера.Триггер <> "deadline_expired" Тогда
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "deadline_expired_start",
		СтрШаблон("Агент=%1; Предмет=%2; RunId=%3; ПричинаПредыдущегоСнятия=%4",
			Строка(СтрокаАгента.Агент), Строка(Предмет), RunId,
			Отсев.ПоследниеПричины.Получить(Предмет)),
		"Информация", RunId, Предмет);

КонецПроцедуры

// Зачесть отсеянный кандидат в счётчики тика по причине отсева
// ("captured_self" / "captured_queue_peer" / "excluded").
//
// Параметры:
//  ПричинаОтсева   - Строка - причина отсева кандидата.
//  СчётчикиСтартов - Структура - {Стартовано, Себе, Соседом, Исключённым}
//                    (заполняется).
//
Процедура УчестьПричинуОтсева(Знач ПричинаОтсева, СчётчикиСтартов)

	СчётчикиСтартов.Себе = СчётчикиСтартов.Себе
		+ ?(ПричинаОтсева = "captured_self", 1, 0);
	СчётчикиСтартов.Соседом = СчётчикиСтартов.Соседом
		+ ?(ПричинаОтсева = "captured_queue_peer", 1, 0);
	СчётчикиСтартов.Исключённым = СчётчикиСтартов.Исключённым
		+ ?(ПричинаОтсева = "excluded", 1, 0);

КонецПроцедуры

// Учёт отказа старта: отказы захвата идут в счётчики отсева (гонка между
// отсевом и стартом), прочие причины - в журнал queue_start_failed.
//
Процедура УчестьОтказСтарта(Знач СтрокаАгента, Знач Предмет, Знач Результат,
	СчётчикиСтартов)

	Если СтрНачинаетсяС(Результат.Причина, "subject_captured") Тогда
		СчётчикиСтартов.Себе = СчётчикиСтартов.Себе
			+ ?(Результат.Причина = "subject_captured", 1, 0);
		СчётчикиСтартов.Соседом = СчётчикиСтартов.Соседом
			+ ?(Результат.Причина = "subject_captured_by_queue_peer", 1, 0);
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_start_failed",
		СтрШаблон("Агент=%1; Предмет=%2; Причина=%3",
			Строка(СтрокаАгента.Агент), Строка(Предмет), Результат.Причина),
		"Предупреждение", Результат.RunId, Предмет);

КонецПроцедуры

// Итог тика по агенту в журнал (queue_tick): слоты, кандидаты, отсеяно по
// причинам (self / queue_peer / excluded), стартовано, длительность мс.
//
Процедура ЗаписатьИтогТика(Знач СтрокаАгента, Знач Кандидаты, Знач СвободноСлотов,
	Знач СчётчикиСтартов, Знач НачалоТика)

	ДлительностьМс = Окр((ТекущаяДатаСеанса() - НачалоТика) * 1000);
	ТекстТика = СтрШаблон(
		"Слотов=%1; Кандидатов=%2; ОтсеяноСебе=%3; ОтсеяноQueuePeer=%4; "
			+ "ОтсеяноExcluded=%5; Стартовано=%6; ДлительностьМс=%7",
		СвободноСлотов,
		Кандидаты.Количество(),
		СчётчикиСтартов.Себе,
		СчётчикиСтартов.Соседом,
		СчётчикиСтартов.Исключённым,
		СчётчикиСтартов.Стартовано,
		ДлительностьМс);
	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_tick", ТекстТика,
		"Информация", "", СтрокаАгента.Агент);

КонецПроцедуры

// Агенты очереди одним запросом: активны, берут из очереди пакета, пакет
// заполнен. Лимит запусков - потолок агента (0/пусто как 1, не выше SCHED-05).
//
// Возвращаемое значение:
//  Массив структур {Агент, ПакетИсточник, ЛимитЗапусков}.
//
Функция АгентыОчереди()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Агент,
		|	Агенты.ar_ПакетИсточник КАК ПакетИсточник,
		|	Агенты.ar_МаксПараллельныхЗапусков КАК МаксПараллельныхЗапусков
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.ar_Активен
		|	И Агенты.ar_БратьИзОчередиПакета
		|	И Агенты.ar_ПакетИсточник <> """"";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Агент, ПакетИсточник, ЛимитЗапусков",
			Выборка.Агент,
			СокрЛП(Выборка.ПакетИсточник),
			ar_ПредметыАгентов.ЛимитЗапусковПоРеквизиту(Выборка.МаксПараллельныхЗапусков)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кандидаты от пакета: запись реестра по ar_Namespace (зарегистрирован),
// объект пакета, вызов ar_ОбъектыКОбработке(Агент, Лимит). Любая ошибка -
// лог queue_source_failed (с ограничением частоты) и Неопределено.
//
// Возвращаемое значение:
//  Массив ссылок; Неопределено - пакет недоступен (источник очереди сломан).
//
Функция КандидатыПакета(Знач СтрокаАгента, Знач ЛимитВыборки)

	ИдентификаторОбработки = ИдентификаторПакетаПоNamespace(СтрокаАгента.ПакетИсточник);
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("пакет по namespace '%1' не найден в реестре", СтрокаАгента.ПакетИсточник));
		Возврат Неопределено;
	КонецЕсли;

	ОбъектПакета = ar_ИнструментыПлагинВызов.СоздатьОбъектПакета(ИдентификаторОбработки);
	Если ОбъектПакета = Неопределено Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("объект пакета '%1' не создан", ИдентификаторОбработки));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Кандидаты = ОбъектПакета.ar_ОбъектыКОбработке(СтрокаАгента.Агент, ЛимитВыборки);
	Исключение
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("ошибка вызова ar_ОбъектыКОбработке: %1",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Кандидаты) <> Тип("Массив") Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("ar_ОбъектыКОбработке вернула %1 вместо Массив", ТипЗнч(Кандидаты)));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кандидаты;

КонецФункции

// Контекст старта для кандидата (спека п.4.4): обычный тик - триггер queue;
// если последняя причина снятия по паре - question_expired (предыдущий
// вопрос остался без ответа), триггер deadline_expired и добавка инструкции.
// Событие deadline_expired_start пишется не здесь, а после успешного старта
// (СтартоватьКандидаты) - спека п.8 требует в нём RunId нового запуска.
//
// Параметры:
//  Отсев            - Структура - {Отсеянные, ПоследниеПричины}.
//  Предмет          - ЛюбаяСсылка - предмет-кандидат.
//  ПользовательРеф  - СправочникСсылка.Пользователи - инициатор (как для cron).
//
// Возвращаемое значение:
//  Структура - {Триггер, ЯкорьСсылка, ПользовательРеф, ИнструкцияДобавка*}.
//
Функция КонтекстСтарта(Знач Отсев, Знач Предмет, Знач ПользовательРеф)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "queue");
	КонтекстТриггера.Вставить("ЯкорьСсылка", Предмет);
	КонтекстТриггера.Вставить("ПользовательРеф", ПользовательРеф);

	Если Отсев.ПоследниеПричины.Получить(Предмет) = "question_expired" Тогда
		КонтекстТриггера.Вставить("Триггер", "deadline_expired");
		КонтекстТриггера.Вставить("ИнструкцияДобавка",
			НСтр("ru='Предыдущий вопрос по этому объекту остался без ответа -
				|срок ответа истёк. Действуй по своему регламенту для истёкшего срока.';
				|en='The previous question about this object was left unanswered -
				|the answer deadline has expired. Follow your regulation for expired deadlines.'"));
	КонецЕсли;

	Возврат КонтекстТриггера;

КонецФункции

// Идентификатор обработки зарегистрированного пакета по пространству имён.
//
// Возвращаемое значение:
//  Строка - ar_ИдентификаторОбработки; "" если пакета нет или он не активен.
//
Функция ИдентификаторПакетаПоNamespace(Знач Namespace)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace = &Namespace
		|	И Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")";
	Запрос.УстановитьПараметр("Namespace", Namespace);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ИдентификаторОбработки);
	КонецЕсли;

	Возврат "";

КонецФункции

// Лог queue_source_failed с ограничением частоты: не чаще раза в 30 минут по
// агенту и тексту ошибки (спека п.8; память модуля между тиками не сохраняется
// - граница берётся из последней записи журнала с Объект = агент; смена текста
// ошибки логируется сразу).
//
Функция ЗаписатьСбойИсточника(Знач СсылкАгент, Знач ТекстСбоя)

	ТекстЗаписи = СтрШаблон("Агент=%1; %2", Строка(СсылкАгент), ТекстСбоя);

	Если ПоследнийСбойМоложе(СсылкАгент, ТекстЗаписи) Тогда
		Возврат Ложь;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_source_failed",
		ТекстЗаписи, "Ошибка", "", СсылкАгент);

	Возврат Истина;

КонецФункции

// Есть ли запись queue_source_failed с тем же текстом по агенту моложе паузы
// (30 минут); запись с другим текстом (сменилась причина сбоя) не глушится.
//
// Параметры:
//  СсылкАгент  - СправочникСсылка.ar_Агенты - агент очереди.
//  ТекстЗаписи - Строка - полный текст записи журнала (для сравнения).
//
// Возвращаемое значение:
//  Булево - Истина, если свежая запись с тем же текстом уже есть.
//
Функция ПоследнийСбойМоложе(Знач СсылкАгент, Знач ТекстЗаписи)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Момент КАК ПоследнийМомент,
		|	Лог.ar_Текст КАК ПоследнийТекст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|	И Лог.ar_ОбъектСсылка = &ОбъектСсылка
		|УПОРЯДОЧИТЬ ПО
		|	Лог.ar_Момент УБЫВ";
	Запрос.УстановитьПараметр("Источник", ИмяИсточникаЛога());
	Запрос.УстановитьПараметр("Событие", "queue_source_failed");
	Запрос.УстановитьПараметр("ОбъектСсылка", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкАгент));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(Выборка.ПоследнийМомент)
		И Выборка.ПоследнийМомент > ТекущаяДатаСеанса() - ПаузаСбоевИсточника()
		И Выборка.ПоследнийТекст = ТекстЗаписи;

КонецФункции

// Ошибка блока тика диспетчера - журнал регистрации (паттерн ar_Планировщик).
//
Процедура ЗаписатьОшибкуТика(Знач ЧтоУпало)

	ТекстОшибки = СтрШаблон(
		НСтр("ru='Ошибка диспетчера очереди (%1): %2';
			|en='Queue dispatcher error (%1): %2'"),
		ЧтоУпало,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_ДиспетчерОчереди'; en='ar_QueueDispatcher'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);

КонецПроцедуры

// Запас кандидатов поверх свободных слотов - на отсев занятых (спека п.4.2).
//
Функция ЗапасОтсева()

	Возврат 20;

КонецФункции

// Потолок выборки кандидатов за тик по одному агенту (спека п.4.2).
//
Функция МаксимальныйЛимитВыборки()

	Возврат 200;

КонецФункции

// Пауза между записями queue_source_failed по одному агенту, секунд.
//
Функция ПаузаСбоевИсточника()

	Возврат 30 * 60;

КонецФункции

// Источник записей журнала диспетчера (консоль ищет queue_tick по нему же -
// ar_ПредметыАгентов.ИмяИсточникаДиспетчера).
//
Функция ИмяИсточникаЛога()

	Возврат "ar_ДиспетчерОчереди";

КонецФункции

#КонецОбласти
