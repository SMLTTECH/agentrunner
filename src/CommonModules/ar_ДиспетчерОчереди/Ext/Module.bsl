////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ДиспетчерОчереди (agentrunner-32).
//
// Диспетчер очереди пакетов: раз в минуту (блок в тике
// ar_Планировщик.ОбработатьПланировщик) обходит агентов с признаком очереди
// (ar_БратьИзОчередиПакета + заполненный ar_ПакетИсточник), запрашивает у
// пакета кандидатов по контракту ar_ОбъектыКОбработке(Агент, Лимит) и
// стартует по запуску на предмет в свободные слоты агента.
//
// Контракт пакета (спека п.7): экспортная функция ar_ОбъектыКОбработке(Агент,
// Лимит) -> Массив ссылок, в порядке приоритета, не больше Лимит. Ядро
// вызывает метод ЛЮБОГО зарегистрированного пакета; от конкретного пакета не
// зависит. Все ошибки пакета - лог queue_source_failed (не чаще раза в
// 30 минут по агенту).
//
// Захват предмета и лимит параллельности страхуются в
// ar_RuntimeЗапуск.СтартоватьВФоне - диспетчер только отсекает заведомо
// занятых кандидатов, чтобы не жечь слоты запросами впустую.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработать очереди всех агентов (вызывается из тика ar_Планировщика).
//
// Порядок: уборка сиротских захватов, затем по каждому агенту очереди -
// свободные слоты, кандидаты пакета, отсев занятых, старты до исчерпания
// слотов, итог queue_tick в журнал. Итог пишется, если стартован хотя бы
// один запуск, а при пустой очереди - пульсом не чаще раза в ПаузаПульса
// (консоль показывает, что очередь опрашивается, без холостых запусков).
// Исключения наружу не пробрасываются: по агенту логируются и не прерывают
// обход остальных.
//
Процедура ОбработатьОчереди() Экспорт

	НачалоТика = ТекущаяДатаСеанса();

	Попытка
		ar_AuditЗащищённыйРежим.УбратьСиротскиеЗахватыПривилегированно(НачалоТика);
	Исключение
		// Уборка страхует снятие захвата в фасаде; её сбой тик не ломает.
		ЗаписатьОшибкуТика("уборка сиротских захватов");
	КонецПопытки;

	Агенты = АгентыОчереди();

	Попытка
		ЗаполнитьПоследниеТики(Агенты);
	Исключение
		// Без моментов последних тиков пульс не пишется (ЗаписатьПульсТика), старты идут.
		ЗаписатьОшибкуТика("последние тики очереди");
	КонецПопытки;

	// agentrunner-444 (п. 9): общий лимит запусков исчерпан - старты прекращаются
	// для всех агентов до следующего тика.
	СостояниеТика = Новый Структура("ОбщийЛимитИсчерпан", Ложь);

	Для Каждого СтрокаАгента Из Агенты Цикл
		Если СостояниеТика.ОбщийЛимитИсчерпан Тогда
			Прервать;
		КонецЕсли;
		Попытка
			ОбработатьОчередьАгента(СтрокаАгента, НачалоТика, СостояниеТика);
		Исключение
			ЗаписатьОшибкуТика(СтрШаблон("агент %1", Строка(СтрокаАгента.Агент)));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработать очередь одного агента (см. ОбработатьОчереди): слоты - кандидаты
// пакета - отсев - старты - queue_tick. Разбита на СтартоватьКандидатов и
// ЗаписатьИтогТика ради когнитивной сложности (BSL LS: CognitiveComplexity).
//
// Параметры:
//  СтрокаАгента  - Структура - {Агент, ПакетИсточник, ЛимитЗапусков, ...}.
//  НачалоТика    - Дата - момент начала тика.
//  СостояниеТика - Структура - {ОбщийЛимитИсчерпан} (agentrunner-444, п. 9; изменяется).
//
// Возвращаемое значение:
//  Булево - Истина, если дошло до стартов.
//
Функция ОбработатьОчередьАгента(Знач СтрокаАгента, Знач НачалоТика, СостояниеТика)

	СлужебныйПользователь = ar_Константы.СлужебныйПользователь();
	ПользовательРеф = ?(ЗначениеЗаполнено(СлужебныйПользователь),
		СлужебныйПользователь, Пользователи.ТекущийПользователь());

	// 1. Свободные слоты: per-agent потолок агента минус активные запуски;
	// суммарный лимит базы - как в ЗапуститьАгента (SCHED-05). Слотов нет -
	// агент пропускается без записи в лог (иначе шум каждую минуту).
	Счётчики = ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно(СтрокаАгента.Агент);
	Если Счётчики.ВсегоАктивных >= ar_Константы.МаксСуммарныхЗапусков() Тогда
		СостояниеТика.ОбщийЛимитИсчерпан = Истина;
		Возврат Ложь;
	КонецЕсли;
	СвободноСлотов = СтрокаАгента.ЛимитЗапусков - Счётчики.ПоАгенту;
	Если СвободноСлотов <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// 2-3.5. Кандидаты пакета по контракту ar_ОбъектыКОбработке, отсев
	// занятых/исключённых и вне состава (ОтобратьКандидатов). Сбой этапа не
	// роняет тик - записан там же.
	ЛимитВыборки = МИН(СвободноСлотов + ЗапасОтсева(), МаксимальныйЛимитВыборки());
	Отбор = ОтобратьКандидатов(СтрокаАгента, ЛимитВыборки);
	Если Отбор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// agentrunner-444 (п. 10): пакет об отсеве не знает - при стабильном порядке
	// выдачи те же отсеянные предметы занимали бы выборку каждый тик и очередь
	// стояла. Выборка полная, а доступных меньше слотов - в том же тике один
	// повторный запрос с потолком выборки.
	Если ЧислоДоступных(Отбор) < СвободноСлотов
		И Отбор.ВсегоВыборки = ЛимитВыборки
		И ЛимитВыборки < МаксимальныйЛимитВыборки() Тогда
		ЛимитВыборки = МаксимальныйЛимитВыборки();
		ОтборРасширенный = ОтобратьКандидатов(СтрокаАгента, ЛимитВыборки);
		Если ОтборРасширенный = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Отбор = ОтборРасширенный;
	КонецЕсли;

	Кандидаты = Отбор.Кандидаты;
	Отсев = Отбор.Отсев;
	Если ЧислоДоступных(Отбор) = 0 Тогда
		Если Отбор.ВсегоВыборки > 0 И Отбор.ВсегоВыборки = ЛимитВыборки Тогда
			ПредупредитьОтсеянаВсяВыборка(СтрокаАгента, Отбор, НачалоТика);
		КонецЕсли;
		// Очередь пакета пуста или всё отсеяно - не ошибка: только пульс (не чаще ПаузаПульса).
		СчетчикиОтсева = НовыеСчетчикиСтартов();
		Для Каждого Предмет Из Кандидаты Цикл
			ПричинаОтсева = Отсев.Отсеянные.Получить(Предмет);
			Если ПричинаОтсева <> Неопределено Тогда
				УчестьПричинуОтсева(ПричинаОтсева, СчетчикиОтсева);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьПульсТика(СтрокаАгента, Кандидаты, СвободноСлотов, СчетчикиОтсева, НачалоТика);
		Возврат Ложь;
	КонецЕсли;

	// 4. Старты до исчерпания слотов, в порядке пакета. Сбой этапа записан по
	// кандидатам (СбойСтартаКандидата) - здесь дублировать нечем.
	СчётчикиСтартов = НовыеСчетчикиСтартов();
	Попытка
		СтартоватьКандидатов(СтрокаАгента, Отсев, Кандидаты, СвободноСлотов,
			ПользовательРеф, СчётчикиСтартов, СостояниеТика);
	Исключение
		СбойЭтапаТика("старт кандидатов", СтрокаАгента.Агент);
	КонецПопытки;

	// 5. Итог по агенту - если стартован хотя бы один запуск (спека п.4.5:
	// иначе каждую минуту писались бы одинаковые записи «всё занято»); без
	// стартов - пульс не чаще ПаузаПульса.
	Если СчётчикиСтартов.Стартовано > 0 Тогда
		ЗаписатьИтогТика(СтрокаАгента, Кандидаты, СвободноСлотов, СчётчикиСтартов, НачалоТика);
	Иначе
		ЗаписатьПульсТика(СтрокаАгента, Кандидаты, СвободноСлотов, СчётчикиСтартов, НачалоТика);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Стартовать кандидатов очереди до исчерпания свободных слотов (спека п.4.4):
// отсеянные считаются по причинам, отказ старта - лог queue_start_failed
// (отказы захвата уже залогированы в ar_RuntimeЗапуск как
// start_refused_captured) и переход к следующему кандидату.
//
// Параметры:
//  СтрокаАгента      - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  Отсев             - Структура - {Отсеянные, ПоследниеПричины}.
//  Кандидаты         - Массив - ссылки-кандидаты пакета.
//  СвободноСлотов    - Число - сколько запусков можно стартовать.
//  ПользовательРеф   - СправочникСсылка.Пользователи - инициатор (как для cron).
//  СчётчикиСтартов   - Структура - {Стартовано, Себе, Соседом, Исключённым}
//                      (заполняется).
//  СостояниеТика     - Структура - {ОбщийЛимитИсчерпан} (agentrunner-444, п. 9; изменяется).
//
// agentrunner-444 (п. 9): отказ global_limit_reached прекращает старты тика по всем
// агентам, agent_already_running - старты этого агента; queue_start_failed по
// каждому оставшемуся кандидату не пишется.
//
Процедура СтартоватьКандидатов(Знач СтрокаАгента, Знач Отсев, Знач Кандидаты,
	Знач СвободноСлотов, Знач ПользовательРеф, СчётчикиСтартов, СостояниеТика)

	Для Каждого Предмет Из Кандидаты Цикл
		Если СчётчикиСтартов.Стартовано >= СвободноСлотов Тогда
			Прервать;
		КонецЕсли;

		ПричинаОтсева = Отсев.Отсеянные.Получить(Предмет);
		Если ПричинаОтсева <> Неопределено Тогда
			УчестьПричинуОтсева(ПричинаОтсева, СчётчикиСтартов);
			Продолжить;
		КонецЕсли;

		КонтекстТриггера = КонтекстСтарта(Отсев, Предмет, ПользовательРеф);
		Попытка
			Результат = ar_RuntimeЗапуск.СтартоватьВФоне(СтрокаАгента.Агент, КонтекстТриггера);
		Исключение
			// Сбой одного кандидата не роняет тик (спека п.4.4: отказ старта -
			// лог, переход к следующему); полный стек - в журнал регистрации.
			СбойСтартаКандидата(СтрокаАгента.Агент, Предмет);
			Продолжить;
		КонецПопытки;
		Если Результат.Успех Тогда
			СчётчикиСтартов.Стартовано = СчётчикиСтартов.Стартовано + 1;
			ЗафиксироватьСтартПоИстекшемуСроку(КонтекстТриггера, СтрокаАгента,
				Предмет, Отсев, Результат.RunId);
		ИначеЕсли Результат.Причина = "global_limit_reached" Тогда
			СостояниеТика.ОбщийЛимитИсчерпан = Истина;
			Прервать;
		ИначеЕсли Результат.Причина = "agent_already_running" Тогда
			Прервать;
		Иначе
			УчестьОтказСтарта(СтрокаАгента, Предмет, Результат, СчётчикиСтартов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Событие deadline_expired_start (спека п.8): RunId нового запуска и причина
// предыдущего снятия. Пишется после успешного старта - RunId известен только
// тогда (ar_RuntimeЗапуск.СтартоватьВФоне возвращает его при успехе).
//
// Параметры:
//  КонтекстТриггера - Структура - контекст удачного старта (Триггер и др.).
//  СтрокаАгента     - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  Предмет          - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет удачного старта.
//  Отсев            - Структура - {Отсеянные, ПоследниеПричины}.
//  RunId            - Строка - идентификатор нового запуска.
//
Процедура ЗафиксироватьСтартПоИстекшемуСроку(Знач КонтекстТриггера, Знач СтрокаАгента,
	Знач Предмет, Знач Отсев, Знач RunId)

	Если КонтекстТриггера.Триггер <> "deadline_expired" Тогда
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "deadline_expired_start",
		СтрШаблон("Агент=%1; Предмет=%2; RunId=%3; ПричинаПредыдущегоСнятия=%4",
			Строка(СтрокаАгента.Агент), Строка(Предмет), RunId,
			Отсев.ПоследниеПричины.Получить(Предмет)),
		"Информация", RunId, Предмет);

КонецПроцедуры

// Зачесть отсеянный кандидат в счётчики тика по причине отсева
// ("captured_self" / "captured_queue_peer" / "excluded").
//
// Параметры:
//  ПричинаОтсева   - Строка - причина отсева кандидата.
//  СчётчикиСтартов - Структура - {Стартовано, Себе, Соседом, Исключённым}
//                    (заполняется).
//
Процедура УчестьПричинуОтсева(Знач ПричинаОтсева, СчётчикиСтартов)

	СчётчикиСтартов.Себе = СчётчикиСтартов.Себе
		+ ?(ПричинаОтсева = "captured_self", 1, 0);
	СчётчикиСтартов.Соседом = СчётчикиСтартов.Соседом
		+ ?(ПричинаОтсева = "captured_queue_peer", 1, 0);
	СчётчикиСтартов.Исключённым = СчётчикиСтартов.Исключённым
		+ ?(ПричинаОтсева = "excluded", 1, 0);

КонецПроцедуры

// Учёт отказа старта: отказы захвата идут в счётчики отсева (гонка между
// отсевом и стартом), прочие причины - в журнал queue_start_failed.
//
Процедура УчестьОтказСтарта(Знач СтрокаАгента, Знач Предмет, Знач Результат,
	СчётчикиСтартов)

	Если СтрНачинаетсяС(Результат.Причина, "subject_captured") Тогда
		СчётчикиСтартов.Себе = СчётчикиСтартов.Себе
			+ ?(Результат.Причина = "subject_captured", 1, 0);
		СчётчикиСтартов.Соседом = СчётчикиСтартов.Соседом
			+ ?(Результат.Причина = "subject_captured_by_queue_peer", 1, 0);
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_start_failed",
		СтрШаблон("Агент=%1; Предмет=%2; Причина=%3",
			Строка(СтрокаАгента.Агент), Строка(Предмет), Результат.Причина),
		"Предупреждение", Результат.RunId, Предмет);

КонецПроцедуры

// Кандидаты пакета с отсевом (шаги 2-3.5 тика): выборка ar_ОбъектыКОбработке,
// отсев занятых/исключённых/на паузе одним запросом к регистру (фасад) и отсев
// вне состава ar_ПрикладнойОбъект. Сбой этапа записан (СбойЭтапаТика,
// queue_source_failed) - возвращается Неопределено.
//
// Параметры:
//  СтрокаАгента - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  ЛимитВыборки - Число - сколько кандидатов запросить у пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - {Кандидаты - Массив (только поддерживаемые типы),
//  Отсев - Структура {Отсеянные, ПоследниеПричины}, ВсегоВыборки - Число (сколько
//  отдал пакет)}; Неопределено - сбой этапа.
//
Функция ОтобратьКандидатов(Знач СтрокаАгента, Знач ЛимитВыборки)

	ВыборкаПакета = КандидатыПакета(СтрокаАгента, ЛимитВыборки);
	Если ВыборкаПакета = Неопределено Тогда
		Возврат Неопределено; // queue_source_failed уже записан
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("ВсегоВыборки", ВыборкаПакета.Количество());
	Отбор.Вставить("Кандидаты", Новый Массив);
	Отбор.Вставить("Отсев", Новый Структура("Отсеянные, ПоследниеПричины",
		Новый Соответствие, Новый Соответствие));
	Если ВыборкаПакета.Количество() = 0 Тогда
		Возврат Отбор;
	КонецЕсли;

	// Отсев занятых/исключённых одним запросом к регистру (фасад). Сбой этапа
	// не роняет тик: тик продолжается по следующим агентам, место сбоя
	// зафиксировано (см. СбойЭтапаТика - диагностика «Непредвиденная ошибка»
	// без стека, доработки verify-20261008 п. 6).
	Попытка
		Отбор.Отсев = ar_AuditЗащищённыйРежим.ОтсеятьКандидатыОчередиПривилегированно(
			СтрокаАгента.Агент, СтрокаАгента.ПакетИсточник, ВыборкаПакета);
	Исключение
		СбойЭтапаТика("отсев кандидатов", СтрокаАгента.Агент);
		Возврат Неопределено;
	КонецПопытки;

	// Кандидаты вне состава определяемого типа ar_ПрикладнойОбъект не
	// стартуют (спека agentrunner-46 п.3).
	Попытка
		Отбор.Кандидаты = ОтсеятьКандидатовВнеСостава(СтрокаАгента, ВыборкаПакета);
	Исключение
		СбойЭтапаТика("отсев вне состава", СтрокаАгента.Агент);
		Возврат Неопределено;
	КонецПопытки;

	Возврат Отбор;

КонецФункции

// Число кандидатов, доступных к старту: поддерживаемый тип и не отсеяны
// (agentrunner-444, п. 10).
//
// Параметры:
//  Отбор - Структура - результат ОтобратьКандидатов.
//
// Возвращаемое значение:
//  Число - количество доступных кандидатов.
//
Функция ЧислоДоступных(Знач Отбор)

	Доступно = 0;
	Для Каждого Предмет Из Отбор.Кандидаты Цикл
		Если Отбор.Отсев.Отсеянные.Получить(Предмет) = Неопределено Тогда
			Доступно = Доступно + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Доступно;

КонецФункции

// Предупреждение queue_all_filtered (agentrunner-444, п. 10): полная выборка пакета
// отсеяна целиком - очередь стоит до сброса сбоев оператором или освобождения
// предметов. Пишется в служебный лог не чаще ПаузаПульса по агенту (как
// queue_source_failed - по последней записи журнала).
//
// Параметры:
//  СтрокаАгента - Структура - {Агент, ...}.
//  Отбор        - Структура - результат ОтобратьКандидатов.
//  НачалоТика   - Дата - момент начала тика.
//
Процедура ПредупредитьОтсеянаВсяВыборка(Знач СтрокаАгента, Знач Отбор, Знач НачалоТика)

	Если ЕстьЗаписьЖурналаМоложе(СтрокаАгента.Агент, "queue_all_filtered", НачалоТика - ПаузаПульса()) Тогда
		Возврат;
	КонецЕсли;

	Причины = Новый Соответствие;
	Для Каждого ЭлементОтсева Из Отбор.Отсев.Отсеянные Цикл
		ЧислоПоПричине = Причины.Получить(ЭлементОтсева.Значение);
		Причины.Вставить(ЭлементОтсева.Значение, ?(ЧислоПоПричине = Неопределено, 0, ЧислоПоПричине) + 1);
	КонецЦикла;
	ЧастиТекста = Новый Массив;
	Для Каждого ЭлементПричины Из Причины Цикл
		ЧастиТекста.Добавить(СтрШаблон("%1=%2", ЭлементПричины.Ключ, ЭлементПричины.Значение));
	КонецЦикла;
	ЧастиТекста.Добавить(СтрШаблон("unsupported_type=%1", Отбор.ВсегоВыборки - Отбор.Кандидаты.Количество()));

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_all_filtered",
		СтрШаблон("Агент=%1; Выборка=%2; %3", Строка(СтрокаАгента.Агент), Отбор.ВсегоВыборки,
			СтрСоединить(ЧастиТекста, "; ")),
		"Предупреждение", "", СтрокаАгента.Агент);

КонецПроцедуры

// Есть ли по агенту запись служебного лога диспетчера с событием моложе границы
// (agentrunner-444, п. 10: ограничение частоты queue_all_filtered).
//
// Параметры:
//  СсылкАгент - СправочникСсылка.ar_Агенты - агент очереди.
//  Событие    - Строка - код события журнала.
//  Граница    - Дата - записи позже границы считаются свежими.
//
// Возвращаемое значение:
//  Булево - Истина, если свежая запись есть.
//
Функция ЕстьЗаписьЖурналаМоложе(Знач СсылкАгент, Знач Событие, Знач Граница)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Момент КАК Момент
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_ОбъектСсылка = &ОбъектСсылка
		|	И Лог.ar_Момент > &Граница
		|	И Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие";
	Запрос.УстановитьПараметр("ОбъектСсылка", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкАгент));
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Источник", ИмяИсточникаЛога());
	Запрос.УстановитьПараметр("Событие", Событие);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Отсеять кандидатов очереди, чей тип вне состава определяемого типа
// ar_ПрикладнойОбъект (спека agentrunner-46 п.3): такие предметы не стартуют.
// Предупреждение queue_subject_type_not_supported - не чаще раза в 30 минут
// по агенту и типу (как queue_source_failed): текст записи стабилен -
// "Агент=%1; Тип=%2", свежие тексты из журнала глушат повтор.
//
// Параметры:
//  СтрокаАгента - Структура - {Агент, ПакетИсточник, ЛимитЗапусков}.
//  Кандидаты    - Массив - ссылки-кандидаты от пакета.
//
// Возвращаемое значение:
//  Массив - кандидаты, чей тип входит в ОпределяемыйТип.ar_ПрикладнойОбъект.
//
Функция ОтсеятьКандидатовВнеСостава(Знач СтрокаАгента, Знач Кандидаты)

	Поддержанные = Новый Массив;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Поддержанные;
	КонецЕсли;

	СвежиеТексты = СвежиеТекстыПредупрежденийОТипе(СтрокаАгента.Агент);

	Для Каждого Предмет Из Кандидаты Цикл
		Если ar_ПредметыАгентов.ТипПредметаПоддерживается(Предмет) Тогда
			Поддержанные.Добавить(Предмет);
			Продолжить;
		КонецЕсли;
		ТекстЗаписи = СтрШаблон("Агент=%1; Тип=%2",
			Строка(СтрокаАгента.Агент), ИмяТипаПредмета(ТипЗнч(Предмет)));
		Если СвежиеТексты.Получить(ТекстЗаписи) = Неопределено Тогда
			СвежиеТексты.Вставить(ТекстЗаписи, Истина);
			ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_subject_type_not_supported",
				ТекстЗаписи, "Предупреждение", "", СтрокаАгента.Агент);
		КонецЕсли;
	КонецЦикла;

	Возврат Поддержанные;

КонецФункции

// Тексты queue_subject_type_not_supported по агенту за окно тишины (30 минут)
// - ОДИН запрос на тик, без запросов в цикле по кандидатам.
//
// Параметры:
//  СсылкАгент - СправочникСсылка.ar_Агенты - агент очереди.
//
// Возвращаемое значение:
//  Соответствие - "Текст записи -> Истина" (для проверки вхождения за O(1)).
//
Функция СвежиеТекстыПредупрежденийОТипе(Знач СсылкАгент)

	Запрос = Новый Запрос;
	// Без РАЗЛИЧНЫХ: ar_Текст - строка неограниченной длины, группировка по ней
	// падает ошибкой СУБД на каждом тике с непустой очередью; дубликаты снимает
	// соответствие ниже.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Лог.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|	И Лог.ar_ОбъектСсылка = &ОбъектСсылка
		|	И Лог.ar_Момент > &Граница";
	Запрос.УстановитьПараметр("Источник", ИмяИсточникаЛога());
	Запрос.УстановитьПараметр("Событие", "queue_subject_type_not_supported");
	Запрос.УстановитьПараметр("ОбъектСсылка", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкАгент));
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - ПаузаСбоевИсточника());

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Текст, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Полное имя объекта метаданных по типу значения (для текста предупреждения);
// для типа без объекта метаданных - представление типа.
//
// Параметры:
//  ТипЗначения - Тип - тип значения-предмета.
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных ("Справочник.Контрагенты").
//
Функция ИмяТипаПредмета(Знач ТипЗначения)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Строка(ТипЗначения);
	КонецЕсли;

	Возврат ОбъектМетаданных.ПолноеИмя();

КонецФункции

// Итог тика по агенту в журнал (queue_tick): слоты, кандидаты, отсеяно по
// причинам (self / queue_peer / excluded), стартовано, длительность мс.
//
Процедура ЗаписатьИтогТика(Знач СтрокаАгента, Знач Кандидаты, Знач СвободноСлотов,
	Знач СчётчикиСтартов, Знач НачалоТика)

	ДлительностьМс = Окр((ТекущаяДатаСеанса() - НачалоТика) * 1000);
	ТекстТика = СтрШаблон(
		"Слотов=%1; Кандидатов=%2; ОтсеяноСебе=%3; ОтсеяноQueuePeer=%4; "
			+ "ОтсеяноExcluded=%5; Стартовано=%6; ДлительностьМс=%7",
		СвободноСлотов,
		Кандидаты.Количество(),
		СчётчикиСтартов.Себе,
		СчётчикиСтартов.Соседом,
		СчётчикиСтартов.Исключённым,
		СчётчикиСтартов.Стартовано,
		ДлительностьМс);
	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_tick", ТекстТика,
		"Информация", "", СтрокаАгента.Агент);

КонецПроцедуры

// Пульс очереди: итог тика без стартов (очередь пуста или все кандидаты
// отсеяны) пишется тем же событием queue_tick, но не чаще раза в ПаузаПульса
// по агенту - консоль (блок очереди, «Последний тик») показывает, что очередь
// опрашивается. Момент последнего тика - СтрокаАгента.ПоследнийТикМомент
// (ЗаполнитьПоследниеТики, один запрос на тик); Неопределено - моменты
// не прочитаны, пульс не пишется.
//
// Параметры: см. ЗаписатьИтогТика.
//
Процедура ЗаписатьПульсТика(Знач СтрокаАгента, Знач Кандидаты, Знач СвободноСлотов,
	Знач СчётчикиСтартов, Знач НачалоТика)

	ПоследнийТикМомент = СтрокаАгента.ПоследнийТикМомент;
	Если ТипЗнч(ПоследнийТикМомент) <> Тип("Дата")
		Или ПоследнийТикМомент > НачалоТика - ПаузаПульса() Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьИтогТика(СтрокаАгента, Кандидаты, СвободноСлотов, СчётчикиСтартов, НачалоТика);

КонецПроцедуры

// Моменты последних queue_tick агентов очереди одним запросом (фасад консоли
// ar_AuditЗащищённыйРежим.ПоследниеТикиОчередиПривилегированно): заполняет
// ПоследнийТикМомент в строках агентов; агент без записей - пустая дата
// (пульс пишется сразу).
//
// Параметры:
//  Агенты - Массив - структуры агентов очереди (см. АгентыОчереди).
//
Процедура ЗаполнитьПоследниеТики(Агенты)

	Если Агенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СсылкиАгентов = Новый Массив;
	Для Каждого СтрокаАгента Из Агенты Цикл
		СсылкиАгентов.Добавить(СтрокаАгента.Агент);
	КонецЦикла;

	ПоследниеТики = ar_AuditЗащищённыйРежим.ПоследниеТикиОчередиПривилегированно(СсылкиАгентов);

	Для Каждого СтрокаАгента Из Агенты Цикл
		ДанныеТика = ПоследниеТики.Получить(СтрокаАгента.Агент);
		СтрокаАгента.ПоследнийТикМомент = ?(ДанныеТика = Неопределено, Дата(1, 1, 1), ДанныеТика.Момент);
	КонецЦикла;

КонецПроцедуры

// Нулевые счётчики стартов тика.
//
// Возвращаемое значение:
//  Структура - {Стартовано, Себе, Соседом, Исключённым}.
//
Функция НовыеСчетчикиСтартов()

	Возврат Новый Структура("Стартовано, Себе, Соседом, Исключённым", 0, 0, 0, 0);

КонецФункции

// Агенты очереди одним запросом: активны, берут из очереди пакета, пакет
// заполнен. Лимит запусков - потолок агента (0/пусто как 1, не выше SCHED-05).
//
// Возвращаемое значение:
//  Массив структур {Агент, ПакетИсточник, ЛимитЗапусков, ПоследнийТикМомент};
//  ПоследнийТикМомент - Неопределено до ЗаполнитьПоследниеТики.
//
Функция АгентыОчереди()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Агент,
		|	Агенты.ar_ПакетИсточник КАК ПакетИсточник,
		|	Агенты.ar_МаксПараллельныхЗапусков КАК МаксПараллельныхЗапусков
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.ar_Активен
		|	И Агенты.ar_БратьИзОчередиПакета
		|	И Агенты.ar_ПакетИсточник <> """"";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Агент, ПакетИсточник, ЛимитЗапусков, ПоследнийТикМомент",
			Выборка.Агент,
			СокрЛП(Выборка.ПакетИсточник),
			ar_ПредметыАгентов.ЛимитЗапусковПоРеквизиту(Выборка.МаксПараллельныхЗапусков),
			Неопределено));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кандидаты от пакета: запись реестра по ar_Namespace (зарегистрирован),
// объект пакета, вызов ar_ОбъектыКОбработке(Агент, Лимит). Любая ошибка -
// лог queue_source_failed (с ограничением частоты) и Неопределено.
//
// Возвращаемое значение:
//  Массив ссылок; Неопределено - пакет недоступен (источник очереди сломан).
//
Функция КандидатыПакета(Знач СтрокаАгента, Знач ЛимитВыборки)

	ИдентификаторОбработки = ИдентификаторПакетаПоNamespace(СтрокаАгента.ПакетИсточник);
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("пакет по namespace '%1' не найден в реестре", СтрокаАгента.ПакетИсточник));
		Возврат Неопределено;
	КонецЕсли;

	ОбъектПакета = ar_ИнструментыДиспетчерПовтИсп.ОбъектПакета(ИдентификаторОбработки);
	Если ОбъектПакета = Неопределено Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("объект пакета '%1' не создан", ИдентификаторОбработки));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Кандидаты = ОбъектПакета.ar_ОбъектыКОбработке(СтрокаАгента.Агент, ЛимитВыборки);
	Исключение
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("ошибка вызова ar_ОбъектыКОбработке: %1",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Кандидаты) <> Тип("Массив") Тогда
		ЗаписатьСбойИсточника(СтрокаАгента.Агент,
			СтрШаблон("ar_ОбъектыКОбработке вернула %1 вместо Массив", ТипЗнч(Кандидаты)));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кандидаты;

КонецФункции

// Контекст старта для кандидата (спека п.4.4): обычный тик - триггер queue;
// если последняя причина снятия по паре - question_expired (предыдущий
// вопрос остался без ответа), триггер deadline_expired и добавка инструкции.
// Событие deadline_expired_start пишется не здесь, а после успешного старта
// (СтартоватьКандидаты) - спека п.8 требует в нём RunId нового запуска.
//
// Параметры:
//  Отсев            - Структура - {Отсеянные, ПоследниеПричины}.
//  Предмет          - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет-кандидат
//                     (кандидаты вне состава отсеиваются до старта).
//  ПользовательРеф  - СправочникСсылка.Пользователи - инициатор (как для cron).
//
// Возвращаемое значение:
//  Структура - {Триггер, ЯкорьСсылка, ПользовательРеф, ИнструкцияДобавка*}.
//
Функция КонтекстСтарта(Знач Отсев, Знач Предмет, Знач ПользовательРеф)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "queue");
	КонтекстТриггера.Вставить("ЯкорьСсылка", Предмет);
	КонтекстТриггера.Вставить("ПользовательРеф", ПользовательРеф);

	Если Отсев.ПоследниеПричины.Получить(Предмет) = "question_expired" Тогда
		КонтекстТриггера.Вставить("Триггер", "deadline_expired");
		КонтекстТриггера.Вставить("ИнструкцияДобавка",
			НСтр("ru='Предыдущий вопрос по этому объекту остался без ответа -
				|срок ответа истёк. Действуй по своему регламенту для истёкшего срока.';
				|en='The previous question about this object was left unanswered -
				|the answer deadline has expired. Follow your regulation for expired deadlines.'"));
	КонецЕсли;

	Возврат КонтекстТриггера;

КонецФункции

// Идентификатор обработки зарегистрированного пакета по пространству имён.
//
// Возвращаемое значение:
//  Строка - ar_ИдентификаторОбработки; "" если пакета нет или он не активен.
//
Функция ИдентификаторПакетаПоNamespace(Знач Namespace)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыИнструментов КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace = &Namespace
		|	И Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")";
	Запрос.УстановитьПараметр("Namespace", Namespace);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ИдентификаторОбработки);
	КонецЕсли;

	Возврат "";

КонецФункции

// Лог queue_source_failed с ограничением частоты: не чаще раза в 30 минут по
// агенту и тексту ошибки (спека п.8; память модуля между тиками не сохраняется
// - граница берётся из последней записи журнала с Объект = агент; смена текста
// ошибки логируется сразу).
//
Функция ЗаписатьСбойИсточника(Знач СсылкАгент, Знач ТекстСбоя)

	ТекстЗаписи = СтрШаблон("Агент=%1; %2", Строка(СсылкАгент), ТекстСбоя);

	Если ПоследнийСбойМоложе(СсылкАгент, ТекстЗаписи) Тогда
		Возврат Ложь;
	КонецЕсли;

	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_source_failed",
		ТекстЗаписи, "Ошибка", "", СсылкАгент);

	Возврат Истина;

КонецФункции

// Есть ли запись queue_source_failed с тем же текстом по агенту моложе паузы
// (30 минут); запись с другим текстом (сменилась причина сбоя) не глушится.
//
// Параметры:
//  СсылкАгент  - СправочникСсылка.ar_Агенты - агент очереди.
//  ТекстЗаписи - Строка - полный текст записи журнала (для сравнения).
//
// Возвращаемое значение:
//  Булево - Истина, если свежая запись с тем же текстом уже есть.
//
Функция ПоследнийСбойМоложе(Знач СсылкАгент, Знач ТекстЗаписи)

	// Граница по моменту в запросе (agentrunner-434): без неё последняя запись
	// по агенту искалась сортировкой всего журнала; запись старше границы и
	// раньше давала Ложь - результат не меняется.
	Граница = ТекущаяДатаСеанса() - ПаузаСбоевИсточника();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лог.ar_Текст КАК ПоследнийТекст
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_ОбъектСсылка = &ОбъектСсылка
		|	И Лог.ar_Момент > &Граница
		|	И Лог.ar_Источник = &Источник
		|	И Лог.ar_Событие = &Событие
		|УПОРЯДОЧИТЬ ПО
		|	Лог.ar_Момент УБЫВ";
	Запрос.УстановитьПараметр("ОбъектСсылка", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкАгент));
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Источник", ИмяИсточникаЛога());
	Запрос.УстановитьПараметр("Событие", "queue_source_failed");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Выборка.ПоследнийТекст = ТекстЗаписи;

КонецФункции

// Ошибка блока тика диспетчера - журнал регистрации (паттерн ar_Планировщик).
//
// Диагностика сбоя этапа тика (доработки verify-20261008 п.6): событие
// queue_stage_failed в ar_СлужебныйЛог (агент, этап, краткий текст) и запись
// журнала регистрации с полным стеком - платформа отдаёт «Непредвиденная
// ошибка» без места сбоя, этапные записи локализуют его по последнему этапу.
//
// Параметры:
//  Этап       - Строка - имя этапа тика ("отсев кандидатов", "старт кандидатов").
//  СсылкАгент - СправочникСсылка.ar_Агенты - агент, на котором упал этап.
//
Процедура СбойЭтапаТика(Знач Этап, Знач СсылкАгент)

	Информация = ИнформацияОбОшибке();
	ТекстСобытия = СтрШаблон("Агент=%1; Этап=%2; %3", Строка(СсылкАгент), Этап,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_stage_failed",
		ТекстСобытия, "Ошибка", "", СсылкАгент);
	ТекстЗаписи = СтрШаблон("Сбой этапа тика «%1» (агент %2): %3", Этап,
		Строка(СсылкАгент), ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_ДиспетчерОчереди'; en='ar_QueueDispatcher'"),
		УровеньЖурналаРегистрации.Ошибка, , , ТекстЗаписи);

КонецПроцедуры

// Диагностика сбоя старта одного кандидата (спека п.4.4): queue_start_failed
// в ar_СлужебныйЛог и полный стек в журнал регистрации - по предмету видно,
// какой кандидат и какой вызов упал.
//
// Параметры:
//  СсылкАгент - СправочникСсылка.ar_Агенты - агент старта.
//  Предмет    - ОпределяемыйТип.ar_ПрикладнойОбъект - кандидат старта.
//
Процедура СбойСтартаКандидата(Знач СсылкАгент, Знач Предмет)

	Информация = ИнформацияОбОшибке();
	ТекстСобытия = СтрШаблон("Агент=%1; Предмет=%2; Причина=%3", Строка(СсылкАгент),
		Строка(Предмет), ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
	ar_СлужебныйЛог.Записать(ИмяИсточникаЛога(), "queue_start_failed",
		ТекстСобытия, "Предупреждение", "", Предмет);
	ТекстЗаписи = СтрШаблон("Сбой старта по кандидату %1 (агент %2): %3",
		Строка(Предмет), Строка(СсылкАгент),
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_ДиспетчерОчереди'; en='ar_QueueDispatcher'"),
		УровеньЖурналаРегистрации.Предупреждение, , , ТекстЗаписи);

КонецПроцедуры

Процедура ЗаписатьОшибкуТика(Знач ЧтоУпало)

	ТекстОшибки = СтрШаблон(
		НСтр("ru='Ошибка диспетчера очереди (%1): %2';
			|en='Queue dispatcher error (%1): %2'"),
		ЧтоУпало,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_ДиспетчерОчереди'; en='ar_QueueDispatcher'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);

КонецПроцедуры

