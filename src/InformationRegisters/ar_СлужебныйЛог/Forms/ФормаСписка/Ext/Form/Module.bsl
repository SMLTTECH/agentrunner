////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра сведений ar_СлужебныйЛог (agentrunner-53, п.7.1;
// открытый период и новые отборы - agentrunner-209) - основная форма списка
// регистра (DefaultListForm).
//
// Динамический список строится произвольным запросом к регистру; отборы
// вынесены в параметры запроса: период, уровень (по умолчанию - все, кроме
// отладочных записей), источник, событие (подстрока, а при наличии запятой -
// список событий через запятую с точным совпадением), объект (подстрока
// навигационной ссылки), текст (подстрока ar_Текст; поле неограниченной
// длины - поиск по первым 1024 символам) и запуск (RunId). Сортировка -
// по ar_Момент по убыванию (свежие записи сверху).
//
// Период: быстрый выбор «15 минут», «Час», «Сутки» (по умолчанию), «Неделя»,
// «Произвольный» - значения реквизита ОтборБыстрыйПериод, списка выбора поля
// «Период» и параметра формы БыстрыйПериод. Для быстрых периодов начало
// пересчитывается от текущей даты сеанса при каждом пересчете параметров
// списка (открытие формы, смена любого отбора, команда «Обновить»), конец
// не ограничен - записи, попавшие в лог после открытия формы, видны по
// «Обновить». Ручное изменение «Период с»/«Период по» переключает период на
// «Произвольный»; пустое «Период по» означает «без ограничения».
//
// Над списком - сводка «Найдено записей: N. Период: ...»: количество
// считается отдельным запросом КОЛИЧЕСТВО(*) с теми же условиями, что у
// списка, в одном серверном вызове вместе с установкой параметров списка
// (УстановитьПараметрыСписка). Условия запроса количества повторяют запрос
// динамического списка (QueryText в Form.xml) - при изменении условий
// обновлять оба места.
//
// Форма принимает параметры Уровень / ПериодНачало / ПериодОкончание /
// Источник / Событие / Запуск (контракт консоли агентов, agentrunner-53,
// п.5.3; Событие допускает список через запятую) и новые необязательные
// Объект / Текст / БыстрыйПериод. Переданные ПериодНачало / ПериодОкончание
// переключают период на «Произвольный» (если передан только «ПериодНачало»,
// конец не ограничен); параметр БыстрыйПериод применяется последним и
// отменяет это переключение. Незаполненные параметры игнорируются, действуют
// значения по умолчанию.
//
// Из строки с заполненным ar_RunId - переход в просмотр запуска
// (ОбщаяФорма.ar_ПросмотрЗапуска, параметр ИдентификаторЗапуска); команда
// «Отбор по объекту строки» (контекстное меню списка) подставляет
// навигационную ссылку объекта строки в отбор «Объект».
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Инициализация формы: значения отборов по умолчанию, затем значения из
// параметров формы (пустые игнорируются), затем параметры запроса
// динамического списка и сводка.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьОтборыПоУмолчанию();
	ПрименитьПараметрыФормы();
	УстановитьПараметрыСписка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Смена быстрого периода - пересчет параметров запроса списка: вычисленное
// начало показывается в «Период с», «Период по» очищается.
&НаКлиенте
Процедура ОтборБыстрыйПериодПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Ручное изменение начала периода - быстрый период переключается на
// «Произвольный», пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборПериодНачалоПриИзменении(Элемент)

	ОтборБыстрыйПериод = "Произвольный";
	УстановитьПараметрыСписка();

КонецПроцедуры

// Ручное изменение окончания периода - быстрый период переключается на
// «Произвольный», пересчет параметров запроса списка. Пустое значение
// означает «без ограничения».
&НаКлиенте
Процедура ОтборПериодОкончаниеПриИзменении(Элемент)

	ОтборБыстрыйПериод = "Произвольный";
	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена уровня отбора - пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборУровеньПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена источника отбора - пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборИсточникПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена события - пересчет параметров запроса списка: подстрока или список
// событий через запятую (точное совпадение).
&НаКлиенте
Процедура ОтборСобытиеПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена подстроки объекта - пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборОбъектПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена подстроки текста - пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборТекстПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена идентификатора запуска - пересчет параметров запроса списка.
&НаКлиенте
Процедура ОтборЗапускПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда «Обновить»: пересчет параметров запроса списка (в том числе начала
// быстрого периода - от текущей даты сеанса) и сводки, затем перечитывание
// списка - записи, записанные в лог после открытия формы, становятся видны.
&НаКлиенте
Процедура ОбновитьСписок(Команда)

	УстановитьПараметрыСписка();
	Элементы.Список.Обновить();

КонецПроцедуры

// Команда «Отбор по объекту строки» (контекстное меню списка): подставляет
// навигационную ссылку объекта текущей строки в отбор «Объект» и
// пересчитывает список. Строка без объекта - без действия.
&НаКлиенте
Процедура ОтборПоОбъектуСтроки(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ar_ОбъектСсылка) Тогда
		Возврат;
	КонецЕсли;

	ОтборОбъект = ТекущиеДанные.ar_ОбъектСсылка;
	УстановитьПараметрыСписка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

// Нажатие на ссылку "Запуск" в строке списка - открытие просмотра запуска.
// Строка без заполненного идентификатора запуска перехода не выполняет.
//
// Параметры:
//   Элемент - ПолеФормы - колонка ar_RunId таблицы списка.
//   СтандартнаяОбработка - Булево - отключается, переход выполняет форма.
//
&НаКлиенте
Процедура ЗапускСтрокиНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ar_RunId) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("ИдентификаторЗапуска", ТекущиеДанные.ar_RunId);

	Попытка
		ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска", ПараметрыОткрытия, ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Форма просмотра запуска недоступна.';
			|en = 'The run viewer form is unavailable.'"));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значения отборов по умолчанию (agentrunner-53, п.7.1; agentrunner-209):
// быстрый период «Сутки» с неограниченным концом (начало пересчитывается при
// каждом пересчете параметров списка), все уровни, кроме отладочных;
// источник, событие, объект, текст и запуск не ограничены.
&НаСервере
Процедура УстановитьОтборыПоУмолчанию()

	ОтборБыстрыйПериод = "Сутки";
	ОтборПериодНачало = ТекущаяДатаСеанса() - СекундыБыстрогоПериода(ОтборБыстрыйПериод);
	ОтборПериодОкончание = Дата(1, 1, 1);
	ОтборУровень = "";
	ОтборИсточник = "";
	ОтборСобытие = "";
	ОтборОбъект = "";
	ОтборТекст = "";
	ОтборЗапуск = "";

КонецПроцедуры

// Подставляет значения параметров формы в отборы: незаполненные значения
// игнорируются, действуют значения по умолчанию. Имена параметров - контракт
// вызова формы (agentrunner-53, п.5.3; agentrunner-209 добавил Объект, Текст
// и БыстрыйПериод). Переданные границы периода переключают быстрый период на
// «Произвольный»; БыстрыйПериод применяется последним и отменяет это
// переключение.
&НаСервере
Процедура ПрименитьПараметрыФормы()

	УровеньПараметра = СтроковыйПараметрФормы(Параметры, "Уровень");
	Если Не ПустаяСтрока(УровеньПараметра) Тогда
		ОтборУровень = УровеньПараметра;
	КонецЕсли;

	ПериодНачалоПараметра = ДатаПараметраФормы(Параметры, "ПериодНачало");
	Если ПериодНачалоПараметра <> Неопределено Тогда
		ОтборПериодНачало = ПериодНачалоПараметра;
		ОтборБыстрыйПериод = "Произвольный";
	КонецЕсли;

	ПериодОкончаниеПараметра = ДатаПараметраФормы(Параметры, "ПериодОкончание");
	Если ПериодОкончаниеПараметра <> Неопределено Тогда
		ОтборПериодОкончание = ПериодОкончаниеПараметра;
		ОтборБыстрыйПериод = "Произвольный";
	КонецЕсли;

	ИсточникПараметра = СтроковыйПараметрФормы(Параметры, "Источник");
	Если Не ПустаяСтрока(ИсточникПараметра) Тогда
		ОтборИсточник = ИсточникПараметра;
	КонецЕсли;

	СобытиеПараметра = СтроковыйПараметрФормы(Параметры, "Событие");
	Если Не ПустаяСтрока(СобытиеПараметра) Тогда
		ОтборСобытие = СобытиеПараметра;
	КонецЕсли;

	ОбъектПараметра = СтроковыйПараметрФормы(Параметры, "Объект");
	Если Не ПустаяСтрока(ОбъектПараметра) Тогда
		ОтборОбъект = ОбъектПараметра;
	КонецЕсли;

	ТекстПараметра = СтроковыйПараметрФормы(Параметры, "Текст");
	Если Не ПустаяСтрока(ТекстПараметра) Тогда
		ОтборТекст = ТекстПараметра;
	КонецЕсли;

	ЗапускПараметра = СтроковыйПараметрФормы(Параметры, "Запуск");
	Если Не ПустаяСтрока(ЗапускПараметра) Тогда
		ОтборЗапуск = ЗапускПараметра;
	КонецЕсли;

	БыстрыйПериодПараметра = СтроковыйПараметрФормы(Параметры, "БыстрыйПериод");
	Если ЭтоБыстрыйПериод(БыстрыйПериодПараметра) Или БыстрыйПериодПараметра = "Произвольный" Тогда
		ОтборБыстрыйПериод = БыстрыйПериодПараметра;
	КонецЕсли;

КонецПроцедуры

// Переносит текущие значения отборов в параметры произвольного запроса
// динамического списка и обновляет сводку над списком. Для быстрого периода
// начало пересчитывается от текущей даты сеанса, конец не ограничен
// (МаксимальныйМомент), вычисленные границы показываются в полях периода;
// для «Произвольного» пустое «Период по» тоже означает «без ограничения».
// Вызывается при создании формы, из обработчиков изменения полей отбора и из
// команды «Обновить»: установка параметров и подсчет записей для сводки
// выполняются одним серверным вызовом.
&НаСервере
Процедура УстановитьПараметрыСписка()

	Если ОтборБыстрыйПериод = "Произвольный" Тогда
		НачалоПериода = ?(ЗначениеЗаполнено(ОтборПериодНачало), ОтборПериодНачало, Дата(1, 1, 1));
		КонецПериода = ?(ЗначениеЗаполнено(ОтборПериодОкончание), ОтборПериодОкончание, МаксимальныйМомент());
	Иначе
		НачалоПериода = ТекущаяДатаСеанса() - СекундыБыстрогоПериода(ОтборБыстрыйПериод);
		КонецПериода = МаксимальныйМомент();
		ОтборПериодНачало = НачалоПериода;
		ОтборПериодОкончание = Дата(1, 1, 1);
	КонецЕсли;

	// Экранирование спецсимволов ПОДОБНО (%, _, [, ], ~) через БСП; пустой
	// отбор дает пустую маску - соответствующее условие отключается в запросе.
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("УровеньЗаписи", ОтборУровень);
	ПараметрыОтбора.Вставить("ИсточникЗаписи", ОтборИсточник);
	ПараметрыОтбора.Вставить("МаскаОбъекта", МаскаПоискаПодстроки(ОтборОбъект));
	ПараметрыОтбора.Вставить("МаскаТекста", МаскаПоискаПодстроки(ОтборТекст));
	ПараметрыОтбора.Вставить("ЗапускЗаписи", ОтборЗапуск);

	// Событие: при наличии запятой - список событий (пробелы по краям
	// обрезаются, пустые отбрасываются, точное совпадение В (...)), иначе -
	// подстрока, как раньше.
	СписокСобытий = СписокСобытийОтбора(ОтборСобытие);
	СобытиеСписком = СписокСобытий.Количество() > 0;
	ПараметрыОтбора.Вставить("СобытиеСписком", СобытиеСписком);
	ПараметрыОтбора.Вставить("СписокСобытий", СписокСобытий);
	ПараметрыОтбора.Вставить("МаскаСобытия", ?(СобытиеСписком, "", МаскаПоискаПодстроки(ОтборСобытие)));

	Список.Параметры.УстановитьЗначениеПараметра("НачалоПериода", НачалоПериода);
	Список.Параметры.УстановитьЗначениеПараметра("КонецПериода", КонецПериода);
	Для Каждого КлючЗначение Из ПараметрыОтбора Цикл
		Список.Параметры.УстановитьЗначениеПараметра(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	ОбновитьСводку(НачалоПериода, КонецПериода, ПараметрыОтбора);

КонецПроцедуры

// Пересчитывает надпись-сводку над списком: количество записей запросом
// КОЛИЧЕСТВО(*) с теми же условиями, что у списка, и представление периода -
// «текущий момент» вместо неограниченного конца. Пустой список при нуле
// однозначно означает «записей с такими отборами нет».
//
// Параметры:
//   НачалоПериода - Дата - начало периода (в сводку и запрос количества).
//   КонецПериода - Дата - конец периода; МаксимальныйМомент означает
//     «без ограничения» (в сводке - «текущий момент»).
//   ПараметрыОтбора - Структура - параметры отборов запроса, те же значения,
//     что установлены в параметры динамического списка.
//
&НаСервере
Процедура ОбновитьСводку(Знач НачалоПериода, Знач КонецПериода, ПараметрыОтбора)

	Запрос = Новый Запрос(ТекстЗапросаКоличества());
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Для Каждого КлючЗначение Из ПараметрыОтбора Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Если КонецПериода >= МаксимальныйМомент() Тогда
		ПредставлениеКонца = НСтр(
			"ru = 'текущий момент';
			|en = 'current moment'");
	Иначе
		ПредставлениеКонца = Формат(КонецПериода, "ДЛФ=DT");
	КонецЕсли;

	Элементы.СводкаЗаписей.Заголовок = СтрШаблон(
		НСтр(
			"ru = 'Найдено записей: %1. Период: с %2 по %3';
			|en = 'Found records: %1. Period: from %2 to %3'"),
		Формат(Выборка.ЧислоЗаписей, "ЧГ="),
		Формат(НачалоПериода, "ДЛФ=DT"),
		ПредставлениеКонца);

КонецПроцедуры

// Длительность быстрого периода в секундах: начало периода считается от
// текущей даты сеанса минус указанное число секунд. «Произвольный», пустое и
// неизвестное значение дают 0 - период быстрым не считается.
//
// Параметры:
//   ЗначениеПериода - Строка - значение реквизита ОтборБыстрыйПериод
//   (совпадает со значениями списка выбора поля «Период»).
//
// Возвращаемое значение:
//   Число - секунд до текущего момента.
//
&НаСервереБезКонтекста
Функция СекундыБыстрогоПериода(Знач ЗначениеПериода)

	Если ЗначениеПериода = "15 минут" Тогда
		Возврат 15 * 60;
	ИначеЕсли ЗначениеПериода = "Час" Тогда
		Возврат 60 * 60;
	ИначеЕсли ЗначениеПериода = "Сутки" Тогда
		Возврат 24 * 60 * 60;
	ИначеЕсли ЗначениеПериода = "Неделя" Тогда
		Возврат 7 * 24 * 60 * 60;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

// Проверка значения быстрого периода: «15 минут», «Час», «Сутки» или
// «Неделя» (значения списка выбора поля «Период» без «Произвольного»).
//
// Параметры:
//   ЗначениеПериода - Строка - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - значение является быстрым периодом.
//
&НаСервереБезКонтекста
Функция ЭтоБыстрыйПериод(Знач ЗначениеПериода)

	Возврат СекундыБыстрогоПериода(ЗначениеПериода) > 0;

КонецФункции

// Момент, означающий «без ограничения» в условиях периода запроса:
// '39991231 23:59:59' - записей с большей датой в логе не бывает.
//
// Возвращаемое значение:
//   Дата - конец периода при неограниченном конце.
//
&НаСервереБезКонтекста
Функция МаксимальныйМомент()

	Возврат Дата(3999, 12, 31, 23, 59, 59);

КонецФункции

// Разбирает строку отбора события: при наличии запятой - список значений
// событий (пробелы по краям элементов обрезаются, пустые отбрасываются),
// без запятой - пустой список (действует поиск подстроки). Отдельная
// функция, чтобы установка параметров списка и подсчет сводки разбирали
// строку одинаково.
//
// Параметры:
//   СтрокаСобытий - Строка - значение отбора «Событие».
//
// Возвращаемое значение:
//   СписокЗначений - события для условия В (...) запроса.
//
&НаСервереБезКонтекста
Функция СписокСобытийОтбора(Знач СтрокаСобытий)

	СписокСобытий = Новый СписокЗначений;
	Если СтрНайти(СтрокаСобытий, ",") > 0 Тогда
		Для Каждого Часть Из СтрРазделить(СтрокаСобытий, ",", Ложь) Цикл
			ЗначениеСобытия = СокрЛП(Часть);
			Если ЗначениеСобытия <> "" Тогда
				СписокСобытий.Добавить(ЗначениеСобытия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СписокСобытий;

КонецФункции

// Маска ПОДОБНО для поиска подстроки в поле запроса: спецсимволы
// экранируются методом БСП (СПЕЦСИМВОЛ "~"), по краям - "%". Пустая строка
// отбора дает пустую маску - соответствующее условие запроса отключается.
//
// Параметры:
//   Подстрока - Строка - значение строкового отбора формы.
//
// Возвращаемое значение:
//   Строка - маска для параметра запроса.
//
&НаСервереБезКонтекста
Функция МаскаПоискаПодстроки(Знач Подстрока)

	Если ПустаяСтрока(Подстрока) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Подстрока) + "%";

КонецФункции

// Текст запроса количества записей для сводки: условия повторяют запрос
// динамического списка (QueryText в Form.xml) - при изменении условий
// обновлять оба места.
//
// Возвращаемое значение:
//   Строка - текст запроса КОЛИЧЕСТВО(*).
//
&НаСервереБезКонтекста
Функция ТекстЗапросаКоличества()

	Возврат
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК ЧислоЗаписей
	|ИЗ
	|	РегистрСведений.ar_СлужебныйЛог КАК СлужебныйЛог
	|ГДЕ
	|	СлужебныйЛог.ar_Момент >= &НачалоПериода
	|	И СлужебныйЛог.ar_Момент <= &КонецПериода
	|	И ВЫБОР
	|			КОГДА &УровеньЗаписи = """"
	|				ТОГДА СлужебныйЛог.ar_Уровень <> ""Отладка""
	|			ИНАЧЕ СлужебныйЛог.ar_Уровень = &УровеньЗаписи
	|		КОНЕЦ
	|	И (&ИсточникЗаписи = """" ИЛИ СлужебныйЛог.ar_Источник = &ИсточникЗаписи)
	|	И ВЫБОР
	|			КОГДА &СобытиеСписком
	|				ТОГДА СлужебныйЛог.ar_Событие В (&СписокСобытий)
	|			ИНАЧЕ &МаскаСобытия = """"
	|				ИЛИ СлужебныйЛог.ar_Событие ПОДОБНО &МаскаСобытия СПЕЦСИМВОЛ ""~""
	|		КОНЕЦ
	|	И (&МаскаОбъекта = """" ИЛИ СлужебныйЛог.ar_ОбъектСсылка ПОДОБНО &МаскаОбъекта СПЕЦСИМВОЛ ""~"")
	|	И (&МаскаТекста = """" ИЛИ ПОДСТРОКА(СлужебныйЛог.ar_Текст, 1, 1024) ПОДОБНО &МаскаТекста СПЕЦСИМВОЛ ""~"")
	|	И (&ЗапускЗаписи = """" ИЛИ СлужебныйЛог.ar_RunId = &ЗапускЗаписи)";

КонецФункции

// Значение строкового параметра формы: пустая строка, если параметр не передан
// или его значение пусто (Неопределено приводится к пустой строке).
//
// Параметры:
//   ПараметрыФормы - Структура - параметры формы (свойство Параметры).
//   ИмяПараметра - Строка - имя параметра формы.
//
// Возвращаемое значение:
//   Строка - значение параметра без пробелов по краям или пустая строка.
//
&НаСервереБезКонтекста
Функция СтроковыйПараметрФормы(ПараметрыФормы, Знач ИмяПараметра)

	Значение = Неопределено;
	Если ПараметрыФормы.Свойство(ИмяПараметра, Значение) И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение параметра-даты формы: Неопределено, если параметр не передан,
// имеет другой тип или содержит незаполненную дату.
//
// Параметры:
//   ПараметрыФормы - Структура - параметры формы (свойство Параметры).
//   ИмяПараметра - Строка - имя параметра формы.
//
// Возвращаемое значение:
//   Дата, Неопределено - заполненная дата параметра.
//
&НаСервереБезКонтекста
Функция ДатаПараметраФормы(ПараметрыФормы, Знач ИмяПараметра)

	Значение = Неопределено;
	Если ПараметрыФормы.Свойство(ИмяПараметра, Значение)
		И ТипЗнч(Значение) = Тип("Дата")
		И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
