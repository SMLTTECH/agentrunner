////////////////////////////////////////////////////////////////////////////////
// Форма списка регистра сведений ar_СлужебныйЛог (agentrunner-53, п.7.1) -
// основная форма списка регистра (DefaultListForm).
//
// Динамический список строится произвольным запросом к регистру; отборы
// вынесены в параметры запроса: период (по умолчанию - последние сутки),
// уровень (по умолчанию - все, кроме отладочных записей), источник, событие
// (подстрока) и запуск (RunId). Сортировка - по ar_Момент по убыванию
// (свежие записи сверху).
//
// Форма принимает параметры Уровень / ПериодНачало / ПериодОкончание /
// Источник / Событие / Запуск - их передаёт консоль агентов (п.5.3, переход
// по «Ошибок за сутки»); любой набор параметров допустим, незаполненные
// значения игнорируются и действуют значения по умолчанию.
//
// Из строки с заполненным ar_RunId - переход в просмотр запуска
// (ОбщаяФорма.ar_ПросмотрЗапуска, параметр ИдентификаторЗапуска).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Инициализация формы: значения отборов по умолчанию, затем значения из
// параметров формы (пустые игнорируются), затем параметры запроса
// динамического списка.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьОтборыПоУмолчанию();
	ПрименитьПараметрыФормы();
	УстановитьПараметрыСписка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Смена начала периода отбора - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборПериодНачалоПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена окончания периода отбора - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборПериодОкончаниеПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена уровня отбора - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборУровеньПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена источника отбора - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборИсточникПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена подстроки события - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборСобытиеПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Смена идентификатора запуска - пересчёт параметров запроса списка.
&НаКлиенте
Процедура ОтборЗапускПриИзменении(Элемент)

	УстановитьПараметрыСписка();

КонецПроцедуры

// Нажатие на ссылку "Запуск" в строке списка - открытие просмотра запуска.
// Строка без заполненного идентификатора запуска перехода не выполняет.
//
// Параметры:
//   Элемент - ПолеФормы - колонка ar_RunId таблицы списка.
//   СтандартнаяОбработка - Булево - отключается, переход выполняет форма.
//
&НаКлиенте
Процедура ЗапускСтрокиНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ar_RunId) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("ИдентификаторЗапуска", ТекущиеДанные.ar_RunId);

	Попытка
		ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска", ПараметрыОткрытия, ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Форма просмотра запуска недоступна.';
			|en = 'The run viewer form is unavailable.'"));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значения отборов по умолчанию (agentrunner-53, п.7.1): последние сутки,
// все уровни, кроме отладочных; источник, событие и запуск не ограничены.
&НаСервере
Процедура УстановитьОтборыПоУмолчанию()

	ПериодОкончание = ТекущаяДатаСеанса();

	ОтборПериодОкончание = ПериодОкончание;
	ОтборПериодНачало = ПериодОкончание - 24 * 60 * 60;
	ОтборУровень = "";
	ОтборИсточник = "";
	ОтборСобытие = "";
	ОтборЗапуск = "";

КонецПроцедуры

// Подставляет значения параметров формы в отборы: незаполненные значения
// игнорируются, действуют значения по умолчанию. Имена параметров -
// контракт вызова формы из консоли агентов (agentrunner-53, п.5.3).
&НаСервере
Процедура ПрименитьПараметрыФормы()

	УровеньПараметра = СтроковыйПараметрФормы(Параметры, "Уровень");
	Если Не ПустаяСтрока(УровеньПараметра) Тогда
		ОтборУровень = УровеньПараметра;
	КонецЕсли;

	ПериодНачалоПараметра = ДатаПараметраФормы(Параметры, "ПериодНачало");
	Если ПериодНачалоПараметра <> Неопределено Тогда
		ОтборПериодНачало = ПериодНачалоПараметра;
	КонецЕсли;

	ПериодОкончаниеПараметра = ДатаПараметраФормы(Параметры, "ПериодОкончание");
	Если ПериодОкончаниеПараметра <> Неопределено Тогда
		ОтборПериодОкончание = ПериодОкончаниеПараметра;
	КонецЕсли;

	ИсточникПараметра = СтроковыйПараметрФормы(Параметры, "Источник");
	Если Не ПустаяСтрока(ИсточникПараметра) Тогда
		ОтборИсточник = ИсточникПараметра;
	КонецЕсли;

	СобытиеПараметра = СтроковыйПараметрФормы(Параметры, "Событие");
	Если Не ПустаяСтрока(СобытиеПараметра) Тогда
		ОтборСобытие = СобытиеПараметра;
	КонецЕсли;

	ЗапускПараметра = СтроковыйПараметрФормы(Параметры, "Запуск");
	Если Не ПустаяСтрока(ЗапускПараметра) Тогда
		ОтборЗапуск = ЗапускПараметра;
	КонецЕсли;

КонецПроцедуры

// Переносит текущие значения отборов в параметры произвольного запроса
// динамического списка. Вызывается при создании формы и из обработчиков
// изменения полей отбора: после установки параметров список перечитывается.
&НаСервере
Процедура УстановитьПараметрыСписка()

	// Экранирование спецсимволов ПОДОБНО (%, _, [, ], ~) и обёртка в "%" -
	// поиск подстроки в ar_Событие.
	ШаблонСобытия = "%"
		+ ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(ОтборСобытие) + "%";

	Список.Параметры.УстановитьЗначениеПараметра("НачалоПериода", ОтборПериодНачало);
	Список.Параметры.УстановитьЗначениеПараметра("КонецПериода", ОтборПериодОкончание);
	Список.Параметры.УстановитьЗначениеПараметра("УровеньЗаписи", ОтборУровень);
	Список.Параметры.УстановитьЗначениеПараметра("ИсточникЗаписи", ОтборИсточник);
	Список.Параметры.УстановитьЗначениеПараметра("МаскаСобытия", ШаблонСобытия);
	Список.Параметры.УстановитьЗначениеПараметра("ЗапускЗаписи", ОтборЗапуск);

КонецПроцедуры

// Значение строкового параметра формы: пустая строка, если параметр не передан
// или его значение пусто (Неопределено приводится к пустой строке).
//
// Параметры:
//   ПараметрыФормы - Структура - параметры формы (свойство Параметры).
//   ИмяПараметра - Строка - имя параметра формы.
//
// Возвращаемое значение:
//   Строка - значение параметра без пробелов по краям или пустая строка.
//
&НаСервереБезКонтекста
Функция СтроковыйПараметрФормы(ПараметрыФормы, Знач ИмяПараметра)

	Значение = Неопределено;
	Если ПараметрыФормы.Свойство(ИмяПараметра, Значение) И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение параметра-даты формы: Неопределено, если параметр не передан,
// имеет другой тип или содержит незаполненную дату.
//
// Параметры:
//   ПараметрыФормы - Структура - параметры формы (свойство Параметры).
//   ИмяПараметра - Строка - имя параметра формы.
//
// Возвращаемое значение:
//   Дата, Неопределено - заполненная дата параметра.
//
&НаСервереБезКонтекста
Функция ДатаПараметраФормы(ПараметрыФормы, Знач ИмяПараметра)

	Значение = Неопределено;
	Если ПараметрыФормы.Свойство(ИмяПараметра, Значение)
		И ТипЗнч(Значение) = Тип("Дата")
		И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти