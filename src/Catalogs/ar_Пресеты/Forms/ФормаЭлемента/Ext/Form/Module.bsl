// Модуль формы справочника ar_Пресеты (ФормаЭлемента). Логики нет: форма платформенная, по метаданным.

#Область ОбработчикиСобытийФормы

// Заголовок окна - наименование пресета (у нового элемента - "Пресет (создание)"):
// одинаковый заголовок "Пресеты" не давал понять, какой пресет открыт (стенд 08.10.2026, п. 9).
//
// Параметры:
//   Отказ                - Булево - отказ от открытия формы.
//   СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Пресет (создание)'; en = 'Preset (new)'");
	Иначе
		Заголовок = Строка(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти