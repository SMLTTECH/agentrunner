////////////////////////////////////////////////////////////////////////////////
// Модуль объекта справочника ar_ПодпискиАгентов
// Реестр event-driven подписок агентов на события 1С. META-35.
//
// Активные подписки обработчик записи объектов читает через кэш сеанса
// ar_ОбработчикПодписокПовтИсп (agentrunner-290). Запись подписки сбрасывает кэш
// своего сеанса - изменение действует в нём сразу; в других сеансах - не позже
// чем через 20 минут (время жизни кэша сеанса).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ)

	// Без проверки ОбменДанными.Загрузка: подписка, загруженная обменом, тоже
	// должна быть видна обработчику записи объектов этого сеанса. Сбрасывается
	// кэш повторно используемых значений всего сеанса - запись подписки редка.
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти
