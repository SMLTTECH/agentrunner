			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Диалоги.Ссылка КАК Ссылка,
	Диалоги.Наименование КАК Description,
	Диалоги.ar_ПредставлениеПредмета КАК ar_ПредставлениеПредмета,
	Диалоги.ar_Агент КАК ar_Агент,
	Диалоги.ar_Состояние КАК ar_Состояние,
	Диалоги.ar_ОтветитьДо КАК ar_ОтветитьДо,
	Диалоги.ar_Обновлён КАК ar_Обновлён,
	ВЫБОР
		КОГДА Диалоги.ar_Состояние = ЗНАЧЕНИЕ(Перечисление.ar_СостоянияДиалогов.ОжидаетОтвета)
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК ОжидаетПервым
ИЗ
	Справочник.ar_Диалоги КАК Диалоги
ГДЕ
	(НЕ &amp;ТолькоМоиВопросы
		ИЛИ (Диалоги.ar_Состояние = ЗНАЧЕНИЕ(Перечисление.ar_СостоянияДиалогов.ОжидаетОтвета)
			И Диалоги.Ссылка В
				(ВЫБРАТЬ
					Участники.Ссылка
				ИЗ
					Справочник.ar_Диалоги.ar_Участники КАК Участники
				ГДЕ
					Участники.ar_Пользователь = &amp;ТекущийПользователь)))
	И (НЕ &amp;ОтбиратьПоПредмету
		ИЛИ Диалоги.ar_Предмет = &amp;Предмет)</QueryText>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ОжидаетПервым</dcssch:dataPath>
					<dcssch:field>ОжидаетПервым</dcssch:field>
				</Field>
				<MainTable>Catalog.ar_Диалоги</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:viewMode>Normal</dcsset:viewMode>
							<dcsset:field>ОжидаетПервым</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:viewMode>Normal</dcsset:viewMode>
							<dcsset:field>ar_Обновлён</dcsset:field>
							<dcsset:orderType>Desc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
