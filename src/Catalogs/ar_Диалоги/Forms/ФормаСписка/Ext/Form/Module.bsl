////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Диалоги (agentrunner-26 п.16): первыми -
// «Ожидает ответа», затем по убыванию даты; параметры открытия Предмет и
// ТолькоМоиВопросы; под списком - лента и ввод текущей строки (через ядро).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь",
		ПараметрыСеанса.ТекущийПользователь);

	Если Параметры.Свойство("ТолькоМоиВопросы")
		И Параметры.ТолькоМоиВопросы = Истина Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ТолькоМоиВопросы", Истина);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ТолькоМоиВопросы", Ложь);
	КонецЕсли;

	Если Параметры.Свойство("Предмет") И ЗначениеЗаполнено(Параметры.Предмет) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ar_Предмет");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Параметры.Предмет;
		ЭлементОтбора.Использование  = Истина;
	КонецЕсли;

	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьЛентуТекущейСтроки", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛентуТекущейСтроки()

	ОбновитьЛентуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	ТекущийДиалог = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(ТекущийДиалог) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите диалог в списке.'; en='Select a dialog in the list.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст сообщения.'; en='Enter the message text.'"));
		Возврат;
	КонецЕсли;

	ОтправитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЛентуНаСервере()

	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЛентуТекущейСтроки()

	Если Не ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		ЛентаHTML = "";
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	ЛентаHTML = ar_ДиалогиСервер.РазметкаЛентыHTML(СсылкаДиалога);

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(СсылкаДиалога);
	Если ШапкаДиалога.ВидДиалога = Перечисления.ar_ВидыДиалогов.Чат Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Чат ведётся в консоли агентов';
			|en='The chat is handled in the agent console'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	ИначеЕсли ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ВРаботе Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Агент работает, дождитесь ответа';
			|en='The agent is working, please wait for the reply'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	Иначе
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Ответ'; en='Reply'");
		Элементы.ГруппаОтвета.Доступность = Истина;

		// Варианты открытого вопроса - в список выбора поля ввода.
		Элементы.ТекстОтвета.СписокВыбора.Очистить();
		Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
			Варианты = ВариантыОткрытогоВопроса(СсылкаДиалога);
			Для Каждого Вариант Из Варианты Цикл
				Элементы.ТекстОтвета.СписокВыбора.Добавить(Вариант);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере()

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат;
	КонецЕсли;

	Итог = ar_ДиалогиСервер.ОтправитьСообщение(СсылкаДиалога, ТекстОтвета);

	Если Не ПустаяСтрока(Итог.Сообщение) Тогда
		ПоказатьПредупреждение(, Итог.Сообщение);
	КонецЕсли;

	Если Итог.Успех Тогда
		ТекстОтвета = "";
	КонецЕсли;

	Элементы.Список.Обновить();
	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВариантыОткрытогоВопроса(Знач Диалог)

	// Варианты из последнего сообщения «Вопрос» (ресурс ar_ВариантыОтвета, JSON).
	Варианты = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сообщения.ar_ВариантыОтвета КАК ВариантыОтвета
		|ИЗ
		|	РегистрСведений.ar_СообщенияДиалога КАК Сообщения
		|ГДЕ
		|	Сообщения.ar_Диалог = &Диалог
		|	И Сообщения.ar_ВидСообщения = &ВидСообщения
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.ar_Номер УБЫВ";
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("ВидСообщения", Перечисления.ar_ВидыСообщенийДиалога.Вопрос);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.ВариантыОтвета) Тогда
		Возврат Варианты;
	КонецЕсли;

	Попытка
		Разобранные = ar_JSON.ИзJSON(Выборка.ВариантыОтвета);
	Исключение
		Возврат Варианты;
	КонецПопытки;

	Если ТипЗнч(Разобранные) = Тип("Массив") Тогда
		Для Каждого Вариант Из Разобранные Цикл
			Если ТипЗнч(Вариант) = Тип("Строка") И Не ПустаяСтрока(Вариант) Тогда
				Варианты.Добавить(Вариант);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Варианты;

КонецФункции

#КонецОбласти
