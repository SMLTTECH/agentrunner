////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Диалоги (agentrunner-26 п.16): первыми -
// «Ожидает ответа», затем по убыванию даты; параметры открытия Предмет и
// ТолькоМоиВопросы; под списком - лента и ввод текущей строки (через ядро).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь",
		ПараметрыСеанса.ТекущийПользователь);
	Список.Параметры.УстановитьЗначениеПараметра("ТолькоМоиВопросы",
		Параметры.Свойство("ТолькоМоиВопросы") И Параметры.ТолькоМоиВопросы = Истина);

	// Отбор по предмету - условием запроса списка (предмет только сравнивается).
	ОтбиратьПоПредмету = Параметры.Свойство("Предмет") И ЗначениеЗаполнено(Параметры.Предмет);
	Список.Параметры.УстановитьЗначениеПараметра("ОтбиратьПоПредмету", ОтбиратьПоПредмету);
	Список.Параметры.УстановитьЗначениеПараметра("Предмет",
		?(ОтбиратьПоПредмету, Параметры.Предмет, Неопределено));

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьЛентуТекущейСтроки", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛентуТекущейСтроки()

	ОбновитьЛентуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	ТекущийДиалог = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(ТекущийДиалог) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите диалог в списке.'; en='Select a dialog in the list.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст сообщения.'; en='Enter the message text.'"));
		Возврат;
	КонецЕсли;

	СообщениеИтога = "";
	ОтправитьНаСервере(СообщениеИтога);

	Если Не ПустаяСтрока(СообщениеИтога) Тогда
		ПоказатьПредупреждение(, СообщениеИтога);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЛентуНаСервере()

	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЛентуТекущейСтроки()

	Если Не ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		ЛентаHTML = "";
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	ЛентаHTML = ar_ДиалогиСервер.РазметкаЛентыHTML(СсылкаДиалога);

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(СсылкаДиалога);
	Если ШапкаДиалога.ВидДиалога = Перечисления.ar_ВидыДиалогов.Чат Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Чат ведётся в консоли агентов';
			|en='The chat is handled in the agent console'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	ИначеЕсли ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ВРаботе Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Агент работает, дождитесь ответа';
			|en='The agent is working, please wait for the reply'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	Иначе
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Ответ'; en='Reply'");
		Элементы.ГруппаОтвета.Доступность = Истина;

		// Варианты открытого вопроса - в список выбора поля ввода.
		Элементы.ТекстОтвета.СписокВыбора.Очистить();
		Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
			Варианты = ar_ДиалогиСервер.ВариантыОткрытогоВопроса(СсылкаДиалога);
			Для Каждого Вариант Из Варианты Цикл
				Элементы.ТекстОтвета.СписокВыбора.Добавить(Вариант);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере(СообщениеИтога)

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат;
	КонецЕсли;

	Итог = ar_ДиалогиСервер.ОтправитьСообщение(СсылкаДиалога, ТекстОтвета);

	СообщениеИтога = Итог.Сообщение;

	Если Итог.Успех Тогда
		ТекстОтвета = "";
	КонецЕсли;

	Элементы.Список.Обновить();
	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

#КонецОбласти
