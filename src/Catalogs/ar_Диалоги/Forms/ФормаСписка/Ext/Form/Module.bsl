////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Диалоги (agentrunner-26 п.16): первыми -
// «Ожидает ответа», затем по убыванию даты; параметры открытия Предмет и
// ТолькоМоиВопросы; под списком - лента и ввод текущей строки (через ядро).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь",
		ПараметрыСеанса.ТекущийПользователь);

	// Без полноправной роли расширения (agentrunner-50) - только свои диалоги:
	// инициатор либо участник. Параметр запроса, пользователь снять не может;
	// оператор / администратор / полноправный видят список как раньше.
	Список.Параметры.УстановитьЗначениеПараметра("ТолькоМоиДиалоги",
		Не ar_ДиалогиСервер.ЕстьРольРасширения());

	Список.Параметры.УстановитьЗначениеПараметра("ТолькоМоиВопросы",
		Параметры.Свойство("ТолькоМоиВопросы") И Параметры.ТолькоМоиВопросы = Истина);

	// Спека 3.5: у диалога с незаполненным представлением предмета (ссылка на
	// удалённый объект либо диалоги ранних версий) в списке показывается понятный
	// текст вместо пустой строки.
	Список.Параметры.УстановитьЗначениеПараметра("ТекстУдаленногоПредмета",
		НСтр("ru = 'Объект удалён'; en = 'The object was deleted'"));

	// Отбор по предмету - условием запроса списка (предмет только сравнивается).
	ОтбиратьПоПредмету = Параметры.Свойство("Предмет") И ЗначениеЗаполнено(Параметры.Предмет);
	ПредметОтбора = ?(ОтбиратьПоПредмету, Параметры.Предмет, Неопределено);
	Список.Параметры.УстановитьЗначениеПараметра("ОтбиратьПоПредмету", ОтбиратьПоПредмету);
	Список.Параметры.УстановитьЗначениеПараметра("Предмет", ПредметОтбора);

	ПроверитьПредметКоманды(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	НастроитьРежимПоПредмету();
	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

// Спека 3.3: команда «Диалог с AI» на несохранённом объекте передает пустой
// предмет - открывать список нечем, форма не открывается, пользователь получает
// сообщение (выводится в панель сообщений после отказа открытия).
//
// Параметры:
//   Отказ - Булево - отказ от открытия формы.
//
&НаСервере
Процедура ПроверитьПредметКоманды(Отказ)

	Если Не Параметры.Свойство("Предмет") Или ЗначениеЗаполнено(Параметры.Предмет) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	ОбщегоНазначения.СообщитьПользователю(НСтр(
		"ru = 'Диалог с AI доступен после записи объекта.';
		|en = 'AI dialog is available after the object is saved.'"));

КонецПроцедуры

// Спека 3.1: список, открытый с отбором по предмету, показывает надпись
// «Диалоги по объекту: <предмет>» и команду «Начать диалог»; штатное «Создать»
// в этом режиме скрыто - диалог начинается с обязательного выбора агента.
//
&НаСервере
Процедура НастроитьРежимПоПредмету()

	ОтборПоПредмету = ЗначениеЗаполнено(ПредметОтбора);
	Элементы.НадписьОтбораПоПредмету.Видимость = ОтборПоПредмету;
	Элементы.КнопкаНачатьДиалог.Видимость = ОтборПоПредмету;

	Если Не ОтборПоПредмету Тогда
		Возврат;
	КонецЕсли;

	Элементы.НадписьОтбораПоПредмету.Заголовок = СтрШаблон(
		НСтр("ru = 'Диалоги по объекту: %1'; en = 'Dialogs on the object: %1'"),
		Строка(ПредметОтбора));

	// Стандартные кнопки списка создаются платформой автоматически, поэтому
	// скрываются безопасным методом БСП: элемента может не быть (например, у
	// пользователя нет права добавления).
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ФормаСоздать", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СписокКонтекстноеМенюСоздать", "Видимость", Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьЛентуТекущейСтроки", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛентуТекущейСтроки()

	ОбновитьЛентуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Спека 3.2: начать диалог с агентом по предмету - выбор активного агента,
// затем форма нового диалога с подставленными предметом и агентом. Сам диалог
// создастся первым отправленным сообщением (ar_ДиалогиСервер.НачатьДиалог).
//
// Параметры:
//   Команда - КомандаФормы - команда «Начать диалог».
//
&НаКлиенте
Процедура НачатьДиалог(Команда)

	Если Не ЗначениеЗаполнено(ПредметОтбора) Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Диалог с AI доступен после записи объекта.';
			|en = 'AI dialog is available after the object is saved.'"));
		Возврат;
	КонецЕсли;

	// Выбор агента: форма выбора справочника с отбором по включённым агентам.
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);
	Отбор = Новый Структура("ar_Активен", Истина);
	ПараметрыФормыВыбора.Вставить("Отбор", Отбор);

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораАгентаДляДиалога", ЭтотОбъект, ПредметОтбора);
	ИмяФормыВыбора = "Справочник.ar_Агенты.ФормаВыбора";
	РежимОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение, РежимОкна);

КонецПроцедуры

// Завершение выбора агента: форма нового диалога с предметом и агентом.
//
// Параметры:
//   Результат               - СправочникСсылка.ar_Агенты - выбранный агент;
//                             Неопределено, если выбор отменен.
//   ДополнительныеПараметры - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет диалога.
//
&НаКлиенте
Процедура ПослеВыбораАгентаДляДиалога(Результат, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("Предмет, Агент", ДополнительныеПараметры, Результат);
	ОткрытьФорму("Справочник.ar_Диалоги.Форма.ФормаЭлемента", ПараметрыОткрытия, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	ТекущийДиалог = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(ТекущийДиалог) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите диалог в списке.'; en='Select a dialog in the list.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст сообщения.'; en='Enter the message text.'"));
		Возврат;
	КонецЕсли;

	СообщениеИтога = "";
	ОтправитьНаСервере(СообщениеИтога);

	Если Не ПустаяСтрока(СообщениеИтога) Тогда
		ПоказатьПредупреждение(, СообщениеИтога);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЛентуНаСервере()

	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЛентуТекущейСтроки()

	Если Не ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		ЛентаHTML = "";
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	ЛентаHTML = ar_ДиалогиСервер.РазметкаЛентыHTML(СсылкаДиалога);

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(СсылкаДиалога);
	// Пустой ar_ВидДиалога (диалоги, созданные до задачи) - тоже чат (спека п.2).
	Если ШапкаДиалога.ВидДиалога <> Перечисления.ar_ВидыДиалогов.ВопросыАгента Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Чат ведётся в консоли агентов';
			|en='The chat is handled in the agent console'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	ИначеЕсли ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ВРаботе Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Агент работает, дождитесь ответа';
			|en='The agent is working, please wait for the reply'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
	Иначе
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Ответ'; en='Reply'");
		Элементы.ГруппаОтвета.Доступность = Истина;

		// Варианты открытого вопроса - в список выбора поля ввода.
		Элементы.ТекстОтвета.СписокВыбора.Очистить();
		Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
			Варианты = ar_ДиалогиСервер.ВариантыОткрытогоВопроса(СсылкаДиалога);
			Для Каждого Вариант Из Варианты Цикл
				Элементы.ТекстОтвета.СписокВыбора.Добавить(Вариант);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере(СообщениеИтога)

	СсылкаДиалога = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат;
	КонецЕсли;

	Итог = ar_ДиалогиСервер.ОтправитьСообщение(СсылкаДиалога, ТекстОтвета);

	СообщениеИтога = Итог.Сообщение;

	Если Итог.Успех Тогда
		ТекстОтвета = "";
	КонецЕсли;

	Элементы.Список.Обновить();
	ЗагрузитьЛентуТекущейСтроки();

КонецПроцедуры

#КонецОбласти
