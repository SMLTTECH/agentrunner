////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Диалоги (agentrunner-26 п.16): лента через
// ядро ar_ДиалогиСервер, ответ на открытый вопрос либо сообщение в завершённый
// диалог, переход к предмету. Реквизиты диалога в форме не редактируются.
// Доступ к данным - только через ar_ДиалогиСервер (проверка прав в ядре).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьЛенту();
	НастроитьВводОтвета();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	Если ПустаяСтрока(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст сообщения.'; en='Enter the message text.'"));
		Возврат;
	КонецЕсли;

	СообщениеИтога = "";

	Если ОтправитьНаСервере(СообщениеИтога) Тогда
		ОбновитьОтображениеДанных();
	КонецЕсли;

	Если Не ПустаяСтрока(СообщениеИтога) Тогда
		ПоказатьПредупреждение(, СообщениеИтога);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКПредмету(Команда)

	Если ЗначениеЗаполнено(ПредметДиалога) Тогда
		ПоказатьЗначение(, ПредметДиалога);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загрузить ленту и предмет диалога (через ядро; доступ проверяет ядро).
//
&НаСервере
Процедура ЗагрузитьЛенту()

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(Объект.Ссылка);
	ЛентаHTML = ar_ДиалогиСервер.РазметкаЛентыHTML(Объект.Ссылка);
	ПредметДиалога = ШапкаДиалога.Предмет;

	// Варианты открытого вопроса - в список выбора поля ответа.
	Элементы.ТекстОтвета.СписокВыбора.Очистить();
	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		Варианты = ar_ДиалогиСервер.ВариантыОткрытогоВопроса(Объект.Ссылка);
		Для Каждого Вариант Из Варианты Цикл
			Элементы.ТекстОтвета.СписокВыбора.Добавить(Вариант);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Отправить сообщение (ответ на вопрос либо сообщение в завершённый диалог).
// После отправки лента и шапка обновляются. Текст для пользователя возвращается
// в СообщениеИтога (ПоказатьПредупреждение - клиентский вызов).
//
&НаСервере
Функция ОтправитьНаСервере(СообщениеИтога)

	Итог = ar_ДиалогиСервер.ОтправитьСообщение(Объект.Ссылка, ТекстОтвета);

	СообщениеИтога = Итог.Сообщение;

	Если Итог.Успех Тогда
		ТекстОтвета = "";
		ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	КонецЕсли;

	ЗагрузитьЛенту();
	НастроитьВводОтвета();

	Возврат Итог.Успех;

КонецФункции

// Поле ввода закрыто, когда отправка недопустима (спека п.13), с пояснением.
//
&НаСервере
Процедура НастроитьВводОтвета()

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(Объект.Ссылка);
	// Пустой ar_ВидДиалога (диалоги, созданные до задачи) - тоже чат (спека п.2).
	Если ШапкаДиалога.ВидДиалога <> Перечисления.ar_ВидыДиалогов.ВопросыАгента Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Чат ведётся в консоли агентов';
			|en='The chat is handled in the agent console'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ВРаботе Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Агент работает, дождитесь ответа';
			|en='The agent is working, please wait for the reply'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Ответ'; en='Reply'");
	Элементы.ГруппаОтвета.Доступность = Истина;

КонецПроцедуры

#КонецОбласти
