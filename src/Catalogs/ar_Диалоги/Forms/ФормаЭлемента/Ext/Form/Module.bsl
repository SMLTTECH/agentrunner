////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Диалоги (agentrunner-26 п.16): лента через
// ядро ar_ДиалогиСервер, ответ на открытый вопрос либо сообщение в завершённый
// диалог, переход к предмету. Реквизиты диалога в форме не редактируются.
// Доступ к данным - только через ar_ДиалогиСервер (проверка прав в ядре).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ПодготовитьНовыйДиалог();
	УстановитьЗаголовокДиалога();
	ЗагрузитьЛенту();
	НастроитьВводОтвета();

КонецПроцедуры

// Подготовка формы нового диалога, открытой командой «Начать диалог» (спека 3.2):
// предмет и агент подставляются из параметров формы, а сам диалог создается при
// отправке первого сообщения (ar_ДиалогиСервер.НачатьДиалог).
//
&НаСервере
Процедура ПодготовитьНовыйДиалог()

	Если Не Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Предмет") И ЗначениеЗаполнено(Параметры.Предмет) Тогда
		Объект.ar_Предмет = Параметры.Предмет;
		Объект.ar_ПредставлениеПредмета = Лев(Строка(Параметры.Предмет), 150);
	КонецЕсли;

	Если Параметры.Свойство("Агент") И ЗначениеЗаполнено(Параметры.Агент) Тогда
		Объект.ar_Агент = Параметры.Агент;
	КонецЕсли;

КонецПроцедуры

// Заголовок окна - наименование диалога (спека 3.4); у нового диалога - «Новый диалог».
//
&НаСервере
Процедура УстановитьЗаголовокДиалога()

	Заголовок = ?(Объект.Ссылка.Пустая(),
		НСтр("ru = 'Новый диалог'; en = 'New dialog'"),
		Строка(Объект.Ссылка));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	Если ПустаяСтрока(ТекстОтвета) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст сообщения.'; en='Enter the message text.'"));
		Возврат;
	КонецЕсли;

	СообщениеИтога = "";

	// Спека 3.2: у нового диалога отправка первого сообщения создает сам диалог и
	// запускает агента по предмету (ar_ДиалогиСервер.НачатьДиалог).
	Если Объект.Ссылка.Пустая() Тогда
		Отправлено = НачатьДиалогНаСервере(СообщениеИтога);
	Иначе
		Отправлено = ОтправитьНаСервере(СообщениеИтога);
	КонецЕсли;

	Если Отправлено Тогда
		ОбновитьЛенту(Неопределено);
	КонецЕсли;

	Если Не ПустаяСтрока(СообщениеИтога) Тогда
		ПоказатьПредупреждение(, СообщениеИтога);
	КонецЕсли;

КонецПроцедуры

// Обновить: перечитать диалог, ленту и настройки ввода - в ожидании ответа
// агента состояние и лента меняются без участия формы (спека agentrunner-215 п.4).
//
// Параметры:
//  Команда - КомандаФормы - команда «Обновить» (обработчик платформы).
//
&НаКлиенте
Процедура ОбновитьЛенту(Команда)

	Если Не Объект.Ссылка.Пустая() Тогда
		ОбновитьЛентуНаСервере();
	КонецЕсли;
	ОбновитьОтображениеДанных();

КонецПроцедуры

// Открыть предмет диалога (agentrunner-50): форма от пакета-переопределения
// либо штатное ПоказатьЗначение, как раньше; битая ссылка предмета (объекта
// нет в базе) - понятное сообщение вместо платформенного «Объект не найден».
//
// Параметры:
//  Команда - КомандаФормы - команда «Перейти к предмету» (обработчик платформы).
//
&НаКлиенте
Процедура ПерейтиКПредмету(Команда)

	Если Не ЗначениеЗаполнено(ПредметДиалога) Тогда
		Возврат;
	КонецЕсли;

	// Переопределение открытия предмета пакетом и проверка существования
	// предмета: один серверный вызов на нажатие.
	РезультатОткрытия = ПараметрыОткрытияПредмета(ПредметДиалога);

	Если РезультатОткрытия.ПредметНеНайден Тогда
		ПоказатьПредупреждение(, НСтр("ru='Предмет диалога не найден в информационной базе (объект удален).';
			|en='The dialog subject was not found in the infobase (the object is deleted).'"));
	ИначеЕсли РезультатОткрытия.ПараметрыОткрытия = Неопределено Тогда
		ПоказатьЗначение(, ПредметДиалога);
	Иначе
		//ОткрытьФорму(РезультатОткрытия.ПараметрыОткрытия.ИмяФормы,
		//	РезультатОткрытия.ПараметрыОткрытия.ПараметрыФормы, ЭтотОбъект);    
			
		ОткрытьФорму(РезультатОткрытия.ПараметрыОткрытия.ИмяФормы,
			РезультатОткрытия.ПараметрыОткрытия.ПараметрыФормы);    	
			
		ЭтаФорма.Закрыть(); //закроем форму чтобы пользователь не путался
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры открытия предмета пакетом и признак существования предмета
// (agentrunner-50): один серверный вызов на нажатие; контракт открытия и лог -
// в ar_ДиалогиСервер.ПараметрыОткрытияПредмета. Существование проверяется
// первым: у битой ссылки переопределять нечего, а ПоказатьЗначение по ней
// падает с платформенной ошибкой «Объект не найден» (доработка по verify
// 08.10.2026). Проверка физическая - ОбщегоНазначения.СсылкаСуществует (права
// пользователя и RLS не учитываются), права на предмет проверяет платформа
// при открытии формы.
//
// Параметры:
//  Предмет - ОпределяемыйТип.ar_ПрикладнойОбъект - предмет диалога.
//
// Возвращаемое значение:
//  Структура - {ПредметНеНайден - Булево, ПараметрыОткрытия - Структура/Неопределено}:
//              ПредметНеНайден - предмет не заполнен либо объекта предмета нет
//              в информационной базе;
//              ПараметрыОткрытия - результат
//              ar_ДиалогиСервер.ПараметрыОткрытияПредмета (Неопределено -
//              предмет открывается штатно, ПоказатьЗначение).
//
&НаСервереБезКонтекста
Функция ПараметрыОткрытияПредмета(Знач Предмет)

	Результат = Новый Структура("ПредметНеНайден, ПараметрыОткрытия", Ложь, Неопределено);

	// Заполненность проверяется до БСП: СсылкаСуществует на неопределённое
	// значение не рассчитана (таблица ссылки не определяется).
	Если Не ЗначениеЗаполнено(Предмет) Тогда
		Результат.ПредметНеНайден = Истина;
		Возврат Результат;
	КонецЕсли;

	Если Не ОбщегоНазначения.СсылкаСуществует(Предмет) Тогда
		Результат.ПредметНеНайден = Истина;
		Возврат Результат;
	КонецЕсли;

	Результат.ПараметрыОткрытия = ar_ДиалогиСервер.ПараметрыОткрытияПредмета(Предмет);
	Возврат Результат;

КонецФункции

// Загрузить ленту и предмет диалога (через ядро; доступ проверяет ядро).
//
&НаСервере
Процедура ЗагрузитьЛенту()

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(Объект.Ссылка);
	ЛентаHTML = ar_ДиалогиСервер.РазметкаЛентыHTML(Объект.Ссылка);
	ПредметДиалога = ШапкаДиалога.Предмет;

	// Варианты открытого вопроса - в список выбора поля ответа.
	Элементы.ТекстОтвета.СписокВыбора.Очистить();
	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		Варианты = ar_ДиалогиСервер.ВариантыОткрытогоВопроса(Объект.Ссылка);
		Для Каждого Вариант Из Варианты Цикл
			Элементы.ТекстОтвета.СписокВыбора.Добавить(Вариант);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Данные диалога из базы, лента и настройки ввода (команда «Обновить»):
// один серверный вызов на нажатие.
//
&НаСервере
Процедура ОбновитьЛентуНаСервере()

	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	ЗагрузитьЛенту();
	НастроитьВводОтвета();

КонецПроцедуры

// Отправить сообщение (ответ на вопрос либо сообщение в завершённый диалог).
// После отправки лента и шапка обновляются. Текст для пользователя возвращается
// в СообщениеИтога (ПоказатьПредупреждение - клиентский вызов).
//
&НаСервере
Функция ОтправитьНаСервере(СообщениеИтога)

	Итог = ar_ДиалогиСервер.ОтправитьСообщение(Объект.Ссылка, ТекстОтвета);

	СообщениеИтога = Итог.Сообщение;

	Если Итог.Успех Тогда
		ТекстОтвета = "";
		ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	КонецЕсли;

	ЗагрузитьЛенту();
	НастроитьВводОтвета();

	Возврат Итог.Успех;

КонецФункции

// Начать диалог по предмету первым сообщением (спека 3.2): диалог создает ядро,
// лента и ввод ответа переключаются на созданный диалог.
// Текст для пользователя возвращается в СообщениеИтога.
//
&НаСервере
Функция НачатьДиалогНаСервере(СообщениеИтога)

	Итог = ar_ДиалогиСервер.НачатьДиалог(Объект.ar_Агент, Объект.ar_Предмет, ТекстОтвета);
	СообщениеИтога = Итог.Сообщение;

	Если Не Итог.Успех Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗначениеВРеквизитФормы(Итог.ДиалогСсылка.ПолучитьОбъект(), "Объект");
	ТекстОтвета = "";
	УстановитьЗаголовокДиалога();
	ЗагрузитьЛенту();
	НастроитьВводОтвета();

	Возврат Истина;

КонецФункции

// Настройка поля ввода и подписи группы по состоянию диалога (спека
// agentrunner-215 п.3, п.5). В завершенном диалоге (Завершён/Истёк, вид
// «Вопросы агента») ввод и «Отправить» остаются: ядро принимает такое
// сообщение и снова передает диалог агенту (ОтправитьСообщениеВнутр), НСИ
// может возобновить ожидание. Флаги сбрасываются при каждом вызове - форма
// переиспользуется после отправки сообщения.
//
&НаСервере
Процедура НастроитьВводОтвета()

	Элементы.ТекстОтвета.ТолькоПросмотр = Ложь;
	Элементы.Отправить.Видимость = Истина;
	Элементы.ГруппаОтвета.Доступность = Истина;

	// «Ответить до» скрыт, если срок не задан.
	Элементы.ОтветитьДо.Видимость = ЗначениеЗаполнено(Объект.ar_ОтветитьДо);

	// Новый диалог (спека 3.2): поле первого сообщения доступно, диалог создаст
	// отправка сообщения.
	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Первое сообщение'; en='First message'");
		Возврат;
	КонецЕсли;

	ШапкаДиалога = ar_ДиалогиСервер.ШапкаДиалога(Объект.Ссылка);

	// Пустой ar_ВидДиалога (диалоги, созданные до задачи) - тоже чат (спека п.2).
	Если ШапкаДиалога.ВидДиалога <> Перечисления.ar_ВидыДиалогов.ВопросыАгента Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Чат ведётся в консоли агентов';
			|en='The chat is handled in the agent console'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ВРаботе Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Агент работает, дождитесь ответа';
			|en='The agent is working, please wait for the reply'");
		Элементы.ГруппаОтвета.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.ОжидаетОтвета Тогда
		ЗаголовокОтвета = НСтр("ru='Ответ агенту'; en='Reply to the agent'");
		Если ЗначениеЗаполнено(ШапкаДиалога.ОтветитьДо) Тогда
			ЗаголовокОтвета = ЗаголовокОтвета + " " + СтрШаблон(
				НСтр("ru='(до %1)'; en='(until %1)'"),
				Формат(ШапкаДиалога.ОтветитьДо, "ДФ='dd.MM.yyyy HH:mm'"));
		КонецЕсли;
		Элементы.ГруппаОтвета.Заголовок = ЗаголовокОтвета;
		Возврат;
	КонецЕсли;

	Если ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.Завершён
		Или ШапкаДиалога.Состояние = Перечисления.ar_СостоянияДиалогов.Истёк Тогда
		Элементы.ГруппаОтвета.Заголовок = НСтр(
			"ru='Диалог завершён. Новое сообщение снова передаст его агенту';
			|en='The dialog is completed. A new message will pass it to the agent again'");
		Возврат;
	КонецЕсли;

	// Прочие разрешенные состояния (например, состояние не задано).
	Элементы.ГруппаОтвета.Заголовок = НСтр("ru='Сообщение агенту'; en='Message to the agent'");

КонецПроцедуры

#КонецОбласти
