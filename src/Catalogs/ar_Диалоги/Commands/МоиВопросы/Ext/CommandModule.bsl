// Команда «Мои вопросы» (agentrunner-26 п.17): открывает ФормаСписка
// с параметром ТолькоМоиВопросы (текущий пользователь - участник,
// состояние «Ожидает ответа»).
//
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ПараметрыФормы = Новый Структура("ТолькоМоиВопросы", Истина);
	ОткрытьФорму("Справочник.ar_Диалоги.ФормаСписка",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно);

КонецПроцедуры
