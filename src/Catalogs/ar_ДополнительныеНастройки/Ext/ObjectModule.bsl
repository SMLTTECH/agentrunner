////////////////////////////////////////////////////////////////////////////////
// Справочник ar_ДополнительныеНастройки - модуль объекта.
//
// Атрибуция настроек (по образцу sp_ДополнительныеНастройки): кто и когда
// изменил. Заполняется при любой записи объекта - интерактивной из форм и
// программной через ar_Настройки.УстановитьЗначение/УстановитьСписок.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ar_Ответственный) Тогда
		ar_Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;

	ar_ДатаИзменения = ТекущаяДатаСеанса();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	// Ответственного копии не наследуем: настройку меняет копировавший.
	ar_Ответственный = Неопределено;

КонецПроцедуры

#КонецОбласти
