////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_ДополнительныеНастройки (PAY-01).
//
// Реквизиты ar_Значение (составной: Булево/Число/Дата + ссылки определяемого
// типа ar_ПрикладнойОбъект, agentrunner-85) и ar_ЗначениеСтрока (строка
// неограниченной длины) объекта показываются оператору как ОДНО поле
// "ЗначениеОтображение" - деталь хранения (два физических реквизита) от
// оператора скрыта. Реквизит формы ТипЗначения ("Строка"/"Число"/"Дата"/
// "Булево"/"Ссылка") определяет, в какое из двух полей объекта уходит значение
// при записи. Выбранный тип сохраняется в реквизите объекта ar_ТипЗначения
// (agentrunner-83): Булево=Ложь, Число=0 и пустая Дата неотличимы от "не
// заполнено" по самим значениям, поэтому при открытии тип берется из
// ar_ТипЗначения, а для элементов, записанных до появления реквизита, -
// определяется эвристикой по заполненности (ОпределитьТипЗначенияПоОбъекту).
// Поле "Тип значения" - выбор из фиксированного списка (Строка/Число/Дата/
// Булево/Ссылка), ввод произвольного текста запрещен.
//
// Реквизит формы ВидНастройки ("Скаляр"/"Список"/"Соответствие") управляет
// видимостью группы одиночного значения vs таблицы ar_Значения vs таблицы
// ar_Соответствие - определяется при открытии по факту заполненности данных
// (см. .docs/specs/PAY-01.md, §UI справочника настроек).
//
// Тип поля "Значение" следует за ТипЗначения: полю программно устанавливается
// ограничение типа (ОграничениеТипа) и запрет диалога выбора типа, поэтому
// значение вводится сразу в нужном типе, без платформенного диалога выбора
// типа составного поля (agentrunner-53, п.8.1). Для "Ссылка" (agentrunner-85)
// ограничение - состав определяемого типа ar_ПрикладнойОбъект, выбор типа
// разрешён (поле составное из нескольких ссылочных типов); ограничение
// ставится серверным вызовом: Метаданные на клиенте (веб-клиент) недоступны.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОпределитьТипЗначенияПоОбъекту();
	ОпределитьВидНастройкиПоОбъекту();
	ЗаполнитьЗначениеОтображениеИзОбъекта();
	ОбновитьВидимостьПоВидуНастройки(ЭтаФорма);
	Если ТипЗначения = "Ссылка" Тогда
		НастроитьПолеЗначенияСсылкойНаСервере();
	Иначе
		НастроитьПолеЗначения(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

// Перед записью переносит ЗначениеОтображение (единое поле формы) обратно в
// физические реквизиты записываемого объекта (ТекущийОбъект - правки реквизита
// формы Объект в этом событии записью не учитываются): Объект.ar_ЗначениеСтрока для типа "Строка",
// Объект.ar_Значение - для прочих (Булево/Число/Дата/Ссылка). Выбранный тип сохраняется
// в ar_ТипЗначения (agentrunner-83) - он нужен при открытии: Булево=Ложь,
// Число=0 и пустая Дата неотличимы от "не заполнено" по самим значениям.
// При виде настройки "Список" или "Соответствие" скалярные поля объекта и
// чужая табличная часть очищаются - значение хранится только в "своей" ТЧ
// (взаимоисключимость Скаляр/Список/Соответствие); ar_ТипЗначения у списка и
// соответствия пуст - тип строки ТЧ задачей не хранится.
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ВидНастройки = "Список" Тогда
		ТекущийОбъект.ar_Значение = Ложь;
		ТекущийОбъект.ar_ЗначениеСтрока = "";
		ТекущийОбъект.ar_Соответствие.Очистить();
		ТекущийОбъект.ar_ТипЗначения = "";
		Возврат;
	КонецЕсли;

	Если ВидНастройки = "Соответствие" Тогда
		ТекущийОбъект.ar_Значение = Ложь;
		ТекущийОбъект.ar_ЗначениеСтрока = "";
		ТекущийОбъект.ar_Значения.Очистить();
		ТекущийОбъект.ar_ТипЗначения = "";
		Возврат;
	КонецЕсли;

	// Скаляр: ТЧ обоих видов очищаются - значение хранится только в полях
	// ar_Значение/ar_ЗначениеСтрока.
	ТекущийОбъект.ar_Значения.Очистить();
	ТекущийОбъект.ar_Соответствие.Очистить();
	ТекущийОбъект.ar_ТипЗначения = ТипЗначения;

	Если ТипЗначения = "Строка" Тогда
		ТекущийОбъект.ar_ЗначениеСтрока = СокрЛП(Строка(ЗначениеОтображение));
		ТекущийОбъект.ar_Значение = Ложь;
	ИначеЕсли ТипЗначения = "Булево" Тогда
		ТекущийОбъект.ar_Значение = (ЗначениеОтображение = Истина);
		ТекущийОбъект.ar_ЗначениеСтрока = "";
	ИначеЕсли ТипЗначения = "Число" Тогда
		Если ТипЗнч(ЗначениеОтображение) = Тип("Число") Тогда
			ТекущийОбъект.ar_Значение = ЗначениеОтображение;
		Иначе
			ТекущийОбъект.ar_Значение = 0;
		КонецЕсли;
		ТекущийОбъект.ar_ЗначениеСтрока = "";
	ИначеЕсли ТипЗначения = "Дата" Тогда
		Если ТипЗнч(ЗначениеОтображение) = Тип("Дата") Тогда
			ТекущийОбъект.ar_Значение = ЗначениеОтображение;
		Иначе
			ТекущийОбъект.ar_Значение = '00010101';
		КонецЕсли;
		ТекущийОбъект.ar_ЗначениеСтрока = "";
	ИначеЕсли ТипЗначения = "Ссылка" Тогда
		// agentrunner-85: ссылка определяемого типа ar_ПрикладнойОбъект хранится
		// в ar_Значение; не ссылочное значение (оператор не выбрал) - пусто (Ложь,
		// как у Булево: тип подскажет ar_ТипЗначения = "Ссылка").
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеОтображение)) Тогда
			ТекущийОбъект.ar_Значение = ЗначениеОтображение;
		Иначе
			ТекущийОбъект.ar_Значение = Ложь;
		КонецЕсли;
		ТекущийОбъект.ar_ЗначениеСтрока = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Переключение Скаляр/Список - управляет видимостью группы одиночного
// значения и таблицы списка (см. докстринг модуля).
&НаКлиенте
Процедура ВидНастройкиПриИзменении(Элемент)

	ОбновитьВидимостьПоВидуНастройки(ЭтаФорма);

КонецПроцедуры

// Смена типа значения - ограничивает тип поля "Значение" выбранным типом и
// приводит уже введённое значение к нему (без потери данных там, где
// конвертация возможна). Для "Ссылка" ограничение ставится серверным вызовом
// (см. НастроитьПолеЗначенияСсылкойНаСервере), прежнее значение очищается -
// скаляр к ссылке не приводится.
&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)

	Если ТипЗначения = "Ссылка" Тогда
		НастроитьПолеЗначенияСсылкойНаСервере();
		ЗначениеОтображение = Неопределено;
	Иначе
		НастроитьПолеЗначения(ЭтаФорма);
		ПривестиЗначениеОтображениеКТипу();
	КонецЕсли;

КонецПроцедуры

// Ввод значения в единое поле - серверная часть не требуется: при записи
// формы ЗначениеОтображение переносится в Объект.ar_Значение/ar_ЗначениеСтрока
// (см. ПередЗаписьюНаСервере).
&НаКлиенте
Процедура ЗначениеОтображениеПриИзменении(Элемент)

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет ТипЗначения реквизита формы для показа оператору.
// Если у элемента записан поддерживаемый ar_ТипЗначения (запись из этой формы
// либо программная из ar_Настройки) - берем его: Булево=Ложь, Число=0 и
// пустая Дата неотличимы от "не заполнено" по самим значениям, поэтому тип
// читается из хранимого реквизита (agentrunner-83). Иначе (элементы,
// записанные до появления реквизита) - прежняя эвристика по факту
// заполненности объекта (см. докстринг ar_Настройки.ЗначениеНастройки - тот
// же принцип): непустая ar_ЗначениеСтрока -> "Строка", ссылочное ar_Значение ->
// "Ссылка" (agentrunner-85), иначе - по типу ar_Значение "как есть". Для
// действительно нового элемента (оба поля пусты, ar_Значение = Ложь по
// умолчанию платформы) - безопасный дефолт "Строка".
&НаСервере
Процедура ОпределитьТипЗначенияПоОбъекту()

	Если ЭтоИмяТипаЗначения(Объект.ar_ТипЗначения) Тогда
		ТипЗначения = Объект.ar_ТипЗначения;
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(Объект.ar_ЗначениеСтрока) Тогда
		ТипЗначения = "Строка";
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект.ar_Значение)) Тогда
		ТипЗначения = "Ссылка";
	ИначеЕсли ТипЗнч(Объект.ar_Значение) = Тип("Число") Тогда
		ТипЗначения = "Число";
	ИначеЕсли ТипЗнч(Объект.ar_Значение) = Тип("Дата") Тогда
		ТипЗначения = "Дата";
	Иначе
		// Булево=Ложь неотличимо от "не заполнено" - для нового элемента
		// (создан только что, значение не вводили) дефолт "Строка" удобнее
		// оператору, чем скрытое Булево=Ложь.
		ТипЗначения = "Строка";
	КонецЕсли;

КонецПроцедуры

// Определяет ВидНастройки ("Скаляр"/"Список"/"Соответствие") по факту
// заполненности: непустая ТЧ ar_Соответствие -> "Соответствие" (как в
// sp_ДополнительныеНастройки: заполненное соответствие сразу показывается
// оператору); иначе непустая ТЧ ar_Значения -> "Список"; иначе -> "Скаляр"
// (в т.ч. для нового элемента - безопасный дефолт). При открытии заполненного
// соответствия его количество дописывается в заголовок таблицы.
&НаСервере
Процедура ОпределитьВидНастройкиПоОбъекту()

	Если Объект.ar_Соответствие.Количество() > 0 Тогда
		ВидНастройки = "Соответствие";
		КоличествоСтрок = Объект.ar_Соответствие.Количество();
		Элементы.ar_Соответствие.Заголовок = СтрШаблон(
			НСтр("ru = 'Соответствие (%1)';
				|en = 'Key-value map (%1)'"),
			КоличествоСтрок);
	ИначеЕсли Объект.ar_Значения.Количество() > 0 Тогда
		ВидНастройки = "Список";
	Иначе
		ВидНастройки = "Скаляр";
	КонецЕсли;

КонецПроцедуры

// Переносит текущее значение объекта (ar_Значение/ar_ЗначениеСтрока) в единое
// поле формы ЗначениеОтображение согласно уже определённому ТипЗначения.
&НаСервере
Процедура ЗаполнитьЗначениеОтображениеИзОбъекта()

	Если ТипЗначения = "Строка" Тогда
		ЗначениеОтображение = Объект.ar_ЗначениеСтрока;
	ИначеЕсли ТипЗначения = "Булево" Тогда
		ЗначениеОтображение = (ТипЗнч(Объект.ar_Значение) = Тип("Булево")) И Объект.ar_Значение;
	ИначеЕсли ТипЗначения = "Число" Тогда
		Если ТипЗнч(Объект.ar_Значение) = Тип("Число") Тогда
			ЗначениеОтображение = Объект.ar_Значение;
		Иначе
			ЗначениеОтображение = 0;
		КонецЕсли;
	ИначеЕсли ТипЗначения = "Дата" Тогда
		Если ТипЗнч(Объект.ar_Значение) = Тип("Дата") Тогда
			ЗначениеОтображение = Объект.ar_Значение;
		Иначе
			ЗначениеОтображение = '00010101';
		КонецЕсли;
	ИначеЕсли ТипЗначения = "Ссылка" Тогда
		// agentrunner-85: ссылку показываем как есть; не ссылочное значение
		// (записано до "Ссылка" без ar_ТипЗначения) - поле остаётся пустым.
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект.ar_Значение)) Тогда
			ЗначениеОтображение = Объект.ar_Значение;
		Иначе
			ЗначениеОтображение = Неопределено;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Показывает блок, соответствующий виду настройки, - три места хранения
// взаимоисключимы, оператор не должен заполнять их одновременно.
//
// Вызывается И с сервера (ПриСозданииНаСервере), И с клиента
// (ВидНастройкиПриИзменении), поэтому директива - &НаКлиентеНаСервереБезКонтекста
// (порядок частей именно такой: Клиент->Сервер, обратный = Unknown annotation).
// Форма передаётся параметром: без контекста прямого доступа к Элементы нет.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьПоВидуНастройки(Форма)

	ЭтоСкаляр      = (Форма.ВидНастройки = "Скаляр");
	ЭтоСписок      = (Форма.ВидНастройки = "Список");
	ЭтоСоответствие = (Форма.ВидНастройки = "Соответствие");

	Форма.Элементы.ГруппаСкаляр.Видимость = ЭтоСкаляр;
	Форма.Элементы.ar_Значения.Видимость = ЭтоСписок;
	Форма.Элементы.ar_Соответствие.Видимость = ЭтоСоответствие;

	// Тип значения имеет смысл только для одиночного значения.
	Форма.Элементы.ТипЗначения.Видимость = ЭтоСкаляр;

КонецПроцедуры

// Устанавливает полю "Значение" тип по реквизиту ТипЗначения: ограничение
// типа поля и запрет диалога выбора типа. Платформенный диалог выбора типа
// составного поля не показывается, значение вводится сразу нужного типа
// (agentrunner-53, п.8.1).
//
// Вызывается И с сервера (ПриСозданииНаСервере), И с клиента
// (ТипЗначенияПриИзменении), поэтому директива - &НаКлиентеНаСервереБезКонтекста;
// форма передаётся параметром (см. ОбновитьВидимостьПоВидуНастройки).
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - форма элемента настройки.
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьПолеЗначения(Форма)

	Форма.Элементы.ЗначениеОтображение.ОграничениеТипа = ОписаниеТипаПоляЗначения(Форма.ТипЗначения);
	Форма.Элементы.ЗначениеОтображение.ВыбиратьТип = Ложь;

КонецПроцедуры

// Описание типа поля "Значение" по выбранному типу значения: Строка / Число /
// Дата / Булево. Квалификаторы числа и даты совпадают с типом реквизита формы
// ЗначениеОтображение (Число 15.2, дата без времени). Для "Ссылка" ограничение
// ставит НастроитьПолеЗначенияСсылкойНаСервере (Метаданные недоступны на клиенте).
//
// Параметры:
//   ТипЗначения - Строка - "Строка" / "Число" / "Дата" / "Булево".
//
// Возвращаемое значение:
//   ОписаниеТипов - ограничение типа для поля "Значение".
//
&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеТипаПоляЗначения(Знач ТипЗначения)

	Если ТипЗначения = "Число" Тогда
		Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ИначеЕсли ТипЗначения = "Дата" Тогда
		Возврат Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ИначеЕсли ТипЗначения = "Булево" Тогда
		Возврат Новый ОписаниеТипов("Булево");
	Иначе
		// "Строка" и любое неизвестное значение - строковое поле.
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;

КонецФункции

// Ограничение поля "Значение" составом определяемого типа ar_ПрикладнойОбъект
// (agentrunner-85); выбор типа разрешён - поле составное из нескольких
// ссылочных типов, платформа предлагает выбрать тип при вводе. Серверная
// процедура: Метаданные.ОпределяемыеТипы недоступны на клиенте (веб-клиент),
// поэтому ветка "Ссылка" вызывается серверным вызовом из ТипЗначенияПриИзменении
// и ПриСозданииНаСервере (изменения свойств элементов формы возвращаются клиенту).
//
&НаСервере
Процедура НастроитьПолеЗначенияСсылкойНаСервере()

	Элементы.ЗначениеОтображение.ОграничениеТипа =
		Метаданные.ОпределяемыеТипы.ar_ПрикладнойОбъект.Тип;
	Элементы.ЗначениеОтображение.ВыбиратьТип = Истина;

КонецПроцедуры

// Булево - строка является одним из пяти поддерживаемых имен типа значения
// ("Строка"/"Число"/"Дата"/"Булево"/"Ссылка"). Пустая строка (тип не записан:
// элементы, созданные до agentrunner-83, виды "Список"/"Соответствие") - Ложь.
//
// Параметры:
//   ИмяТипа - Строка - проверяемое значение реквизита ar_ТипЗначения.
//
// Возвращаемое значение:
//   Булево - имя входит в поддерживаемый список типов значения.
//
&НаСервере
Функция ЭтоИмяТипаЗначения(Знач ИмяТипа)

	Возврат ИмяТипа = "Строка"
		Или ИмяТипа = "Число"
		Или ИмяТипа = "Дата"
		Или ИмяТипа = "Булево"
		Или ИмяТипа = "Ссылка";

КонецФункции

// Приводит текущее ЗначениеОтображение к установленному ограничению типа поля -
// избегает несоответствия значения и типа поля после смены ТипЗначения.
// Для "Ссылка" не вызывается (см. ТипЗначенияПриИзменении): приведение
// скаляра к ссылке бессмысленно, значение очищается на клиенте.
&НаКлиенте
Процедура ПривестиЗначениеОтображениеКТипу()

	ЗначениеОтображение = Элементы.ЗначениеОтображение.ОграничениеТипа.ПривестиЗначение(ЗначениеОтображение);

КонецПроцедуры

#КонецОбласти
