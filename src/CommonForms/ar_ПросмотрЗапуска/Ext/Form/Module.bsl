////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ПросмотрЗапуска («Просмотр запуска» / «Run viewer») — UI-10/UI-11.
//
// Диагностический инструмент: показывает полную историю одного запуска агента
// (РегистрСведений.ar_Запуски) в виде мастер-детального дерева
// «Запуск → События → Вызовы инструментов» (Plan §4.4). Узел 1 уровня — сам запуск,
// узлы 2 уровня — слитый хронологический список событий (ar_СобытияЗапуска)
// и вызовов инструментов (ar_ДействияАгента), отсортированный по ar_Sequence.
// При выборе узла боковая панель показывает релевантные детали.
//
// Открывается программно с параметром ИдентификаторЗапуска (строка) либо ключом записи
// регистра ar_Запуски (стандартная навигация «Перейти к» из списка).
//
// UI-11 — команда ar_ПоказатьПромпт / КнопкаПоказатьПромпт: для узла «Событие»
// с ar_ТипСобытия = LLMCalled и непустым массивом "messages" в ar_PayloadJSON
// кнопка становится видимой (ОбновитьВидимостьКнопкиПромпт). Нажатие открывает
// CommonForm.ar_ФормаПросмотраPrompt (ОткрытьФорму, БлокироватьОкноВладельца) с полным
// (без 500-символьной обрезки ar_Утилиты.МаскироватьСекреты) pretty-print JSON
// массива сообщений промпта и оценкой токенов (ar_Токены через форму UI-03).
//
// UI-12 — ДекорацияПульс: показывает «Пульс: N сек назад» вместо сырой
// даты ar_ПоследнийПульс. Для незавершённых запусков (статус не финальный)
// подключается клиентский таймер (ПодключитьОбработчикОжидания, интервал 5 сек,
// см. ПриОткрытии/ОбновитьПульс) — индикатор «тикает» без обращения к
// серверу (вариант A из спеки: пересчёт на клиенте от ШапкаПоследнийПульс,
// прочитанного один раз при открытии формы). Для финальных статусов
// (Completed/Failed/Cancelled/MaxStepsReached/DeniedGlobally/Interrupted/
// FailedIncompatibleState) таймер не подключается — текст вычисляется один раз
// на сервере и далее не растёт (см. СтатусФинальный, ЗаполнитьШапку).
//
// ТОЧКИ РАСШИРЕНИЯ (зарезервированы в разметке, НЕ реализованы):
//   * UI-13 — команда ar_Возобновить / КнопкаВозобновить: видима только при
//     статусе Interrupted, но обработчик-заглушка не вызывает ar_RuntimeЗапуск —
//     это предмет отдельного DoD UI-13. ПРИМЕЧАНИЕ для разработчика UI-13:
//     обработчик ОбновитьПульс (таймер, подключаемый в ПриОткрытии) можно
//     переиспользовать для периодического обновления видимости/состояния
//     КнопкаВозобновить при автообновлении — не обязательно для UI-12.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения, см. ar_ФормаПросмотраPrompt).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// КнопкаПоказатьПромпт (UI-11) скрыта по умолчанию — становится видимой
	// при активизации строки дерева, соответствующей LLMCalled с messages
	// (см. ОбновитьВидимостьКнопкиПромпт).
	// КнопкаВозобновить (UI-13) — точка расширения, обработчик-заглушка.
	Элементы.КнопкаПоказатьПромпт.Видимость = Ложь;
	Элементы.КнопкаВозобновить.Видимость = Ложь;

	// CONS-13: "читатель без команд управления". Готовый и уже корректно
	// расставленный признак - право Update на ar_ОчередьApproval (Читатель его
	// не имеет, Оператор и Админ имеют, см. спеку) - вычисляется один раз на
	// сервере и кэшируется в реквизит формы; клиентская ОбновитьДоступностьКнопокПодтверждения
	// применяет его как дополнительное И к уже существующей логике по ЭтоИстория (CONS-06).
	ТекущийПользовательМожетУправлятьПодтверждением = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ar_ОчередьApproval);

	ИдентификаторЗапуска = ОпределитьИдентификаторЗапускаИзПараметров();

	Если ПустаяСтрока(ИдентификаторЗапуска) Тогда
		ПоказатьЗаглушкуНеНайдено();
		Возврат;
	КонецЕсли;

	// CONS-13: карточка открывается по прямому ИдентификаторЗапуска (параметр формы, минуя
	// список консоли, где фильтр видимости уже применяется в ar_КонсольДанные) -
	// без этой проверки неадмин, подставив чужой ИдентификаторЗапуска, увидел бы шапку, дерево
	// шагов и секции "Созданные объекты"/"Ожидает подтверждения" чужого запуска.
	// Переиспользуем ТО ЖЕ ядро фильтра, что и список консоли (не отдельная
	// копия правил видимости) - см. ar_КонсольДанные.ЗапускДоступенТекущемуПользователю.
	Если НЕ ar_КонсольДанные.ЗапускДоступенТекущемуПользователю(ИдентификаторЗапуска) Тогда
		ПоказатьЗаглушкуНеНайдено(Истина);
		Возврат;
	КонецЕсли;

	// Спека 4.4: отбор по типу события в дереве событий; по умолчанию «Все»
	// (значение перечислений отбора задается в ЗаполнитьОтборТиповСобытий).
	ЗаполнитьОтборТиповСобытий();

	Если НЕ ЗагрузитьДанныеЗапускаНаСервере() Тогда
		ПоказатьЗаглушкуНеНайдено();
		Возврат;
	КонецЕсли;

	Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиПусто;

КонецПроцедуры

// Загружает (перезагружает) данные запуска в форму: шапку со счётчиками, дерево
// событий, план, созданные объекты и секцию ожидающих подтверждений. Вызывается
// при открытии формы и командой «Обновить» (спека 4.1).
//
// Возвращаемое значение:
//   Булево - Истина, если данные загружены; Ложь, если запуск не найден
//            (форма показывает заглушку «Запуск не найден»).
//
&НаСервере
Функция ЗагрузитьДанныеЗапускаНаСервере()

	Шапка = ПрочитатьШапкуЗапуска(ИдентификаторЗапуска);
	Если Шапка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаполнитьШапку(Шапка);
	ПостроитьДерево(ИдентификаторЗапуска);

	// PLAN-07: секция «План» - тем же путём, что CONS-06 (целевой запрос по ИдентификаторЗапуска
	// к ar_СобытияЗапуска, см. ЗаполнитьПлан) - последнее событие PlanUpdated.
	ЗаполнитьПлан(ИдентификаторЗапуска);

	// CONS-06: секции «Созданные объекты 1С» и «Ожидает подтверждения» строятся
	// отдельными целевыми запросами, а не выборкой из уже построенного дерева
	// (там представление урезано под нужды дерева) - см. .docs/specs/CONS-06.md.
	ЗаполнитьСозданныеОбъекты(ИдентификаторЗапуска);
	ЗаполнитьОжидаетПодтверждения(ИдентификаторЗапуска);

	Заголовок = СтрШаблон(
		НСтр("ru = 'Запуск %1 - %2'; en = 'Run %1 - %2'"),
		ИдентификаторЗапуска, Строка(Шапка.Статус));

	Возврат Истина;

КонецФункции

// Обновление без перестроения дерева событий: шапка со счётчиками и секция
// ожидающих подтверждений. Используется автообновлением идущего запуска
// (спека 4.1): перестроение дерева каждые 5 секунд сбрасывало бы раскрытие
// узлов и выделенную строку, а растущие счётчики и появляющиеся запросы
// подтверждения должны быть видны без действий оператора.
//
&НаСервере
Процедура ОбновитьСчетчикиЗапускаНаСервере()

	Шапка = ПрочитатьШапкуЗапуска(ИдентификаторЗапуска);
	Если Шапка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьШапку(Шапка);
	ЗаполнитьОжидаетПодтверждения(ИдентификаторЗапуска);

КонецПроцедуры

// UI-12: подключает клиентский таймер автообновления индикатора пульса.
//
// Подключается только если ЗаполнитьШапку признала это необходимым
// (ШапкаПульсАктивен = Истина): ar_ПоследнийПульс заполнен и статус запуска не
// финальный. Для АвтоТест/«запуск не найден»/финальных статусов реквизит
// остаётся Ложь (значение по умолчанию для Булево) — таймер не подключается.
//
// ИнтервалПульсаСек (5 секунд) — компромисс между «живостью» индикатора и
// нагрузкой на клиент при нескольких одновременно открытых формах Run Viewer
// (вариант A — пересчёт чисто клиентский, без серверного round-trip, см.
// ОбновитьПульс).
//
// Параметры:
//   Отказ - Булево - стандартный параметр события ПриОткрытии (не используется).
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ШапкаПульсАктивен Тогда
		ПодключитьОбработчикОжидания("ОбновитьПульс", ИнтервалПульсаСек(), Ложь);
	КонецЕсли;

	// Спека 4.1: пока запуск не завершен, счётчики шапки и секция ожидающих
	// подтверждений обновляются сами (дерево событий - командой «Обновить»,
	// чтобы не сбрасывать раскрытие узлов и выделенную строку).
	Если Не ШапкаСтатусФинальный Тогда
		ПодключитьОбработчикОжидания("АвтообновлениеЗапуска", ИнтервалАвтообновленияСек(), Ложь);
	КонецЕсли;

	// Развернуть корневой узел запуска (он один) - Развернуть() клиентский метод,
	// не может вызываться из серверного ПостроитьДерево (см. её комментарий).
	РазвернутьКорневыеУзлы();

КонецПроцедуры

// UI-12: снимает таймеры автообновления при закрытии формы.
//
// Платформа сама отключает обработчики ожидания при закрытии формы (штатное
// поведение), однако явное ОтключитьОбработчикОжидания — защитный приём на
// случай повторного подключения (например, если форма переоткрывается без
// полного пересоздания) и соответствует рекомендации AI-аудита UI-12.
//
&НаКлиенте
Процедура ПриЗакрытии()

	Если ШапкаПульсАктивен Тогда
		ОтключитьОбработчикОжидания("ОбновитьПульс");
	КонецЕсли;

	// Спека 4.1: автообновление идущего запуска выключается при закрытии формы.
	ОтключитьОбработчикОжидания("АвтообновлениеЗапуска");

КонецПроцедуры

// UI-12: периодический пересчёт текста ДекорацияПульс «на тике» таймера.
//
// Пересчёт выполняется полностью на клиенте — без обращения к серверу
// (вариант A): N = Цел(ТекущаяДата() - ШапкаПоследнийПульс), формула совпадает с
// серверной ПредставлениеПульса (используемой при первом заполнении в
// ЗаполнитьШапку). ШапкаПоследнийПульс — серверное время (ТекущаяДатаСеанса()
// на момент ar_AuditЗапуски.Heartbeat), ТекущаяДата() — клиентское (платформенный
// глобальный метод, доступный в клиентском контексте; ТекущаяДатаСеанса —
// серверный, здесь неприменим). Для типовых инсталляций 1С (клиент/сервер
// синхронизированы по NTP) расхождение несущественно (см. «Риски» в спеке UI-12).
//
&НаКлиенте
Процедура ОбновитьПульс()

	Элементы.ДекорацияПульс.Заголовок = ПредставлениеПульсаНаКлиенте(
		ШапкаПоследнийПульс, ТекущаяДата());

КонецПроцедуры

// UI-12: интервал клиентского таймера автообновления индикатора пульса, сек.
// Выделен в отдельную функцию вместо магического числа в ПодключитьОбработчикОжидания.
// Выбран компромисс между «живостью» индикатора (1 сек, см. п.5 спеки UI-12) и
// нагрузкой при нескольких одновременно открытых формах Run Viewer (5 сек —
// нижняя половина рекомендованного спекой диапазона 1-15 сек).
//
// Возвращаемое значение:
//   Число - интервал автообновления в секундах.
//
&НаКлиенте
Функция ИнтервалПульсаСек()
	Возврат 5;
КонецФункции

// Спека 4.1: период автообновления счётчиков идущего запуска, сек. Пять секунд -
// нижняя граница требования «не чаще раза в 5 с»; на каждом тике выполняется
// один серверный вызов (шапка и секция ожидающих подтверждений).
//
// Возвращаемое значение:
//   Число - интервал автообновления в секундах.
//
&НаКлиенте
Функция ИнтервалАвтообновленияСек()
	Возврат 5;
КонецФункции

// Спека 4.1: обработчик ожидания - обновляет шапку со счётчиками и секцию
// ожидающих подтверждений идущего запуска. Как только запуск перешел в финальный
// статус, автообновление выключается (дерево событий и итоговые счётчики
// обновляются командой «Обновить»).
//
&НаКлиенте
Процедура АвтообновлениеЗапуска()

	Если ШапкаСтатусФинальный Тогда
		ОтключитьОбработчикОжидания("АвтообновлениеЗапуска");
		Возврат;
	КонецЕсли;

	ОбновитьСчетчикиЗапускаНаСервере();
	ОбновитьПульс();

	Если ШапкаСтатусФинальный Тогда
		ОтключитьОбработчикОжидания("АвтообновлениеЗапуска");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Спека 4.4: смена отбора по типу события перестраивает дерево событий
// (отбор применяется на сервере при построении дерева).
//
// Параметры:
//   Элемент - ПолеФормы - поле отбора (значение уже записано в реквизит формы).
//
&НаКлиенте
Процедура ФильтрТипаСобытияПриИзменении(Элемент)

	ПостроитьДеревоНаСервере();
	РазвернутьКорневыеУзлы();

КонецПроцедуры

// Перестраивает дерево событий по текущему отбору (без перезагрузки шапки и
// секций карточки).
//
&НаСервере
Процедура ПостроитьДеревоНаСервере()
	ПостроитьДерево(ИдентификаторЗапуска);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоШаговПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ДеревоШагов.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиПусто;
		Элементы.КнопкаПоказатьПромпт.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	ОбновитьДеталиУзла(ТекущиеДанные.ПолучитьИдентификатор());
	ОбновитьВидимостьКнопкиПромпт(ТекущиеДанные);

КонецПроцедуры

// UI-11: видимость КнопкаПоказатьПромпт - для узлов «Событие» с непустым
// массивом messages в payload: LLMCalled (промпт шага агента) и НадзорРешение
// (системный промпт и сводка надзора, agentrunner-68 спека Г.4).
// ТипСобытияИмя читается из дерева (без серверного запроса), наличие messages
// проверяется отдельным дешёвым серверным вызовом.
//
// Параметры:
//   ТекущиеДанные - СтрокаДереваЗначений - текущая строка реквизита формы
//                   ДеревоШагов (колонки Тип, ТипСобытияИмя, Последовательность).
//
&НаКлиенте
Процедура ОбновитьВидимостьКнопкиПромпт(Знач ТекущиеДанные)

	Если ТекущиеДанные.Тип <> "Событие"
		Или (ТекущиеДанные.ТипСобытияИмя <> "ВызванLLM"
			И ТекущиеДанные.ТипСобытияИмя <> "НадзорРешение") Тогда
		Элементы.КнопкаПоказатьПромпт.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.КнопкаПоказатьПромпт.Видимость = ЕстьСообщенияПромптДляУзлаНаСервере(ТекущиеДанные.Последовательность);

КонецПроцедуры

// CONS-06 (D2): клик/выбор строки секции «Созданные объекты 1С» открывает объект.
// Серверное разыменование через ar_Утилиты.ОбъектИзНавигационнойСсылки (round-trip
// фикс ROREF-01/03) + асинхронный ПоказатьЗначение. Для значений, которые не удалось
// разыменовать (не навигационная ссылка) - ничего не открываем, текст и так
// показан в колонке ОбъектТекст (см. ЗаполнитьСозданныеОбъекты).
//
&НаКлиенте
Процедура СозданныеОбъектыВыборСтроки(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.СозданныеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.НавигационнаяСсылка) Тогда
		Возврат;
	КонецЕсли;

	Объект = ОбъектИзНавигационнойСсылкиНаСервере(ТекущиеДанные.НавигационнаяСсылка);

	Если Объект = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Результат не является ссылкой на объект и показан как текст.';
			|en = 'Result is not an object reference and is shown as text.'"));
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(, Объект);

КонецПроцедуры

// CONS-06: при переключении строки секции «Ожидает подтверждения» пересчитывает
// доступность кнопок «Подтвердить»/«Отклонить» - для решённых записей (история,
// ЭтоИстория = Истина) команды принятия решения недоступны (D4), повторное
// решение по уже обработанной записи бессмысленно и приведёт к status_mismatch
// в ar_Подтверждение.Принять/Отклонить.
//
// Параметры:
//   Элемент - ПолеТабличногоДокумента, Таблица - элемент формы ОжидаетПодтверждения
//             (стандартный параметр события ПриАктивизацииСтроки, не используется).
//
&НаКлиенте
Процедура ОжидаетПодтвержденияПриАктивизацииСтроки(Элемент)

	ОбновитьДоступностьКнопокПодтверждения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Спека 4.1: обновление шапки, счётчиков и дерева событий по требованию
// оператора. Применяется и к завершенным запускам (автообновление у них
// выключено).
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_Обновить (параметры не используются).
//
&НаКлиенте
Процедура ar_Обновить(Команда)

	ЗагрузитьДанныеЗапускаНаСервере();
	РазвернутьКорневыеУзлы();
	ОбновитьПульс();

КонецПроцедуры

// UI-11: модальный просмотр полного промпта (массив сообщений LLM-вызова) для
// выбранного узла «Событие»/LLMCalled. Переиспользует CommonForm.ar_ФормаПросмотраPrompt
// (UI-03) — вкладки «Системный»/«Инструкция» скрываются (UI-11 показывает фактический
// массив сообщений запуска, а не сборку системного промпта агента).
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_ПоказатьПромпт (параметры не используются).
//
&НаКлиенте
Процедура ar_ПоказатьПромпт(Команда)

	ТекущиеДанные = Элементы.ДеревоШагов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Защитная проверка: команда осмыслена только для узлов «Событие» (LLMCalled) —
	// кнопка для остальных узлов скрыта (ОбновитьВидимостьКнопкиПромпт), но
	// команда формы технически может быть вызвана и иначе (например, с клавиатуры).
	Если ТекущиеДанные.Тип <> "Событие" Тогда
		Возврат;
	КонецЕсли;

	РезультатПросмотра = ПолучитьПромптДляУзлаНаСервере(ТекущиеДанные.Последовательность);

	Если Не РезультатПросмотра.ЕстьСообщения Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Промпт для этого шага не сохранён.';
			|en = 'Prompt for this step was not saved.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстПромпт", РезультатПросмотра.ТекстПромпт);
	ПараметрыФормы.Вставить("СистемныйПромпт", "");
	ПараметрыФормы.Вставить("ИнструкцияПромпт", "");
	ПараметрыФормы.Вставить("ИмяМодели", РезультатПросмотра.ИмяМодели);
	// UI-11: показываем фактический массив messages LLM-вызова — вкладки
	// «Системный»/«Инструкция» (сборка промпта агента, UI-03) здесь неприменимы.
	ПараметрыФормы.Вставить("СкрытьСистемныйИИнструкцию", Истина);

	ЗаголовокОкна = СтрШаблон(
		НСтр("ru = 'Промпт запуска %1, шаг %2'; en = 'Prompt for run %1, step %2'"),
		ИдентификаторЗапуска, Формат(ТекущиеДанные.Последовательность, "ЧГ=0; ЧДЦ=0"));
	ПараметрыФормы.Вставить("ЗаголовокФормы", ЗаголовокОкна);

	// ОткрытьФормуМодально запрещён при работе без модальности (веб-клиент):
	// "Using modal windows is not allowed in this mode!". Возвращаемое значение
	// формы здесь не используется - это просмотр промпта, поэтому достаточно
	// обычного ОткрытьФорму с блокировкой окна владельца.
	ОткрытьФорму("ОбщаяФорма.ar_ФормаПросмотраPrompt", ПараметрыФормы, ЭтотОбъект,
		, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// agentrunner-55: полный текст ответа инструмента выбранного вызова - в окне
// просмотра ar_ФормаПросмотраPrompt (параметры ТекстПромпт/ЗаголовокФормы, как
// ar_ПоказатьПромпт). Кнопка доступна только при сохранённом ответе
// (ЗаполнитьДеталиВызоваИнструмента), ответ дополнительно маскируется при показе.
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_ОткрытьОтветПолностью (не используется).
//
&НаКлиенте
Процедура ar_ОткрытьОтветПолностью(Команда)

	ТекущиеДанные = Элементы.ДеревоШагов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РезультатПросмотра = ПолучитьОтветИнструментаНаСервере(ТекущиеДанные.Последовательность);

	Если Не РезультатПросмотра.ЕстьОтвет Тогда
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Ответ инструмента для этого шага не сохранён.';
			|en = 'Tool response for this step was not saved.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстПромпт", РезультатПросмотра.ТекстОтвета);
	ПараметрыФормы.Вставить("СистемныйПромпт", "");
	ПараметрыФормы.Вставить("ИнструкцияПромпт", "");
	ПараметрыФормы.Вставить("ИмяМодели", "");
	// Показываем только текст ответа - вкладки «Системный»/«Инструкция» неприменимы
	// (тот же приём, что в ar_ПоказатьПромпт).
	ПараметрыФормы.Вставить("СкрытьСистемныйИИнструкцию", Истина);
	ЗаголовокОкна = СтрШаблон(
		НСтр("ru = 'Ответ инструмента %1'; en = 'Tool response of %1'"),
		РезультатПросмотра.ИмяИнструмента);
	ПараметрыФормы.Вставить("ЗаголовокФормы", ЗаголовокОкна);

	ОткрытьФорму("ОбщаяФорма.ar_ФормаПросмотраPrompt", ПараметрыФормы, ЭтотОбъект,
		, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// UI-13: возобновление Interrupted-запуска вручную из Run Viewer.
//
// 1. Клиентский диалог подтверждения (ВопросАсинх, Да/Нет) — предупреждает
//    оператора о риске повторного выполнения мутирующих действий (Plan §3.1).
// 2. При подтверждении — кнопка временно недоступна (защита от повторного
//    клика, UC-3), серверный вызов ar_RuntimeЗапуск.Возобновить(ИдентификаторЗапуска)
//    (через ВозобновитьНаСервере).
// 3. Результат обрабатывается по 4 веткам (UC-1..4 спеки UI-13):
//     * Успех = Истина                          — UC-1, шапка перечитывается,
//       кнопка скрывается (статус более не Interrupted).
//     * Причина = "snapshot_missing_or_incompatible" — UC-2, информативное
//       сообщение, кнопка остаётся видимой/доступной.
//     * Причина = "already_running"             — UC-3, шапка перечитывается
//       (кнопка скроется сама, если статус сменился).
//     * Причина = "unexpected_status: ..." / "run_not_found" — UC-4 и граничный
//       случай, шапка перечитывается.
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_Возобновить (параметры не используются).
//
&НаКлиенте
Асинх Процедура ar_Возобновить(Команда)

	ТекстВопроса = НСтр(
		"ru = 'Возобновить прерванный запуск?
		|Если запуск был прерван во время выполнения шага, повторный запуск
		|может привести к повторному выполнению уже начатых мутирующих действий.
		|Продолжить?';
		|en = 'Resume the interrupted run?
		|If the run was interrupted during a step, resuming may cause already
		|started mutating actions to run again.
		|Continue?'");

	Ответ = Ждать ВопросАсинх(
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет,
		НСтр("ru = 'Возобновление запуска'; en = 'Resume run'"));

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// UC-3 (граничный случай «двойной клик»): отключаем кнопку на время
	// серверного вызова, включаем обратно только если запуск не возобновился.
	Элементы.КнопкаВозобновить.Доступность = Ложь;

	Результат = ВозобновитьНаСервере();

	// В обоих случаях статус мог измениться (UC-1: Interrupted → Running;
	// UC-3: уже Running) — перечитываем шапку/видимость кнопки (ЗаполнитьШапку,
	// см. ПрочитатьШапкуЗапуска/ЗаполнитьШапку, UI-10/UI-12). Делаем это до
	// разбора Результат.Успех — ОбновитьШапкуПослеВозобновленияНаСервере сама
	// скрывает кнопку, если статус более не Interrupted.
	ОбновитьШапкуПослеВозобновленияНаСервере();

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Запуск возобновлён'; en = 'Run resumed'"));

		// UI-12 (опционально по спеке UI-13, п. UC-1): при успешном resume статус
		// сменился на Running (нефинальный) — ОбновитьШапкуПослеВозобновленияНаСервере
		// (через ЗаполнитьШапку) пересчитала ШапкаПульсАктивен в Истина,
		// переподключаем таймер автообновления индикатора без перезакрытия формы.
		// Двойное подключение не возникает: кнопка скрыта после успешного resume,
		// повторный вызов ar_Возобновить невозможен.
		Если ШапкаПульсАктивен Тогда
			ПодключитьОбработчикОжидания("ОбновитьПульс", ИнтервалПульсаСек(), Ложь);
		КонецЕсли;
	Иначе
		// CONS-05: сопоставление кода причины и локализованного текста вынесено
		// в ar_Утилиты.ТекстПричиныОтказаResume - та же логика нужна форме
		// ar_КонсольАгентов, дублировать текст в двух формах запрещено правилом
		// проекта (см. .docs/specs/CONS-05.md, раздел "Риски").
		ТекстСообщения = ar_Утилиты.ТекстПричиныОтказаResume(Результат.Причина);
		Ждать ПредупреждениеАсинх(ТекстСообщения);

		// Кнопка осталась видимой (статус не изменился) — возвращаем доступность,
		// снятую перед серверным вызовом. При успехе кнопка скрыта
		// ОбновитьШапкуПослеВозобновленияНаСервере, восстанавливать Доступность не нужно.
		Элементы.КнопкаВозобновить.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

// UI-13: серверный вызов ar_RuntimeЗапуск.Возобновить(ИдентификаторЗапуска). ИдентификаторЗапуска — реквизит
// формы (заполняется в ОпределитьИдентификаторЗапускаИзПараметров), отдельных параметров нет.
//
// Привилегированный режим не используется — вызов идёт в уже привилегированные
// модули ar_RuntimeЗапуск → ar_AuditЗапуски (RT-02/RT-03, см. «Граничные случаи»
// спеки UI-13).
//
// Возвращаемое значение:
//   Структура - {Успех: Булево, ИдентификаторЗапуска: Строка, Причина: Строка}, см.
//   ar_RuntimeЗапуск.Возобновить. Успех = Ложь и Причина = "internal_error: ..."
//   при непредвиденном исключении на сервере.
//
&НаСервере
Функция ВозобновитьНаСервере()

	Попытка
		Результат = ar_RuntimeЗапуск.Возобновить(ИдентификаторЗапуска);
	Исключение
		// Непредвиденная серверная ошибка (например, недоступность БД) —
		// не пробрасываем исключение на клиент, возвращаем как unexpected-результат
		// (UC-4 ветка ТекстРезультатаResume обработает по умолчанию).
		Результат = Новый Структура;
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("ИдентификаторЗапуска", ИдентификаторЗапуска);
		Результат.Вставить("Причина", "internal_error: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// D10: фиксируем audit-событие ручного резюме при успехе. Ошибка записи
	// события не пробрасывается (ar_AuditСобытия.Зафиксировать не выбрасывает
	// исключений) — Результат успешного resume не зависит от этого вызова.
	Если Результат.Успех Тогда
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("initiated_by", "ui");
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(ИдентификаторЗапуска, "run_resumed_manually", ПолезнаяНагрузка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// UI-13: перечитывает шапку запуска после возобновления (успешного или нет) — статус
// мог измениться (UC-1: Interrupted → Running; UC-3: возможно уже Running).
// Переиспользует ПрочитатьШапкуЗапуска/ЗаполнитьШапку (UI-10/UI-12, без изменения
// интерфейса) — ЗаполнитьШапку пересчитывает ШапкаПульсАктивен, а видимость
// КнопкаВозобновить (видна только для Interrupted) пересчитывается здесь же,
// дополнительно (см. комментарий ниже).
//
// Параметры: нет (ИдентификаторЗапуска — реквизит формы).
//
&НаСервере
Процедура ОбновитьШапкуПослеВозобновленияНаСервере()

	Шапка = ПрочитатьШапкуЗапуска(ИдентификаторЗапуска);
	Если Шапка = Неопределено Тогда
		// Запись удалена между вызовами (крайне редкий граничный случай) —
		// оставляем форму как есть, отдельный режим заглушки не требуется
		// (ПоказатьПредупреждение про run_not_found уже показан выше).
		Возврат;
	КонецЕсли;

	ЗаполнитьШапку(Шапка);

	// ЗаполнитьШапку не трогает видимость КнопкаВозобновить (это делает только
	// ПриСозданииНаСервере) — пересчитываем здесь по тому же правилу UI-10.
	Элементы.КнопкаВозобновить.Видимость =
		(Шапка.Статус = Перечисления.ar_СтатусЗапуска.Прерван);

КонецПроцедуры

// CONS-06 (D4): подтвердить действие из очереди approval ПО ТЕКУЩЕЙ СТРОКЕ карточки
// запуска, без перехода в ОбщаяФорма.ar_ОчередьПодтверждений. Решение принимает
// готовый ar_Подтверждение.Принять - логика approve/исполнения (шаги 1-5 внутри) не
// дублируется, здесь только чтение текущей строки и разбор результата по образцу
// ВыполнитьApprove из ar_ОчередьПодтверждений (три ветки: успех+выполнено /
// успех-не выполнено / неуспех).
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_ПодтвердитьЗапись (не используется).
//
&НаКлиенте
Асинх Процедура ar_ПодтвердитьЗапись(Команда)

	ТекущиеДанные = Элементы.ОжидаетПодтверждения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.ЭтоИстория Тогда
		// Защитная проверка: команда для решённых записей недоступна
		// (ОбновитьДоступностьКнопокПодтверждения), но могла быть вызвана иначе
		// (например, с клавиатуры) - см. аналогичную защиту в ar_ПоказатьПромпт.
		Возврат;
	КонецЕсли;

	Результат = ПринятьПодтверждениеНаСервере(ТекущиеДанные.ИдентификаторПодтверждения);

	Если Результат.Успех Тогда
		Если Результат.ДействиеВыполнено Тогда
			ТекстУспеха = НСтр("ru = 'Принято'; en = 'Approved'");
			Если Результат.ДокументСсылка = Неопределено Тогда
				ПояснениеУспеха = НСтр("ru = 'Действие выполнено'; en = 'Action executed'");
			Иначе
				ПояснениеУспеха = СтрШаблон(
					НСтр("ru = 'Создан объект: %1'; en = 'Object created: %1'"),
					Строка(Результат.ДокументСсылка));
			КонецЕсли;
			ПоказатьОповещениеПользователя(ТекстУспеха, , ПояснениеУспеха);
		Иначе
			Если ПустаяСтрока(Результат.ДействиеСообщение) Тогда
				ПричинаНевыполнения = НСтр("ru = 'причина не указана'; en = 'no reason given'");
			Иначе
				ПричинаНевыполнения = Результат.ДействиеСообщение;
			КонецЕсли;
			ТекстПредупреждения = СтрШаблон(
				НСтр("ru = 'Решение принято, но действие не выполнено: %1
					|
					|Подробности - в служебном логе (ar_ПоказатьЛог).';
					|en = 'Decision recorded, but the action was not executed: %1
					|
					|See the service log (ar_ПоказатьЛог) for details.'"),
				ПричинаНевыполнения);
			Ждать ПредупреждениеАсинх(ТекстПредупреждения);
		КонецЕсли;
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось принять действие: %1'; en = 'Failed to approve action: %1'"),
			Результат.Причина);
		Ждать ПредупреждениеАсинх(ТекстОшибки);
	КонецЕсли;

	ЗаполнитьОжидаетПодтвержденияНаСервере();
	ОбновитьДоступностьКнопокПодтверждения();

КонецПроцедуры

// CONS-06 (D4): отклонить действие из очереди approval ПО ТЕКУЩЕЙ СТРОКЕ карточки.
// Причина отказа читается из штатного реквизита формы ПричинаОтказаПодтверждения (поле
// ввода рядом с кнопками) - НЕ из DOM, в отличие от ar_ОчередьПодтверждений (там
// причина читается из HTML-поля, здесь секция построена на штатных элементах
// формы, см. риск «двойное определение поля причины» в .docs/specs/CONS-06.md).
//
// Параметры:
//   Команда - КомандаФормы - команда формы ar_ОтклонитьЗапись (не используется).
//
&НаКлиенте
Асинх Процедура ar_ОтклонитьЗапись(Команда)

	ТекущиеДанные = Элементы.ОжидаетПодтверждения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.ЭтоИстория Тогда
		Возврат;
	КонецЕсли;

	Результат = ОтклонитьПодтверждениеНаСервере(ТекущиеДанные.ИдентификаторПодтверждения, ПричинаОтказаПодтверждения);

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отклонено'; en = 'Rejected'"));
		ПричинаОтказаПодтверждения = "";
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось отклонить действие: %1'; en = 'Failed to reject action: %1'"),
			Результат.Причина);
		Ждать ПредупреждениеАсинх(ТекстОшибки);
	КонецЕсли;

	ЗаполнитьОжидаетПодтвержденияНаСервере();
	ОбновитьДоступностьКнопокПодтверждения();

КонецПроцедуры

// CONS-06: пересчитывает доступность командной панели секции «Ожидает
// подтверждения» - для решённых записей (ЭтоИстория = Истина) кнопки
// «Подтвердить»/«Отклонить» недоступны (D4), для пустой выборки (нет текущей
// строки) - тоже недоступны.
//
&НаКлиенте
Процедура ОбновитьДоступностьКнопокПодтверждения()

	ТекущиеДанные = Элементы.ОжидаетПодтверждения.ТекущиеДанные;
	ДоступноРешение = (ТекущиеДанные <> Неопределено) И (Не ТекущиеДанные.ЭтоИстория)
		И ТекущийПользовательМожетУправлятьПодтверждением;

	Элементы.КнопкаПодтвердитьЗапись.Доступность = ДоступноРешение;
	Элементы.КнопкаОтклонитьЗапись.Доступность = ДоступноРешение;
	Элементы.ПричинаОтказаПодтверждения.Доступность = ДоступноРешение;

КонецПроцедуры

&НаСервере
Функция ПринятьПодтверждениеНаСервере(Знач ИдентификаторПодтверждения)
	Возврат ar_Подтверждение.Принять(ИдентификаторПодтверждения, Пользователи.ТекущийПользователь());
КонецФункции

&НаСервере
Функция ОтклонитьПодтверждениеНаСервере(Знач ИдентификаторПодтверждения, Знач Причина)
	Возврат ar_Подтверждение.Отклонить(ИдентификаторПодтверждения, Пользователи.ТекущийПользователь(), Причина);
КонецФункции

&НаСервере
Процедура ЗаполнитьОжидаетПодтвержденияНаСервере()
	ЗаполнитьОжидаетПодтверждения(ИдентификаторЗапуска);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разворачивает корневые узлы дерева шагов (первый уровень) - после
// перестроения дерева раскрытие сбрасывается, а узел запуска у оператора один.
// Развернуть() - клиентский метод, из серверного ПостроитьДерево недоступен.
//
&НаКлиенте
Процедура РазвернутьКорневыеУзлы()

	Для Каждого СтрокаКорня Из ДеревоШагов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоШагов.Развернуть(СтрокаКорня.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОпределитьИдентификаторЗапускаИзПараметров()

	Значение = "";
	Если Параметры.Свойство("ИдентификаторЗапуска", Значение) И ТипЗнч(Значение) = Тип("Строка")
		И НЕ ПустаяСтрока(Значение) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	// Обратная совместимость: ar_Диалог открывает карточку с историческим
	// именем параметра "RunId" (переименован в "ИдентификаторЗапуска" русификацией 96e7e2d,
	// но вызывающие формы не обновлены) - без этой ветки открытие из чата давало
	// заглушку "Запуск не найден".
	Если Параметры.Свойство("RunId", Значение) И ТипЗнч(Значение) = Тип("Строка")
		И НЕ ПустаяСтрока(Значение) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	// Альтернативное открытие из динамического списка — по ключу записи регистра.
	Ключ = Неопределено;
	Если Параметры.Свойство("Ключ", Ключ)
		И ТипЗнч(Ключ) = Тип("РегистрСведенийКлючЗаписи.ar_Запуски") Тогда
		Возврат СокрЛП(Ключ.ar_ИдентификаторЗапуска);
	КонецЕсли;

	Возврат "";

КонецФункции

// Счётчики идущего запуска по его событиям (спека 4.2): шаги - количество
// вызовов модели, токены - сумма tokens_in/tokens_out из полезной нагрузки
// событий ВызванLLM (ключи подтверждены кодом записи события:
// ar_RuntimeЦикл.МетрикиСобытияLLM).
//
// Параметры:
//   ЗначениеИдентификатораЗапуска - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//   Структура - с ключами:
//     * Шагов        - Число - количество событий ВызванLLM;
//     * ТокеновВход  - Число - сумма tokens_in;
//     * ТокеновВыход - Число - сумма tokens_out;
//     * ЕстьТокены   - Булево - ключи tokens_* есть хотя бы в одном событии
//                      (иначе токены не показываются вовсе - прочерк, а не 0).
//
&НаСервереБезКонтекста
Функция СчетчикиПоСобытиямЗапуска(Знач ЗначениеИдентификатораЗапуска)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	Запрос.УстановитьПараметр("ТипСобытия", Перечисления.ar_ТипСобытия.ВызванLLM);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	События.ar_PayloadJSON КАК PayloadJSON
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|	И События.ar_ТипСобытия = &ТипСобытия
	|УПОРЯДОЧИТЬ ПО
	|	События.ar_Sequence";

	Результат = Новый Структура("Шагов, ТокеновВход, ТокеновВыход, ЕстьТокены", 0, 0, 0, Ложь);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Результат.Шагов = Результат.Шагов + 1;

		Payload = ar_JSON.ИзJSON(Выборка.PayloadJSON);
		Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ТокеновВход = Payload.Получить("tokens_in");
		ТокеновВыход = Payload.Получить("tokens_out");
		Если ТипЗнч(ТокеновВход) <> Тип("Число") И ТипЗнч(ТокеновВыход) <> Тип("Число") Тогда
			Продолжить;
		КонецЕсли;

		Результат.ЕстьТокены = Истина;
		Если ТипЗнч(ТокеновВход) = Тип("Число") Тогда
			Результат.ТокеновВход = Результат.ТокеновВход + ТокеновВход;
		КонецЕсли;
		Если ТипЗнч(ТокеновВыход) = Тип("Число") Тогда
			Результат.ТокеновВыход = Результат.ТокеновВыход + ТокеновВыход;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет список отбора по типу события в дереве событий (спека 4.4).
//
&НаСервере
Процедура ЗаполнитьОтборТиповСобытий()

	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Очистить();
	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Добавить(ОтборВсеСобытия(),
		НСтр("ru = 'Все'; en = 'All'"));
	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Добавить(ОтборВызовыИнструментов(),
		НСтр("ru = 'Вызовы инструментов'; en = 'Tool calls'"));
	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Добавить(ОтборОтказыИЗапреты(),
		НСтр("ru = 'Отказы и запреты'; en = 'Denials and restrictions'"));
	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Добавить(ОтборОшибки(),
		НСтр("ru = 'Ошибки'; en = 'Errors'"));
	// agentrunner-68 (спека Г.3): отбор событий надзора.
	Элементы.ФильтрТипаСобытияПоле.СписокВыбора.Добавить(ОтборНадзора(),
		НСтр("ru = 'Надзор'; en = 'Supervision'"));

	Если ПустаяСтрока(ФильтрТипаСобытия) Тогда
		ФильтрТипаСобытия = ОтборВсеСобытия();
	КонецЕсли;

КонецПроцедуры

// Проверяет, что строка дерева событий подходит под выбранный отбор (спека 4.4).
//
// Параметры:
//   Фильтр     - Строка - значение отбора (см. ЗаполнитьОтборТиповСобытий).
//   ТипСтроки  - Строка - "Событие" или "ВызовИнструмента" (колонка Тип дерева).
//   ТипСобытия - ПеречислениеСсылка.ar_ТипСобытия - тип события строки.
//
// Возвращаемое значение:
//   Булево
//
&НаСервереБезКонтекста
Функция СтрокаСобытияПоФильтру(Знач Фильтр, Знач ТипСтроки, Знач ТипСобытия)

	Если Фильтр = ОтборВызовыИнструментов() Тогда
		Возврат ТипСтроки = "ВызовИнструмента"
			Или ТипСобытия = Перечисления.ar_ТипСобытия.ВызванИнструмент;
	ИначеЕсли Фильтр = ОтборОтказыИЗапреты() Тогда
		Возврат ТипСобытия = Перечисления.ar_ТипСобытия.Запрещён
			Или ТипСобытия = Перечисления.ar_ТипСобытия.Отклонён;
	ИначеЕсли Фильтр = ОтборОшибки() Тогда
		Возврат ТипСобытия = Перечисления.ar_ТипСобытия.Ошибка
			Или ТипСобытия = Перечисления.ar_ТипСобытия.ОшибкаВыполненияДействия
			Или ТипСобытия = Перечисления.ar_ТипСобытия.ОшибкаХука;
	ИначеЕсли Фильтр = ОтборНадзора() Тогда
		// agentrunner-68 (спека Г.3): события надзора и запуски продолжений.
		Возврат ТипСобытия = Перечисления.ar_ТипСобытия.НадзорВызван
			Или ТипСобытия = Перечисления.ar_ТипСобытия.НадзорРешение
			Или ТипСобытия = Перечисления.ar_ТипСобытия.ПродолжениеСтартовало;
	Иначе
		// «Все» и пустое значение отбора - дерево строится целиком.
		Возврат Истина;
	КонецЕсли;

КонецФункции

// Ключи отбора по типу события в дереве событий. Ключи строковые (значения
// передаются в серверные вызовы и сравниваются без учета локализации интерфейса).
//
// Возвращаемое значение:
//   Строка
//
&НаСервереБезКонтекста
Функция ОтборВсеСобытия()
	Возврат "Все";
КонецФункции

&НаСервереБезКонтекста
Функция ОтборВызовыИнструментов()
	Возврат "ВызовыИнструментов";
КонецФункции

&НаСервереБезКонтекста
Функция ОтборОтказыИЗапреты()
	Возврат "ОтказыИЗапреты";
КонецФункции

&НаСервереБезКонтекста
Функция ОтборОшибки()
	Возврат "Ошибки";
КонецФункции

&НаСервереБезКонтекста
Функция ОтборНадзора()
	Возврат "Надзор";
КонецФункции

// Читает шапку запуска через менеджер записи регистра ar_Запуски.
// Привилегированный режим не используется — доступ регулируется ролями.
//
// Возвращаемое значение:
//   Структура - поля шапки запуска; Неопределено, если запись не найдена.
//
&НаСервере
Функция ПрочитатьШапкуЗапуска(Знач ЗначениеИдентификатораЗапуска)

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ИдентификаторЗапуска = ЗначениеИдентификатораЗапуска;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Статус", МенеджерЗаписи.ar_Статус);
	Результат.Вставить("Агент", МенеджерЗаписи.ar_АгентРеф);
	Результат.Вставить("Диалог", МенеджерЗаписи.ar_Диалог);
	Результат.Вставить("СтартовалВ", МенеджерЗаписи.ar_СтартовалВ);
	Результат.Вставить("ЗавершенВ", МенеджерЗаписи.ar_ЗавершенВ);
	Результат.Вставить("Триггер", МенеджерЗаписи.ar_Триггер);
	Результат.Вставить("Пользователь", МенеджерЗаписи.ar_ПользовательРеф);
	Результат.Вставить("ТокеновВход", МенеджерЗаписи.ar_ТокеновВход);
	Результат.Вставить("ТокеновВыход", МенеджерЗаписи.ar_ТокеновВыход);
	Результат.Вставить("СтоимостьРуб", МенеджерЗаписи.ar_СтоимостьРуб);
	Результат.Вставить("ШаговВсего", МенеджерЗаписи.ar_ШаговВсего);
	Результат.Вставить("РодительскийИдентификаторЗапуска", МенеджерЗаписи.ar_РодительскийИдентификаторЗапуска);
	Результат.Вставить("ПоследнийПульс", МенеджерЗаписи.ar_ПоследнийПульс);
	// agentrunner-68 (спека Г.5): строка надзора в шапке - продолжений сделано
	// и последнее решение надзора.
	Результат.Вставить("ПродолженийСделано", МенеджерЗаписи.ar_ПродолженийСделано);
	Результат.Вставить("ПоследнееРешениеНадзора", МенеджерЗаписи.ar_ПоследнееРешениеНадзора);
	Результат.Вставить("ЕстьСнимок", ЗначениеЗаполнено(МенеджерЗаписи.ar_StateSnapshot));

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьШапку(Знач Шапка)

	ЗначениеПрочерк = Прочерк();

	ШапкаСтатус = Шапка.Статус;
	ШапкаАгент = Шапка.Агент;
	ШапкаТриггер = ?(ПустаяСтрока(Шапка.Триггер), ЗначениеПрочерк, Шапка.Триггер);
	ШапкаПользователь = Шапка.Пользователь;
	ШапкаДиалог = Шапка.Диалог;

	// agentrunner-11: ноль - факт, печатается цифрой (ЧН в ЦелоеСтрокой/ЧН=0,00;
	// без ЧН Формат печатал пустую строку - «Токены вх/вых: /»).
	ШапкаСтатусФинальный = СтатусФинальный(Шапка.Статус);

	// Спека 4.1/4.2: итоговые счётчики пишет ядро при завершении запуска
	// (ar_AuditЗапуски.Создать/Завершить), поэтому у идущего запуска шаги и
	// токены считаются по его событиям: шаги - количество вызовов модели,
	// токены - сумма из полезной нагрузки событий ВызванLLM.
	СчетчикиСобытий = ?(ШапкаСтатусФинальный, Неопределено, СчетчикиПоСобытиямЗапуска(ИдентификаторЗапуска));

	Если СчетчикиСобытий = Неопределено Тогда
		ШапкаШагов = ЦелоеСтрокой(Шапка.ШаговВсего);
	Иначе
		ШапкаШагов = ЦелоеСтрокой(СчетчикиСобытий.Шагов);
	КонецЕсли;

	Если СчетчикиСобытий = Неопределено Тогда
		// Финальный статус: итоги токенов пишет ядро при завершении запуска.
		ШапкаТокены = СтрШаблон("%1 / %2",
			ЦелоеСтрокой(Шапка.ТокеновВход),
			ЦелоеСтрокой(Шапка.ТокеновВыход));
	ИначеЕсли СчетчикиСобытий.ЕстьТокены Тогда
		// Идущий запуск: сумма из полезной нагрузки событий ВызванLLM (итоги
		// ядра до завершения не заполнены - показывались бы ложные «0 / 0»).
		ШапкаТокены = СтрШаблон("%1 / %2",
			ЦелоеСтрокой(СчетчикиСобытий.ТокеновВход),
			ЦелоеСтрокой(СчетчикиСобытий.ТокеновВыход));
	Иначе
		// Ключей tokens_* нет ни в одном событии запуска - прочерк вместо
		// ложного нуля (спека 4.2).
		ШапкаТокены = СтрШаблон("%1 / %2", Прочерк(), Прочерк());
	КонецЕсли;

	ШапкаСтоимость = Формат(Шапка.СтоимостьРуб, "ЧН=0,00; ЧДЦ=2");

	// agentrunner-68 (спека Г.5): строка «Надзор: продолжений N, последнее
	// решение X». У запуска без надзора (продолжений нет и решение не
	// фиксировалось) - прочерк.
	Если Шапка.ПродолженийСделано > 0 ИЛИ Не ПустаяСтрока(Шапка.ПоследнееРешениеНадзора) Тогда
		ШапкаНадзор = СтрШаблон(
			НСтр("ru = 'продолжений %1, последнее решение %2'; en = '%1 continuations, latest decision %2'"),
			ЦелоеСтрокой(Шапка.ПродолженийСделано), Шапка.ПоследнееРешениеНадзора);
	Иначе
		ШапкаНадзор = ЗначениеПрочерк;
	КонецЕсли;

	// agentrunner-11: правила длительности agentrunner-9 (сек/мин/ч/д; для пауз
	// «<работа> · ждёт <ожидание>» по ar_ПоследнийПульс). У идущего запуска
	// ar_ЗавершенВ пуст - длительность считается от старта до текущего момента.
	ШапкаДлительность = ПредставлениеДлительности(Шапка.СтартовалВ, Шапка.ЗавершенВ,
		Шапка.Статус, Шапка.ПоследнийПульс);

	// Детали для узла «Запуск».
	ДетальЗапускИдентификаторЗапуска = ИдентификаторЗапуска;
	ДетальЗапускРодитель = ?(ПустаяСтрока(Шапка.РодительскийИдентификаторЗапуска), ЗначениеПрочерк, Шапка.РодительскийИдентификаторЗапуска);

	// UI-12: «Пульс: N сек назад» вместо сырой даты. ШапкаПоследнийПульс
	// сохраняется в реквизит формы — клиентский таймер (ОбновитьПульс)
	// пересчитывает текст без повторного серверного запроса (вариант A).
	ШапкаПоследнийПульс = Шапка.ПоследнийПульс;
	Элементы.ДекорацияПульс.Заголовок = ПредставлениеПульса(
		Шапка.ПоследнийПульс, ТекущаяДатаСеанса());

	// Автообновление подключается (см. ПриОткрытии) только если ar_ПоследнийПульс
	// заполнен и статус запуска не финальный — для финальных статусов растущий
	// «N сек назад» был бы бессмысленным «мусорным» счётчиком (см. D4 спеки
	// UI-12): значение фиксируется один раз на момент открытия формы.
	ШапкаПульсАктивен = ЗначениеЗаполнено(Шапка.ПоследнийПульс)
		И НЕ СтатусФинальный(Шапка.Статус);

	// UI-13 (косвенно): индикатор наличия снимка состояния для будущего «Возобновить».
	Если Шапка.ЕстьСнимок Тогда
		Элементы.ДекорацияЕстьСнимок.Заголовок = НСтр(
			"ru = 'Снимок состояния: да'; en = 'State snapshot: yes'");
	Иначе
		Элементы.ДекорацияЕстьСнимок.Заголовок = НСтр(
			"ru = 'Снимок состояния: нет'; en = 'State snapshot: no'");
	КонецЕсли;

	// UI-13: команда «Возобновить» видна только для прерванного запуска. Сравнение
	// со значением перечисления (а не со строкой) - устойчиво к локализации.
	// Установка перенесена из ПриСозданииНаСервере: команда «Обновить» тоже
	// перезаполняет шапку и должна пересчитать видимость кнопки.
	Элементы.КнопкаВозобновить.Видимость = (Шапка.Статус = Перечисления.ar_СтатусЗапуска.Прерван);

КонецПроцедуры

// Строит дерево «Запуск → шаги»: корневой узел — запуск, дочерние — слитый
// по ar_Sequence список событий и вызовов инструментов. Переносит ДеревоЗначений в
// реквизит формы через БСП [Реф: БСП/ОбщегоНазначения].
//
&НаСервере
Процедура ПостроитьДерево(Знач ЗначениеИдентификатораЗапуска)

	ДеревоЗначений = ШагиЗапускаДеревом(ЗначениеИдентификатораЗапуска, ФильтрТипаСобытия);

	КоллекцияЭлементовДерева = ДеревоШагов.ПолучитьЭлементы();
	КоллекцияЭлементовДерева.Очистить();
	ОбщегоНазначения.ЗаполнитьКоллекциюЭлементовДереваДанныхФормы(
		КоллекцияЭлементовДерева, ДеревоЗначений);

	// Развернуть корневой узел запуска (он один). Элементы.ДеревоШагов.Развернуть -
	// клиентский метод (управление визуальным состоянием дерева), недоступен на
	// сервере ("Method not available on server") - фактическое разворачивание
	// выполняется в клиентском ПриОткрытии.

КонецПроцедуры

// Формирует ДеревоЗначений со структурой колонок, совпадающей с колонками
// реквизита формы ДеревоШагов (Представление, Тип, Время, Последовательность, УровеньРиска).
//
// Параметры:
//   ЗначениеИдентификатораЗапуска - Строка - идентификатор запуска.
//   Фильтр - Строка - отбор по типу события (спека 4.4): "Все", "ВызовыИнструментов",
//            "ОтказыИЗапреты", "Ошибки"; пустая строка и "Все" - без отбора.
//
// Возвращаемое значение:
//   ДеревоЗначений - корневой узел запуска и строки событий/вызовов инструментов.
//
&НаСервере
Функция ШагиЗапускаДеревом(Знач ЗначениеИдентификатораЗапуска, Знач Фильтр = "")

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Представление");
	Дерево.Колонки.Добавить("Тип");
	Дерево.Колонки.Добавить("Время");
	Дерево.Колонки.Добавить("Последовательность");
	Дерево.Колонки.Добавить("УровеньРиска");
	// UI-11: машиночитаемое имя типа события (для определения LLMCalled на клиенте
	// без парсинга Представление, см. ДеревоШаговПриАктивизацииСтроки).
	Дерево.Колонки.Добавить("ТипСобытияИмя");

	КореньЗапуск = Дерево.Строки.Добавить();
	КореньЗапуск.Представление = СтрШаблон(
		НСтр("ru = 'Запуск %1'; en = 'Run %1'"), ЗначениеИдентификатораЗапуска);
	КореньЗапуск.Тип = "Запуск";
	КореньЗапуск.Последовательность = 0;

	Шаги = ВыбратьШаги(ЗначениеИдентификатораЗапуска);

	Для Каждого Шаг Из Шаги Цикл

		// Спека 4.4: отбор по типу события - в дерево попадают только подходящие
		// строки; корневой узел запуска остается всегда.
		Если Не СтрокаСобытияПоФильтру(Фильтр, Шаг.Тип, Шаг.ТипСобытия) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаШага = КореньЗапуск.Строки.Добавить();
		СтрокаШага.Тип = Шаг.Тип;
		СтрокаШага.Последовательность = Шаг.НомерШага;
		СтрокаШага.Время = ВремяСобытияСтрокой(Шаг.Время);
		// agentrunner-11: у части вызовов инструментов ar_Последовательность = 0
		// (запись вне нумерации событий) - номер не печатается («[] инструмент: …» недопустимо).
		Если Шаг.Тип = "Событие" Тогда
			СтрокаШага.Представление = ПрефиксНомераШага(Шаг.НомерШага)
				+ ПредставлениеСобытия(Шаг.ТипСобытия, Шаг.PayloadJSON);
			СтрокаШага.ТипСобытияИмя = XMLСтрока(Шаг.ТипСобытия);
		Иначе
			СтрокаШага.Представление = ПрефиксНомераШага(Шаг.НомерШага) + "инструмент: " + Шаг.ИмяИнструмента;
			СтрокаШага.УровеньРиска = Строка(Шаг.УровеньРиска);
		КонецЕсли;
	КонецЦикла;

	Возврат Дерево;

КонецФункции

// Представление строки дерева событий (agentrunner-68, спека Г.2): для событий
// надзора - читаемая строка из payload («Надзор: Продолжить - не сделано: ...»,
// «Надзор: ЦельДостигнута (llm)», «Продолжение 2: смена подхода»); для всех
// остальных - строковое значение типа события, как раньше. Ошибки разбора
// payload дают представление по типу (диагностика не теряется).
//
// Параметры:
//  ТипСобытия  - ПеречислениеСсылка.ar_ТипСобытия - тип события строки.
//  PayloadJSON - Строка - ar_PayloadJSON события (может быть пустым).
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ПредставлениеСобытия(Знач ТипСобытия, Знач PayloadJSON)

	Если ТипСобытия = Перечисления.ar_ТипСобытия.НадзорРешение Тогда
		Представление = ПредставлениеРешенияНадзора(PayloadJSON);
	ИначеЕсли ТипСобытия = Перечисления.ar_ТипСобытия.НадзорВызван Тогда
		Представление = ПредставлениеВызоваНадзора(PayloadJSON);
	ИначеЕсли ТипСобытия = Перечисления.ar_ТипСобытия.ПродолжениеСтартовало Тогда
		Представление = ПредставлениеПродолжения(PayloadJSON);
	Иначе
		Представление = "";
	КонецЕсли;

	Возврат ?(ПустаяСтрока(Представление), Строка(ТипСобытия), Представление);

КонецФункции

// Представление события НадзорРешение: «Надзор: <вердикт> (<source>)
// [<stop_reason>] - не сделано: <missing>»; пусто, если payload не разобрался.
//
&НаСервереБезКонтекста
Функция ПредставлениеРешенияНадзора(Знач PayloadJSON)

	Payload = ar_JSON.ИзJSON(PayloadJSON);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Вердикт = Payload.Получить("verdict");
	Если Вердикт <> Неопределено Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Надзор: %1'; en = 'Supervision: %1'"), "" + Вердикт));
	КонецЕсли;
	Источник = Payload.Получить("source");
	Если Источник <> Неопределено Тогда
		Части.Добавить("(" + Источник + ")");
	КонецЕсли;
	ПричинаОстановки = Payload.Получить("stop_reason");
	Если ПричинаОстановки <> Неопределено Тогда
		Части.Добавить("[" + ПричинаОстановки + "]");
	КонецЕсли;
	НеСделано = Payload.Получить("missing");
	Если НеСделано <> Неопределено И Не ПустаяСтрока("" + НеСделано) Тогда
		Части.Добавить(СтрШаблон(
			НСтр("ru = '- не сделано: %1'; en = '- not done: %1'"),
			Лев(СокрЛП("" + НеСделано), ЛимитНеСделаноВДереве())));
	КонецЕсли;

	Возврат ?(Части.Количество() = 0, "", СтрСоединить(Части, " "));

КонецФункции

// Представление события НадзорВызван: «Надзор: вызван (проход N)»; пусто, если
// payload не разобрался.
//
&НаСервереБезКонтекста
Функция ПредставлениеВызоваНадзора(Знач PayloadJSON)

	Payload = ar_JSON.ИзJSON(PayloadJSON);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	НомерПрохода = Payload.Получить("pass");
	Если НомерПрохода = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Надзор: вызван (проход %1)'; en = 'Supervision: invoked (pass %1)'"),
		"" + НомерПрохода);

КонецФункции

// Представление события ПродолжениеСтартовало: «Продолжение N: продолжение |
// смена подхода»; пусто, если payload не разобрался.
//
&НаСервереБезКонтекста
Функция ПредставлениеПродолжения(Знач PayloadJSON)

	Payload = ar_JSON.ИзJSON(PayloadJSON);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	ВидПродолжения = Payload.Получить("kind");
	Если ВидПродолжения = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Продолжение %1: %2'; en = 'Continuation %1: %2'"),
		"" + Payload.Получить("pass"),
		?(ВидПродолжения = "change_approach",
			НСтр("ru = 'смена подхода'; en = 'change of approach'"),
			НСтр("ru = 'продолжение'; en = 'continuation'")));

КонецФункции

// Лимит текста «не сделано» в представлении НадзорРешение в дереве (символов) -
// полное значение доступно в деталях события.
//
&НаСервереБезКонтекста
Функция ЛимитНеСделаноВДереве()
	Возврат 100;
КонецФункции

// Выбирает события и вызовы инструментов по ИдентификаторЗапуска, объединяет в одну таблицу и
// сортирует по ar_Sequence (общий хронологический порядок). Payload читается только у событий
// надзора (представление строки дерева) - у ВызванLLM он несет полный промпт.
//
&НаСервере
Функция ВыбратьШаги(Знач ЗначениеИдентификатораЗапуска)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""Событие"" КАК Тип,
	|	События.ar_Sequence КАК НомерШага,
	|	События.ar_МоментВремени КАК Время,
	|	События.ar_ТипСобытия КАК ТипСобытия,
	|	"""" КАК ИмяИнструмента,
	|	ЗНАЧЕНИЕ(Перечисление.ar_УровеньРиска.ПустаяСсылка) КАК УровеньРиска
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ВызовИнструмента"",
	|	Действия.ar_Последовательность,
	|	NULL,
	|	ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.ПустаяСсылка),
	|	Действия.ar_ИмяИнструмента,
	|	Действия.ar_УровеньРиска
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерШага,
	|	Тип";

	Шаги = Запрос.Выполнить().Выгрузить();
	Шаги.Колонки.Добавить("PayloadJSON", Новый ОписаниеТипов("Строка"));
	Шаги.Индексы.Добавить("Тип, НомерШага");

	// agentrunner-68 (спека Г.2): payload - только у событий надзора (подпись строки дерева),
	// отдельным запросом без обрезки JSON.
	ЗапросНадзора = Новый Запрос;
	ЗапросНадзора.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	ЗапросНадзора.Текст =
	"ВЫБРАТЬ
	|	События.ar_Sequence КАК НомерШага,
	|	События.ar_PayloadJSON КАК PayloadJSON
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|	И События.ar_ТипСобытия В (ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.НадзорВызван),
	|			ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.НадзорРешение),
	|			ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.ПродолжениеСтартовало))";

	Выборка = ЗапросНадзора.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Тип, НомерШага", "Событие", Выборка.НомерШага);
		Для Каждого Шаг Из Шаги.НайтиСтроки(Отбор) Цикл
			Шаг.PayloadJSON = Выборка.PayloadJSON;
		КонецЦикла;
	КонецЦикла;

	Возврат Шаги;

КонецФункции

// CONS-06 (D1): заполняет секцию «Созданные объекты 1С» - все непустые
// ar_СсылкаНаРезультат запуска, отдельным целевым запросом к ar_ДействияАгента (не
// выборкой из уже построенного ДеревоШагов - там представление урезано под
// нужды дерева, см. .docs/specs/CONS-06.md, «Поведение», п.1).
//
// Время строки - момент связанного вызова инструмента с тем же ИдентификаторомЗапуска+НомерШага
// (ar_СобытияЗапуска.ar_МоментВремени, ЛЕВОЕ СОЕДИНЕНИЕ - тот же источник
// времени, что ВыбратьШаги использует для дерева); если события нет - прочерк.
//
// Параметры:
//   ЗначениеИдентификатораЗапуска - Строка - идентификатор запуска.
//
&НаСервере
Процедура ЗаполнитьСозданныеОбъекты(Знач ЗначениеИдентификатораЗапуска)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяИнструмента КАК ИмяИнструмента,
	|	Действия.ar_СсылкаНаРезультат КАК СсылкаРезультата,
	|	События.ar_МоментВремени КАК МоментВремени
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ar_СобытияЗапуска КАК События
	|		ПО Действия.ar_ИдентификаторЗапуска = События.ar_RunId
	|			И Действия.ar_Последовательность = События.ar_Sequence
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска
	|	И Действия.ar_СсылкаНаРезультат <> """"
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Последовательность";

	СозданныеОбъекты.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НавигационнаяСсылка = "" + Выборка.СсылкаРезультата;
		Объект = ar_Утилиты.ОбъектИзНавигационнойСсылки(НавигационнаяСсылка);

		НоваяСтрока = СозданныеОбъекты.Добавить();
		НоваяСтрока.Представление = ar_ПодтверждениеПредставление.ПредставлениеTool(Выборка.ИмяИнструмента);
		// D5 (CONS-06)/fallback ROREF: не разыменованная ссылка показывается как
		// исходный текст.
		НоваяСтрока.ОбъектТекст = ?(Объект <> Неопределено, Строка(Объект), НавигационнаяСсылка);
		НоваяСтрока.НавигационнаяСсылка = ?(Объект <> Неопределено, НавигационнаяСсылка, "");
		НоваяСтрока.Время = ВремяСобытияСтрокой(Выборка.МоментВремени);

	КонецЦикла;

	// Секция пустая - таблица скрывается, показывается заглушка (тот же паттерн,
	// что для «Ожидает подтверждения», см. ЗаполнитьОжидаетПодтверждения).
	ЕстьСтроки = (СозданныеОбъекты.Количество() > 0);
	Элементы.СозданныеОбъекты.Видимость = ЕстьСтроки;
	Элементы.ДекорацияНетСозданныхОбъектов.Видимость = Не ЕстьСтроки;

КонецПроцедуры

// CONS-06 (D3): заполняет секцию «Ожидает подтверждения» - pending-записи
// ar_ОчередьApproval этого ИдентификатораЗапуска плюс терминальные записи (историю) того же
// ИдентификатораЗапуска в ОДНОЙ таблице с булевым признаком ЭтоИстория (см. .docs/specs/CONS-06.md,
// «Поведение», п.1 - выбранный вариант архитектуры).
//
// Каждая строка строится через ar_ПодтверждениеПредставление.СобратьКарточку -
// единственный источник разбора payload (Представление/Риск/Обоснование/Эффект),
// свой парсер JSON не пишется (см. риск «БейджРиска - HTML» - здесь НЕ
// используется, вместо неё Карточка.Риск - обычная строка + условное оформление
// в Form.xml по значению этой колонки).
//
// SEC-02: Обоснование/ЭффектТекст маскируются от секретов перед показом на форме
// (двойная защита - основное маскирование уже в ar_Подтверждение.Отклонить при записи
// причины оператора, здесь - на пути показа LLM-обоснования постановки).
//
// Параметры:
//   ЗначениеИдентификатораЗапуска - Строка - идентификатор запуска.
//
&НаСервере
Процедура ЗаполнитьОжидаетПодтверждения(Знач ЗначениеИдентификатораЗапуска)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.ar_ApprovalId КАК ИдентификаторПодтверждения,
	|	Очередь.ar_ActionPayloadJSON КАК ДанныеJSON,
	|	Очередь.ar_Статус КАК Статус,
	|	Очередь.ar_ОбоснованиеLLM КАК ОбоснованиеLLM,
	|	Очередь.ar_СозданоВ КАК СозданоВ,
	|	Очередь.ar_РешеноВ КАК РешеноВ,
	|	Очередь.ar_РешилПользователь КАК РешилПользователь
	|ИЗ
	|	РегистрСведений.ar_ОчередьApproval КАК Очередь
	|ГДЕ
	|	Очередь.ar_RunId = &ИдентификаторЗапуска
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ar_СозданоВ";

	ОжидаетПодтверждения.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ЭтоИстория = (Выборка.Статус <> "pending");
		Карточка = ar_ПодтверждениеПредставление.СобратьКарточку(
			"" + Выборка.ИдентификаторПодтверждения, "" + Выборка.ДанныеJSON);

		// Для pending - Карточка.Обоснование (rationale LLM из payload постановки).
		// Для решённых записей ar_ОбоснованиеLLM регистра уже переписан итогом
		// решения (ar_Подтверждение.Отклонить пишет туда причину оператора, Принять -
		// итог исполнения через ПометитьApprovalВыполненным) - показываем
		// актуальное значение поля, а не исходный rationale из payload.
		ТекстОбоснования = ?(ЭтоИстория, "" + Выборка.ОбоснованиеLLM, Карточка.Обоснование);

		НоваяСтрока = ОжидаетПодтверждения.Добавить();
		НоваяСтрока.ИдентификаторПодтверждения = "" + Выборка.ИдентификаторПодтверждения;
		НоваяСтрока.Представление = Карточка.Представление;
		НоваяСтрока.ЭффектТекст = ar_Утилиты.МаскироватьСекреты(Карточка.Эффект);
		НоваяСтрока.Риск = Карточка.Риск;
		НоваяСтрока.Обоснование = ar_Утилиты.МаскироватьСекреты(ТекстОбоснования);
		НоваяСтрока.СозданоВТекст = ?(ЗначениеЗаполнено(Выборка.СозданоВ),
			Формат(Выборка.СозданоВ, "ДЛФ=DT"), Прочерк());
		НоваяСтрока.ЭтоИстория = ЭтоИстория;
		НоваяСтрока.СтатусТекст = "" + Выборка.Статус;

		Если ЭтоИстория Тогда
			НоваяСтрока.РешилТекст = ?(ЗначениеЗаполнено(Выборка.РешилПользователь),
				Строка(Выборка.РешилПользователь), Прочерк());
			НоваяСтрока.РешеноВТекст = ?(ЗначениеЗаполнено(Выборка.РешеноВ),
				Формат(Выборка.РешеноВ, "ДЛФ=DT"), Прочерк());
		Иначе
			НоваяСтрока.РешилТекст = Прочерк();
			НоваяСтрока.РешеноВТекст = Прочерк();
		КонецЕсли;

	КонецЦикла;

	ЕстьСтроки = (ОжидаетПодтверждения.Количество() > 0);
	Элементы.ОжидаетПодтверждения.Видимость = ЕстьСтроки;
	Элементы.ДекорацияНетПодтверждений.Видимость = Не ЕстьСтроки;

	// Спека 4.3: кнопки «Подтвердить»/«Отклонить» видны только при наличии
	// ожидающих решения подтверждений запуска (у обычного запуска панель
	// действий раньше показывалась неактивной).
	ЕстьОжидающие = Ложь;
	Для Каждого СтрокаПодтверждения Из ОжидаетПодтверждения Цикл
		Если Не СтрокаПодтверждения.ЭтоИстория Тогда
			ЕстьОжидающие = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Элементы.ГруппаДействийПодтверждения.Видимость = ЕстьОжидающие;

КонецПроцедуры

// PLAN-07 (D1-D5): заполняет секцию «План» - последнее событие PlanUpdated
// этого запуска (РегистрСведений.ar_СобытияЗапуска), тот же путь чтения по
// ИдентификаторуЗапуска, что уже использует ЗаполнитьДеталиСобытия (:1047) - целевой запрос
// «ВЫБРАТЬ ПЕРВЫЕ 1» по ИдентификаторЗапуска+ТипСобытия, УПОРЯДОЧИТЬ ПО ar_Sequence УБЫВ.
// Никакого нового серверного механизма чтения не заводится (уточнение U6).
//
// Три различимых состояния секции:
//   1. Событие PlanUpdated не найдено (агент не объявлял план, флажок
//      ar_ПланироватьРаботу не был включён, либо запуск до PLAN-04) -
//      ГруппаПлан скрывается целиком (Видимость = Ложь). Не «план объявлен, но
//      пуст» - секция в принципе отсутствует в карточке.
//   2. Событие найдено, но после ar_JSON.ИзJSON payload не Соответствие, либо
//      ключ "steps" не Массив, либо "steps" пуст - секция ПОКАЗЫВАЕТСЯ, таблица
//      пуста, видна заглушка ДекорацияПланПуст с текстом, отличным от
//      «Объекты не создавались» (см. DoD D3).
//   3. "steps" содержит хотя бы один пункт - таблица План заполняется по ВСЕМ
//      элементам массива, включая статус removed (payload ar_RuntimeЦикл
//      сериализует Состояние.План.Пункты целиком, без фильтрации - в отличие от
//      ar_ПланЗапуска.Прогресс, который removed исключает из знаменателя
//      намеренно; здесь фильтровать НЕЛЬЗЯ, иначе теряется история изменения
//      плана, см. DoD D4 и «Риски» в .docs/specs/PLAN-07.md).
//
// Разбор payload - только для отображения уже нормализованного содержимого
// события (title обрезан и нормализован ar_ПланЗапуска на момент записи),
// повторная нормализация/лимиты форме не нужны (ar_ПланЗапуска/ar_ИнструментыПлан не
// вызываются - см. DoD D7, изменения не выходят за пределы формы).
//
// Параметры:
//   ЗначениеИдентификатораЗапуска - Строка - идентификатор запуска.
//
&НаСервере
Процедура ЗаполнитьПлан(Знач ЗначениеИдентификатораЗапуска)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ЗначениеИдентификатораЗапуска);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	События.ar_PayloadJSON КАК ДанныеJSON
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|	И События.ar_ТипСобытия = ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.ПланОбновлён)
	|УПОРЯДОЧИТЬ ПО
	|	События.ar_Sequence УБЫВ";

	План.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		// Состояние 1: плана нет - секция скрыта целиком.
		Элементы.ГруппаПлан.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.ГруппаПлан.Видимость = Истина;

	РазобранныйJSON = ar_JSON.ИзJSON("" + Выборка.ДанныеJSON);
	Шаги = Неопределено;
	Если ТипЗнч(РазобранныйJSON) = Тип("Соответствие") Тогда
		Шаги = РазобранныйJSON.Получить("steps");
	КонецЕсли;

	Если ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Шаги = Новый Массив;
	КонецЕсли;

	Для Каждого Шаг Из Шаги Цикл

		Если ТипЗнч(Шаг) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		СтатусСырой = "" + Шаг.Получить("status");

		НоваяСтрока = План.Добавить();
		НоваяСтрока.Представление = "" + Шаг.Получить("title");
		НоваяСтрока.СтатусТекст = ПредставлениеСтатусаПлана(СтатусСырой);
		НоваяСтрока.СтатусСырой = СтатусСырой;

	КонецЦикла;

	// Состояние 2 (план объявлен, но пуст) против состояния 3 (есть пункты) -
	// заглушка ДекорацияПланПуст текстуально отличается от «Объекты не
	// создавались» (ДекорацияНетСозданныхОбъектов), см. DoD D3.
	ЕстьСтроки = (План.Количество() > 0);
	Элементы.План.Видимость = ЕстьСтроки;
	Элементы.ДекорацияПланПуст.Видимость = Не ЕстьСтроки;

КонецПроцедуры

// Заполняет боковую панель деталей для выбранного узла дерева.
//
&НаСервере
Процедура ОбновитьДеталиУзлаНаСервере(Знач ИдентификаторСтроки)

	СтрокаДерева = ДеревоШагов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Тогда
		Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиПусто;
		Возврат;
	КонецЕсли;

	Если СтрокаДерева.Тип = "Запуск" Тогда
		Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиЗапуск;
	ИначеЕсли СтрокаДерева.Тип = "Событие" Тогда
		ЗаполнитьДеталиСобытия(СтрокаДерева.Последовательность);
		Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиСобытие;
	Иначе
		ЗаполнитьДеталиВызоваИнструмента(СтрокаДерева.Последовательность);
		Элементы.ГруппаДетали.ТекущаяСтраница = Элементы.СтраницаДеталиВызовИнструмента;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиСобытия(Знач НомерШага)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Запрос.УстановитьПараметр("НомерШага", НомерШага);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	События.ar_ТипСобытия КАК ТипСобытия,
	|	События.ar_МоментВремени КАК МоментВремени,
	|	События.ar_PayloadJSON КАК ДанныеJSON
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|	И События.ar_Sequence = &НомерШага";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	ДетальСобытиеТип = Строка(Выборка.ТипСобытия);
	ДетальСобытиеВремя = ВремяСобытияСтрокой(Выборка.МоментВремени);
	// SEC-02: payload очищается при записи (ar_AuditСобытия.ОчиститьЧувствительныеКлючи),
	// дополнительно маскируем секреты при отображении как двойную защиту.
	ДетальСобытиеДанные = ar_Утилиты.МаскироватьСекреты(Выборка.ДанныеJSON);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиВызоваИнструмента(Знач НомерШага)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Запрос.УстановитьПараметр("НомерШага", НомерШага);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Действия.ar_ИмяИнструмента КАК ИмяИнструмента,
	|	Действия.ar_АргументыJSON КАК АргументыJSON,
	|	Действия.ar_ОтветИнструмента КАК ОтветИнструмента,
	|	Действия.ar_УровеньРиска КАК УровеньРиска,
	|	Действия.ar_СсылкаНаРезультат КАК СсылкаРезультата,
	|	Действия.ar_КемПодтверждено КАК Подтвердил,
	|	Действия.ar_ДатаПодтверждения КАК ПодтвержденоВ,
	|	Действия.ar_ДлительностьМС КАК ДлительностьМС
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска
	|	И Действия.ar_Последовательность = &НомерШага";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	ДетальИнструментИмя = Выборка.ИмяИнструмента;
	ДетальИнструментУровеньРиска = Строка(Выборка.УровеньРиска);
	ДетальИнструментАргументы = ar_Утилиты.МаскироватьСекреты(Выборка.АргументыJSON);
	ДетальИнструментСсылкаНаРезультат = Выборка.СсылкаРезультата;
	ДетальИнструментКемПодтверждено = ?(ЗначениеЗаполнено(Выборка.Подтвердил), Строка(Выборка.Подтвердил), Прочерк());
	ДетальИнструментДатаПодтверждения = ?(ЗначениеЗаполнено(Выборка.ПодтвержденоВ),
		Формат(Выборка.ПодтвержденоВ, "ДЛФ=DT"), Прочерк());
	// PERF-04: 0 означает "не измерено" - показываем прочерк, а не "0".
	ДетальИнструментДлительностьМС = ПредставлениеДлительностиМС(Выборка.ДлительностьМС);

	// agentrunner-55: ответ инструмента (записан маскированным, при показе
	// маскируем дополнительно) - начало текста в панели, полный текст - командой
	// «Открыть ответ полностью». Пустой ответ - запуски до введения хранения
	// ответов либо запись ключа без ответа: надпись вместо поля.
	ОтветИзРегистра = Выборка.ОтветИнструмента;
	ДетальИнструментЕстьОтвет = Не ПустаяСтрока(ОтветИзРегистра);
	ДетальИнструментОтвет = ?(ДетальИнструментЕстьОтвет,
		ar_Утилиты.ОбрезатьДо(ar_Утилиты.МаскироватьСекреты(ОтветИзРегистра), ЛимитОтображенияОтвета()), "");
	Элементы.ДетальИнструментОтвет.Видимость = ДетальИнструментЕстьОтвет;
	Элементы.ДекорацияНетОтветаИнструмента.Видимость = Не ДетальИнструментЕстьОтвет;
	Элементы.КнопкаОткрытьОтветПолностью.Доступность = ДетальИнструментЕстьОтвет;

КонецПроцедуры

// agentrunner-55: предел отображения ответа инструмента в панели деталей
// (символов) - начало текста; полный текст открывается командой
// «Открыть ответ полностью» в окне просмотра.
//
// Возвращаемое значение:
//   Число - максимальная длина ответа в поле ДетальИнструментОтвет.
//
&НаСервереБезКонтекста
Функция ЛимитОтображенияОтвета()
	Возврат 2000;
КонецФункции

// agentrunner-55: полный ответ инструмента для окна просмотра - по ключу
// (ИдентификаторЗапуска, НомерШага) из регистра ar_ДействияАгента; при показе
// секреты маскируются (второй барьер поверх маскирования при записи).
//
// Параметры:
//   НомерШага - Число - ar_Последовательность выбранного узла дерева.
//
// Возвращаемое значение:
//   Структура:
//     * ЕстьОтвет       - Булево - ответ сохранён и непуст.
//     * ТекстОтвета     - Строка - полный маскированный ответ, "" если нет ответа.
//     * ИмяИнструмента  - Строка - имя инструмента записи (для заголовка окна).
//
&НаСервере
Функция ПолучитьОтветИнструментаНаСервере(Знач НомерШага)

	Результат = Новый Структура;
	Результат.Вставить("ЕстьОтвет", Ложь);
	Результат.Вставить("ТекстОтвета", "");
	Результат.Вставить("ИмяИнструмента", "");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Запрос.УстановитьПараметр("НомерШага", НомерШага);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Действия.ar_ИмяИнструмента КАК ИмяИнструмента,
	|	Действия.ar_ОтветИнструмента КАК ОтветИнструмента
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска
	|	И Действия.ar_Последовательность = &НомерШага";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяИнструмента = Выборка.ИмяИнструмента;
	Если ПустаяСтрока(Выборка.ОтветИнструмента) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьОтвет = Истина;
	Результат.ТекстОтвета = ar_Утилиты.МаскироватьСекреты(Выборка.ОтветИнструмента);
	Возврат Результат;

КонецФункции

// PERF-04: текстовое представление ar_ДлительностьМС для боковой панели деталей
// вызова инструмента - 0 ("не измерено", см. Comment ресурса регистра ar_ДействияАгента)
// показывается прочерком, а не нулём, чтобы не создавать впечатление
// мгновенного выполнения.
//
// Параметры:
//   ДлительностьМС - Число - значение ресурса ar_ДлительностьМС (>= 0).
//
// Возвращаемое значение:
//   Строка - целое число без разделителей групп либо Прочерк() для 0.
//
&НаСервереБезКонтекста
Функция ПредставлениеДлительностиМС(Знач ДлительностьМС)

	Число = ?(ТипЗнч(ДлительностьМС) = Тип("Число"), ДлительностьМС, 0);
	Если Число <= 0 Тогда
		Возврат Прочерк();
	КонецЕсли;

	Возврат ЦелоеСтрокой(Число);

КонецФункции

&НаСервере
Функция ОбъектИзНавигационнойСсылкиНаСервере(Знач НавигационнаяСсылка)
	Возврат ar_Утилиты.ОбъектИзНавигационнойСсылки(НавигационнаяСсылка);
КонецФункции

// UI-11: читает массив messages из payload события LLMCalled для шага НомерШага.
//
// В отличие от ЗаполнитьДеталиСобытия (боковая панель, усечение 500 символов
// через ar_Утилиты.МаскироватьСекреты), здесь читается ПОЛНЫЙ ar_PayloadJSON —
// маскирование секретов уже выполнено при записи события
// (ar_AuditСобытия.БезопасноЗамаскироватьСтроку, SEC-02), повторное
// маскирование с обрезкой не требуется и испортило бы «полный промпт».
//
// ar_JSON.ИзJSON не выбрасывает исключений при некорректном JSON (возвращает
// Неопределено) — дополнительная обработка Попытка/Исключение не требуется,
// результат уже проверяется ТипЗнч(ДанныеСобытия) <> Тип("Соответствие") ниже.
//
// Параметры:
//   НомерШага - Число - порядковый номер шага (РегистрСведений.ar_СобытияЗапуска.ar_Sequence)
//             в рамках текущего ИдентификатораЗапуска (реквизит формы).
//
// Возвращаемое значение:
//   Массив, Неопределено - массив сообщений messages (если событие LLMCalled
//   с непустым ключом "messages" найдено), иначе Неопределено.
//
&НаСервере
Функция ПрочитатьСообщенияВызоваМодели(Знач НомерШага)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Запрос.УстановитьПараметр("НомерШага", НомерШага);
	// agentrunner-68 (спека Г.4): «Показать промпт» доступна и для НадзорРешение
	// с ключом messages (системный промпт и сводка надзора) - не только ВызванLLM.
	ТипыСобытия = Новый Массив;
	ТипыСобытия.Добавить(Перечисления.ar_ТипСобытия.ВызванLLM);
	ТипыСобытия.Добавить(Перечисления.ar_ТипСобытия.НадзорРешение);
	Запрос.УстановитьПараметр("ТипыСобытия", ТипыСобытия);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	События.ar_PayloadJSON КАК ДанныеJSON
	|ИЗ
	|	РегистрСведений.ar_СобытияЗапуска КАК События
	|ГДЕ
	|	События.ar_RunId = &ИдентификаторЗапуска
	|	И События.ar_Sequence = &НомерШага
	|	И События.ar_ТипСобытия В (&ТипыСобытия)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеСобытия = ar_JSON.ИзJSON(Выборка.ДанныеJSON);
	Если ТипЗнч(ДанныеСобытия) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сообщения = ДанныеСобытия.Получить("messages");
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сообщения;

КонецФункции

// UI-11: дешёвая проверка для ОбновитьВидимостьКнопкиПромпт — есть ли непустой
// messages в payload события LLMCalled для данного шага.
//
// Параметры:
//   НомерШага - Число - порядковый номер шага (РегистрСведений.ar_СобытияЗапуска.ar_Sequence)
//             в рамках текущего ИдентификатораЗапуска (реквизит формы).
//
// Возвращаемое значение:
//   Булево - Истина, если для шага найдено событие LLMCalled с непустым messages.
//
&НаСервере
Функция ЕстьСообщенияПромптДляУзлаНаСервере(Знач НомерШага)
	Возврат ПрочитатьСообщенияВызоваМодели(НомерШага) <> Неопределено;
КонецФункции

// UI-11: возвращает данные для модального просмотра промпта (CommonForm.ar_ФормаПросмотраPrompt).
//
// Параметры:
//   НомерШага - Число - порядковый номер шага (РегистрСведений.ar_СобытияЗапуска.ar_Sequence)
//             в рамках текущего ИдентификатораЗапуска (реквизит формы).
//
// Возвращаемое значение:
//   Структура:
//     * ЕстьСообщения - Булево
//     * ТекстПромпт    - Строка - КрасивыйФорматJSON(messages), "" если нет данных.
//     * ИмяМодели      - Строка - модель агента (ar_Агенты.ar_Модель) для оценки токенов.
//
&НаСервере
Функция ПолучитьПромптДляУзлаНаСервере(Знач НомерШага)

	Результат = Новый Структура;
	Результат.Вставить("ЕстьСообщения", Ложь);
	Результат.Вставить("ТекстПромпт", "");
	Результат.Вставить("ИмяМодели", "");

	Сообщения = ПрочитатьСообщенияВызоваМодели(НомерШага);
	Если Сообщения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ЕстьСообщения = Истина;
	Результат.ТекстПромпт = ar_JSON.КрасивыйФорматJSON(Сообщения);
	Результат.ИмяМодели = ИмяМоделиАгентаЗапуска();

	Возврат Результат;

КонецФункции

// UI-11: имя модели агента текущего запуска (для ar_Токены.Оценить в
// CommonForm.ar_ФормаПросмотраPrompt). Пустая строка, если агент/модель не заполнены.
//
// Возвращаемое значение:
//   Строка - имя модели (ar_Агенты.ar_Модель) агента запуска, "" если не заполнено.
//
&НаСервере
Функция ИмяМоделиАгентаЗапуска()

	// Явное соединение со справочником вместо навигации через точку
	// (Запуски.ar_АгентРеф.ar_Модель) — избегаем неявного вложенного запроса.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗапуска", ИдентификаторЗапуска);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Агенты.ar_Модель КАК Модель
	|ИЗ
	|	РегистрСведений.ar_Запуски КАК Запуски
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
	|		ПО Запуски.ar_АгентРеф = Агенты.Ссылка
	|ГДЕ
	|	Запуски.ar_ИдентификаторЗапуска = &ИдентификаторЗапуска";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(ТипЗнч(Выборка.Модель) = Тип("Строка"), Выборка.Модель, "");

КонецФункции

&НаКлиенте
Процедура ОбновитьДеталиУзла(Знач ИдентификаторСтроки)
	ОбновитьДеталиУзлаНаСервере(ИдентификаторСтроки);
КонецПроцедуры

// Показывает заглушку вместо карточки запуска — используется и когда запуск
// не найден (ИдентификаторЗапуска не заполнен/не существует), и когда он существует, но не
// виден текущему пользователю (CONS-13: ЗапускДоступенТекущемуПользователю).
// Текст различается, чтобы пользователь не принял отказ в доступе за баг
// (см. .docs/specs/CONS-13.md, п.3 доработки итерации 2) — молчаливая пустая
// карточка без объяснения хуже, чем явное сообщение о причине.
//
// Параметры:
//  ЭтоОтказВДоступе - Булево - Ложь (по умолчанию): запуск не найден;
//   Истина: запуск существует, но недоступен текущему пользователю.
//
&НаСервере
Процедура ПоказатьЗаглушкуНеНайдено(Знач ЭтоОтказВДоступе = Ложь)
	Элементы.ДекорацияНеНайдено.Видимость = Истина;
	Элементы.ГруппаШапка.Видимость = Ложь;
	Элементы.ГруппаОсн.Видимость = Ложь;
	Если ЭтоОтказВДоступе Тогда
		Элементы.ДекорацияНеНайдено.Заголовок = НСтр(
			"ru = 'Нет доступа к этому запуску — он не входит в число видимых вам запусков';
			|en = 'Access denied — this run is not visible to you'");
		Заголовок = НСтр("ru = 'Просмотр запуска — нет доступа';
			|en = 'Run viewer — access denied'");
	Иначе
		Заголовок = НСтр("ru = 'Просмотр запуска — запуск не найден';
			|en = 'Run viewer — run not found'");
	КонецЕсли;
КонецПроцедуры

// Длительность запуска для шапки карточки - правила agentrunner-9 (спека, п.1–3):
// интервалы сек/мин/ч/д (ИнтервалСтрокой); для трёх паузных статусов
// «<работа> · ждёт <ожидание>», где работа = ПоследнийПульс - СтартовалВ,
// ожидание = сейчас - ПоследнийПульс (пульс пишется только на шагах цикла и на
// паузе замирает - ближайший к моменту паузы факт). Пульс пуст или раньше
// старта - работа = 0, ожидание от СтартовалВ. Отрицательные интервалы
// клиппуются в 0 (ИнтервалСтрокой). Общий модуль не заводится - копия правил
// спеки agentrunner-9 в модуле этой формы (спека agentrunner-11, п.4).
//
// Параметры:
//   СтартовалВ     - Дата - ar_СтартовалВ (время сеанса).
//   ЗавершенВ      - Дата - ar_ЗавершенВ (время сеанса), пусто у идущего запуска.
//   Статус         - ПеречислениеСсылка.ar_СтатусЗапуска - статус запуска.
//   ПоследнийПульс - Дата - ar_ПоследнийПульс (время сеанса).
//
// Возвращаемое значение:
//   Строка - представление длительности; Прочерк для пустого СтартовалВ.
//
&НаСервереБезКонтекста
Функция ПредставлениеДлительности(Знач СтартовалВ, Знач ЗавершенВ, Знач Статус, Знач ПоследнийПульс)

	Если НЕ ЗначениеЗаполнено(СтартовалВ) Тогда
		Возврат Прочерк();
	КонецЕсли;

	Если Статус = Перечисления.ar_СтатусЗапуска.ПриостановленДляПодтверждения
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ПриостановленДляВвода
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ПриостановленДляСобытия Тогда

		МоментПаузы = ?(ЗначениеЗаполнено(ПоследнийПульс) И ПоследнийПульс > СтартовалВ,
			ПоследнийПульс, СтартовалВ);

		Возврат СтрШаблон(
			НСтр("ru = '%1 · ждёт %2'; en = '%1 · waiting %2'"),
			ИнтервалСтрокой(Цел(МоментПаузы - СтартовалВ)),
			ИнтервалСтрокой(Цел(ТекущаяДатаСеанса() - МоментПаузы)));
	КонецЕсли;

	Конец = ?(ЗначениеЗаполнено(ЗавершенВ), ЗавершенВ, ТекущаяДатаСеанса());
	Возврат ИнтервалСтрокой(Цел(Конец - СтартовалВ));

КонецФункции

// UI-12: текст индикатора «Пульс: N сек назад» (или «Пульс: —» для
// незаполненного значения). N = Цел(Текущая - ПоследнийПульс), отрицательные
// значения клиппуются в 0 — по аналогии с ПредставлениеДлительности.
//
// agentrunner-15: N печатается через ЦелоеСтрокой (ЧН=0) — без ЧН Формат печатал
// пустую строку («Пульс:  сек назад») при Секунд = 0 (пульс в ту же секунду,
// что открытие формы; agentrunner-11: прецедент ЦелоеСтрокой, ar_КонсольАгентов:1037).
//
// Используется при первом заполнении шапки (ЗаполнитьШапку, Текущая =
// ТекущаяДатаСеанса()). Для последующих тиков клиентского таймера используется
// ПредставлениеПульсаНаКлиенте (та же формула, клиентский контекст).
//
// Параметры:
//   ПоследнийПульс - Дата - ar_ПоследнийПульс запуска (РегистрСведений.ar_Запуски);
//                    Дата(1,1,1), если шагов ещё не было.
//   Текущая       - Дата - момент времени, относительно которого считается N.
//
// Возвращаемое значение:
//   Строка - локализованный текст индикатора.
//
&НаСервереБезКонтекста
Функция ПредставлениеПульса(Знач ПоследнийПульс, Знач Текущая)

	Если НЕ ЗначениеЗаполнено(ПоследнийПульс) Тогда
		Возврат НСтр("ru = 'Пульс: —'; en = 'Heartbeat: —'");
	КонецЕсли;

	Секунд = Цел(Текущая - ПоследнийПульс);
	Если Секунд < 0 Тогда
		Секунд = 0;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Пульс: %1 сек назад'; en = 'Heartbeat: %1 sec ago'"),
		ЦелоеСтрокой(Секунд));

КонецФункции

// UI-12: клиентский аналог ПредставлениеПульса — пересчёт «N сек назад» на
// каждом тике ОбновитьПульс без обращения к серверу (вариант A). Формула
// идентична серверной (N = Цел(Текущая - ПоследнийПульс), клипп в 0); дублируется,
// т. к. &НаСервереБезКонтекста-функции недоступны из клиентского контекста
// (в том числе ЦелоеСтрокой — поэтому здесь тот же формат строкой "ЧН=0; ЧГ=0").
//
// Параметры:
//   ПоследнийПульс - Дата - реквизит формы ШапкаПоследнийПульс.
//   Текущая       - Дата - ТекущаяДата() на клиенте на момент тика.
//
// Возвращаемое значение:
//   Строка - локализованный текст индикатора.
//
&НаКлиенте
Функция ПредставлениеПульсаНаКлиенте(Знач ПоследнийПульс, Знач Текущая)

	Если НЕ ЗначениеЗаполнено(ПоследнийПульс) Тогда
		Возврат НСтр("ru = 'Пульс: —'; en = 'Heartbeat: —'");
	КонецЕсли;

	Секунд = Цел(Текущая - ПоследнийПульс);
	Если Секунд < 0 Тогда
		Секунд = 0;
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Пульс: %1 сек назад'; en = 'Heartbeat: %1 sec ago'"),
		Формат(Секунд, "ЧН=0; ЧГ=0"));

КонецФункции

// UI-12: финальность статуса запуска — для финальных статусов пульс больше
// не обновляется бэкендом (ar_AuditЗапуски.Heartbeat вызывается только из
// активного цикла), поэтому клиентский таймер автообновления не подключается
// (см. ЗаполнитьШапку/ПриОткрытии) — иначе «N сек назад» рос бы неограниченно
// для давно завершённых запусков (см. D4/«Граничные случаи» спеки UI-12).
//
// Финальные значения соответствуют Перечисление.ar_СтатусЗапуска: Completed,
// Failed, Cancelled, MaxStepsReached, DeniedGlobally, Interrupted,
// FailedIncompatibleState. Нефинальные: Created, Running, PausedForApproval.
//
// Interrupted включён в финальные намеренно: см. Enums/ar_СтатусЗапуска.xml,
// EnumValue Interrupted - "Финальный статус: heartbeat пропал дольше порога,
// сервер упал". Регламентное ar_ОчисткаЗависших (SCHED-04) переводит запуск
// в Interrupted именно когда ar_ПоследнийПульс устарел дольше
// ar_HeartbeatПорогСек - то есть пульс для такого запуска заведомо не
// обновляется бэкендом, и автообновляющийся счётчик "N сек назад" ему не
// нужен (значение уже "истекло" и зафиксировано). Возможность ручного
// возобновления Interrupted-запуска (UI-13, КнопкаВозобновить) - отдельный
// от индикатора пульса UX-сценарий, не влияет на эту классификацию.
//
// Параметры:
//   Статус - ПеречислениеСсылка.ar_СтатусЗапуска - статус запуска (Шапка.Статус).
//
// Возвращаемое значение:
//   Булево - Истина, если статус финальный.
//
&НаСервереБезКонтекста
Функция СтатусФинальный(Знач Статус)

	Возврат Статус = Перечисления.ar_СтатусЗапуска.Завершён
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ОшибкаВыполнения
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.Отменён
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ДостигнутМаксимумШагов
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ОтклонёнГлобально
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.Прерван
		ИЛИ Статус = Перечисления.ar_СтатусЗапуска.ОшибкаНесовместимоеСостояние;

КонецФункции

// Локализованный прочерк-заглушка для незаполненных полей.
//
&НаСервереБезКонтекста
Функция Прочерк()
	Возврат НСтр("ru = '—'; en = '—'");
КонецФункции

// Формат целого числа без дробной части и разделителей групп. ЧН=0 - ноль
// печатается цифрой «0», а не пустой строкой (умолчание Формата без ЧН;
// agentrunner-11: «Токены вх/вых: 0 / 0», «Шагов всего: 0» - ноль здесь факт,
// а не отсутствие данных; прецедент - ar_КонсольАгентов, Module.bsl:1037).
//
// Параметры:
//   Число - Число - значение ресурса/колонки (тип гарантирован источником).
//
// Возвращаемое значение:
//   Строка - целое без разделителей групп; ноль - «0».
//
&НаСервереБезКонтекста
Функция ЦелоеСтрокой(Знач Число)
	Возврат Формат(Число, "ЧН=0; ЧГ=0; ЧДЦ=0");
КонецФункции

// agentrunner-11: префикс номера шага в дереве «[N] »; для нулевого номера
// (вызов инструмента записан вне нумерации событий, ar_Последовательность = 0) префикс
// пустой - без проверки дерево печатало «[] инструмент: …».
//
// Параметры:
//   НомерШага - Число - ar_Sequence / ar_Последовательность шага.
//
// Возвращаемое значение:
//   Строка - «[N] » либо пустая строка.
//
&НаСервереБезКонтекста
Функция ПрефиксНомераШага(Знач НомерШага)
	Возврат ?(НомерШага = 0, "", "[" + ЦелоеСтрокой(НомерШага) + "] ");
КонецФункции

// Время события (ar_СобытияЗапуска.ar_МоментВремени) строкой для карточки:
// в регистре хранится UTC (ar_AuditСобытия - «для аудита всегда UTC»),
// показывается во времени сеанса - МестноеВремя с ЧасовойПоясСеанса (без
// явного пояса платформа берёт пояс компьютера, в веб-клиенте - рабочей
// станции, а остальные поля карточки - в поясе сеанса). Хранение не меняется.
//
// Параметры:
//   МоментУниверсальный - Дата - значение ar_МоментВремени (универсальное время, UTC).
//
// Возвращаемое значение:
//   Строка - «ДЛФ=DT» во времени сеанса либо Прочерк для пустой даты.
//
&НаСервереБезКонтекста
Функция ВремяСобытияСтрокой(Знач МоментУниверсальный)

	Если НЕ ЗначениеЗаполнено(МоментУниверсальный) Тогда
		Возврат Прочерк();
	КонецЕсли;

	Возврат Формат(МестноеВремя(МоментУниверсальный, ЧасовойПоясСеанса()), "ДЛФ=DT");

КонецФункции

// Формат интервала по правилам agentrunner-9 (п.1): «N сек» / «N мин M сек» /
// «N ч M мин» / «N д N ч»; нулевая младшая часть не печатается («5 мин»,
// «2 ч»), нулевой интервал целиком - «0 сек». Пороги - как в
// ПредставлениеДавности (ar_Настройки): 60 / 3600 / 86400.
//
// Параметры:
//   Секунд - Число - длительность в секундах; отрицательная считается нулём.
//
// Возвращаемое значение:
//   Строка - локализованное представление интервала.
//
&НаСервереБезКонтекста
Функция ИнтервалСтрокой(Знач Секунд)

	СекундВМинуте = 60;
	СекундВЧасе   = 3600;
	СекундВСутках = 86400;
	ЧасовВСутках  = 24;

	Если Секунд < 0 Тогда
		Секунд = 0;
	КонецЕсли;

	Если Секунд < СекундВМинуте Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 сек'; en = '%1 sec'"), ЦелоеСтрокой(Секунд));
	КонецЕсли;

	Минут = Цел(Секунд / СекундВМинуте);
	Часов = Цел(Секунд / СекундВЧасе);

	Если Секунд < СекундВЧасе Тогда
		Возврат ?(Секунд % СекундВМинуте = 0,
			СтрШаблон(НСтр("ru = '%1 мин'; en = '%1 min'"), ЦелоеСтрокой(Минут)),
			СтрШаблон(НСтр("ru = '%1 мин %2 сек'; en = '%1 min %2 sec'"),
				ЦелоеСтрокой(Минут), ЦелоеСтрокой(Секунд % СекундВМинуте)));
	ИначеЕсли Секунд < СекундВСутках Тогда
		Возврат ?(Минут % СекундВМинуте = 0,
			СтрШаблон(НСтр("ru = '%1 ч'; en = '%1 h'"), ЦелоеСтрокой(Часов)),
			СтрШаблон(НСтр("ru = '%1 ч %2 мин'; en = '%1 h %2 min'"),
				ЦелоеСтрокой(Часов), ЦелоеСтрокой(Минут % СекундВМинуте)));
	Иначе
		Возврат ?(Часов % ЧасовВСутках = 0,
			СтрШаблон(НСтр("ru = '%1 д'; en = '%1 d'"), ЦелоеСтрокой(Цел(Секунд / СекундВСутках))),
			СтрШаблон(НСтр("ru = '%1 д %2 ч'; en = '%1 d %2 h'"),
				ЦелоеСтрокой(Цел(Секунд / СекундВСутках)), ЦелоеСтрокой(Часов % ЧасовВСутках)));
	КонецЕсли;

КонецФункции

// PLAN-07: русское представление статуса пункта плана (payload события
// PlanUpdated, латинские значения - см. ar_ПланЗапуска, шапка модуля).
// Пять допустимых значений: pending | in_progress | done | skipped | removed.
// Неизвестное значение (защита от будущих несовместимых payload) показывается
// как «Неизвестно» - функция не бросает исключение на неожиданной строке.
//
// Параметры:
//   СтатусСырой - Строка - значение status из payload PlanUpdated.
//
// Возвращаемое значение:
//   Строка - локализованное представление статуса.
//
&НаСервереБезКонтекста
Функция ПредставлениеСтатусаПлана(Знач СтатусСырой)

	Если СтатусСырой = "pending" Тогда
		Возврат НСтр("ru = 'Ожидает'; en = 'Pending'");
	ИначеЕсли СтатусСырой = "in_progress" Тогда
		Возврат НСтр("ru = 'В работе'; en = 'In progress'");
	ИначеЕсли СтатусСырой = "done" Тогда
		Возврат НСтр("ru = 'Готово'; en = 'Done'");
	ИначеЕсли СтатусСырой = "skipped" Тогда
		Возврат НСтр("ru = 'Пропущено'; en = 'Skipped'");
	ИначеЕсли СтатусСырой = "removed" Тогда
		Возврат НСтр("ru = 'Снято'; en = 'Removed'");
	Иначе
		// Защита от будущих несовместимых payload (значение status вне
		// пяти известных) - не бросаем исключение на неожиданной строке.
		Возврат НСтр("ru = 'Неизвестно'; en = 'Unknown'");
	КонецЕсли;

КонецФункции

#КонецОбласти
