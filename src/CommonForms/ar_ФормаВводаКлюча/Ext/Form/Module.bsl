////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ФормаВводаКлюча (Ввод API-ключа).
//
// Лёгкий модальный диалог ввода значения секрета. Возвращает введённую строку
// через ОписаниеОповещения вызывающей стороны (см. UI-01 / Plan §3.9).
// Само значение хранится в реквизите формы ЗначениеКлюча с признаком
// РежимПароля = Истина и нигде не логируется.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОКНажатие(Команда)

	Закрыть(ЗначениеКлюча);

КонецПроцедуры

&НаКлиенте
Процедура ОтменаНажатие(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти
